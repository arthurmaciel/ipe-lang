module Std.Palette exposing (Shade(..), toHex, Length(..), lengthPx)

-- Spike module for the compiled-source stdlib subsystem (#98, extended #103).
--
-- The load-bearing property this exercises — impossible for a kernel — is a
-- module in the reserved `Std.` namespace that DEFINES its own data type AND
-- pattern-matches its own constructors. `Shade` is deliberately NOT a reserved
-- built-in type name, so it validates the injection + N0025 exemption seam
-- independently of the reserved-name gate.
--
-- `Length` (#103) is the opposite: it IS a reserved built-in type name (in the
-- nullary-Std.Ui set). A USER module declaring `type Length` is still rejected
-- by IPE-N0026, but an `EmbeddedStdlib` module — the canonical definer, tagged
-- via the unforgeable `ModuleOrigin` — is exempt for that subset. This proves
-- an `EmbeddedStdlib` module can define a reserved type end-to-end (the last
-- prereq before compiled-source `Std.Css`, which defines `Length` / `Color` /
-- … for real). The lowerer keys this `Length` under its real home
-- (`Std.Palette`), so it becomes its own enum and never collides with the
-- genuine Std.Ui `UiPlain::Length` (empty home).
--
-- Every top-level binding is fully annotated: the compiled-source stdlib
-- discipline (annotation-driven generalisation, no whole-program let-gen) is
-- machine-checked by a fail-closed canon gate.


type Shade
    = Dark
    | Light


toHex : Shade -> String
toHex shade =
    case shade of
        Dark ->
            "#000"

        Light ->
            "#fff"


type Length
    = Px Int


lengthPx : Length -> Int
lengthPx len =
    case len of
        Px n ->
            n
