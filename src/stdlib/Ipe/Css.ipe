-- ─── Rules + rendering ──────────────────────────────────────────

-- `selector { props }` — the selector is parsed at construction; a selector
-- that fails policy DROPS the whole rule (its declarations included).
rule : String -> List CssProp -> CssRule
rule selector props =
    case safeSelector selector of
        Just s ->
            CssRule s props

        Nothing ->
            CssRuleDropped


-- `@media query { rules }` — the query is parsed through the selector grammar;
-- the `@media ` keyword is supplied by the renderer, never by the user string.
media : String -> List CssRule -> CssRule
media query rules =
    case safeSelector query of
        Just q ->
            CssMedia q rules

        Nothing ->
            CssRuleDropped


-- `@keyframes name { frames }` — name parsed; each raw frame body is close-tag
-- stripped (breakout floor) then gated by `sanitizeRawBody` (the authoritative
-- kernel over the audited `css_safety` raw-body policy).
keyframes : String -> List String -> CssRule
keyframes name frames =
    case safeSelector name of
        Just n ->
            let
                stripped =
                    List.map stripStyleClose frames
            in
            -- Gate the CONCATENATION of all frames through the authoritative
            -- `sanitizeRawBody` kernel. Joining scans a pattern spanning any
            -- frame without a higher-order `List.any` over a named predicate
            -- (which the backend cannot yet emit); over-detection at a join
            -- boundary is fail-safe. The kernel decodes CSS escapes, so an
            -- escaped `@import`/script-sink in any frame drops the whole rule.
            case sanitizeRawBody (String.join "" stripped) of
                Just _ ->
                    CssKeyframes n stripped

                Nothing ->
                    CssRuleDropped

        Nothing ->
            CssRuleDropped


-- One keyframe step: `pct { prop; prop }`.
frame : String -> List CssProp -> String
frame pctStr props =
    pctStr
        ++ " { "
        ++ String.join "; " (List.map renderProp props)
        ++ " }"


-- A raw, pre-rendered fragment — close-tag stripped at construction, then
-- gated by the authoritative `sanitizeRawBody` kernel over the audited
-- `css_safety` policy: a body carrying an at-rule (`@import` SSRF), a
-- `<style>`/comment breakout, or a script-sink URL scheme — in either its raw
-- or CSS-escape-decoded form — is DROPPED entirely (`CssRuleDropped`). The
-- kernel runs `css_unescape` + whitespace-strip, so an escaped payload a raw
-- substring check would miss (`\40 import`, `x:e\78 pression(…)`) is dropped.
raw : String -> CssRule
raw s =
    let
        stripped =
            stripStyleClose s
    in
    case sanitizeRawBody stripped of
        Just safe ->
            CssRaw safe

        Nothing ->
            CssRuleDropped


renderProp : CssProp -> String
renderProp p =
    case p of
        CssPropSafe k v ->
            k ++ ":" ++ v

        CssDropped ->
            ""


renderRule : CssRule -> String
renderRule r =
    case r of
        CssRule selector props ->
            selector
                ++ " {\n"
                ++ String.join ""
                    (List.map
                        (\p ->
                            case p of
                                CssPropSafe k v ->
                                    "  " ++ k ++ ": " ++ v ++ ";\n"

                                CssDropped ->
                                    ""
                        )
                        props
                    )
                ++ "}\n"

        CssMedia query rules ->
            "@media "
                ++ query
                ++ " {\n"
                ++ String.join "" (List.map renderRule rules)
                ++ "}\n"

        CssKeyframes name frames ->
            "@keyframes "
                ++ name
                ++ " { "
                ++ String.join " " frames
                ++ " }\n"

        CssRaw s ->
            -- Single-use of `s` (append a trailing newline unconditionally)
            -- sidesteps the backend String-move limitation (E0382).  A raw
            -- fragment already ending in `\n` gets one extra blank line —
            -- cosmetic only, never a security or correctness issue (`raw` is an
            -- unused escape hatch in the corpus).  See the backend follow-up.
            s ++ "\n"

        CssRuleDropped ->
            ""


-- Render a list of rules to a complete stylesheet string.  Finishes through
-- `stripStyleClose` (defence in depth — a `</style` that slipped any per-entry
-- gate is neutralised before the string reaches a `<style>` sink).
stylesheet : List CssRule -> String
stylesheet rules =
    stripStyleClose (String.join "" (List.map renderRule rules))


-- Render a list of props as an inline `style="a:b;c:d"` string.
styles : List CssProp -> String
styles props =
    stripStyleClose (String.join ";" (List.map renderProp props))
