-- | Ipe.Basics — non-numeric basics, the implicit prelude.
--
-- Each binding routes to its runtime kernel via `Ffi.kernel`. `clamp` is
-- polymorphic over any comparable type; the type-checker's `Comparable`
-- obligation rejects a function or record argument before it monomorphises.
module Ipe.Basics exposing
    ( identity
    , always
    , not
    , fst
    , snd
    , clamp
    )


import Ipe.Ffi as Ffi


identity : a -> a
identity = Ffi.kernel "Basics_identity"


always : a -> b -> a
always = Ffi.kernel "Basics_always"


not : Bool -> Bool
not = Ffi.kernel "Basics_not"


fst : ( a, b ) -> a
fst = Ffi.kernel "Basics_fst"


snd : ( a, b ) -> b
snd = Ffi.kernel "Basics_snd"


clamp : a -> a -> a -> a
clamp = Ffi.kernel "Basics_clamp"
