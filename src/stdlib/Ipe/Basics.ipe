-- | Ipe.Basics — the implicit prelude (Tier-A auto-import, compiled source).
--
-- Each binding routes to its runtime kernel via `Kernel.kernel`. Polymorphic
-- members with ordering or numeric obligations (`clamp`, `min`, `max`,
-- `negate`, `abs`, `compare`) carry the bound implicitly — the type-checker's
-- `Comparable`/`Number` obligation rejects a function or record argument
-- before it monomorphises. `toString` carries the `Stringify` bound;
-- `sqrt` is monomorphically `Float -> Float`.
module Ipe.Basics exposing
    ( identity
    , always
    , not
    , fst
    , snd
    , clamp
    , toString
    , modBy
    , negate
    , abs
    , sqrt
    , min
    , max
    , compare
    )


import Ipe.Ffi.Kernel as Kernel


identity : a -> a
identity = Kernel.kernel "Basics_identity"


always : a -> b -> a
always = Kernel.kernel "Basics_always"


not : Bool -> Bool
not = Kernel.kernel "Basics_not"


fst : ( a, b ) -> a
fst = Kernel.kernel "Basics_fst"


snd : ( a, b ) -> b
snd = Kernel.kernel "Basics_snd"


clamp : a -> a -> a -> a
clamp = Kernel.kernel "Basics_clamp"


toString : a -> String
toString = Kernel.kernel "Basics_toString"


modBy : Int -> Int -> Int
modBy = Kernel.kernel "Basics_modBy"


negate : a -> a
negate = Kernel.kernel "Basics_negate"


abs : a -> a
abs = Kernel.kernel "Basics_abs"


sqrt : Float -> Float
sqrt = Kernel.kernel "Basics_sqrt"


min : a -> a -> a
min = Kernel.kernel "Basics_min"


max : a -> a -> a
max = Kernel.kernel "Basics_max"


compare : a -> a -> Order
compare = Kernel.kernel "Basics_compare"
