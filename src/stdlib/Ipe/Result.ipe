-- | Ipe.Result — combinators over the Result ADT.
--
-- The Result ADT itself (`Result e a`, `Ok`, `Err` ctors) remains
-- kernel-anchored so the type system and runtime IpeResult representation
-- stay in lockstep.
--
-- Partial-resolution at call sites (where the surrounding function is
-- itself polymorphic in `e` or `a`) is handled by `coerceCallArgsAt`
-- forcing explicit `any(e)` widening so generic inference stays
-- consistent across all argument positions in one call.
module Ipe.Result exposing
    ( withDefault
    , map
    , andThen
    , mapError
    , map2, map3, map4, map5
    , andMap
    , combine
    , toMaybe
    , fromMaybe
    )


withDefault def r =
    case r of
        Ok x -> x
        Err _ -> def


map fn r =
    case r of
        Ok x -> Ok (fn x)
        Err e -> Err e


andThen fn r =
    case r of
        Ok x -> fn x
        Err e -> Err e


mapError fn r =
    case r of
        Ok x -> Ok x
        Err e -> Err (fn e)


map2 fn ra rb =
    case ra of
        Ok a ->
            case rb of
                Ok b -> Ok (fn a b)
                Err e -> Err e
        Err e -> Err e


map3 fn ra rb rc =
    case ra of
        Ok a ->
            case rb of
                Ok b ->
                    case rc of
                        Ok c -> Ok (fn a b c)
                        Err e -> Err e
                Err e -> Err e
        Err e -> Err e


map4 fn ra rb rc rd =
    case ra of
        Ok a ->
            case rb of
                Ok b ->
                    case rc of
                        Ok c ->
                            case rd of
                                Ok d -> Ok (fn a b c d)
                                Err e -> Err e
                        Err e -> Err e
                Err e -> Err e
        Err e -> Err e


map5 fn ra rb rc rd re =
    case ra of
        Ok a ->
            case rb of
                Ok b ->
                    case rc of
                        Ok c ->
                            case rd of
                                Ok d ->
                                    case re of
                                        Ok e -> Ok (fn a b c d e)
                                        Err err -> Err err
                                Err err -> Err err
                        Err err -> Err err
                Err err -> Err err
        Err err -> Err err


andMap ra rfn =
    case rfn of
        Ok fn ->
            case ra of
                Ok a -> Ok (fn a)
                Err e -> Err e
        Err e -> Err e


-- | `combine results` — collect a list of Results into a Result of list,
-- preserving order and short-circuiting on the first `Err`.
--
-- `combineHelp` walks the input tail-recursively, prepending each `Ok`
-- payload onto `acc` (reverse order) and returning the first `Err`
-- immediately.  At the empty base it flips `acc` via `reverseHelp` for
-- the final left-to-right output.  The helper is a tail call, so
-- `Ipe.Build.TailCallOpt` lowers it to a loop and a very long input runs
-- in constant native stack.
combine results =
    combineHelp results []


combineHelp results acc =
    case results of
        [] -> Ok (reverseHelp acc [])
        (r :: rest) ->
            case r of
                Ok x -> combineHelp rest (x :: acc)
                Err e -> Err e


reverseHelp list acc =
    case list of
        [] -> acc
        (x :: rest) -> reverseHelp rest (x :: acc)


toMaybe r =
    case r of
        Ok x -> Just x
        Err _ -> Nothing


fromMaybe err m =
    case m of
        Just x -> Ok x
        Nothing -> Err err
