-- | Ipe.Encoding — text encoding helpers.
--
-- String-to-String codecs for base64, percent (URL), and hex encodings.
-- Each encoder is total (`String -> String`); each decoder returns
-- `Result Error String` because the input may be malformed.
--
-- Non-UTF-8 binary payloads should go through `Ipe.Bytes` instead.
module Ipe.Encoding exposing
    ( base64Encode, base64Decode
    , urlEncode, urlDecode, percentDecode
    , hexEncode, hexDecode
    )


import Ipe.Ffi.Kernel as Kernel


-- | Base64-encode a string (RFC 4648 standard alphabet, with padding).
base64Encode : String -> String
base64Encode =
    Kernel.kernel "Encoding_base64Encode"


-- | Base64-decode a string.
--
-- Returns `Err` when the input contains characters outside the base64
-- alphabet or has invalid padding.
base64Decode : String -> Result Error String
base64Decode =
    Kernel.kernel "Encoding_base64Decode"


-- | Form-encode a string for a query-string key or value.
--
-- The encoding is `application/x-www-form-urlencoded`: every byte except the ASCII
-- alphanumerics and `-` `_` `.` `~` is percent-escaped, and a space becomes `+`.
urlEncode : String -> String
urlEncode =
    Kernel.kernel "Encoding_urlEncode"


-- | Form-decode a query-string key or value, the inverse of `urlEncode`.
--
-- The decoding is `application/x-www-form-urlencoded`: a `+` becomes a space,
-- then each `%XX` escape decodes.
--
-- Returns `Err` when the input contains a malformed
-- percent-escape sequence (a `%` not followed by two hex digits), when the
-- decoded bytes are not valid UTF-8, or when the input exceeds the URL
-- component length cap. Use `percentDecode` for a URL path or a file location,
-- where `+` is a literal `+`.
urlDecode : String -> Result Error String
urlDecode =
    Kernel.kernel "Encoding_urlDecode"


-- | Percent-decode a non-form URL component such as a path segment (RFC 3986).
--
-- Each `%XX` escape decodes and a `+` stays a literal `+`, so it also fits a
-- file location.
--
-- Returns `Err` on the same malformed input as `urlDecode`: a bad
-- percent-escape, decoded bytes that are not valid UTF-8, or an over-cap input.
percentDecode : String -> Result Error String
percentDecode =
    Kernel.kernel "Encoding_percentDecode"


-- | Hex-encode a string (lowercase output, two hex digits per byte).
hexEncode : String -> String
hexEncode =
    Kernel.kernel "Encoding_hexEncode"


-- | Hex-decode a string.
--
-- Returns `Err` when the input has an odd length or contains a character
-- outside `[0-9a-fA-F]`.
hexDecode : String -> Result Error String
hexDecode =
    Kernel.kernel "Encoding_hexDecode"
