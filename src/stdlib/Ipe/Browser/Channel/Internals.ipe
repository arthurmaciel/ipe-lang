-- | Ipe.Browser.Channel.Internals — the low-level BroadcastChannel port
-- surface: the closed outbound/inbound ADTs and the raw `Ipe.Ffi.Js`
-- request/subscribe wiring the high-level `Ipe.Browser.Channel` layer wraps.
--
-- Importing this submodule discloses the same `js-port:channel` axis as the
-- top-level module (the disclosure is keyed on the `Ipe.Browser.Channel` path
-- prefix), so the raw port surface cannot be reached undisclosed.
module Ipe.Browser.Channel.Internals exposing
    ( JsCmd(..)
    , JsMsg(..)
    , request
    , subscribe
    , inbound
    )

import Ipe.Ffi.Js as Js
import Ipe.Json.Decode as Decode
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub


-- | The ONE closed OUTBOUND port type.
--
--   * `Open name` — create a `BroadcastChannel` with the given name and
--     attach a `message` event listener that routes frames inbound.
--   * `Send name payload` — post a string message on the named channel.
--   * `Close name` — close the named channel and remove its listener.
type JsCmd
    = Open String
    | Send String String
    | Close String


-- | The NARROW closed INBOUND port type — deliberately NOT the app's internal
-- `Msg`. Every variant the browser can push is enumerated, so the fold in the
-- high-level layer is EXHAUSTIVE and an unavailability can never be silently
-- dropped.
--
--   * `Message payload` — a message received on the channel. `payload` is the
--     string content of the message frame.
--   * `Unavailable` — the `BroadcastChannel` API is absent in this context.
type JsMsg
    = Message String
    | Unavailable


-- | `request cmd` — hand a closed outbound `JsCmd` to the raw port transport.
request : JsCmd -> Cmd.Cmd msg
request cmd =
    Js.send cmd


-- | `subscribe toMsg` — the inbound subscription over the fail-closed seal
-- decoder. `inbound` IS the security gate; a malformed / mismatched frame is
-- dropped whole. A decoded `JsMsg` is handed to `toMsg`.
subscribe : (JsMsg -> msg) -> Sub.Sub msg
subscribe toMsg =
    Js.subscribe inbound toMsg


-- | The total, fail-closed decoder for the inbound `JsMsg`. Reads the `event`
-- discriminator: `"message"` decodes a `Message`; `"unavailable"` decodes
-- `Unavailable`. An unrecognised token fails the decode closed.
inbound : Decode.Decoder JsMsg
inbound =
    Decode.andThen decodeByEvent (Decode.field "event" Decode.string)


decodeByEvent : String -> Decode.Decoder JsMsg
decodeByEvent event =
    case event of
        "message" ->
            Decode.map Message
                (Decode.field "payload" Decode.string)

        "unavailable" ->
            Decode.succeed Unavailable

        _ ->
            Decode.fail ("unknown channel event variant: " ++ event)
