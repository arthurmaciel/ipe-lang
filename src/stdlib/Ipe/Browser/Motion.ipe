-- | Ipe.Browser.Motion — a session-stream delivering `devicemotion` events as
-- typed acceleration and rotation-rate readings, over `Ipe.Ffi.Js` ports.
--
-- A first-party proof of the per-capability web mechanism spanning BOTH port
-- directions: an outbound `JsCmd` starts or stops the motion watch, and inbound
-- `JsMsg` frames carry typed motion readings. Both cross the same seal codec and
-- fail-closed port discipline as every other port; there is no second transport.
--
-- Importing this reserved `Ipe.Browser.<Api>` module discloses `js-port:motion`
-- (import-derived, keyed on the canonical `Ipe.Browser.Motion` path prefix via
-- `WebCapability::for_browser_module`, alias-immune); only the top-level app's
-- `[capabilities] accepts` set can grant it.
--
-- The two layers:
--
--   * `Ipe.Browser.Motion.Internals` publishes the closed outbound/inbound ADTs.
--   * this module is the high-level layer: `watch` starts the continuous stream
--     as an outbound `Cmd`, `stopWatch` ends it, and `readings` is the inbound
--     subscription folding the narrow `JsMsg` into a typed `MotionEvent`. The
--     inbound `case` is EXHAUSTIVE: an unavailability becomes a typed variant,
--     never a silently dropped frame.
module Ipe.Browser.Motion exposing
    ( MotionEvent(..)
    , watch
    , stopWatch
    , readings
    )

import Ipe.Browser.Motion.Internals as Internals exposing (JsMsg(..))
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub


-- | A typed motion event delivered by the watch stream.
--
--   * `MotionReading accelX accelY accelZ rotAlpha rotBeta rotGamma` — a
--     `devicemotion` event. `accelX`/`accelY`/`accelZ` are the acceleration
--     components in m/s² (may be `Nothing` if the axis is unsupported);
--     `rotAlpha`/`rotBeta`/`rotGamma` are the rotation-rate components in
--     degrees/second (may be `Nothing` if unavailable).
--   * `MotionUnavailable` — the `devicemotion` event is absent in this browser
--     context.
type MotionEvent
    = MotionReading (Maybe Float) (Maybe Float) (Maybe Float) (Maybe Float) (Maybe Float) (Maybe Float)
    | MotionUnavailable


-- | `watch` — begin a continuous `devicemotion` stream; readings are delivered
-- on the `readings` subscription. Outbound `Cmd`.
--
-- The JS host attaches a `devicemotion` listener on `window`. A missing event
-- replies immediately with `Unavailable` rather than silently failing.
--
-- Importing this module discloses `js-port:motion`; the app must grant it with
-- `accepts = [ JsPort Motion ]` under [capabilities] in package.ipe.
watch : Cmd.Cmd msg
watch =
    Internals.request Internals.Watch


-- | `stopWatch` — remove the active `devicemotion` listener. A no-op when no
-- watch is active. Outbound `Cmd`.
stopWatch : Cmd.Cmd msg
stopWatch =
    Internals.request Internals.StopWatch


-- | `readings toMsg` — the inbound subscription, wired in `subscriptions`.
--
-- The decoder IS the security gate: every inbound value runs through the total,
-- bounded seal decoder for the narrow `JsMsg`; a malformed / mismatched frame is
-- dropped whole. A decoded `JsMsg` is folded EXHAUSTIVELY into a `MotionEvent`.
readings : (MotionEvent -> msg) -> Sub.Sub msg
readings toMsg =
    Internals.subscribe (\inbound -> toMsg (toEvent inbound))


-- | Fold the narrow inbound `JsMsg` into a typed `MotionEvent`. The `case` is
-- exhaustive over every published inbound variant.
toEvent : Internals.JsMsg -> MotionEvent
toEvent msg =
    case msg of
        Reading accelX accelY accelZ rotAlpha rotBeta rotGamma ->
            MotionReading accelX accelY accelZ rotAlpha rotBeta rotGamma

        Unavailable ->
            MotionUnavailable
