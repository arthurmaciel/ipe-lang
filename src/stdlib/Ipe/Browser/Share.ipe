-- | Ipe.Browser.Share — invoke the platform share sheet over `Ipe.Ffi.Js` ports.
--
-- A first-party proof of the per-capability web mechanism spanning BOTH port
-- directions: an outbound `JsCmd` (`share`) invokes the share sheet, and an inbound
-- `JsMsg` carries the outcome — a completion, a user cancellation, or a typed
-- unavailability. Both cross the same seal codec and fail-closed port discipline as
-- every other port; there is no second transport.
--
-- Importing this reserved `Ipe.Browser.<Api>` module discloses `js-port:share`
-- (import-derived, keyed on the canonical `Ipe.Browser.Share` path prefix via
-- `WebCapability::for_browser_module`, alias-immune); only the top-level app's
-- `[capabilities] accepts` set can grant it.
--
-- The two layers:
--
--   * `Ipe.Browser.Share.Internals` publishes the closed outbound/inbound ADTs and
--     the full `Payload` surface (`title` / `text` / `url`).
--   * this module is the high-level layer: `share` returns a `Task Error ()` via
--     the correlated port→Task bridge (a completion succeeds; a cancellation or an
--     absent API resolves to a typed `Err`), and `outcomes` is the inbound
--     subscription folding the narrow `JsMsg` into a typed `Result Error ()`. The
--     inbound `case` is EXHAUSTIVE: a cancellation becomes a typed `Err`, never a
--     silently dropped variant.
module Ipe.Browser.Share exposing
    ( share
    , outcomes
    , ShareUrl, shareUrl
    , Payload, payload
    )

import Ipe.Browser.Share.Internals as Internals exposing (JsMsg(..))
import Ipe.Error as Error exposing (Error)
import Ipe.Maybe exposing (Maybe(..))
import Ipe.Result as Result exposing (Result)
import Ipe.Task as Task
import Ipe.Url as Url exposing (Url)
import Ipe.App.Tea.Web.Cmd as Cmd
import Ipe.App.Tea.Web.Sub as Sub


-- | The schemes a shared URL may carry: only `http`/`https`. A `javascript:` /
-- `data:` / `file:` URL is rejected at `shareUrl`, so a non-web scheme never
-- reaches the platform share sheet.
shareSchemes : List String
shareSchemes =
    [ "http", "https" ]


-- | An opaque, scheme-narrowed shared URL. The ONLY constructor is `shareUrl`,
-- so a value of this type always carries a vetted `http`/`https` scheme.
type ShareUrl
    = ShareUrl Url


-- | `shareUrl u` — the parse-don't-validate seal for a shared URL. Fail-closed:
-- `Ok` only when `u`'s scheme is `http`/`https`, otherwise a typed `Err`.
shareUrl : Url -> Result Error ShareUrl
shareUrl u =
    Result.map ShareUrl (Url.checkScheme shareSchemes u)


-- | The typed share payload. `url` is an optional scheme-narrowed `ShareUrl` —
-- a raw `String` URL cannot reach the share sheet. Build with `payload`.
type alias Payload =
    { title : String
    , text : String
    , url : Maybe ShareUrl
    }


-- | `payload rec` — lower a typed `Payload` into the raw seal DTO. The narrowed
-- `url` is serialized once here (`Url.toString`); a `Nothing` URL leaves the
-- transport field blank, which the seal omits before the Web API call.
payload : Payload -> Internals.Payload
payload rec =
    { title = rec.title
    , text = rec.text
    , url =
        case rec.url of
            Just (ShareUrl u) ->
                Url.toString u

            Nothing ->
                ""
    }


-- | `share p` — invoke the platform share sheet with the given typed `Payload`,
-- as a `Task Error ()`. The payload is lowered through `payload` (the single
-- serialization point for its scheme-narrowed `url`), so a raw-`String` /
-- unvetted-scheme URL cannot reach the share sheet.
--
-- Uses the correlated port→Task bridge (`Js.request`). The served JS handler calls
-- `navigator.share`; a completion resolves the `Task` with `()`, and a user
-- cancellation or an absent API resolves it to a typed `Err`.
--
-- Importing this module discloses `js-port:share`; the app must grant it with
-- `accepts = [ JsPort Share ]` under [capabilities] in package.ipe.
share : Payload -> Task Error ()
share p =
    Internals.requestOne (Internals.Share (payload p))
        |> Task.andThen foldOutcome


-- | `outcomes toMsg` — the inbound subscription, wired in `subscriptions`.
--
-- The decoder IS the security gate: every inbound value runs through the total,
-- bounded seal decoder for the narrow `JsMsg`; a malformed / mismatched frame is
-- dropped whole. A decoded `JsMsg` is folded EXHAUSTIVELY into a
-- `Result Error ()` — a `Shared` becomes `Ok`, a cancellation / unavailability a
-- typed `Err`.
outcomes : (Result Error () -> msg) -> Sub.Sub msg
outcomes toMsg =
    Internals.subscribe (\inbound -> toMsg (toResult inbound))


-- | Fold a `share` reply into a `Task Error ()`. The `case` is exhaustive over
-- every published inbound variant; only `Shared` succeeds.
foldOutcome : Internals.JsMsg -> Task Error ()
foldOutcome msg =
    case msg of
        Shared ->
            Task.succeed ()

        Cancelled ->
            Task.fail (Error.unavailable "share sheet cancelled")

        Unavailable ->
            Task.fail (Error.unavailable "web share unavailable")


-- | Fold the narrow inbound `JsMsg` into a typed `Result Error ()`. The `case` is
-- exhaustive over every published inbound variant.
toResult : Internals.JsMsg -> Result Error ()
toResult inbound =
    case inbound of
        Shared ->
            Ok ()

        Cancelled ->
            Err (Error.unavailable "share sheet cancelled")

        Unavailable ->
            Err (Error.unavailable "web share unavailable")
