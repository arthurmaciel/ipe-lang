-- ─── Types ─────────────────────────────────────────────────────────


-- | A row read back from the database: every column keyed by its name, values
-- as strings (the `Db.findWhere` representation). The typed `read*` helpers
-- parse a column back into its Ipê type; the raw-column escape (`fromColumns`)
-- stores rows in this form.
type alias Row =
    Dict String String


-- A store's columns are typed with `Ipe.Codec.ColType` — the dialect-neutral
-- column type a codec also derives — so one codec's shape and a hand-declared
-- store share a single column vocabulary. The `Ipe.Db` kernels map each
-- `ColType` to the configured backend's concrete SQL type, so one store
-- declaration works on every backend.


-- | One typed column: its (validated) name and its abstract type for the
-- schema. The value projection lives in the store's codec, so a `Column` is
-- pure data — no stored function.
type Column
    = Column
        { name : String
        , colType : ColType
        }


-- | A per-column DB-only fact the record type cannot express: serial
-- (DB-assigned) id, uniqueness, or a DB-stamped default. A typed ADT, not a
-- stringly flag — an impossible spec (a flag typo, a malformed default) is
-- unrepresentable. The primary key is a table-level fact and lives only in the
-- `PrimaryKeyDecl`, never as a spec, so the key is recorded in one place.
type ColumnSpec
    = Serial String
    | Unique String
    | DefaultNow String
    | DefaultText String String
    | DefaultInt String Int
    | TouchOnUpdate String


-- | The table's primary-key declaration — a table has at most one primary key,
-- so the single-column and the composite form are alternatives of one closed
-- sum rather than two independent fields that could both be set.
--
--   * `NoPk` — no key declared; the by-key operations (`get` / `update` /
--     `delete` and their `…As` / `…On` twins) fail closed.
--   * `SinglePk column` — one key column (`primaryKey` / `primaryKeyNamed`).
--   * `CompositePk columns` — a table-level key over two or more columns, in
--     declared order (`compositePrimaryKey2` / `compositePrimaryKey3` /
--     `compositePrimaryKeyNamed`). A composite key is a schema fact: the by-key
--     operations, which bind exactly one key value, refuse it.
--
-- The builders parse their input once: a composite key of fewer than two
-- columns, or a second key declaration, is recorded as a `PrimaryKeyFault`
-- instead of a `PrimaryKeyDecl`, so no builder ever yields a one-column
-- `CompositePk` or a table with two keys.
type PrimaryKeyDecl
    = NoPk
    | SinglePk String
    | CompositePk (List String)


-- | Why a primary-key declaration was refused — a second declaration, a
-- composite key of fewer than two columns, or a `renameColumn` of a key column.
-- Carried on the `Draft` / `Store` in place of a `PrimaryKeyDecl` and surfaced as
-- a typed `Err` by `createSql`, `migrations`, and every operation that reads the
-- key.
type PrimaryKeyFault
    = SecondPrimaryKey
    | CompositeKeyTooShort (List String)
    | RenamedKeyColumn String


-- | A declarative performance index over one or more of the store's columns.
-- Declared through `index` (name derived from table + columns) or `indexNamed`
-- (caller-supplied name). The columns are validated against the store's
-- codec-derived column list at `create` time; an unknown column or an invalid
-- identifier fails closed with no DDL produced.
type IndexSpec
    = Index (List String)
    | IndexNamed String (List String)


-- | A schema-evolution operation recorded in the store's op log. Each op is
-- appended by `renameColumn` / `renameTable`; the log folds to ledger entries
-- in `migrations`. Kept as a closed ADT so `migrations` is the single point
-- that builds DDL text from ops — identifiers are validated there, never here.
type SchemaOp
    = RenameColumn String String
    | RenameTable String String


-- | A table under construction: its schema is known but its access intent is
-- not yet declared, so it is NOT queryable. `fromCodec` / `fromColumns` return a
-- `Draft a`, the schema-shaping builders (`primaryKey` / `compositePrimaryKey2` /
-- `compositePrimaryKey3` / `serial` / `unique` / `defaultNow` / `defaultText` /
-- `defaultInt` / `touchOnUpdate` / `index` / `indexNamed`) refine one, and
-- `public` / `secured` are the only ways to promote one to a queryable
-- `Store a` / `Secured a`. No read or write operation accepts a `Draft a`, so a
-- table left unclassified cannot be read or written by mistake (deny-by-default).
--
-- The record fields are the same schema payload a `Store a` carries: `codec` is
-- the single source of truth (its `Shape` yields the columns and their types),
-- `specs` are the DB-only facts, `pk` is the parsed primary-key declaration (or
-- the fault that refused it), `frozenTable` / `frozenColumns` hold the table
-- name and columns as first constructed, `table` / `currentColumns` track the
-- current-schema view after any renames, `ops` is the ordered schema-op log, and
-- `indexes` is the ordered index specs. Built only through `fromCodec` / `fromColumns`, so every identifier it
-- holds has already been accepted by `validSqlIdent`.
type Draft a
    = Draft
        { table : String
        , frozenTable : String
        , frozenColumns : List Column
        , currentColumns : List Column
        , codec : Codec a
        , specs : List ColumnSpec
        , pk : Result PrimaryKeyFault PrimaryKeyDecl
        , ops : List SchemaOp
        , indexes : List IndexSpec
        }


-- | One classified, queryable table whose schema, reads, and writes derive from
-- its `Codec a`. A `Store a` is reachable only through `public` (an explicit,
-- auditable world-open declaration) applied to a `Draft a`, so every queryable
-- store has passed through a deliberate classification. Its record fields carry
-- the same schema payload the `Draft a` held: `codec` is the single source of
-- truth (its `Shape` yields the columns and their types, its encoder writes a
-- row, its decoder reads one back); `specs` are the DB-only facts; `pk` is the
-- parsed primary-key declaration (or the fault that refused it) the by-key
-- operations and the DDL read. `frozenTable` and `frozenColumns` hold the table
-- name and columns as first constructed (the source for the never-drifting
-- create entry — neither is edited by a rename).
-- `table` and `currentColumns` track the current-schema view after any renames
-- (the identifiers CRUD targets). `ops` is the ordered schema-op log folded by
-- `migrations`, threaded from `frozenTable` so each rename entry names the table
-- as of its own position. `indexes` is the ordered list of declarative index
-- specs emitted after the create entry by `create` / `migrations`.
type Store a
    = Store
        { table : String
        , frozenTable : String
        , frozenColumns : List Column
        , currentColumns : List Column
        , codec : Codec a
        , specs : List ColumnSpec
        , pk : Result PrimaryKeyFault PrimaryKeyDecl
        , ops : List SchemaOp
        , indexes : List IndexSpec
        }


-- ─── Identifier validation (parse-don't-validate) ──────────────────


-- | `validSqlIdent name` — accept `name` as a (possibly dotted) SQL identifier,
-- or reject it. Byte-equivalent to the runtime's dotted identifier gate
-- (`SqlIdent::parse` in dotted mode, `runtime/rust/src/db.rs`): a non-empty run
-- of ASCII letters, digits, `_`, and `.`, where every `.`-delimited segment is
-- itself non-empty. So a bare name (`users`) and a dotted `table.column`
-- reference (`users.id`) pass, while a lone `.`, a trailing dot (`users.`), a
-- leading dot (`.id`), and consecutive dots (`a..b`) are rejected — a dotted
-- reference is a sequence of bare names, never a structurally-malformed dot
-- string. Everything else (a space, a quote, a semicolon, a parenthesis) is
-- rejected before any SQL is built.
--
-- Table and column *keys* are stricter still (dot-free) and go through
-- `validSqlIdentPlain`; this dotted predicate mirrors the qualified-reference
-- surface (`Sql.column`). Keeping both mirrors byte-equivalent to the single
-- runtime charset gate is why the Ipê-level check and the kernel check agree.
--
-- Example:
--
--     Store.validSqlIdent "users" == True
--     Store.validSqlIdent "users.id" == True
--     Store.validSqlIdent "user table" == False
--     Store.validSqlIdent "users;drop" == False
--     Store.validSqlIdent "users." == False
--     Store.validSqlIdent "a..b" == False
validSqlIdent : String -> Bool
validSqlIdent name =
    Basics.not (String.isEmpty name)
        && String.all validIdentChar name
        && List.all (\seg -> Basics.not (String.isEmpty seg)) (String.split "." name)


-- | `validSqlIdentPlain name` — the dot-free identifier gate, byte-equivalent to
-- the runtime's plain mode (`SqlIdent::parse_plain`): a non-empty run of ASCII
-- letters, digits, and `_`, with no `.` at all. This is the gate the runtime
-- applies to a bare table or column name, so the Store validates its table name
-- and every column key through this stricter predicate rather than the dotted
-- `validSqlIdent`.
validSqlIdentPlain : String -> Bool
validSqlIdentPlain name =
    Basics.not (String.isEmpty name) && String.all plainIdentChar name


validIdentChar : Char -> Bool
validIdentChar c =
    plainIdentChar c || Char.toCode c == dotCode


plainIdentChar : Char -> Bool
plainIdentChar c =
    let
        code =
            Char.toCode c
    in
    isAsciiDigit code
        || isAsciiUpper code
        || isAsciiLower code
        || code == underscoreCode


isAsciiDigit : Int -> Bool
isAsciiDigit code =
    code >= 48 && code <= 57


isAsciiUpper : Int -> Bool
isAsciiUpper code =
    code >= 65 && code <= 90


isAsciiLower : Int -> Bool
isAsciiLower code =
    code >= 97 && code <= 122


underscoreCode : Int
underscoreCode =
    95


dotCode : Int
dotCode =
    46


-- ─── Column builders ───────────────────────────────────────────────


-- | `column name colType` — a column of an explicit `ColType`. The name is
-- validated when the store is built, not here, so a raw `Column` is inert until
-- a constructor accepts it.
column : String -> ColType -> Column
column name colType =
    Column { name = name, colType = colType }


-- | A `CText` column.
textColumn : String -> Column
textColumn name =
    column name CText


-- | A `CInt` column.
intColumn : String -> Column
intColumn name =
    column name CInt


-- | A `CReal` column.
floatColumn : String -> Column
floatColumn name =
    column name CReal


-- | A `CBool` column.
boolColumn : String -> Column
boolColumn name =
    column name CBool


-- ─── Store construction (fail-closed) ──────────────────────────────


-- | `fromCodec table codec` — build a `Draft` from a record codec, or fail
-- closed. The columns are derived from the codec's `Shape`: an `SRecord`
-- becomes the typed column list, a non-`SRecord` codec (a bare scalar, a blob)
-- names no columns and is an `Err`. The table name and every derived column
-- name are run through `validSqlIdent`; the first non-conforming identifier is
-- an `Err`, and no draft is produced. A returned `Draft` therefore holds only
-- accepted identifiers, and its columns cannot drift from the codec that reads
-- and writes its rows (parse-don't-validate + one source of truth).
--
-- A `Draft` is NOT queryable: classify it with `public` (world-open) or
-- `secured` (policy-guarded) to obtain a value the read and write operations
-- accept (deny-by-default).
fromCodec : String -> Codec a -> Result Error (Draft a)
fromCodec table codec =
    case Codec.shape codec of
        SRecord cols ->
            buildStore table (List.map columnFromShape cols) codec

        SScalar _ ->
            Err notARecordError

        SBlob ->
            Err notARecordError


columnFromShape : ( String, ColType ) -> Column
columnFromShape pair =
    case pair of
        ( name, colType ) ->
            column name colType


-- | `fromColumns table columns` — the raw-column escape: build a `Draft Row`
-- for a dynamic or non-codec table, whose rows are the untyped
-- `Dict String String` the DB layer returns. The draft's codec is the row codec
-- derived from `columns` (`rowCodec`), so the same codec-driven CRUD applies once
-- the draft is classified: writes bind each declared column, reads decode back
-- into a `Row`, and the typed `read*` helpers parse a column into its Ipê type.
-- Like `fromCodec`, the table name and every column name run through
-- `validSqlIdent`, so an invalid identifier fails closed before any SQL is built.
-- Classify the result with `public` / `secured` before querying (deny-by-default).
fromColumns : String -> List Column -> Result Error (Draft Row)
fromColumns table columns =
    buildStore table columns (rowCodec columns)


-- The shared constructor for both `fromCodec` and `fromColumns`: validate the
-- table name and every column name, then freeze the columns and attach the
-- codec, producing an unclassified `Draft`. The single validation boundary
-- (parse-don't-validate).
buildStore : String -> List Column -> Codec a -> Result Error (Draft a)
buildStore table columns codec =
    if Basics.not (validSqlIdentPlain table) then
        Err (invalidIdentError "table" table)

    else
        case firstInvalidColumn columns of
            Just bad ->
                Err (invalidIdentError "column" bad)

            Nothing ->
                Ok
                    (Draft
                        { table = table
                        , frozenTable = table
                        , frozenColumns = columns
                        , currentColumns = columns
                        , codec = codec
                        , specs = []
                        , pk = Ok NoPk
                        , ops = []
                        , indexes = []
                        }
                    )


firstInvalidColumn : List Column -> Maybe String
firstInvalidColumn columns =
    case columns of
        [] ->
            Nothing

        first :: rest ->
            let
                name =
                    columnName first
            in
            if validSqlIdentPlain name then
                firstInvalidColumn rest

            else
                Just name


columnName : Column -> String
columnName col =
    case col of
        Column r ->
            r.name


columnColType : Column -> ColType
columnColType col =
    case col of
        Column r ->
            r.colType


-- ─── Row codec (the raw-column escape's source of truth) ───────────


-- | `rowCodec columns` — the `Codec Row` a raw-column store uses: a record
-- codec over `Dict String String` whose `Shape` is `SRecord` naming each
-- declared column. Every column is carried as `CText` at the JSON layer,
-- because a `Row` cell is already the string form the DB layer returns and
-- accepts (the same lossless-string basis the `read*` helpers parse from); the
-- DDL still uses each column's declared `ColType` (held on the store's frozen
-- columns), so a raw store creates its table with real types while its rows stay
-- untyped strings. The encoder emits the declared columns as a JSON object; the
-- decoder reads that object back into a `Row`.
rowCodec : List Column -> Codec Row
rowCodec columns =
    let
        names =
            List.map columnName columns
    in
    Codec
        { enc = \row -> Encode.object (rowFields names row)
        , mkDec = \_ -> Config.dict Config.string
        , shp = SRecord (List.map (\name -> ( name, CText )) names)
        }


-- | Project a `Row` to the JSON fields for the declared columns, in order. A
-- column absent from the row emits the empty string, so the encoded object
-- always names every declared column (the shape's contract), never a missing
-- field the bind step would reject.
rowFields : List String -> Row -> List ( String, Value )
rowFields names row =
    List.map (\name -> ( name, Encode.string (rowCell name row) )) names


rowCell : String -> Row -> String
rowCell name row =
    case Dict.get name row of
        Just s ->
            s

        Nothing ->
            ""


-- ─── Classification (the only Draft → queryable promotions) ─────────


-- | `public draft` — classify `draft` as a world-readable, world-writable table
-- and return the queryable `Store a`. This is the explicit, auditable escape
-- hatch: a code search for `Store.public` enumerates exactly the tables a
-- reviewer must confirm are meant to be open, because `public` is a first-class
-- declaration, not the absence of one. It is the only promotion from a `Draft` to
-- a `Store`; `secured` is the policy-guarded alternative (deny-by-default: an
-- unclassified `Draft` is unqueryable by construction).
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Result as Result exposing (Result(..))
--
--     countries : Result Error (Store Country)
--     countries =
--         case Store.fromCodec "countries" countryCodec of
--             Err e ->
--                 Err e
--
--             Ok draft ->
--                 Ok (Store.public (Store.primaryKey .code draft))
public : Draft a -> Store a
public draft =
    case draft of
        Draft r ->
            Store
                { table = r.table
                , frozenTable = r.frozenTable
                , frozenColumns = r.frozenColumns
                , currentColumns = r.currentColumns
                , codec = r.codec
                , specs = r.specs
                , pk = r.pk
                , ops = r.ops
                , indexes = r.indexes
                }


-- ─── Column-spec builders ──────────────────────────────────────────
--
-- Each shapes the `Draft`, before classification, because it shapes the schema,
-- not the access policy. The key builders (`primaryKey` / `compositePrimaryKey2`
-- / `compositePrimaryKey3` and their `…Named` forms) set the store's one
-- `PrimaryKeyDecl`, which the DDL and the by-key operations both read; the others
-- attach one typed `ColumnSpec`. Every name a builder records is checked against
-- the store's own validated columns before it reaches DDL, so no builder can
-- smuggle an unchecked name into SQL.


-- | Mark the accessor-named column the primary key — the one-column form. The
-- lowering intercept extracts the column name from the accessor and calls
-- `primaryKeyNamed`.
--
-- A table has exactly one primary key. Declare it ONCE, with the builder that
-- matches its width:
--
--   * one column                    → `primaryKey .field`
--   * two columns                   → `compositePrimaryKey2 .fieldA .fieldB`
--   * three columns                 → `compositePrimaryKey3 .fieldA .fieldB .fieldC`
--   * four or more columns, or a
--     raw-column (`fromColumns`) store → `compositePrimaryKeyNamed [ "col_a", "col_b", … ]`
--
-- Prefer the accessor forms: each accessor is checked against the row type, so a
-- misspelled field is a compile error. The `…Named` forms take bare column names
-- (snake_case, as `Codec.auto` derives them), checked only when the DDL is built.
-- Declaring a second key (any mix of the forms above), or a composite key of
-- fewer than two columns, is refused with a typed `Err` from `createSql`,
-- `migrations`, and every operation that reads the key — never a silent
-- last-writer-wins. The by-key operations (`get` / `update` / `delete` and their
-- `…As` / `…On` twins) bind ONE key value, so they need a one-column key; on a
-- composite-key store they fail closed, and rows are read and written through
-- `query` / `updateWhere` / `deleteWhere` conditions over the key columns.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     type alias User =
--         { id : String, name : String }
--
--     users : Result Error (Store User)
--     users =
--         Store.fromCodec "users" userCodec
--             |> Result.map (Store.primaryKey .id)
--             |> Result.map Store.public
primaryKey : (row -> t) -> Draft row -> Draft row
primaryKey =
    Kernel.kernel "Store_primaryKey"


-- | `compositePrimaryKey2 .a .b draft` — declare a two-column primary key over
-- the accessor-named columns, in that order (`PRIMARY KEY (a, b)`). Use it when
-- no single column identifies a row but the pair does — a join table, or a
-- per-owner sequence. Each accessor is checked against the row type, so naming a
-- field the row does not declare is a compile error. The lowering intercept
-- extracts both column names and calls `compositePrimaryKeyNamed`, whose doc
-- lists the refusals. `createSql` renders it as the table-level
-- `PRIMARY KEY (user_id, group_id)`.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     type alias Membership =
--         { userId : String, groupId : String, role : String }
--
--     memberships : Result Error (Store Membership)
--     memberships =
--         Store.fromCodec "memberships" membershipCodec
--             |> Result.map (Store.compositePrimaryKey2 .userId .groupId)
--             |> Result.map Store.public
compositePrimaryKey2 : (row -> a) -> (row -> b) -> Draft row -> Draft row
compositePrimaryKey2 =
    Kernel.kernel "Store_compositePrimaryKey2"


-- | `compositePrimaryKey3 .a .b .c draft` — declare a three-column primary key
-- over the accessor-named columns, in that order (`PRIMARY KEY (a, b, c)`). Like
-- `compositePrimaryKey2`, each accessor is checked against the row type. For
-- four or more columns use `compositePrimaryKeyNamed`.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     type alias Reading =
--         { sensorId : String, day : String, slot : Int, value : Float }
--
--     readings : Result Error (Store Reading)
--     readings =
--         Store.fromCodec "readings" readingCodec
--             |> Result.map (Store.compositePrimaryKey3 .sensorId .day .slot)
--             |> Result.map Store.public
compositePrimaryKey3 : (row -> a) -> (row -> b) -> (row -> c) -> Draft row -> Draft row
compositePrimaryKey3 =
    Kernel.kernel "Store_compositePrimaryKey3"


-- | Mark the accessor-named column DB-assigned (serial). `insert` omits it so
-- the database generates it — a client value can never overwrite a serial column.
serial : (row -> t) -> Draft row -> Draft row
serial =
    Kernel.kernel "Store_serial"


-- | Mark the accessor-named column unique.
unique : (row -> t) -> Draft row -> Draft row
unique =
    Kernel.kernel "Store_unique"


-- | Mark the accessor-named column DB-stamped with the current time on insert.
-- `insert` omits it so the database stamps it.
defaultNow : (row -> t) -> Draft row -> Draft row
defaultNow =
    Kernel.kernel "Store_defaultNow"


-- | `defaultText accessor value store` — give the accessor-named column a
-- DB-level `DEFAULT` of the text `value`. `value` is a fixed schema literal
-- embedded directly in the `CREATE TABLE` DDL (a DDL DEFAULT admits no bound
-- parameter), so building the DDL rejects — with a typed `Err` — any `value`
-- carrying a control byte, newline, NUL, or backslash; an accepted `value` is
-- emitted through single-quote doubling, and with those bytes already refused
-- the literal cannot be broken out of under any backend's string-quoting mode.
-- A plain text default (`"active"`) is unaffected.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     withStatusDefault : Store { status : String } -> Store { status : String }
--     withStatusDefault store =
--         Store.defaultText .status "active" store
defaultText : (row -> String) -> String -> Draft row -> Draft row
defaultText =
    Kernel.kernel "Store_defaultText"


-- | `defaultInt accessor value store` — give the accessor-named column a
-- DB-level `DEFAULT` of the integer `value`. An integer has no injection
-- surface: it renders as its own decimal digits, so the emitted `DEFAULT`
-- literal is always safe.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     withRetryDefault : Store { retries : Int } -> Store { retries : Int }
--     withRetryDefault store =
--         Store.defaultInt .retries 0 store
defaultInt : (row -> Int) -> Int -> Draft row -> Draft row
defaultInt =
    Kernel.kernel "Store_defaultInt"


-- | Mark the accessor-named column a DB-stamped updated-at column. Like
-- `defaultNow` it gets `DEFAULT CURRENT_TIMESTAMP` in the schema and is OMITTED
-- from every client write (`insert`, `update`, `updateWhere`), so a client value
-- can never overwrite it — the database owns the column's value.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     withUpdatedAt : Store { updatedAt : String } -> Store { updatedAt : String }
--     withUpdatedAt store =
--         Store.touchOnUpdate .updatedAt store
touchOnUpdate : (row -> t) -> Draft row -> Draft row
touchOnUpdate =
    Kernel.kernel "Store_touchOnUpdate"


-- The stringly forms below are reached by the accessor-typed kernel intercepts
-- above, and are exported for the capability-gated `Ipe.Db.Store.Unsafe` string
-- surface (a raw-column `fromColumns` draft has no row type, so its columns can
-- only be named by a bare string). They shape the `Draft`, before classification.

primaryKeyNamed : String -> Draft a -> Draft a
primaryKeyNamed name draft =
    case draft of
        Draft r ->
            withPrimaryKey (combinePrimaryKey r.pk (Ok (SinglePk name))) draft


-- | `compositePrimaryKeyNamed columns draft` — declare a primary key over two or
-- more bare-named columns, in that order (`PRIMARY KEY (col_a, col_b, …)`). The
-- string form behind `compositePrimaryKey2` / `compositePrimaryKey3`; reach for it
-- directly for a key of four or more columns, or on a raw-column
-- (`fromColumns`) store that has no row type to name an accessor against.
-- Column names are the snake_case names `Codec.auto` derives (`userId` →
-- `"user_id"`); each is an identifier, never a bound value.
--
-- `createSql` / `migrations` render the key as one table-level constraint,
-- `PRIMARY KEY (col_a, col_b, …)`, on SQLite and Postgres alike. Refused, each
-- as a typed `Err` from `createSql`, `migrations`, and every operation that
-- reads the key:
--
--   * a list of fewer than two columns (a one-column key is `primaryKey` /
--     `primaryKeyNamed`), or a second key declaration on the same draft;
--   * a column the store does not have, or one named twice;
--   * a `serial` column on the same store (`AUTOINCREMENT` exists only on a
--     one-column `INTEGER` key);
--   * a later `renameColumn` of a key column.
--
-- The by-key operations (`get` / `update` / `delete`) need a one-column key and
-- fail closed on a composite-key store.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     type alias Shift =
--         { siteId : String, day : String, slot : Int, badge : String, notes : String }
--
--     shifts : Result Error (Store Shift)
--     shifts =
--         Store.fromCodec "shifts" shiftCodec
--             |> Result.map (Store.compositePrimaryKeyNamed [ "site_id", "day", "slot", "badge" ])
--             |> Result.map Store.public
compositePrimaryKeyNamed : List String -> Draft a -> Draft a
compositePrimaryKeyNamed columns draft =
    case draft of
        Draft r ->
            withPrimaryKey (combinePrimaryKey r.pk (parseCompositeKey columns)) draft


-- A composite key names at least two columns; a shorter list is a one-column key
-- (or no key) mis-declared, refused rather than silently narrowed.
parseCompositeKey : List String -> Result PrimaryKeyFault PrimaryKeyDecl
parseCompositeKey columns =
    if List.length columns < 2 then
        Err (CompositeKeyTooShort columns)

    else
        Ok (CompositePk columns)


-- Fold a new key declaration into the draft's current one: a table has one
-- primary key, so any declaration after the first is a `SecondPrimaryKey` fault,
-- and an earlier fault is kept (the first refusal is the one reported).
combinePrimaryKey : Result PrimaryKeyFault PrimaryKeyDecl -> Result PrimaryKeyFault PrimaryKeyDecl -> Result PrimaryKeyFault PrimaryKeyDecl
combinePrimaryKey current proposed =
    case current of
        Err fault ->
            Err fault

        Ok existing ->
            case existing of
                NoPk ->
                    proposed

                SinglePk _ ->
                    Err SecondPrimaryKey

                CompositePk _ ->
                    Err SecondPrimaryKey


withPrimaryKey : Result PrimaryKeyFault PrimaryKeyDecl -> Draft a -> Draft a
withPrimaryKey decl draft =
    case draft of
        Draft r ->
            Draft
                { table = r.table
                , frozenTable = r.frozenTable
                , frozenColumns = r.frozenColumns
                , currentColumns = r.currentColumns
                , codec = r.codec
                , specs = r.specs
                , pk = decl
                , ops = r.ops
                , indexes = r.indexes
                }


-- The one key column a by-key operation binds its value against. `NoPk` and a
-- `CompositePk` (several columns, one value) both fail closed with
-- `noPrimaryKeyError`; a refused declaration surfaces its own fault.
singleKeyColumn : Result PrimaryKeyFault PrimaryKeyDecl -> Result Error String
singleKeyColumn pk =
    case pk of
        Err fault ->
            Err (primaryKeyFaultError fault)

        Ok decl ->
            case decl of
                SinglePk keyCol ->
                    Ok keyCol

                NoPk ->
                    Err noPrimaryKeyError

                CompositePk _ ->
                    Err noPrimaryKeyError


-- Every column of the declared key (empty for `NoPk`), or the declaration's
-- fault.
primaryKeyColumns : Result PrimaryKeyFault PrimaryKeyDecl -> Result Error (List String)
primaryKeyColumns pk =
    case pk of
        Err fault ->
            Err (primaryKeyFaultError fault)

        Ok decl ->
            case decl of
                NoPk ->
                    Ok []

                SinglePk keyCol ->
                    Ok [ keyCol ]

                CompositePk cols ->
                    Ok cols


serialNamed : String -> Draft a -> Draft a
serialNamed name draft =
    addSpec (Serial name) draft


uniqueNamed : String -> Draft a -> Draft a
uniqueNamed name draft =
    addSpec (Unique name) draft


defaultNowNamed : String -> Draft a -> Draft a
defaultNowNamed name draft =
    addSpec (DefaultNow name) draft


defaultTextNamed : String -> String -> Draft a -> Draft a
defaultTextNamed name value draft =
    addSpec (DefaultText name value) draft


defaultIntNamed : String -> Int -> Draft a -> Draft a
defaultIntNamed name value draft =
    addSpec (DefaultInt name value) draft


touchOnUpdateNamed : String -> Draft a -> Draft a
touchOnUpdateNamed name draft =
    addSpec (TouchOnUpdate name) draft


addSpec : ColumnSpec -> Draft a -> Draft a
addSpec spec draft =
    case draft of
        Draft r ->
            Draft
                { table = r.table
                , frozenTable = r.frozenTable
                , frozenColumns = r.frozenColumns
                , currentColumns = r.currentColumns
                , codec = r.codec
                , specs = spec :: r.specs
                , pk = r.pk
                , ops = r.ops
                , indexes = r.indexes
                }


-- ─── Declarative index builders ────────────────────────────────────


-- | `index columns draft` — declare a non-unique performance index over one or
-- more columns of `draft`, with the index name derived from the table name and
-- the column list (`idx_<table>_<col1>_<col2>_…`). Every column in `columns`
-- must be a name present in the draft's codec-derived column list; an unknown
-- column or an invalid identifier fails closed at `create` time. Shaping the
-- schema, this refines the `Draft` before classification.
--
-- The index is emitted as a separate `CREATE INDEX` ledger entry after the
-- `CREATE TABLE` entry in `migrations`. Existing indexes are not affected
-- (idempotent when the ledger already records this entry name).
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     type alias Post =
--         { id : Int, authorId : String, publishedAt : String }
--
--     postsStore : Result Error (Store Post)
--     postsStore =
--         Store.fromCodec "posts" postCodec
--             |> Result.map (Store.serial .id)
--             |> Result.map (Store.primaryKey .id)
--             |> Result.map (Store.index [ "author_id" ])
--             |> Result.map (Store.index [ "author_id", "published_at" ])
--             |> Result.map Store.public
index : List String -> Draft a -> Draft a
index columns draft =
    addIndex (Index columns) draft


-- | `indexNamed name columns draft` — declare a non-unique performance index
-- over one or more columns of `draft`, with a caller-supplied index name.
-- `name` must pass `validSqlIdent`; every column in `columns` must be a name
-- present in the draft's codec-derived column list. An invalid name, an unknown
-- column, or an invalid column identifier fails closed at `create` time. Shaping
-- the schema, this refines the `Draft` before classification.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     type alias Post =
--         { id : Int, authorId : String, publishedAt : String }
--
--     postsStore : Result Error (Store Post)
--     postsStore =
--         Store.fromCodec "posts" postCodec
--             |> Result.map (Store.serial .id)
--             |> Result.map (Store.primaryKey .id)
--             |> Result.map (Store.indexNamed "posts_author_published" [ "author_id", "published_at" ])
--             |> Result.map Store.public
indexNamed : String -> List String -> Draft a -> Draft a
indexNamed name columns draft =
    addIndex (IndexNamed name columns) draft


addIndex : IndexSpec -> Draft a -> Draft a
addIndex spec draft =
    case draft of
        Draft r ->
            Draft
                { table = r.table
                , frozenTable = r.frozenTable
                , frozenColumns = r.frozenColumns
                , currentColumns = r.currentColumns
                , codec = r.codec
                , specs = r.specs
                , pk = r.pk
                , ops = r.ops
                , indexes = r.indexes ++ [ spec ]
                }


-- ─── Schema-evolution operators ────────────────────────────────────


-- | `renameColumn from to store` — record a column rename in the store's
-- schema-op log and update the current-column view so subsequent
-- `insert` / `get` / `all` target `to`. The frozen create columns are
-- unchanged; the rename appears as a separate ledger entry when `migrations`
-- is called.
--
-- This function is a total constructor: `from` and `to` are admitted into the
-- op log unconditionally. Identifier validation happens once, in `migrations`,
-- which is the only point SQL text is built — an invalid name therefore
-- surfaces as `Err` there, not here.
--
-- A primary-key column (of a one-column or a composite key) cannot be renamed:
-- the rename is recorded as a refused key declaration, so `createSql`,
-- `migrations`, and every operation that reads the key return a typed `Err`
-- instead of addressing the key under a name the table no longer has.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Db.Store.Unsafe as StoreU
--     import Ipe.Result as Result exposing (Result(..))
--     import Ipe.Db as Db
--     import Ipe.Task as Task
--
--     -- Build a store with a column rename in the schema-op log, then
--     -- render it to a migration list and apply it.
--     applyRename : Db -> Task Error (List String)
--     applyRename conn =
--         let
--             storeResult =
--                 Store.fromColumns "users"
--                     [ Store.textColumn "id"
--                     , Store.textColumn "name"
--                     , Store.intColumn "age"
--                     ]
--                     |> Result.map (StoreU.primaryKey "id")
--                     |> Result.map Store.public
--                     |> Result.map (Store.renameColumn "name" "full_name")
--         in
--         case storeResult |> Result.andThen Store.migrations of
--             Ok ms ->
--                 Db.migrate conn ms
--
--             Err e ->
--                 Task.fail e
renameColumn : String -> String -> Store a -> Store a
renameColumn from to store =
    case store of
        Store r ->
            Store
                { table = r.table
                , frozenTable = r.frozenTable
                , frozenColumns = r.frozenColumns
                , currentColumns = renameColumnInList from to r.currentColumns
                , codec = r.codec
                , specs = r.specs
                , pk = refuseKeyRename from r.pk
                , ops = r.ops ++ [ RenameColumn from to ]
                , indexes = r.indexes
                }


-- A rename of a primary-key column is refused as a `RenamedKeyColumn` fault:
-- the key is declared once, under the column's constructed name, and every
-- reader of it (the create DDL, the by-key operations) must agree on that name.
-- An earlier fault is kept.
refuseKeyRename : String -> Result PrimaryKeyFault PrimaryKeyDecl -> Result PrimaryKeyFault PrimaryKeyDecl
refuseKeyRename from pk =
    case primaryKeyColumns pk of
        Ok keyCols ->
            if List.member from keyCols then
                Err (RenamedKeyColumn from)

            else
                pk

        Err _ ->
            pk


renameColumnInList : String -> String -> List Column -> List Column
renameColumnInList from to cols =
    List.map
        (\col ->
            if columnName col == from then
                column to (columnColType col)

            else
                col
        )
        cols


-- | `renameTable to store` — record a table rename in the store's schema-op
-- log and update the store's active table name so subsequent `insert` / `get`
-- / `all` target `to`. The frozen create DDL retains the original table name;
-- the rename appears as a separate ledger entry when `migrations` is called.
--
-- Like `renameColumn`, this is a total constructor: `to` is admitted
-- unconditionally and validated in `migrations` when SQL text is built.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Db.Store.Unsafe as StoreU
--     import Ipe.Result as Result exposing (Result(..))
--     import Ipe.Db as Db
--     import Ipe.Task as Task
--
--     -- Build a store with a table rename, render to migrations, and apply.
--     applyTableRename : Db -> Task Error (List String)
--     applyTableRename conn =
--         let
--             storeResult =
--                 Store.fromColumns "users"
--                     [ Store.textColumn "id"
--                     , Store.textColumn "email"
--                     ]
--                     |> Result.map (StoreU.primaryKey "id")
--                     |> Result.map Store.public
--                     |> Result.map (Store.renameTable "accounts")
--         in
--         case storeResult |> Result.andThen Store.migrations of
--             Ok ms ->
--                 Db.migrate conn ms
--
--             Err e ->
--                 Task.fail e
renameTable : String -> Store a -> Store a
renameTable to store =
    case store of
        Store r ->
            Store
                { table = to
                , frozenTable = r.frozenTable
                , frozenColumns = r.frozenColumns
                , currentColumns = r.currentColumns
                , codec = r.codec
                , specs = r.specs
                , pk = r.pk
                , ops = r.ops ++ [ RenameTable r.table to ]
                , indexes = r.indexes
                }


-- | `migrations store` — fold the store's schema-op log to the ordered list of
-- ledger entries `Db.migrate` consumes: the frozen create entry (built from the
-- store's columns as first constructed) followed by one `ALTER … RENAME` entry
-- per rename op.
--
-- This is the single point where rename DDL text is assembled. Every identifier
-- that will appear in SQL — the table name and each rename's `from`/`to` — is
-- checked through `validSqlIdent` before it reaches the string. The first
-- failing identifier returns `Err` and produces no SQL. A no-op rename
-- (`from == to`) is also rejected with `noopRenameError`.
--
-- For a store with no rename ops, `migrations` yields exactly the frozen create
-- entry — identical to calling `Store.create`, which routes through here.
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Db.Store.Unsafe as StoreU
--     import Ipe.Result as Result exposing (Result(..))
--     import Ipe.Db as Db
--     import Ipe.Task as Task
--
--     -- Render a store (with a column rename) to its ordered migration list.
--     buildMigrations : Db -> Task Error (List String)
--     buildMigrations conn =
--         let
--             storeResult =
--                 Store.fromColumns "users"
--                     [ Store.textColumn "id"
--                     , Store.textColumn "name"
--                     , Store.intColumn "age"
--                     ]
--                     |> Result.map (StoreU.primaryKey "id")
--                     |> Result.map Store.public
--                     |> Result.map (Store.renameColumn "name" "full_name")
--         in
--         case storeResult |> Result.andThen Store.migrations of
--             Ok ms ->
--                 -- ms = [ { name = "create_users", sql = "CREATE TABLE …" }
--                 --       , { name = "rename_column_users_name_to_full_name"
--                 --         , sql = "ALTER TABLE users RENAME COLUMN name TO full_name"
--                 --         }
--                 --       ]
--                 Db.migrate conn ms
--
--             Err e ->
--                 Task.fail e
migrations : Store a -> Result Error (List Db.Migration)
migrations store =
    case store of
        Store r ->
            case createSqlFromColumns r.frozenTable r.frozenColumns r.specs r.pk of
                Err e ->
                    Err e

                Ok ddl ->
                    let
                        createEntry =
                            { name = migrationName r.frozenTable, sql = ddl }
                    in
                    case foldOps r.frozenTable r.ops of
                        Err e ->
                            Err e

                        Ok renameEntries ->
                            case foldIndexes r.table r.currentColumns r.indexes of
                                Err e ->
                                    Err e

                                Ok indexEntries ->
                                    Ok (createEntry :: renameEntries ++ indexEntries)


foldOps : String -> List SchemaOp -> Result Error (List Db.Migration)
foldOps tableAtCreate ops =
    case ops of
        [] ->
            Ok []

        first :: rest ->
            case opToEntry tableAtCreate first of
                Err e ->
                    Err e

                Ok entry ->
                    case foldOps (opNextTable tableAtCreate first) rest of
                        Err e ->
                            Err e

                        Ok more ->
                            Ok (entry :: more)


opNextTable : String -> SchemaOp -> String
opNextTable current op =
    case op of
        RenameTable _ to ->
            to

        RenameColumn _ _ ->
            current


opToEntry : String -> SchemaOp -> Result Error Db.Migration
opToEntry table op =
    case op of
        RenameColumn from to ->
            if from == to then
                Err noopRenameError

            else if Basics.not (validSqlIdentPlain table) then
                Err (invalidIdentError "table" table)

            else if Basics.not (validSqlIdentPlain from) then
                Err (invalidIdentError "column" from)

            else if Basics.not (validSqlIdentPlain to) then
                Err (invalidIdentError "column" to)

            else
                Ok (renameColumnEntry table from to)

        RenameTable from to ->
            if from == to then
                Err noopRenameError

            else if Basics.not (validSqlIdentPlain from) then
                Err (invalidIdentError "table" from)

            else if Basics.not (validSqlIdentPlain to) then
                Err (invalidIdentError "table" to)

            else
                Ok (renameTableEntry from to)


-- The single internal constructor for rename DDL text — the only new
-- SQL-text construction site. Both `renameColumn` and `renameTable` entries
-- are built here, exclusively from already-validated identifiers.
renameColumnEntry : String -> String -> String -> Db.Migration
renameColumnEntry table from to =
    { name =
        String.concat
            [ "rename_column_", table, "_", from, "_to_", to ]
    , sql =
        String.concat
            [ "ALTER TABLE ", table, " RENAME COLUMN ", from, " TO ", to ]
    }


renameTableEntry : String -> String -> Db.Migration
renameTableEntry from to =
    { name =
        String.concat
            [ "rename_table_", from, "_to_", to ]
    , sql =
        String.concat
            [ "ALTER TABLE ", from, " RENAME TO ", to ]
    }


-- ─── Index DDL builders ────────────────────────────────────────────
--
-- Fold the store's declared indexes to `CREATE INDEX` ledger entries. Every
-- identifier — the index name (derived or caller-supplied), the table name, and
-- each column name — passes through `validSqlIdent` before it reaches the DDL
-- string, and each column is also checked against the store's current column
-- list (parse-don't-validate: a column absent from the codec is an `Err`, never
-- silently dropped). No values are involved (DDL only) — there is no parameter
-- path for indexes.


-- Fold the store's index specs to an ordered list of ledger entries, or fail
-- closed on the first invalid identifier or unknown column.
foldIndexes : String -> List Column -> List IndexSpec -> Result Error (List Db.Migration)
foldIndexes table columns indexes =
    case indexes of
        [] ->
            Ok []

        first :: rest ->
            case indexToEntry table columns first of
                Err e ->
                    Err e

                Ok entry ->
                    case foldIndexes table columns rest of
                        Err e ->
                            Err e

                        Ok more ->
                            Ok (entry :: more)


-- Validate and build the `CREATE INDEX` ledger entry for one `IndexSpec`.
-- The table name, the index name (derived or supplied), and every column name
-- all pass through `validSqlIdent`; each column is also checked against the
-- store's current column list (a column absent from the codec is an `Err`).
indexToEntry : String -> List Column -> IndexSpec -> Result Error Db.Migration
indexToEntry table columns spec =
    case spec of
        Index cols ->
            let
                name =
                    String.concat
                        [ "idx_"
                        , table
                        , "_"
                        , String.join "_" cols
                        ]
            in
            buildIndexEntry table name cols columns

        IndexNamed name cols ->
            buildIndexEntry table name cols columns


-- Build a `CREATE INDEX` entry from already-name-resolved components, running
-- every identifier through `validSqlIdent` and each column through the store's
-- column list before constructing the DDL string. Fails on the first invalid or
-- unknown identifier with no partial SQL produced.
buildIndexEntry : String -> String -> List String -> List Column -> Result Error Db.Migration
buildIndexEntry table name cols storeColumns =
    if Basics.not (validSqlIdentPlain table) then
        Err (invalidIdentError "table" table)

    else if Basics.not (validSqlIdentPlain name) then
        Err (invalidIdentError "index" name)

    else if List.isEmpty cols then
        Err emptyIndexError

    else
        case firstInvalidIndexColumn storeColumns cols of
            Just bad ->
                Err bad

            Nothing ->
                Ok
                    { name = String.concat [ "create_index_", name ]
                    , sql =
                        String.concat
                            [ "CREATE INDEX IF NOT EXISTS "
                            , name
                            , " ON "
                            , table
                            , " ("
                            , String.join ", " cols
                            , ")"
                            ]
                    }


-- Check the first column in `cols` that either fails `validSqlIdent` or is
-- absent from the store's column list. Returns `Just (Err e)` for the first
-- bad column, `Nothing` when all are valid and present.
firstInvalidIndexColumn : List Column -> List String -> Maybe Error
firstInvalidIndexColumn storeColumns cols =
    case cols of
        [] ->
            Nothing

        name :: rest ->
            if Basics.not (validSqlIdentPlain name) then
                Just (invalidIdentError "column" name)

            else if Basics.not (hasColumn storeColumns name) then
                Just (unknownColumnError name)

            else
                firstInvalidIndexColumn storeColumns rest


emptyIndexError : Error
emptyIndexError =
    Error.invalidInput
        "Ipe.Db.Store: an index must name at least one column"


-- ─── Introspection ─────────────────────────────────────────────────


-- | The store's current table name (reflects any `renameTable` ops applied).
tableName : Store a -> String
tableName store =
    case store of
        Store r ->
            r.table


-- | The store's current column names, in declaration order (reflects any
-- `renameColumn` ops applied).
columnNames : Store a -> List String
columnNames store =
    case store of
        Store r ->
            List.map columnName r.currentColumns


-- ─── Write path ────────────────────────────────────────────────────


-- | `insert conn store row` — insert one row and return its generated id. The
-- row is projected to `(column, SqlValue)` binds through the store's codec
-- (`Ipe.Db.Codec.codecToBinds`); each binds as a typed parameter. Columns
-- marked `Serial` or `DefaultNow` are OMITTED from the insert so the database
-- fills them (a client value produced for such a column is dropped, never
-- written). Routes through the audited `Db.insertFields`, which re-validates
-- every identifier and binds every value — no SQL text is built here. A codec
-- projection that fails (a shape mismatch) is a typed `Err`.
insert : Db -> Store a -> a -> Task Error Int
insert conn store row =
    case store of
        Store r ->
            case DbCodec.codecToBinds r.codec row of
                Err e ->
                    Task.fail e

                Ok binds ->
                    Db.insertFields conn r.table (insertFields r.specs binds)


insertFields : List ColumnSpec -> List ( String, SqlValue ) -> List ( String, SqlField )
insertFields specs values =
    List.map (\pair -> insertField specs pair) values


insertField : List ColumnSpec -> ( String, SqlValue ) -> ( String, SqlField )
insertField specs pair =
    case pair of
        ( name, value ) ->
            if dbFilledColumn specs name then
                ( name, OmitField )

            else
                ( name, SetField value )


dbFilledColumn : List ColumnSpec -> String -> Bool
dbFilledColumn specs name =
    List.any (\spec -> specOmitsColumn spec name) specs


specOmitsColumn : ColumnSpec -> String -> Bool
specOmitsColumn spec name =
    case spec of
        Serial c ->
            c == name

        DefaultNow c ->
            c == name

        TouchOnUpdate c ->
            c == name

        Unique _ ->
            False

        DefaultText _ _ ->
            False

        DefaultInt _ _ ->
            False


-- | `insertReturning conn store row` — insert one row and return the stored row
-- as decoded by the store's codec, including any DB-assigned columns (such as a
-- `serial` primary key). The same OmitField logic as `insert` omits `Serial` /
-- `DefaultNow` columns from the write so the database fills them; `RETURNING *`
-- reads every column back — the DB-assigned values are present in the result.
-- The returned row is decoded through the store's own codec (the same path `all`
-- / `get` / `findWhere` use), so a schema drift (a missing column, a cell that
-- is not the declared shape) is a typed `Err`, never a wrong value.
--
-- A codec projection that fails, or a RETURNING row that does not decode to the
-- store's type, is a typed `Err`. Fails closed with no SQL on a non-record codec.
--
-- Example:
--
--     import Ipe.Db as Db exposing (Db)
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Task as Task exposing (Task)
--     import Ipe.Error exposing (Error)
--
--     type alias Item =
--         { id : Int, name : String }
--
--     -- `id` is `serial`, so the DB assigns it; `insertReturning` gives it back.
--     addItem : Db -> Store Item -> String -> Task Error Item
--     addItem conn store name =
--         Store.insertReturning conn store { id = 0, name = name }
insertReturning : Db -> Store a -> a -> Task Error a
insertReturning conn store row =
    case store of
        Store r ->
            case DbCodec.codecToBinds r.codec row of
                Err e ->
                    Task.fail e

                Ok binds ->
                    case r.codec of
                        Codec codecR ->
                            Task.andThen
                                (\results ->
                                    case results of
                                        first :: _ ->
                                            Task.succeed first

                                        [] ->
                                            Task.fail insertReturningNoRowError
                                )
                                (Db.insertFieldsReturning
                                    conn
                                    r.table
                                    (insertFields r.specs binds)
                                    "*"
                                    (codecR.mkDec {})
                                )


insertReturningNoRowError : Error
insertReturningNoRowError =
    Error.invalidInput
        "Ipe.Db.Store: insertReturning did not receive a RETURNING row from the database"


-- | `update conn store row` — update the row whose primary key matches `row`'s
-- primary-key field, setting every non-generated column from `row`, and return
-- the updated-row count. The whole record is projected through the store's codec
-- (`Ipe.Db.Codec.codecToBinds`); the primary-key bind scopes the UPDATE (its
-- own validated `pk` column, never a caller identifier), and columns marked
-- `Serial` or `DefaultNow` are OMITTED from the SET so a client value can never
-- overwrite a DB-filled column. Routes through the audited `Db.updateFields`,
-- which re-validates every identifier, binds every value, and refuses an
-- unscoped UPDATE — no SQL text is built here. A store with no primary key, or a
-- record whose primary-key column is absent from the codec projection, fails
-- closed with a typed `Err`.
--
-- Example:
--
--     import Ipe.Db as Db exposing (Db)
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Task as Task exposing (Task)
--     import Ipe.Error exposing (Error)
--
--     type alias User =
--         { id : String, name : String, age : Int }
--
--     renameUser : Db -> Store User -> User -> Task Error Int
--     renameUser conn store user =
--         Store.update conn store { user | name = "renamed" }
update : Db -> Store a -> a -> Task Error Int
update conn store row =
    case store of
        Store r ->
            case singleKeyColumn r.pk of
                Err e ->
                    Task.fail e

                Ok keyCol ->
                    case DbCodec.codecToBinds r.codec row of
                        Err e ->
                            Task.fail e

                        Ok binds ->
                            case bindValue keyCol binds of
                                Nothing ->
                                    Task.fail (missingKeyBindError keyCol)

                                Just keyValue ->
                                    Db.updateFields conn
                                        r.table
                                        [ ( keyCol, keyValue ) ]
                                        (updateSetFields r.specs keyCol binds)


-- Project the codec binds to the UPDATE SET fields: the primary-key column is
-- dropped (it scopes the WHERE, never the SET), and each `Serial` / `DefaultNow`
-- column becomes `OmitField` so the database keeps its own value.
updateSetFields : List ColumnSpec -> String -> List ( String, SqlValue ) -> List ( String, SqlField )
updateSetFields specs keyCol values =
    List.map (\pair -> updateSetField specs pair)
        (List.filter (\pair -> Basics.not (bindNameIs keyCol pair)) values)


updateSetField : List ColumnSpec -> ( String, SqlValue ) -> ( String, SqlField )
updateSetField specs pair =
    case pair of
        ( name, value ) ->
            if dbFilledColumn specs name then
                ( name, OmitField )

            else
                ( name, SetField value )


bindNameIs : String -> ( String, SqlValue ) -> Bool
bindNameIs target pair =
    case pair of
        ( name, _ ) ->
            name == target


-- The `SqlValue` bound to `target` in a codec projection, or `Nothing` when the
-- projection names no such column.
bindValue : String -> List ( String, SqlValue ) -> Maybe SqlValue
bindValue target binds =
    case binds of
        [] ->
            Nothing

        first :: rest ->
            case first of
                ( name, value ) ->
                    if name == target then
                        Just value

                    else
                        bindValue target rest


-- | `updateWhere conn store cond row` — set every non-DB-filled, non-key column
-- of every row matching `cond` from `row`, and return the updated-row count. The
-- WHERE is `cond` lowered to an audited `SqlFragment` against the store's own
-- columns (an unknown column fails closed with a typed `Err`, exactly as `where`
-- does), so no caller identifier or value reaches the SQL text — every value
-- binds as a parameter. The SET is `row` projected through the store's codec
-- (`Ipe.Db.Codec.codecToBinds`); columns marked `Serial` / `DefaultNow` /
-- `touchOnUpdate` are OMITTED so a client value can never overwrite a DB-filled
-- column, and the primary key is OMITTED too — a bulk update refines existing
-- rows, it never rewrites their identity (which would collapse every matching
-- row onto one key). Routes through the audited `Db.updateWhere`, which
-- re-validates the table and SET columns, binds every value, and refuses an
-- unscoped UPDATE.
--
-- Example:
--
--     import Ipe.Db as Db exposing (Db)
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Task as Task exposing (Task)
--     import Ipe.Error exposing (Error)
--
--     type alias User =
--         { id : String, name : String, age : Int }
--
--     renameAdults : Db -> Store User -> User -> Task Error Int
--     renameAdults conn store template =
--         Store.updateWhere conn store (Store.eq .active True) template
updateWhere : Db -> Store a -> Cond a -> a -> Task Error Int
updateWhere conn store cond row =
    case store of
        Store r ->
            if Basics.not (condConstrainsColumn cond) then
                Task.fail unconstrainedMutationError

            else
                case condFragmentIn r.currentColumns cond of
                    Err e ->
                        Task.fail e

                    Ok frag ->
                        case DbCodec.codecToBinds r.codec row of
                            Err e ->
                                Task.fail e

                            Ok binds ->
                                case primaryKeyColumns r.pk of
                                    Err e ->
                                        Task.fail e

                                    Ok keyCols ->
                                        Db.updateWhere conn
                                            r.table
                                            (updateWhereSetFields r.specs keyCols binds)
                                            frag


-- Project the codec binds to the UPDATE SET fields for a WHERE-scoped update:
-- every DB-filled column (`Serial` / `DefaultNow` / `touchOnUpdate`) becomes
-- `OmitField` so the database keeps its own value, every primary-key column is
-- dropped entirely (a WHERE-scoped update never rewrites row identity), and
-- every other column is a bound `SetField`.
updateWhereSetFields : List ColumnSpec -> List String -> List ( String, SqlValue ) -> List ( String, SqlField )
updateWhereSetFields specs keyCols values =
    List.map (\pair -> updateSetField specs pair)
        (List.filter (\pair -> Basics.not (bindIsKey keyCols pair)) values)


bindIsKey : List String -> ( String, SqlValue ) -> Bool
bindIsKey keyCols pair =
    case pair of
        ( name, _ ) ->
            List.member name keyCols


-- | `deleteWhere conn store cond` — delete every row matching `cond` and return
-- the deleted-row count. The WHERE is `cond` lowered to an audited `SqlFragment`
-- against the store's own columns (an unknown column fails closed with a typed
-- `Err`, exactly as `where` does); no caller identifier or value reaches the SQL
-- text. Routes through the audited `Db.deleteWhere`.
--
-- Example:
--
--     import Ipe.Db as Db exposing (Db)
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Task as Task exposing (Task)
--     import Ipe.Error exposing (Error)
--
--     type alias User =
--         { id : String, name : String, age : Int }
--
--     purgeMinors : Db -> Store User -> Task Error Int
--     purgeMinors conn store =
--         Store.deleteWhere conn store (Store.eq .active False)
deleteWhere : Db -> Store a -> Cond a -> Task Error Int
deleteWhere conn store cond =
    case store of
        Store r ->
            if Basics.not (condConstrainsColumn cond) then
                Task.fail unconstrainedMutationError

            else
                case condFragmentIn r.currentColumns cond of
                    Err e ->
                        Task.fail e

                    Ok frag ->
                        Db.deleteWhere conn r.table frag


-- Whether `cond` constrains at least one column: True when its `Cond` tree
-- contains any leaf (`Compare` / `Like` / `IsNull` / `NotNull` / `InList`, each
-- of which names a store column), False when it is only connectives over no
-- leaves. `and []` (→ `(1 = 1)`, matches every row), `or []` (→ `(1 = 0)`), and
-- `not` / `and` / `or` nests that bottom out in empty lists all constrain no
-- column. The mutation surface (`updateWhere` / `deleteWhere`) refuses such an
-- unconstrained condition, so a dynamically-empty condition list can never
-- silently become an update-all / delete-all. The read path keeps the all-rows
-- semantics — an unconstrained query is non-destructive.
condConstrainsColumn : Cond row -> Bool
condConstrainsColumn cond =
    case cond of
        Compare _ _ _ ->
            True

        Like _ _ ->
            True

        IsNull _ ->
            True

        NotNull _ ->
            True

        InList _ _ ->
            True

        AndList conds ->
            List.any condConstrainsColumn conds

        OrList conds ->
            List.any condConstrainsColumn conds

        NotCond inner ->
            condConstrainsColumn inner


-- ─── Read path ─────────────────────────────────────────────────────


-- | `all conn store` — read every row and decode each through the store's
-- codec. Routes through `Db.findWhere` with an always-true predicate, so the
-- table name is kernel-validated and no raw SQL is built. A row that does not
-- decode to the store's type is a typed `Err`, never a wrong value.
all : Db -> Store a -> Task Error (List a)
all conn store =
    case store of
        Store r ->
            Task.andThen
                (\rows -> decodeRows r.codec rows)
                (Db.findWhere conn r.table alwaysTrue)


-- | `findWhere conn store cond` — read the rows matching `cond` and decode each
-- through the store's codec. `cond` is a `SqlFragment` built from the
-- `Ipe.Db.Sql` combinators: every column flows through `Sql.column`
-- (validated), every value through `Sql.param` (bound). Store adds no injection
-- surface over the audited fragment builder.
findWhere : Db -> Store a -> SqlFragment -> Task Error (List a)
findWhere conn store cond =
    case store of
        Store r ->
            Task.andThen
                (\rows -> decodeRows r.codec rows)
                (Db.findWhere conn r.table cond)


-- | `get conn store keyValue` — read the single row whose primary key equals
-- `keyValue`, or `Nothing`, decoded through the store's codec. Keys on the
-- store's own validated `pk` column, never a caller identifier; the value binds
-- as a parameter. A store with no primary key fails closed with a typed error.
get : Db -> Store a -> SqlValue -> Task Error (Maybe a)
get conn store keyValue =
    case store of
        Store r ->
            case singleKeyColumn r.pk of
                Err e ->
                    Task.fail e

                Ok keyCol ->
                    Task.andThen
                        (\rows -> firstDecoded r.codec rows)
                        (Db.findWhere conn r.table (keyEquals keyCol keyValue))


-- | `findBy conn store col value` — read every row whose `col` equals `value`,
-- decoded through the store's codec. `col` is validated against the store's own
-- derived column list before any SQL is built (a name absent from the codec's
-- columns is a typed `Err`, parse-don't-validate), then reaches SQL only through
-- `Sql.column`; `value` binds as a parameter through `Sql.param`. This is the
-- convenience single-column equality read; a compound predicate uses the query
-- builder (`query |> where …`) or the raw-fragment escape `findWhere`.
--
-- Example:
--
--     import Ipe.Db as Db exposing (Db)
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Task as Task exposing (Task)
--     import Ipe.Error exposing (Error)
--
--     type alias User =
--         { id : String, name : String, age : Int }
--
--     adults : Db -> Store User -> Task Error (List User)
--     adults conn store =
--         Store.findBy conn store "age" (SqlInt 18)
findBy : Db -> Store a -> String -> SqlValue -> Task Error (List a)
findBy conn store col value =
    case store of
        Store r ->
            if Basics.not (hasColumn r.currentColumns col) then
                Task.fail (unknownColumnError col)

            else
                Task.andThen
                    (\rows -> decodeRows r.codec rows)
                    (Db.findWhere conn r.table (keyEquals col value))


-- Whether `name` is one of the store's current columns — the derived vocabulary
-- a stringly column name must belong to before it can reach SQL.
hasColumn : List Column -> String -> Bool
hasColumn columns name =
    List.any (\col -> columnName col == name) columns


-- ─── External-connection reads (foreign DB through one codec) ───────
--
-- The `…On` reads take an external `Connection mode` (mode-polymorphic: a read
-- is available on `ReadOnly` and `ReadWrite` alike) instead of the app's `Db`,
-- so a monitoring/ETL job reads a foreign source of a DIFFERENT dialect through
-- the SAME store codec. They route through `Db.findWhereOn` over a `Sql.*`-built
-- `SqlFragment` — identical validated-identifier + bound-parameter barrier as
-- the app reads, run against the external pool. There is no external write path:
-- a foreign write is unrepresentable on `Connection ReadOnly` by type.


-- | `allOn conn store` — read every row from an external connection and decode
-- each through the store's codec. The external counterpart to `all`.
allOn : Connection mode -> Store a -> Task Error (List a)
allOn conn store =
    case store of
        Store r ->
            Task.andThen
                (\rows -> decodeRows r.codec rows)
                (Db.findWhereOn conn r.table alwaysTrue)


-- | `findWhereOn conn store cond` — read the rows matching `cond` from an
-- external connection and decode each through the store's codec. The external
-- counterpart to `findWhere`; the same audited `SqlFragment` barrier applies.
findWhereOn : Connection mode -> Store a -> SqlFragment -> Task Error (List a)
findWhereOn conn store cond =
    case store of
        Store r ->
            Task.andThen
                (\rows -> decodeRows r.codec rows)
                (Db.findWhereOn conn r.table cond)


-- | `getOn conn store keyValue` — read the single row whose primary key equals
-- `keyValue` from an external connection, or `Nothing`, decoded through the
-- store's codec. The external counterpart to `get`; keys on the store's
-- validated `pk`, binds the value as a parameter, and fails closed for a store
-- with no primary key.
getOn : Connection mode -> Store a -> SqlValue -> Task Error (Maybe a)
getOn conn store keyValue =
    case store of
        Store r ->
            case singleKeyColumn r.pk of
                Err e ->
                    Task.fail e

                Ok keyCol ->
                    Task.andThen
                        (\rows -> firstDecoded r.codec rows)
                        (Db.findWhereOn conn r.table (keyEquals keyCol keyValue))


-- | `delete conn store keyValue` — delete the row whose primary key equals
-- `keyValue` and return the deleted-row count. Keys on the validated `pk`
-- column; the value binds as a parameter. A store with no primary key fails
-- closed.
delete : Db -> Store a -> SqlValue -> Task Error Int
delete conn store keyValue =
    case store of
        Store r ->
            case singleKeyColumn r.pk of
                Err e ->
                    Task.fail e

                Ok keyCol ->
                    Db.deleteWhere conn r.table (keyEquals keyCol keyValue)


keyEquals : String -> SqlValue -> SqlFragment
keyEquals keyCol keyValue =
    Sql.eq (Sql.column keyCol) (Sql.param keyValue)


-- | An always-true fragment (`1 = 1`): the predicate for an unfiltered read. It
-- names no caller identifier, so it introduces no injection surface.
alwaysTrue : SqlFragment
alwaysTrue =
    Sql.eq (Sql.param (SqlInt 1)) (Sql.param (SqlInt 1))


decodeRows : Codec a -> List Row -> Task Error (List a)
decodeRows codec rows =
    case rows of
        [] ->
            Task.succeed []

        first :: rest ->
            case DbCodec.codecFromRow codec first of
                Err e ->
                    Task.fail e

                Ok value ->
                    Task.map (\more -> value :: more) (decodeRows codec rest)


firstDecoded : Codec a -> List Row -> Task Error (Maybe a)
firstDecoded codec rows =
    case rows of
        [] ->
            Task.succeed Nothing

        first :: _ ->
            case DbCodec.codecFromRow codec first of
                Err e ->
                    Task.fail e

                Ok value ->
                    Task.succeed (Just value)


-- ─── Typed query builder (Cond → SqlFragment) ──────────────────────
--
-- A `Query a` is a filtered, ordered, paginated read over a `Store a`. Its
-- `WHERE` is a `Cond`: a closed ADT of typed leaves (a validated column name +
-- a bound `SqlValue`) that lowers, only at the terminal `toList` / `toMaybe` /
-- `count`, to the audited `SqlFragment` — every column through `Sql.column`,
-- every value through `Sql.param`. No leaf builds SQL text, so the builder adds
-- no injection surface over the fragment builder it lowers to. A column named in
-- a leaf is validated against the store's own derived column list at lowering
-- time (a name absent from the codec's columns is a typed `Err`), so a stringly
-- column that is not a real store column fails closed before any SQL is issued.
--
-- `ORDER BY` / `LIMIT` / `OFFSET` are applied in Ipê over the fetched rows: the
-- `WHERE` runs at the SQL layer (the injection-safe fragment), and the fetched
-- rows are then sorted by the ordered columns (numeric-aware for `CInt` / `CReal`
-- columns, lexicographic otherwise, per the store's own column types) and sliced.
-- No ordering identifier ever reaches SQL text, so the ordered surface adds no
-- injection surface either.


-- | A comparison operator carried by a query leaf. A typed ADT, not a stringly
-- operator, so a leaf can only name one of the six comparisons the fragment
-- builder provides.
type CompareOp
    = OpEq
    | OpNeq
    | OpGt
    | OpGte
    | OpLt
    | OpLte


-- | A typed `WHERE` predicate over a `Store row`'s rows. The `row` parameter
-- ties the predicate to the row type it queries: an accessor-typed leaf
-- (`eq .age 18`) fixes `row` to the store's row type, so a column from one row
-- type cannot be used against another, and a value's type must match the field's.
-- Built only through the leaf combinators (`eq` / `eqBy`) and the connectives
-- (`and` / `or` / `not`); it carries a validated column name and a bound value as
-- pure data and lowers to a `SqlFragment` at query time. The `row` parameter is a
-- phantom over the data — the constructors carry only the concrete column/value —
-- so the runtime `Cond` is untyped data while the surface stays row-checked.
type Cond row
    = Compare CompareOp String SqlValue
    | Like String String
    | IsNull String
    | NotNull String
    | InList String (List SqlValue)
    | AndList (List (Cond row))
    | OrList (List (Cond row))
    | NotCond (Cond row)


-- | A filtered, ordered, paginated read over a `Store a`, decoded through the
-- store's codec at `toList` / `toMaybe` / `count`. Built through `query` and
-- refined by `where` / `orderAsc` / `orderDesc` / `limit` / `offset`. Opaque:
-- the store it reads and the codec it decodes with cannot drift, because both
-- come from the single `Store a` `query` captured.
--
-- `frag` is the accumulated `WHERE` fragment: each `where` lowers its `Cond` to
-- an audited `SqlFragment` EAGERLY (parse-don't-validate — the store is in hand,
-- so every column is validated against the store's own columns at that moment)
-- and conjoins it. `orderings` carries each ordering column as an `OrderKey`
-- `(name, cellType, dir)`, `cellType` resolved from the store's column type when
-- the ordering is added, so the raw-row sort compares numerically for `CInt` /
-- `CReal` columns without re-consulting the store. `poison` holds the first
-- fail-closed error (an unknown column named by a `where` leaf or an ordering);
-- a poisoned query issues no SQL and fails at the terminal step.
type Query a
    = Query
        { store : Store a
        , frag : Maybe SqlFragment
        , orderings : List OrderKey
        , lim : Maybe Int
        , off : Maybe Int
        , poison : Maybe Error
        }


-- | `query store` — begin a read over `store` with no filter, ordering, or
-- pagination. Refine it with `where` / `orderAsc` / `orderDesc` / `limit` /
-- `offset`, then run it with `toList` / `toMaybe` / `count`.
--
-- Example:
--
--     import Ipe.Db as Db exposing (Db)
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Task as Task exposing (Task)
--     import Ipe.Error exposing (Error)
--
--     type alias User =
--         { id : String, name : String, age : Int }
--
--     topAdults : Db -> Store User -> Task Error (List User)
--     topAdults conn store =
--         Store.query store
--             |> Store.where (Store.eq .age 18)
--             |> Store.orderDesc "age"
--             |> Store.limit 10
--             |> Store.toList conn
query : Store a -> Query a
query store =
    Query
        { store = store
        , frag = Nothing
        , orderings = []
        , lim = Nothing
        , off = Nothing
        , poison = Nothing
        }


-- | `where cond q` — restrict `q` to the rows matching `cond`. Applying `where`
-- more than once AND-joins the predicates, so a pipeline of `where` clauses
-- reads as a conjunction.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.eq .status "active")
--         |> Store.where (Store.eq .active True)
where : Cond a -> Query a -> Query a
where cond q =
    case q of
        Query r ->
            case r.store of
                Store s ->
                    case condFragmentIn s.currentColumns cond of
                        Err e ->
                            Query
                                { store = r.store
                                , frag = r.frag
                                , orderings = r.orderings
                                , lim = r.lim
                                , off = r.off
                                , poison = firstPoison r.poison e
                                }

                        Ok lowered ->
                            Query
                                { store = r.store
                                , frag = Just (conjoinFrag r.frag lowered)
                                , orderings = r.orderings
                                , lim = r.lim
                                , off = r.off
                                , poison = r.poison
                                }


conjoinFrag : Maybe SqlFragment -> SqlFragment -> SqlFragment
conjoinFrag existing added =
    case existing of
        Nothing ->
            added

        Just prior ->
            Sql.and prior added


-- Keep the FIRST fail-closed error a query accrues: a later error does not mask
-- the earliest cause.
firstPoison : Maybe Error -> Error -> Maybe Error
firstPoison existing e =
    case existing of
        Just _ ->
            existing

        Nothing ->
            Just e


-- ── Comparison leaf ────────────────────────────────────────────────


-- | `eq accessor value` — the rows where the record column named by the field
-- `accessor` equals `value`. The column is named by an accessor literal (e.g.
-- `.age`), so it is checked against the row type at compile time; the value's
-- type is pinned to the field's type, so a mismatched literal is a type error.
-- The column identifier is derived and validated at lowering, and `value` binds
-- as a parameter — never interpolated.
--
-- The field type must be a scalar (`String` / `Int` / `Bool` / `Float`). A
-- column whose field is an enum or newtype needs its codec: use `eqBy`.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.eq .age 18)
eq : (row -> value) -> value -> Cond row
eq =
    Kernel.kernel "Store_eq"


-- | `eqBy codec accessor value` — the accessor-typed equality leaf for an ENUM
-- or newtype column, whose wire form is not type-derivable. `codec` is the
-- field's own codec: `value` is projected through it to a bound `SqlValue`, so
-- the stored wire form and the query's bound value agree by construction. The
-- column is named by the accessor literal (checked against the row type) and
-- validated at lowering; `value` binds as a parameter.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.eqBy rankCodec .rank Gold)
eqBy : Codec value -> (row -> value) -> value -> Cond row
eqBy =
    Kernel.kernel "Store_eqBy"


-- The lowered form of `eqBy`: the accessor `.field` (checked against the row
-- type at compile time) has already been turned into the validated column name
-- `col`, so this builds the value-carrying `Cond`. `codec` projects `v` to one
-- bound `SqlValue` through `Ipe.Db.Codec.toSqlValue` (a scalar-shaped codec — an
-- enum or newtype), which the `Compare` leaf later lowers to `Sql.param`. A codec
-- that is not scalar-shaped, or a value that does not encode to its declared
-- `ColType`, fails closed to the always-false `Cond` (`OrList []`) — the query
-- matches no row rather than binding a wrong value.
--
-- Reached only through the `Store.eqBy` lowering intercept, which supplies `col`;
-- not exported, so `col` is never a caller-supplied string.
eqByNamed : String -> Codec value -> value -> Cond row
eqByNamed col codec v =
    case DbCodec.toSqlValue codec v of
        Ok sqlValue ->
            Compare OpEq col sqlValue

        Err _ ->
            OrList []


-- | `neq accessor value` — the rows where the column named by `accessor` is
-- NOT equal to `value`. Scalar fields only; for an enum or newtype column use
-- `neqBy`.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.neq .status "deleted")
neq : (row -> value) -> value -> Cond row
neq =
    Kernel.kernel "Store_neq"


-- | `neqBy codec accessor value` — the accessor-typed not-equal leaf for an
-- enum or newtype column. Projects `value` through `codec` to a bound
-- `SqlValue`; the column is named by the accessor literal.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.neqBy rankCodec .rank Gold)
neqBy : Codec value -> (row -> value) -> value -> Cond row
neqBy =
    Kernel.kernel "Store_neqBy"


neqByNamed : String -> Codec value -> value -> Cond row
neqByNamed col codec v =
    case DbCodec.toSqlValue codec v of
        Ok sqlValue ->
            Compare OpNeq col sqlValue

        Err _ ->
            OrList []


-- | `gt accessor value` — the rows where the column named by `accessor` is
-- greater than `value`. Scalar fields only; for an enum or newtype column use
-- `gtBy`.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.gt .age 18)
gt : (row -> value) -> value -> Cond row
gt =
    Kernel.kernel "Store_gt"


-- | `gtBy codec accessor value` — the accessor-typed greater-than leaf for an
-- enum or newtype column.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.gtBy priceCodec .price minPrice)
gtBy : Codec value -> (row -> value) -> value -> Cond row
gtBy =
    Kernel.kernel "Store_gtBy"


gtByNamed : String -> Codec value -> value -> Cond row
gtByNamed col codec v =
    case DbCodec.toSqlValue codec v of
        Ok sqlValue ->
            Compare OpGt col sqlValue

        Err _ ->
            OrList []


-- | `gte accessor value` — the rows where the column named by `accessor` is
-- greater than or equal to `value`. Scalar fields only; use `gteBy` for enum
-- or newtype columns.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.gte .age 18)
gte : (row -> value) -> value -> Cond row
gte =
    Kernel.kernel "Store_gte"


-- | `gteBy codec accessor value` — the accessor-typed greater-than-or-equal
-- leaf for an enum or newtype column.
gteBy : Codec value -> (row -> value) -> value -> Cond row
gteBy =
    Kernel.kernel "Store_gteBy"


gteByNamed : String -> Codec value -> value -> Cond row
gteByNamed col codec v =
    case DbCodec.toSqlValue codec v of
        Ok sqlValue ->
            Compare OpGte col sqlValue

        Err _ ->
            OrList []


-- | `lt accessor value` — the rows where the column named by `accessor` is
-- less than `value`. Scalar fields only; use `ltBy` for enum or newtype
-- columns.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.lt .age 65)
lt : (row -> value) -> value -> Cond row
lt =
    Kernel.kernel "Store_lt"


-- | `ltBy codec accessor value` — the accessor-typed less-than leaf for an
-- enum or newtype column.
ltBy : Codec value -> (row -> value) -> value -> Cond row
ltBy =
    Kernel.kernel "Store_ltBy"


ltByNamed : String -> Codec value -> value -> Cond row
ltByNamed col codec v =
    case DbCodec.toSqlValue codec v of
        Ok sqlValue ->
            Compare OpLt col sqlValue

        Err _ ->
            OrList []


-- | `lte accessor value` — the rows where the column named by `accessor` is
-- less than or equal to `value`. Scalar fields only; use `lteBy` for enum or
-- newtype columns.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.lte .age 64)
lte : (row -> value) -> value -> Cond row
lte =
    Kernel.kernel "Store_lte"


-- | `lteBy codec accessor value` — the accessor-typed less-than-or-equal leaf
-- for an enum or newtype column.
lteBy : Codec value -> (row -> value) -> value -> Cond row
lteBy =
    Kernel.kernel "Store_lteBy"


lteByNamed : String -> Codec value -> value -> Cond row
lteByNamed col codec v =
    case DbCodec.toSqlValue codec v of
        Ok sqlValue ->
            Compare OpLte col sqlValue

        Err _ ->
            OrList []


-- | `like accessor pattern` — the rows where the `String` column named by
-- `accessor` matches the SQL `LIKE` `pattern`. The pattern binds as a
-- parameter (wildcards `%` / `_` are DATA the SQL engine interprets, never
-- SQL text the caller injects). The accessor must name a `String` field.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.like .name "al%")
like : (row -> String) -> String -> Cond row
like =
    Kernel.kernel "Store_like"


-- | `isNull accessor` — the rows where the column named by `accessor` is SQL
-- NULL. The accessor names the column; no value argument.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.isNull .deletedAt)
isNull : (row -> t) -> Cond row
isNull =
    Kernel.kernel "Store_isNull"


-- | `notNull accessor` — the rows where the column named by `accessor` is NOT
-- SQL NULL.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.notNull .email)
notNull : (row -> t) -> Cond row
notNull =
    Kernel.kernel "Store_notNull"


-- | `inList accessor values` — the rows where the column named by `accessor`
-- is one of the scalar `values`. Each value binds as a parameter. An empty
-- list matches no row (`(1 = 0)`, the identity of disjunction).
--
-- The field type must be scalar (`String` / `Int` / `Bool` / `Float`). For
-- an enum or newtype column use `inListBy`.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.inList .status [ "active", "trial" ])
inList : (row -> value) -> List value -> Cond row
inList =
    Kernel.kernel "Store_inList"


-- | `inListBy codec accessor values` — the accessor-typed IN-list leaf for an
-- enum or newtype column. Each element in `values` is projected through
-- `codec` to a bound `SqlValue`; elements that fail the projection are
-- dropped (the remaining elements still form the IN clause). An empty or
-- all-dropped list matches no row (`OrList []`).
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.inListBy rankCodec .rank [ Gold, Silver ])
inListBy : Codec value -> (row -> value) -> List value -> Cond row
inListBy =
    Kernel.kernel "Store_inListBy"


-- The lowered form of `inListBy`: the accessor `.field` has already been
-- turned into the validated column name `col`. Each element of `values` is
-- projected through `codec`; elements that fail the projection are dropped.
-- An empty result (no values survive projection) lowers to the always-false
-- `Cond` (`OrList []`).
--
-- Reached only through the `Store.inListBy` lowering intercept, which
-- supplies `col`; not exported.
inListByNamed : String -> Codec value -> List value -> Cond row
inListByNamed col codec values =
    let
        sqlValues =
            List.filterMap (\v -> Result.toMaybe (DbCodec.toSqlValue codec v)) values
    in
    if List.isEmpty sqlValues then
        OrList []

    else
        InList col sqlValues


-- The lowered form of `inList` (scalar): the accessor `.field` has been
-- turned into the validated column name `col`, and `sqlValues` is the
-- already-mapped `List SqlValue`. An empty list lowers to the always-false
-- `Cond`.
--
-- Reached only through the `Store.inList` lowering intercept; not exported.
inListNamed : String -> List SqlValue -> Cond row
inListNamed col sqlValues =
    if List.isEmpty sqlValues then
        OrList []

    else
        InList col sqlValues


-- ── Connectives ────────────────────────────────────────────────────


-- | `and conds` — the rows matching EVERY condition in `conds`. An empty list
-- matches every row (the identity of conjunction, `(1 = 1)`).
--
-- Example:
--
--     Store.query store
--         |> Store.where
--             (Store.and
--                 [ Store.eq .active True
--                 , Store.eq .status "active"
--                 ]
--             )
and : List (Cond row) -> Cond row
and conds =
    AndList conds


-- | `or conds` — the rows matching ANY condition in `conds`. An empty list
-- matches no row (the identity of disjunction, `(1 = 0)`).
--
-- Example:
--
--     Store.query store
--         |> Store.where
--             (Store.or
--                 [ Store.eq .status "active"
--                 , Store.eq .status "trial"
--                 ]
--             )
or : List (Cond row) -> Cond row
or conds =
    OrList conds


-- | `not cond` — the rows NOT matching `cond`.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.not (Store.eq .status "deleted"))
not : Cond row -> Cond row
not cond =
    NotCond cond


-- ── Ordering and pagination ────────────────────────────────────────


-- | `orderAsc col q` — order `q`'s rows by `col` ascending. Repeated ordering
-- clauses compose left to right (the first is the primary sort key). The column
-- is validated against the store's columns at query time.
--
-- Example:
--
--     Store.query store
--         |> Store.orderAsc "name"
orderAsc : String -> Query a -> Query a
orderAsc col q =
    addOrdering col Ascending q


-- | `orderDesc col q` — order `q`'s rows by `col` descending.
--
-- Example:
--
--     Store.query store
--         |> Store.orderDesc "age"
orderDesc : String -> Query a -> Query a
orderDesc col q =
    addOrdering col Descending q


addOrdering : String -> SortDir -> Query a -> Query a
addOrdering col dir q =
    case q of
        Query r ->
            case r.store of
                Store s ->
                    case columnTypeOf s.currentColumns col of
                        Nothing ->
                            Query
                                { store = r.store
                                , frag = r.frag
                                , orderings = r.orderings
                                , lim = r.lim
                                , off = r.off
                                , poison = firstPoison r.poison (unknownColumnError col)
                                }

                        Just colType ->
                            Query
                                { store = r.store
                                , frag = r.frag
                                , orderings = r.orderings ++ [ ( col, cellTypeOf colType, dir ) ]
                                , lim = r.lim
                                , off = r.off
                                , poison = r.poison
                                }


-- | `limit n q` — keep at most `n` rows (applied after ordering). A negative or
-- zero `n` keeps no rows.
--
-- Example:
--
--     Store.query store
--         |> Store.orderDesc "age"
--         |> Store.limit 10
limit : Int -> Query a -> Query a
limit n q =
    case q of
        Query r ->
            Query
                { store = r.store
                , frag = r.frag
                , orderings = r.orderings
                , lim = Just n
                , off = r.off
                , poison = r.poison
                }


-- | `offset n q` — skip the first `n` rows (applied after ordering, before
-- `limit`). A negative or zero `n` skips none.
--
-- Example:
--
--     Store.query store
--         |> Store.orderAsc "name"
--         |> Store.offset 20
--         |> Store.limit 10
offset : Int -> Query a -> Query a
offset n q =
    case q of
        Query r ->
            Query
                { store = r.store
                , frag = r.frag
                , orderings = r.orderings
                , lim = r.lim
                , off = Just n
                , poison = r.poison
                }


-- ── Running a query ────────────────────────────────────────────────


-- | `toList conn q` — run `q` and decode every matching row through the store's
-- codec. The `WHERE` runs as an audited `SqlFragment` at the SQL layer; the
-- fetched rows are ordered and paginated in Ipê, then decoded. A row that does
-- not decode to the store's type, or a column name that is not one of the
-- store's columns, is a typed `Err`.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.eq .age 18)
--         |> Store.orderDesc "age"
--         |> Store.limit 10
--         |> Store.toList conn
toList : Db -> Query a -> Task Error (List a)
toList conn q =
    case q of
        Query r ->
            case r.poison of
                Just e ->
                    Task.fail e

                Nothing ->
                    case r.store of
                        Store s ->
                            Task.andThen
                                (\rows -> decodeRows s.codec (paginateRows r.orderings r.off r.lim rows))
                                (Db.findWhere conn s.table (queryFrag r.frag))


-- The `WHERE` fragment a query runs: its accumulated fragment, or the
-- always-true `(1 = 1)` when no `where` was applied (an unfiltered read). Names
-- no caller identifier in the empty case, so it adds no injection surface.
queryFrag : Maybe SqlFragment -> SqlFragment
queryFrag maybeFrag =
    case maybeFrag of
        Just frag ->
            frag

        Nothing ->
            trueFragment


-- Whether a raw-row cell is compared as a number or as text. Replaces a bare
-- `Bool` so the ordering key is self-documenting and the two ordering flags can
-- never be swapped.
type CellType
    = NumericCell
    | TextCell


-- The sort direction for an ordering key. Replaces a bare `Bool` so `Ascending`
-- / `Descending` reads at the call site instead of a positional `True` / `False`.
type SortDir
    = Ascending
    | Descending


-- The ordering key a raw sort needs: the column NAME (to read the cell), whether
-- its store column type is compared numerically (`CellType`), and the sort
-- direction (`SortDir`). The two named sum types replace the old positional
-- `( String, Bool, Bool )` so a mis-ordered flag pair is unrepresentable.
-- Carries no `ColType`, so the `Query` record it lives on references only
-- built-in and this module's own types.
type alias OrderKey =
    ( String, CellType, SortDir )


-- | `toMaybe conn q` — run `q` and decode the FIRST matching row (after ordering
-- and pagination) through the store's codec, or `Nothing`. A `limit 1` is not
-- required; `toMaybe` reads the head of the ordered result.
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.eq .email "a@example.com")
--         |> Store.toMaybe conn
toMaybe : Db -> Query a -> Task Error (Maybe a)
toMaybe conn q =
    Task.map List.head (toList conn q)


-- | `count conn q` — run `q`'s filter and return how many rows match. Ordering
-- and pagination do not affect the count of matched rows (the filter alone
-- decides membership).
--
-- Example:
--
--     Store.query store
--         |> Store.where (Store.eq .status "active")
--         |> Store.count conn
count : Db -> Query a -> Task Error Int
count conn q =
    case q of
        Query r ->
            case r.poison of
                Just e ->
                    Task.fail e

                Nothing ->
                    case r.store of
                        Store s ->
                            Task.map List.length (Db.findWhere conn s.table (queryFrag r.frag))


columnTypeOf : List Column -> String -> Maybe ColType
columnTypeOf columns name =
    case columns of
        [] ->
            Nothing

        first :: rest ->
            if columnName first == name then
                Just (columnColType first)

            else
                columnTypeOf rest name


-- ─── Typed two-store inner join ─────────────────────────────────────
--
-- A `Joined a b` is an inner join of two stores on key equality, lowering to
-- ONE parameterized `SELECT` over a two-table `FROM` — never a per-row fan-out.
-- It carries both stores (so both codecs are in hand for decode), the two
-- validated join-key columns, and an accumulated joined `WHERE` fragment. The
-- two sides are bound to the fixed aliases `a0` (left) and `a1` (right); every
-- column the join references reaches SQL only as a validated `alias.column`
-- reference through `Sql.column`, and every filter value binds as a parameter
-- through `Sql.param`, so the join adds no injection surface over the audited
-- single-table path. A filter column absent from its side's store fails closed
-- with a typed `Err` carried as `poison`, exactly as the single-table `Query`
-- does. Built only through `join`, so both key columns are already accepted.


-- | The alias bound to the left store in a join (`FROM ta AS a0`).
leftAlias : String
leftAlias =
    "a0"


-- | The alias bound to the right store in a join (`FROM tb AS a1`).
rightAlias : String
rightAlias =
    "a1"


-- | Sort direction for `orderByLeft` / `orderByRight`. `Asc` sorts the join
-- result ascending on the named column; `Desc` sorts descending.
type Order
    = Asc
    | Desc


-- | An inner join of two stores on key equality, decoded through each store's
-- own codec at `joinToList` / `joinToMaybe` / `joinCount`. `storeA` / `storeB`
-- are the two sides (left bound to `a0`, right to `a1`); `keyA` / `keyB` are the
-- validated join-key columns (`a0.keyA = a1.keyB`); `frag` is the accumulated
-- joined `WHERE` fragment (the key equality plus any `joinFilterLeft` /
-- `joinFilterRight`); `order` is an optional `(alias, column, ascending)` triple
-- attached by `orderByLeft` / `orderByRight`; `poison` holds the first
-- fail-closed error (a filter column absent from its side). Opaque: the stores
-- it reads and the codecs it decodes with cannot drift, because both come from
-- the two `Store` values `join` captured.
type Joined a b
    = Joined
        { storeA : Store a
        , storeB : Store b
        , keyA : String
        , keyB : String
        , frag : SqlFragment
        , order : Maybe ( String, String, Bool )
        , poison : Maybe Error
        }


-- | `join storeA .keyA storeB .keyB` — begin an inner join of `storeA` and
-- `storeB` on `a0.keyA = a1.keyB`. The two accessor arguments name the join
-- columns the same way `eq .field` names a column: each `.field` is checked
-- against its store's row type at compile time, and their result type `k` must
-- match, so a mistyped join key is a type error. The lowering intercept extracts
-- each accessor's validated column and calls `joinNamed`.
--
-- Example:
--
--     import Ipe.Db as Db exposing (Db)
--     import Ipe.Db.Store as Store exposing (Store)
--     import Ipe.Task as Task exposing (Task)
--     import Ipe.Error exposing (Error)
--
--     type alias Book =
--         { id : String, title : String, authorId : String }
--
--     type alias Author =
--         { id : String, name : String }
--
--     booksByAuthor : Db -> Store Book -> Store Author -> Task Error (List ( Book, Author ))
--     booksByAuthor conn books authors =
--         Store.join books .authorId authors .id
--             |> Store.joinToList conn
join : Store a -> (a -> k) -> Store b -> (b -> k) -> Joined a b
join =
    Kernel.kernel "Store_join"


-- | The lowered form of `join`: each accessor `.field` has already been turned
-- into its validated, snake_cased column name (`keyA` / `keyB`). Builds the
-- `Joined` with the key-equality WHERE fragment `a0.keyA = a1.keyB` — both sides
-- reach SQL only through `Sql.column` on the aliased reference. If either key is
-- somehow not a valid dotted identifier the fragment poisons itself (the
-- `Sql.column` gate), which the runners surface as a typed `Err`; no value is
-- interpolated.
--
-- Reached only through the `Store.join` lowering intercept, which supplies the
-- columns; not part of the accessor caller surface.
joinNamed : Store a -> String -> Store b -> String -> Joined a b
joinNamed storeA keyA storeB keyB =
    Joined
        { storeA = storeA
        , storeB = storeB
        , keyA = keyA
        , keyB = keyB
        , frag = joinKeyEquals keyA keyB
        , order = Nothing
        , poison = Nothing
        }


-- The join-key equality fragment `a0.keyA = a1.keyB`: each side is a validated
-- `alias.column` reference through `Sql.column`, never interpolated text.
joinKeyEquals : String -> String -> SqlFragment
joinKeyEquals keyA keyB =
    Sql.eq
        (Sql.column (qualified leftAlias keyA))
        (Sql.column (qualified rightAlias keyB))


-- Qualify a bare column with a table alias (`a0` + `title` → `a0.title`). The
-- result is a dotted reference `Sql.column` accepts through the same identifier
-- gate the single-table path uses.
qualified : String -> String -> String
qualified alias col =
    String.concat [ alias, ".", col ]


-- | `joinFilterLeft cond joined` — restrict the join to rows whose LEFT side
-- matches `cond`. `cond` is an ordinary `Cond a` over the left store's row type
-- (built with `eq` / `and` / …), so it is row-checked to the left side and its
-- values bind as parameters. Its columns are validated against the left store's
-- own columns and qualified with the left alias (`a0.col`) before reaching SQL,
-- so a column absent from the left store fails closed with a typed `Err`.
-- Repeated filters AND-join.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.joinFilterLeft (Store.eq .available True)
joinFilterLeft : Cond a -> Joined a b -> Joined a b
joinFilterLeft cond joined =
    case joined of
        Joined r ->
            case r.storeA of
                Store s ->
                    addJoinFilter leftAlias s.currentColumns cond joined


-- | `joinFilterRight cond joined` — restrict the join to rows whose RIGHT side
-- matches `cond`. The right-side counterpart to `joinFilterLeft`: `cond` is a
-- `Cond b` over the right store's row type, validated against the right store's
-- columns and qualified with the right alias (`a1.col`).
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.joinFilterRight (Store.eq .active True)
joinFilterRight : Cond b -> Joined a b -> Joined a b
joinFilterRight cond joined =
    case joined of
        Joined r ->
            case r.storeB of
                Store s ->
                    addJoinFilter rightAlias s.currentColumns cond joined


-- Lower `cond` against one side's columns, qualify each referenced column with
-- that side's alias, and AND it into the join's WHERE fragment. A column absent
-- from the side's store poisons the join with the first fail-closed error, so a
-- poisoned join issues no SQL and fails at the terminal runner.
addJoinFilter : String -> List Column -> Cond row -> Joined a b -> Joined a b
addJoinFilter alias columns cond joined =
    case joined of
        Joined r ->
            case condFragmentInQualified alias columns cond of
                Err e ->
                    Joined
                        { storeA = r.storeA
                        , storeB = r.storeB
                        , keyA = r.keyA
                        , keyB = r.keyB
                        , frag = r.frag
                        , order = r.order
                        , poison = firstPoison r.poison e
                        }

                Ok lowered ->
                    Joined
                        { storeA = r.storeA
                        , storeB = r.storeB
                        , keyA = r.keyA
                        , keyB = r.keyB
                        , frag = Sql.and r.frag lowered
                        , order = r.order
                        , poison = r.poison
                        }


-- | `orderByLeft accessor order joined` — sort the join result by a column from
-- the LEFT side (`a0`). The accessor names the sort column the same way `eq`
-- names a filter column; lowering extracts the snake_cased column name and
-- rewrites to `orderByLeftNamed`. `Asc` sorts ascending; `Desc` descending.
-- Only the last `orderByLeft` / `orderByRight` call on a `Joined` takes effect.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.orderByLeft .title Asc
--         |> Store.joinToList db
orderByLeft : (a -> k) -> Order -> Joined a b -> Joined a b
orderByLeft =
    Kernel.kernel "Store_orderByLeft"


-- | `orderByRight accessor order joined` — sort the join result by a column from
-- the RIGHT side (`a1`). Symmetric to `orderByLeft`.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.joinFilterRight (Store.eq .active True)
--         |> Store.orderByRight .name Desc
--         |> Store.joinToList db
orderByRight : (b -> k) -> Order -> Joined a b -> Joined a b
orderByRight =
    Kernel.kernel "Store_orderByRight"


-- | Lowered form of `orderByLeft`: the accessor has already been turned into its
-- validated column name and the `Order` into a `Bool`. Attaches the sort
-- specification to the join so `joinToList` routes to `Db.findJoinOrdered`.
-- Reached only through the `Store.orderByLeft` lowering intercept.
orderByLeftNamed : Joined a b -> String -> Bool -> Joined a b
orderByLeftNamed joined col ascending =
    case joined of
        Joined r ->
            Joined
                { storeA = r.storeA
                , storeB = r.storeB
                , keyA = r.keyA
                , keyB = r.keyB
                , frag = r.frag
                , order = Just ( leftAlias, col, ascending )
                , poison = r.poison
                }


-- | Lowered form of `orderByRight`: symmetric to `orderByLeftNamed` but uses
-- the RIGHT side alias (`a1`). Reached only through the `Store.orderByRight`
-- lowering intercept.
orderByRightNamed : Joined a b -> String -> Bool -> Joined a b
orderByRightNamed joined col ascending =
    case joined of
        Joined r ->
            Joined
                { storeA = r.storeA
                , storeB = r.storeB
                , keyA = r.keyA
                , keyB = r.keyB
                , frag = r.frag
                , order = Just ( rightAlias, col, ascending )
                , poison = r.poison
                }


-- | `joinToList conn joined` — run the join and return each matched pair, both
-- full rows decoded through their own store's codec. Lowers to ONE
-- parameterized statement (`SELECT … FROM ta AS a0, tb AS a1 WHERE a0.keyA =
-- a1.keyB [AND filters]`) through `Db.findJoin` (or `Db.findJoinOrdered` when
-- `orderByLeft` / `orderByRight` was applied): every identifier (both tables,
-- both aliases, every projected column) is re-validated at the runtime boundary,
-- and every filter value is a bound parameter. A poisoned join (a filter naming
-- an unknown column) fails closed with the typed `Err`; a row that does not
-- decode to its side's type is a typed `Err`.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.joinFilterRight (Store.eq .active True)
--         |> Store.joinToList conn
joinToList : Db -> Joined a b -> Task Error (List ( a, b ))
joinToList conn joined =
    case joined of
        Joined r ->
            case r.poison of
                Just e ->
                    Task.fail e

                Nothing ->
                    case r.storeA of
                        Store sa ->
                            case r.storeB of
                                Store sb ->
                                    case r.order of
                                        Nothing ->
                                            Task.andThen
                                                (\pairs -> decodeJoinRows sa.codec sb.codec pairs)
                                                (Db.findJoin conn
                                                    sa.table
                                                    leftAlias
                                                    (List.map columnName sa.currentColumns)
                                                    sb.table
                                                    rightAlias
                                                    (List.map columnName sb.currentColumns)
                                                    r.frag
                                                )

                                        Just ( orderAlias, orderCol, orderAsc ) ->
                                            Task.andThen
                                                (\pairs -> decodeJoinRows sa.codec sb.codec pairs)
                                                (Db.findJoinOrdered conn
                                                    sa.table
                                                    leftAlias
                                                    (List.map columnName sa.currentColumns)
                                                    sb.table
                                                    rightAlias
                                                    (List.map columnName sb.currentColumns)
                                                    r.frag
                                                    orderAlias
                                                    orderCol
                                                    orderAsc
                                                )


-- | `joinToMaybe conn joined` — run the join and decode the FIRST matched pair,
-- or `Nothing`.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.joinFilterLeft (Store.eq .id "book-1")
--         |> Store.joinToMaybe conn
joinToMaybe : Db -> Joined a b -> Task Error (Maybe ( a, b ))
joinToMaybe conn joined =
    Task.map List.head (joinToList conn joined)


-- | `joinCount conn joined` — run the join's filter and return how many pairs
-- match. Decodes nothing; counts the matched join rows.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.joinFilterRight (Store.eq .active True)
--         |> Store.joinCount conn
joinCount : Db -> Joined a b -> Task Error Int
joinCount conn joined =
    Task.map List.length (joinToList conn joined)


-- ─── Typed column projection over a join (`select` / `Select`) ───────
--
-- `select` projects specific columns of a join instead of returning both full
-- rows. Its lambda receives the pair of the two sides' row records (`( a, b )`)
-- and returns either a bare field reference on one side
-- (`\( _, author ) -> author.name`) or a flat tuple of such references
-- (`\( book, author ) -> ( book.title, author.name )`). The lambda is never run
-- over real rows: the compiler reads each referenced column from its `side.field`
-- element at lowering, validates it against that side's row type, and sets the
-- SQL `SELECT` list to exactly those columns (column pushdown), over the join's
-- existing `FROM … WHERE`.
--
-- The security posture is the join's, extended: each projected identifier
-- (alias + column) is a validated `alias.column` reference that reaches SQL only
-- through the runtime's identifier gate, and the `select` lambda cannot smuggle a
-- raw value into the SELECT text — a body that is not a column reference (or a
-- flat tuple of column references) is a fail-closed build error (IPE-L0149),
-- never a computed fragment. Each projected column binds to an output name by
-- position (`p0`, `p1`, …); `selectToList` / `selectToMaybe` return the projected
-- `row` directly — the per-column decode is emitted concretely at the call site
-- from the projected shape the `select` lambda fixed, so no decoder is stored in
-- the projection value and the caller sees a typed `row`, never a positional read.


-- | A column projection over a join, returned as the typed `row` by
-- `selectToList` / `selectToMaybe`. `row` is a PHANTOM type argument: it records
-- the projected shape the `select` lambda fixed so the call site emits the right
-- concrete decode, while the runtime value carries only query data. Built only
-- through `select`, so the projected columns and the shape that reads them back
-- cannot drift. `joined` is the underlying join (its `FROM … WHERE` and any
-- `poison`); `projections` is the ordered typed projection descriptor list (one
-- `ProjectionTerm` per SELECT term — see `selectNamed`).
type Select row
    = Select
        { joinedA : String
        , joinedB : String
        , leftTable : String
        , rightTable : String
        , frag : SqlFragment
        , order : Maybe ( String, String, Bool )
        , poison : Maybe Error
        , projections : List ProjectionTerm
        , extraBinds : List SqlValue
        }


-- | `select (\( left, right ) -> projection) joined` — project specific columns
-- of `joined` instead of both full rows. The lambda receives the two sides' row
-- records and returns either a bare field reference on one side or a flat tuple
-- of such references; lowering reads each referenced column and sets the SQL
-- `SELECT` list to exactly those columns. The lambda is never run over real
-- rows, so each field reference names a validated column: a projection that is
-- not a column reference (a computed expression, a literal) — or a tuple with a
-- non-reference or nested-tuple element — is a fail-closed build error, never a
-- raw SQL fragment.
--
-- `selectToList` / `selectToMaybe` return the projected `row` directly: the
-- per-column decode is emitted concretely at the call site from the projected
-- shape this lambda fixed, so a single-column projection yields the scalar and a
-- tuple projection yields the tuple — no positional read in caller code.
--
-- Example:
--
--     -- one column: a `List String`
--     Store.join books .authorId authors .id
--         |> Store.select (\( _, author ) -> author.name)
--         |> Store.selectToList db
--
--     -- two columns: a `List ( String, String )`
--     Store.join books .authorId authors .id
--         |> Store.select (\( book, author ) -> ( book.title, author.name ))
--         |> Store.selectToList db
select : (( a, b ) -> row) -> Joined a b -> Select row
select =
    Kernel.kernel "Store_select"


-- | `literal value` — inside a `Store.select` projection lambda, binds `value`
-- as a SQL parameter (`? AS pN`) rather than naming a column. The value is
-- never interpolated into SQL text; its type picks the concrete reader the decode
-- emits. Valid only as a direct element of a `Store.select` projection body: a
-- point-free or partially-applied `literal` is a fail-closed build error.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.select (\( _, author ) -> ( literal "fiction", author.name ))
--         |> Store.selectToList db
--         -- : Task Error (List ( String, String ))
--         -- SQL: SELECT ? AS p0, a1.name AS p1 FROM …
literal : t -> t
literal =
    Kernel.kernel "Store_literal"


-- | `upper col` — inside a `Store.select` projection lambda, applies SQL
-- `UPPER(…)` to a `String` column reference. Valid only as a direct element of a
-- `Store.select` projection body applied to a `side.field` accessor; the accessor
-- must resolve to a `String` column. A non-column or non-String argument is a
-- fail-closed build error (IPE-L0149). Every column identifier is validated at
-- compile time and re-checked by the runtime.
--
-- Example:
--
--     joinedBooks
--         |> Store.select (\( _, author ) -> upper author.name)
--         |> Store.selectToList db
--         -- SQL: SELECT UPPER(a1.name) AS p0 FROM …
upper : String -> String
upper =
    Kernel.kernel "Store_upper"


-- | `lower col` — symmetric counterpart to `upper`: applies SQL `LOWER(…)` to
-- a `String` column reference. The same structural restrictions apply.
--
-- Example:
--
--     joinedBooks
--         |> Store.select (\( book, _ ) -> lower book.title)
--         |> Store.selectToList db
--         -- SQL: SELECT LOWER(a0.title) AS p0 FROM …
lower : String -> String
lower =
    Kernel.kernel "Store_lower"


-- | `coalesce left right` — inside a `Store.select` projection lambda, emits
-- `COALESCE(a, b) AS pN` in the SELECT list, returning the first non-null
-- value. Both operands must share the same scalar type `a` (the type variable
-- is unified by the constraint scheme). Each operand is either a bare
-- `side.field` column reference or a `Store.literal` value; a computed
-- expression is a fail-closed build error (IPE-L0149). The operand types must
-- agree; a mismatch is a compile-time type error. Every column identifier is
-- validated at compile time and re-checked by the runtime.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.select (\( _, author ) -> coalesce author.name (literal "unknown"))
--         |> Store.selectToList db
--         -- SQL: SELECT COALESCE(a1.name, ?) AS p0 FROM …
coalesce : Projection a -> Projection a -> Projection a
coalesce =
    Kernel.kernel "Store_coalesce"


-- | `add left right` — inside a `Store.select` projection lambda, emits
-- `(a + b) AS pN` in the SELECT list over two numeric operands. Both operands
-- share one numeric type (`Int` or `Float`); a non-numeric operand is a
-- compile-time type error. Each operand is either a bare `side.field` column
-- reference or a `Store.literal` value; a computed expression is a fail-closed
-- build error (IPE-L0149). Every column identifier is validated at compile time
-- and re-checked by the runtime.
--
-- Example:
--
--     Store.join lineItems .orderId orders .id
--         |> Store.select (\( item, _ ) -> add item.price (literal 10))
--         |> Store.selectToList db
--         -- SQL: SELECT (a0.price + ?) AS p0 FROM …
add : a -> a -> a
add =
    Kernel.kernel "Store_add"


-- | `sub left right` — subtraction counterpart to `add`: emits `(a - b) AS pN`.
-- The same operand and numeric-type restrictions apply.
sub : a -> a -> a
sub =
    Kernel.kernel "Store_sub"


-- | `mul left right` — multiplication counterpart to `add`: emits
-- `(a * b) AS pN`. The same operand and numeric-type restrictions apply.
mul : a -> a -> a
mul =
    Kernel.kernel "Store_mul"


-- | The lowered form of `select`: the lambda has already been read into the
-- ordered `ProjectionTerm` list. Each term is one typed SELECT descriptor:
-- `ColumnTerm alias col`, `LiteralTerm`, `UpperTerm dotted`, `LowerTerm dotted`,
-- or `CoalesceTerm operandA operandB`. Literal-position `SqlValue` binds appear
-- in `extraBinds` in left→right, coalesce-left-before-right order, ahead of the
-- WHERE binds. Builds the `Select` from the join's tables, alias-bound `FROM …
-- WHERE` fragment, and any inherited `poison`. Reached only through the
-- `Store.select` lowering intercept; not part of the accessor caller surface.
selectNamed : Joined a b -> List ProjectionTerm -> List SqlValue -> Select row
selectNamed joined projections extraBinds =
    case joined of
        Joined r ->
            case r.storeA of
                Store sa ->
                    case r.storeB of
                        Store sb ->
                            Select
                                { joinedA = leftAlias
                                , joinedB = rightAlias
                                , leftTable = sa.table
                                , rightTable = sb.table
                                , frag = r.frag
                                , order = r.order
                                , poison = r.poison
                                , projections = projections
                                , extraBinds = extraBinds
                                }


-- | `selectToList db sel` — run the projection and return the projected `row`
-- for every matched join row. Lowers to ONE parameterized statement
-- (`SELECT proj … FROM ta AS a0, tb AS a1 WHERE …`) through `Db.findProjection`:
-- every projected identifier is re-validated at the runtime boundary, and every
-- filter value is a bound parameter. A poisoned projection (an inherited filter
-- naming an unknown column) fails closed with the typed `Err`.
--
-- The `Select` argument must be a `Store.select` projection expression: the
-- compiler reads the projected shape and each column's type from it and emits the
-- concrete per-column decode at this call site (a single column yields the scalar,
-- a tuple yields the tuple), so no decoder is stored in the value. A `Select` that
-- is not a `Store.select` expression is a fail-closed build error (IPE-L0149); the
-- body below is that fail-closed fallback, reached only when the intercept does
-- not fire.
--
-- Example:
--
--     Store.join books .authorId authors .id
--         |> Store.select (\( book, author ) -> ( book.title, author.name ))
--         |> Store.selectToList db
--         -- : Task Error (List ( String, String ))
selectToList : Db -> Select row -> Task Error (List row)
selectToList conn sel =
    Task.fail selectNotProjectionError


-- | `selectToMaybe db sel` — run the projection and return the FIRST projected
-- `row`, or `Nothing`. Like `selectToList`, the `Select` argument must be a
-- `Store.select` projection expression (the decode is emitted at this call site).
selectToMaybe : Db -> Select row -> Task Error (Maybe row)
selectToMaybe conn sel =
    Task.fail selectNotProjectionError


selectNotProjectionError : Error
selectNotProjectionError =
    Error.invalidInput
        "Ipe.Db.Store: selectToList / selectToMaybe require a `Store.select` projection expression"


-- Run the projection, decode every matched row through `decode`, and return the
-- typed list. The `selectToList` intercept emits this call with the concrete
-- per-column `decode` (`Row -> Result Error row`) built from the projection's
-- known shape, so the decode is monomorphic and stored nowhere. A row that does
-- not decode fails the whole task closed (`Result.combine` returns the first
-- `Err`, lifted to `Task.fail`). Internal to the emitted decode; not exposed.
selectDecodeList : (Row -> Result Error row) -> Db -> Select row -> Task Error (List row)
selectDecodeList decode conn sel =
    Task.andThen
        (\rows -> Task.fromResult (Result.combine (List.map decode rows)))
        (selectRows conn sel)


-- The `selectToMaybe` counterpart: decode every row, then keep the first. Same
-- fail-closed decode as `selectDecodeList`. Internal to the emitted decode.
selectDecodeMaybe : (Row -> Result Error row) -> Db -> Select row -> Task Error (Maybe row)
selectDecodeMaybe decode conn sel =
    Task.map List.head (selectDecodeList decode conn sel)


-- Run the projection and return each matched join row as a `Row` keyed by the
-- projection output names (`p0`, …). The untyped read `selectDecodeList` wraps
-- with the concrete per-column decode; not part of the caller surface.
selectRows : Db -> Select row -> Task Error (List Row)
selectRows conn sel =
    case sel of
        Select r ->
            case r.poison of
                Just e ->
                    Task.fail e

                Nothing ->
                    case r.order of
                        Nothing ->
                            Db.findProjection conn
                                r.leftTable
                                r.joinedA
                                r.rightTable
                                r.joinedB
                                r.frag
                                r.projections
                                r.extraBinds

                        Just ( orderAlias, orderCol, orderAsc ) ->
                            Db.findProjectionOrdered conn
                                r.leftTable
                                r.joinedA
                                r.rightTable
                                r.joinedB
                                r.frag
                                r.projections
                                r.extraBinds
                                orderAlias
                                orderCol
                                orderAsc


-- The projection output name a projected column binds to, by position: the first
-- projected column is `p0`, the second `p1`, and so on. Both the SQL `SELECT`
-- alias (built in the runtime from this same convention) and the emitted decode
-- read a cell by this name, so the projection list and the decode cannot disagree
-- on a column's position.
projOutputName : Int -> String
projOutputName index =
    String.concat [ "p", String.fromInt index ]


-- Read the projected column bound to position `index` back as `String`. The
-- concrete decode the `selectToList` / `selectToMaybe` intercept emits calls one
-- `projectionRead*` per projected column, keyed by the same `p<index>` output
-- name the runtime projects into. Internal to the emitted decode; not exposed.
projectionReadText : Int -> Row -> Result Error String
projectionReadText index row =
    readText (projOutputName index) row


-- Read the projected column bound to position `index` back as `Int`. Internal to
-- the emitted decode; not exposed.
projectionReadInt : Int -> Row -> Result Error Int
projectionReadInt index row =
    readInt (projOutputName index) row


-- Read the projected column bound to position `index` back as `Bool`. Internal to
-- the emitted decode; not exposed.
projectionReadBool : Int -> Row -> Result Error Bool
projectionReadBool index row =
    readBool (projOutputName index) row


-- Read the projected column bound to position `index` back as `Float`. Internal
-- to the emitted decode; not exposed.
projectionReadFloat : Int -> Row -> Result Error Float
projectionReadFloat index row =
    readFloat (projOutputName index) row


-- Combine two-to-five per-column reads (`Row -> Result Error t`) into the
-- projected tuple, threading each read's `Result` (the first `Err` wins). The
-- `selectToList` / `selectToMaybe` intercept emits `projectionDecodeN` applied to
-- the concrete per-column readers for the projected tuple's shape, so the decode
-- is monomorphic and the tuple width is fixed at the call site. Internal to the
-- emitted decode; not exposed.
projectionDecode2 : (Row -> Result Error a) -> (Row -> Result Error b) -> Row -> Result Error ( a, b )
projectionDecode2 rd0 rd1 row =
    Result.map2 (\a b -> ( a, b )) (rd0 row) (rd1 row)


projectionDecode3 : (Row -> Result Error a) -> (Row -> Result Error b) -> (Row -> Result Error c) -> Row -> Result Error ( a, b, c )
projectionDecode3 rd0 rd1 rd2 row =
    Result.map3 (\a b c -> ( a, b, c )) (rd0 row) (rd1 row) (rd2 row)


projectionDecode4 : (Row -> Result Error a) -> (Row -> Result Error b) -> (Row -> Result Error c) -> (Row -> Result Error d) -> Row -> Result Error ( a, b, c, d )
projectionDecode4 rd0 rd1 rd2 rd3 row =
    Result.map4 (\a b c d -> ( a, b, c, d )) (rd0 row) (rd1 row) (rd2 row) (rd3 row)


projectionDecode5 : (Row -> Result Error a) -> (Row -> Result Error b) -> (Row -> Result Error c) -> (Row -> Result Error d) -> (Row -> Result Error e) -> Row -> Result Error ( a, b, c, d, e )
projectionDecode5 rd0 rd1 rd2 rd3 rd4 row =
    Result.map5 (\a b c d e -> ( a, b, c, d, e )) (rd0 row) (rd1 row) (rd2 row) (rd3 row) (rd4 row)


-- Decode each `(leftRow, rightRow)` cell-map pair through the two codecs into a
-- typed `( a, b )` pair. A pair whose either side does not decode to its store's
-- type is a typed `Err`, never a wrong value.
decodeJoinRows : Codec a -> Codec b -> List ( Row, Row ) -> Task Error (List ( a, b ))
decodeJoinRows codecA codecB pairs =
    case pairs of
        [] ->
            Task.succeed []

        first :: rest ->
            case first of
                ( leftRow, rightRow ) ->
                    case DbCodec.codecFromRow codecA leftRow of
                        Err e ->
                            Task.fail e

                        Ok a ->
                            case DbCodec.codecFromRow codecB rightRow of
                                Err e ->
                                    Task.fail e

                                Ok b ->
                                    Task.map
                                        (\more -> ( a, b ) :: more)
                                        (decodeJoinRows codecA codecB rest)


-- ── Cond → SqlFragment lowering (the single validation + emit point) ──


-- Lower a `Cond` to an audited `SqlFragment`, validating every column against
-- the store's own column list first. A column absent from that list is a typed
-- `Err` (parse-don't-validate); an accepted column reaches SQL only through
-- `Sql.column`, and every value only through `Sql.param`. `where` calls this the
-- moment a `Cond` is added (the store is in hand), so a bad column fails closed
-- at build time and no `Cond` value survives past the query builder.
condFragmentIn : List Column -> Cond row -> Result Error SqlFragment
condFragmentIn columns cond =
    case cond of
        Compare op col value ->
            checkColumn columns col
                (compareFragment op col value)

        Like col pattern ->
            checkColumn columns col
                (Sql.like (Sql.column col) pattern)

        IsNull col ->
            checkColumn columns col
                (Sql.isNull (Sql.column col))

        NotNull col ->
            checkColumn columns col
                (Sql.isNotNull (Sql.column col))

        InList col values ->
            checkColumn columns col
                (Sql.inList (Sql.column col) values)

        AndList conds ->
            foldConds columns Sql.and trueFragment conds

        OrList conds ->
            foldConds columns Sql.or falseFragment conds

        NotCond inner ->
            Result.map Sql.not (condFragmentIn columns inner)


-- Validate `col` against the store's columns, returning `built` when accepted or
-- a fail-closed `Err` when the store names no such column.
checkColumn : List Column -> String -> SqlFragment -> Result Error SqlFragment
checkColumn columns col built =
    if hasColumn columns col then
        Ok built

    else
        Err (unknownColumnError col)


compareFragment : CompareOp -> String -> SqlValue -> SqlFragment
compareFragment op col value =
    let
        lhs =
            Sql.column col

        rhs =
            Sql.param value
    in
    case op of
        OpEq ->
            Sql.eq lhs rhs

        OpNeq ->
            Sql.ne lhs rhs

        OpGt ->
            Sql.gt lhs rhs

        OpGte ->
            Sql.gte lhs rhs

        OpLt ->
            Sql.lt lhs rhs

        OpLte ->
            Sql.lte lhs rhs


-- Lower a `Cond` for one join side to an audited `SqlFragment`, validating every
-- column against that side's own column list first and QUALIFYING each accepted
-- column with the side's table alias (`col` → `alias.col`) before it reaches
-- SQL. The bare column is what the store's derived list names, so the
-- membership check stays against `columns`; only the emitted reference is
-- qualified, so the join's WHERE names each side unambiguously. A column absent
-- from the side's store is a typed `Err` (parse-don't-validate); every value
-- binds through `Sql.param`. This is `condFragmentIn` with the alias qualifier —
-- the two share the same validation contract, differing only in the emitted
-- column reference.
condFragmentInQualified : String -> List Column -> Cond row -> Result Error SqlFragment
condFragmentInQualified alias columns cond =
    case cond of
        Compare op col value ->
            checkColumn columns col
                (compareFragment op (qualified alias col) value)

        Like col pattern ->
            checkColumn columns col
                (Sql.like (Sql.column (qualified alias col)) pattern)

        IsNull col ->
            checkColumn columns col
                (Sql.isNull (Sql.column (qualified alias col)))

        NotNull col ->
            checkColumn columns col
                (Sql.isNotNull (Sql.column (qualified alias col)))

        InList col values ->
            checkColumn columns col
                (Sql.inList (Sql.column (qualified alias col)) values)

        AndList conds ->
            foldCondsQualified alias columns Sql.and trueFragment conds

        OrList conds ->
            foldCondsQualified alias columns Sql.or falseFragment conds

        NotCond inner ->
            Result.map Sql.not (condFragmentInQualified alias columns inner)


-- The alias-qualifying counterpart to `foldConds`, threading the side's alias
-- through each recursive lowering.
foldCondsQualified : String -> List Column -> (SqlFragment -> SqlFragment -> SqlFragment) -> SqlFragment -> List (Cond row) -> Result Error SqlFragment
foldCondsQualified alias columns join emptyFragment conds =
    case conds of
        [] ->
            Ok emptyFragment

        [ single ] ->
            condFragmentInQualified alias columns single

        first :: rest ->
            case condFragmentInQualified alias columns first of
                Err e ->
                    Err e

                Ok head ->
                    Result.map (\tail -> join head tail)
                        (foldCondsQualified alias columns join emptyFragment rest)


-- Fold a list of conditions with a binary connective, using `emptyFragment` as
-- the identity for the empty list. Each condition is lowered (and column-checked)
-- before it joins, so the first invalid column fails the whole fold closed.
foldConds : List Column -> (SqlFragment -> SqlFragment -> SqlFragment) -> SqlFragment -> List (Cond row) -> Result Error SqlFragment
foldConds columns join emptyFragment conds =
    case conds of
        [] ->
            Ok emptyFragment

        [ single ] ->
            condFragmentIn columns single

        first :: rest ->
            case condFragmentIn columns first of
                Err e ->
                    Err e

                Ok head ->
                    Result.map (\tail -> join head tail)
                        (foldConds columns join emptyFragment rest)


-- The always-true / always-false fragments, the identities of `and` / `or` over
-- the empty list. Each names no caller identifier, so neither adds any injection
-- surface.
trueFragment : SqlFragment
trueFragment =
    Sql.eq (Sql.param (SqlInt 1)) (Sql.param (SqlInt 1))


falseFragment : SqlFragment
falseFragment =
    Sql.eq (Sql.param (SqlInt 1)) (Sql.param (SqlInt 0))


-- The always-true fragment when `admit` holds, else the always-false fragment.
-- A caller-claim predicate leaf (`role` / `memberOf` / `claimEquals`) folds
-- through here at lowering: its truth is fixed by the principal in hand, so it
-- contributes an admit/deny identity fragment rather than a per-row comparison.
-- Fail-closed lives at the call site (the `Auth.*` accessors already read `False`
-- / `Nothing` for an absent claim); this only picks the matching identity.
admitFragment : Bool -> SqlFragment
admitFragment admit =
    if admit then
        trueFragment

    else
        falseFragment


-- ── Ordering + pagination over raw rows (in Ipê, no SQL text) ──────


-- Order then paginate the raw rows: sort by each ordering key (numeric-aware for
-- `CInt` / `CReal` columns), skip `off` rows, keep `lim` rows.
paginateRows : List OrderKey -> Maybe Int -> Maybe Int -> List Row -> List Row
paginateRows orderings off lim rows =
    applyLimit lim (applyOffset off (orderRowsWith orderings rows))


-- Sort raw rows by the ordering keys, in priority order: the LAST ordering is
-- applied first so a stable sort leaves the FIRST ordering as the dominant key
-- (the primary sort). A raw `Row` is a `Dict String String`, so the sort
-- compares the string cell, numerically when the column type is `CInt` / `CReal`.
orderRowsWith : List OrderKey -> List Row -> List Row
orderRowsWith orderings rows =
    List.foldr
        (\ordering acc -> sortByOrdering ordering acc)
        rows
        orderings


sortByOrdering : OrderKey -> List Row -> List Row
sortByOrdering ordering rows =
    case ordering of
        ( col, cellType, dir ) ->
            List.sortWith (\a b -> cellCompare cellType dir col a b) rows


cellCompare : CellType -> SortDir -> String -> Row -> Row -> Order
cellCompare cellType dir col a b =
    let
        base =
            compareCells cellType (rowCell col a) (rowCell col b)
    in
    case dir of
        Ascending ->
            base

        Descending ->
            flipOrder base


compareCells : CellType -> String -> String -> Order
compareCells cellType x y =
    case cellType of
        NumericCell ->
            compareNumeric x y

        TextCell ->
            compare x y


compareNumeric : String -> String -> Order
compareNumeric x y =
    case ( String.toFloat x, String.toFloat y ) of
        ( Just fx, Just fy ) ->
            compare fx fy

        _ ->
            compare x y


-- Map a store column type to the `CellType` a raw-row sort compares by:
-- `CInt` / `CReal` / `CTime` (and a nullable wrapper over any) compare
-- numerically; every other column type compares as text.
cellTypeOf : ColType -> CellType
cellTypeOf colType =
    case colType of
        CInt ->
            NumericCell

        CReal ->
            NumericCell

        CTime ->
            NumericCell

        CNull inner ->
            cellTypeOf inner

        CText ->
            TextCell

        CBool ->
            TextCell

        CDecimal ->
            TextCell

        CMoney ->
            TextCell

        CBlob ->
            TextCell


flipOrder : Order -> Order
flipOrder ord =
    case ord of
        LT ->
            GT

        EQ ->
            EQ

        GT ->
            LT


applyOffset : Maybe Int -> List Row -> List Row
applyOffset off rows =
    case off of
        Just n ->
            List.drop n rows

        Nothing ->
            rows


applyLimit : Maybe Int -> List Row -> List Row
applyLimit lim rows =
    case lim of
        Just n ->
            List.take n rows

        Nothing ->
            rows


-- ─── Typed column reads (row -> value) ─────────────────────────────
--
-- `Db.findWhere` returns each row as `Dict String String`. These helpers read
-- one column back into its Ipê type, failing closed with a typed error when the
-- column is absent or malformed — never a silent default. They are the readers
-- for a raw-column `Store Row`: a codec-driven store decodes whole rows through
-- its own codec, but a raw store reads columns individually.


-- | Read a column as a `String`. A missing column is a typed `Err`.
readText : String -> Row -> Result Error String
readText name row =
    case Dict.get name row of
        Just s ->
            Ok s

        Nothing ->
            Err (missingColumnError name)


-- | Read a column as an `Int`. A missing or non-integer column is a typed `Err`.
readInt : String -> Row -> Result Error Int
readInt name row =
    case Dict.get name row of
        Just s ->
            case String.toInt s of
                Just n ->
                    Ok n

                Nothing ->
                    Err (badColumnError name "Int" s)

        Nothing ->
            Err (missingColumnError name)


-- | Read a column as a `Float`. A missing or non-numeric column is a typed
-- `Err`.
readFloat : String -> Row -> Result Error Float
readFloat name row =
    case Dict.get name row of
        Just s ->
            case String.toFloat s of
                Just f ->
                    Ok f

                Nothing ->
                    Err (badColumnError name "Float" s)

        Nothing ->
            Err (missingColumnError name)


-- | Read a column as a `Bool`. The stored form is SQLite's `0` / `1` integer
-- convention (and the literals `true` / `false`); anything else is a typed
-- `Err`.
readBool : String -> Row -> Result Error Bool
readBool name row =
    case Dict.get name row of
        Just s ->
            if s == "1" || s == "true" then
                Ok True

            else if s == "0" || s == "false" then
                Ok False

            else
                Err (badColumnError name "Bool" s)

        Nothing ->
            Err (missingColumnError name)


-- ─── Schema (create / migrations) ──────────────────────────────────


-- | `createSql store` — the `CREATE TABLE` DDL for the store, or `Err`. Every
-- identifier that would appear in the DDL — the table name, each column name,
-- and each primary-key column — is re-validated through `validSqlIdent` before
-- it can reach the string, so a store built by a constructor (whose identifiers
-- already validate) always yields `Ok`, and any identifier that somehow does not
-- validate fails closed with no DDL produced. This is the one place a Store
-- builds SQL text for the create entry; it builds only from validated
-- identifiers and holds no values, so there is nothing to inject.
--
-- The primary key renders from the store's one key declaration, identically on
-- SQLite and Postgres:
--
--   * a one-column key (`primaryKey`) is inline on its column:
--     `CREATE TABLE IF NOT EXISTS tags (slug TEXT PRIMARY KEY, label TEXT)`
--   * a composite key (`compositePrimaryKey2` / `compositePrimaryKey3` /
--     `compositePrimaryKeyNamed`) is one table-level constraint, its columns in
--     declared order (the order the key's backing index uses):
--     `CREATE TABLE IF NOT EXISTS memberships (user_id TEXT, group_id TEXT, role TEXT, PRIMARY KEY (user_id, group_id))`
--
-- An invalid key is an `Err`, never DDL without it: a refused declaration (a
-- second key, a composite key of fewer than two columns, a renamed key column),
-- a key column the store does not have, a composite key naming a column twice,
-- or a composite key on a store with a `serial` column (`AUTOINCREMENT` exists
-- only on a one-column `INTEGER` key).
--
-- Example:
--
--     import Ipe.Db.Store as Store exposing (Store)
--
--     type alias Membership =
--         { userId : String, groupId : String, role : String }
--
--     -- Ok "CREATE TABLE IF NOT EXISTS memberships (user_id TEXT, group_id TEXT, role TEXT, PRIMARY KEY (user_id, group_id))"
--     membershipsDdl : Result Error String
--     membershipsDdl =
--         Store.fromCodec "memberships" membershipCodec
--             |> Result.map (Store.compositePrimaryKey2 .userId .groupId)
--             |> Result.map Store.public
--             |> Result.andThen Store.createSql
createSql : Store a -> Result Error String
createSql store =
    case store of
        Store r ->
            createSqlFromColumns r.table r.frozenColumns r.specs r.pk


createSqlFromColumns : String -> List Column -> List ColumnSpec -> Result PrimaryKeyFault PrimaryKeyDecl -> Result Error String
createSqlFromColumns table cols specs pk =
    if Basics.not (validSqlIdentPlain table) then
        Err (invalidIdentError "table" table)

    else
        case pk of
            Err fault ->
                Err (primaryKeyFaultError fault)

            Ok decl ->
                case primaryKeyWithinSchema decl specs cols of
                    Err e ->
                        Err e

                    Ok _ ->
                        case specsWithinColumns specs cols of
                            Err e ->
                                Err e

                            Ok _ ->
                                case columnDefs decl specs cols of
                                    Err e ->
                                        Err e

                                    Ok defs ->
                                        Ok
                                            (String.concat
                                                [ "CREATE TABLE IF NOT EXISTS "
                                                , table
                                                , " ("
                                                , String.join ", " (defs ++ tableConstraints decl)
                                                , ")"
                                                ]
                                            )


-- The key declaration checked against the schema it renders into, before any
-- DDL text is built. Every key column must be a valid identifier (defence in
-- depth — the builders take bare strings) AND one of the store's own columns,
-- so an unknown name fails closed instead of rendering a key over a column the
-- table does not have. A composite key additionally names each column once and
-- has no `serial` companion.
primaryKeyWithinSchema : PrimaryKeyDecl -> List ColumnSpec -> List Column -> Result Error ()
primaryKeyWithinSchema decl specs cols =
    case decl of
        NoPk ->
            Ok ()

        SinglePk keyCol ->
            case keyColumnError cols keyCol of
                Just e ->
                    Err e

                Nothing ->
                    Ok ()

        CompositePk keyCols ->
            case List.head (List.filterMap (keyColumnError cols) keyCols) of
                Just e ->
                    Err e

                Nothing ->
                    case firstRepeated keyCols of
                        Just repeated ->
                            Err (duplicateKeyColumnError repeated keyCols)

                        Nothing ->
                            case List.filter (\s -> specIsSerial s (specColumn s)) specs of
                                serialSpec :: _ ->
                                    Err (compositeKeySerialError (specColumn serialSpec) keyCols)

                                [] ->
                                    Ok ()


keyColumnError : List Column -> String -> Maybe Error
keyColumnError cols name =
    if Basics.not (validSqlIdentPlain name) then
        Just (invalidIdentError "primary-key column" name)

    else if Basics.not (hasColumn cols name) then
        Just (unknownKeyColumnError name)

    else
        Nothing


-- The first name that occurs again later in the list, if any.
firstRepeated : List String -> Maybe String
firstRepeated names =
    case names of
        [] ->
            Nothing

        first :: rest ->
            if List.member first rest then
                Just first

            else
                firstRepeated rest


-- Whether `name` carries the key inline (`col TYPE PRIMARY KEY`) — true only for
-- the column of a one-column key. A composite key renders as a table-level
-- constraint instead, so none of its columns carries an inline `PRIMARY KEY`.
isInlineKey : PrimaryKeyDecl -> String -> Bool
isInlineKey decl name =
    case decl of
        SinglePk keyCol ->
            keyCol == name

        NoPk ->
            False

        CompositePk _ ->
            False


-- The table-level constraint terms appended after the column definitions: the
-- composite key's `PRIMARY KEY (a, b, …)`, columns in declared order. Its
-- identifiers were validated by `primaryKeyWithinSchema`.
tableConstraints : PrimaryKeyDecl -> List String
tableConstraints decl =
    case decl of
        CompositePk keyCols ->
            [ String.concat [ "PRIMARY KEY (", String.join ", " keyCols, ")" ] ]

        SinglePk _ ->
            []

        NoPk ->
            []


-- Every spec must name one of the codec's own derived columns; a spec for a
-- column absent from the codec is a silent no-op otherwise (its constraint
-- never attaches to any emitted column), so fail closed — mirroring how the
-- query leaves validate a `Cond` column with `condFragmentIn`. Defence in
-- depth: the accessor builders and `Codec.auto` both snake_case through the
-- one transform, so the names should already agree; this rejects the case
-- where they somehow do not, instead of silently dropping the constraint.
specsWithinColumns : List ColumnSpec -> List Column -> Result Error ()
specsWithinColumns specs cols =
    case specs of
        [] ->
            Ok ()

        first :: rest ->
            let
                name =
                    specColumn first
            in
            if hasColumn cols name then
                specsWithinColumns rest cols

            else
                Err (unknownColumnError name)


-- The column a spec constrains — every `ColumnSpec` variant carries it as its
-- first field.
specColumn : ColumnSpec -> String
specColumn spec =
    case spec of
        Serial c ->
            c

        Unique c ->
            c

        DefaultNow c ->
            c

        DefaultText c _ ->
            c

        DefaultInt c _ ->
            c

        TouchOnUpdate c ->
            c


columnDefs : PrimaryKeyDecl -> List ColumnSpec -> List Column -> Result Error (List String)
columnDefs decl specs columns =
    case columns of
        [] ->
            Ok []

        first :: rest ->
            case columnDef decl specs first of
                Err e ->
                    Err e

                Ok def ->
                    Result.map (\more -> def :: more) (columnDefs decl specs rest)


columnDef : PrimaryKeyDecl -> List ColumnSpec -> Column -> Result Error String
columnDef decl specs col =
    let
        name =
            columnName col

        inlineKey =
            isInlineKey decl name
    in
    if Basics.not (validSqlIdentPlain name) then
        Err (invalidIdentError "column" name)

    else if List.any (\s -> specIsSerial s name) specs && Basics.not inlineKey then
        Err (serialWithoutPkError name)

    else if List.any (\s -> specHasUnsafeDefaultText s name) specs then
        Err (invalidDefaultTextError name)

    else
        Ok
            (String.concat
                [ name
                , " "
                , sqlType (columnColType col)
                , columnConstraints inlineKey specs name
                ]
            )


sqlType : ColType -> String
sqlType colType =
    case colType of
        CText ->
            "TEXT"

        CInt ->
            "INTEGER"

        CReal ->
            "REAL"

        CBool ->
            "INTEGER"

        CTime ->
            "INTEGER"

        CDecimal ->
            "TEXT"

        CMoney ->
            "TEXT"

        CBlob ->
            "TEXT"

        CNull inner ->
            sqlType inner


-- | Build the SQL constraint suffix for `name` from the store's specs.
--
-- SQLite requires `PRIMARY KEY AUTOINCREMENT` in exactly that order; emitting
-- `AUTOINCREMENT` before `PRIMARY KEY` is a syntax error (SQLITE_ERROR).
-- Instead of concatenating each spec's fragment in arbitrary list order, we
-- emit in the canonical SQL constraint order:
--   PRIMARY KEY  →  AUTOINCREMENT  →  UNIQUE  →  DEFAULT …
-- A `Serial` column that is the inline key therefore always gets
-- `PRIMARY KEY AUTOINCREMENT`, regardless of the order the caller applied the
-- builders. `inlineKey` is derived from the store's one key declaration
-- (`isInlineKey`), never from a spec.
columnConstraints : Bool -> List ColumnSpec -> String -> String
columnConstraints inlineKey specs name =
    let
        isSerial =
            List.any (\s -> specIsSerial s name) specs

        isUnique =
            List.any (\s -> specIsUnique s name) specs

        defaultNowFragment =
            if List.any (\s -> specIsDefaultNow s name) specs then
                " DEFAULT CURRENT_TIMESTAMP"

            else
                ""

        defaultLiteralFragment =
            case List.filterMap (\s -> specDefaultLiteral s name) specs of
                literal :: _ ->
                    String.concat [ " DEFAULT ", literal ]

                [] ->
                    ""

        pkFragment =
            if inlineKey then
                " PRIMARY KEY"

            else
                ""

        autoincFragment =
            if isSerial then
                " AUTOINCREMENT"

            else
                ""

        uniqueFragment =
            if isUnique && Basics.not inlineKey then
                " UNIQUE"

            else
                ""
    in
    String.concat [ pkFragment, autoincFragment, uniqueFragment, defaultNowFragment, defaultLiteralFragment ]


specIsSerial : ColumnSpec -> String -> Bool
specIsSerial spec name =
    case spec of
        Serial c ->
            c == name

        Unique _ ->
            False

        DefaultNow _ ->
            False

        DefaultText _ _ ->
            False

        DefaultInt _ _ ->
            False

        TouchOnUpdate _ ->
            False


specIsUnique : ColumnSpec -> String -> Bool
specIsUnique spec name =
    case spec of
        Unique c ->
            c == name

        Serial _ ->
            False

        DefaultNow _ ->
            False

        DefaultText _ _ ->
            False

        DefaultInt _ _ ->
            False

        TouchOnUpdate _ ->
            False


specIsDefaultNow : ColumnSpec -> String -> Bool
specIsDefaultNow spec name =
    case spec of
        DefaultNow c ->
            c == name

        TouchOnUpdate c ->
            c == name

        Serial _ ->
            False

        Unique _ ->
            False

        DefaultText _ _ ->
            False

        DefaultInt _ _ ->
            False


-- The literal `DEFAULT` clause a typed default spec contributes for `name`, or
-- `Nothing` when `spec` sets no literal default there. `DefaultInt` renders as
-- its own digits (no injection surface); `DefaultText` is emitted as an escaped
-- single-quoted SQL string literal (every embedded quote doubled), so no caller
-- text can break out of the literal.
specDefaultLiteral : ColumnSpec -> String -> Maybe String
specDefaultLiteral spec name =
    case spec of
        DefaultText c value ->
            if c == name then
                Just (sqlTextLiteral value)

            else
                Nothing

        DefaultInt c value ->
            if c == name then
                Just (String.fromInt value)

            else
                Nothing

        Serial _ ->
            Nothing

        Unique _ ->
            Nothing

        DefaultNow _ ->
            Nothing

        TouchOnUpdate _ ->
            Nothing


-- `True` when `spec` sets a DEFAULT text literal on `name` whose value is not
-- safe to embed verbatim in DDL — see `defaultTextByteSafe`. Drives the
-- fail-closed rejection in `columnDef`, so an unsafe value never reaches
-- `sqlTextLiteral`.
specHasUnsafeDefaultText : ColumnSpec -> String -> Bool
specHasUnsafeDefaultText spec name =
    case spec of
        DefaultText c value ->
            c == name && Basics.not (defaultTextByteSafe value)

        DefaultInt _ _ ->
            False

        Serial _ ->
            False

        Unique _ ->
            False

        DefaultNow _ ->
            False

        TouchOnUpdate _ ->
            False


-- `True` when every byte of a DEFAULT text value is safe to embed in a
-- single-quoted DDL literal, independent of the backend's quoting mode. A
-- schema DEFAULT is a fixed compile-time constant, so it has no legitimate need
-- for a control byte, a newline, a NUL, or a backslash — and each of those is a
-- literal-breakout or injection hazard the single-quote-doubling escape does not
-- close on its own:
--   * a control byte / newline / NUL would be embedded verbatim into the
--     emitted `CREATE TABLE` text (no bound parameter guards a DDL DEFAULT),
--     the same class the DSN parser refuses at its own boundary;
--   * a backslash makes `''`-doubling complete ONLY when the backend treats `\`
--     as a literal byte — always true for SQLite, but for Postgres only while
--     `standard_conforming_strings` is on (a session setting this runtime never
--     asserts). With it off, a trailing `\` before a doubled quote can consume
--     one quote as an escape and break out of the literal. Refusing the
--     backslash removes that single-point dependence rather than trusting the
--     session flag (defend in depth).
-- Rejecting these values is fail-closed at the construction site: with no proof
-- the value is safe under every backend, the representable outcome is rejection.
defaultTextByteSafe : String -> Bool
defaultTextByteSafe value =
    String.all defaultTextCharSafe value


-- `True` when a single character is safe in a DDL DEFAULT text literal: a
-- printable, non-backslash character. Rejects every C0 control (code < 32,
-- which includes newline `\n` and NUL), the DEL control (code 127), and the
-- backslash (code 92).
defaultTextCharSafe : Char -> Bool
defaultTextCharSafe c =
    let
        code =
            Char.toCode c
    in
    code >= 32 && code /= 127 && code /= 92


-- Render `value` as a single-quoted SQL string literal, doubling every embedded
-- single quote. `columnDef` has already rejected any `value` carrying a
-- control byte, newline, NUL, or backslash (see `defaultTextByteSafe`), so the
-- doubled-quote escape here is complete under every backend quoting mode: the
-- only remaining metacharacter is the single quote, and a doubled `''` can
-- neither terminate the literal nor start new SQL. Used only for the DDL
-- `DEFAULT` clause, where a bound parameter is not permitted.
sqlTextLiteral : String -> String
sqlTextLiteral value =
    String.concat [ "'", String.replace "'" "''" value, "'" ]


-- | `create conn store` — create the store's table if it does not exist, via
-- the versioned `Db.migrate` ledger. For a store with rename ops, use
-- `migrations` to obtain the full ordered entry list instead. Fails closed if
-- the DDL cannot be built from validated identifiers (no SQL is issued in that
-- case). Idempotent: the ledger applies the migration once and records it.
create : Db -> Store a -> Task Error (List String)
create conn store =
    case migrations store of
        Err e ->
            Task.fail e

        Ok ms ->
            Db.migrate conn ms


migrationName : String -> String
migrationName table =
    String.concat [ "create_", table ]


-- ─── Row-level security (Pred/Policy algebra + Secured constructor) ─
--
-- Row security is DATA, not closures: a `Policy` is a small predicate algebra
-- (`Pred`) over the store's own validated column names, never a stored function
-- (Ipê forbids functions in records — and transparent data can be simplified,
-- explained, and its refusals generated, which an opaque predicate could not). A
-- `Policy` scopes one `Pred` per operation (read/insert/update/delete), so the
-- read/write split is total and fail-closed: an operation a builder does not open
-- stays `never`. Each row-side leaf names its column by an accessor literal
-- (`.author`), checked against the row type at compile time exactly like a query
-- column, so a policy over a non-existent or cross-row column is a build error;
-- every predicate lowers through the ONE audited `condFragmentIn` /
-- `Sql.column` / `Sql.param` path, adding no new SQL-injection surface.
--
-- Deny-by-default: a `Draft` is unqueryable until classified. A `Secured` store
-- is reachable only by attaching a policy through `secured`, and the
-- authenticated `…As` operations accept only a `Secured`. `secured` re-validates
-- every column any predicate names — across all four operations and at every
-- depth of the algebra — against the draft's codec-derived columns (the same
-- fail-closed check the query leaves use), so a policy that names a column the
-- draft does not have is a typed `Err`, never a silently ineffective policy.


-- ─── Row-security predicate algebra (`Pred`) ───────────────────────
--
-- A `Pred row` is the transparent-data predicate a policy is built from. It is
-- NOT a closure (Ipê forbids functions in records, and an opaque
-- `row -> Principal -> Bool` could be neither simplified, explained, nor its
-- refusals generated). Every leaf is either a validated-column comparison
-- (through the shared, audited `Cond` path) or a principal-bound term whose
-- value is bound as a `Sql.param` at lowering — no leaf ever builds SQL text, so
-- the algebra adds NO injection surface over the single `condFragmentIn` audit.


-- | An opaque row-security predicate over a `Store row`'s rows. Boolean structure
-- (`allOf` / `anyOf` / `notPred` / `always` / `never`) closes over a row-side leaf
-- (`matchWhere`, embedding a validated `Cond row`) and the principal-side leaves:
-- the owner leaf `POwner` (the `column = $subject` term the owner-scoped policy
-- builders produce, bound at lowering through `Auth.subject`), and the
-- caller-claim leaves `PRole` / `PMemberOf` / `PClaimEquals` (whether the
-- authenticated caller holds a role, a group, or a claim value). Phantom in `row`,
-- exactly as `Cond row` is: the constructors carry only concrete data, so the
-- runtime value is untyped data while the surface stays row-checked. Carries no
-- functions, so structural `==` holds — the simplifier can dedupe leaves.
--
-- The caller-claim leaves name NO row column: they gate on WHO is asking, not on
-- the row's contents. Their answer is fixed once the `Principal` is in hand (the
-- verified claims travel with it), so `predFragmentIn` folds each to the always-
-- true or always-false identity fragment at lowering — never a per-row column
-- comparison. Fail-closed by construction: the fold consults the fail-closed
-- `Auth.hasRole` / `Auth.memberOf` / `Auth.claim` accessors, so an absent role,
-- group, or claim contributes the FALSE (deny) fragment, never the TRUE one — a
-- caller the leaf cannot prove satisfies it is denied.
type Pred row
    = PAll (List (Pred row))
    | PAny (List (Pred row))
    | PNotP (Pred row)
    | PAlways
    | PNever
    | PMatch (Cond row)
    | POwner String
    | PRole String
    | PMemberOf String
    | PClaimEquals String String
    | PExists (ExistsRef row)


-- | The transparent data an `existsIn` predicate lowers from: everything the
-- correlated `EXISTS` subquery needs is captured HERE at `existsIn` time (the
-- share store is in hand), so `predFragmentIn` builds the subquery with no
-- closure and no deferred lookup. `shareTable` is the share store's validated
-- table name; `shareColumns` are the share store's own columns (so the share
-- read predicate and the correlation's share side are re-validated against
-- them, never against the outer row's); `shareRead` is the share store's OWN
-- read predicate, composed into the subquery's WHERE (defence in depth — a row
-- the share's policy denies never satisfies the `EXISTS`); `shareCol` /
-- `outerCol` are the two correlation columns (`shares.doc = docs.id`), the share
-- side validated against `shareColumns`, the outer side against the enclosing
-- store's columns. Carries no functions, so structural `==` holds and the
-- simplifier can dedupe.
--
-- Phantom in `row` exactly as `Pred row` is: `shareRead`'s phantom is the
-- share store's row type, but the phantom carries no runtime value, so it rides
-- the enclosing `row` phantom here — the share side is kept honest by
-- `shareColumns` (the real column strings), never by the phantom. `existsIn`'s
-- scheme pins the surface types; `secured` re-validates BOTH sides' columns.
type ExistsRef row
    = ExistsRef
        { shareTable : String
        , shareColumns : List Column
        , shareRead : Pred row
        , shareCol : String
        , outerCol : String
        }


-- | `always` — the predicate that matches every row (an explicit empty
-- conjunction). The identity element of `allOf`.
always : Pred row
always =
    PAlways


-- | `never` — the predicate that matches no row (an explicit empty disjunction).
-- The identity element of `anyOf` and the fail-closed default: every operation a
-- `Policy` builder does not open is scoped to `never`, so an unspecified write
-- has no representation as an open write.
never : Pred row
never =
    PNever


-- | `allOf preds` — the conjunction of `preds` (AND). `allOf []` is `always`
-- (the empty conjunction matches every row — its documented identity element).
allOf : List (Pred row) -> Pred row
allOf preds =
    PAll preds


-- | `anyOf preds` — the disjunction of `preds` (OR). `anyOf []` is `never` (the
-- empty disjunction matches no row — its documented identity element, so an empty
-- set of alternatives fails closed rather than matching everything).
anyOf : List (Pred row) -> Pred row
anyOf preds =
    PAny preds


-- | `notPred p` — the negation of `p`. Named `notPred` rather than `not` because
-- `Store.not` is already the `Cond` connective; Ipê has no ad-hoc overloading.
notPred : Pred row -> Pred row
notPred p =
    PNotP p


-- | `matchWhere cond` — a row-side leaf that lifts a validated `Cond row` (built
-- from the store's own accessor leaves, e.g. `Store.eq .status "published"`) into
-- the predicate algebra. Reuses the `Cond` path verbatim: the column is checked
-- against the row type at compile time and validated again at lowering, and the
-- value binds through `Sql.param` — one audit, no new SQL surface.
--
-- Example:
--
--     Store.matchWhere (Store.eq .status "published")
matchWhere : Cond row -> Pred row
matchWhere cond =
    PMatch cond


-- | `role name` — a principal-side leaf that admits every row when the
-- authenticated caller holds the role `name`, and denies every row when it does
-- not. It gates on WHO is asking, not on any row column, so unlike `matchWhere`
-- it names no column and its answer is fixed the moment the `Principal` is in
-- hand — `predFragmentIn` folds it to the always-true or always-false fragment at
-- lowering (never a per-row comparison).
--
-- Fail-closed: roles are read through the fail-closed `Auth.hasRole` accessor (the
-- conventional space-separated `roles` claim), so a caller whose token carries no
-- `roles` claim, or a `roles` claim without `name`, is DENIED — an absent role
-- never admits a row. AND it into a read policy to restrict a table to a role, or
-- `anyOf` it with an owner leaf to admit either the owner or a privileged role.
--
-- Example (only an `admin` caller may read; others see no row):
--
--     Store.readOnly (Store.role "admin")
--
-- Example (the owner, or any `admin`, may read):
--
--     Store.readOnly
--         (Store.anyOf [ Store.matchWhere (Store.eq .owner "…"), Store.role "admin" ])
role : String -> Pred row
role name =
    PRole name


-- | `memberOf group` — a principal-side leaf that admits every row when the
-- authenticated caller belongs to `group`, and denies every row otherwise. Like
-- `role`, it gates on the caller (not on a row column) and folds to the always-
-- true or always-false fragment at lowering once the `Principal` is in hand.
--
-- Fail-closed: group membership is read through the fail-closed `Auth.memberOf`
-- accessor (the conventional space-separated `groups` claim), so a caller whose
-- token carries no `groups` claim, or a `groups` claim without `group`, is
-- DENIED — an absent group never admits a row.
--
-- Example (only members of the `platform` group may read):
--
--     Store.readOnly (Store.memberOf "platform")
memberOf : String -> Pred row
memberOf group =
    PMemberOf group


-- | `claimEquals key value` — a principal-side leaf that admits every row when the
-- authenticated caller's verified claim `key` equals `value`, and denies every row
-- otherwise. Like `role` / `memberOf`, it gates on the caller (not on a row
-- column) and folds to the always-true or always-false fragment at lowering.
--
-- The test is claim-equals-a-required-value, not mere claim-presence: the leaf
-- reads the claim through the fail-closed `Auth.claim` accessor (which is
-- `Nothing` when the token carried no such claim) and admits ONLY when the claim
-- is present AND its verified value equals `value`. Fail-closed on both counts —
-- an absent claim (`Nothing`) and a claim whose value differs are each DENIED, so
-- a caller the leaf cannot prove carries the exact claim value is turned away.
--
-- Example (only a caller whose verified `tenant` claim is `"acme"` may read):
--
--     Store.readOnly (Store.claimEquals "tenant" "acme")
claimEquals : String -> String -> Pred row
claimEquals key value =
    PClaimEquals key value


-- | `correlate shareColumn rowColumn` — the column=column correlation leaf of an
-- `existsIn` predicate. It equates a `share`-side column with the OUTER `row`-side
-- column (`shares.doc = docs.id`) — the one comparison `matchWhere` cannot
-- express, because a `Cond`'s right-hand side is always a bound value, never
-- another row's column. Each argument is a column read directly off its binder
-- (`share.docId`, `doc.id`); the shared value type `t` keeps a share column and an
-- outer column of unequal type from being equated, and the intercept reads each
-- `.field` access structurally at lowering. Valid ONLY as the body (or an `allOf`
-- element) of an `existsIn` lambda — a point-free or standalone use fails closed
-- at lowering.
--
-- Example:
--
--     Store.existsIn shares (\share doc -> Store.correlate share.docId doc.id)
correlate : t -> t -> Pred share
correlate =
    Kernel.kernel "Store_correlate"


-- | `existsIn shares lambda` — a correlated-subquery row-security predicate over
-- the enclosing store: the outer row is admitted only when a row of the
-- referenced `shares` store satisfies BOTH the lambda's `correlate` correlation
-- AND `shares`'s OWN read policy (composed into the subquery's WHERE, defence in
-- depth). Lowered to `EXISTS (SELECT 1 FROM <shares-table> WHERE <correlation>
-- AND <shares read policy>)` through the audited `Sql.exists` / `Sql.column` /
-- `Sql.and` path — the table is validated, both correlation columns are
-- `Sql.column` references (never caller text), and no value is interpolated, so
-- the subquery adds no injection surface. `secured` re-validates every column
-- `existsIn` names on BOTH the share side and the outer side.
--
-- Example (a doc is readable when the caller has a share row for it):
--
--     Store.readOnly
--         (Store.existsIn securedShares
--             (\share doc -> Store.correlate share.docId doc.id)
--         )
existsIn : Secured share -> (share -> row -> Pred share) -> Pred row
existsIn =
    Kernel.kernel "Store_existsIn"


-- The stringly form the `existsIn` intercept builds: the intercept extracts the
-- two correlation columns from the `correlate` lambda (compile-time, from each
-- `.field` access) and passes the referenced share store's runtime `Secured` value
-- through; the share table, columns, and OWN read predicate are read from it
-- HERE (runtime), so the `PExists` leaf carries transparent data with no closure.
-- Exported only so the intercept can name it; a caller writes `existsIn` with a
-- `correlate` lambda.
existsInNamed : Secured share -> String -> String -> Pred row
existsInNamed shareSecured shareCol outerCol =
    case shareSecured of
        Secured shareStore sharePolicy ->
            case shareStore of
                Store s ->
                    PExists
                        (ExistsRef
                            { shareTable = s.table
                            , shareColumns = s.currentColumns
                            , shareRead = recastPred (readPred sharePolicy)
                            , shareCol = shareCol
                            , outerCol = outerCol
                            }
                        )


-- Recast a predicate's phantom row type. A `Pred` carries only transparent data
-- (column-name strings, `Cond` leaves, nested `ExistsRef`s) — never a `row`
-- value — so reinterpreting the phantom is a total structural identity rebuild,
-- not a cast: the referenced share store's read predicate (`Pred share`) is
-- carried inside a `PExists` leaf of the outer `Pred row`, where the two phantom
-- rows differ but neither constrains the runtime data. The share side stays
-- honest through `shareColumns` (the real column strings), never the phantom.
recastPred : Pred a -> Pred b
recastPred pred =
    case pred of
        PAll preds ->
            PAll (List.map recastPred preds)

        PAny preds ->
            PAny (List.map recastPred preds)

        PNotP inner ->
            PNotP (recastPred inner)

        PAlways ->
            PAlways

        PNever ->
            PNever

        PMatch cond ->
            PMatch (recastCond cond)

        POwner col ->
            POwner col

        PRole name ->
            PRole name

        PMemberOf group ->
            PMemberOf group

        PClaimEquals key value ->
            PClaimEquals key value

        PExists ref ->
            PExists (recastExistsRef ref)


-- Recast a `Cond`'s phantom row type — a total structural identity rebuild, the
-- `Cond` twin of `recastPred` (a `Cond` carries only column strings and bound
-- `SqlValue`s, never a `row` value).
recastCond : Cond a -> Cond b
recastCond cond =
    case cond of
        Compare op col value ->
            Compare op col value

        Like col pattern ->
            Like col pattern

        IsNull col ->
            IsNull col

        NotNull col ->
            NotNull col

        InList col values ->
            InList col values

        AndList conds ->
            AndList (List.map recastCond conds)

        OrList conds ->
            OrList (List.map recastCond conds)

        NotCond inner ->
            NotCond (recastCond inner)


-- Recast an `ExistsRef`'s phantom row type — its `shareRead` is itself a `Pred`,
-- rebuilt through `recastPred`; every other field is transparent data.
recastExistsRef : ExistsRef a -> ExistsRef b
recastExistsRef ref =
    case ref of
        ExistsRef r ->
            ExistsRef
                { shareTable = r.shareTable
                , shareColumns = r.shareColumns
                , shareRead = recastPred r.shareRead
                , shareCol = r.shareCol
                , outerCol = r.outerCol
                }


-- The columns a predicate names, gathered across the whole algebra (not only the
-- top level), so `secured` can re-validate EVERY column any branch references —
-- a policy naming a missing column is a typed `Err`, never a silently ineffective
-- filter. `always` / `never` name none.
predColumns : Pred row -> List String
predColumns pred =
    case pred of
        PAll preds ->
            List.concatMap predColumns preds

        PAny preds ->
            List.concatMap predColumns preds

        PNotP inner ->
            predColumns inner

        PAlways ->
            []

        PNever ->
            []

        PMatch cond ->
            condColumns cond

        POwner col ->
            [ col ]

        PRole _ ->
            -- A caller-claim leaf names no row column (it gates on the principal,
            -- not the row), so it contributes nothing for `secured` to validate.
            []

        PMemberOf _ ->
            []

        PClaimEquals _ _ ->
            []

        PExists ref ->
            -- Only the OUTER-side correlation column belongs to the enclosing
            -- store, so it is the one `secured` re-validates here. The share-side
            -- columns (the correlation's share side + every column the share read
            -- predicate names) live in the DIFFERENT share table and are
            -- re-validated against the share store's own columns by
            -- `existsShareColumnsValid`, called from `secured` alongside this.
            case ref of
                ExistsRef r ->
                    [ r.outerCol ]


-- The share-side columns an `existsIn` predicate names — the correlation's share
-- side plus every column the share read predicate names — each of which MUST be a
-- real column of the SHARE store (`shareColumns`), never the outer store. Returns
-- the first share-side column absent from `shareColumns`, or `Nothing` when every
-- share-side column exists. `secured` walks this over the whole algebra so a
-- correlation naming a missing column on the SHARE side fails closed exactly as a
-- missing outer column does.
firstUnknownExistsShareColumn : Pred row -> Maybe String
firstUnknownExistsShareColumn pred =
    case pred of
        PAll preds ->
            firstUnknownExistsShareColumnIn preds

        PAny preds ->
            firstUnknownExistsShareColumnIn preds

        PNotP inner ->
            firstUnknownExistsShareColumn inner

        PAlways ->
            Nothing

        PNever ->
            Nothing

        PMatch _ ->
            Nothing

        POwner _ ->
            Nothing

        PRole _ ->
            Nothing

        PMemberOf _ ->
            Nothing

        PClaimEquals _ _ ->
            Nothing

        PExists ref ->
            case ref of
                ExistsRef r ->
                    firstUnknownPolicyColumn r.shareColumns
                        (r.shareCol :: predColumns r.shareRead)


-- `firstUnknownExistsShareColumn` folded over a predicate list, first miss wins.
firstUnknownExistsShareColumnIn : List (Pred row) -> Maybe String
firstUnknownExistsShareColumnIn preds =
    case preds of
        [] ->
            Nothing

        first :: rest ->
            case firstUnknownExistsShareColumn first of
                Just bad ->
                    Just bad

                Nothing ->
                    firstUnknownExistsShareColumnIn rest


-- The columns a `Cond` names, gathered across its boolean structure. Mirrors the
-- `Cond` ADT so a column buried under an `AndList` / `OrList` / `NotCond` is still
-- re-validated by `secured`.
condColumns : Cond row -> List String
condColumns cond =
    case cond of
        Compare _ col _ ->
            [ col ]

        Like col _ ->
            [ col ]

        IsNull col ->
            [ col ]

        NotNull col ->
            [ col ]

        InList col _ ->
            [ col ]

        AndList conds ->
            List.concatMap condColumns conds

        OrList conds ->
            List.concatMap condColumns conds

        NotCond inner ->
            condColumns inner


-- ─── Algebraic simplifier ──────────────────────────────────────────
--
-- Simplify the transparent predicate data before lowering, so the emitted WHERE
-- is minimal and `explain` reads cleanly. Because a `Pred` is data (not a
-- closure) these rewrites are decidable: `anyOf [_, always] → always`,
-- `allOf [_, never] → never`, drop `always` from a conjunction and `never` from a
-- disjunction, constant-fold `notPred`, collapse a singleton, and dedupe
-- structurally-equal leaves (the ADT carries no functions, so `==` is total).


-- | `simplify p` — the minimal predicate equivalent to `p`.
simplify : Pred row -> Pred row
simplify pred =
    case pred of
        PAll preds ->
            simplifyAll (List.map simplify preds)

        PAny preds ->
            simplifyAny (List.map simplify preds)

        PNotP inner ->
            simplifyNot (simplify inner)

        PAlways ->
            PAlways

        PNever ->
            PNever

        PMatch cond ->
            PMatch cond

        POwner col ->
            POwner col

        PRole name ->
            PRole name

        PMemberOf group ->
            PMemberOf group

        PClaimEquals key value ->
            PClaimEquals key value

        PExists ref ->
            PExists ref


-- A conjunction of already-simplified children: `always` is dropped (its
-- identity), a single `never` short-circuits the whole conjunction to `never`,
-- duplicate children collapse, an empty result is `always`, and a lone child
-- unwraps.
simplifyAll : List (Pred row) -> Pred row
simplifyAll preds =
    if List.any predIsNever preds then
        PNever

    else
        case dedupePreds (List.filter (\p -> Basics.not (predIsAlways p)) preds) of
            [] ->
                PAlways

            [ single ] ->
                single

            kept ->
                PAll kept


-- A disjunction of already-simplified children: `never` is dropped (its
-- identity), a single `always` short-circuits to `always`, duplicates collapse,
-- an empty result is `never`, and a lone child unwraps.
simplifyAny : List (Pred row) -> Pred row
simplifyAny preds =
    if List.any predIsAlways preds then
        PAlways

    else
        case dedupePreds (List.filter (\p -> Basics.not (predIsNever p)) preds) of
            [] ->
                PNever

            [ single ] ->
                single

            kept ->
                PAny kept


-- Constant-fold a negation of an already-simplified predicate: `not always` is
-- `never`, `not never` is `always`, and a double negation cancels.
simplifyNot : Pred row -> Pred row
simplifyNot inner =
    case inner of
        PAlways ->
            PNever

        PNever ->
            PAlways

        PNotP again ->
            again

        PAll _ | PAny _ | PMatch _ | POwner _ | PRole _ | PMemberOf _ | PClaimEquals _ _ | PExists _ ->
            PNotP inner


predIsAlways : Pred row -> Bool
predIsAlways pred =
    case pred of
        PAlways ->
            True

        PNever | PNotP _ | PAll _ | PAny _ | PMatch _ | POwner _ | PRole _ | PMemberOf _ | PClaimEquals _ _ | PExists _ ->
            False


predIsNever : Pred row -> Bool
predIsNever pred =
    case pred of
        PNever ->
            True

        PAlways | PNotP _ | PAll _ | PAny _ | PMatch _ | POwner _ | PRole _ | PMemberOf _ | PClaimEquals _ _ | PExists _ ->
            False


-- Drop structurally-equal duplicates, keeping first occurrence. `Pred` carries no
-- functions, so `==` is a total structural comparison.
dedupePreds : List (Pred row) -> List (Pred row)
dedupePreds preds =
    List.foldr
        (\p acc ->
            if List.member p acc then
                acc

            else
                p :: acc
        )
        []
        preds


-- ─── Lowering `Pred` → `SqlFragment` (the SAME audited path) ────────
--
-- Every leaf reaches SQL only through the shared `condFragmentIn` / `Sql.column`
-- / `Sql.param` machinery the query builder already audits — ONE injection audit
-- for the whole module. `always` / `never` lower to the shared `trueFragment` /
-- `falseFragment` identities; `PMatch` delegates to `condFragmentIn`; `POwner`
-- binds the subject as a parameter against its validated column. A column absent
-- from the store is a fail-closed `Err` (parse-don't-validate).
--
-- `outerTable` is the enclosing store's validated table name, used to qualify the
-- OUTER correlation column of a `PExists` (`docs.id`) so it reaches out of the
-- subquery unambiguously; the share side is qualified by its own table.
predFragmentIn : Auth.Principal -> String -> List Column -> Pred row -> Result Error SqlFragment
predFragmentIn principal outerTable columns pred =
    case pred of
        PAlways ->
            Ok trueFragment

        PNever ->
            Ok falseFragment

        PMatch cond ->
            condFragmentIn columns cond

        POwner col ->
            checkColumn columns
                col
                (Sql.eq (Sql.column col) (Sql.param (SqlString (Auth.subject principal))))

        PRole name ->
            -- The caller's role is known once the principal is in hand, so this
            -- leaf folds to an admit/deny contribution at BUILD time rather than a
            -- per-row comparison. Fail-closed: `Auth.hasRole` reads `False` for an
            -- absent `roles` claim, so a caller without the role gets the FALSE
            -- (deny) fragment.
            Ok (admitFragment (Auth.hasRole name principal))

        PMemberOf group ->
            -- Same build-time fold as `PRole`; `Auth.memberOf` is fail-closed, so an
            -- absent `groups` claim (or the group absent from it) denies.
            Ok (admitFragment (Auth.memberOf group principal))

        PClaimEquals key value ->
            -- Admit only when the verified claim is present AND equals `value`;
            -- `Auth.claim` is `Nothing` for an absent claim, so both an absent claim
            -- and a mismatched value fold to the FALSE (deny) fragment.
            Ok (admitFragment (Auth.claim key principal == Just value))

        PNotP inner ->
            Result.map Sql.not (predFragmentIn principal outerTable columns inner)

        PAll preds ->
            foldPreds principal outerTable columns Sql.and trueFragment preds

        PAny preds ->
            foldPreds principal outerTable columns Sql.or falseFragment preds

        PExists ref ->
            existsFragment principal outerTable ref


-- Lower a `PExists` to `EXISTS (SELECT 1 FROM <share> WHERE <correlation> AND
-- <share read policy>)` through the audited `Sql.exists` / `Sql.column` /
-- `Sql.and` path. Injection-safe by construction: the share table is validated
-- inside `Sql.exists` (the same bare-identifier gate `Db.findWhere` uses), both
-- correlation columns are `Sql.column` references (validated, never caller text),
-- and no value is interpolated. The correlation qualifies the share side with the
-- share table and the outer side with the enclosing table so neither is
-- ambiguous. The share store's OWN read predicate is composed into the subquery
-- WHERE (defence in depth), lowered against the SHARE store's columns — a share
-- column named by the correlation or the share read predicate that the share
-- store lacks fails closed here as well as at `secured`.
existsFragment : Auth.Principal -> String -> ExistsRef row -> Result Error SqlFragment
existsFragment principal outerTable ref =
    case ref of
        ExistsRef r ->
            if Basics.not (hasColumn r.shareColumns r.shareCol) then
                Err (unknownColumnError r.shareCol)

            else
                let
                    qualifiedShareCol =
                        String.concat [ r.shareTable, ".", r.shareCol ]

                    qualifiedOuterCol =
                        String.concat [ outerTable, ".", r.outerCol ]

                    correlation =
                        Sql.eq (Sql.column qualifiedShareCol) (Sql.column qualifiedOuterCol)
                in
                -- The share read predicate is lowered against the SHARE store's
                -- columns and its own table (its columns are bare inside the
                -- single-FROM subquery), then AND-ed with the correlation. The
                -- outer table qualifier is irrelevant to the share read pred (it
                -- names no outer column), but threading the share table keeps a
                -- nested `existsIn` correct.
                case predFragmentIn principal r.shareTable r.shareColumns (simplify r.shareRead) of
                    Err e ->
                        Err e

                    Ok shareReadFrag ->
                        Ok (Sql.exists r.shareTable (Sql.and correlation shareReadFrag))


-- Fold a list of predicates with a binary connective, using `emptyFragment` as
-- the identity for the empty list. Each predicate is lowered (and column-checked)
-- before it joins, so the first invalid column fails the whole fold closed.
foldPreds : Auth.Principal -> String -> List Column -> (SqlFragment -> SqlFragment -> SqlFragment) -> SqlFragment -> List (Pred row) -> Result Error SqlFragment
foldPreds principal outerTable columns join emptyFragment preds =
    case preds of
        [] ->
            Ok emptyFragment

        [ single ] ->
            predFragmentIn principal outerTable columns single

        first :: rest ->
            case predFragmentIn principal outerTable columns first of
                Err e ->
                    Err e

                Ok head ->
                    Result.map (\tail -> join head tail)
                        (foldPreds principal outerTable columns join emptyFragment rest)


-- ─── Operation-scoped policy ────────────────────────────────────────


-- | An opaque, operation-scoped row-security policy: a `Pred row` per operation,
-- plus the columns write operations must force to the caller's subject
-- (`owners`) and the columns an update must never rewrite (`immutables`). The
-- four predicates make the read/insert/update/delete split TOTAL — there is no
-- unspecified operation, because every smart constructor scopes each field
-- explicitly and the fail-closed default is `never`, so an open write has no
-- representation. Phantom in `row`, so an accessor-named policy column is checked
-- against the store's row type when the policy is attached with `secured`. The
-- record shape is opaque (built only by the smart constructors below); `owners`
-- and `immutables` are the write-projection side of the algebra (forcing the
-- owner column on a write, dropping an immutable column from an update SET) that a
-- pure WHERE `Pred` cannot express.
type Policy row
    = Policy
        { read : Pred row
        , insert : Pred row
        , update : Pred row
        , delete : Pred row
        , owners : List String
        , immutables : List String
        , masks : List ( String, Pred row )
        }


-- | An opaque secured store: a `Store a` paired with a validated `Policy`. The
-- ONLY value the secured operations (`allAs` / `insertAs` / …) accept, so a
-- secured store is unreachable through the unsecured operations and cannot be read
-- unfiltered by mistake (deny-by-default). Built only by `secured`, which
-- re-validates every policy column against the store's columns, so a `Secured`
-- holds only a policy whose columns all exist on the store.
--
-- Parametric in the row type `a` (it carries the store's `Codec a`) so the secured
-- reads can decode rows through the store's own codec.
type Secured a
    = Secured (Store a) (Policy a)


-- The empty policy: every operation scoped to `never` (deny-by-default), no forced
-- owner column, no immutable column. The base the fail-closed constructors
-- (`readOnly`) open from, so an operation such a builder does not open stays
-- `never` — a hand-scoped policy that forgets a write has no open-write
-- representation.
denyAll : Policy row
denyAll =
    Policy
        { read = PNever
        , insert = PNever
        , update = PNever
        , delete = PNever
        , owners = []
        , immutables = []
        , masks = []
        }


-- The fully-open policy: every operation scoped to `always` (matches every row),
-- no forced owner column, no immutable column. The neutral base of `andPolicy`
-- (`always` is the identity of the per-operation conjunction) and the backing of
-- the legacy read-oriented builders, whose historical behaviour was to permit
-- every operation on a secured store (filtered only by the rules a caller AND-ed
-- in). Not exported: the fail-closed constructors are the caller surface for a
-- fresh policy; `allowAll` exists only so `unrestricted` / `publicRead` /
-- `immutable` preserve their observable behaviour.
allowAll : Policy row
allowAll =
    Policy
        { read = PAlways
        , insert = PAlways
        , update = PAlways
        , delete = PAlways
        , owners = []
        , immutables = []
        , masks = []
        }


-- | `unrestricted` — the policy whose every operation matches every row (reads
-- and writes are unfiltered; a secured store still routes writes through the
-- authenticated `…As` operations). Re-expressed over the algebra as `allowAll`.
-- "No restriction" is a deliberate, named choice rather than the absence of a
-- policy (which, deny-by-default, is instead an unsecured store).
--
-- Observable behaviour is unchanged from the former empty-conjunction form: every
-- operation's WHERE simplifies to the always-true identity fragment, exactly as
-- the former empty rule list produced.
unrestricted : Policy row
unrestricted =
    allowAll


-- | `publicRead` — reads are unrestricted while writes route through the secured
-- operations. Re-expressed as `allowAll`, preserving the former public-read rule's
-- observable behaviour (it added no read filter and left the write path open under
-- the secured operations). Kept distinct from `unrestricted` for the intent it
-- documents.
publicRead : Policy row
publicRead =
    allowAll


-- | `readOnly p` — a read-only policy: `read = p`, every write scoped to `never`
-- (fail-closed). The explicit constructor for read-only intent — a caller who
-- wants a write path opens it deliberately with `alsoInsert` / `alsoUpdate` /
-- `alsoDelete`, so no write is ever left open by omission.
readOnly : Pred row -> Policy row
readOnly p =
    case denyAll of
        Policy r ->
            Policy
                { read = p
                , insert = r.insert
                , update = r.update
                , delete = r.delete
                , owners = r.owners
                , immutables = r.immutables
                , masks = r.masks
                }


-- | `ownerColumn accessor` — the owner-scoped policy: all four operations are
-- scoped to `column = $subject`, and inserts/updates FORCE that column to the
-- caller's subject (so a caller can never write a row it could not read back).
-- Backward-compatible re-expression of the former single owner-column rule; its
-- observable SQL is unchanged (the read/get/update/delete WHERE is still
-- `column = $subject`, and writes still force the owner column).
--
-- The column is named by an accessor literal (`.author`), checked against the row
-- type at compile time and snake_cased at lowering, then delegated to
-- `ownerColumnNamed`.
--
-- Example:
--
--     Store.ownerColumn .author
ownerColumn : (row -> t) -> Policy row
ownerColumn =
    Kernel.kernel "Store_ownerColumn"


-- | `immutable accessor` — a policy whose accessor-named column cannot change
-- after insert: the column is dropped from every update SET (its stored value is
-- fixed at insert), while no operation is otherwise restricted. Composable: AND it
-- into an owner/read policy to add the update restriction without loosening any
-- operation (`always` is the neutral element of the per-operation conjunction).
-- Backward-compatible with the former immutable rule — it added no filter and only
-- dropped the column from an update, which this preserves exactly. Delegated to
-- `immutableNamed`.
--
-- Example:
--
--     Store.ownerColumn .author
--         |> Store.andPolicy (Store.immutable .createdAt)
immutable : (row -> t) -> Policy row
immutable =
    Kernel.kernel "Store_immutable"


-- | `mask accessor pred policy` — refine `policy` so the accessor-named column
-- is column-masked on every secured read: a row for which `pred` holds projects
-- the column's real value, a row for which it does not projects SQL `NULL`, which
-- the secured read decodes to `Nothing` (never `Just ""`). Masking a
-- non-nullable column is a typed `Err` at `secured` (the codec models
-- nullability, so a masked column MUST be `CNull _`). Composable: it only ADDS a
-- projection rule, restricting no operation, so it AND-composes with any policy.
--
-- The column is named by an accessor literal (`.ssn`), checked against the row
-- type at compile time and snake_cased at lowering, then delegated to
-- `maskNamed`. `pred` is a `Pred row` built from the same audited leaves as any
-- policy predicate (e.g. `Store.matchWhere (Store.eq .role "admin")`,
-- `Store.always` for an owner-only visibility rule composed elsewhere) — it
-- lowers through the ONE audited `predFragmentIn` path, so masking adds no
-- injection surface.
--
-- Example (an SSN is visible only to an admin caller):
--
--     Store.ownerColumn .owner
--         |> Store.andPolicy
--             (Store.readOnly Store.always
--                 |> Store.mask .ssn (Store.matchWhere (Store.eq .role "admin"))
--             )
mask : (row -> t) -> Pred row -> Policy row -> Policy row
mask =
    Kernel.kernel "Store_mask"


-- The stringly forms reached by the accessor-typed policy-builder intercepts
-- above. The accessor `.field` has already been turned into the validated,
-- snake_cased column name `col`. Exported only so the intercepts can name them; a
-- caller writes the accessor.
ownerColumnNamed : String -> Policy row
ownerColumnNamed col =
    case denyAll of
        Policy r ->
            Policy
                { read = POwner col
                , insert = POwner col
                , update = POwner col
                , delete = POwner col
                , owners = [ col ]
                , immutables = r.immutables
                , masks = r.masks
                }


immutableNamed : String -> Policy row
immutableNamed col =
    case allowAll of
        Policy r ->
            Policy
                { read = r.read
                , insert = r.insert
                , update = r.update
                , delete = r.delete
                , owners = r.owners
                , immutables = [ col ]
                , masks = r.masks
                }


-- The stringly form the `mask` accessor intercept builds: the accessor `.field`
-- has already been turned into the validated, snake_cased column name `col`.
-- Records the `(col, pred)` mask on the policy through a full record literal (no
-- generic record update). Exported only so the intercept can name it; a caller
-- writes `mask` with an accessor.
maskNamed : String -> Pred row -> Policy row -> Policy row
maskNamed col pred policy =
    case policy of
        Policy r ->
            Policy
                { read = r.read
                , insert = r.insert
                , update = r.update
                , delete = r.delete
                , owners = r.owners
                , immutables = r.immutables
                , masks = r.masks ++ [ ( col, pred ) ]
                }


-- | `andPolicy extra base` — compose two policies: conjoin each operation's
-- predicate (`allOf [ base.op, extra.op ]`) and union the forced-owner and
-- immutable column sets. Named `andPolicy` rather than `and` because `Store.and`
-- is already the `Cond` connective; Ipê has no ad-hoc overloading.
--
-- Backward-compatible with the former rule-list concatenation: the former
-- `Policy (a ++ b)` applied every rule as a conjunction to the read/write WHERE
-- and unioned the owner/immutable rule sets, which conjoining the per-operation
-- predicates and unioning the column sets reproduces exactly.
--
-- Example:
--
--     Store.ownerColumn .author
--         |> Store.andPolicy (Store.immutable .createdAt)
andPolicy : Policy row -> Policy row -> Policy row
andPolicy extra base =
    case base of
        Policy b ->
            case extra of
                Policy e ->
                    Policy
                        { read = PAll [ b.read, e.read ]
                        , insert = PAll [ b.insert, e.insert ]
                        , update = PAll [ b.update, e.update ]
                        , delete = PAll [ b.delete, e.delete ]
                        , owners = b.owners ++ e.owners
                        , immutables = b.immutables ++ e.immutables
                        , masks = b.masks ++ e.masks
                        }


-- | `alsoInsert p base` — open the insert path of `base` to `p` (deliberately
-- lifting insert off its `never` default).
alsoInsert : Pred row -> Policy row -> Policy row
alsoInsert p base =
    case base of
        Policy r ->
            Policy
                { read = r.read
                , insert = p
                , update = r.update
                , delete = r.delete
                , owners = r.owners
                , immutables = r.immutables
                , masks = r.masks
                }


-- | `alsoUpdate p base` — open the update path of `base` to `p`.
alsoUpdate : Pred row -> Policy row -> Policy row
alsoUpdate p base =
    case base of
        Policy r ->
            Policy
                { read = r.read
                , insert = r.insert
                , update = p
                , delete = r.delete
                , owners = r.owners
                , immutables = r.immutables
                , masks = r.masks
                }


-- | `alsoDelete p base` — open the delete path of `base` to `p`.
alsoDelete : Pred row -> Policy row -> Policy row
alsoDelete p base =
    case base of
        Policy r ->
            Policy
                { read = r.read
                , insert = r.insert
                , update = r.update
                , delete = p
                , owners = r.owners
                , immutables = r.immutables
                , masks = r.masks
                }


-- ─── `explain` — render a policy as English (emitted above the SQL) ──


-- | `explain policy` — a human-readable rendering of the (simplified) policy, one
-- line per operation. Because a `Policy` is transparent data, its meaning can be
-- explained in full; the emitted SQL carries this as a leading comment so a
-- reviewer reads the intent beside the generated WHERE.
explain : Policy row -> String
explain policy =
    case policy of
        Policy r ->
            String.join "\n"
                [ explainOp "read" r.read
                , explainOp "insert" r.insert
                , explainOp "update" r.update
                , explainOp "delete" r.delete
                , explainImmutables r.immutables
                , explainMasks r.masks
                ]


explainMasks : List ( String, Pred row ) -> String
explainMasks masks =
    if List.isEmpty masks then
        "masked columns: none"

    else
        String.concat
            [ "masked columns: "
            , String.join ", " (List.map explainMask masks)
            ]


explainMask : ( String, Pred row ) -> String
explainMask pair =
    case pair of
        ( col, pred ) ->
            String.concat
                [ col, " when (", explainPred (simplify pred), ")" ]


explainOp : String -> Pred row -> String
explainOp label pred =
    String.concat [ label, ": ", explainPred (simplify pred) ]


explainPred : Pred row -> String
explainPred pred =
    case pred of
        PAlways ->
            "every row"

        PNever ->
            "no row (denied)"

        POwner col ->
            String.concat [ col, " = caller subject" ]

        PRole name ->
            String.concat [ "caller holds role ", name ]

        PMemberOf group ->
            String.concat [ "caller is member of group ", group ]

        PClaimEquals key value ->
            String.concat [ "caller claim ", key, " = ", value ]

        PMatch _ ->
            "a column condition"

        PNotP inner ->
            String.concat [ "not (", explainPred inner, ")" ]

        PAll preds ->
            String.concat [ "all of [", String.join ", " (List.map explainPred preds), "]" ]

        PAny preds ->
            String.concat [ "any of [", String.join ", " (List.map explainPred preds), "]" ]

        PExists ref ->
            case ref of
                ExistsRef r ->
                    String.concat
                        [ "exists in "
                        , r.shareTable
                        , " where "
                        , r.shareTable
                        , "."
                        , r.shareCol
                        , " = "
                        , r.outerCol
                        , " and its read policy: ("
                        , explainPred (simplify r.shareRead)
                        , ")"
                        ]


explainImmutables : List String -> String
explainImmutables cols =
    if List.isEmpty cols then
        "immutable columns: none"

    else
        String.concat [ "immutable columns: ", String.join ", " cols ]


-- | `secured policy draft` — classify `draft` by attaching `policy`, or fail
-- closed. One of the two `Draft` → queryable promotions (`public` is the other):
-- it yields an opaque `Secured a`, the only value the authenticated `…As`
-- operations accept. Every column any predicate names — across read/insert/
-- update/delete AND the forced-owner and immutable column sets, at every depth of
-- the algebra — is re-validated against the draft's own codec-derived columns (the
-- same `hasColumn` check the query leaves use): a policy column absent from the
-- draft is a typed `Err`, never a silently ineffective policy. Deny-by-default
-- holds — a table is queryable only through a deliberate classification, and a
-- `secured` table is reachable only with a `Principal` through the `…As`
-- operations.
--
-- Example:
--
--     Store.secured
--         (Store.ownerColumn .author
--             |> Store.andPolicy (Store.immutable .createdAt)
--         )
--         draft
secured : Policy a -> Draft a -> Result Error (Secured a)
secured policy draft =
    case draft of
        Draft r ->
            case firstUnknownPolicyColumn r.currentColumns (policyColumns policy) of
                Just bad ->
                    Err (unknownColumnError bad)

                Nothing ->
                    -- Defence in depth: the OUTER-side columns are re-validated
                    -- above against the draft's columns; each `existsIn`'s
                    -- SHARE-side columns are re-validated here against the share
                    -- store's own columns (carried in the `PExists` leaf), so a
                    -- correlation naming a missing column on EITHER side fails
                    -- closed at classification.
                    case firstUnknownPolicyExistsShareColumn policy of
                        Just bad ->
                            Err (unknownColumnError bad)

                        Nothing ->
                            -- A masked column MUST be nullable (`CNull _`): the
                            -- unauthorized row projects SQL `NULL`, which only a
                            -- nullable codec column can decode (to `Nothing`).
                            -- Masking a non-nullable column would NULL a value the
                            -- decoder cannot represent — a fail-closed typed `Err`
                            -- at classification, never a decode panic at read time
                            -- (the soundness SEAL).
                            case firstNonNullableMaskColumn r.currentColumns policy of
                                Just bad ->
                                    Err (nonNullableMaskError bad)

                                Nothing ->
                                    Ok (Secured (public draft) policy)


-- The first masked column of `policy` whose store column type is NOT nullable
-- (`CNull _`), or `Nothing` when every masked column is nullable. A masked column
-- absent from the store is already rejected by the `policyColumns` check, so a
-- column reaching here is present; only its nullability is in question.
firstNonNullableMaskColumn : List Column -> Policy a -> Maybe String
firstNonNullableMaskColumn columns policy =
    case policy of
        Policy r ->
            firstNonNullableMaskColumnIn columns (List.map maskColumn r.masks)


firstNonNullableMaskColumnIn : List Column -> List String -> Maybe String
firstNonNullableMaskColumnIn columns cols =
    case cols of
        [] ->
            Nothing

        col :: rest ->
            if columnIsNullable columns col then
                firstNonNullableMaskColumnIn columns rest

            else
                Just col


-- Whether `name`'s store column type is nullable (`CNull _`). A column absent
-- from the store is treated as non-nullable (fail-closed), though `secured`'s
-- earlier column-existence check makes that case unreachable for a real policy.
columnIsNullable : List Column -> String -> Bool
columnIsNullable columns name =
    case columnColTypeByName columns name of
        Just (CNull _) ->
            True

        Just CText ->
            False

        Just CInt ->
            False

        Just CReal ->
            False

        Just CBool ->
            False

        Just CTime ->
            False

        Just CDecimal ->
            False

        Just CMoney ->
            False

        Just CBlob ->
            False

        Nothing ->
            False


-- The `ColType` of the store column named `name`, or `Nothing` when no such
-- column exists.
columnColTypeByName : List Column -> String -> Maybe ColType
columnColTypeByName columns name =
    case columns of
        [] ->
            Nothing

        first :: rest ->
            if columnName first == name then
                Just (columnColType first)

            else
                columnColTypeByName rest name


-- The first share-side column any `existsIn` in `policy` names that is absent
-- from that `existsIn`'s share store, across all four operation predicates.
firstUnknownPolicyExistsShareColumn : Policy a -> Maybe String
firstUnknownPolicyExistsShareColumn policy =
    case policy of
        Policy r ->
            firstUnknownExistsShareColumnIn
                ([ r.read, r.insert, r.update, r.delete ]
                    ++ List.map maskPred r.masks
                )


-- Every column a policy names, across all four predicates and the write-projection
-- column sets, so `secured` re-validates the whole algebra rather than a top level.
policyColumns : Policy a -> List String
policyColumns policy =
    case policy of
        Policy r ->
            List.concat
                [ predColumns r.read
                , predColumns r.insert
                , predColumns r.update
                , predColumns r.delete
                , r.owners
                , r.immutables
                , List.map maskColumn r.masks
                , List.concatMap (\pair -> predColumns (maskPred pair)) r.masks
                ]


-- The masked column name of a `(column, pred)` mask entry.
maskColumn : ( String, Pred row ) -> String
maskColumn pair =
    case pair of
        ( col, _ ) ->
            col


-- The authorization predicate of a `(column, pred)` mask entry.
maskPred : ( String, Pred row ) -> Pred row
maskPred pair =
    case pair of
        ( _, pred ) ->
            pred


-- The first column in `names` that is not one of the store's columns, or
-- `Nothing` when every named column is a real store column.
firstUnknownPolicyColumn : List Column -> List String -> Maybe String
firstUnknownPolicyColumn columns names =
    case names of
        [] ->
            Nothing

        name :: rest ->
            if hasColumn columns name then
                firstUnknownPolicyColumn columns rest

            else
                Just name


-- ─── Secured operations (the ONLY ops that accept a `Secured`) ──────
--
-- Each `…As` op takes the authenticated `Principal` and a `Secured` store, and
-- ANDs the policy's per-operation predicate into every read/write. The predicate
-- binds the principal's subject as a SQL PARAMETER through `Sql.param` — never
-- string interpolation — so no caller identity can inject SQL. A `Secured` is
-- reachable only through `secured` (which re-validates the policy columns), and
-- the unsecured operations do not accept a `Secured`, so a secured store is
-- unreadable and unwritable without a principal and its policy (deny-by-default).


-- | `policyFragment principal op store policy` — the `WHERE` fragment `policy`'s
-- `op` predicate compiles to for `principal`, validated against `store`'s columns.
-- The predicate is simplified first (minimal SQL), then lowered through the shared
-- audited path. A predicate that names a column the store lacks would already have
-- failed `secured`, so lowering here re-checks columns as defense in depth and
-- falls back to the always-FALSE fragment on the (unreachable) mismatch —
-- fail-closed: a policy that cannot be validated matches no row, never every row.
policyFragment : Auth.Principal -> (Policy a -> Pred a) -> Store a -> Policy a -> SqlFragment
policyFragment principal op store policy =
    case store of
        Store s ->
            case predFragmentIn principal s.table s.currentColumns (simplify (op policy)) of
                Ok fragment ->
                    fragment

                Err _ ->
                    falseFragment


readPred : Policy a -> Pred a
readPred policy =
    case policy of
        Policy r ->
            r.read


-- | `maskedRead principal conn store policy whereFrag` — the shared secured-read
-- core for `allAs` / `getAs`. It builds the explicit column projection from the
-- store's current columns — each column projected as-is, except a policy-masked
-- column projected as `CASE WHEN (<pred>) THEN col ELSE NULL END` — and reads
-- through the NULL-preserving `Db.findWhereMasked`, decoding each row through the
-- store's own codec. A policy with NO masks projects every column verbatim, which
-- is the former `SELECT *` semantics decoded through the same codec (backward
-- compatible). An unauthorized masked cell arrives as SQL `NULL` and the codec's
-- `CNull` arm decodes it to `Nothing` — never `Just ""`.
maskedRead : Auth.Principal -> Db -> Store a -> Policy a -> SqlFragment -> Task Error (List a)
maskedRead principal conn store policy whereFrag =
    case store of
        Store r ->
            case r.codec of
                Codec codecR ->
                    Db.findWhereMasked conn
                        r.table
                        (projectionTerms principal store policy r.currentColumns)
                        whereFrag
                        (codecR.mkDec {})


-- Build the ordered projection `SqlFragment` list for a secured read: each store
-- column becomes a bare `Sql.column` reference, unless the policy masks it — then
-- it becomes an `Sql.maskedColumn` `CASE` term guarded by the mask predicate
-- lowered against the store's columns. The mask predicate reaches SQL only
-- through the ONE audited `predFragmentIn` path; a predicate that fails to lower
-- (an unreachable column mismatch, already refused at `secured`) falls back to the
-- always-FALSE fragment, so the column masks for EVERY row (fail-closed — a mask
-- that cannot be validated hides the value, never reveals it).
projectionTerms : Auth.Principal -> Store a -> Policy a -> List Column -> List SqlFragment
projectionTerms principal store policy columns =
    List.map (\col -> projectionTerm principal store policy (columnName col)) columns


projectionTerm : Auth.Principal -> Store a -> Policy a -> String -> SqlFragment
projectionTerm principal store policy col =
    case maskPredForColumn policy col of
        Nothing ->
            Sql.column col

        Just pred ->
            Sql.maskedColumn (maskPredFragment principal store pred) col


-- The mask predicate for `col` if the policy masks it, else `Nothing`. First
-- mask wins (a column masked twice uses its first predicate; `secured` validates
-- every mask column regardless).
maskPredForColumn : Policy a -> String -> Maybe (Pred a)
maskPredForColumn policy col =
    case policy of
        Policy r ->
            firstMaskPred r.masks col


firstMaskPred : List ( String, Pred a ) -> String -> Maybe (Pred a)
firstMaskPred masks col =
    case masks of
        [] ->
            Nothing

        first :: rest ->
            case first of
                ( name, pred ) ->
                    if name == col then
                        Just pred

                    else
                        firstMaskPred rest col


-- Lower a mask predicate to its guarding `SqlFragment` through the SAME audited
-- path secured WHERE fragments use, validated against the store's own columns.
-- Fail-closed: a predicate that cannot lower falls back to the always-FALSE
-- fragment, so the masked column yields NULL for every row rather than leaking.
maskPredFragment : Auth.Principal -> Store a -> Pred a -> SqlFragment
maskPredFragment principal store pred =
    case store of
        Store s ->
            case predFragmentIn principal s.table s.currentColumns (simplify pred) of
                Ok fragment ->
                    fragment

                Err _ ->
                    falseFragment


updatePred : Policy a -> Pred a
updatePred policy =
    case policy of
        Policy r ->
            r.update


deletePred : Policy a -> Pred a
deletePred policy =
    case policy of
        Policy r ->
            r.delete


-- | `allAs principal db secured` — read every row the policy admits for
-- `principal`, decoded through the store's codec. The policy's owner filter is
-- the WHERE, so the database never returns an out-of-policy row.
allAs : Auth.Principal -> Db -> Secured a -> Task Error (List a)
allAs principal conn secured =
    case secured of
        Secured store policy ->
            case store of
                Store r ->
                    maskedRead principal conn store policy
                        (policyFragment principal readPred store policy)


-- | `getAs principal db secured keyValue` — read the single row whose primary
-- key equals `keyValue` AND which the policy admits for `principal`, or
-- `Nothing`. Keys on the store's validated `pk`; both the key and the subject
-- bind as parameters. A store with no primary key fails closed.
getAs : Auth.Principal -> Db -> Secured a -> SqlValue -> Task Error (Maybe a)
getAs principal conn secured keyValue =
    case secured of
        Secured store policy ->
            case store of
                Store r ->
                    case singleKeyColumn r.pk of
                        Err e ->
                            Task.fail e

                        Ok keyCol ->
                            Task.map List.head
                                (maskedRead principal conn store policy
                                    (Sql.and
                                        (keyEquals keyCol keyValue)
                                        (policyFragment principal readPred store policy)
                                    )
                                )


-- | `insertAs principal db secured row` — insert `row`, forcing every owner
-- column the policy scopes to `principal`'s subject so a caller can never write a
-- row it would not be allowed to read back. The owner value binds as a parameter.
-- The inserted-row count is returned.
insertAs : Auth.Principal -> Db -> Secured a -> a -> Task Error Int
insertAs principal conn secured row =
    case secured of
        Secured store policy ->
            case store of
                Store r ->
                    case DbCodec.codecToBinds r.codec row of
                        Err e ->
                            Task.fail e

                        Ok binds ->
                            Db.insertFields conn
                                r.table
                                (insertFields r.specs
                                    (forceOwnerColumns principal policy binds)
                                )


-- | `updateAs principal db secured row` — update the row whose primary key
-- matches `row`, but only when the policy's update predicate admits it for
-- `principal`; that predicate is AND-ed into the WHERE so a caller cannot update
-- another principal's row. Columns marked `Serial` / `DefaultNow` are omitted from
-- the SET, and so is every column the policy holds immutable: an immutable
-- column's client value is dropped from the SET, so the stored value cannot change
-- after insert (the guarantee `immutable` promises). A store with no primary key,
-- or a record missing its key column, fails closed.
updateAs : Auth.Principal -> Db -> Secured a -> a -> Task Error Int
updateAs principal conn secured row =
    case secured of
        Secured store policy ->
            case store of
                Store r ->
                    case singleKeyColumn r.pk of
                        Err e ->
                            Task.fail e

                        Ok keyCol ->
                            case DbCodec.codecToBinds r.codec row of
                                Err e ->
                                    Task.fail e

                                Ok binds ->
                                    case bindValue keyCol binds of
                                        Nothing ->
                                            Task.fail (missingKeyBindError keyCol)

                                        Just keyValue ->
                                            Db.updateWhere conn
                                                r.table
                                                (updateSetFields r.specs
                                                    keyCol
                                                    (dropImmutableColumns policy binds)
                                                )
                                                (Sql.and
                                                    (keyEquals keyCol keyValue)
                                                    (policyFragment principal updatePred store policy)
                                                )


-- | `deleteAs principal db secured keyValue` — delete the row whose primary key
-- equals `keyValue`, but only when the policy admits it for `principal`; the
-- owner filter is AND-ed into the WHERE. Keys on the validated `pk`; both values
-- bind as parameters. A store with no primary key fails closed.
deleteAs : Auth.Principal -> Db -> Secured a -> SqlValue -> Task Error Int
deleteAs principal conn secured keyValue =
    case secured of
        Secured store policy ->
            case store of
                Store r ->
                    case singleKeyColumn r.pk of
                        Err e ->
                            Task.fail e

                        Ok keyCol ->
                            Db.deleteWhere conn
                                r.table
                                (Sql.and
                                    (keyEquals keyCol keyValue)
                                    (policyFragment principal deletePred store policy)
                                )


-- Drop every column the policy marks immutable from a codec projection, so an
-- update never writes a new value into it — the stored value is fixed at insert.
-- The bind is removed entirely (not set to its old value, which the update path
-- does not have), so the column is absent from the SET and the database keeps its
-- current value. Non-immutable columns leave the binds unchanged.
dropImmutableColumns : Policy a -> List ( String, SqlValue ) -> List ( String, SqlValue )
dropImmutableColumns policy binds =
    case policy of
        Policy r ->
            List.filter (\pair -> Basics.not (bindIsImmutable r.immutables pair)) binds


-- True when the policy's immutable-column set names the column this bind sets.
bindIsImmutable : List String -> ( String, SqlValue ) -> Bool
bindIsImmutable immutables pair =
    case pair of
        ( name, _ ) ->
            List.member name immutables


-- Force every owner column named by the policy to `principal`'s subject in a
-- codec projection, so an insert cannot set an owner other than the caller. A
-- column the policy does not scope to the owner leaves the binds unchanged.
forceOwnerColumns : Auth.Principal -> Policy a -> List ( String, SqlValue ) -> List ( String, SqlValue )
forceOwnerColumns principal policy binds =
    case policy of
        Policy r ->
            List.foldl
                (\col acc -> setBind col (SqlString (Auth.subject principal)) acc)
                binds
                r.owners


-- Set `col`'s value to `value` in a codec projection: replace the existing pair
-- when present, or append it when the column is absent from the projection.
setBind : String -> SqlValue -> List ( String, SqlValue ) -> List ( String, SqlValue )
setBind col value binds =
    if List.any (\pair -> bindNameIs col pair) binds then
        List.map
            (\pair ->
                if bindNameIs col pair then
                    ( col, value )

                else
                    pair
            )
            binds

    else
        binds ++ [ ( col, value ) ]


-- ─── Errors ────────────────────────────────────────────────────────


invalidIdentError : String -> String -> Error
invalidIdentError kind name =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: rejected ", kind, " identifier \"", name, "\" — not a valid SQL identifier" ]
        )


notARecordError : Error
notARecordError =
    Error.invalidInput
        "Ipe.Db.Store: the codec's shape is not a record, so it declares no columns to build a store from"


noPrimaryKeyError : Error
noPrimaryKeyError =
    Error.invalidInput
        "Ipe.Db.Store: this operation requires a single-column primary key; declare one with Store.primaryKey (a composite key cannot be addressed by one key value — read and write a composite-key store through query / updateWhere / deleteWhere conditions over its key columns)"


-- The typed refusal for a primary-key declaration the builders parsed as a
-- fault, naming the builder that expresses the intended key.
primaryKeyFaultError : PrimaryKeyFault -> Error
primaryKeyFaultError fault =
    case fault of
        SecondPrimaryKey ->
            Error.invalidInput
                "Ipe.Db.Store: this store declares more than one primary key, but a table has exactly one — declare it once: Store.primaryKey for one column, Store.compositePrimaryKey2 / compositePrimaryKey3 / compositePrimaryKeyNamed for several columns together"

        CompositeKeyTooShort cols ->
            case cols of
                [ only ] ->
                    Error.invalidInput
                        (String.concat
                            [ "Ipe.Db.Store: a composite primary key needs at least two columns, but only \""
                            , only
                            , "\" was given — declare a one-column key with Store.primaryKey (or Store.primaryKeyNamed \""
                            , only
                            , "\")"
                            ]
                        )

                _ ->
                    Error.invalidInput
                        "Ipe.Db.Store: a composite primary key needs at least two columns, but none were given — list the key columns, or declare a one-column key with Store.primaryKey"

        RenamedKeyColumn name ->
            Error.invalidInput
                (String.concat
                    [ "Ipe.Db.Store: renameColumn \""
                    , name
                    , "\" renames a primary-key column, which is refused — the by-key operations and the key's DDL would then disagree on the key column's name; keep the key column's name and rename only non-key columns"
                    ]
                )


unknownKeyColumnError : String -> Error
unknownKeyColumnError name =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: primary-key column \""
            , name
            , "\" is not a column of this store — name each key column by the store's own column name (the snake_case name Codec.auto derives, e.g. userId → \"user_id\"), or use the accessor forms Store.primaryKey / Store.compositePrimaryKey2 / Store.compositePrimaryKey3, which the compiler checks against the row type"
            ]
        )


duplicateKeyColumnError : String -> List String -> Error
duplicateKeyColumnError name keyCols =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: the composite primary key ("
            , String.join ", " keyCols
            , ") names column \""
            , name
            , "\" more than once — list each key column exactly once"
            ]
        )


compositeKeySerialError : String -> List String -> Error
compositeKeySerialError name keyCols =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: column \""
            , name
            , "\" is marked serial, but the store's primary key is the composite key ("
            , String.join ", " keyCols
            , ") — a DB-assigned serial (AUTOINCREMENT) exists only on a one-column INTEGER primary key; drop Store.serial and supply the key values, or key the table on \""
            , name
            , "\" alone with Store.primaryKey"
            ]
        )


unknownColumnError : String -> Error
unknownColumnError name =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: \"", name, "\" is not a column of this store — a query may only reference the store's own derived columns" ]
        )


nonNullableMaskError : String -> Error
nonNullableMaskError name =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: cannot mask non-nullable column \""
            , name
            , "\" — a masked column yields NULL for an unauthorized row, so it must be nullable (its codec column type must be `CNull _`, i.e. a `Maybe`-typed field). Make the field optional, or drop the mask on this column"
            ]
        )


unconstrainedMutationError : Error
unconstrainedMutationError =
    Error.invalidInput
        "Ipe.Db.Store: refusing an unconstrained updateWhere/deleteWhere — the condition constrains no column (e.g. `and []` matches every row), which would mass-update or mass-delete the whole table; pass a condition that references at least one column"


missingKeyBindError : String -> Error
missingKeyBindError keyCol =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: update needs the primary-key column \"", keyCol, "\" in the record's codec projection, but it is absent" ]
        )


invalidDefaultTextError : String -> Error
invalidDefaultTextError name =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: column \""
            , name
            , "\" has a DEFAULT text value containing a control byte, newline, NUL, or backslash — a schema default is a fixed literal embedded directly in the CREATE TABLE DDL, so it must be printable ASCII/text with no backslash to stay safe under every backend's string-quoting mode"
            ]
        )


serialWithoutPkError : String -> Error
serialWithoutPkError name =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: column \""
            , name
            , "\" is marked serial but has no primary key — SQLite requires AUTOINCREMENT on a PRIMARY KEY column; add Store.primaryKey \""
            , name
            , "\" to the store"
            ]
        )


missingColumnError : String -> Error
missingColumnError name =
    Error.invalidInput
        (String.concat [ "Ipe.Db.Store: row is missing column \"", name, "\"" ])


badColumnError : String -> String -> String -> Error
badColumnError name expected got =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Store: column \"", name, "\" is not a valid ", expected, ": \"", got, "\"" ]
        )


-- | `noopRenameError` — the error returned by `migrations` when a rename op has
-- the same `from` and `to` identifier. A no-op rename would seed a redundant
-- ledger entry whose stable name (`rename_column_T_X_to_X`) is misleading and
-- whose SQL (`ALTER … RENAME COLUMN X TO X`) is a likely mistake.
noopRenameError : Error
noopRenameError =
    Error.invalidInput
        "Ipe.Db.Store: rename op has identical from and to — a no-op rename would seed a redundant ledger entry"
