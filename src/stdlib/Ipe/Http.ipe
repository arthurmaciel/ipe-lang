-- | Ipe.Http — outbound HTTP client (Layer 3 Ipe source, M5b).
--
-- `get` / `post` / `request` are effects (Task Error HttpResponse). The
-- runtime (`ipe_runtime::http_client`) is the PARSE boundary: it validates
-- the URL, enforces the SSRF guard, body cap, timeout floor, and error
-- redaction. These records are transport DTOs carried to that boundary;
-- downstream code MUST NOT re-validate.
--
-- `HttpMethod` is a closed ADT — make-invalid-states-unrepresentable for
-- HTTP verbs. `methodFromString` is the single typed parse boundary for
-- inbound method strings (e.g. parsed from a server request line);
-- `methodToString` recovers the canonical uppercase string for logging or
-- forwarding. Unknown verbs surface as `Nothing` at the parse boundary,
-- never as a silent default.
--
-- `parseQuery` is pure: trims a leading `?`, splits on `&`/`=`,
-- percent-decodes, first-key-wins, returns a `Dict String String` (no
-- duplicate keys — the invariant is proven by the HashMap return type).
--
-- Builders (`defaultRequest` / `with*`) are pure Ipe. `withHeader`
-- PREPENDS the new pair (`(k, v) :: req.headers`) matching the Go
-- reference compiler's Ipe.Http.ipe behaviour — latest-added header
-- is first in the list.
module Ipe.Http exposing
    ( HttpMethod(..)
    , HttpRequest
    , HttpResponse
    , defaultRequest
    , get
    , methodFromString
    , methodToString
    , parseQuery
    , post
    , request
    , withBody
    , withFollowRedirects
    , withHeader
    , withMaxRedirects
    , withMethod
    , withTimeout
    , withUrl
    )


import Ipe.Dict exposing (Dict)
import Ipe.Ffi as Ffi
import Ipe.Maybe exposing (Maybe)


-- ── Types ─────────────────────────────────────────────────────────────────────


-- | Closed set of HTTP methods.  Use constructors directly in client code;
-- use `methodFromString` only at inbound parse boundaries (e.g. routing
-- layers that receive a raw method string from the network).
type HttpMethod
    = Get
    | Post
    | Put
    | Delete
    | Patch
    | Head
    | Options


type alias HttpResponse =
    { status : Int, body : String, headers : Dict String String }


type alias HttpRequest =
    { method : HttpMethod
    , url : String
    , body : String
    , headers : List ( String, String )
    , timeout : Int
    , followRedirects : Bool
    , maxRedirects : Int
    }


-- ── Effect kernels ────────────────────────────────────────────────────────────


get : String -> Task Error HttpResponse
get =
    Ffi.kernel "Http_get"


post : String -> String -> Task Error HttpResponse
post =
    Ffi.kernel "Http_post"


request : HttpRequest -> Task Error HttpResponse
request =
    Ffi.kernel "Http_request"


parseQuery : String -> Dict String String
parseQuery =
    Ffi.kernel "Http_parseQuery"


-- ── HttpMethod helpers ────────────────────────────────────────────────────────


-- | `methodFromString s` — the single typed parse boundary for inbound method
-- strings.  Returns `Just` the matching constructor for the seven standard
-- verbs (case-insensitive); returns `Nothing` for any unrecognised string.
-- Never silently defaults.
methodFromString : String -> Maybe HttpMethod
methodFromString =
    Ffi.kernel "Http_methodFromString"


-- | `methodToString m` — the canonical uppercase string for `m`
-- (e.g. `Get` → `"GET"`).  Use for logging or forwarding; the request
-- runtime converts `HttpMethod` to the reqwest `Method` internally.
methodToString : HttpMethod -> String
methodToString =
    Ffi.kernel "Http_methodToString"


-- ── Pure builders ─────────────────────────────────────────────────────────────


defaultRequest : String -> HttpRequest
defaultRequest url =
    { method = Get
    , url = url
    , body = ""
    , headers = []
    , timeout = 30000
    , followRedirects = True
    , maxRedirects = 10
    }


withMethod : HttpMethod -> HttpRequest -> HttpRequest
withMethod m req =
    { req | method = m }


withTimeout : Int -> HttpRequest -> HttpRequest
withTimeout t req =
    { req | timeout = t }


withBody : String -> HttpRequest -> HttpRequest
withBody b req =
    { req | body = b }

withUrl : String -> HttpRequest -> HttpRequest
withUrl u req =
    { req | url = u }

withFollowRedirects : Bool -> HttpRequest -> HttpRequest
withFollowRedirects f req =
    { req | followRedirects = f }

withMaxRedirects : Int -> HttpRequest -> HttpRequest
withMaxRedirects n req =
    { req | maxRedirects = n }


-- `withHeader k v req` prepends `(k, v)` to `req.headers` — matching the
-- Go reference compiler's Ipe.Http.withHeader semantics (cons-prepend).
-- Latest-added header is first in the list.  HTTP allows duplicate header
-- names and order can matter; the Ipe `request` kernel passes the list to
-- reqwest verbatim, which sends all headers to the server.
withHeader : String -> String -> HttpRequest -> HttpRequest
withHeader k v req =
    { req | headers = ( k, v ) :: req.headers }
