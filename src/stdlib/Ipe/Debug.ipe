-- | Ipe.Debug — the development-only escape hatch (Elm-style `Debug.log`).
--
-- `Debug.log label value` prints `"<label>: <value>"` to stderr as a
-- side effect and returns `value` UNCHANGED, so it can be spliced into
-- any expression without altering its result:
--
--     import Ipe.Debug as Debug
--
--     total =
--         Debug.log "subtotal" subtotal + tax
--
-- This is the ONE deliberate impure escape hatch in the language: it is
-- NOT a `Task`. Reach for it to inspect a value mid-expression while
-- developing, then remove it.
--
-- DEV-ONLY: `ipe release` REJECTS any `Debug.*` use with a clear diagnostic
-- (IPE-L0140) rather than silently stripping or shipping it. Use `ipe build`
-- or `ipe run` during development.
module Ipe.Debug exposing
    ( log
    )


import Ipe.Ffi as Ffi


-- | `log label value` — print `"label: value"` to stderr, return `value`.
-- The value is stringified through the same polymorphic path as
-- `Basics.toString` / `{{expr}}` interpolation, so any value renders.
log : String -> a -> a
log = Ffi.kernel "Debug_log"
