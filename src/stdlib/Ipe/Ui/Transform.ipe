-- | Ipe.Ui.Transform — typed transform and opacity properties for animation keyframes.
--
-- Each builder returns a `Prop` value that the animation renderer lowers to one
-- CSS property:value pair inside a `@keyframes` block. Multiple transform
-- helpers on the same keyframe are merged into a single `transform:` rule
-- (e.g. `translateY(10px) scale(0.95)`); `opacity` emits as a separate property.
--
-- Use these helpers inside `Ui.animate` keyframes only — they produce `Prop`
-- values, not `Attribute msg` values, and have no effect on a plain element.
module Ipe.Ui.Transform exposing
    ( translateX
    , translateY
    , translate
    , scale
    , scaleXY
    , rotate
    , skewX
    , skewY
    , opacity
    , Prop
    , propsToCss
    , propsToCssProps
    )

-- Ipe.Ui.Transform — typed transform / opacity properties for
-- `Ui.animate` keyframes (issue #378).
--
-- Each helper returns a `Prop` value that the animation renderer
-- lowers to one CSS property:value pair inside a `@keyframes`
-- block. Transforms compose by being in the SAME `Prop` list
-- (multiple translate/scale/rotate on one keyframe are joined into
-- one `transform: translateY(10px) scale(0.95)` rule).
--
--     Ui.animate
--         { name = "popIn"
--         , duration = 250
--         , easing = Animation.easeOut
--         , delay = 0
--         , iterations = Animation.once
--         , fillMode = Animation.forwards
--         , respectReducedMotion = True
--         , keyframes =
--             [ ( 0,   [ Transform.opacity (Css.opacityOf 0), Transform.scale 0.9 ] )
--             , ( 100, [ Transform.opacity (Css.opacityOf 1), Transform.scale 1.0 ] )
--             ]
--         }
--
-- Use these helpers ONLY inside `Ui.animate` keyframes — they're
-- not `Attribute msg` values and won't apply to a plain element
-- without an animation wrapper.
import Ipe.Css as Css
import Ipe.List as List
import Ipe.String as String


-- A single keyframe property. Each variant either folds into the
-- `transform: ...` shorthand (`TransformPart`) or emits a
-- standalone CSS property (`OpacityProp`). Future variants might
-- include `FilterPart` etc. — keep grouping by CSS shorthand so
-- the renderer can join them correctly.
type Prop
    = TransformPart String
    | OpacityProp Css.Opacity


-- ─── Transform builders ──────────────────────────────────────────


-- Translate horizontally by `n` pixels.
translateX : Int -> Prop
translateX n =
    TransformPart (Css.translateX (Css.px n))


-- Translate vertically by `n` pixels. Positive = down.
translateY : Int -> Prop
translateY n =
    TransformPart (Css.translateY (Css.px n))


-- Translate both axes.
translate : Int -> Int -> Prop
translate x y =
    TransformPart (Css.translate (Css.px x) (Css.px y))


-- Uniform scale. `1.0` = no change; `0.9` = 90 %.
scale : Float -> Prop
scale s =
    TransformPart (Css.scale s)


-- Per-axis scale.
scaleXY : Float -> Float -> Prop
scaleXY sx sy =
    TransformPart (Css.scaleXY sx sy)


-- Rotate by degrees. Positive = clockwise.
rotate : Float -> Prop
rotate deg =
    TransformPart (Css.rotate (Css.deg deg))


-- Skew horizontally by degrees.
skewX : Float -> Prop
skewX deg =
    TransformPart (Css.skewX (Css.deg deg))


-- Skew vertically by degrees.
skewY : Float -> Prop
skewY deg =
    TransformPart (Css.skewY (Css.deg deg))


-- Opacity in [0, 1]. Emits as a standalone `opacity: <n>` rule;
-- composable with transforms on the same keyframe.
opacity : Css.Opacity -> Prop
opacity a =
    OpacityProp a


-- ─── CSS lowering ────────────────────────────────────────────────


-- Extract the transform function string from a `TransformPart`, if any.
-- Used to collect all transform parts for merging into one declaration.
pickTransformPart : Prop -> Maybe String
pickTransformPart p =
    case p of

        TransformPart part ->
            Just part

        OpacityProp _ ->
            Nothing


-- True when a Prop is NOT a TransformPart — used to collect standalone
-- declarations (opacity and any future non-transform variants).
isStandaloneProp : Prop -> Bool
isStandaloneProp p =
    case p of

        TransformPart _ ->
            False

        OpacityProp _ ->
            True


-- Map a standalone (non-transform) Prop to its `Css.CssProp`. Only call
-- on props for which `isStandaloneProp` is True.
standaloneToCssProp : Prop -> Css.CssProp
standaloneToCssProp p =
    case p of

        TransformPart _ ->
            Css.property "transform" ""

        OpacityProp a ->
            Css.property "opacity" (Css.opacityToString a)


-- Lower a list of Props to a list of `Css.CssProp` values, suitable
-- for passing to `Css.frame`. Multiple `TransformPart`s are merged
-- into ONE `transform` declaration (CSS only honours the last
-- `transform` on an element); each `OpacityProp` becomes its own.
propsToCssProps : List Prop -> List Css.CssProp
propsToCssProps props =
    let
        transformParts = List.filterMap pickTransformPart props
        standaloneProps = List.filter isStandaloneProp props
        transformProp =
            if List.isEmpty transformParts then
                []

            else
                [ Css.property "transform" (String.join " " transformParts) ]
        otherProps =
            List.map standaloneToCssProp standaloneProps
    in
    transformProp ++ otherProps


-- Lower a list of Props to a CSS property block string
-- ("transform:…; opacity:…"). Multiple TransformParts are
-- joined into ONE transform rule (CSS only honours the last
-- transform declaration on an element).
propsToCss : List Prop -> String
propsToCss props =
    String.join "; " (List.map Css.renderProp (propsToCssProps props))
