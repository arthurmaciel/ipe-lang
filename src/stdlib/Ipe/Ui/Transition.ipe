-- | Ipe.Ui.Transition — typed CSS transitions for `Ipe.Ui` (v0.15.57+).
--
-- `Transition.attribute [property "background-color", duration 200,
-- easing easeOut]` builds the CSS transition shorthand from typed
-- `Step`s; pair with `Background.hoverColor` so the browser animates
-- the change between base + `:hover` states.  Auto-wrapped in
-- `@media (prefers-reduced-motion: no-preference)` by default for
-- a11y; opt out via `attributeUnsafe` ONLY when motion is
-- semantically required (loading spinner, progress indicator).
--
-- The shorthand is emitted through `Ui.transition`, whose value is
-- scanned by the native CSS sanitiser at the render sink.
module Ipe.Ui.Transition exposing
    ( Step
    , Easing
    , property
    , duration
    , delay
    , easing
    , linear
    , easeIn
    , easeOut
    , easeInOut
    , cubicBezier
    , buildShorthand
    , easingToCss
    , defaultProperty
    , defaultDuration
    , defaultEasing
    , attribute
    , attributeUnsafe
    )

import Ipe.Basics as Basics
import Ipe.Css as Css
import Ipe.List as List
import Ipe.Math as Math
import Ipe.String as String
import Ipe.Ui as Ui exposing (Attribute)


-- A single step in a transition definition. Combined by
-- `buildShorthand` into the CSS `transition` shorthand value
-- ("property duration easing delay").
type Step
    = StepProperty String
    | StepDuration Int
    | StepDelay Int
    | StepEasing Easing


-- Easing curve. `Linear` / `EaseIn` / `EaseOut` / `EaseInOut` map
-- to the same-named CSS keywords; `CubicBezier x1 y1 x2 y2` is the
-- escape hatch for custom curves (Material's standard curve is
-- `cubicBezier 0.4 0.0 0.2 1.0`, Apple's is `0.25 0.1 0.25 1.0`).
type Easing
    = Linear
    | EaseIn
    | EaseOut
    | EaseInOut
    | CubicBezier Float Float Float Float


-- ─── Step builders ───────────────────────────────────────────────


-- Name the CSS property to transition. Common targets:
-- "background-color", "color", "border-color", "transform",
-- "opacity", "width", "height", "padding", "border-radius".
-- Pass "all" to transition every animatable property.
property : String -> Step
property name =
    StepProperty name


-- Animation duration in milliseconds.
duration : Int -> Step
duration ms =
    StepDuration ms


-- Delay before the transition starts (milliseconds).
delay : Int -> Step
delay ms =
    StepDelay ms


-- Easing curve — see `linear` / `easeIn` / `easeOut` / `easeInOut` /
-- `cubicBezier`.
easing : Easing -> Step
easing e =
    StepEasing e


-- ─── Easing constants ────────────────────────────────────────────


linear : Easing
linear =
    Linear


easeIn : Easing
easeIn =
    EaseIn


easeOut : Easing
easeOut =
    EaseOut


easeInOut : Easing
easeInOut =
    EaseInOut


-- Refine a Float into [0, 1]: NaN maps to 0 (the safe identity-ish default
-- rather than a browser-rejecting NaN), otherwise clamp. Parse-don't-validate:
-- the value that leaves here is already in range, so no downstream site
-- re-checks it.
unitClamp : Float -> Float
unitClamp n =
    if Math.isNaN n then
        0.0

    else
        Basics.clamp 0.0 1.0 n


-- Cubic-bezier control-point curve. The X coordinates MUST lie in [0, 1]
-- (a browser rejects an out-of-range X and silently falls back to default
-- easing), so they are clamped into [0, 1] here — an out-of-range X cannot
-- reach the emitted `cubic-bezier(...)`. Y is unconstrained (overshoot curves
-- legally use Y outside [0, 1]). Named fields remove the four-positional-Float
-- transposition hazard.
cubicBezier : { x1 : Float, y1 : Float, x2 : Float, y2 : Float } -> Easing
cubicBezier c =
    CubicBezier (unitClamp c.x1) c.y1 (unitClamp c.x2) c.y2


-- ─── CSS lowering ────────────────────────────────────────────────


-- Map an Easing to its CSS function string.
easingToCss : Easing -> String
easingToCss e =
    case e of

        Linear ->
            "linear"

        EaseIn ->
            "ease-in"

        EaseOut ->
            "ease-out"

        EaseInOut ->
            "ease-in-out"

        CubicBezier x1 y1 x2 y2 ->
            "cubic-bezier(" ++ String.fromFloat x1 ++ ", "
                ++ String.fromFloat y1
                ++ ", "
                ++ String.fromFloat x2
                ++ ", "
                ++ String.fromFloat y2
                ++ ")"


-- Defaults so the user can write `Ui.transition [property "color"]`
-- and get a sensible 200 ms ease-out. 200 ms is Material's medium-tier
-- default; ease-out matches "things flying in" (slow stop) — the
-- common interaction-feedback case.
defaultProperty : String
defaultProperty =
    "all"


defaultDuration : Int
defaultDuration =
    200


defaultEasing : Easing
defaultEasing =
    EaseOut


-- Helper extractors — walk the step list once per field. Inlining
-- via a 4-tuple accumulator would be tighter but the lowerer's
-- typed-record-tuple support is older + more brittle than per-
-- field folds.
extractProperty : List Step -> String
extractProperty steps =
    case steps of

        [] ->
            defaultProperty

        StepProperty p :: _ ->
            p

        _ :: rest ->
            extractProperty rest


extractDuration : List Step -> Int
extractDuration steps =
    case steps of

        [] ->
            defaultDuration

        StepDuration d :: _ ->
            d

        _ :: rest ->
            extractDuration rest


extractDelay : List Step -> Int
extractDelay steps =
    case steps of

        [] ->
            0

        StepDelay d :: _ ->
            d

        _ :: rest ->
            extractDelay rest


extractEasing : List Step -> Easing
extractEasing steps =
    case steps of

        [] ->
            defaultEasing

        StepEasing e :: _ ->
            e

        _ :: rest ->
            extractEasing rest


-- Lower a list of steps to the CSS `transition` shorthand value:
-- "<prop> <dur>ms <easing> <delay>ms". The delay segment is only
-- emitted when non-zero (common case stays short).
--
-- Routes through `Css.transition` so the `"transition"` property
-- name has a single owner. `Css.prop` scans the value at the Ipê
-- boundary (defence-in-depth; the native render sink re-scans).
-- A rejected value yields "" — fail-closed.
buildShorthand : List Step -> String
buildShorthand steps =
    let
        cssProperty = extractProperty steps
        dur = extractDuration steps
        ease = extractEasing steps
        del = extractDelay steps
        baseVal =
            cssProperty ++ " " ++ String.fromInt dur ++ "ms " ++ easingToCss ease
        shorthandVal =
            if del > 0 then
                baseVal ++ " " ++ String.fromInt del ++ "ms"

            else
                baseVal
        rendered =
            Css.renderProp (Css.transition shorthandVal)
    in
    case String.split ":" rendered of
        _ :: valParts ->
            String.join ":" valParts

        -- Unreachable: `String.split` never yields an empty list. Return the
        -- empty value rather than the unscanned input so the fail-closed
        -- property holds by construction, not just by the sink downstream.
        [] ->
            ""


-- ─── Attribute entry points ──────────────────────────────────────


-- Build a transition Attribute from typed steps. The browser
-- animates property changes (e.g. `Background.color` → `Background.
-- hoverColor`) over the specified duration. The rule is
-- auto-wrapped in `@media (prefers-reduced-motion: no-preference)`
-- by the runtime so users who've opted out of motion get a static
-- UI by default.
--
--     Ui.button
--         [ Background.color blue
--         , Background.hoverColor lightBlue
--         , Transition.attribute
--             [ Transition.property "background-color"
--             , Transition.duration 200
--             , Transition.easing Transition.easeOut
--             ]
--         ]
--         cfg
attribute : List Step -> Attribute msg
attribute steps =
    Ui.transition (buildShorthand steps) True


-- Same as `attribute` but opts OUT of the `prefers-reduced-motion`
-- gate — the transition will fire even for users who've requested
-- reduced motion in their OS. Reserve for transitions that are
-- semantically required (a loading spinner that MUST move or it's
-- a UI bug).
attributeUnsafe : List Step -> Attribute msg
attributeUnsafe steps =
    Ui.transition (buildShorthand steps) False
