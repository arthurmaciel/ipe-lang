-- | Ipe.Ui.ImageSrc — a typed image source (Layer 3 Ipe source).
--
-- An `ImageSrc` is a closed sum: either a remote URL (`ImageSrc.url`) or an
-- inline data URI (`ImageSrc.data`).  The ONLY way to build one is through
-- these two constructors; a raw `String` cannot reach the `Ui.image` boundary.
--
-- `toAttributeValue` produces the string an HTML `src` attribute accepts:
-- for `url` variants it returns the URL string; for `data` variants it
-- assembles `data:<mime>;base64,<base64>`.
--
-- Importing this module forces the `url` runtime feature because `FromUrl`
-- embeds `Ipe.Url.Url`, which renders as `ipe_runtime::url::Url` (gated behind
-- the `url` cargo feature).  The type-driven SSOT
-- (`ir_type_feature_requirement`) closes this automatically — no explicit
-- `uses_url` flag is needed.
module Ipe.Ui.ImageSrc exposing
    ( ImageSrc
    , url
    , relative
    , data
    , toAttributeValue
    )


import Ipe.Error exposing (Error)
import Ipe.Result as Result exposing (Result)
import Ipe.Url as Url exposing (RelativeRef, Url)


-- | The schemes a remote `<img src>` may fetch over: only `http`/`https`. A
-- `Url` legally carries any absolute scheme (`file:`, `javascript:`), so this
-- is the fail-closed narrowing that keeps a non-network scheme out of the
-- media sink. An inline image uses `data` (the structured `data:` path), never
-- a raw `data:` URL smuggled through `url`.
mediaSchemes : List String
mediaSchemes =
    [ "http", "https" ]


-- | An opaque image source: a remote URL, a same-origin relative path, or an
-- inline data URI. The constructors are NOT exported; build via `url`,
-- `relative`, or `data`.
type ImageSrc
    = FromUrl Url
    | FromRelative RelativeRef
    | FromData { mime : String, base64 : String }


-- | `url u` — a remote image from a validated `Ipe.Url.Url`. Fail-closed: the
-- scheme is narrowed to `http`/`https` (a `file:` / `javascript:` / raw `data:`
-- URL is a typed `Err`), so a non-network scheme has no representation at the
-- `<img src>` sink. Returns `Ok` only for a network image URL.
url : Url -> Result Error ImageSrc
url u =
    Result.map FromUrl (Url.checkScheme mediaSchemes u)


-- | `relative raw` — a same-origin relative image path (`/static/logo.png`,
-- `./avatar.jpg`). Fail-closed via the shared `Url.relativeRef` predicate: a
-- protocol-relative (`//host`), scheme-bearing, backslash, or control-char
-- string is a typed `Err`.
relative : String -> Result Error ImageSrc
relative raw =
    Result.map FromRelative (Url.relativeRef raw)


-- | `data { mime, base64 }` — an inline image from base64-encoded bytes.
-- `mime` is the MIME type (e.g. `"image/png"`); `base64` is the
-- base64-encoded payload without the `data:` prefix.
data : { mime : String, base64 : String } -> ImageSrc
data rec =
    FromData rec


-- | `toAttributeValue src` — the string for an HTML `src` attribute.
-- For a `url` variant: the URL string.
-- For a `data` variant: `data:<mime>;base64,<base64>`.
toAttributeValue : ImageSrc -> String
toAttributeValue src =
    case src of
        FromUrl u ->
            Url.toString u

        FromRelative ref ->
            Url.relativeRefToString ref

        FromData rec ->
            "data:" ++ rec.mime ++ ";base64," ++ rec.base64
