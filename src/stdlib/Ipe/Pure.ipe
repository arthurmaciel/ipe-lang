-- | Ipe.Pure — uniform `() -> Task Error a` companion surface
-- for runtime-arity-0 stdlib bindings.
--
-- v0.15.50 — additive mirror module.  Closes Limitation #7 (the
-- inconsistent `()` / bare arity-0 convention) for new code without
-- renaming any existing surface.  Every Pure.* wrapper is a 2-line
-- alias that delegates to the canonical kernel; zero runtime
-- overhead vs the underlying form.
--
-- @
--     import Ipe.Pure as Pure
--
--     -- All consistent — every call site shaped `Pure.foo ()`.
--     uuid    <- Pure.uuidV4 ()
--     now     <- Pure.timeNow ()
--     cwd     <- Pure.systemCwd ()
--     line    <- Pure.ioReadLine ()
--     handle  <- Pure.dbConnect ()
-- @
--
-- Inclusion criteria: a stdlib binding belongs here when (a) it
-- takes no real Sky-level argument that disambiguates the call,
-- and (b) it returns a `Task Error a` (entropy / clock / env /
-- I/O / database connection — the surfaces where the inconsistency
-- bit users most often).  Non-zero-arg helpers like `Random.int`,
-- `Crypto.randomToken`, `System.exit`, `Process.run` are NOT
-- candidates — their argument list carries semantic information.
module Ipe.Pure exposing
    ( uuidV4
    , uuidV7
    , timeNow
    , timeUnixMillis
    , systemArgs
    , systemCwd
    , systemLoadEnv
    , ioReadLine
    , dbConnect
    )

import Ipe.Ffi as Ffi
import Ipe.Error exposing (Error)
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.System as System
import Ipe.Io as Io
import Ipe.Db as Db exposing (Db)


-- ─── UUID generation ───────────────────────────────────────────────


-- | `Pure.uuidV4 ()` — uniform-shape companion for `Uuid.v4`.
-- See `Ipe.Uuid.v4` for semantics.
--
-- Implementation note: the `Uuid_v4` kernel is registered directly at
-- `() -> Task Error String` (entropy is an effect — see the kernel
-- scheme in `sky_types::constrain`, `K::UuidV4 => fun(Unit, task(string))`),
-- so `Pure.uuidV4` is a point-free alias to it, exactly like every other
-- `Ffi.kernel` stdlib binding.  A `uuidV4 _ = uuidV4Kernel` indirection
-- annotated the kernel as a bare `Task Error String`, which mismatches its
-- real `() -> Task Error String` scheme (IPE-T0001).
uuidV4 : () -> Task Error String
uuidV4 =
    Ffi.kernel "Uuid_v4"


-- | `Pure.uuidV7 ()` — uniform-shape companion for `Uuid.v7`.
-- See `Ipe.Uuid.v7` for semantics.
uuidV7 : () -> Task Error String
uuidV7 =
    Ffi.kernel "Uuid_v7"


-- ─── Clock reads ───────────────────────────────────────────────────


-- | `Pure.timeNow ()` — uniform-shape companion for `Time.now ()`.
-- Returns Unix milliseconds since epoch.
timeNow : () -> Task Error Int
timeNow _ =
    Time.now ()


-- | `Pure.timeUnixMillis ()` — uniform-shape companion for
-- `Time.unixMillis ()`.  Identical semantics to `timeNow`.
timeUnixMillis : () -> Task Error Int
timeUnixMillis _ =
    Time.unixMillis ()


-- ─── Process environment ───────────────────────────────────────────


-- | `Pure.systemArgs ()` — uniform-shape companion for
-- `System.args ()`.  Returns the command-line argv tail (program
-- name excluded).
systemArgs : () -> Task Error (List String)
systemArgs _ =
    System.args ()


-- | `Pure.systemCwd ()` — uniform-shape companion for
-- `System.cwd ()`.  Returns the current working directory.
systemCwd : () -> Task Error String
systemCwd _ =
    System.cwd ()


-- | `Pure.systemLoadEnv ()` — uniform-shape companion for
-- `System.loadEnv ()`.  Loads `.env` into the process env table.
systemLoadEnv : () -> Task Error ()
systemLoadEnv _ =
    System.loadEnv ()


-- ─── Standard input ────────────────────────────────────────────────


-- | `Pure.ioReadLine ()` — uniform-shape companion for
-- `Io.readLine ()`.  Reads one line from stdin.
ioReadLine : () -> Task Error String
ioReadLine _ =
    Io.readLine ()


-- ─── Database connection ───────────────────────────────────────────


-- | `Pure.dbConnect ()` — uniform-shape companion for
-- `Db.connect ()`.  Opens the connection described by
-- `ipe.toml`'s `[database]` section.
dbConnect : () -> Task Error Db
dbConnect _ =
    Db.connect ()
