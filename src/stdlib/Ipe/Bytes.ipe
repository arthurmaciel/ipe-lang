-- | Ipe.Bytes — raw byte buffers for binary data.
--
-- `Bytes` is an opaque sequence of bytes, distinct from `String` (which is
-- always valid UTF-8). Use this module when you need to work with arbitrary
-- binary payloads: reading files, decoding network responses, or working with
-- hex / base-64 encodings.
--
-- String ↔ Bytes conversions are always explicit: `fromString` UTF-8-encodes an
-- Ipê `String` into bytes; `toString` UTF-8-decodes bytes back, returning
-- `Just s` on success and `Nothing` when the buffer is not valid UTF-8.
module Ipe.Bytes exposing
    ( Bytes
    , empty
    , length
    , isEmpty
    , fromString
    , toString
    , fromHex
    , toHex
    , fromBase64
    , toBase64
    , append
    , slice
    )

-- `Bytes` is a distinct `Vec<u8>`, not `type alias Bytes = String`: Rust's
-- `String` is constrained to valid UTF-8, so aliasing would reject arbitrary
-- binary payloads.  A distinct primitive lowers to `Vec<u8>`, providing
-- lossless handling of arbitrary binary data.  String ↔ Bytes conversions
-- are always explicit: `fromString` UTF-8-encodes an Ipe `String` into bytes;
-- `toString` UTF-8-decodes bytes, returning `Just s` on success and `Nothing`
-- when the buffer is not valid UTF-8.


-- | The empty byte buffer (zero bytes).
empty : Bytes
empty =
    Ffi.kernel "Bytes_empty"


-- | The number of bytes in the buffer.
length : Bytes -> Int
length =
    Ffi.kernel "Bytes_length"


-- | True when the buffer contains no bytes.
isEmpty : Bytes -> Bool
isEmpty =
    Ffi.kernel "Bytes_isEmpty"


-- | UTF-8-encode a Ipe `String` into a `Bytes` buffer.
--
-- Every Ipe `String` is valid UTF-8, so this conversion is total (never
-- fails).  To go the other way, use `toString`.
fromString : String -> Bytes
fromString =
    Ffi.kernel "Bytes_fromString"


-- | UTF-8-decode a `Bytes` buffer into a Ipe `String`.
--
-- Returns `Just s` when the entire buffer is valid UTF-8, `Nothing`
-- otherwise.  Use `Maybe.withDefault` when you need a fallback string.
toString : Bytes -> Maybe String
toString =
    Ffi.kernel "Bytes_toString"


-- | Decode a hexadecimal string into bytes.
--
-- Accepts both lowercase and uppercase hex digits.  Returns `Nothing` when
-- the input has an odd length or contains any character outside `[0-9a-fA-F]`.
fromHex : String -> Maybe Bytes
fromHex =
    Ffi.kernel "Bytes_fromHex"


-- | Hex-encode a byte buffer (lowercase output, two hex digits per byte).
toHex : Bytes -> String
toHex =
    Ffi.kernel "Bytes_toHex"


-- | Standard (RFC 4648) base-64 decode.
--
-- Returns `Nothing` on invalid padding or non-base-64 characters.
fromBase64 : String -> Maybe Bytes
fromBase64 =
    Ffi.kernel "Bytes_fromBase64"


-- | Standard (RFC 4648) base-64 encode.
toBase64 : Bytes -> String
toBase64 =
    Ffi.kernel "Bytes_toBase64"


-- | Concatenate two byte buffers.
append : Bytes -> Bytes -> Bytes
append =
    Ffi.kernel "Bytes_append"


-- | `slice start end bytes` — return bytes in the half-open interval
-- `[start, end)`, where negative indices count from the end of the buffer
-- (mirrors `String.slice`).
--
-- Out-of-range indices are clamped to the buffer boundaries; `start >= end`
-- (after clamping) returns the empty buffer.
slice : Int -> Int -> Bytes -> Bytes
slice =
    Ffi.kernel "Bytes_slice"
