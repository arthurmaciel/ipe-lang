-- ── Layout builders (pure Ipê sugar over `node` / `taggedNode`). ──

-- | `el attrs child` — a single-child container.
el : List (Attribute msg) -> Element msg -> Element msg
el attrs child =
    node descNone attrs [ child ]


-- | `row attrs children` — a horizontal container (`__row` marker).
row : List (Attribute msg) -> List (Element msg) -> Element msg
row attrs children =
    node descNone (style "__row" "true" :: attrs) children


-- | `column attrs children` — a vertical container (`__col` marker).
column : List (Attribute msg) -> List (Element msg) -> Element msg
column attrs children =
    node descNone (style "__col" "true" :: attrs) children


-- | `wrappedRow attrs children` — a wrapping horizontal container.
wrappedRow : List (Attribute msg) -> List (Element msg) -> Element msg
wrappedRow attrs children =
    node descNone (style "__wrappedrow" "true" :: attrs) children


-- | `grid attrs children` — a CSS-grid container.
grid : List (Attribute msg) -> List (Element msg) -> Element msg
grid attrs children =
    node descNone (style "__grid" "true" :: attrs) children


-- | `paragraph attrs children` — a `<p>` with inline-flow children.
paragraph : List (Attribute msg) -> List (Element msg) -> Element msg
paragraph attrs children =
    taggedNode "p" descParagraph (style "__paragraph" "true" :: attrs) children


-- | `textColumn attrs children` — a `<section>` block of paragraphs.
textColumn : List (Attribute msg) -> List (Element msg) -> Element msg
textColumn attrs children =
    taggedNode "section" descNone (style "__textcolumn" "true" :: attrs) children


-- | `form attrs children` — a `<form>` container.
form : List (Attribute msg) -> List (Element msg) -> Element msg
form attrs children =
    taggedNode "form" descNone attrs children


-- | `input attrs` — an `<input>` void element.
input : List (Attribute msg) -> Element msg
input attrs =
    taggedNode "input" descNone attrs []
