-- | Ipe.Ui — element / attribute / colour / layout surface (Layer 3 Ipe source).
--
-- The layout builders (`el` / `row` / `column` / `wrappedRow` / `grid` /
-- `paragraph` / `textColumn` / `form` / `input`) are ordinary Ipê over two
-- retained native primitives: `node` (a container `Element`) and `taggedNode`
-- (a tag-fixed `Element`). Those two, plus every other member (`layout` /
-- `spacing` / `button` / `link` / `image` / the `on*` events / the
-- security-gated `mediaQuery` / `breakpoint` / `onPseudo` / the `desc*` roles /
-- …), are point-free `Ffi.kernel "Ui_*"` aliases resolving to their unchanged
-- native kernels, so each bespoke emit arm is preserved. The `Ipe.Ui.*`
-- sub-modules (Background / Border / Font / Region / Input / Lazy / Keyed) are
-- separate native qualifiers, untouched here.
module Ipe.Ui exposing
    ( Element, Attribute, Length, Color, Description, HAlign, VAlign, Location, PseudoClass
    , node, taggedNode
    , layout, layoutWith
    , none, text, html, cells, widget
    , el, row, column, wrappedRow, grid
    , paragraph, textColumn, form, input
    , button, link, image
    , spacing, padding, paddingXY, paddingEach, width, height
    , centerX, centerY, alignLeft, alignRight, alignTop, alignBottom
    , pointer, clip, clipX, clipY, scrollbars, scrollbarX, scrollbarY, gridColumns
    , above, below, onLeft, onRight, inFront, behind
    , onClick, onSubmit, onInput, onChange, onFocus, onBlur
    , onMouseOver, onMouseOut, onKeyDown, onKeyUp, onBool, onFile
    , htmlAttribute, mediaQuery, breakpoint
    , aspectRatio, aspectRatioWH, square, widescreen, cinemascope
    , name, style, transition, gridTracks, animate
    , onPseudo, hover, focus, focusVisible, active, disabled
    , mobile, tablet, desktop, darkMode, lightMode, reducedMotion
    , px, fill, fillPortion, content, shrink, minimum, maximum, vh, vw
    , rgb, rgba, white, black, transparent, colorCss
    , describe, descMain, descNavigation, descContentInfo, descComplementary
    , descLivePolite, descLiveAssertive, descHeading, descLabel
    )


import Ipe.Ffi as Ffi


-- ── Retained native primitives ───────────────────────────────────────────────
-- The irreducible `Element` constructors. Every layout builder below is pure
-- Ipê over `node` / `taggedNode`.

-- | `node desc attrs children` — a container `Element` carrying a role
-- `Description`, attributes, and children verbatim.
node : Description -> List (Attribute msg) -> List (Element msg) -> Element msg
node = Ffi.kernel "Ui_node"


-- | `taggedNode tag desc attrs children` — a tag-fixed `Element`.
taggedNode : String -> Description -> List (Attribute msg) -> List (Element msg) -> Element msg
taggedNode = Ffi.kernel "Ui_taggedNode"


-- Module-local `Description` producers backing the sugar below (NOT exposed).

descNone : Description
descNone = Ffi.kernel "Ui_descNone"


descParagraph : Description
descParagraph = Ffi.kernel "Ui_descParagraph"


-- ── Retained native surface ──────────────────────────────────────────────────
-- These stay native and are re-exposed here through the alias mechanism so
-- `Ui.layout` / `Ui.spacing` / `Ui.button` / … keep resolving from user code.

-- | `layout attrs element` — render a root `Element` to `Html`.
layout : List (Attribute msg) -> Element msg -> Html msg
layout = Ffi.kernel "Ui_layout"


-- | `layoutWith { wrapperAttrs, rootAttrs } element` — `layout` with explicit
-- wrapper + root attribute sets.
layoutWith : { wrapperAttrs : List (Attribute msg), rootAttrs : List (Attribute msg) } -> Element msg -> Html msg
layoutWith = Ffi.kernel "Ui_layoutWith"


-- | `none` — the empty `Element`.
none : Element msg
none = Ffi.kernel "Ui_none"


-- | `text s` — a text `Element`.
text : String -> Element msg
text = Ffi.kernel "Ui_text"


-- | `html h` — embed raw `Html` inside a `Ui` view.
html : Html msg -> Element msg
html = Ffi.kernel "Ui_html"


-- | `cells grid` — a raw terminal cell grid (one inner list per row).
cells : List (List Char) -> Element msg
cells = Ffi.kernel "Ui_cells"


-- | `widget handle state onEvent` — place a typed JS custom-element widget.
-- `handle` is a `CustomElement down up` produced by the reserved `customElement`
-- constructor; `state` is the sealed down-state; `onEvent` maps a decoded typed
-- up-event into the app's `msg`. The widget transport is not yet shipped, so a
-- binding whose type mentions `CustomElement` is refused fail-closed at emission
-- (IPE-L0133) until it lands.
widget : CustomElement down up -> down -> (up -> msg) -> Element msg
widget = Ffi.kernel "Ui_widget"


-- | `button attrs { onPress, label }` — a `<button>` with an optional press msg.
button : List (Attribute msg) -> { onPress : Maybe msg, label : Element msg } -> Element msg
button = Ffi.kernel "Ui_button"


-- | `link attrs { url, label }` — an `<a href=…>` link.
link : List (Attribute msg) -> { url : String, label : Element msg } -> Element msg
link = Ffi.kernel "Ui_link"


-- | `image attrs { src, description }` — an `<img src=… alt=…>`.
image : List (Attribute msg) -> { src : String, description : String } -> Element msg
image = Ffi.kernel "Ui_image"


