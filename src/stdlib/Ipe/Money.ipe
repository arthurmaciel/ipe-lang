-- ─── Arithmetic (currency-checked) ────────────────────────────────

-- WARNING: same-currency only. Cross-currency `add` returns the left operand
-- unchanged — the currency mismatch is silently ignored. Convert to a common
-- currency before calling. See `docs/divergences-from-sky.md`.
add : Money -> Money -> Money
add a b =
    if eqCurrency (currency a) (currency b) then
        Money (Dec.add (amount a) (amount b)) (currency a)
    else
        a


-- WARNING: same-currency only. Cross-currency `sub` returns the left operand
-- unchanged — the currency mismatch is silently ignored. Convert to a common
-- currency before calling. See `docs/divergences-from-sky.md`.
sub : Money -> Money -> Money
sub a b =
    if eqCurrency (currency a) (currency b) then
        Money (Dec.sub (amount a) (amount b)) (currency a)
    else
        a


-- | Multiply by a scalar (Decimal). Currency carries through.
mul : Decimal -> Money -> Money
mul k m =
    Money (Dec.mul k (amount m)) (currency m)


neg : Money -> Money
neg m =
    Money (Dec.neg (amount m)) (currency m)


abs : Money -> Money
abs m =
    Money (Dec.abs (amount m)) (currency m)


-- | Allocate a Money value across N parts as evenly as possible,
-- with any remainder distributed 1 cent at a time to the front.
-- The sum of returned parts equals the input exactly.
-- Returns [] when parts <= 0 (no parts to allocate).
--
--   allocate 3 ($100.00)  -> [$33.34, $33.33, $33.33]
--   allocate 3 (-$1.00)   -> [-$0.34, -$0.33, -$0.33]
--   allocate 0 ($100.00)  -> []
allocate : Int -> Money -> List Money
allocate parts m =
    if parts <= 0 then
        []
    else
        let
            c = currency m
            dp = minorUnits c
            totalMinor = Dec.toMinor dp (amount m)
            base = totalMinor // parts
            remainder = totalMinor - base * parts
        in
        List.reverse (allocateHelp c parts base remainder [])


-- Distributes the residue toward zero, one cent per slot, matching the
-- sign of the remainder so negative totals step down and positive totals
-- step up.
allocateHelp : Currency -> Int -> Int -> Int -> List Money -> List Money
allocateHelp c remaining base remainder acc =
    if remaining <= 0 then
        acc
    else
        let
            step = if remainder < 0 then -1 else 1
            piece = if remainder /= 0 then base + step else base
            newRem =
                if remainder > 0 then remainder - 1
                else if remainder < 0 then remainder + 1
                else 0
        in
        allocateHelp c (remaining - 1) base newRem (fromMinor c piece :: acc)


-- WARNING: same-currency only. `sumOf` uses `add` internally; entries whose
-- currency does not match `c` are silently skipped (left-operand fallthrough).
-- See `docs/divergences-from-sky.md`.
sumOf : Currency -> List Money -> Money
sumOf c xs =
    sumOfHelp xs (zero c)


sumOfHelp : List Money -> Money -> Money
sumOfHelp xs acc =
    case xs of
        [] ->
            acc

        first :: rest ->
            sumOfHelp rest (add acc first)


-- ─── Comparison ───────────────────────────────────────────────────

-- WARNING: `compare`/`lt`/`lte`/`gt`/`gte` compare amounts only and ignore
-- currency. Cross-currency comparisons silently treat values as same-currency.
-- See `docs/divergences-from-sky.md`.
compare : Money -> Money -> Int
compare a b =
    Dec.compare (amount a) (amount b)


eq : Money -> Money -> Bool
eq a b =
    eqCurrency (currency a) (currency b) && Dec.eq (amount a) (amount b)


neq : Money -> Money -> Bool
neq a b =
    not (eq a b)


lt : Money -> Money -> Bool
lt a b =
    Dec.lt (amount a) (amount b)


lte : Money -> Money -> Bool
lte a b =
    Dec.lte (amount a) (amount b)


gt : Money -> Money -> Bool
gt a b =
    Dec.gt (amount a) (amount b)


gte : Money -> Money -> Bool
gte a b =
    Dec.gte (amount a) (amount b)


eqCurrency : Currency -> Currency -> Bool
eqCurrency a b =
    currencyCode a == currencyCode b


-- ─── Predicates ───────────────────────────────────────────────────

isZero : Money -> Bool
isZero m =
    Dec.isZero (amount m)


isPositive : Money -> Bool
isPositive m =
    Dec.isPositive (amount m)


isNegative : Money -> Bool
isNegative m =
    Dec.isNegative (amount m)


-- ─── Percent helpers ──────────────────────────────────────────────

percentOf : Decimal -> Money -> Money
percentOf pct m =
    Money (Dec.percentOf pct (amount m)) (currency m)


addPercent : Decimal -> Money -> Money
addPercent pct m =
    Money (Dec.addPercent pct (amount m)) (currency m)


subPercent : Decimal -> Money -> Money
subPercent pct m =
    Money (Dec.subPercent pct (amount m)) (currency m)


-- ─── Formatting + minor extraction ────────────────────────────────

-- | Default symbol-prefixed form: "$12.34", "¥1234" (JPY).
format : Money -> String
format m =
    symbol (currency m) ++ Dec.toStringFixed (minorUnits (currency m)) (amount m)


-- | ISO-code suffix form: "12.34 USD". Preferred for B2B.
formatWithCode : Money -> String
formatWithCode m =
    Dec.toStringFixed (minorUnits (currency m)) (amount m) ++ " " ++ currencyCode (currency m)


-- | Integer-cents representation, for DB persistence.
toMinor : Money -> Int
toMinor m =
    Dec.toMinor (minorUnits (currency m)) (amount m)


-- ─── FX rate registry (stubs — runtime registry not available in pure-Sky port) ─

setRate : Currency -> Currency -> Decimal -> Result Error ()
setRate _ _ _ =
    Err (Error.unexpected "Money.setRate: FX registry not available in this build")


getRate : Currency -> Currency -> Result Error Decimal
getRate _ _ =
    Err (Error.unexpected "Money.getRate: FX registry not available in this build")


hasRate : Currency -> Currency -> Bool
hasRate _ _ =
    False


clearRates : () -> Result Error ()
clearRates _ =
    Err (Error.unexpected "Money.clearRates: FX registry not available in this build")


-- | Convert Money to a target currency using the registered rate.
convert : Currency -> Money -> Result Error Money
convert to m =
    if eqCurrency (currency m) to then
        Ok m
    else
        case getRate (currency m) to of
            Ok rate ->
                Ok (Money (Dec.mul rate (amount m)) to)

            Err e ->
                Err e
