-- ─── Currency property lookups ────────────────────────────────────

-- | Number of decimal places for the currency's minor unit.
-- JPY/KRW/VND/CLP/IDR = 0; BHD/KWD/OMR/JOD = 3; all others = 2.
minorUnits : Currency -> Int
minorUnits c =
    case c of
        JPY -> 0
        KRW -> 0
        VND -> 0
        CLP -> 0
        IDR -> 0
        BHD -> 3
        KWD -> 3
        OMR -> 3
        JOD -> 3
        _ -> 2


