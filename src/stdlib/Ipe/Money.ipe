-- | Ipe.Money — currency-typed Money on `Ipe.Decimal`.
--
-- `Money` carries both magnitude and ISO-4217 currency code in one typed
-- value.  The `Money` / `Currency` ADTs and the pure combinators (arithmetic,
-- comparison, percent, `currencyCode`, `parseCurrency`) live here as Ipê
-- source; the currency-property table, formatter, fair-split `allocate`, and
-- FX rate registry route through the guarded `Money_*` runtime kernels via
-- point-free `Ffi.kernel` aliases (each wrapper converts its `Currency` arg to
-- an ISO 4217 code first, since the kernels take the code as a `String`).
module Ipe.Money exposing
    ( Money(..), Currency(..)
    , fromMinor, fromMajor, fromString
    , zero, zeroOf
    , amount, currency, currencyCode
    , add, sub, mul, allocate, sumOf
    , neg, abs
    , eq, neq, lt, lte, gt, gte, compare
    , isZero, isPositive, isNegative
    , format, formatWithCode, toMinor
    , percentOf, addPercent, subPercent
    , minorUnits, symbol, currencyName
    , knownCurrency, isKnownCode, parseCurrency
    , setRate, getRate, hasRate, clearRates, convert
    )

import Ipe.Ffi as Ffi
import Ipe.List as List
import Ipe.Error as Error exposing (Error)
import Ipe.Decimal as Dec exposing (Decimal)
import Ipe.String as String


-- ─── Currency enum ────────────────────────────────────────────────

type Currency
    = USD | EUR | GBP | JPY | CHF | AUD | CAD | NZD | SEK | NOK
    | DKK | CNY | HKD | SGD | KRW | TWD | INR | THB | MYR | IDR
    | PHP | VND | BRL | MXN | ARS | CLP | ZAR | TRY | RUB | UAH
    | PLN | CZK | HUF | RON | BGN | AED | SAR | QAR | KWD | BHD
    | OMR | JOD | ILS | EGP | NGN | KES | GHS | MAD | TND | DZD
    | PKR | BDT | LKR | NPR
    | BTC | ETH | USDT | USDC
    | CurrencyRaw String


-- ─── The Money ADT ────────────────────────────────────────────────

type Money
    = Money Decimal Currency


-- ─── Construction ─────────────────────────────────────────────────

fromMinor : Currency -> Int -> Money
fromMinor c minor =
    Money (Dec.fromMinor (minorUnits c) minor) c


fromMajor : Currency -> Int -> Money
fromMajor c n =
    Money (Dec.fromInt n) c


fromString : Currency -> String -> Result Error Money
fromString c s =
    case Dec.fromString s of
        Ok d ->
            Ok (Money d c)

        Err e ->
            Err e


zero : Currency -> Money
zero c =
    Money Dec.zero c


zeroOf : Money -> Money
zeroOf m =
    Money Dec.zero (currency m)


-- ─── Accessors ────────────────────────────────────────────────────

amount : Money -> Decimal
amount m =
    case m of
        Money d _ ->
            d


currency : Money -> Currency
currency m =
    case m of
        Money _ c ->
            c


currencyCode : Currency -> String
currencyCode c =
    case c of
        USD -> "USD"
        EUR -> "EUR"
        GBP -> "GBP"
        JPY -> "JPY"
        CHF -> "CHF"
        AUD -> "AUD"
        CAD -> "CAD"
        NZD -> "NZD"
        SEK -> "SEK"
        NOK -> "NOK"
        DKK -> "DKK"
        CNY -> "CNY"
        HKD -> "HKD"
        SGD -> "SGD"
        KRW -> "KRW"
        TWD -> "TWD"
        INR -> "INR"
        THB -> "THB"
        MYR -> "MYR"
        IDR -> "IDR"
        PHP -> "PHP"
        VND -> "VND"
        BRL -> "BRL"
        MXN -> "MXN"
        ARS -> "ARS"
        CLP -> "CLP"
        ZAR -> "ZAR"
        TRY -> "TRY"
        RUB -> "RUB"
        UAH -> "UAH"
        PLN -> "PLN"
        CZK -> "CZK"
        HUF -> "HUF"
        RON -> "RON"
        BGN -> "BGN"
        AED -> "AED"
        SAR -> "SAR"
        QAR -> "QAR"
        KWD -> "KWD"
        BHD -> "BHD"
        OMR -> "OMR"
        JOD -> "JOD"
        ILS -> "ILS"
        EGP -> "EGP"
        NGN -> "NGN"
        KES -> "KES"
        GHS -> "GHS"
        MAD -> "MAD"
        TND -> "TND"
        DZD -> "DZD"
        PKR -> "PKR"
        BDT -> "BDT"
        LKR -> "LKR"
        NPR -> "NPR"
        BTC -> "BTC"
        ETH -> "ETH"
        USDT -> "USDT"
        USDC -> "USDC"
        CurrencyRaw s -> s


-- ─── Currency property lookups (kernel-backed) ────────────────────
--
-- The runtime `money.rs` table is the single source of truth for minor
-- units / symbol / name (JPY=0dp, USD=2dp, BHD=3dp, BTC=8dp; unknown → 2dp,
-- code-as-symbol). Each wrapper converts its `Currency` to the ISO 4217 code
-- before the `String`-taking kernel.

minorUnitsForCode : String -> Int
minorUnitsForCode = Ffi.kernel "Money_minorUnits"


symbolForCode : String -> String
symbolForCode = Ffi.kernel "Money_symbol"


nameForCode : String -> String
nameForCode = Ffi.kernel "Money_currencyName"


-- | Number of decimal places for the currency's minor unit.
minorUnits : Currency -> Int
minorUnits c =
    minorUnitsForCode (currencyCode c)


-- | Common currency symbol.
symbol : Currency -> String
symbol c =
    symbolForCode (currencyCode c)


-- | Human-readable currency name.
currencyName : Currency -> String
currencyName c =
    nameForCode (currencyCode c)


-- | True for every named Currency variant (USD, JPY, BTC, …).
-- False ONLY for `CurrencyRaw _`.
knownCurrency : Currency -> Bool
knownCurrency c =
    case c of
        CurrencyRaw _ ->
            False

        _ ->
            True


isKnownCurrencyForCode : String -> Bool
isKnownCurrencyForCode = Ffi.kernel "Money_isKnownCurrency"


-- | Check whether an ISO 4217 code string is a recognised currency, via the
-- runtime currency table (the single source of truth for known codes).
isKnownCode : String -> Bool
isKnownCode code =
    isKnownCurrencyForCode code


-- | Parse an ISO 4217 currency code string into a `Currency`.
-- Returns `Nothing` for any unrecognised code — the caller must handle
-- the absent case explicitly. Use `CurrencyRaw` directly when you need
-- a passthrough for codes outside the known set.
parseCurrency : String -> Maybe Currency
parseCurrency code =
    case String.toUpper (String.trim code) of
        "USD" -> Just USD
        "EUR" -> Just EUR
        "GBP" -> Just GBP
        "JPY" -> Just JPY
        "CHF" -> Just CHF
        "AUD" -> Just AUD
        "CAD" -> Just CAD
        "NZD" -> Just NZD
        "SEK" -> Just SEK
        "NOK" -> Just NOK
        "DKK" -> Just DKK
        "CNY" -> Just CNY
        "HKD" -> Just HKD
        "SGD" -> Just SGD
        "KRW" -> Just KRW
        "TWD" -> Just TWD
        "INR" -> Just INR
        "THB" -> Just THB
        "MYR" -> Just MYR
        "IDR" -> Just IDR
        "PHP" -> Just PHP
        "VND" -> Just VND
        "BRL" -> Just BRL
        "MXN" -> Just MXN
        "ARS" -> Just ARS
        "CLP" -> Just CLP
        "ZAR" -> Just ZAR
        "TRY" -> Just TRY
        "RUB" -> Just RUB
        "UAH" -> Just UAH
        "PLN" -> Just PLN
        "CZK" -> Just CZK
        "HUF" -> Just HUF
        "RON" -> Just RON
        "BGN" -> Just BGN
        "AED" -> Just AED
        "SAR" -> Just SAR
        "QAR" -> Just QAR
        "KWD" -> Just KWD
        "BHD" -> Just BHD
        "OMR" -> Just OMR
        "JOD" -> Just JOD
        "ILS" -> Just ILS
        "EGP" -> Just EGP
        "NGN" -> Just NGN
        "KES" -> Just KES
        "GHS" -> Just GHS
        "MAD" -> Just MAD
        "TND" -> Just TND
        "DZD" -> Just DZD
        "PKR" -> Just PKR
        "BDT" -> Just BDT
        "LKR" -> Just LKR
        "NPR" -> Just NPR
        "BTC" -> Just BTC
        "ETH" -> Just ETH
        "USDT" -> Just USDT
        "USDC" -> Just USDC
        _ -> Nothing


-- ─── Arithmetic (currency-checked) ────────────────────────────────

-- | Add two Money values. Returns `Err` when the currencies differ — a
-- mismatch is a typed error, not a silent wrong value. Convert both to a
-- common currency first (via `Money.convert`) if needed.
add : Money -> Money -> Result Error Money
add a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Money (Dec.add (amount a) (amount b)) (currency a))
    else
        Err (Error.unexpected ("Money.add: currency mismatch: " ++ currencyCode (currency a) ++ " vs " ++ currencyCode (currency b)))


-- | Subtract two Money values. Returns `Err` when the currencies differ — a
-- mismatch is a typed error, not a silent wrong value. Convert both to a
-- common currency first (via `Money.convert`) if needed.
sub : Money -> Money -> Result Error Money
sub a b =
    if eqCurrency (currency a) (currency b) then
        Ok (Money (Dec.sub (amount a) (amount b)) (currency a))
    else
        Err (Error.unexpected ("Money.sub: currency mismatch: " ++ currencyCode (currency a) ++ " vs " ++ currencyCode (currency b)))


-- | Multiply by a scalar (Decimal). Currency carries through.
mul : Decimal -> Money -> Money
mul k m =
    Money (Dec.mul k (amount m)) (currency m)


neg : Money -> Money
neg m =
    Money (Dec.neg (amount m)) (currency m)


abs : Money -> Money
abs m =
    Money (Dec.abs (amount m)) (currency m)


allocateDecimals : Int -> Int -> Decimal -> List Decimal
allocateDecimals = Ffi.kernel "Money_allocate"


-- | Allocate a Money value across N parts as evenly as possible, with any
-- residue distributed toward zero (positive totals step up, negative totals
-- step down) so the returned parts sum to the input exactly.
--
-- Returns [] when parts <= 0, and (via the kernel's guard) when parts exceeds
-- 100k or the amount overflows — the cap prevents a caller-controlled `parts`
-- from exhausting memory / the call stack.
--
--   allocate 3 ($100.00)  -> [$33.34, $33.33, $33.33]
--   allocate 3 (-$1.00)   -> [-$0.34, -$0.33, -$0.33]
--   allocate 0 ($100.00)  -> []
allocate : Int -> Money -> List Money
allocate parts m =
    let
        c = currency m
        decimals = allocateDecimals (minorUnits c) parts (amount m)
    in
    List.map (\d -> Money d c) decimals


-- | Sum a list of Money values for a given currency. Returns `Err` if any
-- element has a different currency — a mismatch is a typed error. Convert
-- all elements to the target currency first (via `Money.convert`) if needed.
sumOf : Currency -> List Money -> Result Error Money
sumOf c xs =
    sumOfHelp xs (Ok (zero c))


sumOfHelp : List Money -> Result Error Money -> Result Error Money
sumOfHelp xs acc =
    case xs of
        [] ->
            acc

        first :: rest ->
            case acc of
                Err e ->
                    Err e

                Ok m ->
                    sumOfHelp rest (add m first)


-- ─── Comparison ───────────────────────────────────────────────────

-- WARNING: `compare`/`lt`/`lte`/`gt`/`gte` compare amounts only and ignore
-- currency. Cross-currency comparisons silently treat values as same-currency.
-- See `docs/divergences-from-sky.md`.
compare : Money -> Money -> Int
compare a b =
    Dec.compare (amount a) (amount b)


eq : Money -> Money -> Bool
eq a b =
    eqCurrency (currency a) (currency b) && Dec.eq (amount a) (amount b)


neq : Money -> Money -> Bool
neq a b =
    not (eq a b)


lt : Money -> Money -> Bool
lt a b =
    Dec.lt (amount a) (amount b)


lte : Money -> Money -> Bool
lte a b =
    Dec.lte (amount a) (amount b)


gt : Money -> Money -> Bool
gt a b =
    Dec.gt (amount a) (amount b)


gte : Money -> Money -> Bool
gte a b =
    Dec.gte (amount a) (amount b)


eqCurrency : Currency -> Currency -> Bool
eqCurrency a b =
    currencyCode a == currencyCode b


-- ─── Predicates ───────────────────────────────────────────────────

isZero : Money -> Bool
isZero m =
    Dec.isZero (amount m)


isPositive : Money -> Bool
isPositive m =
    Dec.isPositive (amount m)


isNegative : Money -> Bool
isNegative m =
    Dec.isNegative (amount m)


-- ─── Percent helpers ──────────────────────────────────────────────

percentOf : Decimal -> Money -> Money
percentOf pct m =
    Money (Dec.percentOf pct (amount m)) (currency m)


addPercent : Decimal -> Money -> Money
addPercent pct m =
    Money (Dec.addPercent pct (amount m)) (currency m)


subPercent : Decimal -> Money -> Money
subPercent pct m =
    Money (Dec.subPercent pct (amount m)) (currency m)


-- ─── Formatting + minor extraction ────────────────────────────────

formatForCode : String -> Decimal -> String
formatForCode = Ffi.kernel "Money_format"


formatWithCodeForCode : String -> Decimal -> String
formatWithCodeForCode = Ffi.kernel "Money_formatWithCode"


-- | Default symbol-prefixed form: "$12.34", "¥1234" (JPY). The amount is
-- rounded half-away-from-zero to the currency's minor units (so "$2.545"
-- renders "$2.55", not the truncated "$2.54").
format : Money -> String
format m =
    formatForCode (currencyCode (currency m)) (amount m)


-- | ISO-code suffix form: "12.34 USD". Preferred for B2B. Same
-- half-away-from-zero rounding as `format`.
formatWithCode : Money -> String
formatWithCode m =
    formatWithCodeForCode (currencyCode (currency m)) (amount m)


-- | Integer-cents representation, for DB persistence.
toMinor : Money -> Int
toMinor m =
    Dec.toMinor (minorUnits (currency m)) (amount m)


-- ─── FX rate registry (kernel-backed, process-global) ─────────────
--
-- The registry is a process-local mutex-guarded table (positive-only rates,
-- auto-registered inverse, bounded to prevent unbounded growth). Multi-
-- instance deployments need a shared source for consistency.

setRateForCodes : String -> String -> Decimal -> Result Error ()
setRateForCodes = Ffi.kernel "Money_setRate"


getRateForCodes : String -> String -> Result Error Decimal
getRateForCodes = Ffi.kernel "Money_getRate"


hasRateForCodes : String -> String -> Bool
hasRateForCodes = Ffi.kernel "Money_hasRate"


-- | Register an FX rate. Rejects a non-positive rate; auto-registers the
-- inverse so consumers need not set both directions.
setRate : Currency -> Currency -> Decimal -> Result Error ()
setRate from to rate =
    setRateForCodes (currencyCode from) (currencyCode to) rate


-- | Look up a registered rate (identity for from == to; missing → Err).
getRate : Currency -> Currency -> Result Error Decimal
getRate from to =
    getRateForCodes (currencyCode from) (currencyCode to)


hasRate : Currency -> Currency -> Bool
hasRate from to =
    hasRateForCodes (currencyCode from) (currencyCode to)


-- | Drop every registered rate (test / admin).
clearRates : () -> Result Error ()
clearRates = Ffi.kernel "Money_clearRates"


-- | Convert Money to a target currency using the registered rate.
convert : Currency -> Money -> Result Error Money
convert to m =
    if eqCurrency (currency m) to then
        Ok m
    else
        case getRate (currency m) to of
            Ok rate ->
                Ok (Money (Dec.mul rate (amount m)) to)

            Err e ->
                Err e
