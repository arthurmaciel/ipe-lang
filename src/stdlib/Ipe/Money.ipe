-- | True for every named Currency variant (USD, JPY, BTC, …).
-- False ONLY for `CurrencyRaw _`.
knownCurrency : Currency -> Bool
knownCurrency c =
    case c of
        CurrencyRaw _ ->
            False

        _ ->
            True


-- | Check whether an ISO 4217 code string maps to a named Currency variant.
isKnownCode : String -> Bool
isKnownCode code =
    knownCurrency (parseCurrency code)


parseCurrency : String -> Currency
parseCurrency code =
    case String.toUpper (String.trim code) of
        "USD" -> USD
        "EUR" -> EUR
        "GBP" -> GBP
        "JPY" -> JPY
        "CHF" -> CHF
        "AUD" -> AUD
        "CAD" -> CAD
        "NZD" -> NZD
        "SEK" -> SEK
        "NOK" -> NOK
