-- | Ipe.List — list combinators.
--
-- The definitions below are the readable reference for each member; the
-- executable implementations are the native kernels resolved by the `List`
-- qualifier (`src/runtime/rust/src/list.rs`), so this source is parsed but
-- never itself compiled. Keeping the bodies here documents the exact
-- Elm-matching semantics next to the surface a user imports.
module Ipe.List exposing
    ( isEmpty
    , length
    , head
    , tail
    , cons
    , reverse
    , take
    , drop
    , append
    , concat
    , member
    , range
    , zip
    , map
    , filter
    , any
    , all
    , find
    , foldl
    , foldr
    , concatMap
    , indexedMap
    , filterMap
    , sortBy
    , sortWith
    , sum
    , maximum
    , minimum
    , unique
    )


-- | `map fn list` — apply fn to each element.
--
-- `mapHelp` accumulates `fn x :: acc` (reversed) tail-recursively,
-- then `reverseHelp` flips the result.  Both helpers are
-- tail-recursive and auto-TCO'd to loops, running in O(1) stack.
map fn list =
    mapHelp fn list []


mapHelp fn list acc =
    case list of

        [] ->
            reverseHelp acc []

        x :: rest ->
            mapHelp fn rest (fn x :: acc)


-- | `filter pred list` — keep only elements satisfying pred.
--
-- `filterHelp` accumulates `x :: acc` (reversed) for elements
-- satisfying pred, then `reverseHelp` flips the result.  Both helpers
-- are tail-recursive and auto-TCO'd to loops, running in O(1) stack.
filter pred list =
    filterHelp pred list []


filterHelp pred list acc =
    case list of

        [] ->
            reverseHelp acc []

        x :: rest ->
            filterHelp
                pred
                rest
                (if pred x then
                    x :: acc

                else
                    acc)


any pred list =
    case list of

        [] ->
            False

        x :: rest ->
            if pred x then
                True

            else
                any pred rest


all pred list =
    case list of

        [] ->
            True

        x :: rest ->
            if pred x then
                all pred rest

            else
                False


find pred list =
    case list of

        [] ->
            Nothing

        x :: rest ->
            if pred x then
                Just x

            else
                find pred rest


foldl fn acc list =
    case list of

        [] ->
            acc

        x :: rest ->
            foldl fn (fn x acc) rest


-- The legacy `foldr fn x (foldr fn acc rest)` shape recursed in
-- non-tail position (O(N) call depth).  The rewrite delegates to the
-- already-tail-recursive `foldl` over the pre-reversed list — so the
-- CPS helper is tail-recursive and runs in O(1) stack, auto-TCO'd to
-- a loop.  Note: this is a DELEGATING binding — the public `foldr`
-- itself contains no loop because the loop lives in `foldl`.  The
-- `\x a -> fn x a` lambda is structurally identical to `fn` but pinned
-- at the application site so the typed lowerer sees a fresh callback
-- shape per instantiation.
foldr fn acc list =
    foldl (\x a -> fn x a) acc (reverseHelp list [])


-- | `concatMap fn list` — map each element to a list and flatten.
--
-- The legacy `append (fn x) (concatMap fn rest)` shape recursed in
-- non-tail position (O(N) call depth).  `concatMapHelp fn list acc`
-- walks the input tail-recursively, prepending each `fn x` chunk in
-- REVERSE order onto `acc` via `reverseHelp (fn x) acc`, then the
-- outer `reverseHelp acc []` flips the final accumulator once at
-- the base for the left-to-right output.  The helper is tail-recursive
-- and auto-TCO'd to a loop, so it runs in O(1) stack.
--
-- The natural delegation `concatMap fn list = concat (map fn list)`
-- triggers HM cross-module over-unification on the polymorphic
-- `map` instances, so we use the direct accumulator pattern instead.
concatMap fn list =
    reverseHelp (concatMapHelp fn list []) []


-- | `concatMapHelp fn list acc` — tail-recursive worker for
-- `concatMap`.  No explicit signature: the explicit
-- `(a -> List b) -> List a -> List b -> List b` shape
-- over-constrains HM cross-module unification on polymorphic
-- call sites such as `List.concatMap (lineOne cfg xR yR) seriesList`.
-- The inferred shape (HM walking the body) is sound and lets
-- polymorphic call sites unify cleanly.  Tail-recursive and
-- auto-TCO'd to a loop, so O(1) stack.
concatMapHelp fn list acc =
    case list of

        [] ->
            acc

        x :: rest ->
            concatMapHelp fn rest (reverseHelp (fn x) acc)


-- | `indexedMap fn list` — apply `fn` to each (index, element) pair.
--
-- The legacy `fn i x :: indexedMapHelp fn (i + 1) rest` shape recursed
-- in non-tail position (the cons happens AFTER the recursive call
-- returns), giving O(N) call depth.  The rewrite delegates to
-- `indexedMapHelp fn i list acc` which conses `fn i x :: acc` onto the
-- accumulator in REVERSE order, then `reverseHelp acc []` flips it once
-- at the base for the final left-to-right output.  `indexedMapHelp` is
-- tail-recursive and auto-TCO'd to a loop, so it runs in O(1) stack.
indexedMap fn list =
    indexedMapHelp fn 0 list []


-- | `indexedMapHelp fn i list acc` — tail-recursive worker for
-- `indexedMap`. Conses `fn i x :: acc` for each element in reverse
-- order then `reverseHelp` flips the accumulator once at the base
-- for the final left-to-right output. The EXPLICIT signature is
-- load-bearing — without it the HM solver could infer `acc : List any`
-- and the typed-lowerer would fall back to `rt.AsList[any]`, defeating
-- both the Coerce-retreat AND the constant-stack contract.
indexedMapHelp : (Int -> a -> b) -> Int -> List a -> List b -> List b
indexedMapHelp fn i list acc =
    case list of

        [] ->
            reverseHelp acc []

        x :: rest ->
            indexedMapHelp fn (i + 1) rest (fn i x :: acc)


isEmpty list =
    case list of

        [] ->
            True

        _ ->
            False


-- | `length list` — number of elements in the list.
--
-- The legacy `1 + length rest` shape recursed in non-tail position
-- (the `1 +` runs AFTER the recursive call returns), giving O(N) call
-- depth.  `lengthHelp` carries the running count in tail position;
-- the recursion is tail-recursive and auto-TCO'd to a loop, running
-- in O(1) stack.
length list =
    lengthHelp list 0


lengthHelp : List a -> Int -> Int
lengthHelp list n =
    case list of

        [] ->
            n

        _ :: rest ->
            lengthHelp rest (n + 1)


head list =
    case list of

        [] ->
            Nothing

        x :: _ ->
            Just x


tail list =
    case list of

        [] ->
            Nothing

        _ :: rest ->
            Just rest


cons x list =
    x :: list


reverse list =
    reverseHelp list []


reverseHelp : List a -> List a -> List a
reverseHelp list acc =
    case list of

        [] ->
            acc

        x :: rest ->
            reverseHelp rest (x :: acc)


-- | `take n list` — first n elements of `list` (or fewer when `list`
-- is shorter than n).
--
-- `takeHelp n list acc` walks the input tail-recursively, prepending
-- each kept element onto `acc` (reverse order) until either n drops
-- to zero or the input is exhausted; both bases then reverse `acc`
-- via `reverseHelp` for the final left-to-right output.  The helper
-- is tail-recursive and auto-TCO'd to a loop, running in O(1) stack
-- (the legacy `x :: take (n - 1) rest` shape recursed in non-tail
-- position).
--
-- Edge cases: `take 0` and `take <negative>` return `[]` via the
-- `n <= 0` base; `take n []` returns `[]` via the empty-list base.
take n list =
    takeHelp n list []


takeHelp n list acc =
    if n <= 0 then
        reverseHelp acc []

    else
        case list of

            [] ->
                reverseHelp acc []

            x :: rest ->
                takeHelp (n - 1) rest (x :: acc)


drop n list =
    if n <= 0 then
        list

    else
        case list of

            [] ->
                []

            _ :: rest ->
                drop (n - 1) rest


-- | `append xs ys` — concatenate two lists.
--
-- The legacy `x :: append rest ys` shape recursed in non-tail position
-- (the cons happens after the recursive call returns), giving O(N) call
-- depth.  The rewrite first reverses `xs` onto an empty accumulator via
-- `reverseHelp` (already tail-recursive), then `appendHelp` walks the
-- reversed prefix cons'ing each element onto `ys`.  Both phases are
-- tail-recursive and auto-TCO'd to loops, running in O(1) stack.
--
-- Output order is preserved: `reverseHelp [a, b, c] []` gives
-- `[c, b, a]`, then cons'ing those onto `ys = [d, e]`
-- in turn yields `[a, b, c, d, e]` — the head ends up at the
-- front of the result.
append xs ys =
    appendHelp (reverseHelp xs []) ys


-- | `appendHelp revXs ys` — cons each element of `revXs` onto
-- `ys`.  Tail-recursive, auto-TCO'd to a loop.  Private helper for
-- `append`.
--
-- INVARIANT: `revXs` is the REVERSED prefix; cons'ing each
-- head onto `ys` in turn reconstructs the original
-- left-to-right order.
appendHelp revXs ys =
    case revXs of

        [] ->
            ys

        x :: rest ->
            appendHelp rest (x :: ys)


-- | `concat lists` — flatten a list of lists.
--
-- `concatHelp lists acc` walks the outer list tail-recursively,
-- using `appendReverseOnto xs acc` to cons each inner list's
-- elements onto `acc` in REVERSE order.  When the outer list is
-- exhausted, `reverseHelp acc []` flips the accumulator once for
-- the final left-to-right result.  Both `concatHelp` and
-- `appendReverseOnto` are tail-recursive and auto-TCO'd to loops,
-- running in O(1) stack (the legacy `append xs (concat rest)` shape
-- recursed in non-tail position).
--
-- NOTE: `concatHelp` uses ONLY the private `appendReverseOnto`,
-- NOT the public `append` — so `concat` is fully independent of
-- `append`'s implementation.
concat lists =
    concatHelp lists []


concatHelp lists acc =
    case lists of

        [] ->
            reverseHelp acc []

        xs :: rest ->
            concatHelp rest (appendReverseOnto xs acc)


-- | `appendReverseOnto xs acc` — cons each element of `xs` onto
-- `acc` in reverse order.  Tail-recursive, auto-TCO'd to a loop.
-- Private helper for `concat`.
appendReverseOnto xs acc =
    case xs of

        [] ->
            acc

        x :: rest ->
            appendReverseOnto rest (x :: acc)


member x list =
    case list of

        [] ->
            False

        y :: rest ->
            if x == y then
                True

            else
                member x rest


-- | `range lo hi` — produce `[lo, lo + 1, ..., hi]` (inclusive).
--
-- The legacy `lo :: range (lo + 1) hi` shape recursed in non-tail
-- position (the cons happens AFTER the recursive call returns), giving
-- O(N) call depth.  The rewrite delegates to `rangeHelp lo hi acc`
-- which conses each value onto `acc` in REVERSE order (largest first),
-- then `reverseHelp acc []` flips the accumulator once at the base for
-- the final ascending left-to-right output.  `rangeHelp` is
-- tail-recursive and auto-TCO'd to a loop, running in O(1) stack.
range lo hi =
    rangeHelp lo hi []


-- | `rangeHelp lo hi acc` — tail-recursive worker for `range`.
-- Cons each value `lo..hi` onto `acc` in reverse order, then
-- `reverseHelp` flips the accumulator once at the base for the
-- final left-to-right output.  Private helper for `range`.
rangeHelp : Int -> Int -> List Int -> List Int
rangeHelp lo hi acc =
    if lo > hi then
        reverseHelp acc []

    else
        rangeHelp (lo + 1) hi (lo :: acc)


-- | `zip xs ys` — pair-wise zip of two lists.  Truncates to the
-- shorter list's length.
--
-- The legacy `( x, y ) :: zip xRest yRest` shape recursed in
-- non-tail position (the cons happens AFTER the recursive call
-- returns), giving O(N) call depth.  The rewrite delegates to
-- `zipHelp xs ys acc` which conses each `( x, y )` pair onto `acc`
-- in REVERSE order, then `reverseHelp acc []` flips the accumulator
-- once at the base for the final left-to-right output.  `zipHelp`
-- is tail-recursive and auto-TCO'd to a loop, running in O(1) stack.
--
-- The EXPLICIT signature on `zipHelp` is load-bearing: the
-- tuple-typed accumulator (`List (a, b)`) would otherwise be
-- inferred as `List any` by the HM solver — without the annotation
-- the typed-lowerer falls back to `rt.AsList[any]` and the cons
-- payload re-narrows at runtime, defeating the O(1)-stack contract.
zip xs ys =
    zipHelp xs ys []


zipHelp : List a -> List b -> List ( a, b ) -> List ( a, b )
zipHelp xs ys acc =
    case xs of

        [] ->
            reverseHelp acc []

        x :: xRest ->
            case ys of

                [] ->
                    reverseHelp acc []

                y :: yRest ->
                    zipHelp xRest yRest (( x, y ) :: acc)


-- | `filterMap fn list` — apply `fn : a -> Maybe b` to each element and keep
-- only the `Just` payloads, in order.  Combines `map` and `filter` in one pass.
filterMap fn list =
    foldr
        (\x acc ->
            case fn x of

                Just y ->
                    y :: acc

                Nothing ->
                    acc)
        []
        list


-- | `sortWith cmp list` — stable sort by a user comparator `cmp : a -> a -> Order`
-- returning `LT` / `EQ` / `GT`.  Elements that compare `EQ` keep their input
-- order.  Reference body: insertion sort, inserting AFTER every element the new
-- one is not `LT` than, which preserves the input order of equal elements.
sortWith cmp list =
    foldr (insertWith cmp) [] list


insertWith cmp x sorted =
    case sorted of

        [] ->
            [ x ]

        y :: rest ->
            case cmp x y of

                GT ->
                    y :: insertWith cmp x rest

                _ ->
                    x :: y :: rest


-- | `sortBy keyFn list` — stable ascending sort by the `keyFn elem` projection.
-- Equal keys keep their input order; `keyFn` is applied once per element.
sortBy keyFn list =
    sortWith (\a b -> compare (keyFn a) (keyFn b)) list


-- | `sum list` — the additive fold; `sum [] == 0`.
sum list =
    foldl (\x acc -> x + acc) 0 list


-- | `maximum list` — the largest element, or `Nothing` on the empty list.
maximum list =
    case list of

        [] ->
            Nothing

        x :: rest ->
            foldl
                (\y acc ->
                    if y > acc then
                        y

                    else
                        acc)
                x
                rest
                |> Just


-- | `minimum list` — the smallest element, or `Nothing` on the empty list.
minimum list =
    case list of

        [] ->
            Nothing

        x :: rest ->
            foldl
                (\y acc ->
                    if y < acc then
                        y

                    else
                        acc)
                x
                rest
                |> Just


-- | `unique list` — the elements with duplicates removed, keeping the FIRST
-- occurrence of each and preserving that first-seen order.  Uses `==`, so it
-- works for any equatable element type.
unique list =
    uniqueHelp list [] []


uniqueHelp list seen acc =
    case list of

        [] ->
            reverseHelp acc []

        x :: rest ->
            if member x seen then
                uniqueHelp rest seen acc

            else
                uniqueHelp rest (x :: seen) (x :: acc)
