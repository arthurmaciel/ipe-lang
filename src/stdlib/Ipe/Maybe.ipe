-- | Ipe.Maybe — combinators over the Maybe ADT.
--
-- The Maybe ADT itself (`Maybe a`, `Just`, `Nothing` ctors) remains
-- kernel-anchored so the type system and runtime IpeMaybe representation
-- stay in lockstep.  Without monomorphisation, call-site coercion would
-- mismatch inference; with it wired, the call-site coerceArg gets the
-- call's actual concrete type and emits e.g. `MaybeCoerce[string]`
-- instead of `MaybeCoerce[any]`.
module Ipe.Maybe exposing
    ( withDefault
    , map
    , andThen
    , map2, map3, map4, map5
    , andMap
    , combine
    , isJust
    , isNothing
    )


withDefault def m =
    case m of
        Just x -> x
        Nothing -> def


map fn m =
    case m of
        Just x -> Just (fn x)
        Nothing -> Nothing


andThen fn m =
    case m of
        Just x -> fn x
        Nothing -> Nothing


map2 fn ma mb =
    case ma of
        Just a ->
            case mb of
                Just b -> Just (fn a b)
                Nothing -> Nothing
        Nothing -> Nothing


map3 fn ma mb mc =
    case ma of
        Just a ->
            case mb of
                Just b ->
                    case mc of
                        Just c -> Just (fn a b c)
                        Nothing -> Nothing
                Nothing -> Nothing
        Nothing -> Nothing


map4 fn ma mb mc md =
    case ma of
        Just a ->
            case mb of
                Just b ->
                    case mc of
                        Just c ->
                            case md of
                                Just d -> Just (fn a b c d)
                                Nothing -> Nothing
                        Nothing -> Nothing
                Nothing -> Nothing
        Nothing -> Nothing


map5 fn ma mb mc md me =
    case ma of
        Just a ->
            case mb of
                Just b ->
                    case mc of
                        Just c ->
                            case md of
                                Just d ->
                                    case me of
                                        Just e -> Just (fn a b c d e)
                                        Nothing -> Nothing
                                Nothing -> Nothing
                        Nothing -> Nothing
                Nothing -> Nothing
        Nothing -> Nothing


andMap ma mfn =
    case mfn of
        Just fn ->
            case ma of
                Just a -> Just (fn a)
                Nothing -> Nothing
        Nothing -> Nothing


-- | `combine maybes` — collect a list of Maybes into a Maybe of list,
-- preserving order and short-circuiting on the first `Nothing`.
--
-- `combineHelp` walks the input tail-recursively, prepending each `Just`
-- payload onto `acc` (reverse order) and returning `Nothing` immediately
-- on the first miss.  At the empty base it flips `acc` via `reverseHelp`
-- for the final left-to-right output.  The helper is a tail call, so
-- `Ipe.Build.TailCallOpt` lowers it to a loop and a very long input runs
-- in constant native stack.
combine maybes =
    combineHelp maybes []


combineHelp maybes acc =
    case maybes of
        [] -> Just (reverseHelp acc [])
        (m :: rest) ->
            case m of
                Just x -> combineHelp rest (x :: acc)
                Nothing -> Nothing


reverseHelp list acc =
    case list of
        [] -> acc
        (x :: rest) -> reverseHelp rest (x :: acc)


isJust m =
    case m of
        Just _ -> True
        Nothing -> False


isNothing m =
    case m of
        Just _ -> False
        Nothing -> True
