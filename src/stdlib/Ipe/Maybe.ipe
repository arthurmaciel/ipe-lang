-- | `Ipe.Maybe` — work with values that may be absent.
--
-- A `Maybe a` is either `Just a` (a value is present) or `Nothing` (it is
-- absent). It is how Ipê represents "there might not be an answer" without a
-- null: a function that can fail to produce a value returns a `Maybe`, and the
-- caller must handle both cases before using the value. `List.head`, for
-- example, returns `Maybe a` because an empty list has no first element.
--
-- The functions here transform and combine `Maybe` values so you rarely need
-- to `case` on them by hand: `map` changes the value inside a `Just`,
-- `andThen` chains a step that may itself be absent, and `withDefault`
-- supplies a fallback when the value is missing.
--
-- Example:
--
--     import Ipe.Maybe as Maybe exposing (Maybe(..))
--     import Ipe.List as List
--
--     -- The first even number, defaulting to 0 when there is none.
--     firstEven : List Int -> Int
--     firstEven numbers =
--         List.find (\n -> modBy 2 n == 0) numbers
--             |> Maybe.withDefault 0
--
--     firstEven [ 1, 3, 4, 7 ] == 4
--     firstEven [ 1, 3, 5 ] == 0
--
-- `Maybe a`, `Just`, and `Nothing` are built in — no import brings them into
-- scope, though `exposing (Maybe(..))` above lets you write the constructors
-- unqualified.
--
-- See also: `Ipe.Result` (a failure that also carries an error), `Ipe.List`.

-- The `Maybe` type and its `Just` / `Nothing` constructors are kernel-anchored
-- so the type system and the runtime representation stay in lockstep; each
-- combinator below is a point-free `Ffi.kernel` alias to its registered
-- runtime implementation.
module Ipe.Maybe exposing
    ( Maybe(..)
    , withDefault
    , map
    , andThen
    , map2, map3, map4, map5
    , andMap
    , combine
    , isJust
    , isNothing
    )


import Ipe.Ffi as Ffi


{-| `withDefault fallback maybe` — the value inside a `Just`, or `fallback`
when the `Maybe` is `Nothing`.

```ipe
withDefault 0 (Just 5) --> 5
withDefault 0 Nothing --> 0
```
-}
withDefault : a -> Maybe a -> a
withDefault = Ffi.kernel "Maybe_withDefault"


{-| `map f maybe` — apply `f` to the value inside a `Just`, leaving `Nothing`
untouched.

```ipe
map (\n -> n + 1) (Just 4) --> Just 5
map (\n -> n + 1) Nothing --> Nothing
```
-}
map : (a -> b) -> Maybe a -> Maybe b
map = Ffi.kernel "Maybe_map"


{-| `andThen f maybe` — feed the value inside a `Just` to `f`; `Nothing` passes
straight through.

```ipe
andThen (\n -> if n > 0 then Just n else Nothing) (Just 3) --> Just 3
andThen (\n -> if n > 0 then Just n else Nothing) (Just 0) --> Nothing
andThen (\n -> if n > 0 then Just n else Nothing) Nothing --> Nothing
```
-}
andThen : (a -> Maybe b) -> Maybe a -> Maybe b
andThen = Ffi.kernel "Maybe_andThen"


{-| `map2 f ma mb` — combine two `Maybe` values with `f`; `Just` only when both
are present.

```ipe
map2 (\a b -> a + b) (Just 2) (Just 3) --> Just 5
map2 (\a b -> a + b) (Just 2) Nothing --> Nothing
```
-}
map2 : (a -> b -> c) -> Maybe a -> Maybe b -> Maybe c
map2 = Ffi.kernel "Maybe_map2"


{-| `map3 f ma mb mc` — combine three `Maybe` values with `f`; `Just` only when
all three are present.

```ipe
map3 (\a b c -> a + b + c) (Just 1) (Just 2) (Just 3) --> Just 6
map3 (\a b c -> a + b + c) (Just 1) Nothing (Just 3) --> Nothing
```
-}
map3 : (a -> b -> c -> d) -> Maybe a -> Maybe b -> Maybe c -> Maybe d
map3 = Ffi.kernel "Maybe_map3"


{-| `map4 f ma mb mc md` — combine four `Maybe` values with `f`; `Just` only
when all four are present.

```ipe
map4 (\a b c d -> a + b + c + d) (Just 1) (Just 2) (Just 3) (Just 4) --> Just 10
map4 (\a b c d -> a + b + c + d) (Just 1) Nothing (Just 3) (Just 4) --> Nothing
```
-}
map4 : (a -> b -> c -> d -> e) -> Maybe a -> Maybe b -> Maybe c -> Maybe d -> Maybe e
map4 = Ffi.kernel "Maybe_map4"


{-| `map5 f ma mb mc md me` — combine five `Maybe` values with `f`; `Just` only
when all five are present.

```ipe
map5 (\a b c d e -> a + b + c + d + e) (Just 1) (Just 2) (Just 3) (Just 4) (Just 5) --> Just 15
map5 (\a b c d e -> a + b + c + d + e) (Just 1) Nothing (Just 3) (Just 4) (Just 5) --> Nothing
```
-}
map5 : (a -> b -> c -> d -> e -> f) -> Maybe a -> Maybe b -> Maybe c -> Maybe d -> Maybe e -> Maybe f
map5 = Ffi.kernel "Maybe_map5"


{-| `andMap ma mfn` — apply the function inside `mfn` to the value inside `ma`;
`Nothing` if either is absent.

```ipe
andMap (Just 10) (Just (\n -> n + 1)) --> Just 11
andMap Nothing (Just (\n -> n + 1)) --> Nothing
```
-}
andMap : Maybe a -> Maybe (a -> b) -> Maybe b
andMap = Ffi.kernel "Maybe_andMap"


{-| `combine maybes` — turn a `List (Maybe a)` into a `Maybe (List a)`; `Nothing`
if any element is absent.

```ipe
combine [ Just 1, Just 2, Just 3 ] --> Just [ 1, 2, 3 ]
combine [ Just 1, Nothing, Just 3 ] --> Nothing
```
-}
combine : List (Maybe a) -> Maybe (List a)
combine = Ffi.kernel "Maybe_combine"


{-| `isJust maybe` — `True` when the `Maybe` holds a value.

```ipe
isJust (Just 0) --> True
isJust Nothing --> False
```
-}
isJust : Maybe a -> Bool
isJust = Ffi.kernel "Maybe_isJust"


{-| `isNothing maybe` — `True` when the `Maybe` is absent.

```ipe
isNothing Nothing --> True
isNothing (Just 0) --> False
```
-}
isNothing : Maybe a -> Bool
isNothing = Ffi.kernel "Maybe_isNothing"
