-- | Ipe.Char — single-character helpers.
--
-- `Char` is a single Unicode code point; functions are aliased to
-- runtime kernels via `Kernel.kernel`.
module Ipe.Char exposing
    ( isAlpha, isDigit, isLower, isUpper
    , isAlphaNum, isHexDigit, isOctDigit
    , toLower, toUpper
    , toCode, fromCode
    )


import Ipe.Ffi.Kernel as Kernel


isAlpha : Char -> Bool
isAlpha = Kernel.kernel "Char_isAlpha"


isDigit : Char -> Bool
isDigit = Kernel.kernel "Char_isDigit"


isLower : Char -> Bool
isLower = Kernel.kernel "Char_isLower"


isUpper : Char -> Bool
isUpper = Kernel.kernel "Char_isUpper"


-- | A letter or a digit (`isAlpha` or `isDigit`).
isAlphaNum : Char -> Bool
isAlphaNum = Kernel.kernel "Char_isAlphaNum"


-- | An ASCII hexadecimal digit (`0-9`, `a-f`, `A-F`).
isHexDigit : Char -> Bool
isHexDigit = Kernel.kernel "Char_isHexDigit"


-- | An ASCII octal digit (`0-7`).
isOctDigit : Char -> Bool
isOctDigit = Kernel.kernel "Char_isOctDigit"


-- Note: `toLower` / `toUpper` return a single-rune String (the
-- result of `unicode.ToLower(r)` wrapped in `string(_)`), matching
-- the kernel registry's `Char -> String` shape.
toLower : Char -> String
toLower = Kernel.kernel "Char_toLower"


toUpper : Char -> String
toUpper = Kernel.kernel "Char_toUpper"


-- | Unicode code-point conversion.
--
-- `toCode 'A'  → 65`
-- `fromCode 65 → 'A'`
--
-- Round-trip on a single Unicode code point.  Use these to bridge
-- between `Char` and integer arithmetic — index tables, parse ASCII
-- ranges, etc.  Out-of-range `fromCode` (negative or above
-- 0x10FFFF) yields the Unicode replacement character `'�'`.
toCode : Char -> Int
toCode = Kernel.kernel "Char_toCode"


fromCode : Int -> Char
fromCode = Kernel.kernel "Char_fromCode"
