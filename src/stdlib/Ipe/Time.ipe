-- | Ipe.Time -- clock + formatting + parsing (Layer 3 Ipe source).
--
-- Clock reads (`now`, `unixMillis`) return `Task Error Int` (the
-- value is the milliseconds since the Unix epoch).  Pure helpers
-- (`format*`, `timeString`, `addMillis`, `diffMillis`) work on the
-- integer millisecond value directly.  `sleep` and `every` take a typed
-- `Ipe.Duration` span; `every` is the Ipe.Web / Ipe.Tui subscription helper that
-- emits a `Sub msg` once per interval.
module Ipe.Time exposing
    ( now, unixMillis, sleep
    , timeString
    , format, formatHTTP, formatISO8601, formatRFC3339
    , addMillis, diffMillis
    , every
    , isLeapYear, daysInMonth
    )


import Ipe.Ffi as Ffi
import Ipe.Error exposing (Error)
import Ipe.Duration as Duration exposing (Duration)


-- Clock + sleep


now : () -> Task Error Int
now = Ffi.kernel "Time_now"


unixMillis : () -> Task Error Int
unixMillis = Ffi.kernel "Time_unixMillis"


-- | `sleep span` -- resolve after `span` elapses.  Takes a typed
-- `Ipe.Duration` (e.g. `Duration.seconds 2`); the raw milliseconds are unwrapped
-- for the runtime kernel.
sleep : Duration -> Task Error ()
sleep span =
    sleepKernel (Duration.toMillis span)


sleepKernel : Int -> Task Error ()
sleepKernel = Ffi.kernel "Time_sleep"


-- Pure formatting


timeString : Int -> String
timeString = Ffi.kernel "Time_timeString"


format : String -> Int -> String
format = Ffi.kernel "Time_format"


formatHTTP : Int -> String
formatHTTP = Ffi.kernel "Time_formatHTTP"


formatISO8601 : Int -> String
formatISO8601 = Ffi.kernel "Time_formatISO8601"


formatRFC3339 : Int -> String
formatRFC3339 = Ffi.kernel "Time_formatRFC3339"


-- Arithmetic


addMillis : Int -> Int -> Int
addMillis = Ffi.kernel "Time_addMillis"


diffMillis : Int -> Int -> Int
diffMillis = Ffi.kernel "Time_diffMillis"


-- Subscriptions


-- | `every interval msg` -- Ipe.Web / Ipe.Tui subscription that emits `msg` once
-- per `interval`.  Takes a typed `Ipe.Duration` (e.g. `Duration.seconds 1`); the
-- raw milliseconds are unwrapped for the runtime kernel.
every : Duration -> msg -> Sub msg
every interval msg =
    everyKernel (Duration.toMillis interval) msg


everyKernel : Int -> msg -> Sub msg
everyKernel = Ffi.kernel "Time_every"


-- Pure calendar helpers


-- | `isLeapYear year` — True when `year` is a leap year.
isLeapYear : Int -> Bool
isLeapYear = Ffi.kernel "Time_isLeapYear"


-- | `daysInMonth year month` — number of days in `month` of `year`.
daysInMonth : Int -> Int -> Int
daysInMonth = Ffi.kernel "Time_daysInMonth"
