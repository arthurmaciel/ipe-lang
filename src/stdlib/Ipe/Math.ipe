-- | Ipe.Math — pure numeric helpers.
--
-- Every function is aliased to a runtime kernel via `Kernel.kernel`.
module Ipe.Math exposing
    ( abs, min, max
    , sqrt, pow, log, log2, log10
    , exp, exp2
    , cbrt, hypot
    , floor, ceil, round, trunc
    , sin, cos, tan
    , asin, acos, atan, atan2
    , sinh, cosh, tanh
    , asinh, acosh, atanh
    , mod, remainder
    , pi, e, phi, sqrt2
    , inf, nan
    , isNaN
    )


import Ipe.Ffi.Kernel as Kernel


-- ─── Integer helpers ───────────────────────────────────────────────


abs : Int -> Int
abs = Kernel.kernel "Math_abs"


-- min / max are polymorphic — work on any comparable type at the
-- runtime level.  The kernel-registry sig is `forall a. a -> a -> a`;
-- Ipe-source annotation mirrors that.
min : a -> a -> a
min = Kernel.kernel "Math_min"


max : a -> a -> a
max = Kernel.kernel "Math_max"


-- ─── Float helpers ─────────────────────────────────────────────────


sqrt : Float -> Float
sqrt = Kernel.kernel "Math_sqrt"


pow : Float -> Float -> Float
pow = Kernel.kernel "Math_pow"


cbrt : Float -> Float
cbrt = Kernel.kernel "Math_cbrt"


hypot : Float -> Float -> Float
hypot = Kernel.kernel "Math_hypot"


-- ─── Exp / log family ──────────────────────────────────────────────


exp : Float -> Float
exp = Kernel.kernel "Math_exp"


exp2 : Float -> Float
exp2 = Kernel.kernel "Math_exp2"


log : Float -> Float
log = Kernel.kernel "Math_log"


log2 : Float -> Float
log2 = Kernel.kernel "Math_log2"


log10 : Float -> Float
log10 = Kernel.kernel "Math_log10"


-- ─── Trigonometry ──────────────────────────────────────────────────


sin : Float -> Float
sin = Kernel.kernel "Math_sin"


cos : Float -> Float
cos = Kernel.kernel "Math_cos"


tan : Float -> Float
tan = Kernel.kernel "Math_tan"


asin : Float -> Float
asin = Kernel.kernel "Math_asin"


acos : Float -> Float
acos = Kernel.kernel "Math_acos"


atan : Float -> Float
atan = Kernel.kernel "Math_atan"


-- atan2 y x — quadrant-aware arctangent (y first, x second),
-- distinct from atan which is unary.
atan2 : Float -> Float -> Float
atan2 = Kernel.kernel "Math_atan2"


-- ─── Hyperbolic ────────────────────────────────────────────────────


sinh : Float -> Float
sinh = Kernel.kernel "Math_sinh"


cosh : Float -> Float
cosh = Kernel.kernel "Math_cosh"


tanh : Float -> Float
tanh = Kernel.kernel "Math_tanh"


asinh : Float -> Float
asinh = Kernel.kernel "Math_asinh"


acosh : Float -> Float
acosh = Kernel.kernel "Math_acosh"


atanh : Float -> Float
atanh = Kernel.kernel "Math_atanh"


-- ─── Modulo + remainder ────────────────────────────────────────────


-- Float modulo. Result has the sign of the dividend.
mod : Float -> Float -> Float
mod = Kernel.kernel "Math_mod"


-- IEEE 754 remainder. Result has the sign of the dividend or zero.
remainder : Float -> Float -> Float
remainder = Kernel.kernel "Math_remainder"


-- ─── Rounding (Float → Int) ────────────────────────────────────────


floor : Float -> Int
floor = Kernel.kernel "Math_floor"


ceil : Float -> Int
ceil = Kernel.kernel "Math_ceil"


round : Float -> Int
round = Kernel.kernel "Math_round"


-- Truncate toward zero. `trunc 3.7 == 3`, `trunc (-3.7) == -3`.
trunc : Float -> Int
trunc = Kernel.kernel "Math_trunc"


-- ─── Constants ─────────────────────────────────────────────────────


pi : Float
pi = Kernel.kernel "Math_pi"


e : Float
e = Kernel.kernel "Math_e"


-- Golden ratio (1.618033988…).
phi : Float
phi = Kernel.kernel "Math_phi"


sqrt2 : Float
sqrt2 = Kernel.kernel "Math_sqrt2"


-- Positive infinity.
inf : Float
inf = Kernel.kernel "Math_inf"


-- Not-a-Number. `nan == nan` is False (NaN ≠ NaN by IEEE 754);
-- use `Math.isNaN` to test for NaN.
nan : Float
nan = Kernel.kernel "Math_nan"


-- Returns `True` if the argument is NaN (IEEE 754).
isNaN : Float -> Bool
isNaN = Kernel.kernel "Math_isNaN"
