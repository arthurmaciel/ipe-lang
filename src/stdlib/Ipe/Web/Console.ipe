-- | Ipe.Web.Console — types exposed for the optional `consoleAuth`
-- field on `Web.app` cfg (v0.16.0+).
--
-- The `consoleAuth` callback is row-polymorphic, optional, and has
-- shape `Request -> Task Error (Maybe Identity)`.  When the framework
-- gates `/_ipe/console` in `app`-mode (env `IPE_CONSOLE_AUTH=app`),
-- it invokes the callback per request, BEFORE mounting console
-- routes.  `Nothing` → 403 + structured `console.auth.denied` audit
-- log.  `Just identity` → request continues; the identity rides on
-- the same `__Host-ipe_console` session cookie + is attached to
-- subsequent telemetry for audit.
--
-- Use this when the app already has an SSO / multi-tenant session
-- middleware: thread it into `consoleAuth` and the embedded console
-- inherits the same auth surface — no second token to provision.
module Ipe.Web.Console exposing
    ( Identity
    , defaultIdentity
    , withEmail, withClaim, withClaims
    )

-- | Ipe.Web.Console — types exposed for the optional `consoleAuth`
-- field on `Web.app` cfg (v0.16.0).
--
-- The `consoleAuth` callback is row-polymorphic, optional, and has
-- shape:
--
--     consoleAuth : Request -> Task Error (Maybe Identity)
--
-- When the framework gates `/_ipe/console` in `app`-mode (env
-- `IPE_CONSOLE_AUTH=app`), it invokes the callback per request,
-- BEFORE mounting console routes. `Nothing` → 403 + structured
-- `console.auth.denied` audit log. `Just identity` → the request
-- continues; the identity rides on the same `__Host-ipe_console`
-- session cookie + is attached to subsequent telemetry for audit.
--
-- Use this when the app already has an SSO / multi-tenant session
-- middleware: thread it into `consoleAuth` and the embedded console
-- inherits the same auth surface — no second token to provision.
--
-- Example shape:
--
--     import Ipe.Web.Console exposing (Identity)
--     import Ipe.Dict as Dict
--
--     identifyAdmin : Request -> Task Error (Maybe Identity)
--     identifyAdmin req =
--         case Auth.sessionFromCookie req of
--             Nothing -> Task.succeed Nothing
--             Just session ->
--                 if session.role == "admin" then
--                     Task.succeed
--                         (Just
--                             { subject = session.userId
--                             , email = session.email
--                             , claims = Dict.empty
--                             }
--                         )
--                 else
--                     Task.succeed Nothing
--
--     main =
--         Web.app
--             { init = init, update = update, view = view
--             , subscriptions = subscriptions
--             , routes = routes, notFound = HomePage
--             , consoleAuth = identifyAdmin
--             }
--
-- The `claims` Dict is reserved for v0.16.5 RBAC integration
-- (custom-attribute predicates against console actions). Pass
-- `Dict.empty` today if you have no extra attributes — the framework
-- will treat any non-empty Identity as authorised in v0.16.0.


import Ipe.Prelude exposing (..)
import Ipe.Dict as Dict exposing (Dict)


-- | Identity returned by the `consoleAuth` callback when access is
-- permitted. `subject` is the user's stable identifier (GitHub
-- login / email / database UUID). `email` is surfaced separately
-- so the audit log line is human-scannable. `claims` carries any
-- extra attributes the v0.16.5 RBAC layer will consult.
type alias Identity =
    { subject : String
    , email : String
    , claims : Dict String String
    }


-- | `defaultIdentity "user-42"` — Identity with empty email + claims.
-- Builder chain stays source-compat when v0.16.5+ adds optional fields.
defaultIdentity : String -> Identity
defaultIdentity subject =
    { subject = subject
    , email = ""
    , claims = Dict.empty
    }


-- | `withEmail "alice@example.com" id` — replace the audit email.
withEmail : String -> Identity -> Identity
withEmail email id =
    { id | email = email }


-- | `withClaim "role" "admin" id` — add a single RBAC claim.
withClaim : String -> String -> Identity -> Identity
withClaim key value id =
    { id | claims = Dict.insert key value id.claims }


-- | `withClaims (Dict.fromList [("role", "admin"), ("tier", "pro")]) id`
-- — replace the entire claims Dict at once.
withClaims : Dict String String -> Identity -> Identity
withClaims claims id =
    { id | claims = claims }
