-- | Ipe.Io — standard-I/O effect kernels (Layer 3 Ipe source, M5a).
module Ipe.Io exposing
    ( readLine, writeStdout, writeStderr, println, eprintln
    )


import Ipe.Ffi as Ffi


readLine : () -> Task Error String
readLine = Ffi.kernel "Io_readLine"

writeStdout : String -> Task Error ()
writeStdout = Ffi.kernel "Io_writeStdout"

writeStderr : String -> Task Error ()
writeStderr = Ffi.kernel "Io_writeStderr"

println : String -> Task Error ()
println = Ffi.kernel "Io_println"

eprintln : String -> Task Error ()
eprintln = Ffi.kernel "Io_eprintln"
