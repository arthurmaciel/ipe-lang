-- | Ipe.Url — typed, validated URLs.
--
-- `Url` is opaque: the ONLY way to build one is `fromString`, which parses the
-- raw string (the SAME parser the runtime SSRF guard uses) and REJECTS a
-- scheme-less / relative / unparseable string. Because a `Url` is validated at
-- construction, the accessors (`scheme` / `host` / `port` / `path` / `query` /
-- `fragment`) take a `Url`, not a raw `String` — a scheme-confused or
-- unparseable URL can never reach an outbound request.
--
-- `Url.buildQuery` is the injection-safe query-string builder: it
-- percent-encodes every key and value, so a caller cannot forget to encode a
-- metacharacter (`&` / `=` / space / `#`) and split off a new parameter.
module Ipe.Url exposing
    ( Url
    , fromString, toString
    , scheme, host, port, path, query, fragment
    , buildQuery
    , checkScheme
    , RelativeRef, relativeRef, relativeRefToString
    )


import Ipe.Char as Char
import Ipe.Ffi.Kernel as Kernel
import Ipe.Error as Error exposing (Error)
import Ipe.List as List
import Ipe.Maybe exposing (Maybe(..))
import Ipe.Result exposing (Result(..))
import Ipe.String as String


-- | `fromString raw` — the parse-don't-validate seal: the only `Url`
-- constructor. Returns `Err` when `raw` is not a syntactically valid ABSOLUTE
-- URL (a relative reference, a scheme-less host, or otherwise unparseable);
-- otherwise `Ok` the parsed `Url`.
fromString : String -> Result Error Url
fromString = Kernel.kernel "Url_fromString"


-- | `toString url` — recover the serialized URL string.
toString : Url -> String
toString = Kernel.kernel "Url_toString"


-- | `scheme url` — the URL's scheme (`"https"`, `"http"`, …), always present.
scheme : Url -> String
scheme = Kernel.kernel "Url_scheme"


-- | `host url` — the host component, or `Nothing` for a hostless scheme
-- (e.g. `mailto:`).
host : Url -> Maybe String
host = Kernel.kernel "Url_host"


-- | `port url` — the port with the scheme's known default applied
-- (`https://x` → `443`), or `Nothing`.
port : Url -> Maybe Int
port = Kernel.kernel "Url_port"


-- | `path url` — the path component.
path : Url -> String
path = Kernel.kernel "Url_path"


-- | `query url` — the raw query string (without the leading `?`), or `Nothing`.
query : Url -> Maybe String
query = Kernel.kernel "Url_query"


-- | `fragment url` — the fragment (without the leading `#`), or `Nothing`.
fragment : Url -> Maybe String
fragment = Kernel.kernel "Url_fragment"


-- | `buildQuery pairs` — the injection-safe query-string builder. Every key and
-- value is percent-encoded, so a metacharacter in a value cannot split off a
-- new parameter. Returns the encoded string without a leading `?`.
buildQuery : List ( String, String ) -> String
buildQuery = Kernel.kernel "Url_buildQuery"


-- | `checkScheme allowed url` — the fail-closed scheme allowlist boundary, one
-- SSOT mechanism each surface calls with its own policy. `Url` is only the
-- SYNTACTIC parse seal: it legally carries ANY absolute scheme (`javascript:`,
-- `data:`, `file:` are valid `Url` values), so an href/link/share sink that
-- accepts arbitrary schemes is an injection surface. This narrows the already
-- parsed scheme against `allowed`: an `Ok url` only when `Url.scheme url` is in
-- the list, otherwise a typed `Err` naming the blocked scheme. The scheme read
-- is the runtime-normalised (lowercased) value, so a `JavaScript:` cannot evade
-- a lowercase allowlist. Absent proof the scheme is one a caller vetted, the
-- URL is rejected — never silently dropped, never passed through.
checkScheme : List String -> Url -> Result Error Url
checkScheme allowed url =
    if List.member (scheme url) allowed then
        Ok url

    else
        Err
            (Error.invalidInput
                ("Ipe.Url: blocked scheme \""
                    ++ scheme url
                    ++ "\" (not in the allowed set for this surface)"
                )
            )


-- | A safe same-origin RELATIVE reference (`/static/x.js`, `./style.css`,
-- `?q=1`, `#top`). A `Url` is always ABSOLUTE (`fromString` rejects a relative
-- string), so a relative asset path has no `Url` representation — this opaque
-- companion type is the ONE typed home for a validated relative ref, distinct
-- from `Url` and never claiming to be an absolute one. The ONLY constructor is
-- `relativeRef`.
type RelativeRef
    = RelativeRef String


-- | `isSafeRelativeRef s` — the SSOT fail-closed predicate every relative-ref
-- constructor shares (so a drifted hand-copy cannot drop a check). A reference
-- is safe ONLY when it cannot be coerced into a cross-origin or scheme-changing
-- navigation. Rejects, on PRESENCE (never strips): the empty string; any
-- control char (code `0..31` or `127`) that a browser would strip before
-- scheme detection (`ja\tvascript:`); a leading `//` (protocol-relative →
-- cross-origin); any backslash `\` (browsers fold `\` to `/`, so `/\evil.com`
-- becomes protocol-relative); and a `:` appearing before the first `/` (that is
-- an absolute-URL scheme, e.g. `javascript:x`, not a relative ref). Everything
-- else — a leading `/`, `.`/`..`, a bare segment, a leading `?` or `#` — is a
-- same-origin relative reference and is accepted.
isSafeRelativeRef : String -> Bool
isSafeRelativeRef s =
    not (String.isEmpty s)
        && not (String.any isControlChar s)
        && not (String.startsWith "//" s)
        && not (String.contains "\\" s)
        && not (schemeColonBeforeSlash s)


-- | `True` when `c` is an ASCII/Unicode control (code `0..31` or `127`).
isControlChar : Char -> Bool
isControlChar c =
    let
        code = Char.toCode c
    in
    code < 32 || code == 127


-- | `True` when a `:` appears before the first `/` — the signature of an
-- absolute-URL scheme (`javascript:…`, `http:…`) rather than a relative path,
-- where a `:` may legally appear only inside a path segment (after a `/`).
schemeColonBeforeSlash : String -> Bool
schemeColonBeforeSlash s =
    case List.head (String.split "/" s) of
        Just beforeSlash ->
            String.contains ":" beforeSlash

        Nothing ->
            False


-- | `relativeRef s` — the parse-don't-validate seal for a same-origin relative
-- reference. `Ok` only when `s` passes `isSafeRelativeRef`, otherwise a typed
-- `Err`. Fail-closed: an unsafe or absolute-looking string is turned away here,
-- never rendered into an `href` / `src`.
relativeRef : String -> Result Error RelativeRef
relativeRef s =
    if isSafeRelativeRef s then
        Ok (RelativeRef s)

    else
        Err
            (Error.invalidInput
                ("Ipe.Url: unsafe relative reference "
                    ++ "\""
                    ++ s
                    ++ "\" (empty, control char, protocol-relative, backslash, "
                    ++ "or scheme before first slash)"
                )
            )


-- | `relativeRefToString ref` — recover the validated relative reference string.
relativeRefToString : RelativeRef -> String
relativeRefToString ref =
    case ref of
        RelativeRef s ->
            s
