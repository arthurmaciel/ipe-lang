module Ipe.Palette exposing (Shade(..), toHex, Spacing(..), spacingPx)

-- Spike module for the compiled-source stdlib subsystem.
--
-- The load-bearing property this exercises — impossible for a kernel — is a
-- module in the reserved `Ipe.` namespace that DEFINES its own data type AND
-- pattern-matches its own constructors. `Shade` is deliberately NOT a reserved
-- built-in type name, so it validates the injection + N0025 exemption seam
-- independently of the reserved-name gate.
--
-- `Spacing` (formerly `Length`) exercises the complementary path: a type
-- name unique to this module, avoiding collision with the `Length` opaque that
-- `Ipe.Css` defines and owns. No shipped module reuses another module's opaque
-- type vocabulary. The lowerer keys `Spacing` under its real home
-- (`Ipe.Palette`), so it becomes its own enum and never collides with any
-- `Ipe.Css` or `Ipe.Ui` type.
--
-- Every top-level binding is fully annotated: the compiled-source stdlib
-- discipline (annotation-driven generalisation, no whole-program let-gen) is
-- machine-checked by a fail-closed canon gate.


type Shade
    = Dark
    | Light


toHex : Shade -> String
toHex shade =
    case shade of
        Dark ->
            "#000"

        Light ->
            "#fff"


type Spacing
    = Sp Int


spacingPx : Spacing -> Int
spacingPx s =
    case s of
        Sp n ->
            n
