module Main exposing (main)

import Ipe.Json.Decode as Decode
import Ipe.Json.Decode.Pipeline as Pipeline
import Ipe.Io as Io

-- The idiomatic |> pipe form: fields bind top-to-bottom, no swap. Must pass.
userDecoder =
    Decode.succeed (\name email -> { name = name, email = email })
        |> Pipeline.required "name" Decode.string
        |> Pipeline.required "email" Decode.string

main =
    let
        _ = userDecoder
    in
    Io.println "pipe"
