module Main exposing (main)

import Ipe.Json.Decode as Decode
import Ipe.Json.Decode.Pipeline as Pipeline
import Ipe.Io as Io

-- Reverse-associated hand-nested pipeline: binds fields to the constructor in
-- reverse source order, silently swapping same-typed fields. Rejected N0040.
userDecoder =
    Pipeline.required "name" Decode.string
        (Pipeline.required "email" Decode.string
            (Decode.succeed (\name email -> { name = name, email = email })))

main =
    let
        _ = userDecoder
    in
    Io.println "nested"
