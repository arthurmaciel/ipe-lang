module Main exposing (main)

import Ipe.Http as Http
import Ipe.Time as Time
import Ipe.Task as Task
import Ipe.Io as Io
import Ipe.String as String
import Ipe.Url as Url

main : Task ()
main =
    case Url.fromString "https://httpbin.org/get" of
        Ok url ->
            Time.now ()
                |> Task.andThen
                    (\t ->
                        Http.get url
                            |> Task.andThen
                                (\resp ->
                                    Io.println
                                        (Time.timeString t
                                            ++ " body length: "
                                            ++ String.fromInt (String.length resp.body))
                                )
                    )

        Err e ->
            Task.fail e
