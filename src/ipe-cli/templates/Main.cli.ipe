module Main exposing (main)

import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tea.Cli exposing (app)
import Ipe.Tea.Cli.Cmd as Cmd
import Ipe.Tea.Cli.Sub as Sub
import Ipe.Tea.Cli.Ui as Ui
import Ipe.Tea.Cli.Ui exposing (Lines)


type Msg
    = Echo String
    | Quit
    | NoOp


type alias Model =
    { count : Int
    , last : String
    }


init : () -> ( Model, Cmd Msg )
init _unit =
    ( { count = 0, last = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Echo line ->
            ( { count = model.count + 1, last = line }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


view : Model -> Lines Msg
view model =
    Ui.text
        ("echoed "
            ++ String.fromInt model.count
            ++ " ["
            ++ model.last
            ++ "] > "
        )


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


onLine : String -> Msg
onLine line =
    case String.trim line of
        "q" ->
            Quit

        "" ->
            NoOp

        trimmed ->
            Echo trimmed


main =
    app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onLine = onLine
        }
