module Main exposing (main)

-- | Regression tests for Money.allocate guard + sign-correct residue.
--
-- CO-INCR-001: allocate 0 must return [] (was: divide-by-zero abort, exit 101)
-- CO-INCR-002: allocate into negative total must distribute cents toward zero
--              so the parts sum back to the original amount exactly.

import Ipe.Prelude exposing (..)
import Ipe.Money as Money exposing (Money, Currency(..))
import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.System as System


-- Render each Money value as its formatted string joined by commas.
showParts : List Money -> String
showParts parts =
    String.join ", " (List.map Money.format parts)


main =
    let
        -- CO-INCR-001: parts = 0 must return []
        zeroResult = Money.allocate 0 (Money.fromMajor USD 100)
        zeroOk = List.length zeroResult == 0

        -- CO-INCR-001: parts = -1 must also return []
        negPartsResult = Money.allocate (-1) (Money.fromMajor USD 100)
        negPartsOk = List.length negPartsResult == 0

        -- CO-INCR-002: negative total, 3 parts
        -- -$1.00 = -100 cents; base = -33, remainder = -1 → [-34, -33, -33]
        negTotal = Money.neg (Money.fromMajor USD 1)
        negParts = Money.allocate 3 negTotal

        -- allocate always returns same-currency parts so sumOf never fails
        negSumOk =
            case Money.sumOf USD negParts of
                Ok negSum -> Money.eq negSum negTotal
                Err _ -> False

        -- Positive 3-way split still correct
        posParts = Money.allocate 3 (Money.fromMajor USD 100)

        posSumOk =
            case Money.sumOf USD posParts of
                Ok posSum -> Money.eq posSum (Money.fromMajor USD 100)
                Err _ -> False

        allOk = zeroOk && negPartsOk && negSumOk && posSumOk

        negPartsFormatted =
            case Money.sumOf USD negParts of
                Ok negSum -> "[" ++ showParts negParts ++ "] sum=" ++ Money.format negSum
                Err _ -> "ERROR"

        posFormatted =
            case Money.sumOf USD posParts of
                Ok posSum -> Money.format posSum
                Err _ -> "ERROR"

        report =
            String.join "\n"
                [ "allocate 0 -> " ++ String.fromInt (List.length zeroResult) ++ " parts (want 0): " ++ (if zeroOk then "PASS" else "FAIL")
                , "allocate (-1) -> " ++ String.fromInt (List.length negPartsResult) ++ " parts (want 0): " ++ (if negPartsOk then "PASS" else "FAIL")
                , "allocate 3 (-$1.00) -> " ++ negPartsFormatted ++ " (want -$1.00): " ++ (if negSumOk then "PASS" else "FAIL")
                , "allocate 3 ($100.00) sum=" ++ posFormatted ++ " (want $100.00): " ++ (if posSumOk then "PASS" else "FAIL")
                ]
    in
    Task.andThen
        (\_ ->
            if allOk then
                Task.succeed ()
            else
                System.exit 1
        )
        (Io.println report)
