module Main exposing (main)

-- Compiled-source `Ipe.Css` (#47) end-to-end: benign rendering + the three
-- CSS-injection vectors the ratified security posture must neutralise at
-- CONSTRUCTION (value gate, property-name gate, selector gate) with the
-- `stripStyleClose` breakout floor. `Ipe.Css` is compiled pure Ipe; only the
-- four `Ipe.CssSafety` leaf kernels are Rust.
import Ipe.Prelude exposing (..)
import Ipe.Css exposing (..)
import Ipe.Io as Io


-- Benign: renders exactly (Go byte-parity — same pure-Ipe fold).
benign : String
benign =
    stylesheet
        [ rule ".x" [ color (hex "ff6600"), padding (px 8) ] ]


-- Value-level breakout: `</style><script>` in a declaration value fails
-- `safeValue` → the declaration is DROPPED (`CssDropped`), so the rule body is
-- empty and no tag escapes.
attackValue : String
attackValue =
    stylesheet
        [ rule ".y" [ property "color" "</style><script>alert(1)</script>" ] ]


-- Script-sink: `url(javascript:…)` fails `safeValue` → DROPPED.
attackScheme : String
attackScheme =
    stylesheet
        [ rule ".z" [ property "background" "url(javascript:alert(1))" ] ]


-- Selector-level breakout: a selector carrying `{ } < /` fails `safeSelector`
-- → the WHOLE rule is dropped (`CssRuleDropped`).
attackSelector : String
attackSelector =
    stylesheet
        [ rule "body{}</style><script>alert(1)</script>" [ color (hex "000") ] ]


-- #105: a `raw` body smuggling an `@import` (CSS-level SSRF) is DROPPED
-- entirely (`CssRuleDropped`), not just `</style`-stripped.
attackRawImport : String
attackRawImport =
    stylesheet
        [ raw "@import url(https://evil.example/x.css);" ]


-- #105: a `keyframes` frame smuggling `@import` drops the whole rule
-- (`List.any` — ANY frame poisons it).
attackKeyframesImport : String
attackKeyframesImport =
    stylesheet
        [ keyframes "spin"
            [ "0% { transform: rotate(0deg) }"
            , "100% { transform: rotate(360deg) } @import url(x)"
            ]
        ]


-- #105 non-regression: a benign `keyframes` still renders.
benignKeyframes : String
benignKeyframes =
    stylesheet
        [ keyframes "fade"
            [ "0% { opacity: 0 }", "100% { opacity: 1 }" ]
        ]


main =
    Io.println
        (benign
            ++ "\n---\n"
            ++ attackValue
            ++ "\n---\n"
            ++ attackScheme
            ++ "\n---\n"
            ++ attackSelector
            ++ "\n---\n"
            ++ attackRawImport
            ++ "\n---\n"
            ++ attackKeyframesImport
            ++ "\n---\n"
            ++ benignKeyframes
        )
