module Main exposing (main)

-- Mixed import set: a KERNEL module (Ipe.String, qualifier-resolved) and a
-- COMPILED-SOURCE module (Ipe.Palette, injected + canonicalised as ordinary Ipe
-- source). Both must resolve — the resolve.rs `!deps.contains_key` conjunct keeps
-- the genuine kernel on the continue path while routing Ipe.Palette through the
-- normal dep-injection path.
import Ipe.String as String
import Ipe.Palette exposing (Shade(..), toHex, Spacing(..), spacingPx)
import Ipe.Io as Io


main =
    Io.println (toHex Dark ++ " " ++ String.fromInt (spacingPx (Sp 42)))
