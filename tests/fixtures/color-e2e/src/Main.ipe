module Main exposing (main)

-- A NON-UI console program that builds a colour with `Ipe.Color` and prints its
-- CSS + hex spelling. It imports NO `Ipe.Ui` surface, so the emitted project
-- carries the always-vendored `ipe_runtime::color::Color` carrier with no UI
-- feature — proving a colour value is one type everywhere, UI or not.
import Ipe.Color as Color
import Ipe.Io as Io


main =
    let
        base = Color.rgb 40 120 200

        faded = Color.withAlpha 0.5 base

        -- Parse boundary: a bad hex parses to the typed `ColorError` channel,
        -- never a panic or a silent default. On the `Ok` path we take the parsed
        -- colour; on the `Err` path we fall back to opaque black.
        parsed =
            case Color.fromHex "#2878c8" of
                Ok c ->
                    c

                Err _ ->
                    Color.black

        -- Profile down-sampling: the nearest-16 SSOT, exercised so the emitted
        -- program links the `toAnsi` shim + the `AnsiColor` carrier.
        readable =
            Color.readableTextOn base
    in
    Io.println
        (Color.toHex base
            ++ " "
            ++ Color.toCssRgba faded
            ++ " "
            ++ Color.toHex parsed
            ++ " "
            ++ Color.toHex readable
        )
