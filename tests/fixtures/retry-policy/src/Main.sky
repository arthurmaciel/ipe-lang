module Main exposing (main)

import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Std.Log exposing (println)

-- Simple assertion helper
assert : String -> Bool -> Task Error ()
assert label ok =
    if ok then
        println ("PASS: " ++ label)
    else
        Task.fail (Error.unexpected ("FAIL: " ++ label))

-- Test 1: retryWith on succeed returns the value
test1 : Task Error ()
test1 =
    Task.retryWith (Task.linearBackoff 5 1) (Task.succeed 42)
        |> Task.andThen (\v -> assert "retryWith succeed" (v == 42))

-- Test 2: retryWith exhausts retries on permanent failure
test2 : Task Error ()
test2 =
    Task.retryWith (Task.linearBackoff 2 1) (Task.fail (Error.io "transient"))
        |> Task.onError (\_ -> assert "retryWith fail exhausted" True)

-- Test 3: exponentialBackoff
test3 : Task Error ()
test3 =
    Task.retryWith (Task.exponentialBackoff 1 1) (Task.succeed "ok")
        |> Task.andThen (\v -> assert "exponentialBackoff succeed" (v == "ok"))

-- Test 4: withJitter composes
test4 : Task Error ()
test4 =
    let
        policy = Task.withJitter (Task.linearBackoff 3 1)
    in
    Task.retryWith policy (Task.succeed True)
        |> Task.andThen (\v -> assert "withJitter succeed" v)

-- Test 5: retryOn predicate short-circuit (never retry)
test5 : Task Error ()
test5 =
    let
        policy = Task.retryOn (\_ -> False) (Task.linearBackoff 5 1)
    in
    Task.retryWith policy (Task.fail (Error.io "boom"))
        |> Task.onError (\_ -> assert "retryOn never-retry" True)

-- Test 6: builder chain
test6 : Task Error ()
test6 =
    let
        policy =
            Task.defaultRetryPolicy
                |> Task.withMaxAttempts 5
                |> Task.withBaseMs 1
                |> Task.withKind 0
                |> Task.withRetryOn (\_ -> True)
    in
    Task.retryWith policy (Task.succeed 99)
        |> Task.andThen (\v -> assert "builder chain succeed" (v == 99))

main : Task Error ()
main =
    test1
        |> Task.andThen (\_ -> test2)
        |> Task.andThen (\_ -> test3)
        |> Task.andThen (\_ -> test4)
        |> Task.andThen (\_ -> test5)
        |> Task.andThen (\_ -> test6)
        |> Task.andThen (\_ -> println "All retry tests passed!")
