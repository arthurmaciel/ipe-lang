module Main exposing (main)

-- Ipe.Webview spike — Three.js + WebGL2 under a native webview.
--
-- Validates risk #2 from docs/ipewebview/PLAN.md: does WebGL2 +
-- Three.js work end-to-end through the system webview engine?
--
-- Run it with `ipe run src/Main.ipe` — a native window opens
-- pointing at the spike scene. There's no separate `webview_go`
-- shim, no separate Ipe.Http.Server: the same Ipe.Webview backend
-- that powers every other Ipe.Webview example handles loopback
-- asset serving via ipe.toml's `[live].static` (bug #370 — the
-- runtime spawns a 127.0.0.1 http.Server when `static` is set,
-- and Navigate()s to it so the embedded browser can resolve
-- relative paths like `/static/three.min.js`).
--
-- What we're proving by this rewrite:
--
--   1. The Ipe.Webview backend can host real-world web content
--      (Three.js + WebGL2) end-to-end via the built-in static
--      serving — no hand-rolled Ipe.Http.Server, no second
--      process, no `webview_go` shim.
--
--   2. The same Ipe source you'd write for a Ipe.Live page works
--      for a Ipe.Webview desktop app — `Ipe.Html.script`,
--      `Ipe.Html.link`, `Ipe.Html.node "canvas"`, etc all render
--      identically.
--
--   3. `<script>` tags in the rendered view bootstrap correctly
--      (the runtime's __ipeReviveScripts shim revives them after
--      the initial HTML lands in the document — same hardening
--      Ipe.Live uses).
import Ipe.Task as Task
import Ipe.Webview as Webview
import Ipe.Tea.WebView.Cmd as Cmd
import Ipe.Tea.WebView.Sub as Sub
import Ipe.Html as Html
import Ipe.Html.Attributes as Attr

-- ═══════════════════════════════════════════════════════════════════
-- TEA shape — minimal: nothing in Model the WebGL scene cares about,
-- but the Webview.app contract requires init/update/view/subs.
-- ═══════════════════════════════════════════════════════════════════
type alias Model =
    {  }

type Msg
    = NoOp


init : () -> ( Model, Cmd Msg )
init _ =
    ( {}, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update _ model =
    ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- ═══════════════════════════════════════════════════════════════════
-- View — Three.js HUD + canvas mount + two vendored script tags.
-- The browser fetches /static/three.min.js + /static/scene.js +
-- /static/style.css from the loopback http server that Ipe.Webview
-- spawns when ipe.toml's `[live].static = "static"` is set.
-- ═══════════════════════════════════════════════════════════════════
-- Webview's renderer expects the same Html-node tree shape Ipe.Live
-- emits. We use raw Ipe.Html nodes (NOT Ipe.Ui's layout primitives)
-- because the Three.js scene paints into a plain <div id="canvas-wrap">
-- that the loaded JS bundle takes over — no Ipe.Ui layout machinery
-- needed.
view : Model -> any
view _ =
    Html.node
        "div"
        [Attr.id "scene-root"]
        [ Html.node
              "link"
              [ Attr.attribute "rel" "stylesheet"
              , Attr.href "/static/style.css"
              ]
              []
        , Html.node
              "div"
              [Attr.id "hud"]
              [ Html.node
                    "div"
                    [Attr.id "title"]
                    [Html.text "Ipe.Webview spike"]
              , Html.node
                    "div"
                    [Attr.id "info"]
                    [Html.text "three.js + animation under Ipe.Webview"]
              , Html.node
                    "div"
                    [Attr.id "fps"]
                    [ Html.text "FPS: "
                    , Html.node "span" [Attr.id "fps-value"] [Html.text "--"]
                    ]
              , Html.node
                    "div"
                    [Attr.id "renderer"]
                    [ Html.text "Renderer: "
                    , Html.node
                          "span"
                          [Attr.id "renderer-value"]
                          [Html.text "probing..."]
                    ]
              , Html.node
                    "div"
                    [Attr.id "webgl-version"]
                    [ Html.text "WebGL: "
                    , Html.node
                          "span"
                          [Attr.id "webgl-version-value"]
                          [Html.text "probing..."]
                    ]
              , Html.node
                    "button"
                    [Attr.id "toggle-rotate"]
                    [Html.text "pause rotation"]
              , Html.node
                    "button"
                    [Attr.id "toggle-wireframe"]
                    [Html.text "toggle wireframe"]
              ]
        , Html.node "div" [Attr.id "canvas-wrap"] []
        , Html.script [Attr.src "/static/three.min.js"] []
        , Html.script [Attr.src "/static/scene.js"] []
        ]


-- ═══════════════════════════════════════════════════════════════════
-- Main
-- ═══════════════════════════════════════════════════════════════════
main =
    Webview.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , window = { title = "Ipe.Webview spike - three.js", size = ( 1024, 720 ) }
        }
        |> Task.run
