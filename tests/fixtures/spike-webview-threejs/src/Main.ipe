module Main exposing (main)

-- Web shape hosted as a native webview — Three.js + WebGL2.
--
-- Proves WebGL2 + Three.js work end-to-end through the system webview
-- engine. Built as `web desktop`, the same `Web.app` a served web page
-- uses is driven by the native webview host: a native window opens
-- pointing at the scene. The runtime serves the `static/` assets over
-- loopback so the embedded browser resolves relative paths like
-- `/static/three.min.js`.
--
-- What this proves:
--
--   1. The webview host can serve real-world web content (Three.js +
--      WebGL2) end-to-end via the built-in static serving.
--
--   2. The same Ipe source you'd write for a served `Web` page works
--      under the webview host — `Ipe.Html.script`, `Ipe.Html.link`,
--      `Ipe.Html.node "canvas"` all render identically.
--
--   3. `<script>` tags in the rendered view bootstrap correctly after
--      the initial HTML lands in the document.
import Ipe.App.Tea.Web as Web
import Ipe.App.Tea.Web.Cmd as Cmd
import Ipe.App.Tea.Web.Sub as Sub
import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.Result as Result exposing (Result(..))

-- ═══════════════════════════════════════════════════════════════════
-- TEA shape — minimal: nothing in Model the WebGL scene cares about,
-- but the Web.app contract requires init/update/view/subs.
-- ═══════════════════════════════════════════════════════════════════
type alias Model =
    {  }

type Msg
    = NoOp


init : WebReq -> ( Model, Cmd Msg )
init _ =
    ( {}, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update _ model =
    ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- ═══════════════════════════════════════════════════════════════════
-- View — Three.js HUD + canvas mount + two vendored script tags.
-- The browser fetches /static/three.min.js + /static/scene.js +
-- /static/style.css from the loopback http server the webview host
-- spawns to serve the project's `static/` assets.
-- ═══════════════════════════════════════════════════════════════════
-- The webview host renders the same Html-node tree a served `Web` page
-- emits. We use raw Ipe.Html nodes (NOT Ipe.Ui's layout primitives)
-- because the Three.js scene paints into a plain <div id="canvas-wrap">
-- that the loaded JS bundle takes over — no Ipe.Ui layout machinery
-- needed.
-- | A same-origin relative `href` for a static asset. The path is a known-safe
-- literal, so the fail-closed `linkTarget` seal always succeeds; an `Err`
-- (unreachable here) degrades to `noAttr` rather than emitting a broken href.
hrefRel : String -> Attr.Attribute msg
hrefRel path =
    case Attr.linkTarget path of
        Ok target ->
            Attr.href target

        Err _ ->
            Attr.noAttr


-- | A same-origin relative `src` for a static asset, fail-closed through the
-- media `imageSrc` seal (a `src` is a fetch sink, narrowed to `http`/`https` or
-- a same-origin path — distinct from the navigation `link` seal `hrefRel` uses).
srcRel : String -> Attr.Attribute msg
srcRel path =
    case Attr.imageSrc path of
        Ok source ->
            Attr.src source

        Err _ ->
            Attr.noAttr


view : Model -> any
view _ =
    Html.node
        "div"
        [Attr.id "scene-root"]
        [ Html.node
              "link"
              [ Attr.attribute "rel" "stylesheet"
              , hrefRel "/static/style.css"
              ]
              []
        , Html.node
              "div"
              [Attr.id "hud"]
              [ Html.node
                    "div"
                    [Attr.id "title"]
                    [Html.text "Ipe.Webview spike"]
              , Html.node
                    "div"
                    [Attr.id "info"]
                    [Html.text "three.js + animation under Ipe.Webview"]
              , Html.node
                    "div"
                    [Attr.id "fps"]
                    [ Html.text "FPS: "
                    , Html.node "span" [Attr.id "fps-value"] [Html.text "--"]
                    ]
              , Html.node
                    "div"
                    [Attr.id "renderer"]
                    [ Html.text "Renderer: "
                    , Html.node
                          "span"
                          [Attr.id "renderer-value"]
                          [Html.text "probing..."]
                    ]
              , Html.node
                    "div"
                    [Attr.id "webgl-version"]
                    [ Html.text "WebGL: "
                    , Html.node
                          "span"
                          [Attr.id "webgl-version-value"]
                          [Html.text "probing..."]
                    ]
              , Html.node
                    "button"
                    [Attr.id "toggle-rotate"]
                    [Html.text "pause rotation"]
              , Html.node
                    "button"
                    [Attr.id "toggle-wireframe"]
                    [Html.text "toggle wireframe"]
              ]
        , Html.node "div" [Attr.id "canvas-wrap"] []
        , Html.script [srcRel "/static/three.min.js"] []
        , Html.script [srcRel "/static/scene.js"] []
        ]


-- ═══════════════════════════════════════════════════════════════════
-- Main
-- ═══════════════════════════════════════════════════════════════════
main =
    Web.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = NoOp
        }
