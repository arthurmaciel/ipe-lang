module Main exposing (main)

import Ipe.Prelude exposing (..)
import Ipe.Io as Io

-- m-negative gate: the annotation references `Bogus.Box`, but no module named
-- `Bogus` is imported or exists. Canonicalisation must reject this with
-- IPE-N0004 (unknown module) rather than pass it through to codegen.
answer : Bogus.Box Int
answer =
    42

main =
    Io.println (String.fromInt answer)
