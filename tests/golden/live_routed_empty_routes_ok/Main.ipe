module Main exposing (main)

-- #108 round 4 (hole 1) regression — WELL-TYPED routed app with EMPTY routes.
--
-- `routes = []` emits a typed empty vec (`Vec::<Route<…>>::new()`).  The
-- runtime `Route<Page>` struct has NO default type parameter, so the
-- pre-round-4 `IrType::WebRoute` rendering (a bare
-- `ipe_runtime::live::route::Route`) made this ipec-0 program cargo-fail with
-- E0107 ("missing generics for struct `route::Route`") — an
-- exit-0-then-cargo-fail seal violation.  Post-fix `IrType::WebRoute(page)`
-- threads the page type through the lowerer and renders `Route<MainPage>`.
--
-- ipec MUST exit 0 AND the emitted project MUST cargo-build.

import Ipe.Web as Web
import Ipe.Ui as Ui

type Page
    = CounterPage
    | AboutPage

type Msg
    = Increment

type alias Model =
    { page : Page
    , count : Int
    }

init : a -> ( Model, Cmd Msg )
init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )

update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

view : Model -> Html Msg
view model =
    Ui.layout [] (Ui.text (String.fromInt model.count))

subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none

main =
    Web.app
        { init = init, update = update, view = view, subscriptions = subscriptions
        , routes = [], notFound = CounterPage
        }
