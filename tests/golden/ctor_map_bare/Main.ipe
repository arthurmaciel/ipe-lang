module Main exposing (main)
import Ipe.Prelude exposing (..)
import Ipe.List as List
import Ipe.String as String

-- A1 (#147 seal). `Wrap : Int -> Box` (arity 1) is passed bare to
-- `List.map` — the lowerer eta-expands it into a `|eta_0| Box::Wrap(eta_0)` closure.
-- Expected output: "1, 2, 3"

type Box = Wrap Int

unbox : Box -> Int
unbox b =
    case b of
        Wrap n -> n

main =
    let boxes = List.map Wrap [1, 2, 3] in
    let ns = List.map unbox boxes in
    println (String.join ", " (List.map String.fromInt ns))
