module Dep exposing (composed)

import Ipe.Task as Task
import Ipe.Error exposing (Error)


-- The forwarded capture must be a GENUINELY non-Clone carrier (a `Task`) so
-- the IPE-L0126 fail-close is permanent: a pure fn-typed capture is
-- Arc-promoted (legal), so it can no longer anchor this attribution test.
useTask : Task Error Int -> Int -> Int
useTask t x =
    x
-- `composed` is a LARGE def whose body starts far above the failing span:
-- the leading `let` padding pushes the IPE-L0126 forwarding site deep inside
-- the def body, so this def's `body_span.lo` is a poor (large-`lo_dist`) match
-- for the failing span. That is the exact condition (mirroring #221's
-- `Server.run` enclosing `guarded`) under which the pre-fix-B byte-offset
-- heuristic prefers a numerically-closer Main.ipe def and mis-blames it. Fix B
-- threads `Dep.composed`'s home so the diagnostic renders against Dep.ipe.


composed : Task Error Int -> Int -> Int
composed t =
    let
        pad0 = 0
        pad1 = 0
        pad2 = 0
        pad3 = 0
        pad4 = 0
        pad5 = 0
        pad6 = 0
        pad7 = 0
    in
        \x -> useTask t x
