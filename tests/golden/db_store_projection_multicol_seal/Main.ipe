module Main exposing (main)

-- SEAL smoke for the typed multi-column projection over a two-store inner join
-- (`Store.join` / `Store.select` / `Store.selectToList`). Two `Codec.auto`-derived
-- stores join on `books.author_id = authors.id`; `select` projects TWO columns as
-- a flat tuple of references (`( book.title, author.name )`) so the join lowers to
-- ONE parameterized statement selecting exactly those two columns
-- (`SELECT a0.title AS p0, a1.name AS p1 FROM …`, column pushdown). Each projected
-- row comes back as a `Row` keyed by the output names `p0` / `p1`, read by
-- position with `Store.projReadText 0` / `Store.projReadText 1`. No live database
-- is needed: `Task.onError` catches the connection failure and the program exits
-- cleanly. The SEAL proof is a `cargo build` of the emitted project under
-- `IPE_E2E=1`.
--
-- The projection is expressed as a value that lowers to SQL, not a per-row
-- fan-out:
--   * `Store.select (\( book, author ) -> ( book.title, author.name ))` names the
--     two projected columns by bare field references read at compile time (never
--     run over real rows), so a projection that is not a flat tuple of column
--     references is a build error.
--   * `Store.selectToList` returns `List Row`, each row carrying `p0` and `p1`.
--   * The decode is caller-side and monomorphic: each `projReadText` reads its own
--     `p<index>` cell, so the projection value stores no decoder.
--
-- Expected output:
--   projection-multicol-seal:ok


import Ipe.Codec as Codec exposing (Codec)
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error exposing (Error)
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Result as Result exposing (Result(..))
import Ipe.Task as Task exposing (Task)


type alias Book =
    { id : String
    , title : String
    , authorId : String
    }


type alias Author =
    { id : String
    , name : String
    , active : Bool
    }


blankBook : Book
blankBook =
    { id = "", title = "", authorId = "" }


blankAuthor : Author
blankAuthor =
    { id = "", name = "", active = False }


bookCodec : Codec Book
bookCodec =
    Codec.auto blankBook


authorCodec : Codec Author
authorCodec =
    Codec.auto blankAuthor


booksStore : Result Error (Store Book)
booksStore =
    Store.fromCodec "books" bookCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


authorsStore : Result Error (Store Author)
authorsStore =
    Store.fromCodec "authors" authorCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


-- The projection: one parameterized statement selecting `book.title` and
-- `author.name`, no per-row fan-out. Each projected row is a `Row` keyed by `p0`
-- (title) and `p1` (name).
titledAuthors : Db -> Store Book -> Store Author -> Task Error (List Store.Row)
titledAuthors db books authors =
    Store.selectToList db
        (Store.select (\( book, author ) -> ( book.title, author.name ))
            (Store.join books .authorId authors .id)
        )


run : Db -> Task Error (List Store.Row)
run db =
    case booksStore of
        Ok books ->
            case authorsStore of
                Ok authors ->
                    titledAuthors db books authors

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


main : Task Error ()
main =
    Task.andThen
        (\_ -> Io.println "projection-multicol-seal:ok")
        (Task.onError
            (\_ -> Task.succeed ())
            (Task.andThen
                (\db -> Task.map (\_ -> ()) (run db))
                (Db.connect ())
            )
        )
