module Main exposing (main)

-- Decode an integer and a string from JSON; output both on one line.
-- Exercises the `JsonDec.int` and `JsonDec.string` primitive decoders via
-- `JsonDec.decodeString` (parses the JSON string, runs the decoder, returns
-- `Result Error a`).
main =
    let
        r1 = JsonDec.decodeString JsonDec.int "42"

        r2 = JsonDec.decodeString JsonDec.string "\"hello\""
    in
    case r1 of
        Ok n ->
            case r2 of
                Ok s ->
                    println (String.fromInt n ++ " " ++ s)

                Err _ ->
                    println "err2"

        Err _ ->
            println "err1"
