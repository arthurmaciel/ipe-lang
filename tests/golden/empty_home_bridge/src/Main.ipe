module Main exposing (main)

import Ipe.String as String
import ModA exposing (useA)
import ModB exposing (makeB)
import Ipe.Io as Io

-- `Token` is UNQUALIFIED and NOT imported as a type here -> canonicaliser
-- falls back to unwrap_or_default() -> home = [].  Does ModB's TokB flow
-- through into ModA.useA (which expects ModA.Token)?
relay : Token -> String
relay t =
    useA t

main =
    Io.println (relay makeB)
