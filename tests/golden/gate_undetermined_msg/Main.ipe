module Main exposing (main)

-- M5c under-determined-msg gate (IPE-L0102).
-- `Cmd.none` is used in isolation: nothing in the expression tree anchors the
-- `msg` type parameter.  The HM solver leaves `msg` as a free type variable,
-- so the emitter cannot produce inferrable Rust (`SkyCmd<_>` is ambiguous).
-- ipe must exit 1 with IPE-L0102 before generating any Rust project.
main =
    let
        _ = Cmd.none
    in
    println "ok"
