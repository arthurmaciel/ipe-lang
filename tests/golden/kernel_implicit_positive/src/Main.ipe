module Main exposing (main)

import Ipe.Io as Io

-- Positive control for #138: `Request` is in RESERVED_BUILTIN_TYPES and gets
-- the empty-home sentinel by design, so it must compile even without an explicit
-- `import Ipe.Http.Server exposing (Request)`.
--
-- The annotation uses a kernel-implicit type unqualified — the new TypeNotFound
-- gate must NOT reject it (it is a genuine builtin with empty-home sentinel).
getPath : Request -> String
getPath _ = "/"

main =
    Io.println "ok"
