module Main exposing (main)

-- Companion to `dict_adt_gate` for the GENERIC-FUNCTION path with a RECORD key.
-- `singletonDict` is a generic `a -> v -> Dict a v` forwarder built on `Dict.fromList`.
-- The Dict key variable carries the Ipe `comparable`-key obligation
-- (`TyBounds::dict_key`, → Rust `Hash + Eq + Ord`), so the forwarder generalises to
-- a Rust generic bounded by those traits.  Instantiating it at a RECORD — which
-- Rust cannot hash or order — is rejected at type-check (IPE-T0014) rather than
-- emitting an unbounded `singleton_dict::<T, V>` that `cargo` cannot build.

import Ipe.Dict as Dict
import Ipe.Io as Io
import Ipe.String


singletonDict : a -> v -> Dict a v
singletonDict k v =
    Dict.fromList [ ( k, v ) ]


rec : { x : Int }
rec =
    { x = 1 }


-- A fully polymorphic sink: its argument stays at `a`, so the forwarder
-- instantiation is the only thing under test.
gated : a -> String
gated _ =
    "gated"


main =
    Io.println (gated (singletonDict rec 42))
