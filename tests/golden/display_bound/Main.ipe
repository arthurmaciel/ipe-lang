module Main exposing (main)

import Ipe.Prelude exposing (..)
import Ipe.Task as Task
import Ipe.Io as Io


-- Regression — `toString` on a wildcard `any` param.
--
-- The runtime stringifier `basics_to_string<T: IpeStringify>` needs its arg to
-- be `IpeStringify`. The general kernel->bound map
-- (`apply_kernel_type_param_bounds`) obliges `IpeStringify` (BoundSet::SHOW) on
-- any generic param a `BasicsToString` kernel is applied to — the same
-- structural machinery as the `Db.get*`->`IpeRow` obligation, generalised.
-- `IpeStringify` is satisfiable by every scalar AND every composite, so the
-- emitted `main_render` body's `basics_to_string(x)` type-checks and the crate
-- cargo-builds (without the bound the enclosing `<T1: Clone>` param could not
-- prove the obligation → E0277 at cargo, an exit-0-then-cargo-fail breach).
render : any -> String
render x =
    "value=" ++ toString x


main : Task Error ()
main =
    Io.println (render 42)
