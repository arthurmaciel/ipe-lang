module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.Result
import Ipe.String

-- JsonDec.int matches Go's lenient `int(f)`: every JSON number unmarshals to a
-- float, then truncates toward zero — it does NOT reject non-integral numbers.
--   "3.0" -> 3
--   "3.5" -> 3      (truncation, not rounding)
--   "1e2" -> 100    (exponent literal accepted)
-- JsonDec.string rides along to keep the primitive-decoder coverage.
main =
    let
        a = Result.withDefault 0 (JsonDec.decodeString JsonDec.int "3.0")

        b = Result.withDefault 0 (JsonDec.decodeString JsonDec.int "3.5")

        c = Result.withDefault 0 (JsonDec.decodeString JsonDec.int "1e2")

        s = Result.withDefault "?" (JsonDec.decodeString JsonDec.string "\"hello\"")
    in
    Io.println
        (String.join " "
            [ String.fromInt a, String.fromInt b, String.fromInt c, s ]
        )
