module Main exposing (main)

import Std.Html as Html
import Std.Html.Events as Event


-- #107 POSITIVE sentinel: `Std.Html.Events.onInput` produces a
-- `Std.Html.Attribute msg` that composes with a Std.Html element's attribute
-- list. `onInput` receives a `String -> msg` closure — well-typed.
--
-- Pre-#107 this fixture rendered via `Ui.el`, relying on the (incorrect)
-- Event→Ui conflation that made `Std.Html.Events.*` produce a `Std.Ui`
-- attribute. #107 makes `Std.Html.Events` produce `Std.Html.Attribute`, so the
-- correct host is a Std.Html element. Std.Ui events stay covered by
-- `stdui_onclick` (which uses `Ui.onClick`).
--
-- oracle_divergence = true: Go oracle does not expose Html.htmlRender.


type Msg
    = SetText String


staticHtml : String
staticHtml =
    Html.htmlRender
        (Html.input [ Event.onInput (\s -> SetText s) ])


main =
    println staticHtml
