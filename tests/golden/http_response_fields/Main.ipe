module Main exposing (main)

-- Exercises the real Http.* kernel surface:
-- * Http.defaultRequest proves the HttpRequest fieldset synthesises and the
--   url field is readable.
-- * A local HttpResponse record literal (same {body, headers, status} shape
--   the task_map targets) proves field access compiles for the response side.
import Ipe.Http as Http
import Ipe.Dict as Dict
import Ipe.Io as Io


main =
    let
        req = Http.defaultRequest "http://example.com"

        resp =
            { status = 200
            , body = "ok"
            , headers = Dict.fromList [ ( "X-Test", "1" ) ]
            }

        headerVal = Maybe.withDefault "missing" (Dict.get "X-Test" resp.headers)
    in
    Io.println
        (String.join "\n"
            [ req.url
            , String.fromInt resp.status
            , resp.body
            , headerVal
            ]
        )
