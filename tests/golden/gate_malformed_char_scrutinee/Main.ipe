module Main exposing (main)
import Ipe.Prelude exposing (..)
import Ipe.Io as Io

-- A second unrecognised escape (`\z`), this time in scrutinee position. Same
-- single-character invariant, same IPE-P0015 floor: the malformed char literal
-- is rejected at lex time with no emit.
grade : Char -> Int
grade c =
    case c of
        'a' -> 1
        _ -> 0

main =
    Io.println (String.fromInt (grade '\z'))
