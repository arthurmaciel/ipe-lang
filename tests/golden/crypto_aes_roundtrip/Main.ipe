module Main exposing (main)
import Ipe.Io as Io
import Ipe.Crypto

-- AES-GCM round-trip: encrypt then decrypt returns the original plaintext.
-- Keys are derived via the typed Key-returning derivation function.
-- The nonce is random so the ciphertext differs each run; only "ok" is tested.
main =
    let
        key1 = Crypto.aesKeyFromPasswordKey "password" "salt"

        key2 = Crypto.aesKeyFromPasswordKey "password" "salt"

        result =
            case Crypto.aesGcmEncryptKey key1 "hello" of
                Ok ciphertext ->
                    case Crypto.aesGcmDecryptKey key2 ciphertext of
                        Ok plaintext ->
                            if plaintext == "hello" then
                                "ok"

                            else
                                "wrong"

                        Err _ ->
                            "decrypt-failed"

                Err _ ->
                    "encrypt-failed"
    in
    Io.println result
