module Main exposing (main)
import Ipe.Io as Io
import Ipe.Path as Path

-- Negative gate for `path "…"` traversal validation (IPE-P0063).
-- `path "../etc/passwd"` must be a compile-time error: the `..`-traversal
-- escape is caught at the canonicalise stage, never reaching the backend.

evilPath : Path.Path
evilPath =
    path "../etc/passwd"

main =
    Io.println (Path.toString evilPath)
