module Main exposing (main)

import Ipe.Prelude exposing (..)
import Lib exposing (Status(..), label, seedAndCount)
import Ipe.Io as Io


{-| A `Main`-owned helper (Rust name `main_summary`) — uses `Lib`'s `label`
across the module boundary.
-}
summary : Int -> String
summary count =
    label Seeded ++ ":" ++ String.fromInt count


main =
    Task.andThen
        (\count -> Io.println (summary count))
        seedAndCount
