module Main exposing (main)
import Ipe.Io as Io
import Ipe.Path as Path

-- Negative gate for `path "…"` NUL-byte validation (IPE-P0063).
-- A string containing a NUL byte (\0) is a syscall-boundary truncation risk;
-- the compiler rejects it with IPE-P0063 at canonicalise time.

dangerPath : Path.Path
dangerPath =
    path "safe\0bad"

main =
    Io.println (Path.toString dangerPath)
