module Main exposing (main)

import Sky.Core.Encoding as Encoding

-- Non-ASCII text under Encoding.base64Encode / hexEncode.
--
-- The Sky-Rust runtime models a String-as-bytes ("Bytes = String" surface)
-- using a LATIN-1 char-as-byte convention (codepoint U+00E9 'é' → one byte
-- 0xE9), because Rust's `String` is UTF-8-constrained and the binary pipeline
-- (email attachments, compression, WebSocket frames) must round-trip bytes
-- ≥ 0x80 losslessly. The Go reference's `string` is an arbitrary UTF-8 byte
-- sequence, so it base64/hex-encodes the UTF-8 bytes of 'é' (0xC3 0xA9).
--
-- Hence for non-ASCII text the two byte models differ:
--   hexEncode "café"  → Go "636166c3a9"   vs  Sky-Rust "636166e9"
-- This is a recorded divergence (see docs/architecture/divergence-policy.md).
-- The leading "café" literal anchors the list's element type to String (the
-- current Rust-backend milestone cannot infer a list whose elements are all
-- function returns — SKY-L0102); it also echoes the input next to its encodings.
main =
    let
        b64 = Encoding.base64Encode "café"

        hexed = Encoding.hexEncode "café"
    in
    println (String.join " " [ "café", b64, hexed ])
