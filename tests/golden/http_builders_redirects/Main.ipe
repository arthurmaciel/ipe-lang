module Main exposing (main)

import Ipe.Http as Http
import Ipe.Io as Io
import Ipe.String
import Ipe.Url as Url


-- The three builders on top of the M5b set:
-- Http.withUrl / Http.withFollowRedirects / Http.withMaxRedirects.
-- withFollowRedirects / withMaxRedirects are single-field record updates on
-- HttpRequest; withUrl retargets to a typed Url and re-narrows the scheme to
-- http/https (fail-closed), returning a Result. The chain below overrides
-- every one of the defaultRequest values they own
-- (url "http://example.com" -> "http://example.org",
--  followRedirects True -> False, maxRedirects 10 -> 3).
--
-- Expected output:
--   http://example.org
--   noredirect
--   3


printReq : { body : String, followRedirects : Bool, headers : List ( String, String ), maxRedirects : Int, method : Http.HttpMethod, timeout : Int, url : String } -> String
printReq req =
    String.join "\n"
        [ req.url
        , if req.followRedirects then "redirect" else "noredirect"
        , String.fromInt req.maxRedirects
        ]


main =
    case Http.defaultRequestFromString "http://example.com" of
        Ok req0 ->
            case Url.fromString "http://example.org" of
                Ok target ->
                    case Http.withUrl target req0 of
                        Ok retargeted ->
                            Io.println
                                (printReq
                                    (Http.withMaxRedirects 3
                                        (Http.withFollowRedirects False retargeted)))

                        Err _ ->
                            Io.println "blocked"

                Err _ ->
                    Io.println "unparseable"

        Err _ ->
            Io.println "blocked"
