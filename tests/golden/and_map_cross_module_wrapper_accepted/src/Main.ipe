module Main exposing (main)

import Lib exposing (andMapAlias)
import Ipe.Io as Io
import Ipe.String

incInt : Int -> Int
incInt n =
    n + 1

lenPlus : String -> Int
lenPlus s =
    String.length s + 1

main =
    case andMapAlias (Ok 1) (Ok incInt) of
        Ok n1 ->
            case andMapAlias (Ok "hi") (Ok lenPlus) of
                Ok n2 -> Io.println (String.fromInt (n1 + n2))
                Err _ -> Io.println "err2"

        Err _ ->
            Io.println "err1"
