module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Unsafe
import Ipe.List
import Ipe.String
import Ipe.Task

-- M5b-db golden: SqlDecimal + SqlMoney params in Db.exec + Unsafe.unsafeQuery.
-- Proves both new ctors are reachable end-to-end: canon name table,
-- constrain.rs type schemes, lower.rs emit path, and project.rs
-- into_sql_param dispatch (SqlDecimal/SqlMoney -> SqlParam::Text).

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    Unsafe.unsafeExecRaw txconn
                        "CREATE TABLE prices (label TEXT, amount TEXT, money TEXT)"
                        |> Task.andThen
                            (\_ ->
                                Db.exec txconn
                                    "INSERT INTO prices (label, amount, money) VALUES (?, ?, ?)"
                                    [ SqlString "pi", SqlDecimal "3.14159", SqlMoney "USD 9.99" ]
                            )
                        |> Task.andThen
                            (\_ ->
                    Task.andThen
                        (\rows ->
                            Io.println
                                (String.join "\n"
                                    (List.map
                                        (\row ->
                                            Unsafe.unsafeGetString "label" row
                                                ++ ":"
                                                ++ Unsafe.unsafeGetString "amount" row
                                                ++ ":"
                                                ++ Unsafe.unsafeGetString "money" row
                                        )
                                        rows
                                    )
                                )
                        )
                        (Unsafe.unsafeQuery txconn
                            "SELECT label, amount, money FROM prices"
                            []
                        )
                            )
                )
        )
        (Db.open "sqlite" "sqlite::memory:")
