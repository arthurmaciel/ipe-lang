module Main exposing (main)

import Ipe.Io as Io
import Ipe.List

-- Minimal repro for the `24-tui-kitchen-sink` SEAL violation: `ipec build`
-- exits 0 but the emitted crate fails `cargo build` with two INDEPENDENT
-- E0308 errors, both on the entry-point shape `main = case <Maybe String
-- scrutinee> of Just "literal" -> task; _ -> task`.
--
-- Defect 1 — string-literal ctor-payload sub-pattern: `Just "live"` lowered
-- the nested literal straight to a bare `Pat::Str`, emitted as
-- `IpeMaybe::Just("live")`. Rust cannot match a `&str` literal pattern
-- against an owned `String` ctor field (E0308: expected `String`, found
-- `&str`).
--
-- Defect 2 — entry-point task elision only recognised a FLAT
-- `main = task` body. A `case`-branched body where EVERY arm returns a
-- `Task` left `ipe_main` emitted as returning `IpeResult<E, A>` while the
-- `fn main` epilogue's `block_on(ipe_main())` requires `IpeTask<A>`
-- (E0308: expected `Pin<Box<dyn Future…>>`, found `IpeResult<...>`).
mode : Maybe String
mode =
    Just "live"


main =
    case mode of
        Just "live" ->
            Io.println "live mode"

        _ ->
            Io.println "default mode"
