module Lib2 exposing (insertWidget)

import Lib1


-- Calls `Lib1.exec` with a `List SqlValue` (the typed mixed-param path),
-- cross-module — exercises the wrapper's polymorphic `args` across modules.
insertWidget conn =
    Lib1.exec conn
        "INSERT INTO items (id, name) VALUES (?, ?)"
        [ SqlString "1", SqlString "widget" ]
