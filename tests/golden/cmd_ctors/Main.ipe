module Main exposing (main)
import Ipe.Io as Io
import Ipe.Cmd
import Ipe.Task

-- M5c: Cmd.none / Cmd.batch construct-only gate.
-- Constructs Cmd values and discards them; confirms that Cmd.none infers
-- its msg type from a sibling Cmd.perform in the same batch.

main =
    let
        c = Cmd.perform (Task.succeed 1) (\r -> 0)
        _ = Cmd.batch [c, Cmd.none]
    in
    Io.println "ok"
