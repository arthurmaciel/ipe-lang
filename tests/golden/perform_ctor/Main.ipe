module Main exposing (main)
import Ipe.Io as Io
import Ipe.Cmd
import Ipe.Task

-- M5c: Cmd.perform construct-only gate.
-- Constructs a Cmd.perform value and discards it; confirms type+emit+link
-- soundness for the TEA wiring without a dispatch loop.

main =
    let
        _ = Cmd.perform (Task.succeed 1) (\r -> 0)
    in
    Io.println "ok"
