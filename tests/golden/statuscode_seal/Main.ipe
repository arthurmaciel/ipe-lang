module Main exposing (main)

import Ipe.Http.StatusCode as StatusCode
import Ipe.Io as Io
import Ipe.String as String


-- SEAL: Ipe.Http.StatusCode round-trips + classifiers.
-- Proves the compiled-source module resolves, emits, builds, and runs.


okLine : String
okLine =
    let
        sc =
            StatusCode.fromInt 200
    in
    "code=" ++ String.fromInt (StatusCode.code sc) ++ " ok=" ++ toString (StatusCode.isSuccess sc)


redirectLine : String
redirectLine =
    let
        sc =
            StatusCode.fromInt 301
    in
    "code=" ++ String.fromInt (StatusCode.code sc) ++ " redirect=" ++ toString (StatusCode.isRedirect sc)


clientLine : String
clientLine =
    let
        sc =
            StatusCode.fromInt 404
    in
    "code=" ++ String.fromInt (StatusCode.code sc) ++ " client=" ++ toString (StatusCode.isClientError sc)


serverLine : String
serverLine =
    let
        sc =
            StatusCode.fromInt 500
    in
    "code=" ++ String.fromInt (StatusCode.code sc) ++ " server=" ++ toString (StatusCode.isServerError sc)


-- Classifiers are mutually exclusive: 200 is NOT a redirect/client/server error.
negLine : String
negLine =
    let
        sc =
            StatusCode.fromInt 200
    in
    "neg=" ++ toString (StatusCode.isRedirect sc || StatusCode.isClientError sc || StatusCode.isServerError sc)


main =
    Io.println
        (String.join "\n"
            [ okLine
            , redirectLine
            , clientLine
            , serverLine
            , negLine
            ]
        )
