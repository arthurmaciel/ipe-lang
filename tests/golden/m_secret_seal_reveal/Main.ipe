module Main exposing (main)

-- backlog #44 golden: `Secret.fromString` is the seal; `Secret.reveal` is the
-- single greppable un-parse; `Secret.redacted` is the explicit "<redacted>"
-- accessor. Plaintext-grep-guard (see `golden_secret.rs`): the marker
-- "sk_live_zx9K3_MARKER" appears in THIS SOURCE exactly once (sealed right
-- here) and the compiled binary's stdout is asserted to contain it exactly
-- once too (from the deliberate `Secret.reveal` println below) — proving
-- `Secret.redacted` never echoes it.

secretVal =
    Secret.fromString "sk_live_zx9K3_MARKER"

main =
    let
        _ = println (Secret.redacted secretVal)
    in
    println (Secret.reveal secretVal)
