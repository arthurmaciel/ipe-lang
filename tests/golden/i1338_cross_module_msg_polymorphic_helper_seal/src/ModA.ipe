module ModA exposing (viewA)

import Ipe.Html as Html exposing (Html)
import Lib exposing (sharedRow)


type MsgA
    = ClickA


-- `viewA`'s annotation pins the shared helper's phantom `msg` to `MsgA` at THIS
-- use site.
viewA : Html MsgA
viewA =
    Html.div []
        [ sharedRow
        , Html.text "A"
        ]
