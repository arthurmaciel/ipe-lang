module Main exposing (main)

import Ipe.Io as Io
import Ipe.Task as Task


-- A row-polymorphic function that reads its row field and sequences two
-- effects. The name is read TWICE through `rec.name` (the witness getter):
-- once eagerly into `n1`, once eagerly into `n2` — both reads route through
-- `ipe_name()` in the emitted Rust (no lambda captures the row-poly record).
-- `report` is called at two DIFFERENT shapes so the row variable stays generic.
report : { r | name : String } -> Task Error ()
report rec =
    let
        n1 = rec.name
        n2 = rec.name
    in
    Io.println n1
        |> Task.andThen (\_ -> Io.println n2)


ada : { name : String, age : Int }
ada =
    { name = "Ada", age = 36 }


bo : { name : String, id : Int }
bo =
    { name = "Bo", id = 7 }


main =
    Task.andThen (\_ -> report bo) (report ada)
