module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)

-- #158 residual scope (fail-closed, SKY-L0116): a `case` whose nested-cons arm
-- is exhaustive at the SKY level (`Just (h::t)` + `Just []` cover every `Just`,
-- `Nothing` covers the rest) but has NO trailing wildcard catch-all. The
-- guard-based lowering makes those `Just` arms REFUTABLE to rustc (a guard may
-- fall through), so the emitted `match` would be a rustc non-exhaustive error.
-- Rather than accept-then-cargo-fail, this shape stays fail-closed with a clean
-- diagnostic — the caller adds a `_ ->` fallback (see the accepted repros).
f : Maybe (List Int) -> Int
f m =
    case m of
        Just (h :: t) ->
            h

        Just [] ->
            -1

        Nothing ->
            0


main =
    println (String.fromInt (f (Just [ 1, 2 ])))
