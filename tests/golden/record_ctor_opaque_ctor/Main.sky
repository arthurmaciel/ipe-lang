module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Json.Decode as Decode
import Std.Log exposing (println)


-- ROUND-2 SEAL FAIL-CLOSED (#82). Same opaque-wrapper-field alias as
-- `record_ctor_opaque_field`, but here the alias name is USED as a value
-- constructor (`D Decode.int`). Because synthesis declined (the field is
-- non-derivable as a struct field), no top-level value `D` exists — so this
-- must fail CLOSED at skyc with SKY-N0001 ("cannot find this value in scope"),
-- NEVER skyc-0-then-cargo-fail. This golden asserts the skyc build returns an
-- error and emits nothing.
type alias D =
    { dec : Decoder Int }


value : D
value =
    D Decode.int


main : Task Error ()
main =
    println "ok"
