module Main exposing (main)

import Ipe.Io as Io


type Shape
    = Circle Int
    | Empty


type alias Point =
    { x : Int, y : Int }


point : Point
point =
    { x = 1, y = 2 }


main =
    let
        scalar =
            """{{42}}"""

        record =
            """{{point}}"""

        adtPayload =
            """{{Circle 5}}"""

        adtNullary =
            """{{Empty}}"""
    in
    Io.println (scalar ++ " | " ++ record ++ " | " ++ adtPayload ++ " | " ++ adtNullary)
