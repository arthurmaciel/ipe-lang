module Lib exposing (sharedRow)

import Ipe.Html as Html exposing (Html)


-- Unannotated, message-free view helper exported for reuse by another module.
-- Its phantom `msg` generalizes at the module boundary, so a cross-module use
-- CAN pin it to a concrete `Msg`. Here the sole use renders it directly, pinning
-- nothing -- the discharge outcome is Unpinned, so the `msg` defaults to `()`.
sharedRow =
    Html.div [] [ Html.text "shared" ]
