module Main exposing (main)
import Ipe.Prelude exposing (..)
import Ipe.Io as Io

-- REFUTABLE def-head param `f (Just x) =`: the same rule holds for a function
-- head, not just a lambda — one shared irrefutability gate. IPE-T0015.
f : Maybe Int -> Int
f (Just x) = x

main =
    Io.println (String.fromInt (f (Just 1)))
