module Main exposing (main)
import Ipe.Io as Io
import Ipe.Crypto
import Ipe.Task as Task

-- Crypto.randomBytes: verify the call compiles and the program exits cleanly.
-- The generated bytes are ignored; the effect is sequenced with `Task.andThen`
-- so it still runs, then the program prints "ok".
main =
    Crypto.randomBytes 16
        |> Task.andThen (\_ -> Io.println "ok")
