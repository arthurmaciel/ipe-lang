module Main exposing (main)
import Ipe.Io as Io
import Ipe.Path as Path

-- Positive golden for `path "…"` literal sugar.
-- A compile-time-validated `path "…"` has type `Path` directly —
-- no `Result` unwrapping. `Path.toString` recovers the cleaned string.

configPath : Path.Path
configPath =
    path "src/Main.ipe"

main =
    Io.println (Path.toString configPath)
