module Main exposing (main)

import Ipe.Http as Http exposing (HttpMethod(..))
import Ipe.Io as Io
import Ipe.List
import Ipe.String


-- Http builder chain test: verifies that Http.defaultRequest / Http.withMethod /
-- Http.withTimeout / Http.withHeader / Http.withBody all resolve through the
-- kernel dispatch path and produce a correctly-shaped HttpRequest record.
-- withHeader PREPENDS (latest-added first) — B:2 appears before A:1.
-- `method` is now the `HttpMethod` ADT; `Http.methodToString` converts it to
-- the canonical uppercase string for printing.


headerStr : ( String, String ) -> String
headerStr pair =
    case pair of
        ( k, v ) -> k ++ ":" ++ v


printReq : { body : String, followRedirects : Bool, headers : List ( String, String ), maxRedirects : Int, method : Http.HttpMethod, timeout : Int, url : String } -> String
printReq req =
    String.join "\n" [ Http.methodToString req.method, req.url, String.fromInt req.timeout, req.body, String.join "," (List.map headerStr req.headers) ]


main =
    Io.println
        (printReq
            (Http.withBody "hello"
                (Http.withHeader "B" "2"
                    (Http.withHeader "A" "1"
                        (Http.withTimeout 5000
                            (Http.withMethod Http.Post
                                (Http.defaultRequest "http://example.com")))))))
