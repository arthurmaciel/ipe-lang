module Main exposing (main)

-- Task.fail creates a failed task; Task.onError recovers it with a handler.
-- The lambda `\e -> println "recovered"` names the error parameter `e` but
-- ignores it; `e` is typed `Error` by the kernel's fixed handler signature —
-- the pin that resolved the SKY-L0102 free-variable bug.  Previously this
-- golden used `Task.onError println` to pin `e : String` as a workaround;
-- with the handler-parameter now anchored to `Error`, passing `println`
-- (String -> Task ()) as the handler would cause a String/Error mismatch, so
-- we use a lambda instead.
main =
    Task.onError (\e -> println "recovered") (Task.fail "an error")
