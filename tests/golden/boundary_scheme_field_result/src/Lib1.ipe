module Lib1 exposing (getName)


-- Unannotated top-level getter. `r.name` registers a deferred field-access
-- obligation (`FieldAccess { record, result, .. }`). `getName`'s inferred
-- type is `{ record | name : String } -> String`, but at the point
-- `promote_untyped_boundaries` runs (BEFORE `resolve_deferred`), the
-- access's own `result` var is STILL an unresolved plain-`Flex` root — it
-- only gets pinned to the concrete field type once `resolve_deferred` fires,
-- which happens AFTER generalization. See the class-1 fix spec +
-- BACKLOG.md's "Boundary Scheme Promotion" row for the incident this
-- fixture reproduces (a real SEAL violation: ipe exit-0, `cargo build`
-- fails E0283 on the emitted call site).
getName r =
    r.name
