module Main exposing (main)

import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.Error


main =
    let
        e1 = Error.io "disk full"

        e2 = Error.timeout

        e3 = Error.withMessage "custom message" e1
    in
    case e1 of
        Error kind info ->
            do
                kindName =
                    case kind of
                        Io -> "Io"
                        Network -> "Network"
                        Ffi -> "Ffi"
                        Decode -> "Decode"
                        Timeout -> "Timeout"
                        NotFound -> "NotFound"
                        PermissionDenied -> "PermissionDenied"
                        InvalidInput -> "InvalidInput"
                        Conflict -> "Conflict"
                        Unavailable -> "Unavailable"
                        Unexpected -> "Unexpected"
                Io.println (Error.toString e1)
                Io.println info.message
                Io.println kindName
                Io.println (if Error.isRetryable e1 then "retryable" else "not-retryable")
                Io.println (if Error.isRetryable e2 then "retryable" else "not-retryable")
                Io.println (Error.toString e3)
                Io.println "done"
