module Main exposing (main)

import Ipe.Io as Io
import Ipe.Error
import Ipe.Task as Task


main =
    let
        e1 = Error.io "disk full"

        e2 = Error.timeout

        e3 = Error.withMessage "custom message" e1
    in
    case e1 of
        Error kind info ->
            let
                kindName =
                    case kind of
                        Io -> "Io"
                        Network -> "Network"
                        Ffi -> "Ffi"
                        Decode -> "Decode"
                        Timeout -> "Timeout"
                        NotFound -> "NotFound"
                        PermissionDenied -> "PermissionDenied"
                        InvalidInput -> "InvalidInput"
                        Conflict -> "Conflict"
                        Unavailable -> "Unavailable"
                        Unexpected -> "Unexpected"
            in
            Io.println (Error.toString e1)
                |> Task.andThen (\_ -> Io.println info.message)
                |> Task.andThen (\_ -> Io.println kindName)
                |> Task.andThen (\_ -> Io.println (if Error.isRetryable e1 then "retryable" else "not-retryable"))
                |> Task.andThen (\_ -> Io.println (if Error.isRetryable e2 then "retryable" else "not-retryable"))
                |> Task.andThen (\_ -> Io.println (Error.toString e3))
                |> Task.andThen (\_ -> Io.println "done")
