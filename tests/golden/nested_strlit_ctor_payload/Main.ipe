module Main exposing (main)

import Ipe.Io as Io

-- #158 C2 string-literal ctor-payload desugaring (depth 1, direct arg):
-- `Just "live"` desugars to a fresh `String` binder in that ctor-arg slot plus
-- an arm-level equality guard (`binder == "live"`) — Rust cannot literal-match
-- a `&str` pattern against the owned `String` ctor FIELD directly. Positive
-- control for the depth-2 fail-closed gate in
-- `nested_strlit_two_levels_gated` (same file, adjacent test).
f : Maybe String -> String
f m =
    case m of
        Just "live" ->
            "live"

        _ ->
            "other"


main =
    Io.println (f (Just "live"))
