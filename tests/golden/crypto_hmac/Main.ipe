module Main exposing (main)
import Ipe.Io as Io
import Ipe.Char
import Ipe.Crypto
import Ipe.String

-- HMAC-SHA256 / HMAC-SHA512 — RFC 4231 test case 1.
-- key = 0x0b repeated 20 times (byte value 11 = vertical tab)
-- msg = "Hi There"
-- Two key bindings avoid the Rust move issue (key is consumed by each HMAC call).
main =
    let
        rawKey = String.repeat 20 (String.fromChar (Char.fromCode 11))

        key1 = Crypto.keyFromString rawKey

        key2 = Crypto.keyFromString rawKey
    in
    case key1 of
        Nothing ->
            Io.println "key-parse-failed"

        Just k1 ->
            case key2 of
                Nothing ->
                    Io.println "key-parse-failed"

                Just k2 ->
                    let
                        h256 = Crypto.macToHex (Crypto.hmacSha256WithKey k1 "Hi There")

                        h512 = Crypto.macToHex (Crypto.hmacSha512WithKey k2 "Hi There")
                    in
                    Io.println (String.join " " [ h256, h512 ])
