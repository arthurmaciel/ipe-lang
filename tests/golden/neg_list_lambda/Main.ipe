module Main exposing (main)
import Ipe.Prelude exposing (..)
import Ipe.Io as Io

-- A bracket-list lambda param `\[a] ->` is refutable (fails on `[]` and longer
-- lists). Like `\1 ->`, the parser's param grammar rejects a bare list pattern
-- in binding position, so it fails closed as IPE-P0001 before the IPE-T0015
-- gate. A refutable list param never reaches codegen.
f : List Int -> Int
f = \[a] -> a

main =
    Io.println (String.fromInt (f [ 1 ]))
