module Main exposing (main)

-- Http.parseQuery: first-key-wins, percent-decode, empty-value.
-- Uses Dict.get on specific keys to avoid Dict.toList iteration-order
-- non-determinism between backends (Go/Rust hash maps differ in order).
--
-- Semantics:
--   "a" → "1"          (first-key-wins: "a=1" before "a=ignored")
--   "b" → "two words"  (percent-decode of "two%20words")
--   "c" → ""           (bare key, empty value)
--   "x" → absent       (key not present)
import Ipe.Http as Http
import Ipe.Dict as Dict
import Ipe.Io as Io
import Ipe.Maybe
import Ipe.String


main =
    let
        parsed = Http.parseQuery "a=1&b=two%20words&a=ignored&c"
        aVal = Maybe.withDefault "MISSING" (Dict.get "a" parsed)
        bVal = Maybe.withDefault "MISSING" (Dict.get "b" parsed)
        cVal = Maybe.withDefault "MISSING" (Dict.get "c" parsed)
        xVal = Maybe.withDefault "absent" (Dict.get "x" parsed)
    in
    Io.println (String.join "\n" [ aVal, bVal, cVal, xVal ])
