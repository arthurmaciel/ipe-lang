module Main exposing (main)
import Ipe.Prelude exposing (..)
import Ipe.Io as Io

-- A concrete (non-generic) payload ADT: `Circle` carries one field, `Rect` two.
type Shape = Circle Int | Rect Int Int

area : Shape -> Int
area s =
    case s of
        Circle r -> r * r * 3
        Rect w h -> w * h

main =
    Io.println (String.fromInt (area (Rect 4 5) + area (Circle 2)))
