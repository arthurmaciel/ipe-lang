module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode as JsonDec
import Ipe.Json.Decode.Pipeline as JsonDecP
import Ipe.String

-- R1: `JsonDec.succeed (\name age -> …)` — multi-arg lambda curry.
-- Exercises Fix A case 2 (lambda → curry2).
-- Expected: Alice|30

main =
    let
        r1 =
            JsonDec.decodeString
                (JsonDecP.required "age" JsonDec.int
                    (JsonDecP.required "name" JsonDec.string
                        (JsonDec.succeed
                            (\name age -> name ++ "|" ++ String.fromInt age))))
                "{\"name\":\"Alice\",\"age\":30}"
    in
    case r1 of
        Ok label1 -> Io.println label1
        Err _ -> Io.println "err1"
