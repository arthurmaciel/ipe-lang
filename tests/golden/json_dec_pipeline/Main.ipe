module Main exposing (main)
import Ipe.Io as Io

-- Pipeline-style record decoding using `JsonDec.succeed` + `JsonDecP.required`
-- + `JsonDecP.optional`.
--
-- `makeLabel` is a 3-arg function returning a `String` summary; `succeed
-- makeLabel` lifts it into a `Decoder (String -> Int -> String -> String)`
-- factory via `curry3`.  Each pipeline step threads the accumulator decoder as
-- the last argument (desugared |> form).
--
-- The decoder is inlined at each `decodeString` call; top-level decoder
-- bindings produce an unresolved type variable in the current Rust port (a
-- known limitation of the M4h lowerer that does not affect correctness of the
-- emitted code — only top-level *value* references are affected).
--
-- j1 has no "nickname" field: optional supplies the default "unknown".
-- j2 has "nickname" "Bobby".
--
-- Expected:
--   Alice|30|unknown
--   Bob|25|Bobby
makeLabel : String -> Int -> String -> String
makeLabel name age nick =
    name ++ "|" ++ String.fromInt age ++ "|" ++ nick


main =
    let
        j1 = "{\"name\":\"Alice\",\"age\":30}"

        j2 = "{\"name\":\"Bob\",\"age\":25,\"nickname\":\"Bobby\"}"

        r1 =
            JsonDec.decodeString
                (JsonDecP.optional "nickname" JsonDec.string "unknown"
                    (JsonDecP.required "age" JsonDec.int
                        (JsonDecP.required "name" JsonDec.string
                            (JsonDec.succeed makeLabel)))
                )
                j1

        r2 =
            JsonDec.decodeString
                (JsonDecP.optional "nickname" JsonDec.string "unknown"
                    (JsonDecP.required "age" JsonDec.int
                        (JsonDecP.required "name" JsonDec.string
                            (JsonDec.succeed makeLabel)))
                )
                j2
    in
    case r1 of
        Ok label1 ->
            case r2 of
                Ok label2 ->
                    Io.println (label1 ++ "\n" ++ label2)

                Err _ ->
                    Io.println "err2"

        Err _ ->
            Io.println "err1"
