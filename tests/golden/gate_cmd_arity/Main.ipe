module Main exposing (main)

import Ipe.Io as Io

-- #32 review follow-up: a mis-arity `Cmd` ANNOTATION (`Cmd` takes exactly
-- one message type) used to ICE (IPE-I0001) via ir_type_from_canon's
-- catch-all. It now fails closed with the clean IPE-T0016, symmetric with
-- the Task gate.
f : Cmd Int Bool -> Int
f _ =
    0


main =
    Io.println (String.fromInt (f Cmd.none))
