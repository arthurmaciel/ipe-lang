module Main exposing (main)
import Ipe.Io as Io
import Ipe.Crypto

-- ChaCha20-Poly1305 round-trip: encrypt then decrypt returns original plaintext.
-- Keys are derived via the typed Key-returning derivation function.
-- Nonce is random; only "ok" is tested.
main =
    let
        key1 = Crypto.chachaKeyFromPasswordKey "password" "salt"

        key2 = Crypto.chachaKeyFromPasswordKey "password" "salt"

        result =
            case Crypto.chacha20EncryptKey key1 "hello" of
                Ok ciphertext ->
                    case Crypto.chacha20DecryptKey key2 ciphertext of
                        Ok plaintext ->
                            if plaintext == "hello" then
                                "ok"

                            else
                                "wrong"

                        Err _ ->
                            "decrypt-failed"

                Err _ ->
                    "encrypt-failed"
    in
    Io.println result
