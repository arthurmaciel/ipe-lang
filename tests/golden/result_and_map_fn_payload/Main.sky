module Main exposing (main)
import Sky.Core.Prelude exposing (..)

-- #90 Stage 1: `Ok f` holding a function used to trip IPE-L0114 unconditionally,
-- making `Result.andMap` unusable. The construction is sound: `Ok`/`Err`
-- construct the runtime `SkyResult` enum, whose derives are generic-bounded, so
-- `SkyResult<E, Box<dyn Fn(..)->R>>` compiles regardless of the payload.
main =
    println (String.fromInt (Result.withDefault 0 (Ok (\x -> x + 1) |> Result.andMap (Ok 2))))
