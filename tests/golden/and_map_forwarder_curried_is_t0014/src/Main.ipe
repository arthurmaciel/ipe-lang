module Main exposing (main)

import Lib exposing (andMapAlias)
import Ipe.Io as Io
import Ipe.Math
import Ipe.Result

-- #90 T3, "forwarder" path: `andMapAlias` (a GENERIC, ANNOTATED wrapper
-- around `Result.andMap`) is instantiated at a CURRIED (arity >= 3) payload.
-- Unlike every direct-call fixture in `golden_l0114_ctor_payload_function.rs`
-- (which hit the Tier-2 EAGER-PIN path and surface a plain IPE-T0001), the
-- obligation on `andMapAlias`'s own `b` skolem here is checked through
-- `check_scheme_applications` / `SchemeApp` — the SAME per-external-call-site
-- re-verification `Math.min`'s forwarder gate uses
-- (`crates/ipec/tests/golden_m4c_math_gate.rs`) — producing the FRIENDLY,
-- specifically-labelled `SuperTypeUnsatisfied` (IPE-T0014) diagnostic naming
-- the obligation, not a generic type mismatch.
add3 : Int -> Int -> Int -> Int
add3 a b c =
    a + b + c

main =
    case andMapAlias (Ok 1) (Ok add3) of
        Ok _ -> Io.println "ok"
        Err _ -> Io.println "err"
