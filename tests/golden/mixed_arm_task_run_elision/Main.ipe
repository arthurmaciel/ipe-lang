module Main exposing (main)

import Ipe.Error as Error
import Ipe.String

-- Adversarial-review sibling gap: a `case`-dispatched `ipe_main` where every
-- arm produces a `Result`-typed expression — the realistic validate-then-run
-- idiom where `main` returns `Result Error a`.
--
-- `emit_func`'s `ipe_main_wrap` fallback covers `func.ret == Result(_, A)`:
-- the body evaluates synchronously to a uniform `Result e a` and is wrapped
-- in `task_from_result({ <original body> })` — an ALREADY-RESOLVED
-- `IpeTask<a>` carrying the body's actual computed value, not a discarded one.
validate : Int -> Result Error Int
validate n =
    if n < 0 then
        Err (Error.unexpected "negative input")

    else
        Ok n


main =
    case validate 5 of
        Err e ->
            Err e

        Ok cfg ->
            Ok cfg
