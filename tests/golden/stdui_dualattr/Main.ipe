module Main exposing (main)

import Std.Html as Html
import Std.Ui as Ui
import Std.Ui.Background as Background
import Std.Ui.Font as Font


-- Phase-0 reduced dual-attribute bridge test: mixes Std.Ui.Attribute values
-- (Font.bold, Background.color) with a Std.Html node (Html.div / Html.text)
-- embedded via Ui.html.  Exercises the UiCtor::UiAttribute + UiCtor::Html
-- collision-adjacent path that is buildable in Phase 0 (no event kernels).
-- oracle_divergence = true: Rust backend emits compact inline CSS.


main =
    println
        (Html.htmlRender
            (Ui.layout []
                (Ui.column [ Ui.spacing 8 ]
                    [ Ui.el [ Font.bold, Background.color (Ui.rgb 0 128 0) ] (Ui.text "ui-attr")
                    , Ui.html (Html.div [] [ Html.text "html-node" ])
                    ])))
