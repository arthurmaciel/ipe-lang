module Main exposing (main)
import Ipe.Prelude exposing (..)
import Ipe.Io as Io

-- Forward pipe chain: `|>` left-associative at precedence 0.
-- [1,2,3] |> List.map (+1) |> List.length == 3
main =
    [1, 2, 3]
        |> List.map (\x -> x + 1)
        |> List.length
        |> String.fromInt
        |> Io.println
