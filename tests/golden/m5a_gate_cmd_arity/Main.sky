module Main exposing (main)

import Sky.Core.Prelude exposing (..)

-- #32 review follow-up: a mis-arity `Cmd` ANNOTATION (`Cmd` takes exactly
-- one message type) used to ICE (SKY-I0001) via ir_type_from_canon's
-- catch-all. It now fails closed with the clean SKY-T0016, symmetric with
-- the Task gate.
f : Cmd Int Bool -> Int
f _ =
    0


main =
    println (String.fromInt (f Cmd.none))
