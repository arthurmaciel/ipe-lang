module Dep exposing (Box, mkBox, runBox)

-- A user enum wrapping a `List (Int -> Int)`: the collection element carries its
-- function on the `Clone` `Arc<dyn Fn>` carrier, so the enum is storable and
-- lowers cleanly (no longer IPE-L0114). `runBox` folds the stored functions over
-- a seed to apply them.

import Ipe.List


type Box a
    = Mk a


mkBox : Box (List (Int -> Int))
mkBox =
    Mk [ \n -> n + 1, \n -> n * 2 ]


runBox : Box (List (Int -> Int)) -> Int -> Int
runBox box seed =
    case box of
        Mk fns ->
            List.foldl (\f acc -> f acc) seed fns
