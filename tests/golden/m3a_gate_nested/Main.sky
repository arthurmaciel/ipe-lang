module Main exposing (main)
import Sky.Core.Prelude exposing (..)

-- A nested constructor payload pattern (`Som (Som x)`) — SKY-L0112.
type Opt a = Som a | Non

f : Opt (Opt Int) -> Int
f o =
    case o of
        Som (Som x) -> x
        Som Non -> 0
        Non -> 0

main =
    println (String.fromInt (f Non))
