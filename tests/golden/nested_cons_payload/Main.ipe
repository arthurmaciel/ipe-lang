module Main exposing (main)

import Ipe.Prelude exposing (..)
import Ipe.Io as Io

-- #158 Class-4 item C, Repro 1: a cons sub-pattern nested inside a constructor
-- payload (`Just (h :: t)`). Used to fail-closed with IPE-L0116 because a
-- `Vec<T>` enum FIELD cannot be slice-pattern-matched inline. Now it lowers to
-- a fresh `Vec` binder + an arm-level length guard (`.len() >= 1`), with `h`
-- recovered by indexing and `t` by `List.drop`.
f : Maybe (List Int) -> Int
f m =
    case m of
        Just (h :: t) ->
            h

        _ ->
            0


main =
    Io.println (String.fromInt (f (Just [ 1, 2, 3 ])))
