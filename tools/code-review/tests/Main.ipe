tableExists : Db -> String -> Task.Task Error Bool
tableExists db name =
    Db.findWhere db
        "sqlite_master"
        (Sql.and
            (Sql.eq (Sql.column "type") (Sql.string "table"))
            (Sql.eq (Sql.column "name") (Sql.string name))
        )
        |> Task.map (\rows -> List.length rows == 1)


countReviewRows : Db -> String -> String -> Task.Task Error Int
countReviewRows db uid bodyHash =
    Db.findWhere db
        "review"
        (Sql.and
            (Sql.eq (Sql.column "uid") (Sql.string uid))
            (Sql.eq (Sql.column "body_hash") (Sql.string bodyHash))
        )
        |> Task.map List.length


expectErr : Task.Task Error Int -> Task.Task Error Bool
expectErr t =
    t
        |> Task.map (\_ -> False)
        |> Task.onError (\_ -> Task.succeed True)


bothTablesExist : Db -> Task.Task Error Bool
bothTablesExist db =
    Task.map2
        (\a b -> a && b)
        (tableExists db "review")
        (tableExists db "drain_cursor")


idempotent : Db -> Task.Task Error Bool
idempotent db =
    LibDb.migrate db
        |> Task.andThen (\_ -> tableExists db "review")


duplicateInsertIsNoop : Db -> Task.Task Error Bool
duplicateInsertIsNoop db =
    LibDb.insertDecision db "dup-uid" "h1" Approved
        |> Task.andThen
            (\_ ->
                LibDb.insertDecision db "dup-uid" "h1" (Refused "changed")
            )
        |> Task.andThen (\_ -> countReviewRows db "dup-uid" "h1")
        |> Task.andThen
            (\n ->
                LibDb.findDecision db "dup-uid" "h1"
                    |> Task.map (\m -> n == 1 && isApproved m)
            )


-- Re-reviewing the same pair must succeed (any Err here fails
-- the check loudly) and must keep the first decision.
isApproved : Maybe Decision -> Bool
isApproved m =
    case m of
        Nothing ->
            False

        Just d ->
            case d of
                Approved ->
                    True

                Refused _ ->
                    False


refuseWithoutReasonRejected : Db -> Task.Task Error Bool
refuseWithoutReasonRejected db =
    LibDb.insertDecision db "bad-uid" "h2" (Refused "")
        |> expectErr
        |> Task.andThen
            (\emptyRejected ->
                LibDb.insertDecision db "bad-uid" "h3" (Refused "   ")
                    |> expectErr
                    |> Task.andThen
                        (\blankRejected ->
                            Task.map2
                                (\n2 n3 -> emptyRejected && blankRejected && n2 == 0 && n3 == 0)
                                (countReviewRows db "bad-uid" "h2")
                                (countReviewRows db "bad-uid" "h3")
                        )
            )


checkPair : Maybe Decision -> Maybe Decision -> Bool
checkPair approved refused =
    case approved of
        Nothing ->
            False

        Just Approved ->
            case refused of
                Nothing ->
                    False

                Just d ->
                    matchRefused d

        Just (Refused _) ->
            False


matchRefused : Decision -> Bool
matchRefused d =
    case d of
        Approved ->
            False

        Refused reason ->
            reason == "too big"


decisionRoundtrip : Db -> Task.Task Error Bool
decisionRoundtrip db =
    LibDb.insertDecision db "rt-uid" "h3" Approved
        |> Task.andThen (\_ -> LibDb.insertDecision db "rt-uid" "h4" (Refused "too big"))
        |> Task.andThen
            (\_ ->
                Task.map2 checkPair
                    (LibDb.findDecision db "rt-uid" "h3")
                    (LibDb.findDecision db "rt-uid" "h4")
            )


allChecks : Db -> Task.Task Error (List ( String, Bool ))
allChecks db =
    Task.sequence
        [ Task.map (\ok -> ( "0001+0002 create tables", ok )) (bothTablesExist db)
        , Task.map (\ok -> ( "re-migrate idempotent", ok )) (idempotent db)
        , Task.map (\ok -> ( "duplicate (uid,body_hash) no-op", ok )) (duplicateInsertIsNoop db)
        , Task.map (\ok -> ( "refuse without reason rejected", ok )) (refuseWithoutReasonRejected db)
        , Task.map (\ok -> ( "decision roundtrip", ok )) (decisionRoundtrip db)
        , Task.succeed
            ( "formatReviewedAt renders UTC"
            , Format.formatReviewedAt (Timestamp.fromUnixMillis 0)
                == "1970-01-01 00:00:00"
                && Format.formatReviewedAt (Timestamp.fromUnixMillis 1700000000000)
                == "2023-11-14 22:13:20"
            )
        , Task.succeed ( "db file paths escape url specials", filePathsEncodeUrlSpecials )
        , Task.succeed
            ( "numberedLines counts from line_start"
            , Format.numberedLines 10 "a\nb\nc"
                == [ ( 10, "a" ), ( 11, "b" ), ( 12, "c" ) ]
            )
        , Task.succeed
            ( "highlight: rust keywords vs identifiers"
            , List.any (isKeyword "fn") (Highlight.tokenize Highlight.Rust "fn answer() -> i32 { 42 }")
                && List.any (isIdent "answer") (Highlight.tokenize Highlight.Rust "fn answer() -> i32 { 42 }")
                && List.any (isNum "42") (Highlight.tokenize Highlight.Rust "fn answer() -> i32 { 42 }")
                && List.any (isStr "\"hi\"") (Highlight.tokenize Highlight.Rust "let s = \"hi\";")
                && List.any (isComment "// note") (Highlight.tokenize Highlight.Rust "// note\nfn f() {}")
            )
        , Task.succeed
            ( "highlight: shell tokenizes"
            , List.any (isKeyword "echo") (Highlight.tokenize Highlight.Shell "echo hi")
                && List.any (isIdent "hi") (Highlight.tokenize Highlight.Shell "echo hi")
                && isShell (Highlight.langFor "sh")
            )
        , Task.succeed
            ( "highlight: malformed degrades to plain"
            , List.any (isPlain "\"unterminated") (Highlight.tokenize Highlight.Rust "\"unterminated")
                && List.any (isPlain "/* open") (Highlight.tokenize Highlight.Rust "/* open")
                && List.any (isPlain "any old text") (Highlight.tokenize Highlight.Unknown "any old text")
                && isUnknown (Highlight.langFor "weird")
            )
        , Task.succeed
            ( "percent: decided over queued"
            , Format.percent 3 4
                == "75%"
                && Format.percent 0 4
                == "0%"
                && Format.percent 4 4
                == "100%"
                && Format.percent 5 4
                == "125%"
                && Format.percent 0 0
                == "0%"
            )
        ]


isKeyword : String -> Token -> Bool
isKeyword kw tok =
    case tok of
        Keyword k ->
            k == kw

        Str _ ->
            False

        Comment _ ->
            False

        Num _ ->
            False

        Ident _ ->
            False

        Plain _ ->
            False


isIdent : String -> Token -> Bool
isIdent s tok =
    case tok of
        Ident t ->
            t == s

        Keyword _ ->
            False

        Str _ ->
            False

        Comment _ ->
            False

        Num _ ->
            False

        Plain _ ->
            False


isNum : String -> Token -> Bool
isNum s tok =
    case tok of
        Num t ->
            t == s

        Keyword _ ->
            False

        Str _ ->
            False

        Comment _ ->
            False

        Ident _ ->
            False

        Plain _ ->
            False


isStr : String -> Token -> Bool
isStr s tok =
    case tok of
        Str t ->
            t == s

        Keyword _ ->
            False

        Comment _ ->
            False

        Num _ ->
            False

        Ident _ ->
            False

        Plain _ ->
            False


isComment : String -> Token -> Bool
isComment s tok =
    case tok of
        Comment t ->
            t == s

        Keyword _ ->
            False

        Str _ ->
            False

        Num _ ->
            False

        Ident _ ->
            False

        Plain _ ->
            False


isPlain : String -> Token -> Bool
isPlain s tok =
    case tok of
        Plain t ->
            t == s

        Keyword _ ->
            False

        Str _ ->
            False

        Comment _ ->
            False

        Num _ ->
            False

        Ident _ ->
            False


isShell : Lang -> Bool
isShell lang =
    case lang of
        Shell ->
            True

        Rust ->
            False

        Ipe ->
            False

        Unknown ->
            False


isUnknown : Lang -> Bool
isUnknown lang =
    case lang of
        Unknown ->
            True

        Rust ->
            False

        Shell ->
            False

        Ipe ->
            False


-- ── ipe-index bridge ───────────────────────────────────────────────────
--
-- Seeds a scratch ipe-index database (units + change_queue) plus two source
-- files, then loads the first queue page and checks the loaded
-- units' metadata and source slices.
indexBridge : Task.Task Error Bool
indexBridge =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-b3-test"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"
    in
    Task.fromResult (Path.fromString indexDb)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> seedIndex indexDb repo)
        |> Task.andThen (\_ -> loadFirstPage |> Task.map (\r -> checkUnits r.total r.units))
        |> Task.andThen (\ok -> cleanupIndex indexDb repo |> Task.map (\_ -> ok))


seedIndex : String -> String -> Task.Task Error ()
seedIndex indexDb repo =
    Task.fromResult (Path.fromString (repo ++ "/src"))
        |> Task.andThen File.mkdirAll
        |> Task.andThen
            (\_ ->
                Task.map2
                    (\_ _ -> ())
                    (writeFileText (repo ++ "/src/Lib.rs") fixtureLibRs)
                    (writeFileText (repo ++ "/src/Main.ipe") fixtureMainIpe)
            )
        |> Task.andThen (\_ -> seedIndexDb indexDb)
        |> Task.andThen (\_ -> setIndexEnv indexDb repo)


writeFileText : String -> String -> Task.Task Error ()
writeFileText path text =
    Task.fromResult (Path.fromString path)
        |> Task.andThen (\p -> File.writeFile p text)


fixtureLibRs : String
fixtureLibRs =
    "// fixture library\n\npub fn answer() -> i32 {\n    // the answer to everything\n    42\n}\n\npub fn other() -> i32 {\n    7\n}\n"


fixtureMainIpe : String
fixtureMainIpe =
    "module Main exposing (main)\n\nmain = ()\n"


-- Lines 3..6 of `fixtureLibRs`, the source unit `u-a` attests.
viewA : String
viewA =
    "pub fn answer() -> i32 {\n    // the answer to everything\n    42\n}"


-- Lines 1..2 of `fixtureMainIpe`, the source unit `u-b` attests.
viewB : String
viewB =
    "module Main exposing (main)\n"


-- A source view's state as one comparable word; `Unreadable` carries the
-- rendered error so a test can check what it names.
viewTag : Index.SourceView -> String
viewTag view =
    case view of
        Shown _ ->
            "shown"

        Stale Drifted ->
            "drifted"

        Stale (RangeOutOfFile r) ->
            "range " ++ String.fromInt r.lineCount

        Stale UnverifiableHash ->
            "unverifiable"

        Unreadable e ->
            "unreadable: " ++ Error.toString e


shownTextOf : Index.SourceView -> Maybe String
shownTextOf view =
    case view of
        Shown shown ->
            Just (Index.shownText shown)

        Stale _ ->
            Nothing

        Unreadable _ ->
            Nothing


unitViewTag : String -> List Index.Unit -> String
unitViewTag uid units =
    case List.find (\u -> u.uid == uid) units of
        Just u ->
            viewTag u.view

        Nothing ->
            "absent"


-- Runs one statement against a seeded scratch index database.
execIndex : String -> String -> List SqlValue -> Task.Task Error ()
execIndex indexDb sql params =
    do
        conn <- Db.open "sqlite" ("sqlite://" ++ indexDb ++ "?mode=rw")
        Db.exec conn sql params
        Task.succeed ()


-- ── source attestation ──────────────────────────────────────────────────
--
-- A unit's source is shown only when its lines re-hash to the stored
-- attestation; every other state withholds it, per unit, without failing the
-- page.
type alias Scratch =
    { repo : String, indexDb : String, reviewDb : String }


scratchAt : String -> Scratch
scratchAt name =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/" ++ name
    in
    { repo = base ++ "/repo", indexDb = base ++ "/index.db", reviewDb = base ++ "/review.db" }


-- Seeds the bridge fixture at `name`, runs `mutate`, loads the first page and
-- returns the view tag of each queued unit as `uid=tag`.
viewTagsAfter : String -> (Scratch -> Task.Task Error ()) -> Task.Task Error (List String)
viewTagsAfter name mutate =
    let
        at =
            scratchAt name
    in
    do
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        mutate at
        r <- loadFirstPage
        cleanupIndex at.indexDb at.repo
        Task.succeed (List.map (\u -> u.uid ++ "=" ++ viewTag u.view) r.units)


-- ── decisions on attested bytes ─────────────────────────────────────────
--
-- A decision is written only through `Queue.decide`, which re-proves the shown
-- source against the current index row and file. Each case seeds the bridge
-- fixture, runs `prepare`, loads the page, runs `mutate`, decides `u-a` and
-- reports whether the decision failed as a conflict and how many review rows
-- `u-a` holds afterwards.
decideAfter : String -> (Scratch -> Task.Task Error ()) -> (Scratch -> Task.Task Error ()) -> Decision -> Task.Task Error { conflict : Bool, rows : Int }
decideAfter name prepare mutate decision =
    let
        at =
            scratchAt name
    in
    do
        removeFileIfAny at.indexDb
        removeFileIfAny at.reviewDb
        seedIndex at.indexDb at.repo
        prepare at
        r <- loadFirstPage
        mutate at
        db <- openReviewAt at.reviewDb
        migrated <- LibDb.migrate db
        conflict <- decideOutcome db (List.find (\u -> u.uid == "u-a") r.units) decision
        rows <- countUidRows db "u-a"
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed { conflict = conflict, rows = rows }


-- True when deciding `found` fails with a conflict; False when it succeeds,
-- fails otherwise, or the unit was not loaded.
decideOutcome : Db -> Maybe Index.Unit -> Decision -> Task.Task Error Bool
decideOutcome db found decision =
    case found of
        Just unit ->
            Queue.decide db unit decision
                |> Task.map (\_ -> False)
                |> Task.onError (\e -> Task.succeed (Error.kind e == Error.kind (Error.conflict "")))

        Nothing ->
            Task.succeed False


countUidRows : Db -> String -> Task.Task Error Int
countUidRows db uid =
    Db.findWhere db "review" (Sql.eq (Sql.column "uid") (Sql.string uid))
        |> Task.map List.length


noChange : Scratch -> Task.Task Error ()
noChange _ =
    Task.succeed ()


driftLib : Scratch -> Task.Task Error ()
driftLib at =
    writeFileText (at.repo ++ "/src/Lib.rs") ("// inserted above\n" ++ fixtureLibRs)


-- The control: an unchanged shown unit is decided under its attested hash.
decideRecordsShownHash : Task.Task Error Bool
decideRecordsShownHash =
    let
        at =
            scratchAt "ipe-index-decide-ok"
    in
    do
        removeFileIfAny at.indexDb
        removeFileIfAny at.reviewDb
        seedIndex at.indexDb at.repo
        r <- loadFirstPage
        db <- openReviewAt at.reviewDb
        migrated <- LibDb.migrate db
        recorded <-
            case List.find (\u -> u.uid == "u-a") r.units of
                Just unit ->
                    Queue.decide db unit Approved
                        |> Task.map (\( a, n ) -> n == 1 && Index.attestedUid a == "u-a" && Index.attestedHash a == Index.attest viewA)

                Nothing ->
                    Task.succeed False
        rows <- countReviewRows db "u-a" (Index.attest viewA)
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed (recorded && rows == 1)


-- R4: the file drifts after the page showed it. Red if `reverify` is removed
-- from `decide` (the shown hash would be written).
approveRefusedAfterDrift : Task.Task Error Bool
approveRefusedAfterDrift =
    decideAfter "ipe-index-decide-drift" noChange driftLib Approved
        |> Task.map (\o -> o.conflict && o.rows == 0)


-- R5: a re-index after the page loaded: the file and the stored hash move
-- together to new content, so the fresh row verifies on its own. Red if the
-- fresh hash is not compared with the shown hash.
approveRefusedAfterReindex : Task.Task Error Bool
approveRefusedAfterReindex =
    let
        reindex at =
            Task.map2 (\_ _ -> ())
                (writeFileText (at.repo ++ "/src/Lib.rs") (String.replace "42" "43" fixtureLibRs))
                (execIndex at.indexDb "UPDATE units SET body_hash = ? WHERE uid = ?" [ SqlString (Index.attest (String.replace "42" "43" viewA)), SqlString "u-a" ])
    in
    decideAfter "ipe-index-decide-reindex" noChange reindex Approved
        |> Task.map (\o -> o.conflict && o.rows == 0)


-- R6: the unit's row is gone from the index after the page loaded.
approveRefusedAfterUnitDeleted : Task.Task Error Bool
approveRefusedAfterUnitDeleted =
    decideAfter "ipe-index-decide-deleted"
        noChange
        (\at -> execIndex at.indexDb "DELETE FROM units WHERE uid = ?" [ SqlString "u-a" ])
        (Refused "x")
        |> Task.map (\o -> o.conflict && o.rows == 0)


-- R7: a unit loaded stale is refused by `decide` itself, for a refusal as
-- well as an approval.
staleRefuseAlsoRefused : Task.Task Error Bool
staleRefuseAlsoRefused =
    decideAfter "ipe-index-decide-stale" driftLib noChange (Refused "x")
        |> Task.map (\o -> o.conflict && o.rows == 0)


-- True for an `Unreadable` view tag whose rendered error contains `needle`.
unreadableNaming : String -> String -> Bool
unreadableNaming needle tag =
    String.startsWith "unreadable: " tag && String.contains needle tag


-- R1: one line inserted above the unit moves its bytes; the stored hash no
-- longer matches. Red if the hash comparison is removed (the view is shown).
driftedSourceNotShown : Task.Task Error Bool
driftedSourceNotShown =
    viewTagsAfter "ipe-index-attest-drift"
        (\at -> writeFileText (at.repo ++ "/src/Lib.rs") ("// inserted above\n" ++ fixtureLibRs))
        |> Task.map (\tags -> List.member "u-a=drifted" tags && List.member "u-b=shown" tags)


-- R2: a span one line past the 10-line file, stored with the hash of the
-- clamped slice so only the range check can refuse it. Red if the range check
-- is removed or clamping comes back.
rangePastFileIsStale : Task.Task Error Bool
rangePastFileIsStale =
    viewTagsAfter "ipe-index-attest-range"
        (\at ->
            execIndex at.indexDb
                "UPDATE units SET line_start = ?, line_end = ?, body_hash = ? WHERE uid = ?"
                [ SqlInt 9, SqlInt 11, SqlString (Index.attest "    7\n}"), SqlString "u-a" ]
        )
        |> Task.map (\tags -> List.member "u-a=range 10" tags)


-- R3: a stored value with no exact `sha256:` prefix is never re-proved, even
-- when it is the right digest. Red if the scheme parse is removed (each
-- value would read as drifted).
legacyHashUnverifiable : Task.Task Error Bool
legacyHashUnverifiable =
    [ Crypto.sha256 viewA
    , "SHA256:" ++ Crypto.sha256 viewA
    , "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"
    ]
        |> List.map
            (\stored ->
                viewTagsAfter "ipe-index-attest-legacy"
                    (\at -> execIndex at.indexDb "UPDATE units SET body_hash = ? WHERE uid = ?" [ SqlString stored, SqlString "u-a" ])
                    |> Task.map (\tags -> List.member "u-a=unverifiable" tags)
            )
        |> Task.sequence
        |> Task.map (List.all identity)


-- R8: one queued unit's file is gone; that unit alone is unreadable, naming
-- its stored path, and the page still loads. Red if the per-unit error
-- capture is removed (the whole page fails).
oneMissingFileIsolated : Task.Task Error Bool
oneMissingFileIsolated =
    viewTagsAfter "ipe-index-attest-missing"
        (\at -> removeFileIfAny (at.repo ++ "/src/Main.ipe"))
        |> Task.map
            (\tags ->
                List.member "u-a=shown" tags
                    && List.any (\t -> String.startsWith "u-b=unreadable: " t && String.contains "ipe:src/Main.ipe" t) tags
            )


unitsDdl : String
unitsDdl =
    "CREATE TABLE units (uid TEXT PRIMARY KEY, path TEXT NOT NULL, kind TEXT NOT NULL, name TEXT NOT NULL, qualified TEXT NOT NULL, line_start INTEGER NOT NULL, line_end INTEGER NOT NULL, facing TEXT NOT NULL, purpose TEXT, body_hash TEXT NOT NULL, updated_sha TEXT NOT NULL)"


queueDdl : String
queueDdl =
    "CREATE TABLE change_queue (uid TEXT PRIMARY KEY, change TEXT NOT NULL, old_hash TEXT, new_hash TEXT, enqueued_sha TEXT NOT NULL, enqueued_at INTEGER NOT NULL)"


seedIndexDb : String -> Task.Task Error ()
seedIndexDb indexDb =
    Db.open "sqlite" ("sqlite://" ++ indexDb ++ "?mode=rwc")
        |> Task.andThen
            (\conn ->
                Db.exec conn unitsDdl []
                    |> Task.andThen (\_ -> Db.exec conn queueDdl [])
                    |> Task.andThen (\_ -> insertUnitRows conn)
            )
        |> Task.map (\_ -> ())


insertUnitRows : Db -> Task.Task Error Int
insertUnitRows conn =
    Db.exec conn
        "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
        [ SqlString "u-a"
        , SqlString "ipe:src/Lib.rs"
        , SqlString "fn"
        , SqlString "answer"
        , SqlString "Lib.answer"
        , SqlInt 3
        , SqlInt 6
        , SqlString "internal"
        , SqlString "purpose-A"
        , SqlString (Index.attest viewA)
        , SqlString "shaA"
        ]
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
                    [ SqlString "u-b"
                    , SqlString "ipe:src/Main.ipe"
                    , SqlString "module"
                    , SqlString "Main"
                    , SqlString "Main"
                    , SqlInt 1
                    , SqlInt 2
                    , SqlString "user"
                    , SqlNull (SqlString "")
                    , SqlString (Index.attest viewB)
                    , SqlString "shaB"
                    ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
                    [ SqlString "u-del"
                    , SqlString "ipe:src/Gone.ipe"
                    , SqlString "module"
                    , SqlString "Gone"
                    , SqlString "Gone"
                    , SqlInt 1
                    , SqlInt 1
                    , SqlString "user"
                    , SqlNull (SqlString "")
                    , SqlString "hashC"
                    , SqlString "shaC"
                    ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                    [ SqlString "u-a", SqlString "new", SqlNull (SqlString ""), SqlNull (SqlString ""), SqlString "shaA", SqlInt 1 ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                    [ SqlString "u-b", SqlString "modified", SqlString "oldB", SqlString (Index.attest viewB), SqlString "shaB", SqlInt 2 ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                    [ SqlString "u-del", SqlString "deleted", SqlString "hashC", SqlNull (SqlString ""), SqlString "shaC", SqlInt 3 ]
            )


setIndexEnv : String -> String -> Task.Task Error ()
setIndexEnv indexDb repo =
    System.setenv "IPE_INDEX_DB" indexDb
        |> Task.andThen (\_ -> System.setenv "IPE_INDEX_ROOT" repo)


-- The first queue page's units with the whole queue's count.
loadFirstPage : Task.Task Error { units : List Index.Unit, total : Int }
loadFirstPage =
    do
        rows <- Index.loadPendingPage Index.Start
        total <- Index.countPending
        Task.succeed { units = List.map (\r -> r.unit) rows, total = total }


checkUnits : Int -> List Index.Unit -> Bool
checkUnits total units =
    if total /= 2 || List.length units /= 2 then
        False

    else
        case List.head units of
            Nothing ->
                False

            Just a ->
                case listSecond units of
                    Nothing ->
                        False

                    Just b ->
                        isUnitA a && isUnitB b


listSecond : List a -> Maybe a
listSecond items =
    case items of
        _ :: rest ->
            List.head rest

        [] ->
            Nothing


isUnitA : Index.Unit -> Bool
isUnitA u =
    u.uid
        == "u-a"
        && u.change
        == "new"
        && u.oldHash
        == Nothing
        && u.newHash
        == Nothing
        && u.path
        == "ipe:src/Lib.rs"
        && u.name
        == "answer"
        && u.qualified
        == "Lib.answer"
        && u.kind
        == "fn"
        && u.lineStart
        == 3
        && u.lineEnd
        == 6
        && u.facing
        == "internal"
        && u.purpose
        == Just "purpose-A"
        && Index.storedHash u.attested
        == Index.attest viewA
        && u.updatedSha
        == "shaA"
        && shownTextOf u.view
        == Just viewA


isUnitB : Index.Unit -> Bool
isUnitB u =
    u.uid
        == "u-b"
        && u.change
        == "modified"
        && u.newHash
        == Just (Index.attest viewB)
        && u.path
        == "ipe:src/Main.ipe"
        && u.kind
        == "module"
        && u.facing
        == "user"
        && u.purpose
        == Nothing
        && shownTextOf u.view
        == Just viewB


cleanupIndex : String -> String -> Task.Task Error ()
cleanupIndex indexDb repo =
    Task.sequence
        [ removeFileIfAny indexDb
        , removeFileIfAny (indexDb ++ "-wal")
        , removeFileIfAny (indexDb ++ "-shm")
        , removeFileIfAny (repo ++ "/src/Lib.rs")
        , removeFileIfAny (repo ++ "/src/Main.ipe")
        ]
        |> Task.map (\_ -> ())


removeFileIfAny : String -> Task.Task Error ()
removeFileIfAny path =
    Task.fromResult (Path.fromString path)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())


-- ── bounded queue pages ─────────────────────────────────────────────────
--
-- One page holds at most `Index.pageSize` units while `total` counts the
-- whole queue; the page cursor walks every queued unit exactly once, ties on
-- `enqueued_at` included, and the last page has no next cursor.
pagesCoverQueueOnce : Task.Task Error Bool
pagesCoverQueueOnce =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-queue-pages"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"

        reviewDb =
            base ++ "/review.db"

        seeded =
            Index.pageSize + 7
    in
    do
        removePageFixture indexDb reviewDb repo
        Task.fromResult (Path.fromString (repo ++ "/src")) |> Task.andThen File.mkdirAll
        writeFileText (repo ++ "/src/Main.ipe") fixtureMainIpe
        seedManyUnits indexDb seeded
        setIndexEnv indexDb repo
        System.setenv "IPE_REVIEW_DB" reviewDb
        first <- Queue.loadPage Index.Start
        second <-
            case first.next of
                Just cursor ->
                    Queue.loadPage cursor

                Nothing ->
                    Task.fail (Error.unexpected "a full first page has no next cursor")
        removePageFixture indexDb reviewDb repo
        Task.succeed
            (List.length first.units
                == Index.pageSize
                && first.total
                == seeded
                && List.length second.units
                == 7
                && isLastPage second.next
                && distinctUids (first.units ++ second.units)
                == seeded
            )


isLastPage : Maybe Index.Cursor -> Bool
isLastPage next =
    case next of
        Just _ ->
            False

        Nothing ->
            True


distinctUids : List Queue.QueuedUnit -> Int
distinctUids units =
    units
        |> List.map (\q -> ( q.unit.uid, () ))
        |> Dict.fromList
        |> Dict.size


-- A `deleted` change_queue row is neither listed nor counted.
deletedRowsNotQueued : Task.Task Error Bool
deletedRowsNotQueued =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-queue-deleted"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"

        reviewDb =
            base ++ "/review.db"
    in
    do
        removePageFixture indexDb reviewDb repo
        Task.fromResult (Path.fromString (repo ++ "/src")) |> Task.andThen File.mkdirAll
        writeFileText (repo ++ "/src/Main.ipe") fixtureMainIpe
        seedManyUnits indexDb 3
        conn <- Db.open "sqlite" ("sqlite://" ++ indexDb ++ "?mode=rwc")
        Db.exec conn "UPDATE change_queue SET change = 'deleted' WHERE uid = ?" [ SqlString "u-page-2" ]
        setIndexEnv indexDb repo
        r <- loadFirstPage
        removePageFixture indexDb reviewDb repo
        Task.succeed (r.total == 2 && List.map (\u -> u.uid) r.units == [ "u-page-1", "u-page-3" ])


-- The size of a seeded index database is positive; a queue load against a
-- missing index database is `Failed`, never an empty `Loaded`.
dbSizeAndMissingDb : Task.Task Error Bool
dbSizeAndMissingDb =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-queue-size"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"

        reviewDb =
            base ++ "/review.db"
    in
    do
        removePageFixture indexDb reviewDb repo
        Task.fromResult (Path.fromString (repo ++ "/src")) |> Task.andThen File.mkdirAll
        writeFileText (repo ++ "/src/Main.ipe") fixtureMainIpe
        seedManyUnits indexDb 1
        setIndexEnv indexDb repo
        System.setenv "IPE_REVIEW_DB" reviewDb
        bytes <- Index.dbBytes
        setIndexEnv (base ++ "/missing.db") repo
        result <-
            Queue.loadPage Index.Start
                |> Task.map Ok
                |> Task.onError (\e -> Task.succeed (Err e))
        removePageFixture indexDb reviewDb repo
        Task.succeed (bytes > 0 && isFailed (Queue.stateFromResult result))


isFailed : Queue.QueueState -> Bool
isFailed state =
    case state of
        Failed _ ->
            True

        Loading ->
            False

        Loaded _ ->
            False


removePageFixture : String -> String -> String -> Task.Task Error ()
removePageFixture indexDb reviewDb repo =
    Task.sequence
        [ removeFileIfAny indexDb
        , removeFileIfAny (indexDb ++ "-wal")
        , removeFileIfAny (indexDb ++ "-shm")
        , removeFileIfAny reviewDb
        , removeFileIfAny (reviewDb ++ "-wal")
        , removeFileIfAny (reviewDb ++ "-shm")
        , removeFileIfAny (repo ++ "/src/Main.ipe")
        ]
        |> Task.map (\_ -> ())


-- Seeds `n` queued units, all `new`, all pointing at the same fixture file.
-- The last rows share one `enqueued_at` across the first page's end, so only
-- the `uid` tiebreak orders them.
seedManyUnits : String -> Int -> Task.Task Error ()
seedManyUnits indexDb n =
    Db.open "sqlite" ("sqlite://" ++ indexDb ++ "?mode=rwc")
        |> Task.andThen
            (\conn ->
                Db.exec conn unitsDdl []
                    |> Task.andThen (\_ -> Db.exec conn queueDdl [])
                    |> Task.andThen
                        (\_ ->
                            List.range 1 n
                                |> List.map (seedOneUnit conn)
                                |> Task.sequence
                        )
            )
        |> Task.map (\_ -> ())


tiedEnqueuedAt : Int -> Int
tiedEnqueuedAt i =
    if i > Index.pageSize - 5 then
        Index.pageSize - 5

    else
        i


seedOneUnit : Db -> Int -> Task.Task Error ()
seedOneUnit conn i =
    let
        uid =
            "u-page-" ++ String.fromInt i

        hash =
            "hash-" ++ String.fromInt i

        sha =
            "sha-" ++ String.fromInt i
    in
    Db.exec conn
        "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
        [ SqlString uid
        , SqlString "ipe:src/Main.ipe"
        , SqlString "module"
        , SqlString "Main"
        , SqlString "Main"
        , SqlInt 1
        , SqlInt 1
        , SqlString "internal"
        , SqlNull (SqlString "")
        , SqlString hash
        , SqlString sha
        ]
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                    [ SqlString uid, SqlString "new", SqlNull (SqlString ""), SqlNull (SqlString ""), SqlString sha, SqlInt (tiedEnqueuedAt i) ]
            )
        |> Task.map (\_ -> ())


-- ── guard the path resolver ─────────────────────────────────────────────
--
-- A queued unit whose stored path escapes the index root (mid-path `..`
-- segment) is unreadable, naming the stored path, and no file outside the
-- root is read; the page itself still loads.
traversalPathsRejected : Task.Task Error Bool
traversalPathsRejected =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-b3-traversal"
    in
    Task.fromResult (Path.fromString (base ++ "/index.db"))
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString base) |> Task.andThen File.mkdirAll)
        |> Task.andThen (\_ -> seedTraversalDb base)
        |> Task.andThen (\_ -> loadFirstPage)
        |> Task.map
            (\r ->
                let
                    tag =
                        unitViewTag "u-esc" r.units
                in
                String.startsWith "unreadable: " tag
                    && String.contains "escapes its root via `..`" tag
                    && String.contains "ipe:a/../../escape" tag
            )
        |> Task.andThen (\ok -> removeFileIfAny (base ++ "/index.db") |> Task.map (\_ -> ok))


seedTraversalDb : String -> Task.Task Error ()
seedTraversalDb base =
    Db.open "sqlite" ("sqlite://" ++ base ++ "/index.db?mode=rwc")
        |> Task.andThen
            (\conn ->
                Db.exec conn unitsDdl []
                    |> Task.andThen (\_ -> Db.exec conn queueDdl [])
                    |> Task.andThen
                        (\_ ->
                            Db.exec conn
                                "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
                                [ SqlString "u-esc"
                                , SqlString "ipe:a/../../escape"
                                , SqlString "fn"
                                , SqlString "x"
                                , SqlString "x"
                                , SqlInt 1
                                , SqlInt 1
                                , SqlString "user"
                                , SqlNull (SqlString "")
                                , SqlString (Index.attest "x")
                                , SqlString "s"
                                ]
                        )
                    |> Task.andThen
                        (\_ ->
                            Db.exec conn
                                "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                                [ SqlString "u-esc", SqlString "new", SqlNull (SqlString ""), SqlNull (SqlString ""), SqlString "s", SqlInt 1 ]
                        )
            )
        |> Task.andThen (\_ -> System.setenv "IPE_INDEX_DB" (base ++ "/index.db"))
        |> Task.andThen (\_ -> System.setenv "IPE_INDEX_ROOT" base)
        |> Task.map (\_ -> ())


-- ── typed root and stored-path join ──────────────────────────────────────────
--
-- `RepoPath.resolve` refuses every stored path that is not a relative path
-- strictly below the root, and `parseRoot` accepts a working-directory-relative
-- root (leading `..` included) while refusing a blank or non-directory one.


refusalName : PathError -> String
refusalName err =
    case err of
        MissingTag _ ->
            "missing-tag"

        InvalidRelative _ _ ->
            "invalid"

        UnknownTag _ ->
            "unknown-tag"

        NotUnderRoot _ _ ->
            "not-under-root"

        NoRoots ->
            "no-roots"

        DuplicateTag _ ->
            "duplicate-tag"


refusedAs : String -> Result PathError Path.Path -> Bool
refusedAs expected result =
    case result of
        Ok _ ->
            False

        Err err ->
            refusalName err == expected


-- A refusal whose caller-facing message carries `fragment` from the
-- `Ipe.Path` error that decided it.
refusalNames : String -> Result PathError Path.Path -> Bool
refusalNames fragment result =
    case result of
        Ok _ ->
            False

        Err err ->
            String.contains fragment (SafeText.toString (RepoPath.describe err))


refused : Result PathError Path.Path -> Bool
refused result =
    case result of
        Ok _ ->
            False

        Err _ ->
            True


resolvesTo : String -> Result PathError Path.Path -> Bool
resolvesTo expected result =
    case result of
        Ok path ->
            Path.toString path == expected

        Err _ ->
            False


-- The absolute path `abs` spelled relative to the working directory, climbing
-- to `/` first — the shape a `../..`-style `IPE_INDEX_ROOT` takes.
relativeFromCwd : String -> Task.Task Error String
relativeFromCwd abs =
    System.cwd ()
        |> Task.map
            (\cwd ->
                let
                    depth =
                        List.length (List.filter (\seg -> seg /= "") (String.split "/" cwd))
                in
                String.repeat depth "../" ++ String.dropLeft 1 abs
            )


-- A root map binding each `( tag, root )`, failing the task on a refusal.
mapOf : List ( String, Root ) -> Task.Task Error RootMap
mapOf bindings =
    bindings
        |> List.map (\( name, root ) -> RepoPath.parseTag name |> Result.map (\tag -> ( tag, root )))
        |> Result.combine
        |> Result.andThen RepoPath.rootMap
        |> Result.mapError RepoPath.toError
        |> Task.fromResult


storedPathRefusals : Task.Task Error Bool
storedPathRefusals =
    do
        cwd <- System.cwd ()
        cwdRoot <- RepoPath.parseRoot cwd
        root <- mapOf [ ( "ipe", cwdRoot ) ]
        let
            base =
                Path.toString (RepoPath.rootPath cwdRoot)
        in
        Task.succeed
            (List.all identity
                [ refusedAs "invalid" (RepoPath.resolve root "ipe:a/../../escape")
                , refusedAs "invalid" (RepoPath.resolve root "ipe:../escape")
                , refusedAs "invalid" (RepoPath.resolve root "ipe:../x")
                , refusedAs "invalid" (RepoPath.resolve root "ipe:..")
                , refusedAs "invalid" (RepoPath.resolve root "ipe:a\0b")
                , refusedAs "not-under-root" (RepoPath.resolve root "ipe:/etc/passwd")
                , refusedAs "not-under-root" (RepoPath.resolve root "ipe://etc/passwd")
                , refusedAs "not-under-root" (RepoPath.resolve root "ipe:")
                , refusedAs "not-under-root" (RepoPath.resolve root "ipe:.")
                , refusedAs "not-under-root" (RepoPath.resolve root "ipe:./")
                , refusedAs "not-under-root" (RepoPath.resolve root "ipe:a/..")
                , refusedAs "missing-tag" (RepoPath.resolve root "src/Main.ipe")
                , refusedAs "missing-tag" (RepoPath.resolve root "")
                , refusedAs "missing-tag" (RepoPath.resolve root ":src/Main.ipe")
                , refusalNames "Ipe.Path.under" (RepoPath.resolve root "ipe:/etc/passwd")
                , refusalNames "escapes its root" (RepoPath.resolve root "ipe:../x")
                , resolvesTo (base ++ "/src/Main.ipe") (RepoPath.resolve root "ipe:src/Main.ipe")
                , resolvesTo (base ++ "/src/Main.ipe") (RepoPath.resolve root "ipe:./src//Main.ipe/")
                , resolvesTo (base ++ "/a:b") (RepoPath.resolve root "ipe:a:b")
                , resolvesTo (base ++ "/b") (RepoPath.resolve root "ipe:a/../b")
                , resolvesTo (base ++ "/..\\x") (RepoPath.resolve root "ipe:..\\x")
                ]
            )


-- A root spelled relative to the working directory, climbing with `..`,
-- resolves to the same absolute directory, and stored paths join under it.
relativeRootAccepted : Task.Task Error Bool
relativeRootAccepted =
    do
        cwd <- System.cwd ()
        cwdPath <- Task.fromResult (Path.fromString cwd)
        rel <- relativeFromCwd (Path.toString cwdPath)
        root <- RepoPath.parseRoot rel
        dotRoot <- RepoPath.parseRoot "."
        System.setenv "IPE_INDEX_DB" (cwd ++ "/unused-index.db")
        System.setenv "IPE_INDEX_ROOT" rel
        settings <- Settings.indexSettings
        Task.succeed
            (Path.toString (RepoPath.rootPath root)
                == Path.toString cwdPath
                && Path.toString (RepoPath.rootPath dotRoot)
                == Path.toString cwdPath
                && resolvesTo (Path.toString cwdPath ++ "/package.ipe") (RepoPath.resolve settings.roots "ipe:package.ipe")
                && refusedAs "unknown-tag" (RepoPath.resolve settings.roots "other:package.ipe")
                && Result.map RepoPath.tagName Settings.ipeTag
                == Ok "ipe"
            )


-- A map binding only `ipe` refuses a stored path under any other tag rather
-- than reading it from the one root it has.
unknownTagRefused : Task.Task Error Bool
unknownTagRefused =
    do
        cwd <- System.cwd ()
        cwdRoot <- RepoPath.parseRoot cwd
        roots <- mapOf [ ( "ipe", cwdRoot ) ]
        Task.succeed
            (refusedAs "unknown-tag" (RepoPath.resolve roots "other:src/x.ipe")
                && refusedAs "unknown-tag" (RepoPath.resolve roots "Ipe:package.ipe")
                && refusalNames "names a repo tag" (RepoPath.resolve roots "other:src/x.ipe")
            )


-- A directory `File.tempDir` makes unique to this call, holding the two
-- subdirectories `a` and `b`, so concurrent runs never share roots.
freshRootBase : Task.Task Error String
freshRootBase =
    do
        base <- File.tempDir "ipe-review-tag-roots-"
        Task.fromResult (Path.fromString (base ++ "/a")) |> Task.andThen File.mkdirAll
        Task.fromResult (Path.fromString (base ++ "/b")) |> Task.andThen File.mkdirAll
        Task.succeed base


-- Each tag joins under its own root: with `ipe` bound to A and `other` to B,
-- `other:f` lands in B and `ipe:f` in A, in either binding order.
tagSelectsItsRoot : Task.Task Error Bool
tagSelectsItsRoot =
    do
        base <- freshRootBase
        a <- RepoPath.parseRoot (base ++ "/a")
        b <- RepoPath.parseRoot (base ++ "/b")
        ipeFirst <- mapOf [ ( "ipe", a ), ( "other", b ) ]
        otherFirst <- mapOf [ ( "other", b ), ( "ipe", a ) ]
        let
            aDir =
                Path.toString (RepoPath.rootPath a)

            bDir =
                Path.toString (RepoPath.rootPath b)
        in
        Task.succeed
            (List.all identity
                [ resolvesTo (bDir ++ "/f") (RepoPath.resolve ipeFirst "other:f")
                , resolvesTo (aDir ++ "/f") (RepoPath.resolve ipeFirst "ipe:f")
                , resolvesTo (bDir ++ "/f") (RepoPath.resolve otherFirst "other:f")
                , resolvesTo (aDir ++ "/f") (RepoPath.resolve otherFirst "ipe:f")
                ]
            )


-- The tag grammar is the subset of ipe-index's `split_tag` that reads a
-- stored path back as tagged: `split_tag` takes a `:` as the separator only
-- before the first `/`.
tagGrammarMatchesWriter : Task.Task Error Bool
tagGrammarMatchesWriter =
    do
        cwd <- System.cwd ()
        cwdRoot <- RepoPath.parseRoot cwd
        roots <- mapOf [ ( "ipe", cwdRoot ), ( "a", cwdRoot ) ]
        let
            base =
                Path.toString (RepoPath.rootPath cwdRoot)
        in
        Task.succeed
            (List.all identity
                -- split_tag "a/b:c" = (None, "a/b:c"): the `:` follows a `/`
                [ refusedAs "missing-tag" (RepoPath.resolve roots "a/b:c")
                -- split_tag ":x" = (Some(""), "x"): an empty tag no repo carries
                , refusedAs "missing-tag" (RepoPath.resolve roots ":x")
                -- split_tag "ipe:a:b" = (Some("ipe"), "a:b")
                , resolvesTo (base ++ "/a:b") (RepoPath.resolve roots "ipe:a:b")
                , tagRefused "a/b"
                , tagRefused "a:b"
                , tagRefused ""
                , Result.map RepoPath.tagName (RepoPath.parseTag "ipe") == Ok "ipe"
                ]
            )


-- `parseTag` refuses `raw` as `MissingTag`.
tagRefused : String -> Bool
tagRefused raw =
    case RepoPath.parseTag raw of
        Ok _ ->
            False

        Err err ->
            refusalName err == "missing-tag"


-- A root map is never empty and never binds a tag twice.
rootMapRefusals : Task.Task Error Bool
rootMapRefusals =
    do
        base <- freshRootBase
        a <- RepoPath.parseRoot (base ++ "/a")
        b <- RepoPath.parseRoot (base ++ "/b")
        ipe <- Task.fromResult (RepoPath.parseTag "ipe" |> Result.mapError RepoPath.toError)
        Task.succeed
            (mapRefusedAs "no-roots" (RepoPath.rootMap [])
                && mapRefusedAs "duplicate-tag" (RepoPath.rootMap [ ( ipe, a ), ( ipe, b ) ])
                && mapRefusedAs "duplicate-tag" (RepoPath.rootMap [ ( ipe, a ), ( ipe, a ) ])
            )


mapRefusedAs : String -> Result PathError RootMap -> Bool
mapRefusedAs expected result =
    case result of
        Ok _ ->
            False

        Err err ->
            refusalName err == expected


-- One character as a string, by code point: the language has no `\u{}`
-- string escape, so hazard characters are built from their decimal code.
codeText : Int -> String
codeText code =
    String.fromChar (Char.fromCode code)


noHazard : String -> Bool
noHazard text =
    not (String.any SafeText.isHazard text)


rendered : String -> String
rendered raw =
    SafeText.toString (SafeText.render raw)


renderedForeign : String -> String
renderedForeign raw =
    SafeText.toString (SafeText.renderForeign raw)


-- Every member of the runtime's `is_log_hazard` set
-- (`src/runtime/rust/src/system.rs`, the definition this table mirrors): `Cc`
-- 0x00-0x1F and 0x7F-0x9F, U+061C, U+200E-U+200F, U+2028-U+202E (the
-- separators and U+202A-U+202E), U+2066-U+2069.
hazardMembers : List Int
hazardMembers =
    List.range 0 31
        ++ List.range 127 159
        ++ [ 1564 ]
        ++ List.range 8206 8207
        ++ List.range 8232 8238
        ++ List.range 8294 8297


-- The code point one step outside each range edge of `hazardMembers`.
hazardNeighbours : List Int
hazardNeighbours =
    [ 32, 126, 160, 1563, 1565, 8205, 8208, 8231, 8239, 8293, 8298 ]


-- `render` escapes exactly the hazard set, in `scrub_log_controls`'s spelling,
-- and passes every neighbour through unchanged.
safeTextHazardTable : Bool
safeTextHazardTable =
    List.all
        (\code ->
            SafeText.isHazard (Char.fromCode code)
                && rendered (codeText code) /= codeText code
                && noHazard (rendered (codeText code))
                && noHazard (renderedForeign (codeText code))
        )
        hazardMembers
        && List.all
            (\code ->
                not (SafeText.isHazard (Char.fromCode code))
                    && rendered (codeText code) == codeText code
                    && renderedForeign (codeText code) == codeText code
            )
            hazardNeighbours
        && List.all identity
            [ rendered "\n" == "\\n"
            , rendered "\r" == "\\r"
            , rendered "\t" == "\\t"
            , rendered (codeText 0) == "\\u{0}"
            , rendered (codeText 27) == "\\u{1b}"
            , rendered (codeText 127) == "\\u{7f}"
            , rendered (codeText 159) == "\\u{9f}"
            , rendered (codeText 1564) == "\\u{61c}"
            , rendered (codeText 8238) == "\\u{202e}"
            , rendered (codeText 8297) == "\\u{2069}"
            , rendered "src/plain.ipe" == "src/plain.ipe"
            , SafeText.toString (SafeText.quoted ("a" ++ codeText 27)) == "\"a\\u{1b}\""
            ]


describeText : PathError -> String
describeText err =
    SafeText.toString (RepoPath.describe err)


-- A stored path carrying a terminal escape, a CR, an LF or a bidi override
-- reaches `describe`'s text only as its visible escape.
describeEscapesStoredPath : Bool
describeEscapesStoredPath =
    let
        osc =
            describeText (MissingTag (codeText 27 ++ "]0;x" ++ codeText 7))

        cr =
            describeText (MissingTag "a\rb")

        lf =
            describeText (MissingTag "a\nb")

        rlo =
            describeText (MissingTag (codeText 8238 ++ "gpj.exe"))
    in
    List.all identity
        [ String.contains "\\u{1b}]0;x\\u{7}" osc
        , String.contains "\"a\\rb\"" cr
        , String.contains "\"a\\nb\"" lf
        , String.contains "\\u{202e}gpj.exe" rlo
        , List.all noHazard [ osc, cr, lf, rlo ]
        ]


rootRefusalMessage : String -> Task.Task Error (Maybe String)
rootRefusalMessage raw =
    RepoPath.parseRoot raw
        |> Task.map (\_ -> Nothing)
        |> Task.onError (\e -> Task.succeed (Just (Error.message e)))


-- An `IPE_INDEX_ROOT` value carrying a terminal escape, refused as a missing
-- directory or as an invalid path, is echoed only escaped.
rootRefusalEscapesEnv : Task.Task Error Bool
rootRefusalEscapesEnv =
    do
        clear <- rootRefusalMessage (codeText 27 ++ "[2J/nope")
        nul <- rootRefusalMessage (codeText 27 ++ "[2J" ++ codeText 0 ++ "/nope")
        Task.succeed
            (case ( clear, nul ) of
                ( Just notDir, Just invalid ) ->
                    String.contains "\\u{1b}[2J/nope" notDir
                        && String.contains "not a directory" notDir
                        && String.contains "\\u{1b}[2J" invalid
                        && String.contains "not a valid path" invalid
                        && noHazard notDir
                        && noHazard invalid

                _ ->
                    False
            )


-- The same refusal with every foreign field replaced: the `case` names every
-- `PathError` constructor, so a new one cannot join `allPathErrors` without an
-- arm here.
withForeign : String -> Error -> PathError -> PathError
withForeign stored e err =
    case err of
        MissingTag _ ->
            MissingTag stored

        UnknownTag _ ->
            UnknownTag stored

        InvalidRelative _ _ ->
            InvalidRelative stored e

        NotUnderRoot _ _ ->
            NotUnderRoot stored e

        NoRoots ->
            NoRoots

        DuplicateTag _ ->
            DuplicateTag stored


allPathErrors : List PathError
allPathErrors =
    let
        e =
            Error.unexpected ""
    in
    [ MissingTag "", UnknownTag "", InvalidRelative "" e, NotUnderRoot "" e, NoRoots, DuplicateTag "" ]


-- Every `PathError`, fed a hazard-bearing stored path and a hazard-bearing
-- nested error, describes itself (and converts to an `Error`) free of hazards;
-- so do the refusals `resolve` builds from hazard-bearing stored paths.
diagnosticsNeverRaw : Task.Task Error Bool
diagnosticsNeverRaw =
    let
        hazards =
            codeText 27 ++ "]0;pwn" ++ codeText 7 ++ "\r\n" ++ codeText 8238 ++ codeText 133 ++ codeText 8233

        nested =
            Error.invalidInput hazards

        clean err =
            noHazard (describeText err) && noHazard (Error.message (RepoPath.toError err))

        resolvedClean roots stored =
            case RepoPath.resolve roots stored of
                Ok _ ->
                    False

                Err err ->
                    clean err
    in
    do
        cwd <- System.cwd ()
        cwdRoot <- RepoPath.parseRoot cwd
        roots <- mapOf [ ( "ipe", cwdRoot ) ]
        Task.succeed
            (List.length allPathErrors == 6
                && List.all (\err -> clean (withForeign hazards nested err)) allPathErrors
                && List.all (resolvedClean roots)
                    [ hazards
                    , "other:" ++ hazards
                    , "ipe:" ++ hazards ++ codeText 0
                    , "ipe:/etc/" ++ hazards
                    , "ipe:../" ++ hazards
                    , hazards ++ "/x:y"
                    ]
            )


-- `render` escapes a literal `\`, so text spelling an escape cannot pass for
-- the character it names; `renderForeign` leaves `\` alone.
backslashCannotForge : Bool
backslashCannotForge =
    List.all identity
        [ rendered "\\u{1b}" /= rendered (codeText 27)
        , rendered "\\u{1b}" == "\\\\u{1b}"
        , rendered "a\\nb" /= rendered "a\nb"
        , renderedForeign "a\\b" == "a\\b"
        , renderedForeign ("a\\" ++ codeText 27) == "a\\\\u{1b}"
        ]


-- `render` escapes `"`, so a quoted foreign value cannot close its own quotes
-- and fake a boundary in the diagnostic around it.
quoteCannotForgeBoundary : Bool
quoteCannotForgeBoundary =
    List.all identity
        [ rendered "a\"b" == "a\\\"b"
        , SafeText.toString (SafeText.quoted "x\" ok \"y") == "\"x\\\" ok \\\"y\""
        , String.contains "\"ipe:a\\\" has\"" (describeText (MissingTag "ipe:a\" has"))
        , rendered "\\\"" /= rendered "\""
        ]


-- The sink renders that live in `Lib`: the queue's failure line escapes a
-- hazard-bearing error.
sinkRendersEscape : Bool
sinkRendersEscape =
    case Queue.queueStatusText (Failed (Error.unexpected (codeText 27 ++ "[2J" ++ codeText 8238))) of
        Just text ->
            noHazard text && String.contains "\\u{1b}[2J\\u{202e}" text

        Nothing ->
            False


-- An `IPE_INDEX_DB` value carrying hazards is refused by naming the variable,
-- never by echoing the value.
dbRefusalNamesOnlyVariable : Task.Task Error Bool
dbRefusalNamesOnlyVariable =
    do
        cwd <- System.cwd ()
        System.setenv "IPE_INDEX_ROOT" cwd
        refusal <- settingsRefusal ("postgres://" ++ codeText 27 ++ "]0;pwn" ++ codeText 7 ++ "/index")
        Task.succeed
            (refusedFor "IPE_INDEX_DB" refusal
                && not (refusedFor "]0;pwn" refusal)
                && not (refusedFor "postgres://" refusal)
                && (case refusal of
                        Just message ->
                            noHazard message

                        Nothing ->
                            False
                   )
            )


rootRefused : String -> String -> Task.Task Error Bool
rootRefused raw reason =
    RepoPath.parseRoot raw
        |> Task.map (\_ -> Nothing)
        |> Task.onError (\e -> Task.succeed (Just (Error.message e)))
        |> Task.map (refusedFor reason)


-- A parse that failed, and failed for `reason` rather than an unrelated one.
refusedFor : String -> Maybe String -> Bool
refusedFor reason refusal =
    case refusal of
        Just message ->
            String.contains reason message

        Nothing ->
            False


-- Blank, missing, and non-directory roots stop at the parse.
badRootsRefused : Task.Task Error Bool
badRootsRefused =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-review-root-refusals"
    in
    do
        dir <- Task.fromResult (Path.fromString base)
        File.mkdirAll dir
        writeFileText (base ++ "/plain-file") "x"
        blank <- rootRefused "" "is empty"
        spaces <- rootRefused "   " "is empty"
        missing <- rootRefused (base ++ "/does-not-exist") "not a directory"
        notDir <- rootRefused (base ++ "/plain-file") "not a directory"
        removeFileIfAny (base ++ "/plain-file")
        Task.succeed (blank && spaces && missing && notDir)


settingsRefusal : String -> Task.Task Error (Maybe String)
settingsRefusal indexDb =
    System.setenv "IPE_INDEX_DB" indexDb
        |> Task.andThen (\_ -> Settings.indexSettings)
        |> Task.map (\_ -> Nothing)
        |> Task.onError (\e -> Task.succeed (Just (Error.message e)))


settingsRefused : String -> String -> Task.Task Error Bool
settingsRefused indexDb reason =
    settingsRefusal indexDb |> Task.map (refusedFor reason)


-- `IPE_INDEX_DB` values that cannot name a SQLite database stop at the parse,
-- each for its own reason, and no refusal repeats the value it refused.
badIndexDbRefused : Task.Task Error Bool
badIndexDbRefused =
    do
        cwd <- System.cwd ()
        System.setenv "IPE_INDEX_ROOT" cwd
        blank <- settingsRefused "" "is empty"
        otherScheme <- settingsRefused "postgres://localhost/index" "not `sqlite://`"
        query <- settingsRefused "index.db?mode=rwc" "file path containing"
        fragment <- settingsRefused "index.db#x" "file path containing"
        percent <- settingsRefused "index%2e.db" "file path containing"
        urlQuery <- settingsRefused "sqlite:///tmp/index.db?mode=rwc" "with a query"
        urlOtherQuery <- settingsRefused "sqlite:///tmp/index.db?cache=shared" "with a query"
        urlEmpty <- settingsRefused "sqlite://" "naming no database"
        urlFragment <- settingsRefused "sqlite:///tmp/index.db#x" "with a query or fragment"
        urlEncodedQuery <- settingsRefused "sqlite://file:/tmp/x.db%3Fmode=ro" "not absolute"
        urlEncodedImmutable <- settingsRefused "sqlite://file:/x.db%3Fmode=ro%26immutable=1" "not absolute"
        urlMemory <- settingsRefused "sqlite://:memory:" "not absolute"
        urlRelative <- settingsRefused "sqlite://rel.db" "not absolute"
        urlNested <- settingsRefused "sqlite://sqlite:" "not absolute"
        urlBadEscape <- settingsRefused "sqlite:///tmp/index%zz.db" "malformed percent-escape"
        urlNul <- settingsRefused "sqlite:///tmp/index%00.db" "not a valid file path"
        urlAboveRoot <- settingsRefused "sqlite:///.." "root directory"
        urlDeepAboveRoot <- settingsRefused "sqlite:///tmp/../../.." "root directory"
        urlRoot <- settingsRefused "sqlite:///" "root directory"
        pathAboveRoot <- settingsRefused "/.." "root directory"
        urlDot <- settingsRefused "sqlite:///." "root directory"
        urlDotSlash <- settingsRefused "sqlite:///./" "root directory"
        urlDoubleSlash <- settingsRefused "sqlite:////" "root directory"
        urlEncodedAboveRoot <- settingsRefused "sqlite:///%2e%2e" "root directory"
        noSlashes <- settingsRefused "sqlite:index.db" "without `//`"
        fileNoSlashes <- settingsRefused "file:index.db" "without `//`"
        secret <- settingsRefusal "postgres://admin:s3cr3t-pw@db/index"
        Task.succeed
            (blank
                && otherScheme
                && query
                && fragment
                && percent
                && urlQuery
                && urlOtherQuery
                && urlEmpty
                && urlFragment
                && urlEncodedQuery
                && urlEncodedImmutable
                && urlMemory
                && urlRelative
                && urlNested
                && urlBadEscape
                && urlNul
                && urlAboveRoot
                && urlDeepAboveRoot
                && urlRoot
                && pathAboveRoot
                && urlDot
                && urlDotSlash
                && urlDoubleSlash
                && urlEncodedAboveRoot
                && noSlashes
                && fileNoSlashes
                && refusedFor "IPE_INDEX_DB" secret
                && not (refusedFor "s3cr3t-pw" secret)
                && not (refusedFor "admin" secret)
            )


-- A write that fails for a reason other than the key keeps its own error, and
-- a failed insert whose pair already has a row is the duplicate no-op. A
-- read-only connection makes every insert fail without a key conflict, with
-- SQLite's read-only result code (`SQLITE_READONLY`, 8).
failedWritesKeepTheirError : Task.Task Error Bool
failedWritesKeepTheirError =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-review-failed-writes"

        dbPath =
            base ++ "/review.db"

        failedReadOnly task =
            task
                |> Task.map (\_ -> False)
                |> Task.onError (\e -> Task.succeed (Error.message e == readOnlyWriteError))
    in
    do
        dir <- Task.fromResult (Path.fromString base)
        File.mkdirAll dir
        removeFileIfAny dbPath
        rw <- openReviewAt dbPath
        LibDb.migrate rw
        LibDb.insertDecision rw "seen" "h" Approved
        ro <- openReadOnlyAt dbPath
        duplicate <- LibDb.insertDecision ro "seen" "h" Approved
        freshReview <- failedReadOnly (LibDb.insertDecision ro "fresh" "h" Approved)
        freshDrain <- failedReadOnly (LibDb.recordDrain ro "fresh" "h")
        freshDrainInsert <- failedReadOnly (LibDb.insertDrainCursor ro "fresh" "h")
        kept <- LibDb.findDecision rw "fresh" "h"
        removeFileIfAny dbPath
        removeFileIfAny (dbPath ++ "-wal")
        removeFileIfAny (dbPath ++ "-shm")
        Task.succeed (duplicate == 0 && freshReview && freshDrain && freshDrainInsert && not (hasDecision kept))


-- A cursor insert that loses the race to a concurrent drain of the same pair
-- hits the primary key, then refreshes the row that won: the pair already has
-- its cursor row when the insert runs, and the insert reports that one row
-- written instead of failing, leaving the pair with exactly one row.
lostCursorInsertRefreshes : Task.Task Error Bool
lostCursorInsertRefreshes =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-review-lost-insert"

        dbPath =
            base ++ "/review.db"
    in
    do
        dir <- Task.fromResult (Path.fromString base)
        File.mkdirAll dir
        removeFileIfAny dbPath
        db <- openReviewAt dbPath
        LibDb.migrate db
        first <- LibDb.recordDrain db "raced" "h"
        lost <- LibDb.insertDrainCursor db "raced" "h"
        rows <- countDrainRows db "raced" "h"
        removeFileIfAny dbPath
        removeFileIfAny (dbPath ++ "-wal")
        removeFileIfAny (dbPath ++ "-shm")
        Task.succeed (first == 1 && lost == 1 && rows == 1)


-- A cursor insert that fails for a reason other than the key, on a writable
-- database whose pair has no row, keeps the insert's own error: the retried
-- refresh matches no row, so the failure is not read as a lost race. A trigger
-- aborting every insert is that reason (`SQLITE_CONSTRAINT_TRIGGER`, 1811,
-- not the primary key's 1555).
blockedCursorInsertKeepsItsError : Task.Task Error Bool
blockedCursorInsertKeepsItsError =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-review-blocked-insert"

        dbPath =
            base ++ "/review.db"
    in
    do
        dir <- Task.fromResult (Path.fromString base)
        File.mkdirAll dir
        removeFileIfAny dbPath
        db <- openReviewAt dbPath
        LibDb.migrate db
        Db.exec db "CREATE TRIGGER block_cursor BEFORE INSERT ON drain_cursor BEGIN SELECT RAISE(ABORT, 'blocked'); END" []
        refusal <-
            LibDb.insertDrainCursor db "fresh" "h"
                |> Task.map (\_ -> Nothing)
                |> Task.onError (\e -> Task.succeed (Just (Error.message e)))
        rows <- countDrainRows db "fresh" "h"
        removeFileIfAny dbPath
        removeFileIfAny (dbPath ++ "-wal")
        removeFileIfAny (dbPath ++ "-shm")
        Task.succeed (refusal == Just triggerAbortError && rows == 0)


triggerAbortError : String
triggerAbortError =
    "db: database error [1811]"


readOnlyWriteError : String
readOnlyWriteError =
    "db: database error [8]"


-- The review database at a test file path, opened through the app's own
-- location parse and review URL builder.
openReviewAt : String -> Task.Task Error Db
openReviewAt path =
    Settings.parseDbLocation "IPE_REVIEW_DB" path
        |> Task.andThen LibDb.openAt


-- A test file path opened read-only through the app's read URL builder, so
-- every write on it fails without a key conflict.
openReadOnlyAt : String -> Task.Task Error Db
openReadOnlyAt path =
    Settings.parseDbLocation "IPE_INDEX_DB" path
        |> Task.andThen (\loc -> Db.open "sqlite" (Settings.indexReadUrl loc))


hasDecision : Maybe Decision -> Bool
hasDecision m =
    case m of
        Just _ ->
            True

        Nothing ->
            False


-- Every open URL carries exactly the app's mode, for a file path and a
-- `sqlite://` URL alike, and a `sqlite://` URL parses to the same location as
-- the plain path it names; a `+` in the URL path is a literal `+`, never a
-- space.
dbUrlsCarryAppMode : Task.Task Error Bool
dbUrlsCarryAppMode =
    do
        file <- Settings.parseDbLocation "IPE_INDEX_DB" "/tmp/a&b/index.db"
        url <- Settings.parseDbLocation "IPE_INDEX_DB" "sqlite:///tmp/index%3F.db"
        absUrl <- Settings.parseDbLocation "IPE_INDEX_DB" "sqlite:///abs/x.db"
        absPath <- Settings.parseDbLocation "IPE_INDEX_DB" "/abs/x.db"
        plusUrl <- Settings.parseDbLocation "IPE_INDEX_DB" "sqlite:///t/a+b.db"
        escapedPlusUrl <- Settings.parseDbLocation "IPE_INDEX_DB" "sqlite:///t/a%2Bb.db"
        plusPath <- Settings.parseDbLocation "IPE_INDEX_DB" "/t/a+b.db"
        Task.succeed
            (absUrl
                == absPath
                && plusUrl
                == plusPath
                && escapedPlusUrl
                == plusPath
                && Settings.reviewUrl plusUrl
                == "sqlite:///t/a+b.db?mode=rwc"
                && Settings.indexReadUrl absUrl
                == "sqlite:///abs/x.db?mode=ro"
                && Settings.indexReadUrl file
                == "sqlite:///tmp/a&b/index.db?mode=ro"
                && Settings.indexWriteUrl file
                == "sqlite:///tmp/a&b/index.db?mode=rw"
                && Settings.reviewUrl file
                == "sqlite:///tmp/a&b/index.db?mode=rwc"
                && Settings.indexReadUrl url
                == "sqlite:///tmp/index%3F.db?mode=ro"
                && Settings.indexWriteUrl url
                == "sqlite:///tmp/index%3F.db?mode=rw"
                && Settings.reviewUrl url
                == "sqlite:///tmp/index%3F.db?mode=rwc"
            )


-- A working directory can hold `%`, `?` or `#`; each is escaped so the joined
-- file path survives the URL as the same name, with `%` escaped first so the
-- other escapes are not re-encoded.
filePathsEncodeUrlSpecials : Bool
filePathsEncodeUrlSpecials =
    Settings.encodeFilePath "/w/a%b?c#d/index.db"
        == "/w/a%25b%3Fc%23d/index.db"
        && Settings.encodeFilePath "/w/%3F"
        == "/w/%253F"
        && Settings.encodeFilePath "/w/plain.db"
        == "/w/plain.db"


-- The index bridge with `IPE_INDEX_ROOT` given relative to the working
-- directory: the queue loads and every source slice reads from under the root.
relativeRootLoadsQueue : Task.Task Error Bool
relativeRootLoadsQueue =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-relative-root"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"
    in
    do
        removeFileIfAny indexDb
        seedIndex indexDb repo
        absRepo <- Task.fromResult (Path.fromString repo)
        relRepo <- relativeFromCwd (Path.toString absRepo)
        System.setenv "IPE_INDEX_ROOT" relRepo
        r <- loadFirstPage
        cleanupIndex indexDb repo
        Task.succeed (checkUnits r.total r.units)


-- A queued unit whose source file is one byte past the 16 MiB read ceiling
-- is unreadable for that reason, rather than read whole; the page still
-- loads.
oversizedSourceRefused : Task.Task Error Bool
oversizedSourceRefused =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-oversized-source"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"
    in
    do
        removeFileIfAny indexDb
        seedIndex indexDb repo
        writeFileText (repo ++ "/src/Lib.rs") (String.repeat (16 * 1024 * 1024 + 1) "x")
        r <- loadFirstPage
        cleanupIndex indexDb repo
        Task.succeed (unreadableNaming "16777216-byte limit" (unitViewTag "u-a" r.units))


-- ── decision drain loop ─────────────────────────────────────────────────
--
-- A decided unit leaves the index queue: the decision returns the attested
-- pair, recordDrain writes the drain cursor under it (idempotent on the same
-- pair), drainUnit deletes the consumed change_queue row, and a subsequent
-- page load no longer lists the unit.
drainFlow : Task.Task Error Bool
drainFlow =
    drainAfter "ipe-index-drain" noChange
        |> Task.map (\o -> o.drained == 1 && o.cursorRows == 1 && not o.stillQueued && o.totalAfter == o.totalBefore - 1)


-- R11: the unit is re-queued with a new hash between the decision and the
-- drain. The drain deletes only the row of the attested hash, so the new
-- change stays queued. Red if `drainUnit` matches on uid alone.
drainKeepsRequeuedChange : Task.Task Error Bool
drainKeepsRequeuedChange =
    drainAfter "ipe-index-drain-requeued" requeueB
        |> Task.map (\o -> o.drained == 0 && o.stillQueued && o.totalAfter == o.totalBefore)


-- R10: an unknown uid is its own unit-page state, and every state that
-- withholds a unit or its source says so in its own words. Red if a missing
-- unit collapses to the loading state.
unitPageStatesDistinct : Task.Task Error Bool
unitPageStatesDistinct =
    let
        at =
            scratchAt "ipe-index-unit-page-states"

        pageTexts =
            List.filterMap Queue.unitPageStatusText [ UnitLoading, UnitNotFound, UnitFailed (Error.conflict "boom") ]

        sourceTexts =
            List.filterMap Queue.sourceStatusText
                [ Stale Drifted
                , Stale (RangeOutOfFile { lineCount = 3 })
                , Stale UnverifiableHash
                , Unreadable (Error.conflict "boom")
                ]
    in
    do
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        loaded <- Queue.loadUnitView "no-such-uid"
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (isNotFound (Queue.unitPageFromResult (Ok loaded))
                && List.length pageTexts == 3
                && List.length sourceTexts == 4
                && pairwiseDistinct (pageTexts ++ sourceTexts)
            )


isNotFound : Queue.UnitPageState -> Bool
isNotFound state =
    case state of
        UnitNotFound ->
            True

        UnitLoading ->
            False

        UnitLoaded _ _ ->
            False

        UnitFailed _ ->
            False


pairwiseDistinct : List String -> Bool
pairwiseDistinct texts =
    case texts of
        [] ->
            True

        t :: rest ->
            not (List.member t rest) && pairwiseDistinct rest


requeueB : Scratch -> Task.Task Error ()
requeueB at =
    execIndex at.indexDb "UPDATE change_queue SET new_hash = ? WHERE uid = ?" [ SqlString "sha256:other", SqlString "u-b" ]


-- Seeds the bridge fixture, decides `u-b`, runs `mutate`, then records the
-- drain twice and drains under the decision's attested pair. `totalBefore`
-- and `totalAfter` are the queue counts around the drain.
drainAfter : String -> (Scratch -> Task.Task Error ()) -> Task.Task Error DrainOutcome
drainAfter name mutate =
    let
        at =
            scratchAt name
    in
    do
        removeFileIfAny at.indexDb
        removeFileIfAny at.reviewDb
        seedIndex at.indexDb at.repo
        r <- loadFirstPage
        db <- openReviewAt at.reviewDb
        migrated <- LibDb.migrate db
        decided <- decideUnit db (List.find (\u -> u.uid == "u-b") r.units)
        mutate at
        outcome <- drainDecided db r.total decided
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed outcome


decideUnit : Db -> Maybe Index.Unit -> Task.Task Error ( Index.Attested, Int )
decideUnit db found =
    case found of
        Just unit ->
            Queue.decide db unit Approved

        Nothing ->
            Task.fail (Error.conflict "fixture unit not loaded")


type alias DrainOutcome =
    { drained : Int, cursorRows : Int, stillQueued : Bool, totalBefore : Int, totalAfter : Int }


drainDecided : Db -> Int -> ( Index.Attested, Int ) -> Task.Task Error DrainOutcome
drainDecided db totalBefore decided =
    case decided of
        ( attested, _ ) ->
            do
                first <- LibDb.recordDrain db (Index.attestedUid attested) (Index.attestedHash attested)
                second <- LibDb.recordDrain db (Index.attestedUid attested) (Index.attestedHash attested)
                cursorRows <- countDrainRows db (Index.attestedUid attested) (Index.attestedHash attested)
                drained <- Index.drainUnit attested
                after <- loadFirstPage
                Task.succeed
                    { drained = drained
                    , cursorRows = cursorRows
                    , stillQueued = List.any (\u -> u.uid == "u-b") after.units
                    , totalBefore = totalBefore
                    , totalAfter = after.total
                    }


countDrainRows : Db -> String -> String -> Task.Task Error Int
countDrainRows db uid bodyHash =
    Db.findWhere db
        "drain_cursor"
        (Sql.and
            (Sql.eq (Sql.column "uid") (Sql.string uid))
            (Sql.eq (Sql.column "body_hash") (Sql.string bodyHash))
        )
        |> Task.map List.length


-- ── review history ──────────────────────────────────────────────────────
--
-- Two decisions on a scratch review db must come back through findDecisions
-- with their columns in order (descending reviewed_at, then uid).
historyRoundtrip : Task.Task Error Bool
historyRoundtrip =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-b6-history"

        reviewDb =
            base ++ "/review.db"
    in
    removeFileIfAny reviewDb
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString base))
        |> Task.andThen File.mkdirAll
        |> Task.andThen (\_ -> openReviewAt reviewDb)
        |> Task.andThen
            (\db ->
                LibDb.migrate db
                    |> Task.andThen (\_ -> insertBoth db)
                    |> Task.map (\_ -> db)
            )
        |> Task.andThen
            (\db ->
                LibDb.findDecisions db
                    |> Task.map
                        (\rows ->
                            List.length rows
                                == 2
                                && List.member ( "u-a", "approve" ) (List.map (\r -> ( r.uid, r.decision )) rows)
                                && List.member ( "u-b", "refuse" ) (List.map (\r -> ( r.uid, r.decision )) rows)
                                && List.member (Just "too big") (List.map (\r -> r.reason) rows)
                        )
            )
        |> Task.andThen
            (\ok ->
                removeFileIfAny reviewDb
                    |> Task.andThen (\_ -> removeFileIfAny (reviewDb ++ "-wal"))
                    |> Task.andThen (\_ -> removeFileIfAny (reviewDb ++ "-shm"))
                    |> Task.map (\_ -> ok)
            )


insertBoth : Db -> Task.Task Error Int
insertBoth db =
    LibDb.insertDecision db "u-a" "hashA" Approved
        |> Task.andThen (\_ -> LibDb.insertDecision db "u-b" "hashB" (Refused "too big"))


-- ── change re-enqueue ─────────────────────────────────────────────────────
--
-- A unit already decided on its current hash stays hidden; a unit decided on an
-- OLDER hash resurfaced at the queue head, flagged with the previous decision;
-- never-seen units follow in their natural order.
changeReenqueue : Task.Task Error Bool
changeReenqueue =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-b8-reenqueue"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"

        reviewDb =
            base ++ "/review.db"
    in
    Task.fromResult (Path.fromString indexDb)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString base) |> Task.andThen File.mkdirAll)
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString (repo ++ "/src")) |> Task.andThen File.mkdirAll)
        |> Task.andThen (\_ -> writeFileText (repo ++ "/src/A.ipe") fixtureMainIpe)
        |> Task.andThen (\_ -> writeFileText (repo ++ "/src/B.ipe") fixtureMainIpe)
        |> Task.andThen (\_ -> writeFileText (repo ++ "/src/C.ipe") fixtureMainIpe)
        |> Task.andThen (\_ -> seedB8Db indexDb)
        |> Task.andThen (\_ -> System.setenv "IPE_INDEX_DB" indexDb)
        |> Task.andThen (\_ -> System.setenv "IPE_INDEX_ROOT" repo)
        |> Task.andThen
            (\_ ->
                openReviewAt reviewDb
                    |> Task.andThen (\db -> LibDb.migrate db |> Task.map (\_ -> db))
                    |> Task.andThen
                        (\db ->
                            LibDb.insertDecision db "u-a" "hashA" Approved
                                |> Task.andThen (\_ -> LibDb.insertDecision db "u-b" "hashB" (Refused "too big"))
                                |> Task.map (\_ -> db)
                        )
                    |> Task.andThen (\_ -> System.setenv "IPE_REVIEW_DB" reviewDb)
                    |> Task.andThen (\_ -> Queue.loadPage Index.Start)
            )
        |> Task.map
            (\r ->
                changedHead r.units
                    && freshSecond r.units
                    && List.length r.units
                    == 2
                    && r.total
                    == 3
            )
        |> Task.andThen
            (\ok ->
                Task.sequence
                    [ removeFileIfAny indexDb
                    , removeFileIfAny (indexDb ++ "-wal")
                    , removeFileIfAny (indexDb ++ "-shm")
                    , removeFileIfAny (repo ++ "/src/A.ipe")
                    , removeFileIfAny (repo ++ "/src/B.ipe")
                    , removeFileIfAny (repo ++ "/src/C.ipe")
                    , removeFileIfAny reviewDb
                    , removeFileIfAny (reviewDb ++ "-wal")
                    , removeFileIfAny (reviewDb ++ "-shm")
                    ]
                    |> Task.map (\_ -> ok)
            )


changedHead : List Queue.QueuedUnit -> Bool
changedHead units =
    case List.head units of
        Just first ->
            first.unit.uid == "u-a" && resurfaced first.changed

        Nothing ->
            False


resurfaced : Maybe LibDb.ReviewRow -> Bool
resurfaced old =
    case old of
        Just row ->
            row.decision == "approve" && row.bodyHash == "hashA"

        Nothing ->
            False


freshSecond : List Queue.QueuedUnit -> Bool
freshSecond units =
    case List.head (List.drop 1 units) of
        Just second ->
            second.unit.uid == "u-c" && neverSeen second.changed

        Nothing ->
            False


neverSeen : Maybe LibDb.ReviewRow -> Bool
neverSeen old =
    case old of
        Nothing ->
            True

        Just _ ->
            False


seedB8Db : String -> Task.Task Error ()
seedB8Db indexDb =
    Db.open "sqlite" ("sqlite://" ++ indexDb ++ "?mode=rwc")
        |> Task.andThen
            (\conn ->
                Db.exec conn unitsDdl []
                    |> Task.andThen (\_ -> Db.exec conn queueDdl [])
                    |> Task.andThen (\_ -> insertB8Units conn)
            )
        |> Task.map (\_ -> ())


insertB8Units : Db -> Task.Task Error Int
insertB8Units conn =
    Db.exec conn
        "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
        [ SqlString "u-a"
        , SqlString "ipe:src/A.ipe"
        , SqlString "module"
        , SqlString "A"
        , SqlString "A"
        , SqlInt 1
        , SqlInt 2
        , SqlString "user"
        , SqlNull (SqlString "")
        , SqlString "hashA2"
        , SqlString "shaA2"
        ]
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
                    [ SqlString "u-b"
                    , SqlString "ipe:src/B.ipe"
                    , SqlString "module"
                    , SqlString "B"
                    , SqlString "B"
                    , SqlInt 1
                    , SqlInt 2
                    , SqlString "user"
                    , SqlNull (SqlString "")
                    , SqlString "hashB"
                    , SqlString "shaB"
                    ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO units VALUES (?,?,?,?,?,?,?,?,?,?,?)"
                    [ SqlString "u-c"
                    , SqlString "ipe:src/C.ipe"
                    , SqlString "module"
                    , SqlString "C"
                    , SqlString "C"
                    , SqlInt 1
                    , SqlInt 2
                    , SqlString "user"
                    , SqlNull (SqlString "")
                    , SqlString "hashC"
                    , SqlString "shaC"
                    ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                    [ SqlString "u-a", SqlString "modified", SqlString "hashA", SqlString "hashA2", SqlString "shaA2", SqlInt 3 ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                    [ SqlString "u-b", SqlString "new", SqlNull (SqlString ""), SqlString "hashB", SqlString "shaB", SqlInt 2 ]
            )
        |> Task.andThen
            (\_ ->
                Db.exec conn
                    "INSERT INTO change_queue VALUES (?,?,?,?,?,?)"
                    [ SqlString "u-c", SqlString "new", SqlNull (SqlString ""), SqlString "hashC", SqlString "shaC", SqlInt 1 ]
            )


-- ── internal/external linking ───────────────────────────────────────────
--
-- Identifier tokens in a unit's source resolve against the index's qualified
-- names (internal) or http(s) URLs (external); the unit's own name never
-- links to itself and punctuation is stripped from tokens.
linksResolve : Bool
linksResolve =
    let
        units =
            [ ( "Lib.answer", "u-a" )
            , ( "Lib.answer2", "u-b" )
            , ( "Main.main", "u-m" )
            ]

        got =
            Links.resolve
                "Lib.answer"
                units
                "use Lib.answer();\nLib.answer2 helper https://docs.rs/serde\nMain.main() Main.main"

        want =
            [ Links.Internal "Lib.answer2" "u-b"
            , Links.External "https://docs.rs/serde"
            , Links.Internal "Main.main" "u-m"
            ]
    in
    List.map Links.linkKey got == List.map Links.linkKey want


linksSubstring : Bool
linksSubstring =
    let
        noSelf =
            List.isEmpty (Links.resolve "Main" [ ( "Main", "u-x" ) ] "Main.main()")

        urlPunct =
            Links.resolve "" [] "(https://a.io/b,)"
                == [ Links.External "https://a.io/b" ]
    in
    noSelf && urlPunct


-- The unit page's data path: a uid that exists loads with source and qualified
-- name; a bogus uid loads Nothing; the qualified-name table lists every unit.
unitPageLoad : Task.Task Error Bool
unitPageLoad =
    let
        base =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-index-b9-unit"

        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"
    in
    Task.fromResult (Path.fromString indexDb)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString base) |> Task.andThen File.mkdirAll)
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString (repo ++ "/src")) |> Task.andThen File.mkdirAll)
        |> Task.andThen (\_ -> writeFileText (repo ++ "/src/Lib.rs") fixtureLibRs)
        |> Task.andThen (\_ -> writeFileText (repo ++ "/src/Main.ipe") fixtureMainIpe)
        |> Task.andThen (\_ -> seedIndexDb indexDb)
        |> Task.andThen (\_ -> setIndexEnv indexDb repo)
        |> Task.andThen
            (\_ ->
                Index.loadUnitByUid "u-a"
                    |> Task.andThen
                        (\mb ->
                            case mb of
                                Just unit ->
                                    Index.qualifiedUids
                                        |> Task.map
                                            (\qs ->
                                                unit.qualified
                                                    == "Lib.answer"
                                                    && shownTextOf unit.view
                                                    == Just viewA
                                                    && List.length qs
                                                    == 3
                                                    && List.member ( "Lib.answer", "u-a" ) qs
                                            )

                                Nothing ->
                                    Task.succeed False
                        )
            )
        |> Task.andThen
            (\ok ->
                if not ok then
                    Task.succeed False

                else
                    Index.loadUnitByUid "u-zz"
                        |> Task.map
                            (\mb ->
                                case mb of
                                    Nothing ->
                                        True

                                    Just _ ->
                                        False
                            )
            )
        |> Task.andThen
            (\ok ->
                Task.sequence
                    [ removeFileIfAny indexDb
                    , removeFileIfAny (indexDb ++ "-wal")
                    , removeFileIfAny (indexDb ++ "-shm")
                    , removeFileIfAny (repo ++ "/src/Lib.rs")
                    , removeFileIfAny (repo ++ "/src/Main.ipe")
                    ]
                    |> Task.map (\_ -> ok)
            )


-- The keyboard shortcuts drive exactly the messages the buttons send: a/r
-- act on the selected unit, j/k/g/1-5 move the selection, Enter/Escape
-- confirm/cancel an open refuse panel, and every key is ignored while the
-- refuse reason input is open (so typing a reason is not hijacked).
testKeys : Bool
testKeys =
    List.all identity
        [ Keys.label (Keys.keyAction False 3 0 "a") == "approve"
        , Keys.label (Keys.keyAction False 3 0 "r") == "refuse"
        , Keys.label (Keys.keyAction False 3 0 "j") == "select1"
        , Keys.label (Keys.keyAction False 3 0 "k") == "select0"
        , Keys.label (Keys.keyAction False 3 2 "g") == "select0"
        , Keys.label (Keys.keyAction False 3 0 "2") == "select1"
        , Keys.label (Keys.keyAction False 3 0 "5") == "select2"
        , Keys.label (Keys.keyAction False 3 2 "j") == "select2"
        , Keys.label (Keys.keyAction False 3 1 "Enter") == "ignore"
        , Keys.label (Keys.keyAction False 0 0 "a") == "ignore"
        , Keys.label (Keys.keyAction True 3 0 "a") == "ignore"
        , Keys.label (Keys.keyAction True 3 0 "j") == "ignore"
        , Keys.label (Keys.keyAction True 3 0 "Enter") == "confirm"
        , Keys.label (Keys.keyAction True 3 0 "Escape") == "cancel"
        ]


-- A queue in flight or failed never renders the empty-queue text; only a
-- loaded queue with total 0 does, and a loaded page with units has no status
-- line at all.
queueStateTextsDistinct : Bool
queueStateTextsDistinct =
    let
        boom =
            Error.unexpected "boom"

        empty =
            { units = [], total = 0, dbName = "index.db", dbBytes = 4096, next = Nothing }

        drained =
            { empty | total = 41000 }

        full =
            { drained | units = [ sampleQueuedUnit ] }
    in
    List.all identity
        [ Queue.queueStatusText Loading == Just "Loading queue…"
        , Queue.queueStatusText (Loaded empty) == Just "No units queued."
        , Queue.queueStatusText (Failed boom) == Just ("Queue failed to load: " ++ Error.toString boom)
        , Queue.queueStatusText Loading /= Queue.queueStatusText (Loaded empty)
        , Queue.queueStatusText (Failed boom) /= Queue.queueStatusText (Loaded empty)
        , Queue.queueStatusText (Loaded drained) == Just "No units to review on this page."
        , Queue.queueStatusText (Loaded full) == Nothing
        , Queue.pageHeaderText full == "index.db · 4.0 KB · showing 1 of 41000"
        , Format.byteSize 512 == "512 B"
        ]


sampleQueuedUnit : Queue.QueuedUnit
sampleQueuedUnit =
    { unit =
        { uid = "u-sample"
        , change = "new"
        , oldHash = Nothing
        , newHash = Nothing
        , path = "ipe:src/Main.ipe"
        , kind = "module"
        , name = "Main"
        , qualified = "Main"
        , lineStart = 1
        , lineEnd = 1
        , facing = "internal"
        , purpose = Nothing
        , attested = Index.UnknownScheme "hash-sample"
        , updatedSha = "sha-sample"
        , view = Stale UnverifiableHash
        }
    , changed = Nothing
    }


-- ── shared view/hash vectors ──────────────────────────────────────────────
--
-- The Ipê view rule and attestation agree with ipe-index's on every row of
-- the shared vectors file, and a row ipe-index refuses is refused here too.
-- Red if the trailing-newline drop or the `\r` keep rule changes, or if a
-- range past the file is clamped instead of refused.
type alias HashVector =
    { name : String
    , src : String
    , startLine : Int
    , endLine : Int
    , view : Maybe String
    , hash : Maybe String
    }


viewHashVectors : Task.Task Error Bool
viewHashVectors =
    do
        cwd <- System.cwd ()
        path <- Task.fromResult (Path.fromString (vectorsPath cwd))
        text <- File.readFileLimit path (ByteSize.kib 64)
        vectors <- Task.fromResult (Decode.decodeString (Decode.list vectorDecoder) text)
        Task.succeed (List.length vectors >= 13 && List.all vectorHolds vectors)


-- The vectors file beside this package: `tools/ipe-index/tests`, reached from
-- the `tools/code-review` working directory without a `..` segment.
vectorsPath : String -> String
vectorsPath cwd =
    let
        segments =
            String.split "/" cwd
    in
    String.join "/" (List.take (List.length segments - 1) segments) ++ "/ipe-index/tests/view_hash_vectors.json"


vectorDecoder : Decode.Decoder HashVector
vectorDecoder =
    Decode.map3
        (\name src rest ->
            { name = name
            , src = src
            , startLine = rest.startLine
            , endLine = rest.endLine
            , view = rest.view
            , hash = rest.hash
            }
        )
        (Decode.field "name" Decode.string)
        (Decode.field "src" Decode.string)
        (Decode.map4
            (\startLine endLine view hash -> { startLine = startLine, endLine = endLine, view = view, hash = hash })
            (Decode.field "start" Decode.int)
            (Decode.field "end" Decode.int)
            (Decode.field "view" (Decode.nullable Decode.string))
            (Decode.field "hash" (Decode.nullable Decode.string))
        )


vectorHolds : HashVector -> Bool
vectorHolds v =
    case Index.viewText v.startLine v.endLine v.src of
        Ok text ->
            case ( v.view, v.hash ) of
                ( Just view, Just hash ) ->
                    text == view && Index.attest text == hash

                _ ->
                    False

        Err (RangeOutOfFile _) ->
            v.view == Nothing && v.hash == Nothing

        Err _ ->
            False


report : List ( String, Bool ) -> String
report results =
    List.map
        (\( name, ok ) ->
            (if ok then
                "PASS"

            else
                "FAIL"
            )
                ++ " "
                ++ name
        )
        results
        |> String.join "\n"


finish : List ( String, Bool ) -> Task.Task Error ()
finish results =
    Io.println (report results)
        |> Task.andThen
            (\_ ->
                if List.all (\( _, ok ) -> ok) results then
                    Task.succeed ()

                else
                    System.exit 1
            )


main : Task.Task Error ()
main =
    let
        dbPath =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-review-b2-test.db"
    in
    Task.fromResult (Path.fromString dbPath)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> openReviewAt dbPath)
        |> Task.andThen (\db -> LibDb.migrate db |> Task.andThen (\_ -> allChecks db))
        |> Task.andThen
            (\results ->
                indexBridge
                    |> Task.map (\ok -> results ++ [ ( "index bridge loads queued units", ok ) ])
            )
        |> Task.andThen
            (\results ->
                traversalPathsRejected
                    |> Task.map (\ok -> results ++ [ ( "traversal paths rejected", ok ) ])
            )
        |> Task.andThen
            (\results ->
                storedPathRefusals
                    |> Task.map (\ok -> results ++ [ ( "stored paths outside the root refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                relativeRootAccepted
                    |> Task.map (\ok -> results ++ [ ( "relative root resolves against the working directory", ok ) ])
            )
        |> Task.andThen
            (\results ->
                unknownTagRefused
                    |> Task.map (\ok -> results ++ [ ( "stored path under an unbound tag refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                tagSelectsItsRoot
                    |> Task.map (\ok -> results ++ [ ( "each tag joins under its own root", ok ) ])
            )
        |> Task.andThen
            (\results ->
                tagGrammarMatchesWriter
                    |> Task.map (\ok -> results ++ [ ( "tag grammar matches the index writer", ok ) ])
            )
        |> Task.andThen
            (\results ->
                rootMapRefusals
                    |> Task.map (\ok -> results ++ [ ( "empty and duplicate-tag root maps refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                rootRefusalEscapesEnv
                    |> Task.map (\ok -> results ++ [ ( "root refusal escapes the env value", ok ) ])
            )
        |> Task.andThen
            (\results ->
                diagnosticsNeverRaw
                    |> Task.map (\ok -> results ++ [ ( "every path refusal describes itself without raw hazards", ok ) ])
            )
        |> Task.andThen
            (\results ->
                dbRefusalNamesOnlyVariable
                    |> Task.map (\ok -> results ++ [ ( "index db refusal names only the variable", ok ) ])
            )
        |> Task.andThen
            (\results ->
                Task.succeed
                    (results
                        ++ [ ( "safe text escapes exactly the log-hazard set", safeTextHazardTable )
                        , ( "describe escapes the stored path", describeEscapesStoredPath )
                        , ( "a literal backslash cannot forge an escape", backslashCannotForge )
                        , ( "a quote cannot forge a quoted boundary", quoteCannotForgeBoundary )
                        , ( "queue failure line escapes its error", sinkRendersEscape )
                        ]
                    )
            )
        |> Task.andThen
            (\results ->
                badRootsRefused
                    |> Task.map (\ok -> results ++ [ ( "blank, missing and non-directory roots refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                badIndexDbRefused
                    |> Task.map (\ok -> results ++ [ ( "unusable index db locations refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                failedWritesKeepTheirError
                    |> Task.map (\ok -> results ++ [ ( "failed writes keep their error", ok ) ])
            )
        |> Task.andThen
            (\results ->
                lostCursorInsertRefreshes
                    |> Task.map (\ok -> results ++ [ ( "cursor insert that lost the race refreshes the winner", ok ) ])
            )
        |> Task.andThen
            (\results ->
                blockedCursorInsertKeepsItsError
                    |> Task.map (\ok -> results ++ [ ( "cursor insert failing off the key keeps its error", ok ) ])
            )
        |> Task.andThen
            (\results ->
                dbUrlsCarryAppMode
                    |> Task.map (\ok -> results ++ [ ( "db urls carry only the app's open mode", ok ) ])
            )
        |> Task.andThen
            (\results ->
                relativeRootLoadsQueue
                    |> Task.map (\ok -> results ++ [ ( "relative root loads the queue", ok ) ])
            )
        |> Task.andThen
            (\results ->
                oversizedSourceRefused
                    |> Task.map (\ok -> results ++ [ ( "source file past the read ceiling refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                drainFlow
                    |> Task.map (\ok -> results ++ [ ( "decided unit drained from queue", ok ) ])
            )
        |> Task.andThen
            (\results ->
                drainKeepsRequeuedChange
                    |> Task.map (\ok -> results ++ [ ( "re-queued change survives the drain", ok ) ])
            )
        |> Task.andThen
            (\results ->
                unitPageStatesDistinct
                    |> Task.map (\ok -> results ++ [ ( "unit page states are distinct", ok ) ])
            )
        |> Task.andThen
            (\results ->
                historyRoundtrip
                    |> Task.map (\ok -> results ++ [ ( "review history roundtrip", ok ) ])
            )
        |> Task.andThen
            (\results ->
                changeReenqueue
                    |> Task.map (\ok -> results ++ [ ( "changed unit resurfaced at head, unchanged stays hidden", ok ) ])
            )
        |> Task.andThen
            (\results ->
                pagesCoverQueueOnce
                    |> Task.map (\ok -> results ++ [ ( "queue pages bound to pageSize and cover the queue once", ok ) ])
            )
        |> Task.andThen
            (\results ->
                deletedRowsNotQueued
                    |> Task.map (\ok -> results ++ [ ( "deleted queue rows neither listed nor counted", ok ) ])
            )
        |> Task.andThen
            (\results ->
                dbSizeAndMissingDb
                    |> Task.map (\ok -> results ++ [ ( "db size positive, missing index db fails the queue", ok ) ])
            )
        |> Task.andThen
            (\results ->
                Task.succeed
                    (results
                        ++ [ ( "links resolve internal and external", linksResolve )
                        , ( "link tokens: no self-links, urls strip punctuation", linksSubstring )
                        ]
                    )
            )
        |> Task.andThen
            (\results ->
                unitPageLoad
                    |> Task.map (\ok -> results ++ [ ( "unit page loads by uid, names resolve", ok ) ])
            )
        |> Task.andThen
            (\results ->
                Task.succeed
                    (results
                        ++ [ ( "keyboard shortcuts map to the button msgs", testKeys )
                        , ( "queue state texts distinguish loading/empty/failed/loaded", queueStateTextsDistinct )
                        ]
                    )
            )
        |> Task.andThen
            (\results ->
                driftedSourceNotShown
                    |> Task.map (\ok -> results ++ [ ( "a drifted unit's source is withheld", ok ) ])
            )
        |> Task.andThen
            (\results ->
                rangePastFileIsStale
                    |> Task.map (\ok -> results ++ [ ( "a span past the file is refused, not clamped", ok ) ])
            )
        |> Task.andThen
            (\results ->
                legacyHashUnverifiable
                    |> Task.map (\ok -> results ++ [ ( "an unprefixed or foreign-scheme hash is unverifiable", ok ) ])
            )
        |> Task.andThen
            (\results ->
                oneMissingFileIsolated
                    |> Task.map (\ok -> results ++ [ ( "one missing file fails only its unit", ok ) ])
            )
        |> Task.andThen
            (\results ->
                decideRecordsShownHash
                    |> Task.map (\ok -> results ++ [ ( "a shown unit is decided under its attested hash", ok ) ])
            )
        |> Task.andThen
            (\results ->
                approveRefusedAfterDrift
                    |> Task.map (\ok -> results ++ [ ( "a decision after the file drifted is refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                approveRefusedAfterReindex
                    |> Task.map (\ok -> results ++ [ ( "a decision after a re-index is refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                approveRefusedAfterUnitDeleted
                    |> Task.map (\ok -> results ++ [ ( "a decision on a unit gone from the index is refused", ok ) ])
            )
        |> Task.andThen
            (\results ->
                staleRefuseAlsoRefused
                    |> Task.map (\ok -> results ++ [ ( "a stale unit cannot be refused either", ok ) ])
            )
        |> Task.andThen
            (\results ->
                viewHashVectors
                    |> Task.map (\ok -> results ++ [ ( "view and attestation match the shared ipe-index vectors", ok ) ])
            )
        |> Task.andThen
            (\results ->
                removeDbFile dbPath
                    |> Task.map (\_ -> results)
            )
        |> Task.andThen finish


removeDbFile : String -> Task.Task Error ()
removeDbFile dbPath =
    Task.fromResult (Path.fromString dbPath)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
