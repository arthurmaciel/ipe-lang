import TestSupport exposing (openReviewAt)
import DbTests
import ViewTests
import IndexTests
import QueueTests
import LinksTests
import SafeTextTests
import RepoPathTests
import SettingsTests


-- Every test module must contribute at least one check: an empty list from
-- any module is a wiring bug (a split file never wired into the aggregator,
-- or a `checks` that silently returns nothing), not a passing run.
contributesChecks : String -> List ( String, Bool ) -> Task.Task Error (List ( String, Bool ))
contributesChecks moduleName results =
    if List.isEmpty results then
        Task.fail (Error.unexpected (moduleName ++ " contributed no checks"))

    else
        Task.succeed results


gatherChecks : Db -> Task.Task Error (List ( String, Bool ))
gatherChecks db =
    Task.sequence
        [ DbTests.checks db |> Task.andThen (contributesChecks "DbTests")
        , ViewTests.checks db |> Task.andThen (contributesChecks "ViewTests")
        , IndexTests.checks db |> Task.andThen (contributesChecks "IndexTests")
        , QueueTests.checks db |> Task.andThen (contributesChecks "QueueTests")
        , LinksTests.checks db |> Task.andThen (contributesChecks "LinksTests")
        , SafeTextTests.checks db |> Task.andThen (contributesChecks "SafeTextTests")
        , RepoPathTests.checks db |> Task.andThen (contributesChecks "RepoPathTests")
        , SettingsTests.checks db |> Task.andThen (contributesChecks "SettingsTests")
        ]
        |> Task.map List.concat


report : List ( String, Bool ) -> String
report results =
    List.map
        (\( name, ok ) ->
            (if ok then
                "PASS"

            else
                "FAIL"
            )
                ++ " "
                ++ name
        )
        results
        |> String.join "\n"


finish : List ( String, Bool ) -> Task.Task Error ()
finish results =
    Io.println (report results)
        |> Task.andThen
            (\_ ->
                if List.all (\( _, ok ) -> ok) results then
                    Task.succeed ()

                else
                    System.exit 1
            )


main : Task.Task Error ()
main =
    let
        dbPath =
            System.getenvOr "TMPDIR" "/tmp" ++ "/ipe-review-b2-test.db"
    in
    Task.fromResult (Path.fromString dbPath)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> openReviewAt dbPath)
        |> Task.andThen (\db -> LibDb.migrate db |> Task.andThen (\_ -> gatherChecks db))
        |> Task.andThen
            (\results ->
                removeDbFile dbPath
                    |> Task.map (\_ -> results)
            )
        |> Task.andThen finish


removeDbFile : String -> Task.Task Error ()
removeDbFile dbPath =
    Task.fromResult (Path.fromString dbPath)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
