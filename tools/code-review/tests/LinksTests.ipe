-- ── internal/external linking ───────────────────────────────────────────
--
-- Identifier tokens in a unit's source resolve against the index's qualified
-- names (internal) or http(s) URLs (external); the unit's own name never
-- links to itself and punctuation is stripped from tokens.
linksResolve : Bool
linksResolve =
    let
        units =
            [ ( "Lib.answer", "u-a" )
            , ( "Lib.answer2", "u-b" )
            , ( "Main.main", "u-m" )
            ]

        got =
            Links.resolve
                "Lib.answer"
                units
                "use Lib.answer();\nLib.answer2 helper https://docs.rs/serde\nMain.main() Main.main"

        want =
            [ Links.Internal (SafeText.renderForeign "Lib.answer2") "u-b"
            , Links.External "https://docs.rs/serde"
            , Links.Internal (SafeText.renderForeign "Main.main") "u-m"
            ]
    in
    List.map Links.linkKey got
        == List.map Links.linkKey want
        && List.map (\l -> SafeText.toString (Links.label l)) got
        == [ "→ Lib.answer2", "↗ https://docs.rs/serde", "→ Main.main" ]



linksSubstring : Bool
linksSubstring =
    let
        noSelf =
            List.isEmpty (Links.resolve "Main" [ ( "Main", "u-x" ) ] "Main.main()")

        urlPunct =
            Links.resolve "" [] "(https://a.io/b,)"
                == [ Links.External "https://a.io/b" ]

        firstWins =
            List.map Links.linkKey (Links.resolve "" [ ( "A", "u-a" ), ( "B", "u-b" ) ] "A B A https://x.io B")
                == [ "i:u-a", "i:u-b", "e:https://x.io" ]
    in
    noSelf && urlPunct && firstWins


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.succeed
        [ ( "links resolve internal and external", linksResolve )
        , ( "link tokens: no self-links, urls strip punctuation, first occurrence wins", linksSubstring )
        ]
