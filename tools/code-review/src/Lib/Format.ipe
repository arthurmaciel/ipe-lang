module Lib.Format exposing (formatReviewedAt, numberedLines, percent)

import Ipe.List as List
import Ipe.String


-- Renders a Unix millisecond timestamp as UTC "YYYY-MM-DD HH:MM:SS" via the
-- civil-from-days algorithm (Hinnant). The stdlib's Time.timeString only
-- renders the time-of-day, which is useless across days in a review history.
-- Pure: no kernel calls, so it is testable and stable across platforms.
formatReviewedAt : Int -> String
formatReviewedAt ms =
    let
        seconds =
            ms // 1000

        days =
            seconds // 86400

        secOfDay =
            modBy 86400 seconds

        h =
            secOfDay // 3600

        m =
            modBy 60 (secOfDay // 60)

        sec =
            modBy 60 secOfDay

        z =
            days + 719468

        era =
            z // 146097

        doe =
            z - era * 146097

        yoe =
            (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365

        y =
            yoe + era * 400

        doy =
            doe - (365 * yoe + yoe // 4 - yoe // 100)

        mp =
            (5 * doy + 2) // 153

        d =
            doy - (153 * mp + 2) // 5 + 1

        mth =
            if mp < 10 then
                mp + 3

            else
                mp - 9

        yr =
            if mth <= 2 then
                y + 1

            else
                y
    in
    String.fromInt yr
        ++ "-"
        ++ pad2 mth
        ++ "-"
        ++ pad2 d
        ++ " "
        ++ pad2 h
        ++ ":"
        ++ pad2 m
        ++ ":"
        ++ pad2 sec


pad2 : Int -> String
pad2 n =
    String.padLeft 2 '0' (String.fromInt n)


-- Splits source text into (absolute line number, line text) pairs, numbering
-- from the unit's line_start so reviewers can cite the exact lines shown in
-- the index (ipe:src/Lib.rs:14 style citations stay consistent with the gutter).
numberedLines : Int -> String -> List ( Int, String )
numberedLines start text =
    text
        |> String.lines
        |> List.indexedMap (\i line -> ( start + i, line ))


-- Floor percentage of k decided out of n queued; 0% when nothing is queued
-- (a 0/0 division would otherwise be undefined).
percent : Int -> Int -> String
percent k n =
    if n == 0 then
        "0%"

    else
        String.fromInt ((k * 100) // n) ++ "%"
