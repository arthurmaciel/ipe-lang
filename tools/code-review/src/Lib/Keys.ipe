module Lib.Keys exposing (KeyAction(..), keyAction, label)

import Ipe.String as String


-- B10: page-level keyboard shortcuts. The mapping lives here, pure and
-- testable; Main only translates each KeyAction into the same Msg the
-- matching button dispatches, so the buttons stay the single source of truth.
type KeyAction
    = ApproveSelected
    | RefuseSelected
    | Select Int
    | ConfirmRefuse
    | CancelRefuse
    | Ignore


label : KeyAction -> String
label action =
    case action of
        ApproveSelected ->
            "approve"

        RefuseSelected ->
            "refuse"

        Select i ->
            "select" ++ String.fromInt i

        ConfirmRefuse ->
            "confirm"

        CancelRefuse ->
            "cancel"

        Ignore ->
            "ignore"


-- panelOpen: a refuse-reason panel is showing; its text input must not be
-- hijacked by shortcuts, so only Enter (confirm) and Escape (cancel) act.
-- len: queue length; 0 disables every shortcut. selected: current index.
keyAction : Bool -> Int -> Int -> String -> KeyAction
keyAction panelOpen len selected key =
    if panelOpen then
        case key of
            "Enter" ->
                ConfirmRefuse

            "Escape" ->
                CancelRefuse

            _ ->
                Ignore

    else if len == 0 then
        Ignore

    else
        case key of
            "a" ->
                ApproveSelected

            "r" ->
                RefuseSelected

            "j" ->
                Select (min (selected + 1) (len - 1))

            "k" ->
                Select (max (selected - 1) 0)

            "g" ->
                Select 0

            "1" ->
                Select (min 0 (len - 1))

            "2" ->
                Select (min 1 (len - 1))

            "3" ->
                Select (min 2 (len - 1))

            "4" ->
                Select (min 3 (len - 1))

            "5" ->
                Select (min 4 (len - 1))

            _ ->
                Ignore
