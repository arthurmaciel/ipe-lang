module Lib.Queue exposing (QueuedUnit, classifyWith, loadPage)

import Ipe.List as List
import Ipe.Result as Result exposing (Result(..))
import Ipe.Task as Task
import Ipe.Time.Timestamp as Timestamp
import Lib.Db as LibDb
import Lib.Index as Index
import Lib.Page exposing (PageBounds)


-- A pending unit plus its resurfacing state. `changed` is Just the previous
-- review when this uid was already decided on an OLDER body hash: the author
-- edited the code after the review, so the unit must be reviewed again.
type alias QueuedUnit =
    { unit : Index.Unit
    , changed : Maybe LibDb.ReviewRow
    }


-- One page of the queue as the review app sees it: the page's units from the
-- index db plus every review row for their uids, fetched in one query.
loadPage : PageBounds -> Task.Task Error (List QueuedUnit)
loadPage bounds =
    do
        db <- LibDb.open
        units <- Index.loadPendingPage bounds
        reviews <- LibDb.findReviewsFor db (List.map (\u -> u.uid) units)
        Task.fromResult (classifyWith reviews units)


-- Classifies a page of units against their review rows:
--
--   * a unit whose exact (uid, body_hash) pair was already decided is
--     hidden — the first review of a pair is final and the drain loop
--     already cleared it; a re-queued identical unit is a no-op;
--   * a unit decided on an older hash resurfaces at the head of the page,
--     flagged with its latest review (newest reviewed_at, then lowest
--     body_hash);
--   * never-seen units keep the index's enqueue order after resurfaced ones.
--
-- A malformed decision on the exact pair fails the page with a typed error.
classifyWith : List LibDb.ReviewRow -> List Index.Unit -> Result Error (List QueuedUnit)
classifyWith reviews units =
    units
        |> List.map (classifyUnit reviews)
        |> Result.combine
        |> Result.map prioritize


classifyUnit : List LibDb.ReviewRow -> Index.Unit -> Result Error (Maybe QueuedUnit)
classifyUnit reviews unit =
    let
        forUid =
            List.filter (\r -> r.uid == unit.uid) reviews
    in
    case List.head (List.filter (\r -> r.bodyHash == unit.bodyHash) forUid) of
        Just exact ->
            Result.map (\_ -> Nothing) (LibDb.decodeDecision exact)

        Nothing ->
            Ok (Just { unit = unit, changed = latest forUid })


latest : List LibDb.ReviewRow -> Maybe LibDb.ReviewRow
latest rows =
    List.foldl
        (\row best ->
            case best of
                Just b ->
                    if newer row b then
                        Just row

                    else
                        best

                Nothing ->
                    Just row
        )
        Nothing
        rows


newer : LibDb.ReviewRow -> LibDb.ReviewRow -> Bool
newer a b =
    let
        ta =
            Timestamp.toUnixMillis a.reviewedAt

        tb =
            Timestamp.toUnixMillis b.reviewedAt
    in
    ta > tb || (ta == tb && a.bodyHash < b.bodyHash)


prioritize : List (Maybe QueuedUnit) -> List QueuedUnit
prioritize classified =
    let
        ( changed, fresh ) =
            partition (List.concatMap collect classified)
    in
    changed ++ fresh


collect : Maybe QueuedUnit -> List QueuedUnit
collect mb =
    case mb of
        Just q ->
            [ q ]

        Nothing ->
            []


-- Stable partition: resurfaced (changed) units first, fresh units after,
-- each group keeping the index's enqueue order.
partition : List QueuedUnit -> ( List QueuedUnit, List QueuedUnit )
partition qs =
    List.foldr
        (\q ( changed, fresh ) ->
            if q.changed == Nothing then
                ( changed, q :: fresh )

            else
                ( q :: changed, fresh )
        )
        ( [], [] )
        qs
