module Lib.Queue exposing (Progress, QueuePage, QueueState(..), QueuedUnit, UnitPageState(..), decide, loadPage, loadUnitView, pageHeaderText, queueStatusText, resyncPageCeiling, resyncReviewed, resyncReviewedWithin, sourceStatusText, stateFromResult, unitPageFromResult, unitPageStatusText)

import Ipe.Db as Db
import Ipe.Error as Error
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Lib.Db as LibDb
import Lib.Format as Format
-- `Index.Unit` names `Highlight.Lang`, and an imported alias resolves its
-- qualified names in this module.
import Lib.Highlight as Highlight
import Lib.Index as Index exposing (SourceView(..), StaleReason(..))
import Lib.Links as Links
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings


-- A pending unit plus its resurfacing state. `changed` is Just the previous
-- review when this uid was already decided on an OLDER body hash: the author
-- edited the code after the review, so the unit must be reviewed again.
type alias QueuedUnit =
    { unit : Index.Unit
    , changed : Maybe LibDb.ReviewRow
    }


-- One loaded page of the queue. `total` counts the whole queue (never this
-- page's length); `next` is the cursor of the following page, Nothing on the
-- last page; `dbName` is the index file's name, rendered once.
type alias QueuePage =
    { units : List QueuedUnit
    , total : Int
    , dbName : SafeText
    , dbBytes : Int
    , next : Maybe Index.Cursor
    , progress : Progress
    }


-- Review progress over the index as it stands, never from a session:
-- `reviewed` counts the units whose current body hash has a decision, `total`
-- the units reviewed or still queued. Both are one aggregate over the index's
-- `reviewed` table, the copy of the review database's decided pairs that each
-- drain extends; every load first checks the copy's row count against the
-- review database and rebuilds the copy on a mismatch. Deciding a unit moves
-- it from queued to reviewed, so `total` holds while the queue drains, and a
-- reload or a second tab reads the same numbers.
type alias Progress =
    { reviewed : Int
    , total : Int
    }


-- The progress of the index, with the `reviewed` copy checked fresh first:
-- when its row count differs from the review database's decision count (a
-- decision whose drain failed, a replaced index file, a deleted review row),
-- the copy is rebuilt once and the row read again. It never loops.
currentProgress : Db.Db -> Task.Task Error Progress
currentProgress db =
    do
        first <- Index.loadProgress
        decisions <- LibDb.countDecisions db
        if first.mirrored == decisions then
            Task.succeed (progressFrom first)

        else
            do
                resyncReviewed db
                second <- Index.loadProgress
                Task.succeed (progressFrom second)


progressFrom : Index.ProgressRow -> Progress
progressFrom row =
    { reviewed = row.reviewed, total = row.total }


-- The most review-database pages one rebuild of the `reviewed` copy reads,
-- `pairPageSize` pairs each.
resyncPageCeiling : Int
resyncPageCeiling =
    10000


-- The `reviewed` copy rebuilt from the review database: one index
-- transaction empties it and drains every decided pair, so a pair's
-- undrained queue row leaves too. Returns the count of pairs copied.
resyncReviewed : Db.Db -> Task.Task Error Int
resyncReviewed db =
    resyncReviewedWithin resyncPageCeiling db


-- `resyncReviewed` reading at most `ceiling` pages of decided pairs. A review
-- database holding more refuses the rebuild and rolls it back, leaving the
-- copy as it was.
resyncReviewedWithin : Int -> Db.Db -> Task.Task Error Int
resyncReviewedWithin ceiling db =
    Index.rebuildReviewed (\conn -> refillPages ceiling db conn 0 0 Nothing)


-- Page `pagesRead` of decided pairs after `cursor`, each drained on `conn`;
-- `copied` counts the pairs drained so far. A short page is the last one. A
-- non-empty page past the ceiling fails the whole rebuild.
refillPages : Int -> Db.Db -> Db.Db -> Int -> Int -> Maybe ( String, String ) -> Task.Task Error Int
refillPages ceiling db conn pagesRead copied cursor =
    do
        pairs <- LibDb.decidedPairsAfter db cursor
        if List.isEmpty pairs then
            Task.succeed copied

        else if pagesRead >= ceiling then
            Task.fail (resyncCeilingRefusal ceiling)

        else
            do
                pairs
                    |> List.map (\( uid, hash ) -> Index.drainPair conn uid hash)
                    |> Task.sequence
                if List.length pairs < LibDb.pairPageSize then
                    Task.succeed (copied + List.length pairs)

                else
                    refillPages ceiling db conn (pagesRead + 1) (copied + List.length pairs) (List.head (List.reverse pairs))


resyncCeilingRefusal : Int -> Error
resyncCeilingRefusal ceiling =
    Error.unavailable
        ("the review database holds more than "
            ++ String.fromInt (ceiling * LibDb.pairPageSize)
            ++ " decisions, past the "
            ++ String.fromInt ceiling
            ++ "-page ceiling of a review progress rebuild; the progress copy is left unchanged"
        )


-- The queue view's state. An empty queue is only `Loaded` with `total == 0`,
-- so a load in flight or a failed load can never render as empty.
type QueueState
    = Loading
    | Loaded QueuePage
    | Failed Error


-- The one way a decision is recorded: only a shown source can be decided,
-- and only after `Index.reverify` re-proves it, so the hash written is the
-- hash of the bytes the reviewer saw. A stale or unreadable unit is refused
-- before any I/O.
decide : Db.Db -> Index.Unit -> LibDb.Decision -> Task.Task Error ( Index.Attested, Int )
decide db unit decision =
    case unit.view of
        Shown shown ->
            do
                attested <- Index.reverify shown
                n <- LibDb.insertDecision db (Index.attestedUid attested) (Index.attestedHash attested) decision
                Task.succeed ( attested, n )

        Stale _ ->
            Task.fail notDecidable

        Unreadable _ ->
            Task.fail notDecidable


notDecidable : Error
notDecidable =
    Error.conflict "this unit's source is not verified, so it cannot be decided"


-- The unit page: loading, the unit with its links, no such unit, or a failed
-- load. A missing unit is its own state, never shown as still loading.
type UnitPageState
    = UnitLoading
    | UnitLoaded Index.Unit (List Links.Link)
    | UnitNotFound
    | UnitFailed Error


unitPageFromResult : Result Error (Maybe ( Index.Unit, List Links.Link )) -> UnitPageState
unitPageFromResult result =
    case result of
        Ok (Just ( unit, links )) ->
            UnitLoaded unit links

        Ok Nothing ->
            UnitNotFound

        Err e ->
            UnitFailed e


-- The one-line text for a unit page that has no unit to show; Nothing once
-- the unit is loaded.
unitPageStatusText : UnitPageState -> Maybe String
unitPageStatusText state =
    case state of
        UnitLoading ->
            Just "Loading unit…"

        UnitNotFound ->
            Just "No unit with this id is in the index."

        UnitFailed e ->
            Just ("Unit load failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        UnitLoaded _ _ ->
            Nothing


-- Why a unit's source is withheld, in place of the source and the decision
-- buttons; Nothing only for a verified view.
sourceStatusText : Index.SourceView -> Maybe String
sourceStatusText view =
    case view of
        Shown _ ->
            Nothing

        Stale Drifted ->
            Just "Source changed since it was indexed; re-run `ipe-index index` to review it."

        Stale (RangeOutOfFile r) ->
            Just ("The file now has " ++ String.fromInt r.lineCount ++ " lines, fewer than this unit's range; re-run `ipe-index index` to review it.")

        Stale UnverifiableHash ->
            Just "This unit's hash predates source attestation; re-run `ipe-index index` to verify it."

        Unreadable e ->
            Just ("Source unreadable: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))


-- The unit page loads the unit by uid (decided units have no change_queue
-- row, so the page queries units directly) and resolves every identifier
-- token of its verified source against the index's qualified names. Nothing
-- when no unit has this uid.
loadUnitView : String -> Task.Task Error (Maybe ( Index.Unit, List Links.Link ))
loadUnitView uid =
    do
        mb <- Index.loadUnitByUid uid
        case mb of
            Just unit ->
                do
                    qs <- Index.qualifiedUids
                    Task.succeed (Just ( unit, linksFor unit qs ))

            Nothing ->
                Task.succeed Nothing


-- Jump links come only from verified source; a withheld view links nothing.
-- The unit's own name, which never links, is its raw qualified name from the
-- same table the links resolve against (`unit.qualified` is display text).
linksFor : Index.Unit -> List ( String, String ) -> List Links.Link
linksFor unit qs =
    case unit.view of
        Shown shown ->
            Links.resolve (ownQualified unit.uid qs) qs (Index.shownText shown)

        Stale _ ->
            []

        Unreadable _ ->
            []


ownQualified : String -> List ( String, String ) -> String
ownQualified uid qs =
    case List.find (\( _, u ) -> u == uid) qs of
        Just ( q, _ ) ->
            q

        Nothing ->
            ""


stateFromResult : Result Error QueuePage -> QueueState
stateFromResult result =
    case result of
        Ok page ->
            Loaded page

        Err e ->
            Failed e


-- The one-line text for a state that has no unit list to show; Nothing for a
-- loaded page that holds units.
queueStatusText : QueueState -> Maybe String
queueStatusText state =
    case state of
        Loading ->
            Just "Loading queue…"

        Failed e ->
            Just ("Queue failed to load: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        Loaded page ->
            if page.total == 0 then
                Just "No units queued."

            else if List.isEmpty page.units then
                Just "No units to review on this page."

            else
                Nothing


-- The queue header: database name, size, and how many of the queued units
-- this page shows.
pageHeaderText : QueuePage -> String
pageHeaderText page =
    String.concat
        [ SafeText.toString page.dbName
        , " · "
        , Format.byteSize page.dbBytes
        , " · showing "
        , String.fromInt (List.length page.units)
        , " of "
        , String.fromInt page.total
        ]


-- One page of the queue at `cursor`, as the review app sees it:
--
--   * a unit whose exact (uid, body_hash) pair was already decided is
--     hidden — the first review of a pair is final and the drain loop
--     already cleared it; a re-queued identical unit is a no-op;
--   * a unit decided on an older hash resurfaced at the head, flagged with
--     its previous review;
--   * never-seen units keep the index's enqueue order after resurfaced ones.
--
-- Only one page of the queue is classified per load, so the resurfaced-first
-- order holds within the page.
--
-- The page also carries the whole-queue count, the database size and the
-- review progress. Progress is read first, so a rebuild of the `reviewed`
-- copy that drains an undrained decided pair is already reflected in the
-- page's rows and count.
loadPage : Index.Cursor -> Task.Task Error QueuePage
loadPage cursor =
    do
        settings <- Settings.indexSettings
        db <- LibDb.open
        progress <- currentProgress db
        rows <- Index.loadPendingPage cursor
        total <- Index.countPending
        bytes <- Index.dbBytes
        units <- classify db (List.map (\r -> r.unit) rows)
        Task.succeed
            { units = units
            , total = total
            , dbName = SafeText.renderForeign (Settings.dbFileName settings.db)
            , dbBytes = bytes
            , next = nextCursor rows
            , progress = progress
            }


-- A full page may have rows after it; a short page is the last one.
nextCursor : List Index.PendingRow -> Maybe Index.Cursor
nextCursor rows =
    if List.length rows < Index.pageSize then
        Nothing

    else
        rows
            |> List.reverse
            |> List.head
            |> Maybe.map (\r -> Index.After { enqueuedAt = r.enqueuedAt, uid = r.unit.uid })


classify : Db.Db -> List Index.Unit -> Task.Task Error (List QueuedUnit)
classify db units =
    units
        |> List.map (classifyUnit db)
        |> Task.sequence
        |> Task.map prioritize


classifyUnit : Db.Db -> Index.Unit -> Task.Task Error (Maybe QueuedUnit)
classifyUnit db unit =
    do
        decided <- LibDb.findDecision db unit.uid (Index.storedHash unit.attested)
        case decided of
            Just _ ->
                Task.succeed Nothing

            Nothing ->
                do
                    old <- LibDb.findLatestForUid db unit.uid
                    Task.succeed (Just { unit = unit, changed = old })


prioritize : List (Maybe QueuedUnit) -> List QueuedUnit
prioritize classified =
    let
        ( changed, fresh ) =
            partition (List.concatMap collect classified)
    in
    changed ++ fresh


collect : Maybe QueuedUnit -> List QueuedUnit
collect mb =
    case mb of
        Just q ->
            [ q ]

        Nothing ->
            []


-- Stable partition: resurfaced (changed) units first, fresh units after,
-- each group keeping the index's enqueue order.
partition : List QueuedUnit -> ( List QueuedUnit, List QueuedUnit )
partition qs =
    List.foldr
        (\q ( changed, fresh ) ->
            if q.changed == Nothing then
                ( changed, q :: fresh )

            else
                ( q :: changed, fresh )
        )
        ( [], [] )
        qs
