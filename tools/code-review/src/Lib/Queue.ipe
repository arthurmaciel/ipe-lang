module Lib.Queue exposing (QueueState(..), QueuedUnit, load, queueStatusText)

import Ipe.Db as Db
import Ipe.List as List
import Ipe.Task as Task
import Lib.Db as LibDb
import Lib.Index as Index


-- A pending unit plus its resurfacing state. `changed` is Just the previous
-- review when this uid was already decided on an OLDER body hash: the author
-- edited the code after the review, so the unit must be reviewed again.
type alias QueuedUnit =
    { unit : Index.Unit
    , changed : Maybe LibDb.ReviewRow
    }


-- The queue as the review app sees it, one pass over both databases:
--
--   * a unit whose exact (uid, body_hash) pair was already decided is
--     hidden — the first review of a pair is final (B6) and the drain loop
--     already cleared it; a re-queued identical unit is a no-op;
--   * a unit decided on an older hash resurfaced at the head, flagged with
--     its previous review (B8 change re-enqueue);
--   * never-seen units keep the index's enqueue order after resurfaced ones.
--
-- The view's model of "how far has the queue load gotten": loading, failed
-- with a reason, or loaded with (possibly zero) units. Kept as one sum type
-- rather than a separate list + error field so "not loaded yet", "load
-- failed", and "loaded and genuinely empty" are three distinct, exhaustively
-- matched states instead of three field combinations only some of which are
-- meaningful (the representable-but-illegal shape #2913 reports: an empty
-- list stood in for both "still loading" and "truly empty").
type QueueState
    = QueueLoading
    | QueueLoaded (List QueuedUnit)
    | QueueFailed String


-- The single-line status text for the three states that are not "a queue
-- with units to show": Nothing means "the caller should render the detailed
-- list instead" — a QueueLoaded with units. Total over QueueState, so a
-- loading or failed queue can never fall through to the same "No units
-- queued yet." text an empty-but-loaded queue renders.
queueStatusText : QueueState -> Maybe String
queueStatusText state =
    case state of
        QueueLoading ->
            Just "Loading queue…"

        QueueFailed err ->
            Just ("Queue failed to load: " ++ err)

        QueueLoaded units ->
            if List.isEmpty units then
                Just "No units queued yet."

            else
                Nothing


-- `total` passes `Index.loadPending`'s honest whole-queue count through
-- unchanged — `items` is only this page's units after classification.
load : Task.Task Error { items : List QueuedUnit, total : Int }
load =
    do
        db <- LibDb.open
        pending <- Index.loadPending
        items <- classify db pending.units
        Task.succeed { items = items, total = pending.total }


classify : Db.Db -> List Index.Unit -> Task.Task Error (List QueuedUnit)
classify db units =
    units
        |> List.map (classifyUnit db)
        |> Task.sequence
        |> Task.map prioritize


classifyUnit : Db.Db -> Index.Unit -> Task.Task Error (Maybe QueuedUnit)
classifyUnit db unit =
    do
        decided <- LibDb.findDecision db unit.uid unit.bodyHash
        case decided of
            Just _ ->
                Task.succeed Nothing

            Nothing ->
                do
                    old <- LibDb.findLatestForUid db unit.uid
                    Task.succeed (Just { unit = unit, changed = old })


prioritize : List (Maybe QueuedUnit) -> List QueuedUnit
prioritize classified =
    let
        ( changed, fresh ) =
            partition (List.concatMap collect classified)
    in
    changed ++ fresh


collect : Maybe QueuedUnit -> List QueuedUnit
collect mb =
    case mb of
        Just q ->
            [ q ]

        Nothing ->
            []


-- Stable partition: resurfaced (changed) units first, fresh units after,
-- each group keeping the index's enqueue order.
partition : List QueuedUnit -> ( List QueuedUnit, List QueuedUnit )
partition qs =
    List.foldr
        (\q ( changed, fresh ) ->
            if q.changed == Nothing then
                ( changed, q :: fresh )

            else
                ( q :: changed, fresh )
        )
        ( [], [] )
        qs
