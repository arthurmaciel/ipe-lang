module Lib.Links exposing (Link(..), label, linkKey, resolve)

import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Set as Set
import Ipe.String as String
import Lib.SafeText as SafeText exposing (SafeText)


-- A link found in a unit's source, resolved against the index's unit table.
-- Internal links jump to the /unit/<uid> page of the callee; external links
-- open their URL. Resolution is purely lexical: identifier tokens are matched
-- against the qualified names of every indexed unit. An internal link's
-- label is the matched token rendered once into `SafeText`; an external
-- link keeps its raw URL for the `href` check, and `label` renders it.
type Link
    = Internal SafeText String
    | External String


-- Resolve the identifier tokens of a unit's source into links. The source's
-- own qualified name never links to itself; tokens that match no unit and are
-- not URLs produce nothing. The first occurrence of a link wins.
resolve : String -> List ( String, String ) -> String -> List Link
resolve selfQualified units source =
    source
        |> String.words
        |> List.map (stripPunct >> linkFor selfQualified units)
        |> List.filterMap identity
        |> dedup


linkFor : String -> List ( String, String ) -> String -> Maybe Link
linkFor selfQualified units token =
    if isUrl token then
        Just (External token)

    else if token == selfQualified then
        Nothing

    else
        case List.find (\( q, _ ) -> q == token) units of
            Just ( _, uid ) ->
                Just (Internal (SafeText.renderForeign token) uid)

            Nothing ->
                Nothing


isUrl : String -> Bool
isUrl token =
    String.startsWith "http://" token || String.startsWith "https://" token


-- Trailing/leading punctuation that lexers attach to identifiers: "foo();"
-- and "(foo)" must both resolve to foo.
stripPunct : String -> String
stripPunct token =
    String.fromList (List.reverse (dropPunct (List.reverse (dropPunct (String.toList token)))))


dropPunct : List Char -> List Char
dropPunct chars =
    case chars of
        c :: rest ->
            if isPunct c then
                dropPunct rest

            else
                chars

        [] ->
            []


-- Char literals for quote/backslash escapes crash the formatter (IPE-I0001
-- MalformedChar), so the punctuation set comes from a String instead.
punctChars : List Char
punctChars =
    String.toList "'()[]{},;.!?<>\"`:-="


isPunct : Char -> Bool
isPunct c =
    List.member c punctChars


-- First occurrence wins: one left-to-right pass keeps a link only when its
-- key is new. The seen set holds each link's comparable `linkKey`.
dedup : List Link -> List Link
dedup links =
    case List.foldl keepFirst ( Set.empty, [] ) links of
        ( _, kept ) ->
            List.reverse kept


keepFirst : Link -> ( Set String, List Link ) -> ( Set String, List Link )
keepFirst link ( seen, kept ) =
    if Set.member (linkKey link) seen then
        ( seen, kept )

    else
        ( Set.insert (linkKey link) seen, link :: kept )


-- The text a link shows, never raw: an internal link's rendered name, an
-- external link's URL with every control and bidi character escaped.
label : Link -> SafeText
label link =
    case link of
        Internal name _ ->
            SafeText.concat [ SafeText.literal "→ ", name ]

        External url ->
            SafeText.concat [ SafeText.literal "↗ ", SafeText.renderForeign url ]


linkKey : Link -> String
linkKey link =
    case link of
        Internal _ uid ->
            "i:" ++ uid

        External url ->
            "e:" ++ url
