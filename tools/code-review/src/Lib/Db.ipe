module Lib.Db exposing (Decision(..), Reason, ReviewRow, StoredReason, countDecisions, decidedPairsAfter, findDecision, findDecisions, findLatestForUid, insertDecision, insertDrainCursor, migrate, open, openAt, pairPageSize, parseReason, probe, reasonMaxChars, reasonText, recordDrain, storedReasonText)

import Ipe.Codec as Codec exposing (Codec(..), ColType(..), Shape(..))
import Ipe.Config as Config
import Ipe.Db as Db
import Ipe.Db.Decode
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Time.Timestamp as Timestamp exposing (Timestamp)
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings exposing (DbLocation)
import Migrations exposing (all)


type Decision
    = Approved
    | Refused Reason


-- Why a unit was refused: non-blank and at most `reasonMaxChars` characters.
-- Opaque: built only by `parseReason`, the one decode point for the
-- reviewer's text and for a stored reason, so an empty or unbounded reason
-- has no representation. It is shown only through `reasonText`.
type Reason
    = Reason String


-- The longest refusal reason, in characters.
reasonMaxChars : Int
reasonMaxChars =
    500


-- The reviewer's text as a `Reason`, or why it is not one.
parseReason : String -> Result Error Reason
parseReason raw =
    case storedReason raw of
        Valid reason ->
            Ok reason

        Blank _ ->
            Err (Error.invalidInput "a refusal needs a reason")

        Overlong text ->
            Err (Error.invalidInput ("a refusal reason is at most " ++ String.fromInt reasonMaxChars ++ " characters; this one has " ++ String.fromInt (String.length text)))


-- A refusal's reason as the review table holds it. A row written before the
-- reason bound, or edited outside this tool, may hold a reason that is not a
-- `Reason`; it is read as `Overlong` or `Blank` with its text kept only for a
-- faithful re-encode, so no stored row fails a read and its text is never
-- shown. Opaque: built only by `storedReason`, the one classification of a
-- reason's text, and shown only through `storedReasonText`.
type StoredReason
    = Valid Reason
    | Overlong String
    | Blank String


storedReason : String -> StoredReason
storedReason raw =
    if String.isEmpty (String.trim raw) then
        Blank raw

    else if String.length raw > reasonMaxChars then
        Overlong raw

    else
        Valid (Reason raw)


-- A stored reason as it may be shown: a valid one through `reasonText`, an
-- over-long one by its length only, a blank one as a note.
storedReasonText : StoredReason -> SafeText
storedReasonText stored =
    case stored of
        Valid reason ->
            reasonText reason

        Overlong text ->
            SafeText.concat
                [ SafeText.literal "reason not shown: "
                , SafeText.render (String.fromInt (String.length text))
                , SafeText.literal " characters, over the "
                , SafeText.render (String.fromInt reasonMaxChars)
                , SafeText.literal "-character limit"
                ]

        Blank _ ->
            SafeText.literal "reason not shown: it is blank"


storedReasonString : StoredReason -> String
storedReasonString stored =
    case stored of
        Valid reason ->
            reasonString reason

        Overlong text ->
            text

        Blank text ->
            text


-- A reason as it may be shown, with every control and bidi character escaped.
reasonText : Reason -> SafeText
reasonText reason =
    SafeText.renderForeign (reasonString reason)


reasonString : Reason -> String
reasonString reason =
    case reason of
        Reason r ->
            r


-- One row of the review table. `reviewedAt` is a typed instant — a moment in
-- time, not a bare count — so it can only be built from and read as a
-- `Timestamp`, never swapped for a plain `Int`. `reason` is `Just` exactly
-- for a refusal: a stored refusal's reason is classified by `storedReason`,
-- so a row breaking the bound still decodes, and an approval's reason column
-- is never read (the store's plain read returns SQL NULL as `""`, which must
-- not stand for a reason).
type alias ReviewRow =
    { uid : String
    , bodyHash : String
    , decision : String
    , reason : Maybe StoredReason
    , reviewedAt : Timestamp
    }


-- Codec for ReviewRow. Keys in `SRecord` and JSON object match the DB column
-- names so `Store.fromCodec` derives the correct column list from the shape.
reviewCodec : Codec ReviewRow
reviewCodec =
    Codec
        { enc =
            \row ->
                Encode.object
                    [ ( "uid", Encode.string row.uid )
                    , ( "body_hash", Encode.string row.bodyHash )
                    , ( "decision", Encode.string row.decision )
                    , ( "reason"
                      , case row.reason of
                            Just r ->
                                Encode.string (storedReasonString r)

                            Nothing ->
                                Encode.null
                      )
                    , ( "reviewed_at", Codec.toValue Codec.timestamp row.reviewedAt )
                    ]
        , mkDec =
            \_ ->
                Config.map5 makeRow
                    (Config.field "uid" Config.string)
                    (Config.field "body_hash" Config.string)
                    (Config.field "decision" Config.string)
                    (Config.field "reason" (Config.nullable Config.string))
                    (Config.field "reviewed_at" (Config.map Timestamp.fromUnixMillis Config.int))
                    |> Config.map rowFromStored
        , shp =
            SRecord
                [ ( "uid", CText )
                , ( "body_hash", CText )
                , ( "decision", CText )
                , ( "reason", CNull CText )
                , ( "reviewed_at", CTime )
                ]
        }


-- A stored row as read, before its reason is parsed.
type alias StoredRow =
    { uid : String
    , bodyHash : String
    , decision : String
    , reason : Maybe String
    , reviewedAt : Timestamp
    }


makeRow : String -> String -> String -> Maybe String -> Timestamp -> StoredRow
makeRow uid bodyHash decision reason reviewedAt =
    { uid = uid
    , bodyHash = bodyHash
    , decision = decision
    , reason = reason
    , reviewedAt = reviewedAt
    }


-- A stored row with its reason classified. Total: every row the table can
-- hold decodes, so one legacy row never fails a page.
rowFromStored : StoredRow -> ReviewRow
rowFromStored stored =
    { uid = stored.uid
    , bodyHash = stored.bodyHash
    , decision = stored.decision
    , reason =
        if stored.decision == "refuse" then
            Just (storedReason (Maybe.withDefault "" stored.reason))

        else
            Nothing
    , reviewedAt = stored.reviewedAt
    }


-- The typed store for the review table. `fromCodec` validates every column
-- identifier; the composite key records `PRIMARY KEY (uid, body_hash)`, so the
-- by-key operations fail closed and every access names both key columns. The
-- table itself comes from the hand-written migration, since `createSql` does
-- not render a composite key.
reviewStore : Result Error (Store ReviewRow)
reviewStore =
    Store.fromCodec "review" reviewCodec
        |> Result.map (\draft -> Store.public (Store.compositePrimaryKey2 .uid .bodyHash draft))


-- The startup check of `IPE_REVIEW_DB`: the review database is opened
-- (created when absent) and migrated, so an unwritable location stops the
-- server before it listens, naming the variable and the file.
probe : DbLocation -> Task.Task Error ()
probe loc =
    (do
        db <- openAt loc
        migrate db
        Task.succeed ()
    )
        |> Task.mapError (Settings.openFailure "IPE_REVIEW_DB" (SafeText.literal "point IPE_REVIEW_DB at a writable SQLite file") loc)


-- The review database from `IPE_REVIEW_DB`, opened and migrated.
open : Task.Task Error Db
open =
    do
        loc <- Settings.reviewDb
        db <- openAt loc
        migrate db
        Task.succeed db


-- The review database at a parsed location, opened through the one review URL
-- builder (`Settings.reviewUrl`); no raw URL reaches the driver.
openAt : DbLocation -> Task.Task Error Db
openAt loc =
    Db.open "sqlite" (Settings.reviewUrl loc)


migrate : Db -> Task.Task Error (List String)
migrate db =
    Db.migrate db all


-- A refusal's reason is already a parsed `Reason`, so every decision that
-- reaches the store is well formed.
insertDecision : Db -> String -> String -> Decision -> Task.Task Error Int
insertDecision db uid bodyHash decision =
    insertIfAbsent db uid bodyHash decision


-- A duplicate (uid, body_hash) pair is a no-op: the first review wins and
-- re-reviewing the same pair never overwrites it. The insert runs first and
-- the primary key arbitrates, so two concurrent first reviews cannot both
-- pass a check and one then fail: an insert that fails where the pair's row
-- exists is the duplicate (0 rows), and one that fails with no row for the
-- pair keeps its own error. Review rows are never deleted, so a row seen
-- after a failed insert is the one that won.
insertIfAbsent : Db -> String -> String -> Decision -> Task.Task Error Int
insertIfAbsent db uid bodyHash decision =
    insertNew db uid bodyHash decision
        |> Task.onError (\insertError -> duplicateOr db uid bodyHash insertError)


duplicateOr : Db -> String -> String -> Error -> Task.Task Error Int
duplicateOr db uid bodyHash insertError =
    do
        existing <- findDecision db uid bodyHash
        case existing of
            Just _ ->
                Task.succeed 0

            Nothing ->
                Task.fail insertError


insertNew : Db -> String -> String -> Decision -> Task.Task Error Int
insertNew db uid bodyHash decision =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            do
                now <- Time.unixMillis ()
                let
                    ( decisionText, reason ) =
                        case decision of
                            Approved ->
                                ( "approve", Nothing )

                            Refused r ->
                                ( "refuse", Just (Valid r) )

                    row =
                        { uid = uid
                        , bodyHash = bodyHash
                        , decision = decisionText
                        , reason = reason
                        , reviewedAt = now
                        }
                in
                Store.insert db store row


-- The review row recorded for one (uid, body_hash) key, if any. The
-- condition names both key columns through typed accessors; values bind as
-- parameters. Every stored row decodes, so a legacy refusal never fails it.
findDecision : Db -> String -> String -> Task.Task Error (Maybe ReviewRow)
findDecision db uid bodyHash =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Store.query store
                |> Store.where (Store.and [ Store.eq .uid uid, Store.eq .bodyHash bodyHash ])
                |> Store.toMaybe db


-- The most recent review row for a uid across all hashes, if any. Filter uses
-- `Store.eq .uid` (field name "uid" matches SRecord key "uid"); ordering uses
-- the snake_case column names the store knows ("reviewed_at", "body_hash");
-- in-Ipê sort + limit-1 via the query builder.
findLatestForUid : Db -> String -> Task.Task Error (Maybe ReviewRow)
findLatestForUid db uid =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Store.query store
                |> Store.where (Store.eq .uid uid)
                |> Store.orderDesc "reviewed_at"
                |> Store.orderAsc "body_hash"
                |> Store.limit 1
                |> Store.toMaybe db


-- One row of the drain cursor. `updatedAt` is a typed instant, bound as the
-- `SqlTime` role through `drainCodec`, never a bare `Int`.
type alias DrainCursor =
    { uid : String
    , bodyHash : String
    , updatedAt : Timestamp
    }


makeCursor : String -> String -> Timestamp -> DrainCursor
makeCursor uid bodyHash updatedAt =
    { uid = uid
    , bodyHash = bodyHash
    , updatedAt = updatedAt
    }


-- Codec for the drain cursor. `updated_at` flows through `Codec.timestamp`, so
-- its shape is `CTime` and it binds in the time role, never as a bare `SqlInt`.
drainCodec : Codec DrainCursor
drainCodec =
    Codec
        { enc =
            \row ->
                Encode.object
                    [ ( "uid", Encode.string row.uid )
                    , ( "body_hash", Encode.string row.bodyHash )
                    , ( "updated_at", Codec.toValue Codec.timestamp row.updatedAt )
                    ]
        , mkDec =
            \_ ->
                Config.map3 makeCursor
                    (Config.field "uid" Config.string)
                    (Config.field "body_hash" Config.string)
                    (Config.field "updated_at" (Config.map Timestamp.fromUnixMillis Config.int))
        , shp =
            SRecord
                [ ( "uid", CText )
                , ( "body_hash", CText )
                , ( "updated_at", CTime )
                ]
        }


-- The typed store for the drain cursor, keyed like the review table.
drainStore : Result Error (Store DrainCursor)
drainStore =
    Store.fromCodec "drain_cursor" drainCodec
        |> Result.map (\draft -> Store.public (Store.compositePrimaryKey2 .uid .bodyHash draft))


-- Bookkeeping for the drain loop. Re-draining the same pair refreshes its
-- `updated_at` instead of adding a row, so a re-queued unit reviewed twice
-- keeps a single cursor row. `updateWhere` never writes the key columns. When
-- the refresh matches no row the cursor is inserted through
-- `insertDrainCursor`.
recordDrain : Db -> String -> String -> Task.Task Error Int
recordDrain db uid bodyHash =
    withDrainCursor uid bodyHash
        (\store cursor ->
            do
                updated <- refreshCursor db store cursor
                if updated == 0 then
                    insertCursor db store cursor

                else
                    Task.succeed updated
        )


-- The pair's cursor row inserted. An insert that loses a race to a concurrent
-- drain of the same pair hits the primary key; the pair's row then exists, so
-- the refresh is retried, and the insert's own error stands only when that
-- retry still matches no row. Cursor rows are never deleted, so a row the
-- retry matches is the one that won the race.
insertDrainCursor : Db -> String -> String -> Task.Task Error Int
insertDrainCursor db uid bodyHash =
    withDrainCursor uid bodyHash (\store cursor -> insertCursor db store cursor)


withDrainCursor : String -> String -> (Store DrainCursor -> DrainCursor -> Task.Task Error Int) -> Task.Task Error Int
withDrainCursor uid bodyHash write =
    case drainStore of
        Err e ->
            Task.fail e

        Ok store ->
            Time.unixMillis ()
                |> Task.andThen (\now -> write store (makeCursor uid bodyHash now))


insertCursor : Db -> Store DrainCursor -> DrainCursor -> Task.Task Error Int
insertCursor db store cursor =
    Store.insert db store cursor
        |> Task.onError (\insertError -> retryRefresh db store cursor insertError)


-- The cursor row for `cursor`'s (uid, body_hash) pair given `cursor`'s
-- `updated_at`; the count of rows it matched.
refreshCursor : Db -> Store DrainCursor -> DrainCursor -> Task.Task Error Int
refreshCursor db store cursor =
    Store.updateWhere db store (Store.and [ Store.eq .uid cursor.uid, Store.eq .bodyHash cursor.bodyHash ]) cursor


retryRefresh : Db -> Store DrainCursor -> DrainCursor -> Error -> Task.Task Error Int
retryRefresh db store cursor insertError =
    do
        updated <- refreshCursor db store cursor
        if updated == 0 then
            Task.fail insertError

        else
            Task.succeed updated


countDecoder : Db.Decode.Decoder Int
countDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "total" (Db.Decode.int "total")


-- How many decisions the review table holds, counted by SQLite without
-- decoding a row, so a row whose stored reason no longer parses still
-- counts. A count query that yields anything but one row is a failed read,
-- never a zero.
countDecisions : Db -> Task.Task Error Int
countDecisions db =
    do
        rows <- Db.queryDecode db "SELECT COUNT(*) AS total FROM review" [] countDecoder
        case rows of
            [ n ] ->
                Task.succeed n

            _ ->
                Task.fail (Error.unexpected "COUNT(*) over review did not return exactly one row")


-- The most decided pairs one page of a progress rebuild reads.
pairPageSize : Int
pairPageSize =
    200


pairDecoder : Db.Decode.Decoder ( String, String )
pairDecoder =
    Db.Decode.succeed (\uid bodyHash -> ( uid, bodyHash ))
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")


-- One page of decided (uid, body_hash) pairs in key order, strictly after
-- `cursor` (from the first pair when Nothing), at most `pageSize` of them.
-- Only the two key columns are read, so no reason is parsed; every value is
-- a bound parameter. The caller passes a positive `pageSize`.
decidedPairsAfter : Db -> Int -> Maybe ( String, String ) -> Task.Task Error (List ( String, String ))
decidedPairsAfter db pageSize cursor =
    case cursor of
        Nothing ->
            Db.queryDecode db (pairColumns ++ pairOrder) [ SqlInt pageSize ] pairDecoder

        Just ( uid, bodyHash ) ->
            Db.queryDecode db
                (pairColumns ++ " WHERE (uid, body_hash) > (?, ?)" ++ pairOrder)
                [ SqlString uid, SqlString bodyHash, SqlInt pageSize ]
                pairDecoder


pairColumns : String
pairColumns =
    "SELECT uid, body_hash FROM review"


pairOrder : String
pairOrder =
    " ORDER BY uid, body_hash LIMIT ?"


-- Every review row, newest first. `Store.all` fetches all rows; the query
-- builder sorts them in Ipê by reviewed_at DESC then uid ASC.
findDecisions : Db -> Task.Task Error (List ReviewRow)
findDecisions db =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Store.query store
                |> Store.orderDesc "reviewed_at"
                |> Store.orderAsc "uid"
                |> Store.toList db
