module Lib.Db exposing (Decision(..), ReviewRow, findDecision, findDecisions, findLatestForUid, insertDecision, migrate, open, openAt, recordDrain)

import Ipe.Codec as Codec exposing (Codec(..), ColType(..), Shape(..))
import Ipe.Config as Config
import Ipe.Db as Db
import Ipe.Db.Sql as Sql
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Time as Time
import Migrations exposing (all)


type Decision
    = Approved
    | Refused String


-- One row of the review table. `reviewedAt` carries unix milliseconds.
type alias ReviewRow =
    { uid : String
    , bodyHash : String
    , decision : String
    , reason : Maybe String
    , reviewedAt : Int
    }


-- Codec for ReviewRow. Keys in `SRecord` and JSON object match the DB column
-- names so `Store.fromCodec` derives the correct column list from the shape.
reviewCodec : Codec ReviewRow
reviewCodec =
    Codec
        { enc =
            \row ->
                Encode.object
                    [ ( "uid", Encode.string row.uid )
                    , ( "body_hash", Encode.string row.bodyHash )
                    , ( "decision", Encode.string row.decision )
                    , ( "reason"
                      , case row.reason of
                            Just r ->
                                Encode.string r

                            Nothing ->
                                Encode.null
                      )
                    , ( "reviewed_at", Encode.int row.reviewedAt )
                    ]
        , mkDec =
            \_ ->
                Config.map5 makeRow
                    (Config.field "uid" Config.string)
                    (Config.field "body_hash" Config.string)
                    (Config.field "decision" Config.string)
                    (Config.field "reason" (Config.nullable Config.string))
                    (Config.field "reviewed_at" Config.int)
        , shp =
            SRecord
                [ ( "uid", CText )
                , ( "body_hash", CText )
                , ( "decision", CText )
                , ( "reason", CNull CText )
                , ( "reviewed_at", CInt )
                ]
        }


makeRow : String -> String -> String -> Maybe String -> Int -> ReviewRow
makeRow uid bodyHash decision reason reviewedAt =
    { uid = uid
    , bodyHash = bodyHash
    , decision = decision
    , reason = reason
    , reviewedAt = reviewedAt
    }


-- The typed store for the review table. `fromCodec` validates every column
-- identifier; `public` classifies it as world-readable/writable. No
-- `primaryKey` spec: the composite `PRIMARY KEY (uid, body_hash)` lives only
-- in the hand-written DDL migration, which Store cannot express.
reviewStore : Result Error (Store ReviewRow)
reviewStore =
    Store.fromCodec "review" reviewCodec
        |> Result.map Store.public


open : Task.Task Error Db
open =
    Db.open "sqlite" (System.getenvOr "IPE_REVIEW_DB" "review.db")


openAt : String -> Task.Task Error Db
openAt path =
    Db.open "sqlite" path


migrate : Db -> Task.Task Error (List String)
migrate db =
    Db.migrate db all


insertDecision : Db -> String -> String -> Decision -> Task.Task Error Int
insertDecision db uid bodyHash decision =
    case decision of
        Refused r ->
            if String.length (String.trim r) == 0 then
                Task.fail (Error.unexpected "a refused review needs a non-empty reason")

            else
                insertIfAbsent db uid bodyHash decision

        Approved ->
            insertIfAbsent db uid bodyHash decision


-- A duplicate (uid, body_hash) pair is a no-op: the first review wins and
-- re-reviewing the same pair never overwrites it.
insertIfAbsent : Db -> String -> String -> Decision -> Task.Task Error Int
insertIfAbsent db uid bodyHash decision =
    findDecision db uid bodyHash
        |> Task.andThen
            (\existing ->
                case existing of
                    Just _ ->
                        Task.succeed 0

                    Nothing ->
                        insertNew db uid bodyHash decision
            )


insertNew : Db -> String -> String -> Decision -> Task.Task Error Int
insertNew db uid bodyHash decision =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Time.unixMillis ()
                |> Task.andThen
                    (\now ->
                        let
                            ( decisionText, reason ) =
                                case decision of
                                    Approved ->
                                        ( "approve", Nothing )

                                    Refused r ->
                                        ( "refuse", Just r )

                            row =
                                { uid = uid
                                , bodyHash = bodyHash
                                , decision = decisionText
                                , reason = reason
                                , reviewedAt = Time.toMillis now
                                }
                        in
                        Store.insert db store row
                    )


-- Filter by both `uid` and `body_hash` using `Store.findWhere` with an
-- injection-safe `SqlFragment` (Sql.column + Sql.param). The codec decodes
-- each returned row; a mismatch is a typed error.
findDecision : Db -> String -> String -> Task.Task Error (Maybe Decision)
findDecision db uid bodyHash =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Store.findWhere db
                store
                (Sql.and
                    (Sql.eq (Sql.column "uid") (Sql.param (SqlString uid)))
                    (Sql.eq (Sql.column "body_hash") (Sql.param (SqlString bodyHash)))
                )
                |> Task.map List.head
                |> Task.andThen
                    (\mb ->
                        case mb of
                            Nothing ->
                                Task.succeed Nothing

                            Just row ->
                                case decodeDecision row of
                                    Ok d ->
                                        Task.succeed (Just d)

                                    Err e ->
                                        Task.fail e
                    )


decodeDecision : ReviewRow -> Result Error Decision
decodeDecision row =
    case row.decision of
        "approve" ->
            Ok Approved

        "refuse" ->
            case row.reason of
                Just r ->
                    Ok (Refused r)

                Nothing ->
                    Err (Error.unexpected "review row is refused but has no reason")

        other ->
            Err (Error.unexpected ("malformed review decision: " ++ other))


-- The most recent review row for a uid across all hashes, if any. Filter uses
-- `Store.eq .uid` (field name "uid" matches SRecord key "uid"); ordering uses
-- the snake_case column names the store knows ("reviewed_at", "body_hash");
-- in-Ipê sort + limit-1 via the query builder.
findLatestForUid : Db -> String -> Task.Task Error (Maybe ReviewRow)
findLatestForUid db uid =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Store.query store
                |> Store.where (Store.eq .uid uid)
                |> Store.orderDesc "reviewed_at"
                |> Store.orderAsc "body_hash"
                |> Store.limit 1
                |> Store.toMaybe db


-- Bookkeeping for the drain loop. Re-draining the same pair is a no-op
-- (INSERT OR REPLACE), so a re-queued unit that gets reviewed twice keeps
-- a single cursor row.
recordDrain : Db -> String -> String -> Task.Task Error Int
recordDrain db uid bodyHash =
    Time.unixMillis ()
        |> Task.andThen
            (\now ->
                Db.exec db
                    "INSERT OR REPLACE INTO drain_cursor VALUES (?, ?, ?)"
                    [ SqlString uid, SqlString bodyHash, SqlInt (Time.toMillis now) ]
            )


-- Every review row, newest first. `Store.all` fetches all rows; the query
-- builder sorts them in Ipê by reviewed_at DESC then uid ASC.
findDecisions : Db -> Task.Task Error (List ReviewRow)
findDecisions db =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Store.query store
                |> Store.orderDesc "reviewed_at"
                |> Store.orderAsc "uid"
                |> Store.toList db
