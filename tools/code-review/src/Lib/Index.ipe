module Lib.Index exposing (Unit, drainUnit, loadPending, loadUnitByUid, nameFor, openRead, qualifiedUids)

import Ipe.ByteSize as ByteSize exposing (ByteSize)
import Ipe.Db
import Ipe.Db.Decode
import Ipe.Db.Sql as Sql
import Ipe.Db.Store as Store exposing (Store)
import Ipe.File as File
import Ipe.List as List
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Lib.RepoPath as RepoPath exposing (Root)
import Lib.Settings as Settings


-- One queued ipe-index unit plus its source slice. `path` is the
-- `tag:relative` form ipe-index stores; `source` is the unit's line slice
-- read from disk.
type alias Unit =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    , kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    , source : String
    }


-- The unit columns as they come off the DB, before the source is attached.
-- The unit page queries units directly, not via change_queue: a decided
-- unit has no queue row, but its page must still render. change/old_hash/
-- new_hash are literals then, since the queue row is the only source of a
-- real change state.
unitByUidSql : String
unitByUidSql =
    "SELECT u.uid, 'new' AS change, NULL AS old_hash, NULL AS new_hash, u.path, u.name, u.qualified, u.kind, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha FROM units u WHERE u.uid = ?"


-- One unit by uid (decided or not), with its source slice resolved against
-- the index root; Nothing when no such unit exists.
loadUnitByUid : String -> Task.Task Error (Maybe Unit)
loadUnitByUid uid =
    do
        settings <- Settings.indexSettings
        conn <- Db.open "sqlite" (Settings.indexReadUrl settings.db)
        rows <- Db.queryDecode conn unitByUidSql [ SqlString uid ] rowDecoder
        case List.head rows of
            Just row ->
                Task.map Just (loadSource settings.root row)

            Nothing ->
                Task.succeed Nothing


-- Every unit's (qualified, uid) pair. The link resolver matches
-- identifier references in a unit's source against these names to build
-- internal jump links; only the names are needed, so no file reads happen.
qualifiedUids : Task.Task Error (List ( String, String ))
qualifiedUids =
    do
        conn <- openRead
        Db.queryDecode conn "SELECT qualified, uid FROM units" [] qualifiedDecoder


qualifiedDecoder : Db.Decode.Decoder ( String, String )
qualifiedDecoder =
    Db.Decode.succeed (\q u -> ( q, u ))
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")
        |> Db.Decode.required "uid" (Db.Decode.string "uid")


-- A unit row before the source is attached. The unit page queries units
-- directly, not via change_queue: a decided unit has no queue row, but its
-- page must still render. change/old_hash/new_hash are literals then, since
-- the queue row is the only source of a real change state.
type alias RowUnit =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    , kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    }


-- The queue row is decoded in two halves of at most ten columns each
-- (`Db.Decode.succeed` lifts at most 10 parameters — IPE-L0121), then merged.
type alias RowA =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    }


type alias RowB =
    { kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    }


makeRowA : String -> String -> Maybe String -> Maybe String -> String -> String -> String -> RowA
makeRowA uid change oldHash newHash path name qualified =
    { uid = uid
    , change = change
    , oldHash = oldHash
    , newHash = newHash
    , path = path
    , name = name
    , qualified = qualified
    }


makeRowB : String -> Int -> Int -> String -> Maybe String -> String -> String -> RowB
makeRowB kind lineStart lineEnd facing purpose bodyHash updatedSha =
    { kind = kind
    , lineStart = lineStart
    , lineEnd = lineEnd
    , facing = facing
    , purpose = purpose
    , bodyHash = bodyHash
    , updatedSha = updatedSha
    }


mergeRows : RowA -> RowB -> RowUnit
mergeRows a b =
    { uid = a.uid
    , change = a.change
    , oldHash = a.oldHash
    , newHash = a.newHash
    , path = a.path
    , name = a.name
    , qualified = a.qualified
    , kind = b.kind
    , lineStart = b.lineStart
    , lineEnd = b.lineEnd
    , facing = b.facing
    , purpose = b.purpose
    , bodyHash = b.bodyHash
    , updatedSha = b.updatedSha
    }


rowDecoder : Db.Decode.Decoder RowUnit
rowDecoder =
    Db.Decode.andThen
        (\a -> Db.Decode.map (\b -> mergeRows a b) partBDecoder)
        partADecoder


partADecoder : Db.Decode.Decoder RowA
partADecoder =
    Db.Decode.succeed makeRowA
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "change" (Db.Decode.string "change")
        |> Db.Decode.required "old_hash" (Db.Decode.nullable (Db.Decode.string "old_hash"))
        |> Db.Decode.required "new_hash" (Db.Decode.nullable (Db.Decode.string "new_hash"))
        |> Db.Decode.required "path" (Db.Decode.string "path")
        |> Db.Decode.required "name" (Db.Decode.string "name")
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")


partBDecoder : Db.Decode.Decoder RowB
partBDecoder =
    Db.Decode.succeed makeRowB
        |> Db.Decode.required "kind" (Db.Decode.string "kind")
        |> Db.Decode.required "line_start" (Db.Decode.int "line_start")
        |> Db.Decode.required "line_end" (Db.Decode.int "line_end")
        |> Db.Decode.required "facing" (Db.Decode.string "facing")
        |> Db.Decode.required "purpose" (Db.Decode.nullable (Db.Decode.string "purpose"))
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")
        |> Db.Decode.required "updated_sha" (Db.Decode.string "updated_sha")


-- The index database opened read-only, for listing.
openRead : Task.Task Error Db.Db
openRead =
    do
        settings <- Settings.indexSettings
        Db.open "sqlite" (Settings.indexReadUrl settings.db)


pendingSql : String
pendingSql =
    "SELECT q.uid, q.change, q.old_hash, q.new_hash, u.path, u.name, u.qualified, u.kind, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha FROM change_queue q JOIN units u ON u.uid = q.uid WHERE q.change IN ('new','modified') ORDER BY q.enqueued_at, q.uid"


-- Queue units (new + modified, ordered by enqueue time), each with its
-- source slice resolved against the index root. Deleted units drop out of
-- the JOIN — they have no row to slice.
loadPending : Task.Task Error (List Unit)
loadPending =
    do
        settings <- Settings.indexSettings
        conn <- Db.open "sqlite" (Settings.indexReadUrl settings.db)
        rows <- Db.queryDecode conn pendingSql [] rowDecoder
        loadSources settings.root rows


-- The review app consumes and clears explicitly: after a unit is decided,
-- its change_queue row is deleted so it stops appearing in loadPending. The
-- row comes back only when the index re-queues the unit after it changes
-- again (per-uid PRIMARY KEY in change_queue — a fresh change, a fresh
-- review).
drainUnit : String -> Task.Task Error Int
drainUnit uid =
    do
        settings <- Settings.indexSettings
        conn <- Db.open "sqlite" (Settings.indexWriteUrl settings.db)
        Db.deleteWhere conn "change_queue" (Sql.eq (Sql.column "uid") (Sql.param (SqlString uid)))


-- The ipe-index `units` table modelled as a typed store over its explicit
-- columns, so a lookup runs through `Store.findBy` with a bound value rather
-- than a hand-written `WHERE` fragment. The store is read-only here — only
-- queried, never migrated — so its column set need only cover the columns a
-- query reads.
unitsStore : Result Error (Store Store.Row)
unitsStore =
    Store.fromColumns "units"
        [ Store.textColumn "uid"
        , Store.textColumn "qualified"
        ]
        |> Result.map Store.public


-- The unit's qualified name from the units table, if the unit still exists
-- (a decided unit whose source was deleted leaves a review row but no name).
-- The `uid` value is bound as a parameter by `Store.findBy`, never
-- interpolated into SQL text.
nameFor : Db.Db -> String -> Task.Task Error (Maybe String)
nameFor conn uid =
    case unitsStore of
        Err e ->
            Task.fail e

        Ok store ->
            do
                rows <- Store.findBy conn store "uid" (SqlString uid)
                case List.head rows of
                    Just row ->
                        Task.succeed (Result.toMaybe (Store.readText "qualified" row))

                    Nothing ->
                        Task.succeed Nothing


loadSources : Root -> List RowUnit -> Task.Task Error (List Unit)
loadSources root rows =
    rows
        |> List.map (loadSource root)
        |> Task.sequence


-- Reading a unit's source fails the whole load with a typed error: a queued
-- unit whose stored path is refused by `RepoPath.resolve`, or whose file
-- cannot be read or exceeds `sourceCeiling`, is a real problem, not a row to
-- silently skip.
loadSource : Root -> RowUnit -> Task.Task Error Unit
loadSource root row =
    case RepoPath.resolve root row.path of
        Err refusal ->
            Task.fail (RepoPath.toError refusal)

        Ok path ->
            do
                text <- File.readFileLimit path sourceCeiling
                Task.succeed (withSource (sliceLines row.lineStart row.lineEnd text) row)


-- The largest source file a unit is sliced from; a bigger file under the root
-- is refused rather than read whole into memory.
sourceCeiling : ByteSize
sourceCeiling =
    ByteSize.mib 16


withSource : String -> RowUnit -> Unit
withSource source row =
    { uid = row.uid
    , change = row.change
    , oldHash = row.oldHash
    , newHash = row.newHash
    , path = row.path
    , name = row.name
    , qualified = row.qualified
    , kind = row.kind
    , lineStart = row.lineStart
    , lineEnd = row.lineEnd
    , facing = row.facing
    , purpose = row.purpose
    , bodyHash = row.bodyHash
    , updatedSha = row.updatedSha
    , source = source
    }


-- 1-based inclusive slice of the unit's lines.
sliceLines : Int -> Int -> String -> String
sliceLines start end text =
    text
        |> String.split "\n"
        |> List.drop (max 0 (start - 1))
        |> List.take (max 0 (end - start + 1))
        |> String.join "\n"
