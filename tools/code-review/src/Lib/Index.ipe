module Lib.Index exposing (IndexInfo, Unit, dbFileName, dbPathOf, drainUnit, indexDbUrl, loadInfo, loadPendingPage, loadUnitByUid, nameFor, qualifiedUids)

import Ipe.ByteSize as ByteSize exposing (ByteSize)
import Ipe.Db
import Ipe.Db.Decode
import Ipe.Db.Sql as Sql
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Dict as Dict exposing (Dict)
import Ipe.Error as Error
import Ipe.File as File
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Path as Path
import Ipe.Result as Result exposing (Result)
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Lib.Page as Page exposing (PageBounds)


-- One queued ipe-index unit plus its source slice. `path` is the
-- `tag:relative` form ipe-index stores; `source` is the unit's line slice
-- read from disk.
type alias Unit =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    , kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    , source : String
    }


-- The unit columns as they come off the DB, before the source is attached.
-- The unit page (B9) queries units directly, not via change_queue: a decided
-- unit has no queue row, but its page must still render. change/old_hash/
-- new_hash are literals then, since the queue row is the only source of a
-- real change state.
unitByUidSql : String
unitByUidSql =
    "SELECT u.uid, 'new' AS change, NULL AS old_hash, NULL AS new_hash, u.path, u.name, u.qualified, u.kind, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha FROM units u WHERE u.uid = ?"


-- One unit by uid (decided or not), with its source slice resolved against
-- the index root; Nothing when no such unit exists.
loadUnitByUid : String -> Task.Task Error (Maybe Unit)
loadUnitByUid uid =
    do
        root <- indexRoot
        url <- indexDbUrl
        conn <- Db.open "sqlite" url
        rows <- Db.queryDecode conn unitByUidSql [ SqlString uid ] rowDecoder
        case List.head rows of
            Just row ->
                Task.map List.head (loadSources root [ row ])

            Nothing ->
                Task.succeed Nothing


-- Every unit's (qualified, uid) pair. The link resolver (B9) matches
-- identifier references in a unit's source against these names to build
-- internal jump links; only the names are needed, so no file reads happen.
qualifiedUids : Task.Task Error (List ( String, String ))
qualifiedUids =
    do
        url <- indexDbUrl
        conn <- Db.open "sqlite" url
        Db.queryDecode conn "SELECT qualified, uid FROM units" [] qualifiedDecoder


qualifiedDecoder : Db.Decode.Decoder ( String, String )
qualifiedDecoder =
    Db.Decode.succeed (\q u -> ( q, u ))
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")
        |> Db.Decode.required "uid" (Db.Decode.string "uid")


-- A unit row before the source is attached. The unit page (B9) queries units
-- directly, not via change_queue: a decided unit has no queue row, but its
-- page must still render. change/old_hash/new_hash are literals then, since
-- the queue row is the only source of a real change state.
type alias RowUnit =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    , kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    }


-- The queue row is decoded in two halves of at most ten columns each
-- (`Db.Decode.succeed` lifts at most 10 parameters — IPE-L0121), then merged.
type alias RowA =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    }


type alias RowB =
    { kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    }


makeRowA : String -> String -> Maybe String -> Maybe String -> String -> String -> String -> RowA
makeRowA uid change oldHash newHash path name qualified =
    { uid = uid
    , change = change
    , oldHash = oldHash
    , newHash = newHash
    , path = path
    , name = name
    , qualified = qualified
    }


makeRowB : String -> Int -> Int -> String -> Maybe String -> String -> String -> RowB
makeRowB kind lineStart lineEnd facing purpose bodyHash updatedSha =
    { kind = kind
    , lineStart = lineStart
    , lineEnd = lineEnd
    , facing = facing
    , purpose = purpose
    , bodyHash = bodyHash
    , updatedSha = updatedSha
    }


mergeRows : RowA -> RowB -> RowUnit
mergeRows a b =
    { uid = a.uid
    , change = a.change
    , oldHash = a.oldHash
    , newHash = a.newHash
    , path = a.path
    , name = a.name
    , qualified = a.qualified
    , kind = b.kind
    , lineStart = b.lineStart
    , lineEnd = b.lineEnd
    , facing = b.facing
    , purpose = b.purpose
    , bodyHash = b.bodyHash
    , updatedSha = b.updatedSha
    }


rowDecoder : Db.Decode.Decoder RowUnit
rowDecoder =
    Db.Decode.andThen
        (\a -> Db.Decode.map (\b -> mergeRows a b) partBDecoder)
        partADecoder


partADecoder : Db.Decode.Decoder RowA
partADecoder =
    Db.Decode.succeed makeRowA
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "change" (Db.Decode.string "change")
        |> Db.Decode.required "old_hash" (Db.Decode.nullable (Db.Decode.string "old_hash"))
        |> Db.Decode.required "new_hash" (Db.Decode.nullable (Db.Decode.string "new_hash"))
        |> Db.Decode.required "path" (Db.Decode.string "path")
        |> Db.Decode.required "name" (Db.Decode.string "name")
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")


partBDecoder : Db.Decode.Decoder RowB
partBDecoder =
    Db.Decode.succeed makeRowB
        |> Db.Decode.required "kind" (Db.Decode.string "kind")
        |> Db.Decode.required "line_start" (Db.Decode.int "line_start")
        |> Db.Decode.required "line_end" (Db.Decode.int "line_end")
        |> Db.Decode.required "facing" (Db.Decode.string "facing")
        |> Db.Decode.required "purpose" (Db.Decode.nullable (Db.Decode.string "purpose"))
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")
        |> Db.Decode.required "updated_sha" (Db.Decode.string "updated_sha")


-- Read URL for the ipe-index sqlite database. A `sqlite://` URL with an
-- explicit `mode=ro` query is passed through verbatim by the runtime, so the
-- index DB is never created or modified. This is a function of the env value
-- (not a cached top-level value): loadPendingPage runs against different
-- IPE_INDEX_DB settings within one process (tests).
indexDbUrlFor : String -> String
indexDbUrlFor raw =
    if String.contains "://" raw then
        if String.contains "?" raw then
            raw

        else
            raw ++ "?mode=ro"

    else
        "sqlite://" ++ raw ++ "?mode=ro"


-- The same database opened read-write, for the drain step. `mode=ro` (either
-- explicit or implied by the pass-through branch above) is rewritten so the
-- consumed queue row can be deleted; a URL with no mode already defaults to
-- read-write in SQLite.
indexDbWriteUrlFor : String -> String
indexDbWriteUrlFor raw =
    if String.contains "://" raw then
        String.replace "mode=ro" "mode=rwc" raw

    else
        "sqlite://" ++ raw ++ "?mode=rwc"


-- The index database location, read from `IPE_INDEX_DB`. `System.getenv` fails
-- closed when the variable is unset, so a misconfigured run stops with a typed
-- error rather than silently opening a wrong-path (or nonexistent) database —
-- the `main` entry point guards this variable up front, and no code path here
-- reintroduces a permissive default.
indexDbRaw : Task.Task Error String
indexDbRaw =
    System.getenv "IPE_INDEX_DB"


-- The read-only index URL: the env value shaped into a `mode=ro` `sqlite://`
-- URL so the index db is opened for listing, never created or modified.
indexDbUrl : Task.Task Error String
indexDbUrl =
    Task.map indexDbUrlFor indexDbRaw


-- The read-write index URL, for the drain step that deletes a consumed
-- `change_queue` row.
indexDbWriteUrl : Task.Task Error String
indexDbWriteUrl =
    Task.map indexDbWriteUrlFor indexDbRaw


-- The repo root the index's `tag:relative` paths join to, read from
-- `IPE_INDEX_ROOT`; unset fails closed (guarded up front by `main`).
indexRoot : Task.Task Error String
indexRoot =
    System.getenv "IPE_INDEX_ROOT"


-- The pending rowset, shared by the page query and the count query so the
-- header's count is exactly the set the pages walk.
pendingFrom : String
pendingFrom =
    "FROM change_queue q JOIN units u ON u.uid = q.uid WHERE q.change IN ('new','modified')"


-- One page of the pending rowset. LIMIT and OFFSET are bound parameters
-- filled from a validated `PageBounds`.
pendingPageSql : String
pendingPageSql =
    "SELECT q.uid, q.change, q.old_hash, q.new_hash, u.path, u.name, u.qualified, u.kind, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha "
        ++ pendingFrom
        ++ " ORDER BY q.enqueued_at, q.uid LIMIT ? OFFSET ?"


pendingCountSql : String
pendingCountSql =
    "SELECT COUNT(*) AS n " ++ pendingFrom


-- The database file size as SQLite reports it (page count times page size),
-- read through the open connection: the stdlib has no file-metadata call, and
-- the app never shells out.
dbBytesSql : String
dbBytesSql =
    "SELECT p.page_count * s.page_size AS bytes FROM pragma_page_count() AS p, pragma_page_size() AS s"


-- One page of queue units (new + modified, ordered by enqueue time), each with
-- its source slice resolved against the index root. Deleted units drop out of
-- the JOIN — they have no row to slice. Only this page's rows are fetched and
-- only its distinct source files are read.
loadPendingPage : PageBounds -> Task.Task Error (List Unit)
loadPendingPage bounds =
    do
        root <- indexRoot
        url <- indexDbUrl
        conn <- Db.open "sqlite" url
        rows <- Db.queryDecode conn pendingPageSql [ SqlInt (Page.limit bounds), SqlInt (Page.offset bounds) ] rowDecoder
        loadSources root rows


-- Header facts about the index database: its file name, its location with
-- any URL scheme and query stripped, its size, and the pending-unit count.
type alias IndexInfo =
    { fileName : String
    , location : String
    , size : ByteSize
    , pending : Int
    }


loadInfo : Task.Task Error IndexInfo
loadInfo =
    do
        raw <- indexDbRaw
        conn <- Db.open "sqlite" (indexDbUrlFor raw)
        pending <- singleInt conn pendingCountSql "n"
        bytes <- singleInt conn dbBytesSql "bytes"
        Task.succeed
            { fileName = dbFileName raw
            , location = dbPathOf raw
            , size = ByteSize.bytes bytes
            , pending = pending
            }


-- The one integer an aggregate query returns; no row is a typed error.
singleInt : Db.Db -> String -> String -> Task.Task Error Int
singleInt conn sql column =
    do
        values <- Db.queryDecode conn sql [] (Db.Decode.succeed (\n -> n) |> Db.Decode.required column (Db.Decode.int column))
        case List.head values of
            Just n ->
                Task.succeed n

            Nothing ->
                Task.fail (Error.unexpected ("index query returned no row: " ++ sql))


-- The filesystem path inside an `IPE_INDEX_DB` value: a `scheme://` prefix and
-- a `?query` suffix are stripped, a bare path passes through.
-- `sqlite:///data/index.db?mode=ro` -> `/data/index.db`.
dbPathOf : String -> String
dbPathOf raw =
    let
        noQuery =
            Maybe.withDefault raw (List.head (String.split "?" raw))
    in
    case String.split "://" noQuery of
        _ :: afterScheme :: more ->
            String.join "://" (afterScheme :: more)

        _ ->
            noQuery


-- The last path segment of an `IPE_INDEX_DB` value (`index.db`); the whole
-- path when it has no usable segment.
dbFileName : String -> String
dbFileName raw =
    let
        path =
            dbPathOf raw
    in
    case List.head (List.reverse (String.split "/" path)) of
        Just segment ->
            if segment == "" then
                path

            else
                segment

        Nothing ->
            path


-- The review app consumes and clears explicitly: after a unit is decided,
-- its change_queue row is deleted so it stops appearing in the pending pages. The
-- row comes back only when the index re-queues the unit after it changes
-- again (per-uid PRIMARY KEY in change_queue — a fresh change, a fresh
-- review).
drainUnit : String -> Task.Task Error Int
drainUnit uid =
    do
        url <- indexDbWriteUrl
        conn <- Db.open "sqlite" url
        Db.deleteWhere conn "change_queue" (Sql.eq (Sql.column "uid") (Sql.param (SqlString uid)))


-- The ipe-index `units` table modelled as a typed store over its explicit
-- columns, so a lookup runs through `Store.findBy` with a bound value rather
-- than a hand-written `WHERE` fragment. The store is read-only here — only
-- queried, never migrated — so its column set need only cover the columns a
-- query reads.
unitsStore : Result Error (Store Store.Row)
unitsStore =
    Store.fromColumns "units"
        [ Store.textColumn "uid"
        , Store.textColumn "qualified"
        ]
        |> Result.map Store.public


-- The unit's qualified name from the units table, if the unit still exists
-- (a decided unit whose source was deleted leaves a review row but no name).
-- The `uid` value is bound as a parameter by `Store.findBy`, never
-- interpolated into SQL text.
nameFor : Db.Db -> String -> Task.Task Error (Maybe String)
nameFor conn uid =
    case unitsStore of
        Err e ->
            Task.fail e

        Ok store ->
            do
                rows <- Store.findBy conn store "uid" (SqlString uid)
                case List.head rows of
                    Just row ->
                        Task.succeed (Result.toMaybe (Store.readText "qualified" row))

                    Nothing ->
                        Task.succeed Nothing


-- Each distinct source file of the page is read once, then every row takes
-- its slice from that text.
loadSources : String -> List RowUnit -> Task.Task Error (List Unit)
loadSources root rows =
    do
        texts <-
            rows
                |> List.map (\row -> row.path)
                |> distinct
                |> List.map (readSource root)
                |> Task.sequence
        let
            byPath =
                Dict.fromList texts
        in
        rows
            |> List.map (sliceFrom byPath)
            |> Task.sequence


distinct : List String -> List String
distinct items =
    List.reverse
        (List.foldl
            (\item seen ->
                if List.member item seen then
                    seen

                else
                    item :: seen
            )
            []
            items
        )


sliceFrom : Dict String String -> RowUnit -> Task.Task Error Unit
sliceFrom byPath row =
    case Dict.get row.path byPath of
        Just text ->
            Task.succeed (withSource (sliceLines row.lineStart row.lineEnd text) row)

        Nothing ->
            Task.fail (Error.unexpected ("index unit source was not read: " ++ row.path))


-- Reading a unit's source fails the whole load with a typed error: a queued
-- unit whose file cannot be resolved or read is a real problem, not a row to
-- silently skip.
readSource : String -> String -> Task.Task Error ( String, String )
readSource root stored =
    case resolvePath root stored of
        Nothing ->
            Task.fail (Error.unexpected ("index unit has an unresolvable path: " ++ stored))

        Just absPath ->
            do
                path <- Task.fromResult (Path.fromString absPath)
                text <- File.readFile path
                Task.succeed ( stored, text )


withSource : String -> RowUnit -> Unit
withSource source row =
    { uid = row.uid
    , change = row.change
    , oldHash = row.oldHash
    , newHash = row.newHash
    , path = row.path
    , name = row.name
    , qualified = row.qualified
    , kind = row.kind
    , lineStart = row.lineStart
    , lineEnd = row.lineEnd
    , facing = row.facing
    , purpose = row.purpose
    , bodyHash = row.bodyHash
    , updatedSha = row.updatedSha
    , source = source
    }


-- `ipe:src/Main.ipe` -> `src/Main.ipe`. The first `:`-segment is the repo tag
-- (e.g. `ipe:`); relative paths are joined onto the index root. Absolute and
-- `..`-escaping paths are refused.
resolvePath : String -> String -> Maybe String
resolvePath root stored =
    case String.split ":" stored of
        _ :: rest ->
            let
                rel =
                    String.join ":" rest

                segments =
                    String.split "/" rel
            in
            if rel == "" || String.startsWith "/" rel || List.member ".." segments then
                Nothing

            else
                Just (root ++ "/" ++ rel)

        [] ->
            Nothing


-- 1-based inclusive slice of the unit's lines.
sliceLines : Int -> Int -> String -> String
sliceLines start end text =
    text
        |> String.split "\n"
        |> List.drop (max 0 (start - 1))
        |> List.take (max 0 (end - start + 1))
        |> String.join "\n"
