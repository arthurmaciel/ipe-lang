module Lib.Index exposing (Attested, AttestedHash(..), Cursor(..), PendingRow, ShownSource, SourceView(..), StaleReason(..), Unit, UnitState, attest, attestedHash, attestedUid, countPending, dbBytes, drainUnit, loadPendingPage, loadUnitByUid, nameFor, openRead, pageSize, probe, qualifiedUids, reverify, shortHash, shownHash, shownText, storedHash, unitStates, viewText)

import Ipe.ByteSize as ByteSize exposing (ByteSize)
import Ipe.Crypto as Crypto
import Ipe.Db
import Ipe.Db.Decode
import Ipe.Db.Sql as Sql
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error
import Ipe.File as File
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Lib.Highlight as Highlight
import Lib.RepoPath as RepoPath exposing (RootMap)
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings exposing (IndexSettings)


-- One queued ipe-index unit plus its verified source view. Every text column
-- a page shows (`path`, the `tag:relative` form ipe-index stores; `name`;
-- `qualified`; `kind`; `facing`; `purpose`) is `SafeText`, rendered once
-- here, so no index text can reach a page raw; `lang` is `kind` parsed for
-- highlighting. `attested` is the stored body hash, parsed once; `view` is
-- the unit's lines from disk, shown only when they re-hash to `attested`.
type alias Unit =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : SafeText
    , name : SafeText
    , qualified : SafeText
    , kind : SafeText
    , lang : Highlight.Lang
    , lineStart : Int
    , lineEnd : Int
    , facing : SafeText
    , purpose : Maybe SafeText
    , attested : AttestedHash
    , updatedSha : String
    , view : SourceView
    }


-- The unit columns as they come off the DB, before the source is attached.
-- The unit page queries units directly, not via change_queue: a decided
-- unit has no queue row, but its page must still render. change/old_hash/
-- new_hash are literals then, since the queue row is the only source of a
-- real change state.
unitByUidSql : String
unitByUidSql =
    "SELECT u.uid, 'new' AS change, NULL AS old_hash, NULL AS new_hash, u.path, u.name, u.qualified, u.kind, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha FROM units u WHERE u.uid = ?"


-- One unit by uid (decided or not), with its source view verified against
-- its tag's index root; Nothing when no such unit exists.
loadUnitByUid : String -> Task.Task Error (Maybe Unit)
loadUnitByUid uid =
    do
        settings <- Settings.indexSettings
        conn <- Db.open "sqlite" (Settings.indexReadUrl settings.db)
        rows <- Db.queryDecode conn unitByUidSql [ SqlString uid ] rowDecoder
        case List.head rows of
            Just row ->
                Task.map (\view -> Just (withView view row)) (viewOf settings.roots row)

            Nothing ->
                Task.succeed Nothing


-- Every unit's (qualified, uid) pair. The link resolver matches
-- identifier references in a unit's source against these names to build
-- internal jump links; only the names are needed, so no file reads happen.
qualifiedUids : Task.Task Error (List ( String, String ))
qualifiedUids =
    do
        conn <- openRead
        Db.queryDecode conn "SELECT qualified, uid FROM units" [] qualifiedDecoder


qualifiedDecoder : Db.Decode.Decoder ( String, String )
qualifiedDecoder =
    Db.Decode.succeed (\q u -> ( q, u ))
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")
        |> Db.Decode.required "uid" (Db.Decode.string "uid")


-- A unit row before the source is attached. The unit page queries units
-- directly, not via change_queue: a decided unit has no queue row, but its
-- page must still render. change/old_hash/new_hash are literals then, since
-- the queue row is the only source of a real change state.
type alias RowUnit =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    , kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    }


-- The queue row is decoded in two halves of at most ten columns each
-- (`Db.Decode.succeed` lifts at most 10 parameters — IPE-L0121), then merged.
type alias RowA =
    { uid : String
    , change : String
    , oldHash : Maybe String
    , newHash : Maybe String
    , path : String
    , name : String
    , qualified : String
    }


type alias RowB =
    { kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    }


makeRowA : String -> String -> Maybe String -> Maybe String -> String -> String -> String -> RowA
makeRowA uid change oldHash newHash path name qualified =
    { uid = uid
    , change = change
    , oldHash = oldHash
    , newHash = newHash
    , path = path
    , name = name
    , qualified = qualified
    }


makeRowB : String -> Int -> Int -> String -> Maybe String -> String -> String -> RowB
makeRowB kind lineStart lineEnd facing purpose bodyHash updatedSha =
    { kind = kind
    , lineStart = lineStart
    , lineEnd = lineEnd
    , facing = facing
    , purpose = purpose
    , bodyHash = bodyHash
    , updatedSha = updatedSha
    }


mergeRows : RowA -> RowB -> RowUnit
mergeRows a b =
    { uid = a.uid
    , change = a.change
    , oldHash = a.oldHash
    , newHash = a.newHash
    , path = a.path
    , name = a.name
    , qualified = a.qualified
    , kind = b.kind
    , lineStart = b.lineStart
    , lineEnd = b.lineEnd
    , facing = b.facing
    , purpose = b.purpose
    , bodyHash = b.bodyHash
    , updatedSha = b.updatedSha
    }


rowDecoder : Db.Decode.Decoder RowUnit
rowDecoder =
    Db.Decode.andThen
        (\a -> Db.Decode.map (\b -> mergeRows a b) partBDecoder)
        partADecoder


partADecoder : Db.Decode.Decoder RowA
partADecoder =
    Db.Decode.succeed makeRowA
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "change" (Db.Decode.string "change")
        |> Db.Decode.required "old_hash" (Db.Decode.nullable (Db.Decode.string "old_hash"))
        |> Db.Decode.required "new_hash" (Db.Decode.nullable (Db.Decode.string "new_hash"))
        |> Db.Decode.required "path" (Db.Decode.string "path")
        |> Db.Decode.required "name" (Db.Decode.string "name")
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")


partBDecoder : Db.Decode.Decoder RowB
partBDecoder =
    Db.Decode.succeed makeRowB
        |> Db.Decode.required "kind" (Db.Decode.string "kind")
        |> Db.Decode.required "line_start" (Db.Decode.int "line_start")
        |> Db.Decode.required "line_end" (Db.Decode.int "line_end")
        |> Db.Decode.required "facing" (Db.Decode.string "facing")
        |> Db.Decode.required "purpose" (Db.Decode.nullable (Db.Decode.string "purpose"))
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")
        |> Db.Decode.required "updated_sha" (Db.Decode.string "updated_sha")


-- The startup check of `IPE_INDEX_DB`: the index is opened read-only and
-- every column a queue page reads is selected, so a missing file, a file
-- that is not an ipe-index database, or one missing a table or column stops
-- the server before it listens, naming the variable and the file.
probe : IndexSettings -> Task.Task Error ()
probe settings =
    (do
        conn <- Db.open "sqlite" (Settings.indexReadUrl settings.db)
        Db.queryDecode conn (pendingColumns ++ pendingFrom ++ " LIMIT 0") [] pendingRowDecoder
        Task.succeed ()
    )
        |> Task.mapError (Settings.openFailure "IPE_INDEX_DB" (SafeText.literal "build it from the repo root with `tools/scripts/ipe-index index`, or point IPE_INDEX_DB at an existing index") settings.db)


-- Every unit's id and stored body hash, and whether it has a pending queue
-- row (the rows `pendingFrom` selects), for review progress over the whole
-- index.
type alias UnitState =
    { uid : String
    , bodyHash : String
    , queued : Bool
    }


unitStates : Task.Task Error (List UnitState)
unitStates =
    do
        conn <- openRead
        Db.queryDecode conn
            ("SELECT u.uid, u.body_hash, EXISTS (SELECT 1 FROM change_queue q WHERE q.uid = u.uid AND " ++ pendingChange ++ ") AS queued FROM units u")
            []
            unitStateDecoder


unitStateDecoder : Db.Decode.Decoder UnitState
unitStateDecoder =
    Db.Decode.succeed (\uid hash queued -> { uid = uid, bodyHash = hash, queued = queued /= 0 })
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")
        |> Db.Decode.required "queued" (Db.Decode.int "queued")


-- The index database opened read-only, for listing.
openRead : Task.Task Error Db.Db
openRead =
    do
        settings <- Settings.indexSettings
        Db.open "sqlite" (Settings.indexReadUrl settings.db)


-- The most queue rows one page load reads. An index can hold tens of
-- thousands of queued units, and each loaded unit costs a source-file read
-- plus two review-db lookups, so a load is bounded by this constant rather
-- than by the queue's size.
pageSize : Int
pageSize =
    200


-- Where a page starts in the queue's `(enqueued_at, uid)` order: the head, or
-- strictly after the last row of the previous page. `uid` breaks ties on
-- `enqueued_at`, so the order is total and no row is skipped or repeated
-- across pages.
type Cursor
    = Start
    | After { enqueuedAt : Int, uid : String }


-- A queued unit with the `enqueued_at` it is ordered by, so the caller can
-- build the cursor for the following page.
type alias PendingRow =
    { unit : Unit
    , enqueuedAt : Int
    }


-- The one JOIN/WHERE both the page and the count read, so the total always
-- counts exactly the rows a page can return.
pendingFrom : String
pendingFrom =
    " FROM change_queue q JOIN units u ON u.uid = q.uid WHERE " ++ pendingChange


-- The queue rows still to review; `deleted` rows are never listed.
pendingChange : String
pendingChange =
    "q.change IN ('new','modified')"


pendingColumns : String
pendingColumns =
    "SELECT q.uid, q.change, q.old_hash, q.new_hash, u.path, u.name, u.qualified, u.kind, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha, q.enqueued_at"


pendingOrder : String
pendingOrder =
    " ORDER BY q.enqueued_at, q.uid LIMIT ?"


-- The page query and its bound parameters for `cursor`. Every value is a
-- bound parameter; the page bound is always the last one.
pendingPageQuery : Cursor -> ( String, List SqlValue )
pendingPageQuery cursor =
    case cursor of
        Start ->
            ( pendingColumns ++ pendingFrom ++ pendingOrder, [ SqlInt pageSize ] )

        After at ->
            ( pendingColumns ++ pendingFrom ++ " AND (q.enqueued_at, q.uid) > (?, ?)" ++ pendingOrder
            , [ SqlInt at.enqueuedAt, SqlString at.uid, SqlInt pageSize ]
            )


pendingRowDecoder : Db.Decode.Decoder ( RowUnit, Int )
pendingRowDecoder =
    Db.Decode.andThen
        (\row -> Db.Decode.map (\at -> ( row, at )) enqueuedAtDecoder)
        rowDecoder


enqueuedAtDecoder : Db.Decode.Decoder Int
enqueuedAtDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "enqueued_at" (Db.Decode.int "enqueued_at")


-- One page of queue units (new + modified) at `cursor`, at most `pageSize`
-- rows, each with its source view verified against its tag's index root. A
-- unit whose file is missing, refused or drifted carries that state; only a
-- failed query fails the page.
loadPendingPage : Cursor -> Task.Task Error (List PendingRow)
loadPendingPage cursor =
    let
        ( sql, params ) =
            pendingPageQuery cursor
    in
    do
        settings <- Settings.indexSettings
        conn <- Db.open "sqlite" (Settings.indexReadUrl settings.db)
        rows <- Db.queryDecode conn sql params pendingRowDecoder
        rows
            |> List.map (\( row, at ) -> Task.map (\view -> { unit = withView view row, enqueuedAt = at }) (viewOf settings.roots row))
            |> Task.sequence


countDecoder : Db.Decode.Decoder Int
countDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "total" (Db.Decode.int "total")


-- How many units the whole queue holds, counted over `pendingFrom` without
-- loading a row. A count query that yields no row is a failed read, never a
-- zero.
countPending : Task.Task Error Int
countPending =
    do
        conn <- openRead
        rows <- Db.queryDecode conn ("SELECT COUNT(*) AS total" ++ pendingFrom) [] countDecoder
        singleInt "COUNT(*) over change_queue" rows


bytesDecoder : Db.Decode.Decoder Int
bytesDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "bytes" (Db.Decode.int "bytes")


-- The index database's size in bytes, from SQLite's page count and page
-- size, so the size costs one constant-time query and no file read.
dbBytes : Task.Task Error Int
dbBytes =
    do
        conn <- openRead
        rows <- Db.queryDecode conn "SELECT page_count * page_size AS bytes FROM pragma_page_count(), pragma_page_size()" [] bytesDecoder
        singleInt "the index database size query" rows


singleInt : String -> List Int -> Task.Task Error Int
singleInt what rows =
    case rows of
        [ n ] ->
            Task.succeed n

        _ ->
            Task.fail (Error.unexpected (what ++ " did not return exactly one row"))


-- The review app consumes and clears explicitly: after a unit is decided,
-- its change_queue row is deleted so it stops appearing in queue pages. Only
-- the row queued for the attested hash is deleted: a re-index that re-queued
-- the unit under new content keeps its row, so that change is still reviewed.
drainUnit : Attested -> Task.Task Error Int
drainUnit attested =
    do
        settings <- Settings.indexSettings
        conn <- Db.open "sqlite" (Settings.indexWriteUrl settings.db)
        Db.deleteWhere conn
            "change_queue"
            (Sql.and
                (Sql.eq (Sql.column "uid") (Sql.param (SqlString (attestedUid attested))))
                (Sql.eq (Sql.column "new_hash") (Sql.param (SqlString (attestedHash attested))))
            )


-- The ipe-index `units` table modelled as a typed store over its explicit
-- columns, so a lookup runs through `Store.findBy` with a bound value rather
-- than a hand-written `WHERE` fragment. The store is read-only here — only
-- queried, never migrated — so its column set need only cover the columns a
-- query reads.
unitsStore : Result Error (Store Store.Row)
unitsStore =
    Store.fromColumns "units"
        [ Store.textColumn "uid"
        , Store.textColumn "qualified"
        ]
        |> Result.map Store.public


-- The unit's qualified name from the units table, rendered for display, if
-- the unit still exists (a decided unit whose source was deleted leaves a
-- review row but no name). The `uid` value is bound as a parameter by
-- `Store.findBy`, never interpolated into SQL text.
nameFor : Db.Db -> String -> Task.Task Error (Maybe SafeText)
nameFor conn uid =
    case unitsStore of
        Err e ->
            Task.fail e

        Ok store ->
            do
                rows <- Store.findBy conn store "uid" (SqlString uid)
                case List.head rows of
                    Just row ->
                        Task.succeed (Maybe.map SafeText.renderForeign (Result.toMaybe (Store.readText "qualified" row)))

                    Nothing ->
                        Task.succeed Nothing


-- The one verification of a unit's source. The stored hash is parsed first,
-- so an unknown scheme refuses before any read; then the stored path is
-- resolved, the file read, the line range checked and the view re-hashed.
-- Only a view whose attestation equals the stored one is `Shown`. Every
-- per-unit cause (refused path, unreadable file, bad range, drift) is a
-- `SourceView` state, never a failed task.
viewOf : RootMap -> RowUnit -> Task.Task Error SourceView
viewOf roots row =
    case parseAttested row.bodyHash of
        UnknownScheme _ ->
            Task.succeed (Stale UnverifiableHash)

        Sha256 stored ->
            case RepoPath.resolve roots row.path of
                Err refusal ->
                    Task.succeed (Unreadable (RepoPath.toError refusal))

                Ok path ->
                    File.readFileLimit path sourceCeiling
                        |> Task.map (\text -> verifyView row.uid stored (viewText row.lineStart row.lineEnd text))
                        |> Task.onError (\e -> Task.succeed (Unreadable (readFailure row.path e)))


-- A read error re-worded to name the stored path it came from.
readFailure : String -> Error -> Error
readFailure stored e =
    Error.withMessage
        (SafeText.toString
            (SafeText.concat
                [ SafeText.literal "index path "
                , SafeText.quoted stored
                , SafeText.literal " could not be read: "
                , SafeText.render (Error.message e)
                ]
            )
        )
        e


verifyView : String -> String -> Result StaleReason String -> SourceView
verifyView uid stored sliced =
    case sliced of
        Err reason ->
            Stale reason

        Ok view ->
            if attest view == stored then
                Shown (ShownSource { uid = uid, text = view, hash = stored })

            else
                Stale Drifted


-- The largest source file a unit is sliced from; a bigger file under the root
-- is refused rather than read whole into memory.
sourceCeiling : ByteSize
sourceCeiling =
    ByteSize.mib 16


-- The single decode point from a raw row: the stored hash is parsed here,
-- and every displayed text column is rendered into `SafeText`.
withView : SourceView -> RowUnit -> Unit
withView view row =
    { uid = row.uid
    , change = row.change
    , oldHash = row.oldHash
    , newHash = row.newHash
    , path = SafeText.renderForeign row.path
    , name = SafeText.renderForeign row.name
    , qualified = SafeText.renderForeign row.qualified
    , kind = SafeText.renderForeign row.kind
    , lang = Highlight.langFor row.kind
    , lineStart = row.lineStart
    , lineEnd = row.lineEnd
    , facing = SafeText.renderForeign row.facing
    , purpose = Maybe.map SafeText.renderForeign row.purpose
    , attested = parseAttested row.bodyHash
    , updatedSha = row.updatedSha
    , view = view
    }


-- A stored `body_hash`, parsed once: an attestation this app can re-prove,
-- or a value under any other scheme (a legacy or unknown hash).
type AttestedHash
    = Sha256 String
    | UnknownScheme String


parseAttested : String -> AttestedHash
parseAttested stored =
    if String.startsWith attestScheme stored then
        Sha256 stored

    else
        UnknownScheme stored


-- The stored text, for keying review-db lookups only; never a value to
-- record a decision against.
storedHash : AttestedHash -> String
storedHash attested =
    case attested of
        Sha256 stored ->
            stored

        UnknownScheme stored ->
            stored


-- The first 8 digits of a stored hash, for display: an attestation shows
-- its digest without the scheme prefix, any other value its leading text.
shortHash : String -> String
shortHash stored =
    case parseAttested stored of
        Sha256 attested ->
            String.slice 0 8 (String.dropLeft (String.length attestScheme) attested)

        UnknownScheme other ->
            String.slice 0 8 other


-- Source text proved equal to its attestation. Opaque: built only by
-- `viewOf`, so holding one means the bytes were re-hashed.
type ShownSource
    = ShownSource { uid : String, text : String, hash : String }


shownText : ShownSource -> String
shownText shown =
    case shown of
        ShownSource s ->
            s.text


shownHash : ShownSource -> String
shownHash shown =
    case shown of
        ShownSource s ->
            s.hash


-- The one hash a decision or drain may record: the hash of the bytes that
-- were shown, re-proved against the current index row and file. Opaque:
-- built only by `reverify`.
type Attested
    = Attested { uid : String, hash : String }


attestedUid : Attested -> String
attestedUid attested =
    case attested of
        Attested a ->
            a.uid


attestedHash : Attested -> String
attestedHash attested =
    case attested of
        Attested a ->
            a.hash


-- Re-proves a shown source at decision time: the unit's row is re-read from
-- the index and its file re-hashed through `viewOf`, and the fresh view must
-- be shown under the same hash. A unit gone from the index, or a source that
-- changed or became unreadable since it was shown, is a conflict, so no
-- decision is recorded against bytes the reviewer did not see.
reverify : ShownSource -> Task.Task Error Attested
reverify shown =
    case shown of
        ShownSource s ->
            do
                settings <- Settings.indexSettings
                conn <- Db.open "sqlite" (Settings.indexReadUrl settings.db)
                rows <- Db.queryDecode conn unitByUidSql [ SqlString s.uid ] rowDecoder
                case List.head rows of
                    Just row ->
                        viewOf settings.roots row
                            |> Task.andThen (confirmShown s.uid s.hash)

                    Nothing ->
                        Task.fail (Error.conflict "unit no longer indexed")


confirmShown : String -> String -> SourceView -> Task.Task Error Attested
confirmShown uid hash fresh =
    case fresh of
        Shown now ->
            if shownHash now == hash then
                Task.succeed (Attested { uid = uid, hash = hash })

            else
                Task.fail sourceChanged

        Stale _ ->
            Task.fail sourceChanged

        Unreadable _ ->
            Task.fail sourceChanged


sourceChanged : Error
sourceChanged =
    Error.conflict "source changed since it was shown; reload"


-- Why a unit's source is withheld instead of shown.
type StaleReason
    = Drifted
    | RangeOutOfFile { lineCount : Int }
    | UnverifiableHash


-- What the unit page may show of a unit's source: the verified view, a
-- reason it is withheld, or the error that kept it from being read.
type SourceView
    = Shown ShownSource
    | Stale StaleReason
    | Unreadable Error


-- The scheme prefix of every attestation ipe-index stores in `body_hash`.
attestScheme : String
attestScheme =
    "sha256:"


-- The attestation of a view: the scheme prefix and the view's lowercase hex
-- SHA-256, the exact form ipe-index stores in `units.body_hash`.
attest : String -> String
attest view =
    attestScheme ++ Crypto.sha256 view


-- A file's lines under the attestation's split rule, shared with ipe-index
-- through the vectors file: split on `\n`, keep `\r`, drop the one empty
-- segment a trailing `\n` leaves. `""` is one empty line.
viewLines : String -> List String
viewLines text =
    let
        segments =
            String.split "\n" text
    in
    if String.endsWith "\n" text then
        List.take (List.length segments - 1) segments

    else
        segments


-- Lines `start..end` (1-based, inclusive) of `text` joined by `\n`. A range
-- outside the file is refused with the file's line count, never clamped.
viewText : Int -> Int -> String -> Result StaleReason String
viewText start end text =
    let
        segments =
            viewLines text

        count =
            List.length segments
    in
    if 1 <= start && start <= end && end <= count then
        segments
            |> List.drop (start - 1)
            |> List.take (end - start + 1)
            |> String.join "\n"
            |> Ok

    else
        Err (RangeOutOfFile { lineCount = count })
