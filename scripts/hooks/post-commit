#!/usr/bin/env bash
# post-commit — refresh the ipe-index incrementally so rdeps/locate/parity stay
# current after a commit. Non-blocking by design: the index is a developer
# convenience, never a correctness gate, so any failure (a mid-rebase state, a
# missing binary, a stale DB) is swallowed and the commit always succeeds.
#
# Install via scripts/install-hooks.sh (sets core.hooksPath to scripts/hooks).
REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -x "$REPO/tools/scripts/ipe-index" ] || exit 0
# `update` is the incremental path (git-diff last_sha..HEAD, re-extract changed
# files). Redirect noise and never fail the commit.
"$REPO/tools/scripts/ipe-index" update >/dev/null 2>&1 || true
exit 0
