-- | Std.Compression — gzip + zstd compression (Layer 3 Sky source).
--
-- Operate on raw bytes (`Sky.Core.Bytes` alias = `String`); use
-- `Bytes.fromString` / `Bytes.toBase64` etc. for transport encoding.
--
-- Compression is CPU work — every entry returns `Task Error _` so a
-- caller can run it through `Task.parallel` or off the request
-- goroutine.  Failures (corrupt input on decompress, OOM-class
-- workload) surface as `Err Error`.
--
-- v0.15.47.
module Std.Compression exposing
    ( gzip
    , gunzip
    , zstdCompress
    , zstdDecompress
    )


import Sky.Ffi as Ffi
import Sky.Core.Error exposing (Error)
import Sky.Core.Bytes exposing (Bytes)


-- All entry points operate on `Bytes` — arbitrary byte sequences, not
-- necessarily valid UTF-8.  In the Rust backend `Bytes` is a distinct
-- `Vec<u8>` (a documented divergence from the Go backend, where
-- `Bytes` aliased `String`), so the compression kernels take + return
-- `Bytes` to line up with the runtime `compression_*(Vec<u8>) ->
-- SkyTask<_, Vec<u8>>` signatures.  Convert to/from `String` at the
-- boundary via `Bytes.fromString` / `Bytes.toString` /
-- `Bytes.toBase64` when transport encoding is needed.


-- | `gzip bytes` — RFC 1952 gzip-compress.  Output is a complete
-- gzip stream with header + checksum.
gzip : Bytes -> Task Error Bytes
gzip = Ffi.kernel "Compression_gzip"


-- | `gunzip bytes` — RFC 1952 gzip-decompress.  Fails on truncated
-- or corrupt input.
gunzip : Bytes -> Task Error Bytes
gunzip = Ffi.kernel "Compression_gunzip"


-- | `zstdCompress bytes` — Zstandard (RFC 8478) compress at the
-- default level.  Higher compression ratio than gzip with
-- comparable decompression speed.
zstdCompress : Bytes -> Task Error Bytes
zstdCompress = Ffi.kernel "Compression_zstdCompress"


-- | `zstdDecompress bytes` — Zstandard decompress.  Fails on
-- truncated or corrupt input.
zstdDecompress : Bytes -> Task Error Bytes
zstdDecompress = Ffi.kernel "Compression_zstdDecompress"
