module Ffi.Iced exposing (Counter, Message, counterUpdate)


foreign Counter =
    { crate = "iced"
    , kind = Struct { value = Int }
    , derives = [ Default, Clone ]
    }


foreign Message =
    { crate = "iced"
    , kind = Enum [ Variant "Increment" [], Variant "Decrement" [] ]
    , derives = [ Clone, Debug ]
    }


foreign counterUpdate =
    { crate = "iced"
    , kind = Closure { args = [ Int ], returns = Int }
    }
