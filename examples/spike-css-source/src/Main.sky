module Main exposing (main)

-- Compiled-source `Std.Css` (#47) end-to-end: benign rendering + the three
-- CSS-injection vectors the ratified security posture must neutralise at
-- CONSTRUCTION (value gate, property-name gate, selector gate) with the
-- `stripStyleClose` breakout floor. `Std.Css` is compiled pure Sky; only the
-- four `Sky.Core.CssSafety` leaf kernels are Rust.
import Sky.Core.Prelude exposing (..)
import Std.Css exposing (..)


-- Benign: renders exactly (Go byte-parity — same pure-Sky fold).
benign : String
benign =
    stylesheet
        [ rule ".x" [ color (hex "ff6600"), padding (px 8) ] ]


-- Value-level breakout: `</style><script>` in a declaration value fails
-- `safeValue` → the declaration is DROPPED (`CssDropped`), so the rule body is
-- empty and no tag escapes.
attackValue : String
attackValue =
    stylesheet
        [ rule ".y" [ property "color" "</style><script>alert(1)</script>" ] ]


-- Script-sink: `url(javascript:…)` fails `safeValue` → DROPPED.
attackScheme : String
attackScheme =
    stylesheet
        [ rule ".z" [ property "background" "url(javascript:alert(1))" ] ]


-- Selector-level breakout: a selector carrying `{ } < /` fails `safeSelector`
-- → the WHOLE rule is dropped (`CssRuleDropped`).
attackSelector : String
attackSelector =
    stylesheet
        [ rule "body{}</style><script>alert(1)</script>" [ color (hex "000") ] ]


main =
    println
        (benign
            ++ "\n---\n"
            ++ attackValue
            ++ "\n---\n"
            ++ attackScheme
            ++ "\n---\n"
            ++ attackSelector
        )
