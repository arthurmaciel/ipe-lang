module Main exposing (main)

import Ipe.Parser as Parser exposing (Parser)
import Ipe.Char as Char
import Ipe.Task as Task
import Ipe.List as List
import Ipe.String as String
import Ipe.Io as Io


-- Classify each input as a token, showing the ideas most `Ipe.Parser` code
-- turns on:
--   • `oneOf` tries alternatives in order and commits to the first that matches.
--   • `map` tags a parsed value into a typed result — here a `Token` variant.
--   • `getChompedString (chompWhile …)` captures the exact run of characters a
--     predicate accepted.
--   • `run` is a total `String -> Result (List DeadEnd) a`: an unrecognised
--     input surfaces as a value, never a crash.


type Token
    = Number Int
    | Word String
    | Unknown


-- A token is either a non-negative integer or a run of letters. `oneOf` picks
-- the first branch that matches; a leading non-letter, non-digit falls through
-- to the final `succeed Unknown`, which consumes nothing and always succeeds.
token : Parser Token
token =
    Parser.oneOf
        [ Parser.map Number Parser.int
        , Parser.map Word (Parser.getChompedString (Parser.chompWhile Char.isAlpha))
        , Parser.succeed Unknown
        ]


render : String -> String
render raw =
    case Parser.run token raw of

        Ok (Number n) ->
            raw ++ "  ->  Number " ++ String.fromInt n

        Ok (Word w) ->
            if String.isEmpty w then
                raw ++ "  ->  Unknown"

            else
                raw ++ "  ->  Word " ++ w

        Ok Unknown ->
            raw ++ "  ->  Unknown"

        Err _ ->
            raw ++ "  ->  (parse error)"


inputs : List String
inputs =
    [ "42"
    , "hello"
    , "007"
    , "!"
    ]


main =
    do
        Io.println "Classifying tokens:"
        List.map (\s -> Io.println ("  " ++ render s)) inputs
            |> Task.sequence
            |> Task.map (\_ -> ())
