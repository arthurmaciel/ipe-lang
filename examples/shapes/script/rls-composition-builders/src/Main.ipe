module Main exposing (main)

-- rls-composition-builders — the FOUR canonical row-level-security patterns
-- (Owner, Rbac, Tenant, Sharing) built ENTIRELY by composition over the existing
-- `Ipe.Db.Store` surface: no edit to the core, no new kernel. Each pattern lives
-- in its own `Rls.*` sub-module as thin, named `.ipe` helpers over public
-- exports (`ownerColumn`, `role` / `memberOf` / `claimEquals`, `existsIn` /
-- `correlate`, `allOf` / `anyOf` / `andPolicy`, `readOnly`). This proves the small
-- principled core is COMPLETE for real-world RLS by composition alone — breadth
-- grows as user package code, never by editing the core (PRINCIPLES:
-- community-extensibility).
--
-- Every line is a PURE check — `Store.explain` over a composed policy, or a
-- `Store.secured` classify outcome — so the emitted project builds and runs
-- deterministically with no live database and no `Principal`. The principal-side
-- leaves (`role` / `memberOf` / `claimEquals`) fold to their fail-closed
-- admit/deny answer only once a `Principal` is in hand at lowering; here we
-- observe their STRUCTURE through `explain`, which is what a policy author reads.
--
-- The refusal checks (…-writes / …-absent lines) pin deny-by-default THROUGH the
-- composition: every operation a read-only pattern does not open explains as
-- `no row (denied)`, and a policy naming a column the store lacks fails closed at
-- `secured`. A rejection no line drives is a rejection one edit from vanishing.

import Ipe.Codec as Codec exposing (Codec(..), Shape(..), ColType(..))
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Json.Decode as Decode
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.String as String
import Ipe.Result as Result exposing (Result(..))
import Ipe.Task as Task
import Rls.Owner
import Rls.Rbac
import Rls.Sharing
import Rls.Tenant


-- ── Row fixtures ────────────────────────────────────────────────────────────
--
-- A `Doc` is the secured resource. Its `Codec.auto` columns are the snake_cased
-- field names: `id` / `author` / `region` / `tenant` / `created_at`.
type alias Doc =
    { id : String
    , author : String
    , region : String
    , tenant : String
    , createdAt : String
    }


blankDoc : Doc
blankDoc =
    { id = "", author = "", region = "", tenant = "", createdAt = "" }


docCodec : Codec Doc
docCodec =
    Codec.auto blankDoc


-- A THIN `Doc` codec whose shape names ONLY `id`, so a store built from it lacks
-- `author` / `created_at` — used to prove a policy naming a missing column fails
-- closed at `secured` (deny-by-default, not a silent no-op).
thinDocCodec : Codec Doc
thinDocCodec =
    Codec
        { enc = \d -> Encode.object [ ( "id", Encode.string d.id ) ]
        , mkDec =
            \_ ->
                Decode.map
                    (\i -> { id = i, author = "", region = "", tenant = "", createdAt = "" })
                    (Decode.field "id" Decode.string)
        , shp = SRecord [ ( "id", CText ) ]
        }


-- A `Share` records which member may see which document. Its `Codec.auto`
-- columns are `doc_id` / `member`. The secured share store is owner-scoped on
-- `.member` (its OWN read policy), which composes into every `existsIn` subquery
-- — defence in depth.
type alias Share =
    { docId : String
    , member : String
    }


blankShare : Share
blankShare =
    { docId = "", member = "" }


shareCodec : Codec Share
shareCodec =
    Codec.auto blankShare


-- Build the caller-secured share store, or `Nothing` on any build/classify
-- failure (a caller line turns that into a `build-err` marker).
securedShares : Maybe (Store.Secured Share)
securedShares =
    case Store.fromCodec "shares" shareCodec of
        Err _ ->
            Nothing

        Ok store ->
            case Store.secured (Store.ownerColumn .member) store of
                Ok secured ->
                    Just secured

                Err _ ->
                    Nothing


-- ── Composed policies, one per pattern ──────────────────────────────────────


ownerPolicy : Store.Policy Doc
ownerPolicy =
    Rls.Owner.ownedReadWrite .author .createdAt


rbacRolePolicy : Store.Policy Doc
rbacRolePolicy =
    Rls.Rbac.onlyRole "admin"


rbacOwnerOrRolePolicy : Store.Policy Doc
rbacOwnerOrRolePolicy =
    Store.readOnly (Rls.Rbac.ownerOrRole .author "root" "admin")


tenantPolicy : Store.Policy Doc
tenantPolicy =
    Rls.Tenant.staticTenant "acme"


sharingPolicy : Store.Secured Share -> Store.Policy Doc
sharingPolicy shares =
    Rls.Sharing.sharedVia shares
        (\share doc -> Store.correlate share.docId doc.id)


-- ── main ────────────────────────────────────────────────────────────────────


main : Task Error ()
main =
    Io.println
        (String.join "\n"
            [ -- Owner
              clauseLine "owner-read" "read" ownerPolicy
            , immutableLine "owner-immutable" ownerPolicy

            -- Rbac
            , clauseLine "rbac-read" "read" rbacRolePolicy
            , clauseLine "rbac-group" "read" (Rls.Rbac.onlyGroup "platform")
            , clauseLine "rbac-any" "read" rbacOwnerOrRolePolicy

            -- Tenant
            , clauseLine "tenant-read" "read" tenantPolicy
            , clauseLine "tenant-claim" "read" (Rls.Tenant.staticTenantClaim "org" "beta")

            -- Sharing
            , sharingReadLine
            , sharingOkLine

            -- Refusals: the owner pattern opens writes ONLY to the owner (never
            -- world-open) — its insert is `author = caller subject`, so a caller
            -- can write only rows it owns. Every read-only pattern's writes stay
            -- `never` (deny-by-default).
            , clauseLine "owner-write" "insert" ownerPolicy
            , clauseLine "rbac-refuse-insert" "insert" rbacRolePolicy
            , clauseLine "rbac-refuse-update" "update" rbacRolePolicy
            , clauseLine "rbac-refuse-delete" "delete" rbacRolePolicy
            , clauseLine "tenant-refuse-insert" "insert" tenantPolicy
            , clauseLine "sharing-refuse-insert" "insert" (sharingRefusalPolicy)

            -- Refusals: a policy naming a missing column fails closed at `secured`
            , ownerMissingColumnLine
            , goodClassifyLine

            -- Refusals: a caller-side leaf classifies `Ok` (it names no row
            -- column) yet its structure is deny-by-default until the Principal
            -- proves the role/claim — pinned by the `no row (denied)` writes above.
            , principalLeafOkLine
            ]
        )


-- A sharing policy over the good share store, or a fail marker when the share
-- store did not build — used only for the write-refusal check.
sharingRefusalPolicy : Store.Policy Doc
sharingRefusalPolicy =
    case securedShares of
        Just shares ->
            sharingPolicy shares

        Nothing ->
            Store.readOnly Store.never


-- The `read:` clause of the sharing policy, proving `explain` renders the
-- correlation AND the composed share read policy as transparent text.
sharingReadLine : String
sharingReadLine =
    case securedShares of
        Just shares ->
            clauseLine "sharing-read" "read" (sharingPolicy shares)

        Nothing ->
            "sharing-read:build-err"


-- `secured` over the good `docs` store with the sharing policy → `Ok` (both
-- correlation columns exist on their own side; the share store's own read policy
-- composes in).
sharingOkLine : String
sharingOkLine =
    case ( Store.fromCodec "docs" docCodec, securedShares ) of
        ( Ok store, Just shares ) ->
            classifyMarker "sharing-ok" store (sharingPolicy shares)

        _ ->
            "sharing-ok:build-err"


-- `secured (ownerColumn .author)` over a store whose columns lack `author` →
-- fail-closed typed `Err` (deny-by-default: a policy over a missing column is
-- never a silent no-op).
ownerMissingColumnLine : String
ownerMissingColumnLine =
    case Store.fromCodec "docs2" thinDocCodec of
        Err _ ->
            "owner-missing:build-err"

        Ok store ->
            classifyMarker "owner-missing" store (Rls.Owner.ownedBy .author)


-- `secured` over the good store with the owner+immutable policy → `Ok`.
goodClassifyLine : String
goodClassifyLine =
    case Store.fromCodec "docs3" docCodec of
        Err _ ->
            "owner-classify:build-err"

        Ok store ->
            classifyMarker "owner-classify" store ownerPolicy


-- A caller-side role leaf names NO row column, so a policy built from one
-- classifies `Ok` even over the THIN store (which lacks `author`) — it smuggles
-- no phantom column into `secured`'s column-validation surface. Its deny-by-
-- default meaning lives in the fold at lowering, pinned by the write refusals.
principalLeafOkLine : String
principalLeafOkLine =
    case Store.fromCodec "docs4" thinDocCodec of
        Err _ ->
            "principal-leaf:build-err"

        Ok store ->
            classifyMarker "principal-leaf" store rbacRolePolicy


-- ── explain / classify plumbing ──────────────────────────────────────────────


-- `label:<clause value>` — the value of the `explain` clause named `clause`
-- (read / insert / update / delete), trimmed.
clauseLine : String -> String -> Store.Policy row -> String
clauseLine label clause policy =
    String.concat [ label, ":", clauseValue clause policy ]


-- `label:<immutable columns clause value>`.
immutableLine : String -> Store.Policy row -> String
immutableLine label policy =
    String.concat [ label, ":", immutableValue policy ]


-- `label:ok` when `secured` classifies the policy over the store, else
-- `label:err` (fail-closed).
classifyMarker : String -> Store.Store row -> Store.Policy row -> String
classifyMarker label store policy =
    case Store.secured policy store of
        Ok _ ->
            String.concat [ label, ":ok" ]

        Err _ ->
            String.concat [ label, ":err" ]


-- The value of the `explain` clause labelled `<clause>` — the text after the
-- clause's colon, trimmed — or `""` when the clause is absent.
clauseValue : String -> Store.Policy row -> String
clauseValue clause policy =
    lineValue (String.append clause ":") (Store.explain policy)


-- The value of the `immutable columns:` clause of a policy's `explain`.
immutableValue : Store.Policy row -> String
immutableValue policy =
    lineValue "immutable columns:" (Store.explain policy)


-- The trimmed text after the first `:` of the first line of `text` starting with
-- `prefix`, or `""` when no such line exists.
lineValue : String -> String -> String
lineValue prefix text =
    case List.head (List.filter (String.startsWith prefix) (String.lines text)) of
        Just line ->
            String.trim (afterColon line)

        Nothing ->
            ""


-- Everything after the first `:` in `s`, or `s` unchanged when it has none.
afterColon : String -> String
afterColon s =
    case String.split ":" s of
        _ :: rest ->
            String.join ":" rest

        [] ->
            s
