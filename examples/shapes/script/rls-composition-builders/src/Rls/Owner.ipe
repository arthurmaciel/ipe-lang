module Rls.Owner exposing (ownedBy, ownedReadWrite)

-- The OWNER row-security pattern, composed entirely over the existing
-- `Ipe.Db.Store` surface — no core edit, no new kernel. A row belongs to the
-- caller when its owner column equals the caller's subject; only the owner may
-- read or write it.
--
-- The whole pattern is `Store.ownerColumn`, which scopes all four operations to
-- `column = $subject` AND forces that column to the caller's subject on every
-- write (so a caller can never insert or update a row it could not read back).
-- These helpers only NAME that composition for the four canonical patterns to
-- read side by side; each is a plain `.ipe` value built from public exports.

import Ipe.Db.Store as Store exposing (Policy)


-- | `ownedBy accessor` — the owner-scoped policy over the accessor-named column:
-- read/insert/update/delete are all `column = caller subject`, and writes force
-- the owner column to the caller. This IS `Store.ownerColumn`, named for the
-- pattern.
ownedBy : (row -> t) -> Policy row
ownedBy accessor =
    Store.ownerColumn accessor


-- | `ownedReadWrite accessor immutableAccessor` — owner-scoped, with the
-- immutable column pinned at insert (its stored value cannot change on update).
-- Composed from `ownerColumn` AND `immutable`; `always` is the neutral element of
-- the per-operation conjunction, so `immutable` adds the update restriction
-- without loosening any operation.
ownedReadWrite : (row -> t) -> (row -> u) -> Policy row
ownedReadWrite ownerAccessor immutableAccessor =
    Store.ownerColumn ownerAccessor
        |> Store.andPolicy (Store.immutable immutableAccessor)
