module Rls.Tenant exposing (staticTenant, staticTenantClaim, dynamicTenant)

-- The TENANT-isolation row-security pattern, composed over the existing
-- `Ipe.Db.Store` surface — no core edit, no new kernel. Two contrasting shapes:
--
--   * STATIC — `Store.claimEquals "tenant" value` gates the whole table to one
--     tenant: it admits every row only when the caller's verified `tenant` claim
--     equals `value`, and denies every row otherwise. Fail-closed on BOTH an
--     absent claim (`Nothing`) and a mismatched value. Use it when a table holds
--     exactly one tenant's rows and the tenant is fixed for the caller.
--
--   * DYNAMIC — `Store.existsIn` over a caller-scoped memberships store isolates
--     PER ROW: a row is visible only when a membership row correlates the caller's
--     tenant to the row's tenant column. The memberships store carries its OWN
--     read policy, which composes into the EXISTS subquery (defence in depth).
--     Use it when one table holds many tenants' rows and visibility follows the
--     caller's memberships rather than a single fixed claim.

import Ipe.Db.Store as Store exposing (Policy, Secured)


-- | `staticTenant value` — a read-only policy admitting rows only when the
-- caller's verified `tenant` claim equals `value`. The claim gates on the caller,
-- names no row column, and is fail-closed: an absent or mismatched claim denies.
staticTenant : String -> Policy row
staticTenant value =
    Store.readOnly (Store.claimEquals "tenant" value)


-- | `staticTenantClaim key value` — the same gate over an arbitrary claim `key`,
-- for a table keyed on a claim other than `tenant`.
staticTenantClaim : String -> String -> Policy row
staticTenantClaim key value =
    Store.readOnly (Store.claimEquals key value)


-- | `dynamicTenant memberships correlation` — a read-only policy admitting a row
-- only when a row of the caller-scoped `memberships` store satisfies BOTH the
-- `correlation` (the row's tenant column matched against a membership column) AND
-- the memberships store's OWN read policy, composed into the subquery. Per-row
-- isolation: the caller sees only the rows whose tenant they belong to. Built
-- from `existsIn`, which validates both correlation columns against their own
-- store.
dynamicTenant :
    Secured membership
    -> (membership -> row -> Store.Pred membership)
    -> Policy row
dynamicTenant memberships correlation =
    Store.readOnly (Store.existsIn memberships correlation)
