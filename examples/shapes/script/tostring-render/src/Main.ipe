module Main exposing (main)

import Ipe.Io as Io

-- `toString` (the `Ipe.Basics` prelude default) renders any `Stringify`
-- value to `String` without a per-type function to memorise, and a
-- `"""..."""` triple-quoted string additionally supports `{{expr}}`
-- interpolation, auto-stringified through `toString`. Two ideas:
--   • `toString` is total over `Int`, `Float`, and `Bool` — no `Maybe`,
--     no `Result` to unwrap.
--   • `{{expr}}` interpolation reads closer to the rendered output than a
--     `++`/`String.concat` chain of the same pieces.


-- A one-line summary row, each field interpolated straight into the string.
row : String -> Int -> Float -> Bool -> String
row label count ratio enabled =
    """{{label}}: count={{count}} ratio={{ratio}} enabled={{enabled}}"""


main =
    do
        Io.println (row "alpha" 3 0.75 True)
        Io.println (row "beta" 128 1.5 False)
