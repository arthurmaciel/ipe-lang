module Main exposing (main)

{-|
A full-screen TEA counter over the canonical `Tui.app` surface.

`Tui.app` re-exports the terminal `appScreen` entry: the `view` paints a
typed `Ipe.Ui` `Element` tree to terminal cells, and the `onKey` callback
maps each key event to a `Msg`.

Keys:
    Up / k     increment
    Down / j   decrement
    r          reset to zero
    q          quit (Ctrl-C also quits)
-}

import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tea.Tui as Tui
import Ipe.Tea.Tui.Cmd as Cmd
import Ipe.Tea.Tui.Sub as Sub
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Font as Font


type Msg
    = Increment
    | Decrement
    | Reset
    | Quit
    | NoOp


type alias Model =
    { count : Int }


init : () -> ( Model, Cmd Msg )
init _unit =
    ( { count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Decrement ->
            ( { model | count = model.count - 1 }, Cmd.none )

        Reset ->
            ( { count = 0 }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.column [ Ui.spacing 12, Ui.padding 16 ]
        [ Ui.el [ Font.bold ] (Ui.text "Ipê tui counter")
        , Ui.text ("count = " ++ String.fromInt model.count)
        , Ui.text "(Up/k +, Down/j -, r reset, q quit)"
        ]


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey key =
    if key.kind == "up" then
        Increment

    else if key.kind == "down" then
        Decrement

    else if key.kind == "char" && key.value == "k" then
        Increment

    else if key.kind == "char" && key.value == "j" then
        Decrement

    else if key.kind == "char" && key.value == "r" then
        Reset

    else if key.kind == "char" && key.value == "q" then
        Quit

    else if key.kind == "ctrl" && key.value == "c" then
        Quit

    else
        NoOp


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }
