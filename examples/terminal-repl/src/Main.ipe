module Main exposing (main)

-- An accumulator calculator as a terminal line REPL: the same TEA loop as the
-- graphical shapes, driven by standard input. `Terminal.appLines` renders `view`
-- to stdout, reads one line at a time, turns each into a `Msg` via `onLine`, folds
-- it through `update`, and re-renders.
--
-- Each line is a command:
--
--     add N    add N to the running total
--     sub N    subtract N
--     mul N    multiply by N
--     reset    set the total back to 0
--     quit     exit (end-of-input also exits)
--
-- `view` prints the last outcome and the current total, then a prompt. Anything
-- that is not one of those commands prints a friendly error line and leaves the
-- total unchanged.

import Ipe.String as String
import Ipe.System as System
import Ipe.Tea.Terminal exposing (appLines)
import Ipe.Cmd as Cmd
import Ipe.Sub as Sub


-- A parsed input line. Parsing happens once, at the edge (`onLine`), so `update`
-- only ever folds well-formed commands and never re-inspects raw text.
type Command
    = Add Int
    | Sub Int
    | Mul Int
    | Reset
    | Quit
    | Unknown String


type Msg
    = Entered Command


type alias Model =
    { total : Int
    , outcome : String
    }


init : () -> ( Model, Cmd Msg )
init _unit =
    ( { total = 0, outcome = "ready" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Entered command ->
            case command of
                Add n ->
                    ( { total = model.total + n, outcome = "added " ++ String.fromInt n }
                    , Cmd.none
                    )

                Sub n ->
                    ( { total = model.total - n, outcome = "subtracted " ++ String.fromInt n }
                    , Cmd.none
                    )

                Mul n ->
                    ( { total = model.total * n, outcome = "multiplied by " ++ String.fromInt n }
                    , Cmd.none
                    )

                Reset ->
                    ( { total = 0, outcome = "reset" }, Cmd.none )

                Quit ->
                    ( model, Cmd.perform (System.exit 0) (\_ -> Entered (Unknown "")) )

                Unknown raw ->
                    ( { model | outcome = "?  unknown command: " ++ raw ++ "  (try: add N, sub N, mul N, reset, quit)" }
                    , Cmd.none
                    )


view : Model -> String
view model =
    model.outcome
        ++ "\n= "
        ++ String.fromInt model.total
        ++ "\n> "


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


-- Parse one input line into a `Command`. A bare command word (`reset` / `quit`)
-- takes no argument; the arithmetic commands take a single integer argument.
onLine : String -> Msg
onLine line =
    Entered (parse (String.trim line))


parse : String -> Command
parse line =
    case String.words line of
        verb :: rest ->
            case verb of
                "reset" ->
                    Reset

                "quit" ->
                    Quit

                "add" ->
                    parseBinary Add rest line

                "sub" ->
                    parseBinary Sub rest line

                "mul" ->
                    parseBinary Mul rest line

                _ ->
                    Unknown line

        [] ->
            Unknown line


-- An arithmetic command is a verb plus exactly one integer argument. Anything
-- else — no argument, extra words, or a non-integer — is reported as unknown.
parseBinary : (Int -> Command) -> List String -> String -> Command
parseBinary build rest line =
    case rest of
        argument :: [] ->
            case String.toInt argument of
                Just n ->
                    build n

                Nothing ->
                    Unknown line

        _ ->
            Unknown line


main =
    appLines
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onLine = onLine
        }
