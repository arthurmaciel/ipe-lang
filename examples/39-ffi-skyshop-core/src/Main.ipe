module Main exposing (main)

-- The 13-skyshop domain core with its Go FFI deps converted to Rust crates:
-- order IDs come from the REAL crates.io `uuid` crate through the shim-free
-- auto-FFI (`Rust.Uuid`), persistence is Ipe.Db SQLite (the Firestore
-- replacement), and everything else is Ipe stdlib.

import Ipe.Prelude exposing (..)
import Ipe.Task as Task
import Ipe.Error as Error
import Ipe.List as List
import Ipe.Db as Db
import Rust.Uuid as Uuid
import Ipe.Log exposing (println)


dbPath = "skyshop_core.db"


createTables = """
CREATE TABLE IF NOT EXISTS products (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    cents INTEGER NOT NULL,
    stock INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS orders (
    order_id TEXT PRIMARY KEY,
    product_id INTEGER NOT NULL,
    qty INTEGER NOT NULL,
    total_cents INTEGER NOT NULL
);
"""


-- Order IDs are minted by the REAL `uuid` crate (v4), exactly where the sky
-- original called `github.com/google/uuid`.
mintOrderId : Task Error String
mintOrderId =
    case Uuid.new_v4_from_uuid () of
        Ok id ->
            Task.fromResult (Uuid.to_string_from_uuid id)

        Err e ->
            Task.fail e


seedProducts db =
    Db.exec db
        "INSERT INTO products (name, cents, stock) VALUES (?, ?, ?)"
        [ SqlString "Ipe Mug", SqlInt 1450, SqlInt 10 ]
        |> Task.andThen
            (\_ ->
                Db.exec db
                    "INSERT INTO products (name, cents, stock) VALUES (?, ?, ?)"
                    [ SqlString "Ipe Tee", SqlInt 2900, SqlInt 5 ]
            )


placeOrder db orderId =
    Db.exec db
        "INSERT INTO orders (order_id, product_id, qty, total_cents) VALUES (?, ?, ?, ?)"
        [ SqlString orderId, SqlInt 1, SqlInt 2, SqlInt 2900 ]
        |> Task.andThen
            (\_ -> Db.exec db "UPDATE products SET stock = stock - 2 WHERE id = 1" [])


verifyOrder db orderId =
    Db.query db "SELECT order_id, total_cents FROM orders WHERE order_id = ?" [ orderId ]
        |> Task.andThen
            (\rows ->
                case List.head rows of
                    Just row ->
                        if Db.getString "order_id" row == orderId && Db.getInt "total_cents" row == 2900 then
                            Task.succeed ()

                        else
                            Task.fail (Error.unexpected "order row mismatch")

                    Nothing ->
                        Task.fail (Error.unexpected "order not persisted")
            )


run : Task Error ()
run =
    Db.open "sqlite" dbPath
        |> Task.andThen
            (\db ->
                Db.execRaw db createTables
                    |> Task.andThen (\_ -> seedProducts db)
                    |> Task.andThen (\_ -> mintOrderId)
                    |> Task.andThen
                        (\orderId ->
                            if String.length orderId == 36 then
                                placeOrder db orderId
                                    |> Task.andThen (\_ -> verifyOrder db orderId)

                            else
                                Task.fail (Error.unexpected ("bad order id: " ++ orderId))
                        )
            )


main : Task Error ()
main =
    run |> Task.andThen (\_ -> println "[SKYSHOP-CORE OK]")
