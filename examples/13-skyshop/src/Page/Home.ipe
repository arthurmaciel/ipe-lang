module Page.Home exposing (viewHome, viewProducts)

import Ipe.Prelude exposing (..)
import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Input as Input
import Ipe.Ui.Region as Region
import State exposing (..)
import Ui.Layout as Layout
import Lib.Db as Db
import Lib.Money as Money
import Lib.Translation as Tr
import Lib.Products as Products


-- ══════════════════════════════════════════════════════
-- HOME PAGE
-- ══════════════════════════════════════════════════════
viewHome : Model -> Html.Html Msg
viewHome model =
    Ui.layout []
        (Layout.shell
            model
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 32 ]
                [ hero model
                , categoryBar model
                , featuredProducts model
                ]))


hero : Model -> Element Msg
hero model =
    let
        lang = model.lang
    in
        Ui.column
            [ Ui.width Ui.fill
            , Ui.paddingXY 32 40
            , Ui.spacing 12
            , Background.color (Ui.rgb 15 23 42)
            , Border.rounded 12
            ]
            [ Ui.el
                  [ Font.color (Ui.rgb 96 165 250)
                  , Font.size 12
                  , Font.bold
                  ]
                  (Ui.text (String.toUpper (Tr.t lang "hero.badge")))
            , Ui.el
                  [ Region.heading 1
                  , Font.color (Ui.rgb 255 255 255)
                  , Font.size 36
                  , Font.bold
                  ]
                  (Ui.text (Tr.t lang "app.name"))
            , Ui.paragraph
                  [ Font.color (Ui.rgb 156 163 175), Font.size 16 ]
                  [ Ui.text (Tr.t lang "hero.subtitle") ]
            , Layout.primaryButton (Navigate ProductsPage) (Tr.t lang "hero.cta")
            ]


categoryBar : Model -> Element Msg
categoryBar model =
    Ui.wrappedRow
        [ Ui.spacing 8, Ui.width Ui.fill ]
        (List.map (categoryChip model) (List.take 6 allCategories))


categoryChip : Model -> String -> Element Msg
categoryChip model cat =
    Ui.button
        [ Background.color (Ui.rgb 243 244 246)
        , Background.hoverColor (Ui.rgb 229 231 235)
        , Font.color Layout.muted
        , Font.size 14
        , Font.weight 500
        , Border.rounded 999
        , Ui.paddingXY 16 8
        ]
        { onPress = Just (SetCategoryFilter cat)
        , label = Ui.text (Tr.tCategory model.lang cat)
        }


featuredProducts : Model -> Element Msg
featuredProducts model =
    let
        featured = List.take 8 model.products
    in
        Ui.column
            [ Ui.width Ui.fill, Ui.spacing 16 ]
            [ Ui.row
                  [ Ui.width Ui.fill ]
                  [ Layout.sectionHeading (Tr.t model.lang "home.featured")
                  , Ui.el [ Ui.width Ui.fill ] Ui.none
                  , Ui.button
                        [ Font.color Layout.brand, Font.size 14, Font.semiBold ]
                        { onPress = Just (Navigate ProductsPage)
                        , label = Ui.text (Tr.t model.lang "home.viewAll")
                        }
                  ]
            , productGrid model featured
            ]


-- ══════════════════════════════════════════════════════
-- PRODUCTS PAGE
-- ══════════════════════════════════════════════════════
viewProducts : Model -> Html.Html Msg
viewProducts model =
    Ui.layout []
        (Layout.shell
            model
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 24 ]
                [ Ui.column
                      [ Ui.spacing 4 ]
                      [ Ui.el
                            [ Region.heading 1
                            , Font.size 30
                            , Font.bold
                            , Font.color Layout.ink
                            ]
                            (Ui.text (Tr.t model.lang "nav.products"))
                      , Ui.el [ Font.color Layout.muted ]
                            (Ui.text (Tr.t model.lang "hero.browse"))
                      ]
                , toolbar model
                , productGrid model model.products
                ]))


toolbar : Model -> Element Msg
toolbar model =
    let
        lang = model.lang
    in
        Ui.column
            [ Ui.width Ui.fill, Ui.spacing 16 ]
            [ Input.text
                  [ Ui.width Ui.fill ]
                  { onChange = SetSearch
                  , text = model.search
                  , placeholder =
                        Just (Input.placeholder [] (Ui.text (Tr.t lang "product.search")))
                  , label = Input.labelHidden "search"
                  }
            , Ui.wrappedRow
                  [ Ui.spacing 8 ]
                  (filterChip model "all" (Tr.t lang "product.all")
                      :: List.map
                             (\cat ->
                                 filterChip model cat (Tr.tCategory lang cat))
                             allCategories)
            , Ui.row
                  [ Ui.spacing 8 ]
                  [ Ui.el [ Font.color Layout.muted, Font.size 14 ]
                        (Ui.text (Tr.t lang "product.sortBy"))
                  , sortChip model "newest" (Tr.t lang "product.sort.newest")
                  , sortChip model "price" (Tr.t lang "product.sort.price")
                  , sortChip model "title" (Tr.t lang "product.sort.title")
                  , Ui.button
                        [ Border.width 1
                        , Border.color Layout.hairline
                        , Border.rounded 6
                        , Ui.paddingXY 10 6
                        , Font.color Layout.ink
                        ]
                        { onPress = Just ToggleSortDir
                        , label =
                              Ui.text
                                  (if model.sortDir == "asc" then
                                      "↑"

                                  else
                                      "↓")
                        }
                  ]
            ]


filterChip : Model -> String -> String -> Element Msg
filterChip model value label =
    let
        active = model.categoryFilter == value
    in
        Ui.button
            [ Background.color
                  (if active then
                      Layout.brand

                  else
                      Layout.cardBg)
            , Font.color
                  (if active then
                      Ui.rgb 255 255 255

                  else
                      Layout.muted)
            , Border.width 1
            , Border.color
                  (if active then
                      Layout.brand

                  else
                      Layout.hairline)
            , Font.size 14
            , Border.rounded 999
            , Ui.paddingXY 16 6
            ]
            { onPress = Just (SetCategoryFilter value), label = Ui.text label }


sortChip : Model -> String -> String -> Element Msg
sortChip model value label =
    let
        active = model.sortBy == value
    in
        Ui.button
            [ Background.color
                  (if active then
                      Layout.ink

                  else
                      Layout.cardBg)
            , Font.color
                  (if active then
                      Ui.rgb 255 255 255

                  else
                      Layout.muted)
            , Border.width 1
            , Border.color
                  (if active then
                      Layout.ink

                  else
                      Layout.hairline)
            , Font.size 14
            , Border.rounded 6
            , Ui.paddingXY 12 6
            ]
            { onPress = Just (SetSortBy value), label = Ui.text label }


-- ══════════════════════════════════════════════════════
-- PRODUCT GRID
-- ══════════════════════════════════════════════════════
productGrid : Model -> List (Dict String String) -> Element Msg
productGrid model products =
    if List.isEmpty products then
        Ui.el
            [ Ui.width Ui.fill
            , Ui.paddingXY 24 48
            , Font.color Layout.muted
            , Font.alignCenter
            ]
            (Ui.text (Tr.t model.lang "product.noResults"))

    else
        Ui.wrappedRow
            [ Ui.spacing 16, Ui.width Ui.fill ]
            (List.map (productCard model) products)


productCard : Model -> Dict String String -> Element Msg
productCard model product =
    let
        productId = Db.getField "id" product
        title = Db.getField "title" product
        category = Db.getField "category" product
        pricing = Money.formatPriceFromRow product
        stock = Db.getInt "stock" product
    in
        Ui.column
            [ Ui.width (Ui.px 260)
            , Ui.spacing 8
            , Background.color Layout.cardBg
            , Border.rounded 8
            , Border.width 1
            , Border.color Layout.hairline
            , Ui.padding 16
            ]
            [ Ui.el
                  [ Ui.width Ui.fill
                  , Ui.height (Ui.px 140)
                  , Background.color (Ui.rgb 243 244 246)
                  , Border.rounded 6
                  , Font.alignCenter
                  , Font.color Layout.muted
                  , Font.size 12
                  ]
                  (Ui.text category)
            , Ui.row
                  [ Ui.width Ui.fill ]
                  [ Ui.el
                        [ Font.color (Ui.rgb 59 130 246), Font.size 11, Font.bold ]
                        (Ui.text (String.toUpper (Tr.tCategory model.lang category)))
                  , Ui.el [ Ui.width Ui.fill ] Ui.none
                  , stockDot stock
                  ]
            , Ui.el
                  [ Font.color Layout.ink, Font.size 15, Font.semiBold ]
                  (Ui.text title)
            , priceView pricing
            , Layout.primaryButton (Navigate (ProductPage productId)) (Tr.t model.lang "product.addToCart")
            ]


priceView : Money.Price -> Element Msg
priceView pricing =
    if pricing.hasDiscount then
        Ui.row
            [ Ui.spacing 8 ]
            [ Ui.el [ Font.color (Ui.rgb 220 38 38), Font.size 18, Font.bold ]
                (Ui.text pricing.discounted)
            , Ui.el [ Font.color Layout.muted, Font.size 14 ]
                (Ui.text pricing.original)
            ]

    else
        Ui.el [ Font.color Layout.ink, Font.size 18, Font.bold ]
            (Ui.text pricing.original)


stockDot : Int -> Element Msg
stockDot stock =
    Ui.el
        [ Ui.width (Ui.px 8)
        , Ui.height (Ui.px 8)
        , Border.rounded 999
        , Background.color
              (if stock == 0 then
                  Layout.danger

              else
                  Layout.success)
        ]
        Ui.none
