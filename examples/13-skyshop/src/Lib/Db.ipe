module Lib.Db exposing
    ( getDoc
    , setDoc
    , queryDocs
    , queryWhere
    , queryWhereOrder
    , deleteDoc
    , getField
    , getInt
    , getBool
    , intVal
    , boolVal
    , floatVal
    , initDb
    , queryWhereOrLog
    , queryWhereOrderOrLog
    , queryDocsOrLog
    , encodeFields
    )

-- Persistence over the REAL crates.io `firestore` crate, auto-FFI-bound
-- shim-free (`Rust.Firestore`). Documents are flat string-valued rows
-- (`Dict String String`), written as flat JSON objects and read back from the
-- SDK's JSON rendering by `rowFromJson` below. `queryWhere`/`queryWhereOrder`
-- fetch the collection and filter/sort in Ipe (the typed query-filter builder
-- needs a `FirestoreValue` constructor that is not on the bound surface —
-- recorded over-restriction, equivalent behavior).

import Ipe.Prelude exposing (..)
import Ipe.Maybe as Maybe
import Ipe.Dict as Dict
import Ipe.List as List
import Ipe.Result as Result
import Ipe.String as String
import Ipe.Json.Encode as JsonEnc
import Ipe.Task as Task
import Ipe.System as System
import Ipe.Log exposing (println)
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
import Rust.Firestore as Fs exposing (FirestoreDb)

-- ══════════════════════════════════════════════════════
-- FIELD ACCESSORS (unchanged from the original)
-- ══════════════════════════════════════════════════════
getField field row =
    Maybe.withDefault "" (Dict.get field row)

getInt field row =
    let
        val = getField field row
    in
        if val == "" then
            0

        else
            val |> String.toInt |> Maybe.withDefault 0

getBool field row =
    let
        val = getField field row
    in
        val == "1" || val == "true"

-- Value wrappers for storing native types in a flat row Dict (String values).
intVal : Int -> String
intVal n =
    String.fromInt n

boolVal : Bool -> String
boolVal b =
    if b then
        "true"

    else
        "false"

floatVal : Float -> String
floatVal f =
    String.fromFloat f

-- ══════════════════════════════════════════════════════
-- CLIENT
-- ══════════════════════════════════════════════════════
projectId : () -> String
projectId _ =
    let
        fromEnv =
            Result.withDefault "" (Task.run (System.getenv "GOOGLE_CLOUD_PROJECT"))
    in
        if fromEnv == "" then
            "demo-project"

        else
            fromEnv

-- One Firestore client per operation: the Lib boundary is synchronous
-- (`Result`), so each call builds the client, runs its Task chain, and folds
-- back to `Result` via `Task.run`.
withDb : (FirestoreDb -> Task Error a) -> Result Error a
withDb use =
    Task.run
        (Task.fromResult (Fs.new_from_firestoreDbOptions (projectId ()))
            |> Task.andThen Fs.with_options_from_firestoreDb
            |> Task.andThen use
        )

initDb _ =
    let
        _ = println "[DB] firestore client configured (shim-free auto-FFI)"
    in
        ()

-- ══════════════════════════════════════════════════════
-- ROW CODEC (Dict String String <-> flat JSON object text)
-- ══════════════════════════════════════════════════════
encodeFields : Dict String String -> String
encodeFields data =
    let
        pairs = Dict.toList data
        jsonPairs = List.map (\( k, v ) -> ( k, JsonEnc.string v )) pairs
    in
        JsonEnc.encode 0 (JsonEnc.object jsonPairs)

-- Parse ONE flat JSON object of string values ({"k":"v", ...}) — exactly the
-- shape `encodeFields` writes and the SDK returns for these documents. A
-- non-string value (never produced by this app) is skipped.
rowFromJson : String -> Dict String String
rowFromJson text =
    parseObject (String.toList text) Dict.empty

parseObject : List Char -> Dict String String -> Dict String String
parseObject chars acc =
    case skipToQuote chars of

        Nothing ->
            acc

        Just afterOpen ->
            case takeString afterOpen "" of

                Nothing ->
                    acc

                Just ( key, afterKey ) ->
                    case skipToColon afterKey of

                        Nothing ->
                            acc

                        Just afterColon ->
                            case skipToQuote afterColon of

                                Nothing ->
                                    -- Non-string value: skip to the next comma.
                                    parseObject (skipValue afterColon) acc

                                Just afterValOpen ->
                                    case takeString afterValOpen "" of

                                        Nothing ->
                                            acc

                                        Just ( value, rest ) ->
                                            parseObject rest (Dict.insert key value acc)

-- Position after the next unescaped '"'; Nothing when none remains. Stops at
-- a '}' between entries only when no further quote exists.
skipToQuote : List Char -> Maybe (List Char)
skipToQuote chars =
    case chars of

        [] ->
            Nothing

        c :: rest ->
            if c == '"' then
                Just rest

            else
                skipToQuote rest

skipToColon : List Char -> Maybe (List Char)
skipToColon chars =
    case chars of

        [] ->
            Nothing

        c :: rest ->
            if c == ':' then
                Just rest

            else
                skipToColon rest

-- Consume a JSON string body up to its closing quote, unescaping \" \\ \n \t.
takeString : List Char -> String -> Maybe ( String, List Char )
takeString chars acc =
    case chars of

        [] ->
            Nothing

        '\\' :: esc :: rest ->
            let
                unescaped =
                    if esc == 'n' then
                        "\n"

                    else if esc == 't' then
                        "\t"

                    else if esc == 'r' then
                        "\r"

                    else
                        String.fromList [ esc ]
            in
                takeString rest (acc ++ unescaped)

        c :: rest ->
            if c == '"' then
                Just ( acc, rest )

            else
                takeString rest (acc ++ String.fromList [ c ])

-- Skip a non-string JSON value: everything up to the next top-level ',' or
-- the end of the object.
skipValue : List Char -> List Char
skipValue chars =
    case chars of

        [] ->
            []

        c :: rest ->
            if c == ',' || c == '}' then
                rest

            else
                skipValue rest

-- ══════════════════════════════════════════════════════
-- CORE API (over the auto-bound firestore SDK)
-- ══════════════════════════════════════════════════════
getDoc : String -> String -> Result Error (Maybe (Dict String String))
getDoc collection docId =
    withDb (\db -> Fs.get_obj_if_exists_from_firestoreDb db collection docId Nothing)
        |> Result.map (Maybe.map rowFromJson)

setDoc : String -> String -> Dict String String -> Result Error ()
setDoc collection docId data =
    withDb
        (\db ->
            Fs.update_obj_from_firestoreDb db collection docId (encodeFields data) Nothing Nothing Nothing
        )
        |> Result.map (\_ -> ())

deleteDoc : String -> String -> Result Error ()
deleteDoc collection docId =
    withDb (\db -> Fs.delete_by_id_from_firestoreDb db collection docId Nothing)

queryDocs : String -> Result Error (List (Dict String String))
queryDocs collection =
    withDb
        (\db ->
            Task.fromResult
                (Fs.new_from_firestoreQueryParams
                    (Fs.single_new_variant_from_firestoreQueryCollection collection)
                )
                |> Task.andThen (\params -> Fs.query_obj_from_firestoreDb db params)
        )
        |> Result.map (List.map rowFromJson)

-- Fetch-and-filter: the row model stores every value as a string, so every
-- comparison the app issues ("==", "!=", "<", "<=", ">", ">=") is decided on
-- the string (numeric fields compare via toInt when both sides parse).
matchesOp : String -> String -> String -> Bool
matchesOp op actual expected =
    let
        numeric =
            case ( String.toInt actual, String.toInt expected ) of

                ( Just a, Just b ) ->
                    Just ( a, b )

                _ ->
                    Nothing
    in
        if op == "==" then
            actual == expected

        else if op == "!=" then
            actual /= expected

        else
            case numeric of

                Just ( a, b ) ->
                    if op == "<" then
                        a < b

                    else if op == "<=" then
                        a <= b

                    else if op == ">" then
                        a > b

                    else
                        a >= b

                Nothing ->
                    False

queryWhere : String -> String -> String -> String -> Result Error (List (Dict String String))
queryWhere collection field op value =
    queryDocs collection
        |> Result.map (List.filter (\row -> matchesOp op (getField field row) value))

queryWhereOrder : String -> String -> String -> String -> String -> String -> Result Error (List (Dict String String))
queryWhereOrder collection field op value orderField dir =
    queryWhere collection field op value
        |> Result.map
            (\rows ->
                let
                    sorted = List.sortBy (\row -> getField orderField row) rows
                in
                    if dir == "desc" then
                        List.reverse sorted

                    else
                        sorted
            )

-- ══════════════════════════════════════════════════════
-- LOGGING HELPERS (Result → list, logging Err instead of swallowing)
-- ══════════════════════════════════════════════════════
queryWhereOrLog label collection field op value =
    case queryWhere collection field op value of

        Ok rows ->
            rows

        Err e ->
            let
                _ = println ("[DB ERROR] " ++ label ++ ": " ++ Error.toString e)
            in
                []

queryWhereOrderOrLog label collection field op value orderField dir =
    case queryWhereOrder collection field op value orderField dir of

        Ok rows ->
            rows

        Err e ->
            let
                _ = println ("[DB ERROR] " ++ label ++ ": " ++ Error.toString e)
            in
                []

queryDocsOrLog label collection =
    case queryDocs collection of

        Ok rows ->
            rows

        Err e ->
            let
                _ = println ("[DB ERROR] " ++ label ++ ": " ++ Error.toString e)
            in
                []
