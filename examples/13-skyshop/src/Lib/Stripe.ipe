module Lib.Stripe exposing (createCheckoutSession, verifyPayment, deductStock, CheckoutInfo, PaymentStatus)

import Ipe.Prelude exposing (..)
import Ipe.Maybe exposing (..)
import Ipe.Result as Result
import Ipe.Task as Task
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Json.Encode as JsonEnc
import Ipe.Log exposing (println)
import Ipe.System as System
import Lib.Db as Db
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
-- DE-SHIM PENDING (stripe-builder-surface wall — see README.md): this module
-- still names the reference shim; the real `Rust.Async_stripe*` surfaces bind
-- the create-customer + send flows, but the checkout-session builder members
-- this module needs are not admitted yet.
import Rust.Sky_stripe_shim as Stripe


type alias PaymentStatus =
    { status : String
    , paymentStatus : String
    , customerName : String
    , customerEmail : String
    , customerPhone : String
    , shippingLine1 : String
    , shippingLine2 : String
    , shippingCity : String
    , shippingCountry : String
    , shippingPostalCode : String
    }


type alias CheckoutInfo =
    { id : String
    , url : String
    }


domainUrl _ =
    let
        domain = Result.withDefault "" (Task.run (System.getenv "DOMAIN"))
        port_ =
            Result.withDefault "" (Task.run (System.getenv "SKY_LIVE_PORT"))
    in
        if domain != "" then
            domain

        else
            let
                effectivePort =
                    if port_ == "" then
                        "8000"

                    else
                        port_
            in
                "http://localhost:" ++ effectivePort


-- Encode the cart items as a flat JSON array of line-item objects for the shim.
lineItemValue : Dict String String -> Value
lineItemValue item =
    let
        price = Db.getInt "price_amount" item
        discount = Db.getInt "price_discount" item
        effectivePrice =
            if price - discount > 0 then
                price - discount

            else
                price
    in
        JsonEnc.object
            [ ( "title", JsonEnc.string (Db.getField "title" item) )
            , ( "amount", JsonEnc.int effectivePrice )
            , ( "quantity", JsonEnc.int (Db.getInt "quantity" item) )
            , ( "currency"
              , JsonEnc.string
                    (String.toLower (Db.getField "price_currency" item))
              )
            ]


encodeLineItems : List (Dict String String) -> String
encodeLineItems items =
    JsonEnc.encode 0 (JsonEnc.list lineItemValue items)


createCheckoutSession : String -> List (Dict String String) -> String -> String -> String -> String -> Result Error CheckoutInfo
createCheckoutSession cartId items userId userName userEmail remarks =
    let
        _ = userId
        _ = userName
        _ = remarks
        successUrl = domainUrl () ++ "/order/" ++ cartId ++ "/success"
        cancelUrl = domainUrl () ++ "/cart"
        lineItemsJson = encodeLineItems items
        _ =
            println
                ("[STRIPE] Creating checkout session for cart: " ++ cartId)
    in
        case Stripe.stripe_create_checkout_session cartId userEmail lineItemsJson successUrl cancelUrl of

            Ok session ->
                Ok
                    { id = Db.getField "id" session
                    , url = Db.getField "url" session
                    }

            Err _ ->
                Err (Error.network "Stripe shim: failed to create checkout session.")


verifyPayment orderId =
    let
        doc =
            case Db.getDoc "orders" orderId of

                Ok (Just order) ->
                    Just order

                _ ->
                    case Db.getDoc "carts" orderId of

                        Ok (Just cart) ->
                            Just cart

                        _ ->
                            Nothing
    in
        case doc of

            Just order ->
                let
                    reference = Db.getField "checkout_reference" order
                in
                    if reference == "" then
                        Err (Error.invalidInput "No checkout reference found.")

                    else
                        verifyStripeSession orderId reference

            Nothing ->
                Err (Error.notFound |> Error.withMessage "Order not found.")


verifyStripeSession cartId sessionId =
    case Stripe.stripe_retrieve_session sessionId of

        Ok sess ->
            let
                status = Db.getField "status" sess
                paymentStatus = Db.getField "payment_status" sess
            in
                if status == "complete" && paymentStatus == "paid" then
                    let
                        _ =
                            println
                                ("[STRIPE] Payment verified for cart: " ++ cartId)
                    in
                        Ok
                            { status = status
                            , paymentStatus = paymentStatus
                            , customerName = Db.getField "customer_name" sess
                            , customerEmail = Db.getField "customer_email" sess
                            , customerPhone = Db.getField "customer_phone" sess
                            , shippingLine1 = Db.getField "shipping_line1" sess
                            , shippingLine2 = Db.getField "shipping_line2" sess
                            , shippingCity = Db.getField "shipping_city" sess
                            , shippingCountry = Db.getField "shipping_country" sess
                            , shippingPostalCode = Db.getField "shipping_postal_code" sess
                            }

                else
                    Err (Error.invalidInput "Payment not complete.")

        Err _ ->
            Err (Error.network "Failed to retrieve checkout session.")


deductStock orderId =
    let
        orderItems =
            Db.queryWhereOrLog
                "Stripe.deductStock.orderItems"
                "order_items"
                "order_id"
                "=="
                orderId
        items =
            if List.isEmpty orderItems then
                Db.queryWhereOrLog
                    "Stripe.deductStock.cartItems"
                    "cart_items"
                    "cart_id"
                    "=="
                    orderId

            else
                orderItems
        _ = List.map deductItemStock items
        _ = println ("[STOCK] Deducted for order: " ++ orderId)
    in
        ()


deductItemStock item =
    let
        productId = Db.getField "product_id" item
        qty = Db.getInt "quantity" item
    in
        case Db.getDoc "products" productId of

            Ok (Just product) ->
                let
                    currentStock = Db.getInt "stock" product
                in
                    if currentStock >= 0 then
                        let
                            newStock =
                                if currentStock - qty >= 0 then
                                    currentStock - qty

                                else
                                    0
                            updatedProduct =
                                Dict.insert "stock" (Db.intVal newStock) product
                            _ =
                                Db.setDoc "products" productId updatedProduct
                        in
                            ()

                    else
                        ()

            _ ->
                ()
