module Lib.OAuth exposing (firebaseAuthScript, handleAuthCallback)

import Ipe.Prelude exposing (..)
import Lib.Auth as Auth


-- D5 (Std.Ui, no raw HTML/JS): the Std.Ui view layer has no `raw`/script
-- injection primitive, so the client-side Firebase SDK <script> is NOT
-- injected here. Sign-in is wired server-side via the FirebaseAuth Msg path
-- (the firebase ID-token binding verifies the id token). Kept as a no-op so the
-- call sites that referenced it in the original still type-check; a future
-- executor can wire a Std.Ui-compatible client bridge.
firebaseAuthScript : a -> String
firebaseAuthScript _ =
    ""


handleAuthCallback token =
    Auth.verifyToken token
