module Main exposing (main)

import Gate exposing (BindRefusal(..), Refusal(..), Token)
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Test as Test exposing (Test, TestResult)
import Runner exposing (DeadlineRefusal(..))
import Staging exposing (StagingError(..))


-- The staging allowlist: the page's own emit is accepted, every path that
-- could land outside the token-scoped run directory is refused.
banner : String -> String -> String
banner path body =
    "// ==== " ++ path ++ " ====\n" ++ body ++ "\n"


crate : List String -> String
crate extra =
    String.concat (List.map (\name -> banner name "fn f() {}") extra)
        ++ banner "src/main.rs" "fn main() {}"
        ++ banner "Cargo.toml" "[package]"


stagedPaths : String -> Result StagingError (List String)
stagedPaths emitted =
    Result.map (\p -> List.map (\ipe_accessor_arg -> ipe_accessor_arg.path) (Staging.files p)) (Staging.plan emitted)


refuses : String -> StagingError -> String -> Test
refuses name expected emitted =
    Test.test name (\_ -> Test.equal (Err expected) (Result.map (\_ -> ()) (Staging.plan emitted)))


accepted : Test
accepted =
    Test.suite "accepted"
        [ Test.test
            "the emitted crate stages as written"
            (\_ -> Test.equal (Ok [ "src/main.rs", "Cargo.toml" ]) (stagedPaths (crate [])))
        , Test.test
            "a nested module file is allowed"
            (\_ -> Test.ok (Staging.plan (crate [ "src/ipe_mods/app_2.rs" ])))
        , Test.test
            "file bodies survive the split"
            (\_ -> Test.equal (Ok [ "fn main() {}\n", "[package]\n" ]) (Result.map (\p -> List.map (\ipe_accessor_arg -> ipe_accessor_arg.content) (Staging.files p)) (Staging.plan (crate []))))
        ]


refused : Test
refused =
    Test.suite "refused"
        [ refuses "a parent traversal" (BadPath "src/../../../../etc/cron.d/x.rs") (crate [ "src/../../../../etc/cron.d/x.rs" ])
        , refuses "a traversal that cleans back inside" (BadPath "src/a/../main2.rs") (crate [ "src/a/../main2.rs" ])
        , refuses "an absolute path" (BadPath "/tmp/x.rs") (crate [ "/tmp/x.rs" ])
        , refuses "a path outside src" (BadPath "build.rs") (crate [ "build.rs" ])
        , refuses "a harness entry" (BadPath "Cargo.lock") (crate [ "Cargo.lock" ])
        , refuses "a non-Rust source" (BadPath "src/data.json") (crate [ "src/data.json" ])
        , refuses "an empty segment" (BadPath "src//x.rs") (crate [ "src//x.rs" ])
        , refuses "a hidden file" (BadPath "src/.x.rs") (crate [ "src/.x.rs" ])
        , refuses "a bare extension" (BadPath "src/.rs") (crate [ "src/.rs" ])
        , refuses "a non-ASCII segment" (BadPath "src/é.rs") (crate [ "src/é.rs" ])
        , refuses "a backslash segment" (BadPath "src/a\\b.rs") (crate [ "src/a\\b.rs" ])
        , refuses "a duplicate path" DuplicatePath (crate [ "src/main.rs" ])
        , refuses "nesting past the ceiling" (BadPath "src/a/b/c/d/e/f/g/h/i.rs") (crate [ "src/a/b/c/d/e/f/g/h/i.rs" ])
        , refuses "text before the first banner" Preamble ("fn evil() {}\n" ++ crate [])
        , refuses "a missing manifest" MissingManifest (banner "src/main.rs" "fn main() {}")
        , refuses "a missing entry point" MissingEntryPoint (banner "Cargo.toml" "[package]")
        , refuses "no files at all" MissingManifest ""
        , refuses
            "too many files"
            TooManyFiles
            (crate (List.map (\n -> "src/m" ++ String.fromInt n ++ ".rs") (List.range 1 Staging.maxFiles)))
        ]


-- The jail runner is executed only by an absolute path, never looked up on PATH.
runnerPath : Test
runnerPath =
    Test.suite "runner path"
        [ Test.test "an absolute runner is used as given" (\_ -> Test.ok (Runner.absoluteRunner "/opt/pg/bin/jail-runner"))
        , Test.test "a bare name is refused" (\_ -> Test.err (Runner.absoluteRunner "jail-runner"))
        , Test.test "a relative path is refused" (\_ -> Test.err (Runner.absoluteRunner "bin/jail-runner"))
        , Test.test "an empty name is refused" (\_ -> Test.err (Runner.absoluteRunner ""))
        ]


-- Runs stage under an absolute HOME only, never the server's working directory.
home : Test
home =
    Test.suite "home"
        [ Test.test "an absolute home is used as given" (\_ -> Test.equal (Ok "/home/pg") (Runner.absoluteHome "/home/pg"))
        , Test.test "an unset home is refused" (\_ -> Test.err (Runner.absoluteHome ""))
        , Test.test "the working directory is refused" (\_ -> Test.err (Runner.absoluteHome "."))
        , Test.test "a relative home is refused" (\_ -> Test.err (Runner.absoluteHome "home/pg"))
        ]


-- The jail wall sits five seconds under the request deadline, so a jail always
-- ends before its request; a deadline too short for that, or one the runtime
-- would read differently, keeps the server from starting.
wallOf : String -> Result DeadlineRefusal Int
wallOf raw =
    Result.map Runner.wallSecs (Runner.jailWallFor raw)


{-| The wall for `deadline` is accepted, inside the jail runner's range, and
at least five seconds short of the deadline.
-}
wallEndsInTime : Int -> Bool
wallEndsInTime deadline =
    case wallOf (String.fromInt deadline) of
        Ok secs ->
            secs <= deadline - 5 && secs >= Runner.minJailWallSecs && secs <= Runner.maxJailWallSecs

        Err _ ->
            False


deadlineRefused : String -> DeadlineRefusal -> String -> Test
deadlineRefused name expected raw =
    Test.test name (\_ -> Test.equal (Err expected) (wallOf raw))


wall : Test
wall =
    Test.suite "jail wall"
        [ Test.test "an unset deadline is the runtime default" (\_ -> Test.equal (Ok (Runner.defaultDeadlineSecs - 5)) (wallOf ""))
        , Test.test "a blank deadline is the runtime default" (\_ -> Test.equal (Ok 25) (wallOf "  "))
        , Test.test "the default deadline" (\_ -> Test.equal (Ok 25) (wallOf "30"))
        , Test.test "a padded deadline" (\_ -> Test.equal (Ok 55) (wallOf " 60 "))
        , Test.test "the floor deadline yields the jail runner's floor" (\_ -> Test.equal (Ok Runner.minJailWallSecs) (wallOf "15"))
        , Test.test "the highest deadline under the ceiling" (\_ -> Test.equal (Ok Runner.maxJailWallSecs) (wallOf "605"))
        , Test.test "a long deadline is capped at the ceiling" (\_ -> Test.equal (Ok Runner.maxJailWallSecs) (wallOf "9223372036854775807"))
        , Test.test "every accepted wall ends five seconds before its deadline" (\_ -> Test.equal [] (List.filter (\d -> not (wallEndsInTime d)) (List.range 15 700)))
        , deadlineRefused "one second below the floor" (DeadlineBelowFloor 14) "14"
        , deadlineRefused "a one-second deadline" (DeadlineBelowFloor 1) "1"
        , deadlineRefused "a zero deadline" (MalformedDeadline "0") "0"
        , deadlineRefused "a zero-padded zero" (MalformedDeadline "000") "000"
        , deadlineRefused "a non-numeric deadline" (MalformedDeadline "soon") "soon"
        , deadlineRefused "a unit suffix" (MalformedDeadline "30s") "30s"
        , deadlineRefused "a signed deadline" (MalformedDeadline "+30") "+30"
        , deadlineRefused "a negative deadline" (MalformedDeadline "-9223372036854775808") "-9223372036854775808"
        , deadlineRefused "a fractional deadline" (MalformedDeadline "30.5") "30.5"
        , deadlineRefused "a deadline past the integer range" (MalformedDeadline "9223372036854775808") "9223372036854775808"
        , Test.test "every deadline below the floor is refused" (\_ -> Test.equal [] (List.filter (\d -> wallOf (String.fromInt d) /= Err (DeadlineBelowFloor d)) (List.range 1 14)))
        ]


-- A request's headers, looked up the way `Server.header` does for the gate.
headers : List ( String, String ) -> String -> Maybe String
headers pairs name =
    pairs
        |> List.filter (\( key, _ ) -> key == name)
        |> List.map (\( _, value ) -> value)
        |> List.head


validToken : String
validToken =
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJK0123-_"


otherToken : String
otherToken =
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJK0123-A"


{-| The headers the playground page sends with a run, minus the named ones. -}
pageRun : List String -> List ( String, String ) -> List ( String, String )
pageRun without extra =
    [ ( "host", "127.0.0.1:8000" )
    , ( "origin", "http://127.0.0.1:8000" )
    , ( "sec-fetch-site", "same-origin" )
    , ( "content-type", "application/json" )
    , ( "x-ipe-playground-token", validToken )
    ]
        |> List.filter (\( key, _ ) -> not (List.member key without) && not (List.any (\( replaced, _ ) -> replaced == key) extra))
        |> List.append extra


runVerdict : List ( String, String ) -> Result Refusal String
runVerdict pairs =
    case Gate.parseToken validToken of
        Just token ->
            Result.map Gate.trustedBody (Gate.trustRun token (headers pairs) "{}")

        Nothing ->
            Ok "the fixture token does not parse"


runRefused : String -> Refusal -> List ( String, String ) -> Test
runRefused name expected pairs =
    Test.test name (\_ -> Test.equal (Err expected) (runVerdict pairs))


gateRun : Test
gateRun =
    Test.suite "run gate"
        [ Test.test "the page's own run is admitted" (\_ -> Test.equal (Ok "{}") (runVerdict (pageRun [] [])))
        , Test.test
            "the page served as localhost is admitted"
            (\_ -> Test.equal (Ok "{}") (runVerdict (pageRun [] [ ( "host", "localhost:8000" ), ( "origin", "http://localhost:8000" ) ])))
        , Test.test "a browser without Sec-Fetch-Site is admitted" (\_ -> Test.equal (Ok "{}") (runVerdict (pageRun [ "sec-fetch-site" ] [])))
        , runRefused "a missing Host" BadHost (pageRun [ "host" ] [])
        , runRefused "a DNS-rebound Host" BadHost (pageRun [] [ ( "host", "attacker.example:8000" ) ])
        , runRefused "a Host on another port" BadHost (pageRun [] [ ( "host", "127.0.0.1:8001" ) ])
        , runRefused "a Host without a port" BadHost (pageRun [] [ ( "host", "127.0.0.1" ) ])
        , runRefused "a Host of another loopback address" BadHost (pageRun [] [ ( "host", "127.0.0.2:8000" ) ])
        , runRefused "a missing Origin" BadOrigin (pageRun [ "origin" ] [])
        , runRefused "a foreign Origin" BadOrigin (pageRun [] [ ( "origin", "http://attacker.example" ) ])
        , runRefused "an opaque Origin" BadOrigin (pageRun [] [ ( "origin", "null" ) ])
        , runRefused "an Origin on another scheme" BadOrigin (pageRun [] [ ( "origin", "https://127.0.0.1:8000" ) ])
        , runRefused "an Origin naming the other loopback name" BadOrigin (pageRun [] [ ( "origin", "http://localhost:8000" ) ])
        , runRefused "a cross-site fetch" CrossSite (pageRun [] [ ( "sec-fetch-site", "cross-site" ) ])
        , runRefused "a same-site fetch" CrossSite (pageRun [] [ ( "sec-fetch-site", "same-site" ) ])
        , runRefused "a user-initiated navigation" CrossSite (pageRun [] [ ( "sec-fetch-site", "none" ) ])
        , runRefused "a missing Content-Type" BadContentType (pageRun [ "content-type" ] [])
        , runRefused "a form post" BadContentType (pageRun [] [ ( "content-type", "application/x-www-form-urlencoded" ) ])
        , runRefused "a text/plain post" BadContentType (pageRun [] [ ( "content-type", "text/plain" ) ])
        , runRefused "a multipart post" BadContentType (pageRun [] [ ( "content-type", "multipart/form-data" ) ])
        , runRefused "a missing token" BadToken (pageRun [ "x-ipe-playground-token" ] [])
        , runRefused "an empty token" BadToken (pageRun [] [ ( "x-ipe-playground-token", "" ) ])
        , runRefused "a wrong token" BadToken (pageRun [] [ ( "x-ipe-playground-token", otherToken ) ])
        , runRefused "a token prefix" BadToken (pageRun [] [ ( "x-ipe-playground-token", String.left 42 validToken ) ])
        , runRefused "a token with a suffix" BadToken (pageRun [] [ ( "x-ipe-playground-token", validToken ++ "x" ) ])
        ]


healthRefused : String -> Refusal -> List ( String, String ) -> Test
healthRefused name expected pairs =
    Test.test name (\_ -> Test.equal (Err expected) (Gate.trustHealth (headers pairs)))


gateHealth : Test
gateHealth =
    Test.suite "health gate"
        [ Test.test "a same-origin GET without Origin is admitted" (\_ -> Test.ok (Gate.trustHealth (headers [ ( "host", "127.0.0.1:8000" ), ( "sec-fetch-site", "same-origin" ) ])))
        , Test.test "a same-origin GET with Origin is admitted" (\_ -> Test.ok (Gate.trustHealth (headers [ ( "host", "localhost:8000" ), ( "origin", "http://localhost:8000" ) ])))
        , Test.test "a typed-in URL is admitted" (\_ -> Test.ok (Gate.trustHealth (headers [ ( "host", "127.0.0.1:8000" ), ( "sec-fetch-site", "none" ) ])))
        , healthRefused "a missing Host" BadHost []
        , healthRefused "a DNS-rebound Host" BadHost [ ( "host", "attacker.example:8000" ) ]
        , healthRefused "a foreign Origin" BadOrigin [ ( "host", "127.0.0.1:8000" ), ( "origin", "http://attacker.example" ) ]
        , healthRefused "an opaque Origin" BadOrigin [ ( "host", "127.0.0.1:8000" ), ( "origin", "null" ) ]
        , healthRefused "a cross-site fetch" CrossSite [ ( "host", "127.0.0.1:8000" ), ( "sec-fetch-site", "cross-site" ) ]
        , healthRefused "a same-site fetch" CrossSite [ ( "host", "127.0.0.1:8000" ), ( "sec-fetch-site", "same-site" ) ]
        ]


-- /health tells the page a server is present and nothing more: the token is
-- never served, so another local user who can reach the port cannot learn it.
healthBody : Test
healthBody =
    Test.suite "health answer"
        [ Test.test
            "a browser's same-origin probe gets no token"
            (\_ -> Test.equal (Ok "{\"ok\":true}") (Gate.healthAnswer (headers [ ( "host", "127.0.0.1:8000" ), ( "sec-fetch-site", "same-origin" ) ])))
        , Test.test
            "a non-browser client without Origin gets no token"
            (\_ -> Test.equal (Ok "{\"ok\":true}") (Gate.healthAnswer (headers [ ( "host", "127.0.0.1:8000" ) ])))
        , Test.test
            "a refused probe gets the refusal"
            (\_ -> Test.equal (Err BadHost) (Gate.healthAnswer (headers [ ( "host", "attacker.example:8000" ) ])))
        ]


-- The token reaches the page only in the launch URL's fragment, which the
-- browser never sends back to the server.
launch : Test
launch =
    Test.suite "launch url"
        [ Test.test
            "the launch URL carries the token in the fragment"
            (\_ -> Test.equal (Just ("http://127.0.0.1:8000/#t=" ++ validToken)) (Maybe.map Gate.launchUrl (Gate.parseToken validToken)))
        ]


tokenShape : Test
tokenShape =
    Test.suite "token shape"
        [ Test.test "a minted-shape token parses" (\_ -> Test.equal (Just validToken) (Maybe.map Gate.tokenText (Gate.parseToken validToken)))
        , Test.test "an empty token is refused" (\_ -> Test.equal Nothing (Maybe.map Gate.tokenText (Gate.parseToken "")))
        , Test.test "a short token is refused" (\_ -> Test.equal Nothing (Maybe.map Gate.tokenText (Gate.parseToken (String.left 42 validToken))))
        , Test.test "a long token is refused" (\_ -> Test.equal Nothing (Maybe.map Gate.tokenText (Gate.parseToken (validToken ++ "a"))))
        , Test.test "a padded token is refused" (\_ -> Test.equal Nothing (Maybe.map Gate.tokenText (Gate.parseToken (String.left 42 validToken ++ "="))))
        , Test.test "a standard-base64 token is refused" (\_ -> Test.equal Nothing (Maybe.map Gate.tokenText (Gate.parseToken (String.left 42 validToken ++ "+"))))
        ]


bindRefused : String -> BindRefusal -> { bind : String, serverPort : String } -> Test
bindRefused name expected env =
    Test.test name (\_ -> Test.equal (Err expected) (Gate.requireLoopback env))


loopback : Test
loopback =
    Test.suite "loopback bind"
        [ Test.test "loopback on the default port starts" (\_ -> Test.equal (Ok ()) (Gate.requireLoopback { bind = "127.0.0.1", serverPort = "" }))
        , Test.test "a padded loopback bind starts" (\_ -> Test.equal (Ok ()) (Gate.requireLoopback { bind = " 127.0.0.1 ", serverPort = "8000" }))
        , bindRefused "an unset bind" (NotLoopback "") { bind = "", serverPort = "" }
        , bindRefused "every interface" (NotLoopback "0.0.0.0") { bind = "0.0.0.0", serverPort = "" }
        , bindRefused "every IPv6 interface" (NotLoopback "::") { bind = "::", serverPort = "" }
        , bindRefused "another address" (NotLoopback "192.168.1.5") { bind = "192.168.1.5", serverPort = "" }
        , bindRefused "a name the resolver maps" (NotLoopback "localhost") { bind = "localhost", serverPort = "" }
        , bindRefused "a relocated port" (PortRelocated "8123") { bind = "127.0.0.1", serverPort = "8123" }
        , bindRefused "a malformed port" (PortRelocated "abc") { bind = "127.0.0.1", serverPort = "abc" }
        ]


main =
    Test.runMain [ accepted, refused, runnerPath, home, wall, gateRun, gateHealth, healthBody, launch, tokenShape, loopback ]
