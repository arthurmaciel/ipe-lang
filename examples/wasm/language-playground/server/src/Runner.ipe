module Runner exposing (DeadlineRefusal(..), JailWall, RunResult, absoluteHome, absoluteRunner, deadlineMessage, defaultDeadlineSecs, jailWallFor, maxJailWallSecs, minJailWallSecs, runPlan, wallSecs)

import Ipe.Crypto as Crypto
import Ipe.Error as Error exposing (Error)
import Ipe.File as File
import Ipe.Json.Decode as Json
import Ipe.Maybe as Maybe
import Ipe.Path as Path exposing (Path)
import Ipe.Process as Process
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Staging exposing (StagedFile)


-- Run one staging plan (a crate the allowlist accepted): write its files under a fresh
-- `~/.cache/ipe/playground-runs/<token>` directory, and hand that directory to
-- the jail runner by direct argv. The runner re-checks the layout, builds and
-- runs inside the jail, and removes the directory.
type alias RunResult =
    { ok : Bool
    , unsandboxed : Bool
    , output : String
    }


type alias Phase =
    { status : Maybe Int
    , stdout : String
    , stderr : String
    , killed : Bool
    }


type alias RawOutcome =
    { ok : Bool
    , unsandboxed : Bool
    , build : Maybe Phase
    , run : Maybe Phase
    , exit : Maybe Int
    , error : Maybe String
    }


runPlan : JailWall -> Staging.Plan -> Task Error RunResult
runPlan wall plan =
    do
        home <- System.getenvOr "HOME" "" |> absoluteHome |> Task.fromResult
        token <- Crypto.randomToken 8
        runDir <- toPath (home ++ "/.cache/ipe/playground-runs/" ++ token)
        File.mkdirAll runDir
        writeAll (Path.toString runDir) (Staging.files plan)
        raw <- runJail wall home (Path.toString runDir)
        Task.succeed (formatOutcome raw)


runJail : JailWall -> String -> String -> Task Error RawOutcome
runJail wall home runDir =
    let
        warmDir =
            System.getenvOr "IPE_PLAYGROUND_WARM_DIR" (home ++ "/.cache/ipe/playground-warm")

        args =
            [ "run", runDir, "--wall", String.fromInt (wallSecs wall), "--warm", warmDir ]
    in
    do
        runner <- home |> runnerPath |> Task.fromResult
        done <- Process.runWith { command = runner, args = args, cwd = Nothing, env = [] }
        Task.fromResult (decodeOutcome done)


{-| The jail runner, executed only by an absolute path: the one setup installs
(`$HOME/.cache/ipe/playground/bin/jail-runner`) unless
`IPE_PLAYGROUND_JAIL_RUNNER` names another. A relative name is refused rather
than resolved through `PATH`.
-}
runnerPath : String -> Result Error String
runnerPath home =
    home ++ "/.cache/ipe/playground/bin/jail-runner" |> System.getenvOr "IPE_PLAYGROUND_JAIL_RUNNER" |> absoluteRunner


{-| The home directory runs are staged under: an absolute `HOME`, never a
relative fallback that would stage into the server's working directory.
-}
absoluteHome : String -> Result Error String
absoluteHome home =
    if String.startsWith "/" home then
        Ok home

    else
        "HOME must be an absolute path, got: " ++ String.left 200 home |> Error.unexpected |> Err


absoluteRunner : String -> Result Error String
absoluteRunner runner =
    if String.startsWith "/" runner then
        Ok runner

    else
        "IPE_PLAYGROUND_JAIL_RUNNER must be an absolute path, got: " ++ String.left 200 runner |> Error.unexpected |> Err


{-| The shortest wall the jail runner accepts, in seconds. -}
minJailWallSecs : Int
minJailWallSecs =
    10


{-| The longest wall the jail runner accepts, in seconds. -}
maxJailWallSecs : Int
maxJailWallSecs =
    600


{-| The jail's wall-clock budget, proven to sit five seconds under the request
deadline, measured from handler start (the deadline itself runs from the
request's arrival, body read included). The jail is not killed when its
request times out, so a wall at or past the deadline would let a jail outlive
its request and its concurrency permit.
-}
type JailWall
    = JailWall Int


{-| Why the server refuses to start on its `IPE_HTTP_REQUEST_TIMEOUT`. -}
type DeadlineRefusal
    = MalformedDeadline String
    | DeadlineBelowFloor Int


{-| The runtime's per-request deadline when `IPE_HTTP_REQUEST_TIMEOUT` is unset. -}
defaultDeadlineSecs : Int
defaultDeadlineSecs =
    30


{-| The wall, in seconds, for the jail runner's `--wall`. -}
wallSecs : JailWall -> Int
wallSecs wall =
    case wall of
        JailWall secs ->
            secs


{-| The jail wall for the server's per-request deadline, `IPE_HTTP_REQUEST_TIMEOUT`.

The deadline is read as the runtime reads it (trimmed; unset or blank is 30)
but only in the form both read alike: ASCII digits, above zero. Any other value,
which the runtime would silently replace, is refused. The wall is five seconds
under the deadline, capped at the jail runner's ceiling; a deadline too short
for the jail runner's floor is refused, never raised past the request.
-}
jailWallFor : String -> Result DeadlineRefusal JailWall
jailWallFor raw =
    let
        trimmed =
            String.trim raw
    in
    if trimmed == "" then
        Ok (JailWall (defaultDeadlineSecs - 5))

    else
        case digitsToInt trimmed of
            Nothing ->
                Err (MalformedDeadline trimmed)

            Just deadline ->
                if deadline < minJailWallSecs + 5 then
                    Err (DeadlineBelowFloor deadline)

                else
                    Ok (JailWall (min maxJailWallSecs (deadline - 5)))


{-| A positive decimal made of ASCII digits only. -}
digitsToInt : String -> Maybe Int
digitsToInt text =
    if String.all (\c -> String.contains (String.fromChar c) "0123456789") text then
        String.toInt text
            |> Maybe.andThen
                (\n ->
                    if n > 0 then
                        Just n

                    else
                        Nothing
                )

    else
        Nothing


{-| The startup refusal message. -}
deadlineMessage : DeadlineRefusal -> String
deadlineMessage refusal =
    case refusal of
        MalformedDeadline raw ->
            "IPE_HTTP_REQUEST_TIMEOUT must be a whole number of seconds above zero (got "
                ++ String.left 80 raw
                ++ ")"

        DeadlineBelowFloor deadline ->
            "IPE_HTTP_REQUEST_TIMEOUT must be at least "
                ++ String.fromInt (minJailWallSecs + 5)
                ++ " seconds, so the jail wall stays five seconds under the request deadline (got "
                ++ String.fromInt deadline
                ++ ")"


decodeOutcome : { exitCode : Int, stderr : String, stdout : String } -> Result Error RawOutcome
decodeOutcome done =
    case Json.decodeString outcomeDecoder done.stdout of
        Ok outcome ->
            Ok outcome

        Err _ ->
            ("jail runner exited " ++ String.fromInt done.exitCode ++ " without an outcome: " ++ String.right 2000 done.stderr)
                |> Error.unexpected
                |> Err


writeAll : String -> List StagedFile -> Task Error ()
writeAll baseDir files =
    case files of
        [] ->
            Task.succeed ()

        file :: rest ->
            do
                target <- toPath (baseDir ++ "/" ++ file.path)
                parent <- toPath (Path.dir target)
                File.mkdirAll parent
                File.writeFile target file.content
                writeAll baseDir rest


toPath : String -> Task Error Path
toPath raw =
    Task.fromResult (Path.fromString raw)


outcomeDecoder : Json.Decoder RawOutcome
outcomeDecoder =
    Json.map4 assembleOutcome flagsDecoder (optional "build" phaseDecoder) (optional "run" phaseDecoder) endingDecoder


flagsDecoder : Json.Decoder ( Bool, Bool )
flagsDecoder =
    Json.map2 (\ok unsandboxed -> ( ok, unsandboxed )) (Json.field "ok" Json.bool) (Json.field "unsandboxed" Json.bool)


endingDecoder : Json.Decoder ( Maybe Int, Maybe String )
endingDecoder =
    Json.map2 (\exit error -> ( exit, error )) (optional "exit" Json.int) (optional "error" Json.string)


assembleOutcome : ( Bool, Bool ) -> Maybe Phase -> Maybe Phase -> ( Maybe Int, Maybe String ) -> RawOutcome
assembleOutcome ( ok, unsandboxed ) build run ( exit, error ) =
    { ok = ok
    , unsandboxed = unsandboxed
    , build = build
    , run = run
    , exit = exit
    , error = error
    }


optional : String -> Json.Decoder a -> Json.Decoder (Maybe a)
optional name decoder =
    Json.oneOf [ Json.map Just (Json.field name decoder), Json.succeed Nothing ]


phaseDecoder : Json.Decoder Phase
phaseDecoder =
    Json.map4
        (\status stdout stderr killed -> { status = status, stdout = stdout, stderr = stderr, killed = killed })
        (optional "status" Json.int)
        (Json.field "stdout" Json.string)
        (Json.field "stderr" Json.string)
        (Json.field "killed" Json.bool)


formatOutcome : RawOutcome -> RunResult
formatOutcome raw =
    if raw.ok then
        case raw.run of
            Just run ->
                { ok = True
                , unsandboxed = raw.unsandboxed
                , output = ensureNewline (section "Run" run.stdout run.stderr)
                }

            Nothing ->
                { ok = True
                , unsandboxed = raw.unsandboxed
                , output = "── Run ──\n(no run output)\n"
                }

    else
        let
            buildPart =
                case raw.build of
                    Just b ->
                        section "Build" b.stdout b.stderr

                    Nothing ->
                        ""

            errorPart =
                case raw.error of
                    Just e ->
                        "── Error ──\n" ++ e ++ "\n"

                    Nothing ->
                        ""
        in
        { ok = False
        , unsandboxed = raw.unsandboxed
        , output = ensureNewline (buildPart ++ errorPart)
        }


section : String -> String -> String -> String
section name stdout stderr =
    "── " ++ name ++ " ──\n" ++ stdout ++ stderr


ensureNewline : String -> String
ensureNewline s =
    if String.endsWith "\n" s then
        s

    else
        s ++ "\n"
