module Runner exposing (RunResult, absoluteRunner, runPlan)

import Ipe.Crypto as Crypto
import Ipe.Error as Error exposing (Error)
import Ipe.File as File
import Ipe.Json.Decode as Json
import Ipe.Maybe as Maybe
import Ipe.Path as Path exposing (Path)
import Ipe.Process as Process
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Staging exposing (StagedFile)


-- Run one staging plan (a crate the allowlist accepted): write its files under a fresh
-- `~/.cache/ipe/playground-runs/<token>` directory, and hand that directory to
-- the jail runner by direct argv. The runner re-checks the layout, builds and
-- runs inside the jail, and removes the directory.
type alias RunResult =
    { ok : Bool
    , unsandboxed : Bool
    , output : String
    }


type alias Phase =
    { status : Maybe Int
    , stdout : String
    , stderr : String
    , killed : Bool
    }


type alias RawOutcome =
    { ok : Bool
    , unsandboxed : Bool
    , build : Maybe Phase
    , run : Maybe Phase
    , exit : Maybe Int
    , error : Maybe String
    }


runPlan : Staging.Plan -> Task Error RunResult
runPlan plan =
    let
        home =
            System.getenvOr "HOME" "."
    in
    do
        token <- Crypto.randomToken 8
        runDir <- toPath (home ++ "/.cache/ipe/playground-runs/" ++ token)
        File.mkdirAll runDir
        writeAll (Path.toString runDir) (Staging.files plan)
        raw <- runJail home (Path.toString runDir)
        Task.succeed (formatOutcome raw)


runJail : String -> String -> Task Error RawOutcome
runJail home runDir =
    let
        warmDir =
            System.getenvOr "IPE_PLAYGROUND_WARM_DIR" (home ++ "/.cache/ipe/playground-warm")

        args =
            [ "run", runDir, "--wall", String.fromInt jailWallSecs, "--warm", warmDir ]
    in
    do
        runner <- home |> runnerPath |> Task.fromResult
        done <- Process.runWith { command = runner, args = args, cwd = Nothing, env = [] }
        Task.fromResult (decodeOutcome done)


{-| The jail runner, executed only by an absolute path: the one setup installs
(`$HOME/.cache/ipe/playground/bin/jail-runner`) unless
`IPE_PLAYGROUND_JAIL_RUNNER` names another. A relative name is refused rather
than resolved through `PATH`.
-}
runnerPath : String -> Result Error String
runnerPath home =
    home ++ "/.cache/ipe/playground/bin/jail-runner" |> System.getenvOr "IPE_PLAYGROUND_JAIL_RUNNER" |> absoluteRunner


absoluteRunner : String -> Result Error String
absoluteRunner runner =
    if String.startsWith "/" runner then
        Ok runner

    else
        "IPE_PLAYGROUND_JAIL_RUNNER must be an absolute path, got: " ++ String.left 200 runner |> Error.unexpected |> Err


{-| The jail's wall-clock budget: inside the server's per-request deadline
(`IPE_HTTP_REQUEST_TIMEOUT`, 30 seconds unless set), so a jail never outlives
the request that started it.
-}
jailWallSecs : Int
jailWallSecs =
    let
        deadline =
            System.getenvOr "IPE_HTTP_REQUEST_TIMEOUT" "30"
                |> String.trim
                |> String.toInt
                |> Maybe.withDefault 30
    in
    if deadline > 10 then
        deadline - 5

    else
        5


decodeOutcome : { exitCode : Int, stderr : String, stdout : String } -> Result Error RawOutcome
decodeOutcome done =
    case Json.decodeString outcomeDecoder done.stdout of
        Ok outcome ->
            Ok outcome

        Err _ ->
            ("jail runner exited " ++ String.fromInt done.exitCode ++ " without an outcome: " ++ String.right 2000 done.stderr)
                |> Error.unexpected
                |> Err


writeAll : String -> List StagedFile -> Task Error ()
writeAll baseDir files =
    case files of
        [] ->
            Task.succeed ()

        file :: rest ->
            do
                target <- toPath (baseDir ++ "/" ++ file.path)
                parent <- toPath (Path.dir target)
                File.mkdirAll parent
                File.writeFile target file.content
                writeAll baseDir rest


toPath : String -> Task Error Path
toPath raw =
    Task.fromResult (Path.fromString raw)


outcomeDecoder : Json.Decoder RawOutcome
outcomeDecoder =
    Json.map4 assembleOutcome flagsDecoder (optional "build" phaseDecoder) (optional "run" phaseDecoder) endingDecoder


flagsDecoder : Json.Decoder ( Bool, Bool )
flagsDecoder =
    Json.map2 (\ok unsandboxed -> ( ok, unsandboxed )) (Json.field "ok" Json.bool) (Json.field "unsandboxed" Json.bool)


endingDecoder : Json.Decoder ( Maybe Int, Maybe String )
endingDecoder =
    Json.map2 (\exit error -> ( exit, error )) (optional "exit" Json.int) (optional "error" Json.string)


assembleOutcome : ( Bool, Bool ) -> Maybe Phase -> Maybe Phase -> ( Maybe Int, Maybe String ) -> RawOutcome
assembleOutcome ( ok, unsandboxed ) build run ( exit, error ) =
    { ok = ok
    , unsandboxed = unsandboxed
    , build = build
    , run = run
    , exit = exit
    , error = error
    }


optional : String -> Json.Decoder a -> Json.Decoder (Maybe a)
optional name decoder =
    Json.oneOf [ Json.map Just (Json.field name decoder), Json.succeed Nothing ]


phaseDecoder : Json.Decoder Phase
phaseDecoder =
    Json.map4
        (\status stdout stderr killed -> { status = status, stdout = stdout, stderr = stderr, killed = killed })
        (optional "status" Json.int)
        (Json.field "stdout" Json.string)
        (Json.field "stderr" Json.string)
        (Json.field "killed" Json.bool)


formatOutcome : RawOutcome -> RunResult
formatOutcome raw =
    if raw.ok then
        case raw.run of
            Just run ->
                { ok = True
                , unsandboxed = raw.unsandboxed
                , output = ensureNewline (section "Run" run.stdout run.stderr)
                }

            Nothing ->
                { ok = True
                , unsandboxed = raw.unsandboxed
                , output = "── Run ──\n(no run output)\n"
                }

    else
        let
            buildPart =
                case raw.build of
                    Just b ->
                        section "Build" b.stdout b.stderr

                    Nothing ->
                        ""

            errorPart =
                case raw.error of
                    Just e ->
                        "── Error ──\n" ++ e ++ "\n"

                    Nothing ->
                        ""
        in
        { ok = False
        , unsandboxed = raw.unsandboxed
        , output = ensureNewline (buildPart ++ errorPart)
        }


section : String -> String -> String -> String
section name stdout stderr =
    "── " ++ name ++ " ──\n" ++ stdout ++ stderr


ensureNewline : String -> String
ensureNewline s =
    if String.endsWith "\n" s then
        s

    else
        s ++ "\n"
