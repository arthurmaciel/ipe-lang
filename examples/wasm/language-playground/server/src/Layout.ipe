module Layout exposing (Layout, LayoutRefusal(..), indexPath, layoutMessage, locate, pkgDir, probe, requiredFiles, rootOf, staticDir)

import Ipe.Error as Error exposing (Error)
import Ipe.File as File
import Ipe.Path as Path exposing (Path)
import Ipe.Result as Result
import Ipe.String as String
import Ipe.Task as Task exposing (Task)
import Paths


-- Where the files the server serves live. The server starts from the
-- playground's `server/` directory, so its parent is the playground root; every
-- file the page needs is proven present there before the server listens, and
-- every served path is a `Path` joined beneath that absolute root with
-- `Paths.below`, never resolved against the working directory again.
{-| The page, the static directory and the wasm bundle directory, under a root
proven to hold every file in `requiredFiles`.
-}
type Layout
    = Layout Path Path Path


{-| Why the server refuses to start on the directory it was started from. -}
type LayoutRefusal
    = RelativeCwd String
    | Missing String String


{-| The files, relative to the playground root, the page cannot work without. -}
requiredFiles : List String
requiredFiles =
    [ "index.html", "static/app.js", "pkg/ipe_wasm.js", "pkg/ipe_wasm_bg.wasm" ]


{-| The playground root for the server's working directory: its parent. The
directory is parsed once; a path that is not absolute is refused.
-}
rootOf : String -> Result LayoutRefusal Path
rootOf cwd =
    case Path.fromString cwd of
        Ok path ->
            if Path.isAbsolute path then
                Result.mapError (\_ -> RelativeCwd cwd) (Path.fromString (Path.dir path))

            else
                Err (RelativeCwd cwd)

        Err _ ->
            Err (RelativeCwd cwd)


{-| The layout for the server's working directory, or the refusal naming the
first required file it lacks.
-}
probe : String -> Task Error (Result LayoutRefusal Layout)
probe cwd =
    case rootOf cwd of
        Err refusal ->
            Task.succeed (Err refusal)

        Ok root ->
            do
                missing <- firstMissing root requiredFiles
                case missing of
                    Just file ->
                        Task.succeed (Err (Missing (Path.toString root) file))

                    Nothing ->
                        Task.map Ok (Task.fromResult (Result.map3 Layout (Paths.below root "index.html") (Paths.below root "static") (Paths.below root "pkg")))


{-| Locate the playground from the server's working directory, or refuse. -}
locate : String -> Task Error Layout
locate cwd =
    do
        found <- probe cwd
        Task.fromResult (Result.mapError refusalError found)


firstMissing : Path -> List String -> Task Error (Maybe String)
firstMissing root files =
    case files of
        [] ->
            Task.succeed Nothing

        file :: rest ->
            do
                path <- Task.fromResult (Paths.below root file)
                present <- File.exists path
                if present then
                    firstMissing root rest

                else
                    Task.succeed (Just file)


refusalError : LayoutRefusal -> Error
refusalError refusal =
    Error.unexpected (layoutMessage refusal)


{-| The page, `index.html`. -}
indexPath : Layout -> Path
indexPath layout =
    case layout of
        Layout index _ _ ->
            index


{-| The page script and its vendored editor, `static/`. -}
staticDir : Layout -> String
staticDir layout =
    case layout of
        Layout _ static _ ->
            Path.toString static


{-| The wasm bundle, `pkg/`. -}
pkgDir : Layout -> String
pkgDir layout =
    case layout of
        Layout _ _ pkg ->
            Path.toString pkg


{-| The startup refusal message. -}
layoutMessage : LayoutRefusal -> String
layoutMessage refusal =
    case refusal of
        RelativeCwd cwd ->
            "the playground run server needs an absolute working directory (got "
                ++ String.left 200 cwd
                ++ ")"

        Missing root file ->
            "the playground run server starts from the playground's server/ directory, whose parent holds the page: "
                ++ String.left 200 root
                ++ "/"
                ++ file
                ++ " is missing"
                ++ (if String.startsWith "pkg/" file then
                    "; build the wasm bundle with `cd ../setup && ipe run -- bundle`"

                else
                    ""
                )
