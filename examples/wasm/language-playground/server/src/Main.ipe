module Main exposing (main)

import Gate exposing (Token)
import Ipe.ByteSize as ByteSize
import Ipe.Error as Error exposing (Error)
import Ipe.File as File
import Ipe.Io as Io
import Ipe.Json.Decode as Json
import Ipe.Json.Encode as Encode
import Ipe.Result as Result
import Ipe.Server.Http as Server
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task exposing (Task)
import Layout exposing (Layout)
import Runner exposing (JailWall)
import Staging


-- The playground's run server, started from this directory
-- (`IPE_HTTP_BIND=127.0.0.1 ipe run`); it refuses to start on any other bind,
-- or on a request deadline too short for the jail to end inside it. At startup
-- it prints the launch URL, which carries this launch's token in its fragment,
-- to the operator's terminal; no route serves the token. GET / serves the page
-- (never framed, same-origin scripts only), "/pkg" the wasm bundle and
-- "/static" the page script with its vendored editor, all from the playground
-- root (the parent of this directory), which must hold every file `Layout`
-- requires or the server refuses to start. GET /health answers `{"ok":true}`
-- so the page knows a run server is present. POST /run takes
-- `{"rust": <emitted crate>}` (the page's own ipe-wasm emit, never Ipê source)
-- and answers with the jailed transcript: 403 or 415 for a request `Gate`
-- refuses, 413 for a body over the bound, 400 for a malformed one, 422 for a
-- crate the staging allowlist refuses, 500 when the jail itself fails.
main : Task Error ()
main =
    do
        Gate.requireLoopback
            { bind = System.getenvOr "IPE_HTTP_BIND" ""
            , serverPort = System.getenvOr "IPE_SERVER_PORT" ""
            }
            |> Result.mapError (\refusal -> Error.unexpected (Gate.bindMessage refusal))
            |> Task.fromResult
        wall <- Task.fromResult (Result.mapError (\refusal -> Error.unexpected (Runner.deadlineMessage refusal)) (Runner.jailWallFor (System.getenvOr "IPE_HTTP_REQUEST_TIMEOUT" "")))
        cwd <- System.cwd ()
        layout <- Layout.locate cwd
        token <- Gate.mintToken
        Io.println ("Ipê playground: open " ++ Gate.launchUrl token)
        Server.listen Gate.port
            [ Server.get "/" (page layout)
            , Server.get "/health" health
            , Server.post "/run" (handleRun wall token)
            , Server.static "/pkg" (Layout.pkgDir layout)
            , Server.static "/static" (Layout.staticDir layout)
            ]


{-| The page, served so that no other site can frame it and it runs no other
origin's script.
-}
page : Layout -> Server.Request -> Task Error Server.Response
page layout _ =
    do
        html <- File.readFileLimit (Layout.indexPath layout) (ByteSize.kib 256)
        html
            |> Server.html
            |> Server.withHeader "X-Frame-Options" "DENY"
            |> Server.withHeader "Content-Security-Policy" Gate.pageContentSecurityPolicy
            |> Server.withHeader "Cache-Control" "no-store"
            |> Task.succeed


{-| The largest request body `/run` decodes, in code points: the emitted crate
of one playground program, without the runtime, is tens of KiB.
-}
maxRequestChars : Int
maxRequestChars =
    1048576


health : Server.Request -> Task Error Server.Response
health req =
    case Gate.healthAnswer (\name -> Server.header name req) of
        Err refusal ->
            refuse (Gate.refusalStatus refusal) (Gate.refusalMessage refusal)

        Ok body ->
            body
                |> Server.json
                |> Server.withHeader "Cache-Control" "no-store"
                |> Task.succeed


handleRun : JailWall -> Token -> Server.Request -> Task Error Server.Response
handleRun wall token req =
    case Gate.trustRun token (\name -> Server.header name req) (Server.body req) of
        Err refusal ->
            refuse (Gate.refusalStatus refusal) (Gate.refusalMessage refusal)

        Ok trusted ->
            runTrusted wall (Gate.trustedBody trusted)


runTrusted : JailWall -> String -> Task Error Server.Response
runTrusted wall raw =
    if String.length raw > maxRequestChars then
        refuse 413 "Program too large (over 1 MiB of emitted Rust)."

    else
        case Json.decodeString (Json.field "rust" Json.string) raw of
            Err _ ->
                refuse 400 "Malformed request: expected {\"rust\": String}."

            Ok rust ->
                case Staging.plan rust of
                    Err error ->
                        refuse 422 ("Program refused: " ++ Staging.errorMessage error)

                    Ok plan ->
                        Runner.runPlan wall plan
                            |> Task.map (\r -> Server.json (runResponse r.ok r.unsandboxed r.output))
                            |> Task.onError (\e -> refuse 500 ("Server error: " ++ Error.message e))


refuse : Int -> String -> Task Error Server.Response
refuse status message =
    runResponse False False message
        |> Server.json
        |> Server.withStatus status
        |> Task.succeed


runResponse : Bool -> Bool -> String -> String
runResponse ok unsandboxed output =
    Encode.encode 0
        (Encode.object
            [ ( "ok", Encode.bool ok )
            , ( "unsandboxed", Encode.bool unsandboxed )
            , ( "output", Encode.string output )
            ]
        )
