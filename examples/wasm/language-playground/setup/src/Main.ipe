module Main exposing (main)

import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Json.Decode as Json
import Ipe.List as List
import Ipe.Process as Process
import Ipe.Result as Result
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task exposing (Task)


-- Playground setup, run from examples/wasm/language-playground/setup:
--
--     ipe run              the full setup: wasm bundle, jail-runner, cache warm
--     ipe run -- bundle    only rebuild the wasm bundle (pkg/)
--
-- The full setup probes the prerequisites, builds `ipe-wasm` for
-- wasm32-unknown-unknown and runs wasm-bindgen into ../pkg/, installs
-- playground-jail-runner at the fixed path the server executes, and pre-warms
-- the offline dependency cache so the first Run builds offline. Every step is a
-- direct argv vector, never a shell string; any failure ends the program with
-- a non-zero exit and the reason.
main : Task Error ()
main =
    do
        args <- System.args ()
        mode <- args |> parseMode |> Task.fromResult
        root <- repoRoot
        case mode of
            BundleOnly ->
                do
                    buildBundle root
                    Io.println ("Done — pkg/ rebuilt under " ++ playgroundDir root)

            Full ->
                do
                    probe "bwrap" "Install bubblewrap (the Run jail), e.g. `apt install bubblewrap`."
                    buildBundle root
                    runner <- installJailRunner root
                    prewarm runner
                    done root


type Mode
    = Full
    | BundleOnly


parseMode : List String -> Result Error Mode
parseMode args =
    if List.isEmpty args then
        Ok Full

    else if args == [ "bundle" ] then
        Ok BundleOnly

    else
        "usage: ipe run [-- bundle] (got: " ++ String.join " " args ++ ")" |> Error.unexpected |> Err


{-| The jail-runner install root; the server's default runner is its
`bin/jail-runner`. -}
runnerRoot : String
runnerRoot =
    System.getenvOr "HOME" "." ++ "/.cache/ipe/playground"


repoRoot : Task Error String
repoRoot =
    do
        probe "git" "Install git: https://git-scm.com/downloads"
        out <- Process.run "git" [ "rev-parse", "--show-toplevel" ]
        Task.succeed (String.trim out)


playgroundDir : String -> String
playgroundDir root =
    root ++ "/examples/wasm/language-playground"


{-| Fail with `hint` unless `tool --version` runs. -}
probe : String -> String -> Task Error ()
probe tool hint =
    Process.run tool [ "--version" ]
        |> Task.map (\_ -> ())
        |> Task.onError (\_ -> tool ++ " was not found on your PATH. " ++ hint |> Error.unexpected |> Task.fail)


{-| Run one build step, announcing it first. -}
step : String -> String -> List String -> Task Error ()
step announce tool args =
    do
        Io.println announce
        Process.run tool args |> Task.map (\_ -> ())


buildBundle : String -> Task Error ()
buildBundle root =
    do
        probe "cargo" "cargo ships with the Rust toolchain; install it via rustup: https://rustup.rs"
        probe "rustup" "Install rustup: https://rustup.rs"
        probe "wasm-bindgen" "Install the wasm-bindgen CLI: cargo install wasm-bindgen-cli --version 0.2.126"
        step "Adding the wasm32-unknown-unknown target…" "rustup" [ "target", "add", "wasm32-unknown-unknown" ]
        step
            "Building ipe-wasm for wasm32-unknown-unknown (release)…"
            "cargo"
            [ "build", "-p", "ipe-wasm", "--target", "wasm32-unknown-unknown", "--release", "--manifest-path", root ++ "/Cargo.toml" ]
        target <- targetDir root
        step
            "Generating JS bindings with wasm-bindgen…"
            "wasm-bindgen"
            [ "--target", "web", "--no-typescript", "--out-dir", playgroundDir root ++ "/pkg", "--out-name", "ipe_wasm", target ++ "/wasm32-unknown-unknown/release/ipe_wasm.wasm" ]


-- Cargo's resolved target dir: `cargo metadata` applies CARGO_TARGET_DIR, a
-- [build] target-dir in any cargo config, and the workspace default in the
-- same precedence as cargo's own build.
targetDir : String -> Task Error String
targetDir root =
    do
        out <- Process.run "cargo" [ "metadata", "--format-version", "1", "--no-deps", "--manifest-path", root ++ "/Cargo.toml" ]
        out
            |> Json.decodeString (Json.field "target_directory" Json.string)
            |> Result.mapError (\err -> Error.unexpected ("could not read cargo metadata: " ++ Error.toString err))
            |> Task.fromResult


{-| Install playground-jail-runner under `runnerRoot`, reusing the workspace
target dir; its binary path. -}
installJailRunner : String -> Task Error String
installJailRunner root =
    do
        target <- targetDir root
        step
            "Installing playground-jail-runner…"
            "cargo"
            [ "install", "--path", playgroundDir root ++ "/jail-runner", "--root", runnerRoot, "--target-dir", target, "--debug", "--locked" ]
        Task.succeed (runnerRoot ++ "/bin/jail-runner")


prewarm : String -> Task Error ()
prewarm runner =
    step "Warming the offline dependency cache (jail-runner prewarm)…" runner [ "prewarm" ]


done : String -> Task Error ()
done root =
    do
        Io.println ""
        Io.println "Setup complete. Start the playground server:"
        Io.println ("  cd " ++ playgroundDir root ++ "/server && ipe run")
        Io.println "Then open http://localhost:8000"
