Fix two import gaps exposed by Ipê's stricter scope rules.

1. Ui/Charts.ipe: type annotation `sparkline : ... -> Html Msg` references Msg
   from State without importing it. Add the import.
2. Lib/Auth.ipe: upstream sky used `System.loadEnv "KEY"` as a single-key
   env-var lookup (Sky's old API). Ipê's System.loadEnv loads a .env FILE
   (takes ()); the correct function is System.getenv : String -> Task Error
   String. Add the import and rename all three call sites.

--- a/src/Ui/Charts.ipe
+++ b/src/Ui/Charts.ipe
@@ -5,6 +5,7 @@
 import Ipe.String as String
 import Ipe.Html exposing (..)
 import Ipe.Html.Attributes exposing (..)
+import State exposing (Msg)


 -- Render a sparkline SVG from a list of values (most recent last).
--- a/src/Lib/Auth.ipe
+++ b/src/Lib/Auth.ipe
@@ -10,23 +10,24 @@
 import Ipe.Process as Process
 import Ipe.Db as Db
 import Ipe.Log exposing (println)
+import Ipe.System as System
 import Lib.Database as Database
 import Ipe.Error as Error exposing (Error(..), ErrorKind(..))


 getGitHubClientId : String
 getGitHubClientId =
-    Result.withDefault "" (Task.run (System.loadEnv "GITHUB_CLIENT_ID"))
+    Result.withDefault "" (Task.run (System.getenv "GITHUB_CLIENT_ID"))


 getGitHubClientSecret : String
 getGitHubClientSecret =
-    Result.withDefault "" (Task.run (System.loadEnv "GITHUB_CLIENT_SECRET"))
+    Result.withDefault "" (Task.run (System.getenv "GITHUB_CLIENT_SECRET"))


 getAdmins : String
 getAdmins =
-    Result.withDefault "" (Task.run (System.loadEnv "SKYMON_ADMINS"))
+    Result.withDefault "" (Task.run (System.getenv "SKYMON_ADMINS"))


