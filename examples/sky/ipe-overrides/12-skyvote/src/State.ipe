module State exposing (..)

import Ipe.Maybe exposing (..)
import Ipe.Dict as Dict
import Ipe.Error as Error exposing (Error)


-- A Web-shape Model is persisted to the session store between requests, so
-- it holds plain data only — rows are `Dict String String`, never the
-- opaque `Db` handle (IPE-L0120). Every field here is settled data that a
-- database effect delivered through a response `Msg`.
type alias Model =
    { page : Page
    , currentUser : Maybe (Dict String String)
    , ideas : List (Dict String String)
    , sortBy : String
    , filterCategory : String
    , searchQuery : String
    , selectedIdeaId : String
    , selectedIdea : Maybe (Dict String String)
    , ideaComments : List (Dict String String)
    , newComment : String
    , submitTitle : String
    , submitDescription : String
    , submitCategory : String
    , authEmail : String
    , authUsername : String
    , authPassword : String
    , authError : String
    , notification : String
    , roadmapOpen : List (Dict String String)
    , roadmapPlanned : List (Dict String String)
    , roadmapInProgress : List (Dict String String)
    , roadmapDone : List (Dict String String)
    }


type Page
    = BoardPage
    | DetailPage
    | SubmitPage
    | SignInPage
    | SignUpPage
    | AboutPage
    | RoadmapPage
    | NotFoundPage


-- The single-idea detail load settles as its idea plus that idea's
-- comments, folded together so one response `Msg` populates both.
type alias DetailData =
    { idea : Maybe (Dict String String)
    , comments : List (Dict String String)
    }


-- The roadmap load settles as the four status buckets, folded together so
-- one response `Msg` populates the whole board.
type alias RoadmapData =
    { open : List (Dict String String)
    , planned : List (Dict String String)
    , inProgress : List (Dict String String)
    , done : List (Dict String String)
    }


type Msg
    = Navigate Page
    | SetSort String
    | SetFilter String
    | SetSearch String
    | ToggleVote String
    | ViewIdea String
    | UpdateComment String
    | SubmitComment
    | BackToBoard
    | UpdateTitle String
    | UpdateDescription String
    | UpdateCategory String
    | SubmitIdea
    | UpdateEmail String
    | UpdateUsername String
    | UpdatePassword String
    | DoSignIn
    | DoSignUp
    | DoSignOut
    | Tick
    | IdeasLoaded (Result Error (List (Dict String String)))
    | DetailLoaded (Result Error DetailData)
    | RoadmapLoaded (Result Error RoadmapData)
    | VoteToggled (Result Error ())
    | CommentPosted (Result Error ())
    | IdeaCreated (Result Error ())
    | SignedIn (Result Error (Dict String String))
    | SignedUp (Result Error (Dict String String))
