module Lib.Comments exposing (createComment, getComments)

import Ipe.Crypto as Crypto
import Ipe.String as String
import Ipe.Time as Time
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Error as Error exposing (Error)
import Lib.Db as LibDb


-- Persist one comment. The current time is read inside the Task chain
-- (`Time.now` yields a `Task Error Int`) and folded into the id material,
-- so identical content from the same user on the same idea never collides
-- on the PRIMARY KEY. The clock is never forced synchronously before the
-- effect runs.
createComment : String -> String -> String -> Task Error ()
createComment ideaId authorId content =
    Time.now ()
        |> Task.andThen
            (\nowMs ->
                let
                    id =
                        String.slice
                            0
                            12
                            (Crypto.sha256
                                (ideaId ++ ":" ++ authorId ++ ":" ++ content
                                    ++ ":"
                                    ++ String.fromInt nowMs))
                in
                    LibDb.withConn
                        (\conn ->
                            Db.exec
                                conn
                                "INSERT INTO comments (id, idea_id, author_id, content) VALUES (?, ?, ?, ?)"
                                [ id, ideaId, authorId, content ])
                        |> Task.map (\_ -> ())
            )


getComments : String -> Task Error (List (Dict String String))
getComments ideaId =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT c.id, c.content, c.created_at, u.username as author_name FROM comments c LEFT JOIN users u ON c.author_id = u.id WHERE c.idea_id = ? ORDER BY c.created_at ASC"
                [ ideaId ])
