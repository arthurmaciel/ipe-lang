module Lib.Ideas exposing
    ( createIdea
    , getIdeas
    , getIdea
    , getIdeasByStatus
    , toggleVote
    )

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Crypto as Crypto
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Db.Unsafe as DbUnsafe
import Ipe.Error as Error exposing (Error)
import Lib.Db as LibDb


-- The full idea row, including the correlated vote/comment counts and the
-- author's username. Shared by the board list and the single-idea read so
-- both render from the same column set.
selectColumns : String
selectColumns =
    "SELECT i.id, i.title, i.description, i.category, i.status, i.author_id, i.created_at, u.username as author_name, (SELECT COUNT(*) FROM votes v WHERE v.idea_id = i.id) as vote_count, (SELECT COUNT(*) FROM comments c WHERE c.idea_id = i.id) as comment_count FROM ideas i LEFT JOIN users u ON i.author_id = u.id"


createIdea : String -> String -> String -> String -> Task Error String
createIdea title description category authorId =
    let
        id = String.slice 0 12 (Crypto.sha256 (title ++ ":" ++ authorId))
    in
        LibDb.withConn
            (\conn ->
                Db.exec
                    conn
                    "INSERT INTO ideas (id, title, description, category, author_id) VALUES (?, ?, ?, ?, ?)"
                    [ id, title, description, category, authorId ]
            )
            |> Task.map (\_ -> id)


-- The WHERE clause is assembled from user-supplied filter and search, but
-- the VALUES are always bound parameters — never string-interpolated into
-- the SQL — so a search term or category can carry no injection. The
-- `LIKE` wildcards are wrapped around the bound value, not the query text.
getIdeas : String -> String -> String -> Task Error (List (Dict String String))
getIdeas sortBy filterCategory searchQuery =
    let
        orderClause = orderClauseFor sortBy
        like = "%" ++ searchQuery ++ "%"
    in
        if filterCategory == "all" then
            if searchQuery == "" then
                LibDb.withConn
                    (\conn ->
                        DbUnsafe.unsafeQuery conn (selectColumns ++ orderClause) [])

            else
                LibDb.withConn
                    (\conn ->
                        DbUnsafe.unsafeQuery
                            conn
                            (selectColumns
                                ++ " WHERE (i.title LIKE ? OR i.description LIKE ?)"
                                ++ orderClause)
                            [ like, like ])

        else if searchQuery == "" then
            LibDb.withConn
                (\conn ->
                    DbUnsafe.unsafeQuery
                        conn
                        (selectColumns ++ " WHERE i.category = ?" ++ orderClause)
                        [ filterCategory ])

        else
            LibDb.withConn
                (\conn ->
                    DbUnsafe.unsafeQuery
                        conn
                        (selectColumns
                            ++ " WHERE i.category = ? AND (i.title LIKE ? OR i.description LIKE ?)"
                            ++ orderClause)
                        [ filterCategory, like, like ])


orderClauseFor : String -> String
orderClauseFor sortBy =
    if sortBy == "votes" then
        " ORDER BY vote_count DESC, i.created_at DESC"

    else if sortBy == "comments" then
        " ORDER BY comment_count DESC, i.created_at DESC"

    else
        " ORDER BY i.created_at DESC"


-- The outer Task carries a DB failure; the inner Maybe is "found / not
-- found", which is normal and not an error.
getIdea : String -> Task Error (Maybe (Dict String String))
getIdea ideaId =
    LibDb.withConn
        (\conn ->
            DbUnsafe.unsafeQuery
                conn
                (selectColumns ++ " WHERE i.id = ? LIMIT 1")
                [ ideaId ])
        |> Task.map List.head


getIdeasByStatus : String -> Task Error (List (Dict String String))
getIdeasByStatus status =
    LibDb.withConn
        (\conn ->
            DbUnsafe.unsafeQuery
                conn
                "SELECT i.id, i.title, i.description, i.category, i.status, i.author_id, i.created_at, u.username as author_name, (SELECT COUNT(*) FROM votes v WHERE v.idea_id = i.id) as vote_count FROM ideas i LEFT JOIN users u ON i.author_id = u.id WHERE i.status = ? ORDER BY vote_count DESC"
                [ status ])


-- A vote toggle is two effects (look up the existing vote, then insert or
-- delete) chained in one Task so both run on the same acquired connection.
toggleVote : String -> String -> Task Error ()
toggleVote ideaId userId =
    LibDb.withConn
        (\conn ->
            DbUnsafe.unsafeQuery
                conn
                "SELECT id FROM votes WHERE idea_id = ? AND user_id = ?"
                [ ideaId, userId ]
                |> Task.andThen (\rows -> applyVoteToggle conn ideaId userId rows))


applyVoteToggle : Db -> String -> String -> List (Dict String String) -> Task Error ()
applyVoteToggle conn ideaId userId existingRows =
    case List.head existingRows of

        Just _ ->
            Db.exec
                conn
                "DELETE FROM votes WHERE idea_id = ? AND user_id = ?"
                [ ideaId, userId ]
                |> Task.map (\_ -> ())

        Nothing ->
            let
                voteId =
                    String.slice 0 12 (Crypto.sha256 (ideaId ++ ":" ++ userId))
            in
                Db.exec
                    conn
                    "INSERT INTO votes (id, idea_id, user_id) VALUES (?, ?, ?)"
                    [ voteId, ideaId, userId ]
                    |> Task.map (\_ -> ())
