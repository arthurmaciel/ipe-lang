module Page.Roadmap exposing (viewRoadmap)

import Ipe.List as List
import Ipe.String as String
import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onClick)
import State exposing (..)
import Lib.Db as Db
import Ui.Layout as Layout


-- The four status buckets are read from the Model, which a `RoadmapLoaded`
-- response populated. The view itself performs no database read — the load
-- is a Task dispatched by the roadmap page's ticker.
viewRoadmap model =
    Layout.page
        model
        (div
            [ class "mt-32" ]
            [ h1 [ class "page-title" ] [ text "Roadmap" ]
            , p
                  [ class "page-subtitle" ]
                  [ text
                        "Track the progress of community ideas from submission to completion."
                  ]
            , div
                  [ class "roadmap-grid" ]
                  [ roadmapColumn "Open" "Awaiting review" model.roadmapOpen
                  , roadmapColumn "Planned" "On the roadmap" model.roadmapPlanned
                  , roadmapColumn
                        "In Progress"
                        "Currently being built"
                        model.roadmapInProgress
                  , roadmapColumn "Done" "Shipped!" model.roadmapDone
                  ]
            ])


roadmapColumn title subtitle items =
    div
        [ class "roadmap-column" ]
        [ div
              [ class "roadmap-column-title" ]
              [ text title
              , span
                    [ class "roadmap-count" ]
                    [ text ("(" ++ String.fromInt (List.length items) ++ ")") ]
              ]
        , p [ class "roadmap-subtitle" ] [ text subtitle ]
        , div
              []
              (if List.isEmpty items then
                  [ p [ class "roadmap-empty" ] [ text "Nothing here yet" ] ]

              else
                  List.map roadmapItem items)
        ]


roadmapItem idea =
    let
        ideaId = Db.field "id" idea
        voteCount = Db.field "vote_count" idea
    in
        div
            [ class "roadmap-item" ]
            [ button
                  [ onClick (ViewIdea ideaId), class "roadmap-item-title" ]
                  [ text (Db.field "title" idea) ]
            , div
                  [ class "roadmap-item-votes" ]
                  [ text (voteCount ++ " votes") ]
            ]
