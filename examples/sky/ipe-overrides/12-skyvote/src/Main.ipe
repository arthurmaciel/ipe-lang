module Main exposing (main)

-- examples/12-skyvote — feature-voting board, TEA rearchitecture.
--
-- A DB-backed voting board: users submit ideas, vote on them, comment,
-- and track status on a roadmap. The upstream forces every database
-- read/write with `Task.run` — a module-level synchronous `dbConn` plus
-- synchronous `exec`/`query` wrappers consumed mid-`update` and inside
-- `view`. `Task.run` is removed from the Ipê surface (IPE-N0036) and Ipê
-- TEA has no synchronous force, so this is a whole-example
-- rearchitecture, hosted here as an `ipe-overrides/` tree (the same
-- mechanism as `13-skyshop` and `27-multi-session-chat`).
--
-- EFFECT MODEL. Every database read/write is a `Task Error a`; there is
-- no synchronous force. A Web-shape `Model` is persisted to the session
-- store between requests, so it holds plain data only — never the opaque
-- `Db` handle (IPE-L0120). Each database effect opens its own pooled
-- connection inside its Task chain (`Db.connect |> ensureSchema |> op`,
-- via `Lib.Db.withConn`), and only the settled DATA reaches the Model
-- through a response `Msg`. A page's data is loaded by the `Msg` that
-- navigates there and refreshed by a page-scoped `Time.every` tick, since
-- a route-only navigation re-renders the view without running `update`.

import Ipe.Result as Result
import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Ui as Ui
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
import Ipe.Tea.Web exposing (app, route)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import State exposing (..)
import Lib.Db as Db
import Lib.Auth as Auth
import Lib.Ideas as Ideas
import Lib.Comments as Comments
import Page.Board as Board
import Page.Detail as Detail
import Page.Submit as Submit
import Page.AuthPage as PageAuth
import Page.About as About
import Page.Roadmap as Roadmap


-- ══════════════════════════════════════════════════════
-- APP  (declared early — parity with the upstream ordering note)
-- ══════════════════════════════════════════════════════
main =
    app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes =
              [ route "/" BoardPage
              , route "/submit" SubmitPage
              , route "/auth/signin" SignInPage
              , route "/auth/signup" SignUpPage
              , route "/about" AboutPage
              , route "/roadmap" RoadmapPage
              ]
        , notFound = NotFoundPage
        }


-- ══════════════════════════════════════════════════════
-- INIT
-- ══════════════════════════════════════════════════════
-- | `init` runs once per new session. The board's ideas are loaded
-- asynchronously; the model starts empty and `IdeasLoaded` fills it in.
init req =
    ( emptyModel, loadIdeasCmd "newest" "all" "" )


emptyModel : Model
emptyModel =
    { page = BoardPage
    , currentUser = Nothing
    , ideas = []
    , sortBy = "newest"
    , filterCategory = "all"
    , searchQuery = ""
    , selectedIdeaId = ""
    , selectedIdea = Nothing
    , ideaComments = []
    , newComment = ""
    , submitTitle = ""
    , submitDescription = ""
    , submitCategory = "feature"
    , authEmail = ""
    , authUsername = ""
    , authPassword = ""
    , authError = ""
    , notification = ""
    , roadmapOpen = []
    , roadmapPlanned = []
    , roadmapInProgress = []
    , roadmapDone = []
    }


-- ══════════════════════════════════════════════════════
-- VIEW
-- ══════════════════════════════════════════════════════
-- The Web shape's `view` is `Model -> Element Msg`. The whole app is
-- built from the typed `Ipe.Html` / `Ipe.Css` builders (each page view
-- returns `Html Msg`); the single `Ui.html` bridge lifts that tree into
-- the `Element Msg` the shape expects.
view : Model -> Ui.Element Msg
view model =
    Ui.html (viewPage model)


viewPage : Model -> Html Msg
viewPage model =
    case model.page of

        BoardPage ->
            Board.viewBoard model

        DetailPage ->
            Detail.viewDetail model

        SubmitPage ->
            Submit.viewSubmit model

        SignInPage ->
            PageAuth.viewSignIn model

        SignUpPage ->
            PageAuth.viewSignUp model

        AboutPage ->
            About.viewAbout model

        RoadmapPage ->
            Roadmap.viewRoadmap model

        NotFoundPage ->
            Board.viewBoard model


-- ══════════════════════════════════════════════════════
-- SUBSCRIPTIONS
-- ══════════════════════════════════════════════════════
-- A route-only navigation re-renders the view without running `update`,
-- so the page-scoped ticker is how the board, detail, and roadmap pages
-- load and stay fresh after a nav-link click. Every `Page` constructor is
-- enumerated explicitly — a catch-all `_` over a closed union is rejected
-- (IPE-T0018).
subscriptions : Model -> Sub.Sub Msg
subscriptions model =
    case model.page of

        BoardPage ->
            Time.every 5000 Tick

        DetailPage ->
            Time.every 5000 Tick

        RoadmapPage ->
            Time.every 5000 Tick

        SubmitPage ->
            Sub.none

        SignInPage ->
            Sub.none

        SignUpPage ->
            Sub.none

        AboutPage ->
            Sub.none

        NotFoundPage ->
            Sub.none


-- ══════════════════════════════════════════════════════
-- UPDATE
-- ══════════════════════════════════════════════════════
update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigate page ->
            ( { model | page = page, notification = "", authError = "" }
            , Cmd.none
            )

        Tick ->
            ( model, refreshCurrentCmd model )

        -- ── Async responses ─────────────────────────────────────────
        IdeasLoaded (Ok ideas) ->
            ( { model | ideas = ideas }, Cmd.none )

        IdeasLoaded (Err e) ->
            ( { model | notification = "Could not load ideas: " ++ Error.toString e }
            , Cmd.none
            )

        DetailLoaded (Ok detail) ->
            ( { model | selectedIdea = detail.idea
              , ideaComments = detail.comments
              }
            , Cmd.none
            )

        DetailLoaded (Err e) ->
            ( { model | notification = "Could not load idea: " ++ Error.toString e }
            , Cmd.none
            )

        RoadmapLoaded (Ok data) ->
            ( { model | roadmapOpen = data.open
              , roadmapPlanned = data.planned
              , roadmapInProgress = data.inProgress
              , roadmapDone = data.done
              }
            , Cmd.none
            )

        RoadmapLoaded (Err e) ->
            ( { model | notification = "Could not load roadmap: " ++ Error.toString e }
            , Cmd.none
            )

        VoteToggled (Ok _) ->
            ( model, refreshCurrentCmd model )

        VoteToggled (Err e) ->
            ( { model | notification = "Could not record your vote: " ++ Error.toString e }
            , Cmd.none
            )

        CommentPosted (Ok _) ->
            ( { model | newComment = "" }, reloadDetailCmd model.selectedIdeaId )

        CommentPosted (Err e) ->
            ( { model | notification = "Could not post comment: " ++ Error.toString e }
            , Cmd.none
            )

        IdeaCreated (Ok _) ->
            ( { model | page = BoardPage
              , submitTitle = ""
              , submitDescription = ""
              , submitCategory = "feature"
              , notification = "Your idea has been submitted!"
              }
            , loadIdeasCmd model.sortBy model.filterCategory model.searchQuery
            )

        IdeaCreated (Err e) ->
            ( { model | notification = "Could not submit idea: " ++ Error.toString e }
            , Cmd.none
            )

        SignedIn (Ok user) ->
            ( { model | currentUser = Just user
              , page = BoardPage
              , authEmail = ""
              , authPassword = ""
              , authError = ""
              , notification = "Welcome back!"
              }
            , loadIdeasCmd "newest" "all" ""
            )

        SignedIn (Err e) ->
            ( { model | authError = signInErrorMessage e }, Cmd.none )

        SignedUp (Ok user) ->
            ( { model | currentUser = Just user
              , page = BoardPage
              , authEmail = ""
              , authUsername = ""
              , authPassword = ""
              , authError = ""
              , notification = "Account created! Welcome to SkyVote!"
              }
            , loadIdeasCmd "newest" "all" ""
            )

        SignedUp (Err e) ->
            ( { model | authError = Error.toString e }, Cmd.none )

        -- ── Board controls ──────────────────────────────────────────
        SetSort sortBy ->
            ( { model | sortBy = sortBy }
            , loadIdeasCmd sortBy model.filterCategory model.searchQuery
            )

        SetFilter category ->
            ( { model | filterCategory = category }
            , loadIdeasCmd model.sortBy category model.searchQuery
            )

        SetSearch query ->
            ( { model | searchQuery = query }
            , loadIdeasCmd model.sortBy model.filterCategory query
            )

        ToggleVote ideaId ->
            handleToggleVote ideaId model

        ViewIdea ideaId ->
            ( { model | page = DetailPage
              , selectedIdeaId = ideaId
              , selectedIdea = Nothing
              , ideaComments = []
              , newComment = ""
              , notification = ""
              }
            , reloadDetailCmd ideaId
            )

        BackToBoard ->
            ( { model | page = BoardPage
              , selectedIdea = Nothing
              , selectedIdeaId = ""
              , notification = ""
              }
            , loadIdeasCmd model.sortBy model.filterCategory model.searchQuery
            )

        -- ── Detail controls ─────────────────────────────────────────
        UpdateComment content ->
            ( { model | newComment = content }, Cmd.none )

        SubmitComment ->
            handleSubmitComment model

        -- ── Submit controls ─────────────────────────────────────────
        UpdateTitle t ->
            ( { model | submitTitle = t }, Cmd.none )

        UpdateDescription d ->
            ( { model | submitDescription = d }, Cmd.none )

        UpdateCategory c ->
            ( { model | submitCategory = c }, Cmd.none )

        SubmitIdea ->
            handleSubmitIdea model

        -- ── Auth controls ───────────────────────────────────────────
        UpdateEmail e ->
            ( { model | authEmail = e }, Cmd.none )

        UpdateUsername u ->
            ( { model | authUsername = u }, Cmd.none )

        UpdatePassword p ->
            ( { model | authPassword = p }, Cmd.none )

        DoSignIn ->
            ( model, Task.attempt SignedIn (Auth.authenticateUser model.authEmail model.authPassword) )

        DoSignUp ->
            handleSignUp model

        DoSignOut ->
            ( { model | currentUser = Nothing
              , page = BoardPage
              , notification = ""
              , authError = ""
              }
            , loadIdeasCmd "newest" "all" ""
            )


-- ══════════════════════════════════════════════════════
-- EFFECT BUILDERS
-- ══════════════════════════════════════════════════════
loadIdeasCmd : String -> String -> String -> Cmd Msg
loadIdeasCmd sortBy filterCategory searchQuery =
    Task.attempt IdeasLoaded (Ideas.getIdeas sortBy filterCategory searchQuery)


-- The single-idea detail load composes the idea read and its comments read
-- into one Task, so both settle together under a single response Msg.
reloadDetailCmd : String -> Cmd Msg
reloadDetailCmd ideaId =
    Task.attempt
        DetailLoaded
        (Task.map2
            (\idea comments -> { idea = idea, comments = comments })
            (Ideas.getIdea ideaId)
            (Comments.getComments ideaId))


-- The roadmap load composes the four status reads into one Task.
loadRoadmapCmd : Cmd Msg
loadRoadmapCmd =
    Task.attempt
        RoadmapLoaded
        (Task.map2
            (\( open, planned ) ( inProgress, done ) ->
                { open = open
                , planned = planned
                , inProgress = inProgress
                , done = done
                })
            (Task.map2 (\o p -> ( o, p ))
                (Ideas.getIdeasByStatus "open")
                (Ideas.getIdeasByStatus "planned"))
            (Task.map2 (\i d -> ( i, d ))
                (Ideas.getIdeasByStatus "in-progress")
                (Ideas.getIdeasByStatus "done")))


-- Reload whatever data the current page renders. Drives both the periodic
-- ticker and the post-vote refresh.
refreshCurrentCmd : Model -> Cmd Msg
refreshCurrentCmd model =
    case model.page of

        BoardPage ->
            loadIdeasCmd model.sortBy model.filterCategory model.searchQuery

        DetailPage ->
            reloadDetailCmd model.selectedIdeaId

        RoadmapPage ->
            loadRoadmapCmd

        SubmitPage ->
            Cmd.none

        SignInPage ->
            Cmd.none

        SignUpPage ->
            Cmd.none

        AboutPage ->
            Cmd.none

        NotFoundPage ->
            Cmd.none


-- ══════════════════════════════════════════════════════
-- AUTH-GATED HANDLERS
-- ══════════════════════════════════════════════════════
-- A vote requires a signed-in user; an anonymous vote is redirected to the
-- sign-in page rather than silently dropped.
handleToggleVote : String -> Model -> ( Model, Cmd Msg )
handleToggleVote ideaId model =
    case model.currentUser of

        Just user ->
            ( model, Task.attempt VoteToggled (Ideas.toggleVote ideaId (Db.field "id" user)) )

        Nothing ->
            ( { model | page = SignInPage, authError = "Please sign in to vote." }
            , Cmd.none
            )


handleSubmitComment : Model -> ( Model, Cmd Msg )
handleSubmitComment model =
    case model.currentUser of

        Just user ->
            if model.newComment == "" then
                ( model, Cmd.none )

            else
                ( model
                , Task.attempt
                    CommentPosted
                    (Comments.createComment model.selectedIdeaId (Db.field "id" user) model.newComment)
                )

        Nothing ->
            ( { model | page = SignInPage }, Cmd.none )


handleSubmitIdea : Model -> ( Model, Cmd Msg )
handleSubmitIdea model =
    case model.currentUser of

        Just user ->
            if model.submitTitle == "" then
                ( model, Cmd.none )

            else
                ( model
                , Task.attempt
                    IdeaCreated
                    (Ideas.createIdea
                        model.submitTitle
                        model.submitDescription
                        model.submitCategory
                        (Db.field "id" user)
                        |> Task.map (\_ -> ()))
                )

        Nothing ->
            ( { model | page = SignInPage }, Cmd.none )


-- Sign-up validates the form fields before touching the database; the
-- create-then-lookup pair is composed into one Task so the freshly
-- registered user is delivered in a single `SignedUp` response.
handleSignUp : Model -> ( Model, Cmd Msg )
handleSignUp model =
    if model.authEmail == "" then
        ( { model | authError = "Email is required." }, Cmd.none )

    else if model.authUsername == "" then
        ( { model | authError = "Username is required." }, Cmd.none )

    else if String.length model.authPassword < 8 then
        ( { model | authError = "Password must be at least 8 characters." }
        , Cmd.none
        )

    else
        ( model, Task.attempt SignedUp (registerUser model) )


registerUser : Model -> Task Error (Dict String String)
registerUser model =
    Auth.createUser model.authUsername model.authEmail model.authPassword
        |> Task.andThen
            (\userId ->
                Auth.getUserById userId
                    |> Task.andThen
                        (\maybeUser ->
                            case maybeUser of

                                Just user ->
                                    Task.succeed user

                                Nothing ->
                                    Task.fail
                                        (Error.invalidInput
                                            "Account created but auto-login failed. Please sign in.")
                        )
            )


-- A PermissionDenied surfaces the user-facing message verbatim (the same
-- text for a wrong password and an unknown email, so the response reveals
-- nothing); every other error kind is a service fault whose internals the
-- user should not see. Each kind is enumerated so a new `ErrorKind`
-- variant forces a decision here rather than falling through silently
-- (IPE-T0018).
signInErrorMessage : Error -> String
signInErrorMessage e =
    case e of

        Error kind info ->
            case kind of

                PermissionDenied ->
                    info.message

                Io ->
                    serviceUnavailableMessage

                Network ->
                    serviceUnavailableMessage

                Ffi ->
                    serviceUnavailableMessage

                Decode ->
                    serviceUnavailableMessage

                Timeout ->
                    serviceUnavailableMessage

                NotFound ->
                    serviceUnavailableMessage

                InvalidInput ->
                    serviceUnavailableMessage

                Conflict ->
                    serviceUnavailableMessage

                Unavailable ->
                    serviceUnavailableMessage

                Unexpected ->
                    serviceUnavailableMessage


serviceUnavailableMessage : String
serviceUnavailableMessage =
    "Sign-in temporarily unavailable. Please try again."
