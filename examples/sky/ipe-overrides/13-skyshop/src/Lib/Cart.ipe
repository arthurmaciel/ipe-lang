module Lib.Cart exposing
    ( getOrCreateCart
    , createCart
    , getCart
    , getCartItems
    , getCartWithItems
    , addItem
    , updateItemQty
    , removeItem
    , recalculateTotal
    , setCartState
    , setCheckout
    , setShipping
    , getUserCarts
    , getOrdersByState
    , getAllOrders
    , checkoutToOrder
    , getOrder
    , getOrderItems
    , getOrderWithItems
    )

import Ipe.Prelude exposing (..)
import Ipe.Maybe exposing (..)
import Ipe.Result as Result
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.Uuid as Uuid
import Lib.Db as Db
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))


newId : String
newId =
    Result.withDefault "" (Task.run (Uuid.v4 ()))


getOrCreateCart : String -> Result Error (Dict String String)
getOrCreateCart userId =
    let
        cartId = userId ++ "-cart"
    in
        case Db.getDoc "carts" cartId of

            Ok (Just cart) ->
                if Db.unsafeGetField "state" cart == "ongoing" then
                    Ok cart

                else
                    createCart userId

            Ok Nothing ->
                createCart userId

            Err e ->
                Err e


createCart : String -> Result Error (Dict String String)
createCart userId =
    let
        cartId = userId ++ "-cart"
        cartData =
            Dict.fromList
                [ ( "id", cartId )
                , ( "owner_id", userId )
                , ( "state", "ongoing" )
                , ( "checkout_link", "" )
                , ( "checkout_reference", "" )
                , ( "checkout_remarks", "" )
                , ( "shipping_name", "" )
                , ( "shipping_email", "" )
                , ( "shipping_phone", "" )
                , ( "shipping_line1", "" )
                , ( "shipping_line2", "" )
                , ( "shipping_city", "" )
                , ( "shipping_country", "" )
                , ( "shipping_postcode", "" )
                , ( "total_amount", Db.intVal 0 )
                , ( "total_currency", "GBP" )
                ]
    in
        case Db.setDoc "carts" cartId cartData of

            Ok _ ->
                Ok cartData

            Err e ->
                Err e


getCart cartId =
    Db.getDoc "carts" cartId


getCartItems cartId =
    let
        items =
            Db.queryWhereOrLog
                "Cart.getCartItems"
                "cart_items"
                "cart_id"
                "=="
                cartId
    in
        List.map enrichCartItem items


enrichCartItem item =
    let
        productId = Db.unsafeGetField "product_id" item
    in
        case Db.getDoc "products" productId of

            Ok (Just product) ->
                Dict.insert
                    "title"
                    (Db.unsafeGetField "title" product)
                    (Dict.insert
                        "summary"
                        (Db.unsafeGetField "summary" product)
                        (Dict.insert
                            "price_amount"
                            (Db.unsafeGetField "price_amount" product)
                            (Dict.insert
                                "price_currency"
                                (Db.unsafeGetField "price_currency" product)
                                (Dict.insert
                                    "price_discount"
                                    (Db.unsafeGetField "price_discount" product)
                                    (Dict.insert
                                        "price_tax"
                                        (Db.unsafeGetField "price_tax" product)
                                        (Dict.insert
                                            "stock"
                                            (Db.unsafeGetField "stock" product)
                                            item))))))

            _ ->
                item


getCartWithItems cartId =
    let
        cartResult = getCart cartId
        items =
            case cartResult of

                Ok (Just c) ->
                    getCartItems (Db.unsafeGetField "id" c)

                _ ->
                    []
    in
        ( cartResult, items )


addItem : String -> String -> Int -> Result Error ()
addItem cartId productId quantity =
    let
        existingItems =
            Db.queryWhereOrLog "Cart.addItem" "cart_items" "cart_id" "==" cartId
        matchingItems =
            List.filter
                (\item -> Db.unsafeGetField "product_id" item == productId)
                existingItems
    in
        case List.head matchingItems of

            Just existing ->
                let
                    existingQty = Db.unsafeGetInt "quantity" existing
                    newQty = existingQty + quantity
                    itemId = Db.unsafeGetField "id" existing
                    updatedItem =
                        Dict.insert "quantity" (Db.intVal newQty) existing
                    _ = Db.setDoc "cart_items" itemId updatedItem
                    _ = recalculateTotal cartId
                in
                    Ok ()

            Nothing ->
                let
                    itemId = newId
                    itemData =
                        Dict.fromList
                            [ ( "id", itemId )
                            , ( "cart_id", cartId )
                            , ( "product_id", productId )
                            , ( "quantity", Db.intVal quantity )
                            ]
                    _ = Db.setDoc "cart_items" itemId itemData
                    _ = recalculateTotal cartId
                in
                    Ok ()


updateItemQty : String -> Int -> Result Error ()
updateItemQty itemId quantity =
    if quantity <= 0 then
        removeItem itemId

    else
        case Db.getDoc "cart_items" itemId of

            Ok (Just item) ->
                let
                    updatedItem =
                        Dict.insert "quantity" (Db.intVal quantity) item
                    _ = Db.setDoc "cart_items" itemId updatedItem
                    _ = recalculateTotal (Db.unsafeGetField "cart_id" item)
                in
                    Ok ()

            _ ->
                Ok ()


removeItem : String -> Result Error ()
removeItem itemId =
    case Db.getDoc "cart_items" itemId of

        Ok (Just item) ->
            let
                cartId = Db.unsafeGetField "cart_id" item
                _ = Db.deleteDoc "cart_items" itemId
            in
                if cartId /= "" then
                    let
                        _ = recalculateTotal cartId
                    in
                        Ok ()

                else
                    Ok ()

        _ ->
            Ok ()


recalculateTotal cartId =
    let
        items = getCartItems cartId
        total =
            List.foldl
                (\item acc ->
                    let
                        price = Db.unsafeGetInt "price_amount" item
                        discount = Db.unsafeGetInt "price_discount" item
                        qty = Db.unsafeGetInt "quantity" item
                        effectivePrice = price - discount
                        itemTotal =
                            if effectivePrice > 0 then
                                effectivePrice * qty

                            else
                                0
                    in
                        acc + itemTotal)
                0
                items
        currency =
            case List.head items of

                Just item ->
                    Db.unsafeGetField "price_currency" item

                Nothing ->
                    "GBP"
    in
        case Db.getDoc "carts" cartId of

            Ok (Just cart) ->
                let
                    updatedCart =
                        Dict.insert
                            "total_amount"
                            (Db.intVal total)
                            (Dict.insert "total_currency" currency cart)
                    _ = Db.setDoc "carts" cartId updatedCart
                in
                    total

            _ ->
                total


findDocAndCollection docId =
    case Db.getDoc "orders" docId of

        Ok (Just doc) ->
            Ok ( "orders", doc )

        _ ->
            case Db.getDoc "carts" docId of

                Ok (Just doc) ->
                    Ok ( "carts", doc )

                Ok Nothing ->
                    Err
                        (Error.notFound
                            |> Error.withMessage "Document not found.")

                Err e ->
                    Err e


setCartState docId newState =
    case findDocAndCollection docId of

        Ok ( collection, doc ) ->
            let
                updatedDoc = Dict.insert "state" newState doc
                result = Db.setDoc collection docId updatedDoc
                _ =
                    Io.println
                        ("[ORDER] State changed: " ++ docId ++ " -> " ++ newState)
            in
                case result of

                    Ok v ->
                        Ok v

                    Err e ->
                        Err e

        Err e ->
            Err e


setCheckout docId link reference remarks =
    case findDocAndCollection docId of

        Ok ( collection, doc ) ->
            let
                updatedDoc =
                    Dict.insert
                        "checkout_link"
                        link
                        (Dict.insert
                            "checkout_reference"
                            reference
                            (Dict.insert "checkout_remarks" remarks doc))
            in
                Db.setDoc collection docId updatedDoc

        Err e ->
            Err e


setShipping docId name email phone line1 line2 city country postcode =
    case findDocAndCollection docId of

        Ok ( collection, doc ) ->
            let
                updatedDoc =
                    Dict.insert
                        "shipping_name"
                        name
                        (Dict.insert
                            "shipping_email"
                            email
                            (Dict.insert
                                "shipping_phone"
                                phone
                                (Dict.insert
                                    "shipping_line1"
                                    line1
                                    (Dict.insert
                                        "shipping_line2"
                                        line2
                                        (Dict.insert
                                            "shipping_city"
                                            city
                                            (Dict.insert
                                                "shipping_country"
                                                country
                                                (Dict.insert
                                                    "shipping_postcode"
                                                    postcode
                                                    doc)))))))
            in
                Db.setDoc collection docId updatedDoc

        Err e ->
            Err e


checkoutToOrder cartId =
    let
        orderId = newId
    in
        case Db.getDoc "carts" cartId of

            Ok (Just cart) ->
                let
                    orderData =
                        Dict.insert
                            "id"
                            orderId
                            (Dict.insert "cart_id" cartId cart)
                    _ = Db.setDoc "orders" orderId orderData
                    cartItems =
                        Db.queryWhereOrLog
                            "Cart.checkoutToOrder"
                            "cart_items"
                            "cart_id"
                            "=="
                            cartId
                    _ =
                        List.map
                            (\item ->
                                let
                                    itemId = newId
                                    enriched = enrichCartItem item
                                    orderItem =
                                        Dict.insert
                                            "id"
                                            itemId
                                            (Dict.insert
                                                "order_id"
                                                orderId
                                                (Dict.insert
                                                    "cart_id"
                                                    cartId
                                                    enriched))
                                in
                                    Db.setDoc "order_items" itemId orderItem)
                            cartItems
                    _ =
                        Io.println
                            ("[CHECKOUT] Created order " ++ orderId
                                ++ " from cart "
                                ++ cartId)
                in
                    Ok orderId

            _ ->
                Err (Error.notFound |> Error.withMessage "Cart not found.")


getOrder orderId =
    Db.getDoc "orders" orderId


getOrderItems orderId =
    Db.queryWhereOrLog
        "Cart.getOrderItems"
        "order_items"
        "order_id"
        "=="
        orderId


getOrderWithItems orderId =
    let
        orderResult = getOrder orderId
        items =
            case orderResult of

                Ok (Just _) ->
                    getOrderItems orderId

                _ ->
                    []
    in
        ( orderResult, items )


getUserCarts userId =
    Db.queryWhereOrLog "Cart.getUserCarts" "orders" "owner_id" "==" userId


getOrdersByState state =
    if state == "all" then
        getAllOrders

    else
        let
            orders =
                Db.queryWhereOrLog
                    "Cart.getOrdersByState"
                    "orders"
                    "state"
                    "=="
                    state
        in
            List.map enrichOrderWithUser orders


getAllOrders =
    let
        allOrders = Db.queryDocsOrLog "Cart.getAllOrders" "orders"
    in
        List.map enrichOrderWithUser allOrders


enrichOrderWithUser order =
    let
        ownerId = Db.unsafeGetField "owner_id" order
    in
        case Db.getDoc "users" ownerId of

            Ok (Just user) ->
                Dict.insert
                    "user_name"
                    (Db.unsafeGetField "name" user)
                    (Dict.insert "user_email" (Db.unsafeGetField "email" user) order)

            _ ->
                order
