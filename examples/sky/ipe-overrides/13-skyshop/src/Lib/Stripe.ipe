module Lib.Stripe exposing (createCheckoutSession, verifyPayment, deductStock, CheckoutInfo, PaymentStatus)

-- Payments over the REAL crates.io async-stripe crates, auto-FFI-bound
-- shim-free. The Lib boundary is synchronous (`Result`): each call builds a
-- client from STRIPE_SECRET_KEY, runs its Task chain, and folds back via
-- `Task.run`. Line items are built inline (`price_data` + `product_data`), so
-- no pre-created Stripe Price is needed. `currencyFromCode` covers the shop's
-- currency codes with a USD fallback — a recorded over-restriction vs the full
-- ISO table.

import Ipe.Maybe as Maybe exposing (..)
import Ipe.Result as Result
import Ipe.Task as Task
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Io as Io
import Ipe.System as System
import Lib.Db as Db
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
import Rust.Async_stripe as Stripe
import Rust.Async_stripe_checkout as Checkout
import Rust.Async_stripe_shared as Shared
import Rust.Async_stripe_types as Types


type alias PaymentStatus =
    { status : String
    , paymentStatus : String
    , customerName : String
    , customerEmail : String
    , customerPhone : String
    , shippingLine1 : String
    , shippingLine2 : String
    , shippingCity : String
    , shippingCountry : String
    , shippingPostalCode : String
    }


type alias CheckoutInfo =
    { id : String
    , url : String
    }


domainUrl _ =
    let
        domain = Result.withDefault "" (Task.run (System.getenv "DOMAIN"))
        port_ =
            Result.withDefault "" (Task.run (System.getenv "SKY_LIVE_PORT"))
    in
        if domain /= "" then
            domain

        else
            let
                effectivePort =
                    if port_ == "" then
                        "8000"

                    else
                        port_
            in
                "http://localhost:" ++ effectivePort


secretKey _ =
    Result.withDefault "" (Task.run (System.getenv "STRIPE_SECRET_KEY"))


-- One Stripe client per operation, mirroring Lib.Db's per-op client: build,
-- run the Task chain, fold back to Result.
withClient use =
    Task.run
        (Task.fromResult (Stripe.new_from_client (secretKey ()))
            |> Task.andThen use
        )


-- The shop's currency codes, USD fallback (the reference behavior for an
-- unrecognised code).
currencyFromCode code =
    case String.toLower code of

        "eur" ->
            Types.eUR_new_variant_from_currency ()

        "gbp" ->
            Types.gBP_new_variant_from_currency ()

        "brl" ->
            Types.bRL_new_variant_from_currency ()

        _ ->
            Types.uSD_new_variant_from_currency ()


-- One inline line item from a cart row: price_data carries the currency +
-- unit amount, product_data carries the title; quantity is checked (the
-- narrowing-int setter is fallible by design).
buildLineItem item =
    let
        price = Db.unsafeGetInt "price_amount" item
        discount = Db.unsafeGetInt "price_discount" item
        effectivePrice =
            if price - discount > 0 then
                price - discount

            else
                price
        qtyRaw = Db.unsafeGetInt "quantity" item
        qty =
            if qtyRaw <= 0 then
                1

            else
                qtyRaw
        currency = currencyFromCode (Db.unsafeGetField "price_currency" item)
    in
        Checkout.new_from_checkout_sessionCreateCheckoutSessionLineItemsPriceData currency
            |> Result.map
                (Checkout.unit_amount_set_field_from_checkout_sessionCreateCheckoutSessionLineItemsPriceData
                    (Just effectivePrice)
                )
            |> Result.andThen
                (\priceData ->
                    Checkout.new_from_checkout_sessionProductData (Db.unsafeGetField "title" item)
                        |> Result.map
                            (\productData ->
                                Checkout.product_data_set_field_from_checkout_sessionCreateCheckoutSessionLineItemsPriceData
                                    (Just productData)
                                    priceData
                            )
                )
            |> Result.andThen
                (\priceData ->
                    Checkout.new_from_checkout_sessionCreateCheckoutSessionLineItems ()
                        |> Result.map
                            (Checkout.price_data_set_field_from_checkout_sessionCreateCheckoutSessionLineItems
                                (Just priceData)
                            )
                )
            |> Result.andThen
                (Checkout.quantity_set_field_from_checkout_sessionCreateCheckoutSessionLineItems
                    (Just qty)
                )


buildLineItems items =
    if List.isEmpty items then
        Err (Error.invalidInput "No line items for checkout.")

    else
        List.foldr
            (\item acc ->
                acc
                    |> Result.andThen
                        (\rest ->
                            buildLineItem item
                                |> Result.map (\li -> li :: rest)
                        )
            )
            (Ok [])
            items


checkoutInfoFromSession session =
    Shared.to_string_from_checkoutSessionId (Shared.id_field_from_checkoutSession session)
        |> Result.map
            (\sessionId ->
                { id = sessionId
                , url = Maybe.withDefault "" (Shared.url_field_from_checkoutSession session)
                }
            )


createCheckoutSession : String -> List (Dict String String) -> String -> String -> String -> String -> Result Error CheckoutInfo
createCheckoutSession cartId items _userId _userName userEmail _remarks =
    let
        successUrl = domainUrl () ++ "/order/" ++ cartId ++ "/success"
        cancelUrl = domainUrl () ++ "/cart"
    in
        buildLineItems items
            |> Result.andThen
                (\lineItems ->
                    withClient
                        (\client ->
                            Task.fromResult (Checkout.new_from_checkout_sessionCreateCheckoutSession ())
                                |> Task.andThen
                                    (\b ->
                                        Task.fromResult
                                            (Checkout.mode_from_checkout_sessionCreateCheckoutSession
                                                b
                                                (Shared.payment_new_variant_from_checkoutSessionMode ())
                                            )
                                    )
                                |> Task.andThen
                                    (\b ->
                                        Task.fromResult
                                            (Checkout.customer_email_from_checkout_sessionCreateCheckoutSession b userEmail)
                                    )
                                |> Task.andThen
                                    (\b ->
                                        Task.fromResult
                                            (Checkout.line_items_from_checkout_sessionCreateCheckoutSession b lineItems)
                                    )
                                |> Task.andThen
                                    (\b ->
                                        Task.fromResult
                                            (Checkout.success_url_from_checkout_sessionCreateCheckoutSession b successUrl)
                                    )
                                |> Task.andThen
                                    (\b ->
                                        Task.fromResult
                                            (Checkout.cancel_url_from_checkout_sessionCreateCheckoutSession b cancelUrl)
                                    )
                                |> Task.andThen
                                    (\b -> Checkout.send_from_checkout_sessionCreateCheckoutSession b client)
                        )
                )
            |> Result.andThen checkoutInfoFromSession


verifyPayment orderId =
    let
        doc =
            case Db.getDoc "orders" orderId of

                Ok (Just order) ->
                    Just order

                _ ->
                    case Db.getDoc "carts" orderId of

                        Ok (Just cart) ->
                            Just cart

                        _ ->
                            Nothing
    in
        case doc of

            Just order ->
                let
                    reference = Db.unsafeGetField "checkout_reference" order
                in
                    if reference == "" then
                        Err (Error.invalidInput "No checkout reference found.")

                    else
                        verifyStripeSession orderId reference

            Nothing ->
                Err (Error.notFound |> Error.withMessage "Order not found.")


verifyStripeSession cartId sessionId =
    withClient
        (\client ->
            Task.fromResult (Checkout.new_from_checkout_sessionRetrieveCheckoutSession sessionId)
                |> Task.andThen
                    (\r ->
                        Task.fromResult
                            (Checkout.expand_from_checkout_sessionRetrieveCheckoutSession r [ "customer_details" ])
                    )
                |> Task.andThen
                    (\r -> Checkout.send_from_checkout_sessionRetrieveCheckoutSession r client)
        )
        |> Result.andThen (paymentStatusFromSession cartId)


paymentStatusFromSession cartId session =
    let
        status =
            case Shared.status_field_from_checkoutSession session of

                Just s ->
                    Result.withDefault "" (Shared.as_str_from_checkoutSessionStatus s)

                Nothing ->
                    ""
        paymentStatus =
            Result.withDefault ""
                (Shared.as_str_from_checkoutSessionPaymentStatus
                    (Shared.payment_status_field_from_checkoutSession session)
                )
        details = Shared.customer_details_field_from_checkoutSession session
        address =
            Maybe.andThen Shared.address_field_from_paymentPagesCheckoutSessionCustomerDetails details
        detailField get =
            Maybe.withDefault "" (Maybe.andThen get details)
        addressField get =
            Maybe.withDefault "" (Maybe.andThen get address)
    in
        if status == "complete" && paymentStatus == "paid" then
            Ok
                { status = status
                , paymentStatus = paymentStatus
                , customerName = detailField Shared.name_field_from_paymentPagesCheckoutSessionCustomerDetails
                , customerEmail = detailField Shared.email_field_from_paymentPagesCheckoutSessionCustomerDetails
                , customerPhone = detailField Shared.phone_field_from_paymentPagesCheckoutSessionCustomerDetails
                , shippingLine1 = addressField Shared.line1_field_from_address
                , shippingLine2 = addressField Shared.line2_field_from_address
                , shippingCity = addressField Shared.city_field_from_address
                , shippingCountry = addressField Shared.country_field_from_address
                , shippingPostalCode = addressField Shared.postal_code_field_from_address
                }

        else
            Err (Error.invalidInput "Payment not complete.")


deductStock orderId =
    let
        orderItems =
            Db.queryWhereOrLog
                "Stripe.deductStock.orderItems"
                "order_items"
                "order_id"
                "=="
                orderId
        items =
            if List.isEmpty orderItems then
                Db.queryWhereOrLog
                    "Stripe.deductStock.cartItems"
                    "cart_items"
                    "cart_id"
                    "=="
                    orderId

            else
                orderItems
        _deductResults = List.map deductItemStock items
    in
        ()


deductItemStock item =
    let
        productId = Db.unsafeGetField "product_id" item
        qty = Db.unsafeGetInt "quantity" item
    in
        case Db.getDoc "products" productId of

            Ok (Just product) ->
                let
                    currentStock = Db.unsafeGetInt "stock" product
                in
                    if currentStock >= 0 then
                        let
                            newStock =
                                if currentStock - qty >= 0 then
                                    currentStock - qty

                                else
                                    0
                            updatedProduct =
                                Dict.insert "stock" (Db.intVal newStock) product
                            _setResult =
                                Db.setDoc "products" productId updatedProduct
                        in
                            ()

                    else
                        ()

            _ ->
                ()
