module Lib.Auth exposing (verifyToken, signOut, getUserById, isAdmin, getSessionUser)

import Ipe.Prelude exposing (..)
import Ipe.Maybe exposing (..)
import Ipe.Result as Result
import Ipe.Task as Task
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Log exposing (println)
import Ipe.System as System
import Lib.Db as Db
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
import Ipe.Json.Decode as JsonDec
import Rust.Rs_firebase_admin_sdk as Firebase


adminEmails _ =
    let
        envAdmins =
            Result.withDefault "" (Task.run (System.getenv "ADMIN_EMAILS"))
    in
        if envAdmins == "" then
            ["admin@example.com"]

        else
            String.split "," envAdmins


isAdmin : Dict String String -> Bool
isAdmin user =
    Db.getBool "is_admin" user


-- ══════════════════════════════════════════════════════
-- VERIFY TOKEN (over Rust.Rs_firebase_admin_sdk)
-- ══════════════════════════════════════════════════════
-- ID-token verification over the REAL `rs-firebase-admin-sdk` crate
-- (`Rust.Rs_firebase_admin_sdk`, shim-free): a live JWT validator for the
-- project, `validate` returning the claims as JSON text, decoded here
-- (`sub` is the Firebase uid; `email`/`name` are optional claims).
claimField : String -> String -> String
claimField name claimsJson =
    JsonDec.decodeString (JsonDec.field name JsonDec.string) claimsJson
        |> Result.withDefault ""

verifyClaims : String -> Result Error String
verifyClaims idToken =
    Task.run
        (Task.fromResult (Firebase.new_jwt_validator_from_jwtLiveValidator (firebaseProjectId ()))
            |> Task.andThen (\verifier -> Firebase.validate verifier idToken)
        )

firebaseProjectId : () -> String
firebaseProjectId _ =
    let
        fromEnv =
            Result.withDefault "" (Task.run (System.getenv "GOOGLE_CLOUD_PROJECT"))
    in
        if fromEnv == "" then
            "demo-project"

        else
            fromEnv

verifyToken idToken =
    case verifyClaims idToken of

        Ok claims ->
            let
                uid = claimField "sub" claims
                email = claimField "email" claims
                name = claimField "name" claims
                _ =
                    println
                        ("[AUTH] Firebase token verified for: " ++ email
                            ++ " (uid: "
                            ++ uid
                            ++ ")")
            in
                findOrCreateUser uid email name

        Err _ ->
            let
                _ = println "[AUTH] Firebase token verification failed"
            in
                Err
                    (Error.permissionDenied
                        |> Error.withMessage
                               "Authentication failed. Please try again.")


findOrCreateUser uid email name =
    let
        isAdminUser = List.member email (adminEmails ())
        adminStr =
            if isAdminUser then
                "true"

            else
                "false"
        upsertData =
            Dict.fromList
                [ ( "id", uid )
                , ( "firebase_uid", uid )
                , ( "email", email )
                , ( "name", name )
                , ( "is_admin", Db.boolVal isAdminUser )
                ]
        _ = Db.setDoc "users" uid upsertData
        result = Db.getDoc "users" uid
    in
        case result of

            Ok maybeUser ->
                case maybeUser of

                    Just user ->
                        if Db.getBool "suspended" user then
                            Err
                                (Error.permissionDenied
                                    |> Error.withMessage
                                           "Account suspended. Please contact support.")

                        else
                            let
                                _ =
                                    println
                                        ("[AUTH] Signed in: " ++ email
                                            ++ " (admin: "
                                            ++ adminStr
                                            ++ ")")
                                -- setDoc returns the doc id only (not the stored
                                -- row), so the upsert fields are the canonical
                                -- identity — return them directly (also avoids
                                -- Dict.union, not yet on the Rust runtime).
                            in
                                Ok upsertData

                    Nothing ->
                        Ok upsertData

            Err _ ->
                Ok upsertData


signOut =
    let
        _ = println "[AUTH] User signed out"
    in
        ()


getUserById userId =
    Db.getDoc "users" userId


getSessionUser userId =
    case getUserById userId of

        Ok maybeUser ->
            maybeUser

        Err _ ->
            Nothing
