module Page.Admin exposing
    ( viewAdminProducts
    , viewAdminNewProduct
    , viewAdminEditProduct
    , viewAdminOrders
    , viewAdminOrder
    )

import Ipe.Prelude exposing (..)
import Ipe.Maybe as Maybe
import Ipe.List as List
import Ipe.String as String
import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Input as Input
import Ipe.Ui.Region as Region
import State exposing (..)
import Ui.Layout as Layout
import Lib.Db as Db
import Lib.Money as Money
import Lib.Products as Products
import Lib.Translation as Tr


-- ══════════════════════════════════════════════════════
-- ADMIN PRODUCT LIST
-- ══════════════════════════════════════════════════════
viewAdminProducts : Model -> Html.Html Msg
viewAdminProducts model =
    let
        lang = model.lang
        products = model.products
        publishedCount =
            List.length (List.filter (\p -> Db.unsafeGetBool "published" p) products)
        draftCount = List.length products - publishedCount
    in
        Ui.layout []
            (Layout.adminShell
                model
                (Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 24 ]
                    [ Ui.row
                        [ Ui.width Ui.fill, Ui.spacing 16 ]
                        [ Ui.column
                            [ Ui.spacing 4 ]
                            [ Ui.el
                                [ Region.heading 1, Font.size 24, Font.bold, Font.color Layout.ink ]
                                (Ui.text (Tr.t lang "admin.products"))
                            , Ui.el
                                [ Font.color Layout.muted, Font.size 14 ]
                                (Ui.text
                                    (String.fromInt (List.length products)
                                        ++ " total / "
                                        ++ String.fromInt publishedCount
                                        ++ " published / "
                                        ++ String.fromInt draftCount
                                        ++ " draft"))
                            ]
                        , Ui.el [ Ui.width Ui.fill ] Ui.none
                        , Layout.primaryButton (Navigate AdminNewProductPage)
                            ("+ " ++ Tr.t lang "admin.newProduct")
                        ]
                    , productTable model products
                    ]))


productTable : Model -> List (Dict String String) -> Element Msg
productTable model products =
    if List.isEmpty products then
        Layout.card []
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 12, Font.alignCenter ]
                [ Ui.el [ Ui.width Ui.fill, Font.alignCenter, Font.color (Ui.rgb 156 163 175) ]
                    (Ui.text "No products yet")
                , Ui.el [ Ui.width Ui.fill, Font.alignCenter ]
                    (Ui.button
                        [ Font.color Layout.brand, Font.size 14, Font.semiBold ]
                        { onPress = Just (Navigate AdminNewProductPage)
                        , label = Ui.text "Create your first product"
                        })
                ])

    else
        Layout.card []
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 0 ]
                (productTableHeader
                    :: List.map (viewAdminProductRow model) products))


productTableHeader : Element Msg
productTableHeader =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 12 10
        , Ui.spacing 12
        , Background.color (Ui.rgb 249 250 251)
        , Font.color Layout.muted
        , Font.size 12
        , Font.semiBold
        ]
        [ Ui.el [ Ui.width Ui.fill ] (Ui.text "Product")
        , Ui.el [ Ui.width (Ui.px 120) ] (Ui.text "Category")
        , Ui.el [ Ui.width (Ui.px 90) ] (Ui.text "Price")
        , Ui.el [ Ui.width (Ui.px 80) ] (Ui.text "Stock")
        , Ui.el [ Ui.width (Ui.px 70) ] (Ui.text "Status")
        ]


viewAdminProductRow : Model -> Dict String String -> Element Msg
viewAdminProductRow model product =
    let
        productId = Db.unsafeGetField "id" product
        title = Db.unsafeGetField "title" product
        category = Db.unsafeGetField "category" product
        pricing = Money.formatPriceFromRow product
        published = Db.unsafeGetBool "published" product
        stock = Db.unsafeGetInt "stock" product
    in
        Ui.button
            [ Ui.width Ui.fill
            , Background.hoverColor (Ui.rgb 249 250 251)
            , Ui.paddingXY 12 12
            , Border.widthEach { top = 1, right = 0, bottom = 0, left = 0 }
            , Border.color Layout.hairline
            ]
            { onPress = Just (Navigate (AdminEditProductPage productId))
            , label =
                Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 12 ]
                    [ Ui.el
                        [ Ui.width Ui.fill, Font.color Layout.ink, Font.size 14, Font.weight 500 ]
                        (Ui.text title)
                    , Ui.el
                        [ Ui.width (Ui.px 120), Font.color Layout.muted, Font.size 14 ]
                        (Ui.text category)
                    , Ui.el
                        [ Ui.width (Ui.px 90), Font.color Layout.ink, Font.size 14, Font.weight 500 ]
                        (Ui.text pricing.original)
                    , Ui.el
                        [ Ui.width (Ui.px 80), Font.color Layout.muted, Font.size 14 ]
                        (Ui.text
                            (if stock < 0 then
                                "Unlimited"

                             else
                                String.fromInt stock))
                    , Ui.el
                        [ Ui.width (Ui.px 70) ]
                        (if published then
                            Layout.badge (Ui.rgb 21 128 61) (Ui.rgb 240 253 244) "Live"

                         else
                            Layout.badge Layout.muted (Ui.rgb 243 244 246) "Draft")
                    ]
            }


-- ══════════════════════════════════════════════════════
-- ADMIN PRODUCT FORM (new + edit)
-- ══════════════════════════════════════════════════════
viewAdminNewProduct : Model -> Html.Html Msg
viewAdminNewProduct model =
    Ui.layout []
        (Layout.adminShell
            model
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 24 ]
                [ Ui.column
                    [ Ui.spacing 8 ]
                    [ backLink "< Products" AdminProductsPage
                    , Ui.el
                        [ Region.heading 1, Font.size 24, Font.bold, Font.color Layout.ink ]
                        (Ui.text (Tr.t model.lang "admin.newProduct"))
                    ]
                , viewProductForm model
                ]))


viewAdminEditProduct : Model -> Html.Html Msg
viewAdminEditProduct model =
    Ui.layout []
        (Layout.adminShell
            model
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 24 ]
                [ Ui.column
                    [ Ui.spacing 8, Ui.width Ui.fill ]
                    [ backLink "< Products" AdminProductsPage
                    , Ui.row
                        [ Ui.width Ui.fill, Ui.spacing 16 ]
                        [ Ui.el
                            [ Region.heading 1, Font.size 24, Font.bold, Font.color Layout.ink ]
                            (Ui.text (Tr.t model.lang "admin.editProduct"))
                        , Ui.el [ Ui.width Ui.fill ] Ui.none
                        , Layout.dangerButton (DeleteProduct model.editProductId)
                            (Tr.t model.lang "admin.product.delete")
                        ]
                    ]
                , viewProductForm model
                , if model.editProductId /= "" then
                    viewImageManager model

                  else
                    Ui.none
                ]))


backLink : String -> Page -> Element Msg
backLink label target =
    Ui.button
        [ Font.color Layout.muted, Font.size 14 ]
        { onPress = Just (Navigate target), label = Ui.text label }


formLabel : String -> Element Msg
formLabel txt =
    Ui.el
        [ Font.color (Ui.rgb 55 65 81), Font.size 13, Font.weight 500 ]
        (Ui.text txt)


-- A parsed-Int text field — ports the original number input + the
-- `onInput (\s -> Msg (Maybe.withDefault current (String.toInt s)))` shape.
intField : String -> Int -> (Int -> Msg) -> Element Msg
intField labelTxt current toMsg =
    Ui.column
        [ Ui.width Ui.fill, Ui.spacing 6 ]
        [ formLabel labelTxt
        , Input.text
            [ Ui.width Ui.fill ]
            { onChange = \s -> toMsg (Maybe.withDefault current (String.toInt s))
            , text = String.fromInt current
            , placeholder = Just (Input.placeholder [] (Ui.text "0"))
            , label = Input.labelHidden labelTxt
            }
        ]


viewProductForm : Model -> Element Msg
viewProductForm model =
    let
        lang = model.lang
    in
        Layout.card []
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 20 ]
                [ Ui.el
                    [ Font.color Layout.ink, Font.size 14, Font.semiBold ]
                    (Ui.text (Tr.t lang "admin.product.basicInfo"))
                , Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 6 ]
                    [ formLabel (Tr.t lang "admin.product.title")
                    , Input.text
                        [ Ui.width Ui.fill ]
                        { onChange = UpdateEditTitle
                        , text = model.editTitle
                        , placeholder = Just (Input.placeholder [] (Ui.text "Product name"))
                        , label = Input.labelHidden "title"
                        }
                    ]
                , Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 6 ]
                    [ formLabel (Tr.t lang "admin.product.summary")
                    , Input.text
                        [ Ui.width Ui.fill ]
                        { onChange = UpdateEditSummary
                        , text = model.editSummary
                        , placeholder = Just (Input.placeholder [] (Ui.text "Describe the product..."))
                        , label = Input.labelHidden "summary"
                        }
                    ]
                , Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 6 ]
                    [ formLabel (Tr.t lang "admin.product.category")
                    , Ui.wrappedRow
                        [ Ui.spacing 8 ]
                        (List.map (categoryChip model) allCategories)
                    ]
                , Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 6 ]
                    [ formLabel (Tr.t lang "admin.product.currency")
                    , Ui.row
                        [ Ui.spacing 8 ]
                        (List.map (currencyChip model) allCurrencies)
                    ]
                , Ui.el
                    [ Font.color Layout.ink, Font.size 14, Font.semiBold ]
                    (Ui.text (Tr.t lang "admin.product.pricingInventory"))
                , Ui.wrappedRow
                    [ Ui.width Ui.fill, Ui.spacing 16 ]
                    [ intField (Tr.t lang "admin.product.price") model.editPrice UpdateEditPrice
                    , intField (Tr.t lang "admin.product.discount") model.editDiscount UpdateEditDiscount
                    , intField (Tr.t lang "admin.product.stock") model.editStock UpdateEditStock
                    ]
                , Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 12 ]
                    [ publishToggle model
                    , Ui.el
                        [ Font.color (Ui.rgb 55 65 81), Font.size 14, Font.weight 500 ]
                        (Ui.text (Tr.t lang "admin.product.published"))
                    , Ui.el [ Ui.width Ui.fill ] Ui.none
                    , Layout.secondaryButton (Navigate AdminProductsPage)
                        (Tr.t lang "common.cancel")
                    , Layout.primaryButton SubmitProduct (Tr.t lang "admin.product.save")
                    ]
                ])


categoryChip : Model -> String -> Element Msg
categoryChip model cat =
    let
        active = model.editCategory == cat
    in
        Ui.button
            [ Background.color
                (if active then
                    Layout.brand

                 else
                    Layout.cardBg)
            , Font.color
                (if active then
                    Ui.rgb 255 255 255

                 else
                    Layout.muted)
            , Border.width 1
            , Border.color
                (if active then
                    Layout.brand

                 else
                    Layout.hairline)
            , Font.size 13
            , Border.rounded 999
            , Ui.paddingXY 12 6
            ]
            { onPress = Just (UpdateEditCategory cat)
            , label = Ui.text (Tr.tCategory model.lang cat)
            }


currencyChip : Model -> String -> Element Msg
currencyChip model cur =
    let
        active = model.editCurrency == cur
    in
        Ui.button
            [ Background.color
                (if active then
                    Layout.ink

                 else
                    Layout.cardBg)
            , Font.color
                (if active then
                    Ui.rgb 255 255 255

                 else
                    Layout.muted)
            , Border.width 1
            , Border.color
                (if active then
                    Layout.ink

                 else
                    Layout.hairline)
            , Font.size 13
            , Border.rounded 6
            , Ui.paddingXY 12 6
            ]
            { onPress = Just (UpdateEditCurrency cur)
            , label = Ui.text cur
            }


publishToggle : Model -> Element Msg
publishToggle model =
    Ui.button
        [ Background.color
            (if model.editPublished then
                Layout.success

             else
                Ui.rgb 209 213 219)
        , Font.color (Ui.rgb 255 255 255)
        , Font.size 12
        , Font.semiBold
        , Border.rounded 999
        , Ui.paddingXY 12 6
        ]
        { onPress = Just ToggleEditPublished
        , label =
            Ui.text
                (if model.editPublished then
                    "ON"

                 else
                    "OFF")
        }


-- ══════════════════════════════════════════════════════
-- IMAGE MANAGER
-- ══════════════════════════════════════════════════════
-- DIVERGENCE: the original uses a raw <input type="file"> with onImage /
-- fileMaxWidth — Std.Ui has no file-picker primitive in the proven set, so the
-- upload control is re-expressed as an "Upload Image" button driving the
-- existing `UploadImage` Msg (which reads model.editImageData). The image grid
-- + per-image delete buttons stay faithful.
viewImageManager : Model -> Element Msg
viewImageManager model =
    let
        lang = model.lang
        images = model.productImages
    in
        Layout.card []
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 16 ]
                [ Ui.el
                    [ Font.color Layout.ink, Font.size 14, Font.semiBold ]
                    (Ui.text
                        (Tr.t lang "admin.product.images" ++ " ("
                            ++ String.fromInt (List.length images)
                            ++ ")"))
                , if List.isEmpty images then
                    Ui.none

                  else
                    Ui.wrappedRow
                        [ Ui.spacing 12 ]
                        (List.map imageThumb images)
                , Ui.row
                    [ Ui.spacing 12 ]
                    [ Layout.primaryButton UploadImage (Tr.t lang "admin.product.upload") ]
                ])


imageThumb : Dict String String -> Element Msg
imageThumb imgRow =
    let
        imageId = Db.unsafeGetField "id" imgRow
    in
        Ui.column
            [ Ui.width (Ui.px 120)
            , Ui.spacing 4
            ]
            [ Ui.el
                [ Ui.width (Ui.px 120)
                , Ui.height (Ui.px 120)
                , Background.color (Ui.rgb 243 244 246)
                , Border.rounded 6
                , Font.alignCenter
                , Font.color Layout.muted
                , Font.size 11
                ]
                (Ui.text "image")
            , Layout.dangerButton (DeleteImage imageId) "Delete"
            ]


-- ══════════════════════════════════════════════════════
-- ADMIN ORDERS LIST
-- ══════════════════════════════════════════════════════
viewAdminOrders : Model -> Html.Html Msg
viewAdminOrders model =
    let
        lang = model.lang
    in
        Ui.layout []
            (Layout.adminShell
                model
                (Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 24 ]
                    [ Ui.column
                        [ Ui.spacing 4 ]
                        [ Ui.el
                            [ Region.heading 1, Font.size 24, Font.bold, Font.color Layout.ink ]
                            (Ui.text (Tr.t lang "admin.orders"))
                        , Ui.el
                            [ Font.color Layout.muted, Font.size 14 ]
                            (Ui.text (String.fromInt (List.length model.adminOrders) ++ " orders"))
                        ]
                    , viewOrderFilter model
                    , ordersTable model
                    ]))


viewOrderFilter : Model -> Element Msg
viewOrderFilter model =
    Ui.wrappedRow
        [ Ui.spacing 8 ]
        (orderFilterBtn model "all" "All"
            :: List.map
                (\st -> orderFilterBtn model st (Tr.tCartState model.lang st))
                [ "pending"
                , "ordered"
                , "shipped"
                , "delivered"
                , "cancelled"
                , "refunded"
                ])


orderFilterBtn : Model -> String -> String -> Element Msg
orderFilterBtn model filterValue label =
    let
        active = model.adminOrderFilter == filterValue
    in
        Ui.button
            [ Background.color
                (if active then
                    Layout.brand

                 else
                    Layout.cardBg)
            , Font.color
                (if active then
                    Ui.rgb 255 255 255

                 else
                    Layout.muted)
            , Border.width 1
            , Border.color
                (if active then
                    Layout.brand

                 else
                    Layout.hairline)
            , Font.size 14
            , Border.rounded 999
            , Ui.paddingXY 16 6
            ]
            { onPress = Just (SetAdminOrderFilter filterValue), label = Ui.text label }


ordersTable : Model -> Element Msg
ordersTable model =
    if List.isEmpty model.adminOrders then
        Layout.card []
            (Ui.el
                [ Ui.width Ui.fill, Font.alignCenter, Font.color (Ui.rgb 156 163 175) ]
                (Ui.text "No orders found"))

    else
        Layout.card []
            (Ui.column
                [ Ui.width Ui.fill, Ui.spacing 0 ]
                (ordersTableHeader
                    :: List.map (viewAdminOrderRow model) model.adminOrders))


ordersTableHeader : Element Msg
ordersTableHeader =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 12 10
        , Ui.spacing 12
        , Background.color (Ui.rgb 249 250 251)
        , Font.color Layout.muted
        , Font.size 12
        , Font.semiBold
        ]
        [ Ui.el [ Ui.width Ui.fill ] (Ui.text "Customer")
        , Ui.el [ Ui.width (Ui.px 110) ] (Ui.text "Total")
        , Ui.el [ Ui.width (Ui.px 140) ] (Ui.text "Date")
        , Ui.el [ Ui.width (Ui.px 90) ] (Ui.text "Status")
        ]


viewAdminOrderRow : Model -> Dict String String -> Element Msg
viewAdminOrderRow model order =
    let
        orderId = Db.unsafeGetField "id" order
        st = Db.unsafeGetField "state" order
        userName = Db.unsafeGetField "user_name" order
        userEmail = Db.unsafeGetField "user_email" order
        totalAmount = Db.unsafeGetInt "total_amount" order
        totalCurrency = Db.unsafeGetField "total_currency" order
        createdAt = Db.unsafeGetField "created_at" order
    in
        Ui.button
            [ Ui.width Ui.fill
            , Background.hoverColor (Ui.rgb 249 250 251)
            , Ui.paddingXY 12 12
            , Border.widthEach { top = 1, right = 0, bottom = 0, left = 0 }
            , Border.color Layout.hairline
            ]
            { onPress = Just (Navigate (AdminOrderPage orderId))
            , label =
                Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 12 ]
                    [ Ui.column
                        [ Ui.width Ui.fill, Ui.spacing 2 ]
                        [ Ui.el
                            [ Font.color Layout.ink, Font.size 14, Font.weight 500 ]
                            (Ui.text userName)
                        , Ui.el
                            [ Font.color (Ui.rgb 156 163 175), Font.size 12 ]
                            (Ui.text userEmail)
                        ]
                    , Ui.el
                        [ Ui.width (Ui.px 110), Font.color Layout.ink, Font.size 14, Font.weight 500 ]
                        (Ui.text (Money.formatPrice totalAmount totalCurrency))
                    , Ui.el
                        [ Ui.width (Ui.px 140), Font.color Layout.muted, Font.size 12 ]
                        (Ui.text createdAt)
                    , Ui.el
                        [ Ui.width (Ui.px 90) ]
                        (stateBadge model st)
                    ]
            }


stateBadge : Model -> String -> Element Msg
stateBadge model st =
    Layout.badge (stateBadgeFg st) (stateBadgeBg st) (Tr.tCartState model.lang st)


stateBadgeFg : String -> Ui.Color
stateBadgeFg st =
    case st of
        "ordered" ->
            Ui.rgb 30 64 175

        "shipped" ->
            Ui.rgb 91 33 182

        "delivered" ->
            Ui.rgb 21 128 61

        "cancelled" ->
            Ui.rgb 185 28 28

        "refunded" ->
            Ui.rgb 146 64 14

        "pending" ->
            Ui.rgb 161 98 7

        _ ->
            Layout.muted


stateBadgeBg : String -> Ui.Color
stateBadgeBg st =
    case st of
        "ordered" ->
            Ui.rgb 219 234 254

        "shipped" ->
            Ui.rgb 237 233 254

        "delivered" ->
            Ui.rgb 240 253 244

        "cancelled" ->
            Ui.rgb 254 242 242

        "refunded" ->
            Ui.rgb 254 243 199

        "pending" ->
            Ui.rgb 254 249 195

        _ ->
            Ui.rgb 243 244 246


-- ══════════════════════════════════════════════════════
-- ADMIN ORDER DETAIL
-- ══════════════════════════════════════════════════════
viewAdminOrder : Model -> Html.Html Msg
viewAdminOrder model =
    Ui.layout []
        (Layout.adminShell
            model
            (case model.order of
                Just order ->
                    viewAdminOrderDetail model order

                Nothing ->
                    Ui.el
                        [ Ui.width Ui.fill
                        , Ui.paddingXY 0 64
                        , Font.alignCenter
                        , Font.color (Ui.rgb 156 163 175)
                        ]
                        (Ui.text "Order not found.")))


viewAdminOrderDetail : Model -> Dict String String -> Element Msg
viewAdminOrderDetail model order =
    let
        lang = model.lang
        orderId = Db.unsafeGetField "id" order
        st = Db.unsafeGetField "state" order
        totalAmount = Db.unsafeGetInt "total_amount" order
        totalCurrency = Db.unsafeGetField "total_currency" order
        userName = Db.unsafeGetField "user_name" order
        userEmail = Db.unsafeGetField "user_email" order
        shippingName = Db.unsafeGetField "shipping_name" order
        shippingLine1 = Db.unsafeGetField "shipping_line1" order
        shippingCity = Db.unsafeGetField "shipping_city" order
        shippingCountry = Db.unsafeGetField "shipping_country" order
        shippingPostcode = Db.unsafeGetField "shipping_postcode" order
        remarks = Db.unsafeGetField "checkout_remarks" order
        createdAt = Db.unsafeGetField "created_at" order
    in
        Ui.column
            [ Ui.width Ui.fill, Ui.spacing 24 ]
            [ Ui.column
                [ Ui.spacing 8, Ui.width Ui.fill ]
                [ backLink "< Orders" AdminOrdersPage
                , Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 16 ]
                    [ Ui.el
                        [ Region.heading 1, Font.size 24, Font.bold, Font.color Layout.ink ]
                        (Ui.text (Tr.t lang "order.detail"))
                    , Ui.el [ Ui.width Ui.fill ] Ui.none
                    , stateBadge model st
                    ]
                ]
            , Ui.wrappedRow
                [ Ui.width Ui.fill, Ui.spacing 16 ]
                [ infoCard "Customer" [ userName, userEmail ]
                , infoCard "Total"
                    [ Money.formatPrice totalAmount totalCurrency, createdAt ]
                , if shippingName /= "" then
                    infoCard "Shipping"
                        [ shippingName
                        , shippingLine1 ++ ", " ++ shippingCity
                        , shippingPostcode ++ " " ++ shippingCountry
                        ]

                  else
                    Ui.none
                , if remarks /= "" then
                    infoCard "Remarks" [ remarks ]

                  else
                    Ui.none
                ]
            , Layout.card []
                (Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 12 ]
                    [ Ui.el
                        [ Font.color Layout.ink, Font.size 14, Font.semiBold ]
                        (Ui.text (Tr.t lang "admin.order.updateState"))
                    , Ui.wrappedRow
                        [ Ui.spacing 8 ]
                        (List.map (stateUpdateBtn lang orderId st) allCartStates)
                    ])
            , Layout.card []
                (Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 0 ]
                    (Ui.el
                        [ Font.color Layout.muted, Font.size 14, Font.semiBold, Ui.paddingXY 0 8 ]
                        (Ui.text "Items")
                        :: List.map viewAdminOrderItem model.orderItems))
            ]


stateUpdateBtn : String -> String -> String -> String -> Element Msg
stateUpdateBtn lang orderId currentState newState =
    if newState /= currentState && newState /= "ongoing" then
        Ui.button
            [ Background.color Layout.cardBg
            , Border.width 1
            , Border.color Layout.hairline
            , Font.color Layout.ink
            , Font.size 13
            , Border.rounded 6
            , Ui.paddingXY 12 6
            ]
            { onPress = Just (UpdateOrderState orderId newState)
            , label = Ui.text (Tr.tCartState lang newState)
            }

    else
        Ui.none


infoCard : String -> List String -> Element Msg
infoCard title lines =
    Ui.column
        [ Ui.width (Ui.px 280)
        , Ui.spacing 6
        , Background.color Layout.cardBg
        , Border.rounded 8
        , Border.width 1
        , Border.color Layout.hairline
        , Ui.padding 16
        ]
        (Ui.el
            [ Font.color Layout.muted, Font.size 12, Font.semiBold ]
            (Ui.text title)
            :: List.map
                (\line -> Ui.el [ Font.color (Ui.rgb 55 65 81), Font.size 14 ] (Ui.text line))
                lines)


viewAdminOrderItem : Dict String String -> Element Msg
viewAdminOrderItem item =
    let
        title = Db.unsafeGetField "title" item
        qty = Db.unsafeGetInt "quantity" item
        price = Db.unsafeGetInt "price_amount" item
        discount = Db.unsafeGetInt "price_discount" item
        currency = Db.unsafeGetField "price_currency" item
        effectivePrice =
            if discount > 0 then
                price - discount

            else
                price
        lineTotal = Money.formatPrice (effectivePrice * qty) currency
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 10
            , Ui.spacing 12
            , Border.widthEach { top = 1, right = 0, bottom = 0, left = 0 }
            , Border.color Layout.hairline
            ]
            [ Ui.el
                [ Ui.width Ui.fill, Font.color Layout.ink, Font.size 14, Font.weight 500 ]
                (Ui.text (title ++ "  x" ++ String.fromInt qty))
            , Ui.el
                [ Font.color Layout.ink, Font.size 14, Font.semiBold ]
                (Ui.text lineTotal)
            ]
