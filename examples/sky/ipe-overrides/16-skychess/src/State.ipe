module State exposing (..)

import Ipe.Maybe exposing (..)
import Ipe.Dict as Dict
import Ipe.Error as Error exposing (Error)
import Chess.Piece exposing (..)


-- A Web-shape Model is persisted to the session store between requests, so
-- it holds plain data only — the board is a `Dict Int Piece`, saved games
-- are `Dict String String` rows, never the opaque `Db` handle (IPE-L0120).
-- Every database-derived field here is settled data that an effect
-- delivered through a response `Msg`.
type alias Model =
    { page : Page
    , playerName : String
    , nameInput : String
    , gameId : String
    , board : Dict Int Piece
    , turn : Colour
    , selectedSquare : Int
    , legalMoves : List Int
    , moveHistory : List String
    , gameStatus : String
    , computerThinking : Bool
    , lastMoveFrom : Int
    , lastMoveTo : Int
    , capturedByWhite : List String
    , capturedByBlack : List String
    , whiteKingMoved : Bool
    , blackKingMoved : Bool
    , whiteRookAMoved : Bool
    , whiteRookHMoved : Bool
    , blackRookAMoved : Bool
    , blackRookHMoved : Bool
    , enPassantSquare : Int
    , halfMoveClock : Int
    , fullMoveNumber : Int
    , savedGames : List (Dict String String)
    , notification : String
    , errorMessage : String
    }

type Page
    = HomePage
    | GamePage
    | NotFoundPage


-- The load-game effect settles as the game's info row (found / not-found)
-- plus its move rows, folded together so one response `Msg` populates the
-- replayed board and history in a single tick.
type alias GameLoadData =
    { info : Maybe (Dict String String)
    , moves : List (Dict String String)
    }


type Msg
    = Navigate Page
    | UpdateNameInput String
    | StartNewGame
    | LoadGame String
    | ClickSquare Int
    | ComputerMove
    | Resign
    | BackToHome
    | Tick
    | DeleteGame String
    | GamesLoaded (Result Error (List (Dict String String)))
    | GameCreated (Result Error String)
    | GameLoaded (Result Error GameLoadData)
    | GameDeleted (Result Error ())
    | MoveSaved (Result Error ())
    | StatusSaved (Result Error ())
