module Lib.Games exposing
    ( createGame
    , saveMove
    , updateGameStatus
    , getGames
    , getGameMoves
    , getGame
    , deleteGame
    , field
    )

import Ipe.Maybe as Maybe
import Ipe.List as List
import Ipe.String as String
import Ipe.Crypto as Crypto
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Error as Error exposing (Error)
import Lib.Db as LibDb


-- Every database operation is a `Task Error a`; there is no synchronous
-- force. Each opens its own pooled connection through `LibDb.withConn`
-- (acquire-per-effect), so the connection never escapes into the
-- session-persisted Model. Callers dispatch these as commands via
-- `Task.attempt` and fold the settled `Result` into the Model in a
-- dedicated `update` branch. Every user-supplied value is bound as a `?`
-- parameter — never string-interpolated into the SQL — so no input can
-- carry an injection.


-- createGame : Task Error String — yields the new gameId. The id is
-- derived from the player name and the current game count so repeated new
-- games for the same player produce distinct ids; the count read and the
-- insert run on the same acquired connection.
createGame : String -> Task Error String
createGame playerName =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT id FROM games WHERE player_name = ? ORDER BY created_at DESC LIMIT 20"
                [ playerName ]
                |> Task.andThen
                    (\existing ->
                        let
                            count = String.fromInt (List.length existing)
                            gameId =
                                String.slice
                                    0
                                    12
                                    (Crypto.sha256
                                        (playerName ++ ":game:" ++ count))
                        in
                            Db.exec
                                conn
                                "INSERT INTO games (id, player_name, status, result, move_count) VALUES (?, ?, 'playing', '', 0)"
                                [ gameId, playerName ]
                                |> Task.map (\_ -> gameId)
                    )
        )


-- saveMove : Task Error () — writes the move row and updates the game's
-- move count. Both writes run on the same acquired connection.
saveMove : String -> Int -> Int -> Int -> String -> String -> Task Error ()
saveMove gameId moveNum from to algebraic colour =
    LibDb.withConn
        (\conn ->
            Db.exec
                conn
                "INSERT INTO moves (game_id, move_number, from_square, to_square, algebraic, colour) VALUES (?, ?, ?, ?, ?, ?)"
                [ gameId
                , String.fromInt moveNum
                , String.fromInt from
                , String.fromInt to
                , algebraic
                , colour
                ]
                |> Task.andThen
                    (\_ ->
                        Db.exec
                            conn
                            "UPDATE games SET move_count = ?, updated_at = datetime('now') WHERE id = ?"
                            [ String.fromInt moveNum, gameId ])
                |> Task.map (\_ -> ())
        )


updateGameStatus : String -> String -> String -> Task Error ()
updateGameStatus gameId status result =
    LibDb.withConn
        (\conn ->
            Db.exec
                conn
                "UPDATE games SET status = ?, result = ?, updated_at = datetime('now') WHERE id = ?"
                [ status, result, gameId ]
                |> Task.map (\_ -> ())
        )


getGames : String -> Task Error (List (Dict String String))
getGames playerName =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT * FROM games WHERE player_name = ? ORDER BY created_at DESC LIMIT 20"
                [ playerName ])


getGameMoves : String -> Task Error (List (Dict String String))
getGameMoves gameId =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT * FROM moves WHERE game_id = ? ORDER BY move_number ASC"
                [ gameId ])


-- getGame : Task Error (Maybe Row). The outer Task carries an infra
-- failure; the inner Maybe is found / not-found, which is normal.
getGame : String -> Task Error (Maybe (Dict String String))
getGame gameId =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT * FROM games WHERE id = ? LIMIT 1"
                [ gameId ])
        |> Task.map List.head


-- Deleting a game removes its moves first, then the game row, both on the
-- same acquired connection.
deleteGame : String -> Task Error ()
deleteGame gameId =
    LibDb.withConn
        (\conn ->
            Db.exec conn "DELETE FROM moves WHERE game_id = ?" [ gameId ]
                |> Task.andThen
                    (\_ ->
                        Db.exec
                            conn
                            "DELETE FROM games WHERE id = ?"
                            [ gameId ])
                |> Task.map (\_ -> ())
        )


-- Read a string column from a row already loaded into the Model.
field : String -> Dict String String -> String
field key row =
    LibDb.field key row
