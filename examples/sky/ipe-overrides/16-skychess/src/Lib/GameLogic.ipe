module Lib.GameLogic exposing (executeWhiteMove, executeBlackMove, finishGame)

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.Tea.Web.Cmd as Cmd
import Chess.Board as Board
import Chess.Piece exposing (..)
import Chess.Move as Move
import Chess.Ai as Ai
import Lib.Games as Games
import State exposing (..)
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))


-- The board transition is pure: apply the move, update the model
-- synchronously, and decide the resulting game state in the same tick. The
-- persistence is a separate `Task Error ()` dispatched as a command
-- (`Task.attempt MoveSaved`) — a durable write must not force the render
-- to wait, and a persistence failure is surfaced by the `MoveSaved` update
-- branch, never swallowed. `Cmd.batch` lets a move that also ends the game
-- persist both the move row and the finished status.
executeWhiteMove : Int -> Int -> Model -> ( Model, Cmd Msg )
executeWhiteMove from to model =
    let
        algebraic = Move.moveToAlgebraic from to model.board model
        result = Move.applyMove from to model.board model
        newBoard = fst result
        captured = snd result
    in
        executeWhitePart2 from to algebraic newBoard captured model


executeWhitePart2 : Int -> Int -> String -> Dict Int Piece -> Maybe String -> Model -> ( Model, Cmd Msg )
executeWhitePart2 from to algebraic newBoard captured model =
    let
        newEp = Move.newEnPassantSquare from to model.board
        moveNum = List.length model.moveHistory + 1
        saveCmd =
            Task.attempt
                MoveSaved
                (Games.saveMove model.gameId moveNum from to algebraic "White")
        newCaptured = appendCaptured captured model.capturedByWhite
        newHistory = model.moveHistory ++ [ algebraic ]
    in
        buildWhiteUpdate from to newBoard newEp newCaptured newHistory saveCmd model


buildWhiteUpdate : Int -> Int -> Dict Int Piece -> Int -> List String -> List String -> Cmd Msg -> Model -> ( Model, Cmd Msg )
buildWhiteUpdate from to newBoard newEp newCaptured newHistory saveCmd model =
    afterWhiteMove
        saveCmd
        { model | board = newBoard
        , selectedSquare = -1
        , legalMoves = []
        , lastMoveFrom = from
        , lastMoveTo = to
        , moveHistory = newHistory
        , capturedByWhite = newCaptured
        , enPassantSquare = newEp
        , whiteKingMoved = model.whiteKingMoved || from == 60
        , blackKingMoved = model.blackKingMoved || from == 4
        , whiteRookAMoved = model.whiteRookAMoved || from == 56
        , whiteRookHMoved = model.whiteRookHMoved || from == 63
        , blackRookAMoved = model.blackRookAMoved || from == 0
        , blackRookHMoved = model.blackRookHMoved || from == 7
        }


afterWhiteMove : Cmd Msg -> Model -> ( Model, Cmd Msg )
afterWhiteMove saveCmd updated =
    let
        blackCanMove = Move.hasLegalMoves Black updated.board updated
        blackInCheck = Move.isInCheck Black updated.board
    in
        resolveAfterWhite saveCmd updated blackCanMove blackInCheck


resolveAfterWhite : Cmd Msg -> Model -> Bool -> Bool -> ( Model, Cmd Msg )
resolveAfterWhite saveCmd updated blackCanMove blackInCheck =
    if not blackCanMove && blackInCheck then
        finishGameWith saveCmd "checkmate-white" updated

    else if not blackCanMove then
        finishGameWith saveCmd "stalemate" updated

    else
        ( { updated | turn = Black, computerThinking = True }, saveCmd )


executeBlackMove : Model -> ( Model, Cmd Msg )
executeBlackMove model =
    let
        movePair = Ai.bestMove model.board model
        from = fst movePair
        to = snd movePair
        pieces = Board.allPiecesOfColour Black model.board
        _ =
            Io.println
                ("[AI] Black pieces: " ++ String.fromInt (List.length pieces))
        allMoves = Move.allLegalMoves Black model.board model
        _ =
            Io.println
                ("[AI] Legal moves: " ++ String.fromInt (List.length allMoves))
        _ =
            Io.println
                ("[AI] Best: " ++ String.fromInt from ++ "->"
                    ++ String.fromInt to)
        _ =
            Io.println
                ("[AI] First 10: "
                    ++ String.join
                           " "
                           (List.map
                               (\m ->
                                   String.fromInt (fst m) ++ "->"
                                       ++ String.fromInt (snd m))
                               (List.take 10 allMoves)))
    in
        applyBlackOr from to model


applyBlackOr : Int -> Int -> Model -> ( Model, Cmd Msg )
applyBlackOr from to model =
    if from < 0 then
        ( { model | computerThinking = False }, Cmd.none )

    else
        doBlackMove from to model


doBlackMove : Int -> Int -> Model -> ( Model, Cmd Msg )
doBlackMove from to model =
    let
        algebraic = Move.moveToAlgebraic from to model.board model
        result = Move.applyMove from to model.board model
        newBoard = fst result
        captured = snd result
    in
        doBlackPart2 from to algebraic newBoard captured model


doBlackPart2 : Int -> Int -> String -> Dict Int Piece -> Maybe String -> Model -> ( Model, Cmd Msg )
doBlackPart2 from to algebraic newBoard captured model =
    let
        newEp = Move.newEnPassantSquare from to model.board
        moveNum = List.length model.moveHistory + 1
        saveCmd =
            Task.attempt
                MoveSaved
                (Games.saveMove model.gameId moveNum from to algebraic "Black")
        newCaptured = appendCaptured captured model.capturedByBlack
        newHistory = model.moveHistory ++ [ algebraic ]
    in
        buildBlackUpdate from to newBoard newEp newCaptured newHistory saveCmd model


buildBlackUpdate : Int -> Int -> Dict Int Piece -> Int -> List String -> List String -> Cmd Msg -> Model -> ( Model, Cmd Msg )
buildBlackUpdate from to newBoard newEp newCaptured newHistory saveCmd model =
    afterBlackMove
        saveCmd
        { model | board = newBoard
        , computerThinking = False
        , lastMoveFrom = from
        , lastMoveTo = to
        , moveHistory = newHistory
        , capturedByBlack = newCaptured
        , enPassantSquare = newEp
        , whiteKingMoved = model.whiteKingMoved || from == 60
        , blackKingMoved = model.blackKingMoved || from == 4
        , whiteRookAMoved = model.whiteRookAMoved || from == 56
        , whiteRookHMoved = model.whiteRookHMoved || from == 63
        , blackRookAMoved = model.blackRookAMoved || from == 0
        , blackRookHMoved = model.blackRookHMoved || from == 7
        }


afterBlackMove : Cmd Msg -> Model -> ( Model, Cmd Msg )
afterBlackMove saveCmd updated =
    let
        whiteCanMove = Move.hasLegalMoves White updated.board updated
        whiteInCheck = Move.isInCheck White updated.board
    in
        resolveAfterBlack saveCmd updated whiteCanMove whiteInCheck


resolveAfterBlack : Cmd Msg -> Model -> Bool -> Bool -> ( Model, Cmd Msg )
resolveAfterBlack saveCmd updated whiteCanMove whiteInCheck =
    if not whiteCanMove && whiteInCheck then
        finishGameWith saveCmd "checkmate-black" updated

    else if not whiteCanMove then
        finishGameWith saveCmd "stalemate" updated

    else
        ( { updated | turn = White }, saveCmd )


-- Persist the finished status alongside the just-made move. Both writes are
-- fire-and-forget commands whose failures surface through their response
-- branches.
finishGameWith : Cmd Msg -> String -> Model -> ( Model, Cmd Msg )
finishGameWith saveCmd result model =
    ( { model | gameStatus = result }
    , Cmd.batch [ saveCmd, persistStatus model.gameId result ]
    )


-- Persist a game-ending status when it is reached outside a move (a
-- resignation). Dispatched as a command; the `StatusSaved` branch reports
-- a failure.
finishGame : String -> Model -> ( Model, Cmd Msg )
finishGame result model =
    ( { model | gameStatus = result }, persistStatus model.gameId result )


persistStatus : String -> String -> Cmd Msg
persistStatus gameId result =
    Task.attempt StatusSaved (Games.updateGameStatus gameId "finished" result)


appendCaptured : Maybe String -> List String -> List String
appendCaptured captured existing =
    case captured of

        Just sym ->
            existing ++ [ sym ]

        Nothing ->
            existing
