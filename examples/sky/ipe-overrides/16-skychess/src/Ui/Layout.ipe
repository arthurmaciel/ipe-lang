module Ui.Layout exposing (page)

import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onClick)
import State exposing (..)
import Ui.Styles exposing (globalStyles)


page model content =
    div
        []
        [ styleNode [] globalStyles
        , viewHeader model
        , div [ class "container" ] [ content ]
        ]


viewHeader model =
    headerNode
        [ class "header" ]
        [ div
              [ class "header-inner" ]
              [ a
                    [ href "/", attribute "ipe-nav" "", class "logo" ]
                    [ text "♞ SkyChess" ]
              , nav [ class "nav" ] [ viewNavItems model ]
              ]
        ]


-- Every `Page` constructor is enumerated explicitly; only the in-game page
-- shows the player badge and the home button. A catch-all over a closed
-- union is rejected (IPE-T0018), so adding a page forces a choice here.
viewNavItems model =
    case model.page of

        GamePage ->
            span
                [ class "nav-info" ]
                [ span [ class "nav-player" ] [ text model.playerName ]
                , button
                      [ onClick BackToHome, class "btn btn-ghost btn-sm" ]
                      [ text "Home" ]
                ]

        HomePage ->
            text ""

        NotFoundPage ->
            text ""
