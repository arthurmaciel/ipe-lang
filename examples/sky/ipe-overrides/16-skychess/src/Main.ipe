module Main exposing (main)

-- examples/16-skychess — chess against a minimax AI, TEA rearchitecture.
--
-- White plays a human; Black is a 2-ply minimax opponent. Games and their
-- moves are persisted to SQLite so a game can be reloaded and replayed. The
-- upstream forces every database read/write with `Task.run` — a
-- module-level synchronous `dbConn` plus synchronous `exec`/`query`
-- wrappers in `Lib/Games`, consumed mid-`update`. `Task.run` is removed
-- from the Ipê surface (IPE-N0036) and Ipê TEA has no synchronous force, so
-- this is a whole-example rearchitecture, hosted here as an
-- `ipe-overrides/` tree (the same mechanism as `13-skyshop`, `12-skyvote`,
-- and `27-multi-session-chat`).
--
-- EFFECT MODEL. Every database read/write is a `Task Error a`; there is no
-- synchronous force. A Web-shape `Model` is persisted to the session store
-- between requests, so it holds plain data only — never the opaque `Db`
-- handle (IPE-L0120). Each database effect opens its own pooled connection
-- inside its Task chain (`Db.connect |> ensureSchema |> op`, via
-- `Lib.Db.withConn`), and only the settled DATA reaches the Model through a
-- response `Msg`. The board transition is pure and applied synchronously;
-- the move's durable write is a separate fire-and-forget command whose
-- failure surfaces through its response branch.

import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Io as Io
import Ipe.Ui as Ui
import Ipe.Task as Task
import Ipe.Tea.Web exposing (app, route)
import Ipe.Html.Events exposing (onClick)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Time as Time
import State exposing (..)
import Lib.Games as Games
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
import Lib.GameLogic as Logic
import Chess.Board as Board
import Chess.Piece exposing (..)
import Chess.Move as Move
import Page.Home as Home
import Page.Game as Game
import Ui.Layout as Layout


main =
    app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ route "/" HomePage, route "/game" GamePage ]
        , notFound = NotFoundPage
        }


-- | `init` runs once per new session. The schema is ensured lazily by the
-- first database effect (each `Lib.Db.withConn` runs `ensureSchema` after
-- `Db.connect`), so `init` starts from an empty model with no synchronous
-- database force.
init : a -> ( Model, Cmd Msg )
init _req =
    ( emptyModel, Cmd.none )


emptyModel : Model
emptyModel =
    { page = HomePage
    , playerName = ""
    , nameInput = ""
    , gameId = ""
    , board = Dict.empty
    , turn = White
    , selectedSquare = -1
    , legalMoves = []
    , moveHistory = []
    , gameStatus = "playing"
    , computerThinking = False
    , lastMoveFrom = -1
    , lastMoveTo = -1
    , capturedByWhite = []
    , capturedByBlack = []
    , whiteKingMoved = False
    , blackKingMoved = False
    , whiteRookAMoved = False
    , whiteRookHMoved = False
    , blackRookAMoved = False
    , blackRookHMoved = False
    , enPassantSquare = -1
    , halfMoveClock = 0
    , fullMoveNumber = 1
    , savedGames = []
    , notification = ""
    , errorMessage = ""
    }


view : Model -> Ui.Element Msg
view model =
    Ui.html (viewPage model)


viewPage : Model -> Html Msg
viewPage model =
    case model.page of

        HomePage ->
            Home.viewHome model

        GamePage ->
            Game.viewGame model

        NotFoundPage ->
            Home.viewHome model


-- Only subscribe to the AI tick when it is actually the AI's turn and the
-- game is live, so the AI never burns dispatch cycles on the human's turn,
-- while the game is finished, or on the home page. Every `Page` constructor
-- is reachable through the guard's `model.page == GamePage` test.
subscriptions : Model -> Sub.Sub Msg
subscriptions model =
    if model.page == GamePage && model.turn == Black && model.gameStatus
        == "playing" then
        Time.every 500 ComputerMove

    else
        Sub.none


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigate page ->
            ( { model | page = page, notification = "" }, Cmd.none )

        UpdateNameInput s ->
            ( { model | nameInput = s, playerName = s }
            , Task.attempt GamesLoaded (Games.getGames s)
            )

        StartNewGame ->
            handleStartNewGame model

        LoadGame gameId ->
            ( { model | gameId = gameId }, loadGameCmd gameId )

        ClickSquare sq ->
            handleClickSquare sq model

        ComputerMove ->
            handleComputerMove model

        Resign ->
            handleResign model

        BackToHome ->
            handleBackToHome model

        Tick ->
            ( model, Cmd.none )

        DeleteGame gameId ->
            ( model, Task.attempt GameDeleted (Games.deleteGame gameId) )

        -- ── Async responses ─────────────────────────────────────────
        GamesLoaded (Ok games) ->
            ( { model | savedGames = games, notification = "" }, Cmd.none )

        GamesLoaded (Err e) ->
            let
                _ =
                    Io.println
                        ("[CHESS ERROR] getGames: " ++ Error.toString e)
            in
                ( { model | notification = Error.toString e }, Cmd.none )

        GameCreated (Ok gameId) ->
            ( startedGameModel model.playerName gameId model, Cmd.none )

        GameCreated (Err e) ->
            let
                _ =
                    Io.println
                        ("[CHESS ERROR] createGame: " ++ Error.toString e)
            in
                ( { model | errorMessage = Error.toString e
                  , notification = Error.toString e
                  }
                , Cmd.none
                )

        GameLoaded (Ok data) ->
            ( loadedGameModel model.gameId data model, Cmd.none )

        GameLoaded (Err e) ->
            let
                _ =
                    Io.println
                        ("[CHESS ERROR] loadGame: " ++ Error.toString e)
            in
                ( { model | notification = Error.toString e }, Cmd.none )

        GameDeleted (Ok _) ->
            ( model, Task.attempt GamesLoaded (Games.getGames model.playerName) )

        GameDeleted (Err e) ->
            let
                _ =
                    Io.println
                        ("[CHESS ERROR] deleteGame: " ++ Error.toString e)
            in
                ( { model | notification = Error.toString e }, Cmd.none )

        MoveSaved (Ok _) ->
            ( model, Cmd.none )

        MoveSaved (Err e) ->
            let
                _ =
                    Io.println
                        ("[CHESS][persist-fail] saveMove: " ++ Error.toString e)
            in
                ( { model | notification = Error.toString e }, Cmd.none )

        StatusSaved (Ok _) ->
            ( model, Cmd.none )

        StatusSaved (Err e) ->
            let
                _ =
                    Io.println
                        ("[CHESS][persist-fail] updateGameStatus: "
                            ++ Error.toString e)
            in
                ( { model | notification = Error.toString e }, Cmd.none )


handleStartNewGame : Model -> ( Model, Cmd Msg )
handleStartNewGame model =
    let
        name =
            if model.nameInput == "" then
                model.playerName

            else
                model.nameInput
    in
        if name == "" then
            ( { model | errorMessage = "Please enter your name" }, Cmd.none )

        else
            ( { model | playerName = name }
            , Task.attempt GameCreated (Games.createGame name)
            )


-- Build the model for a freshly created game (was `startGameWithNameOk`).
startedGameModel : String -> String -> Model -> Model
startedGameModel name gameId model =
    { model | page = GamePage
    , playerName = name
    , gameId = gameId
    , board = Board.initialBoard
    , turn = White
    , selectedSquare = -1
    , legalMoves = []
    , moveHistory = []
    , gameStatus = "playing"
    , computerThinking = False
    , lastMoveFrom = -1
    , lastMoveTo = -1
    , capturedByWhite = []
    , capturedByBlack = []
    , whiteKingMoved = False
    , blackKingMoved = False
    , whiteRookAMoved = False
    , whiteRookHMoved = False
    , blackRookAMoved = False
    , blackRookHMoved = False
    , enPassantSquare = -1
    , halfMoveClock = 0
    , fullMoveNumber = 1
    , notification = ""
    , errorMessage = ""
    }


-- The load-game effect composes the game-info read and its moves read into
-- one Task, so both settle together under a single `GameLoaded` response.
-- The game id is stored on the Model by `LoadGame` before this runs, so the
-- response tag carries only the settled data.
loadGameCmd : String -> Cmd Msg
loadGameCmd gameId =
    Task.attempt
        GameLoaded
        (Task.map2
            (\info moves -> { info = info, moves = moves })
            (Games.getGame gameId)
            (Games.getGameMoves gameId))


-- Build the model for a loaded game by replaying its moves onto the initial
-- board (was `handleLoadGame`, minus the synchronous DB reads that are now
-- delivered in `data`).
loadedGameModel : String -> GameLoadData -> Model -> Model
loadedGameModel gameId data model =
    let
        playerName =
            case data.info of

                Just g ->
                    Games.field "player_name" g

                Nothing ->
                    model.playerName
        result = replayMoves data.moves Board.initialBoard
        board = fst result
        history = snd result
        moveCount = List.length history
        turn =
            if modBy 2 moveCount == 0 then
                White

            else
                Black
        status =
            case data.info of

                Just g ->
                    let
                        s = Games.field "status" g
                        r = Games.field "result" g
                    in
                        if s == "finished" then
                            r

                        else
                            "playing"

                Nothing ->
                    "playing"
    in
        { model | page = GamePage
        , playerName = playerName
        , gameId = gameId
        , board = board
        , turn = turn
        , selectedSquare = -1
        , legalMoves = []
        , moveHistory = history
        , gameStatus = status
        , computerThinking = False
        , lastMoveFrom = -1
        , lastMoveTo = -1
        , notification = ""
        , errorMessage = ""
        }


replayMoves : List (Dict String String) -> Dict Int Piece -> ( Dict Int Piece, List String )
replayMoves moves board =
    replayMovesLoop moves board []


replayMovesLoop : List (Dict String String) -> Dict Int Piece -> List String -> ( Dict Int Piece, List String )
replayMovesLoop moves board history =
    case moves of

        [] ->
            ( board, history )

        move :: rest ->
            let
                fromStr = Games.field "from_square" move
                toStr = Games.field "to_square" move
                algebraic = Games.field "algebraic" move
            in
                case String.toInt fromStr of

                    Just from ->
                        case String.toInt toStr of

                            Just to ->
                                let
                                    newBoard = Board.movePiece from to board
                                in
                                    replayMovesLoop
                                        rest
                                        newBoard
                                        (history ++ [ algebraic ])

                            Nothing ->
                                let
                                    _ =
                                        Io.println
                                            ("[REPLAY ERROR] bad to_square: "
                                                ++ toStr)
                                in
                                    replayMovesLoop rest board history

                    Nothing ->
                        let
                            _ =
                                Io.println
                                    ("[REPLAY ERROR] bad from_square: "
                                        ++ fromStr)
                        in
                            replayMovesLoop rest board history


handleClickSquare : Int -> Model -> ( Model, Cmd Msg )
handleClickSquare sq model =
    if model.gameStatus /= "playing" then
        ( model, Cmd.none )

    else if model.turn /= White then
        ( model, Cmd.none )

    else if model.selectedSquare == -1 then
        trySelectPiece sq model

    else if sq == model.selectedSquare then
        ( { model | selectedSquare = -1, legalMoves = [] }, Cmd.none )

    else if List.member sq model.legalMoves then
        Logic.executeWhiteMove model.selectedSquare sq model

    else
        trySelectPiece sq model


trySelectPiece : Int -> Model -> ( Model, Cmd Msg )
trySelectPiece sq model =
    case Dict.get sq model.board of

        Just piece ->
            selectIfWhite sq piece model

        Nothing ->
            ( model, Cmd.none )


selectIfWhite : Int -> Piece -> Model -> ( Model, Cmd Msg )
selectIfWhite sq piece model =
    if piece.colour == White then
        let
            moves = Move.legalMovesForSquare sq White model.board model
        in
            ( { model | selectedSquare = sq, legalMoves = moves }, Cmd.none )

    else
        ( model, Cmd.none )


handleComputerMove : Model -> ( Model, Cmd Msg )
handleComputerMove model =
    if model.turn /= Black then
        ( { model | computerThinking = False }, Cmd.none )

    else if model.gameStatus /= "playing" then
        ( { model | computerThinking = False }, Cmd.none )

    else
        Logic.executeBlackMove model


handleResign : Model -> ( Model, Cmd Msg )
handleResign model =
    Logic.finishGame "resigned" model


handleBackToHome : Model -> ( Model, Cmd Msg )
handleBackToHome model =
    ( { model | page = HomePage
      , selectedSquare = -1
      , legalMoves = []
      , notification = ""
      }
    , Task.attempt GamesLoaded (Games.getGames model.playerName)
    )
