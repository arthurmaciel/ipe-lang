module Ui.Layout exposing (page)

import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onClick)
import State exposing (..)
import Ui.Styles exposing (globalStyles)


page : Model -> Html Msg -> Html Msg
page model content =
    div
        []
        [ styleNode [] globalStyles
        , viewHeader model
        , div [ class "app" ] [ viewNotification model, content ]
        ]


viewNotification : Model -> Html Msg
viewNotification model =
    if model.notification == "" then
        text ""

    else
        div [ class "notification" ] [ text model.notification ]


viewHeader : Model -> Html Msg
viewHeader model =
    headerNode
        [ class "header" ]
        [ div
              [ class "header-inner" ]
              [ a
                    [ href "/", attribute "ipe-nav" "", class "logo" ]
                    [ text "☀ SkyMon" ]
              , nav
                    [ class "nav" ]
                    [ a
                          [ href "/", attribute "ipe-nav" "", class "nav-link" ]
                          [ text "Dashboard" ]
                    , a
                          [ href "/status"
                          , attribute "ipe-nav" ""
                          , class "nav-link"
                          ]
                          [ text "Status" ]
                    , viewSettingsLink model
                    , viewAlertsLink model
                    , viewAuthNav model
                    ]
              ]
        ]


-- Settings is admin-only. Every branch of `model.session` and the admin
-- guard is enumerated (IPE-T0018) so an anonymous or non-admin visitor sees
-- nothing here.
viewSettingsLink : Model -> Html Msg
viewSettingsLink model =
    case model.session of

        Just session ->
            if session.role == Admin then
                a
                    [ href "/settings"
                    , attribute "ipe-nav" ""
                    , class "nav-link"
                    ]
                    [ text "Settings" ]

            else
                text ""

        Nothing ->
            text ""


viewAlertsLink : Model -> Html Msg
viewAlertsLink model =
    case model.session of

        Just _ ->
            a
                [ href "/alerts", attribute "ipe-nav" "", class "nav-link" ]
                [ text "Alerts" ]

        Nothing ->
            text ""


viewAuthNav : Model -> Html Msg
viewAuthNav model =
    case model.session of

        Just session ->
            div
                [ class "user-info" ]
                [ span [] [ text session.username ]
                , viewRoleBadge session.role
                , button
                      [ onClick SignOut, class "btn btn-ghost btn-sm" ]
                      [ text "Sign Out" ]
                ]

        Nothing ->
            a
                [ href "/auth", attribute "ipe-nav" "", class "nav-link" ]
                [ text "Sign In" ]


viewRoleBadge : Role -> Html Msg
viewRoleBadge role =
    case role of

        Admin ->
            span [ class "badge badge-admin" ] [ text "admin" ]

        User ->
            span [ class "badge badge-user" ] [ text "user" ]

        Public ->
            text ""
