module Lib.Monitors exposing
    ( createMonitor
    , deleteMonitor
    , getMonitors
    , getMonitorHistory
    , checkAndRecord
    )

import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Http as Http
import Ipe.Task as Task
import Ipe.Crypto as Crypto
import Ipe.Db as Db
import Lib.Db as LibDb
import Ipe.Error as Error exposing (Error)


-- Every database operation is a `Task Error a`; there is no synchronous
-- force. Each opens its own pooled connection through `LibDb.withConn`
-- (acquire-per-effect), so the connection never escapes into the
-- session-persisted Model. Every user-supplied value reaches SQL as a bound
-- `?` parameter — never string-interpolated — so no name or URL can carry
-- an injection.


createMonitor : String -> String -> Int -> String -> Task Error String
createMonitor name url interval visibility =
    let
        monId = String.slice 0 12 (Crypto.sha256 (name ++ ":" ++ url))
    in
        LibDb.withConn
            (\conn ->
                Db.exec
                    conn
                    "INSERT OR REPLACE INTO monitors (id, name, url, interval_secs, visibility) VALUES (?, ?, ?, ?, ?)"
                    [ monId, name, url, String.fromInt interval, visibility ]
                    |> Task.map (\_ -> monId)
            )


-- Deleting a monitor removes its history first, then the monitor row, both
-- on the same acquired connection.
deleteMonitor : String -> Task Error ()
deleteMonitor monId =
    LibDb.withConn
        (\conn ->
            Db.exec
                conn
                "DELETE FROM monitor_history WHERE monitor_id = ?"
                [ monId ]
                |> Task.andThen
                    (\_ ->
                        Db.exec
                            conn
                            "DELETE FROM monitors WHERE id = ?"
                            [ monId ])
                |> Task.map (\_ -> ())
        )


getMonitors : Task Error (List (Dict String String))
getMonitors =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT * FROM monitors ORDER BY name"
                [])


getMonitorHistory : String -> Int -> Task Error (List (Dict String String))
getMonitorHistory monId limit =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT status, response_time, checked_at FROM monitor_history WHERE monitor_id = ? ORDER BY checked_at DESC LIMIT ?"
                [ monId, String.fromInt limit ])


-- Probe the monitor's endpoint over HTTP, classify the outcome into a
-- status string, then record it on the monitor row and in its history — all
-- as one Task. A transport failure classifies as "down" rather than
-- surfacing as an error, mirroring the upstream's fail-to-down behaviour.
checkAndRecord : Dict String String -> Task Error ()
checkAndRecord monitor =
    let
        monId = LibDb.field "id" monitor
        url = LibDb.field "url" monitor
    in
        Http.get url
            |> Task.map classifyResponse
            |> Task.onError (\_ -> Task.succeed "down")
            |> Task.andThen (\status -> recordCheck monId status 0)


classifyResponse resp =
    if resp.status >= 200 && resp.status < 400 then
        "healthy"

    else if resp.status >= 400 && resp.status < 500 then
        "degraded"

    else
        "down"


recordCheck : String -> String -> Int -> Task Error ()
recordCheck monId status responseTime =
    LibDb.withConn
        (\conn ->
            Db.exec
                conn
                "UPDATE monitors SET status = ?, response_time = ?, last_checked = datetime('now') WHERE id = ?"
                [ status, String.fromInt responseTime, monId ]
                |> Task.andThen
                    (\_ ->
                        Db.exec
                            conn
                            "INSERT INTO monitor_history (monitor_id, status, response_time) VALUES (?, ?, ?)"
                            [ monId, status, String.fromInt responseTime ])
                |> Task.map (\_ -> ())
        )
