module Lib.Alerts exposing
    ( createAlert
    , deleteAlert
    , getAlerts
    , getAlertHistory
    , getAlertHistoryForMetric
    , checkAlerts
    )

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Http as Http
import Ipe.Task as Task
import Ipe.Crypto as Crypto
import Ipe.Db as Db
import Ipe.Io as Io
import Lib.Db as LibDb
import Ipe.Error as Error exposing (Error)


-- Every database operation is a `Task Error a`; each opens its own pooled
-- connection through `LibDb.withConn`. Every user-supplied value reaches SQL
-- as a bound `?` parameter.


createAlert : String -> String -> String -> String -> String -> Task Error String
createAlert metricId condition threshold notifyType notifyTarget =
    let
        alertId =
            String.slice
                0
                12
                (Crypto.sha256 (metricId ++ ":" ++ condition ++ ":" ++ threshold))
    in
        LibDb.withConn
            (\conn ->
                Db.exec
                    conn
                    "INSERT OR REPLACE INTO alerts (id, metric_id, condition, threshold, notify_type, notify_target) VALUES (?, ?, ?, ?, ?, ?)"
                    [ alertId, metricId, condition, threshold, notifyType, notifyTarget ]
                    |> Task.map (\_ -> alertId)
            )


deleteAlert : String -> Task Error ()
deleteAlert alertId =
    LibDb.withConn
        (\conn ->
            Db.exec conn "DELETE FROM alerts WHERE id = ?" [ alertId ]
                |> Task.map (\_ -> ())
        )


getAlerts : Task Error (List (Dict String String))
getAlerts =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT * FROM alerts ORDER BY created_at DESC"
                [])


getAlertHistory : Int -> Task Error (List (Dict String String))
getAlertHistory limit =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT * FROM alert_history ORDER BY fired_at DESC LIMIT ?"
                [ String.fromInt limit ])


getAlertHistoryForMetric : String -> Int -> Task Error (List (Dict String String))
getAlertHistoryForMetric metricId limit =
    LibDb.withConn
        (\conn ->
            Db.unsafeQuery
                conn
                "SELECT * FROM alert_history WHERE metric_id = ? ORDER BY fired_at DESC LIMIT ?"
                [ metricId, String.fromInt limit ])


-- ══════════════════════════════════════════════════════
-- ALERT EVALUATION
-- ══════════════════════════════════════════════════════
-- Check every alert against the current metric values, firing (record +
-- notify) those whose condition is triggered. Each alert's fire is a Task,
-- and the whole batch is folded into one Task with `Task.andThen`, so the
-- collector's tick runs them in sequence and surfaces the first failure.
checkAlerts : List (Dict String String) -> List (Dict String String) -> Task Error ()
checkAlerts alerts metrics =
    case alerts of

        [] ->
            Task.succeed ()

        alert :: rest ->
            checkOneAlert alert metrics
                |> Task.andThen (\_ -> checkAlerts rest metrics)


checkOneAlert : Dict String String -> List (Dict String String) -> Task Error ()
checkOneAlert alert metrics =
    let
        metricId = LibDb.field "metric_id" alert
        condition = LibDb.field "condition" alert
        threshold = LibDb.field "threshold" alert
        enabled = LibDb.field "enabled" alert
    in
        if enabled /= "1" then
            Task.succeed ()

        else
            case findMetricById metricId metrics of

                Nothing ->
                    Task.succeed ()

                Just metric ->
                    let
                        value = LibDb.field "last_value" metric
                    in
                        if evaluateCondition value condition threshold then
                            fireAlert alert value

                        else
                            Task.succeed ()


evaluateCondition : String -> String -> String -> Bool
evaluateCondition valueStr condition thresholdStr =
    let
        value = parseFloat valueStr
        threshold = parseFloat thresholdStr
    in
        if condition == ">" then
            value > threshold

        else if condition == "<" then
            value < threshold

        else if condition == ">=" then
            value >= threshold

        else if condition == "<=" then
            value <= threshold

        else if condition == "==" then
            value == threshold

        else if condition == "!=" then
            value /= threshold

        else if condition == "contains" then
            String.contains thresholdStr valueStr

        else if condition == "down" then
            valueStr == "down" || valueStr == "0"
                || String.startsWith "error" valueStr

        else
            False


-- Firing records the event to alert_history, logs it, and — for a webhook
-- or slack notify type — POSTs the message. The record write and the
-- delivery are chained into one Task; a delivery failure is logged and
-- swallowed so one unreachable webhook never aborts the whole check batch.
fireAlert : Dict String String -> String -> Task Error ()
fireAlert alert currentValue =
    let
        alertId = LibDb.field "id" alert
        metricId = LibDb.field "metric_id" alert
        condition = LibDb.field "condition" alert
        threshold = LibDb.field "threshold" alert
        notifyType = LibDb.field "notify_type" alert
        notifyTarget = LibDb.field "notify_target" alert
        message =
            "SkyMon Alert: metric " ++ metricId ++ " value " ++ currentValue
                ++ " " ++ condition ++ " " ++ threshold
    in
        recordAlertFired alertId metricId currentValue condition threshold notifyType
            |> Task.andThen
                (\_ ->
                    let
                        _ = Io.println ("[ALERT] " ++ message)
                    in
                        deliver notifyType notifyTarget message
                )


deliver : String -> String -> String -> Task Error ()
deliver notifyType target message =
    if (notifyType == "webhook" || notifyType == "slack")
        && not (String.isEmpty target) then
        Http.post target ("{\"text\":\"" ++ escapeJson message ++ "\"}")
            |> Task.map (\_ -> ())
            |> Task.onError
                (\e ->
                    let
                        _ =
                            Io.println
                                ("[ALERT ERROR] " ++ notifyType ++ " " ++ target
                                    ++ ": " ++ Error.toString e)
                    in
                        Task.succeed ()
                )

    else
        Task.succeed ()


recordAlertFired : String -> String -> String -> String -> String -> String -> Task Error ()
recordAlertFired alertId metricId value condition threshold notifyType =
    LibDb.withConn
        (\conn ->
            Db.exec
                conn
                "INSERT INTO alert_history (alert_id, metric_id, metric_value, condition, threshold, notify_type) VALUES (?, ?, ?, ?, ?, ?)"
                [ alertId, metricId, value, condition, threshold, notifyType ]
                |> Task.map (\_ -> ())
        )


findMetricById : String -> List (Dict String String) -> Maybe (Dict String String)
findMetricById metricId metrics =
    case metrics of

        [] ->
            Nothing

        m :: rest ->
            if LibDb.field "id" m == metricId then
                Just m

            else
                findMetricById metricId rest


escapeJson : String -> String
escapeJson s =
    String.replace "\"" "\\\"" (String.replace "\\" "\\\\" s)


parseFloat : String -> Float
parseFloat s =
    case String.toFloat s of

        Just f ->
            f

        Nothing ->
            0.0
