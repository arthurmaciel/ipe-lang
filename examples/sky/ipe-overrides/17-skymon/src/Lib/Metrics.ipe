module Lib.Metrics exposing
    ( createMetric
    , deleteMetric
    , getMetrics
    , getMetricHistory
    , collectMetric
    , extractJsonField
    )

import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Http as Http
import Ipe.Task as Task
import Ipe.Crypto as Crypto
import Ipe.Db as Db
import Ipe.Db.Unsafe as DbUnsafe
import Lib.Db as LibDb
import Lib.SafeQuery as SafeQuery
import Ipe.Error as Error exposing (Error)


-- Every database operation is a `Task Error a`; there is no synchronous
-- force. Each opens its own pooled connection through `LibDb.withConn`, so
-- the connection never escapes into the session-persisted Model. Every
-- user-supplied value reaches SQL as a bound `?` parameter.


createMetric : String -> String -> String -> String -> Task Error String
createMetric name sourceType configJson visibility =
    let
        metId = String.slice 0 12 (Crypto.sha256 (name ++ ":" ++ sourceType))
    in
        LibDb.withConn
            (\conn ->
                Db.exec
                    conn
                    "INSERT OR REPLACE INTO metrics (id, name, source_type, config_json, visibility) VALUES (?, ?, ?, ?, ?)"
                    [ metId, name, sourceType, configJson, visibility ]
                    |> Task.map (\_ -> metId)
            )


-- Deleting a metric removes its history and any alerts on it before the
-- metric row itself, all on the same acquired connection.
deleteMetric : String -> Task Error ()
deleteMetric metId =
    LibDb.withConn
        (\conn ->
            Db.exec
                conn
                "DELETE FROM metric_history WHERE metric_id = ?"
                [ metId ]
                |> Task.andThen
                    (\_ ->
                        Db.exec
                            conn
                            "DELETE FROM alerts WHERE metric_id = ?"
                            [ metId ])
                |> Task.andThen
                    (\_ ->
                        Db.exec
                            conn
                            "DELETE FROM metrics WHERE id = ?"
                            [ metId ])
                |> Task.map (\_ -> ())
        )


getMetrics : Task Error (List (Dict String String))
getMetrics =
    LibDb.withConn
        (\conn ->
            DbUnsafe.unsafeQuery
                conn
                "SELECT * FROM metrics ORDER BY name"
                [])


getMetricHistory : String -> Int -> Task Error (List (Dict String String))
getMetricHistory metId limit =
    LibDb.withConn
        (\conn ->
            DbUnsafe.unsafeQuery
                conn
                "SELECT value, recorded_at FROM metric_history WHERE metric_id = ? ORDER BY recorded_at DESC LIMIT ?"
                [ metId, String.fromInt limit ])


-- Collect one metric's current value and persist it. The value is produced
-- by an effect that depends on the metric's source type, then written to the
-- metric row and its history in one chained Task.
collectMetric : Dict String String -> Task Error ()
collectMetric metric =
    runMetric metric
        |> Task.andThen (\value -> recordMetricValue (LibDb.field "id" metric) value)


-- runMetric : Task Error String — yields the collected value. `http`/`api`
-- probe an endpoint; `sql` runs a read-only SELECT through the SafeQuery
-- gate on the app's own connection (an external DSN is not reachable through
-- the arg-less `Db.connect ()`, so the DSN in the config is informational).
runMetric : Dict String String -> Task Error String
runMetric metric =
    let
        sourceType = LibDb.field "source_type" metric
        configJson = LibDb.field "config_json" metric
    in
        if sourceType == "sql" then
            runSqlMetric configJson

        else if sourceType == "http" then
            runHttpMetric configJson

        else if sourceType == "api" then
            runApiMetric configJson

        else
            Task.succeed "error: unknown source type"


runSqlMetric : String -> Task Error String
runSqlMetric configJson =
    let
        query = extractJsonField "query" configJson
    in
        if String.isEmpty query then
            Task.succeed "error: missing query in config"

        else
            LibDb.withConn (\conn -> SafeQuery.runReadOnly conn query [])
                |> Task.map extractFirstValue
                |> Task.onError (\e -> Task.succeed ("error: " ++ Error.toString e))


extractFirstValue : List (Dict String String) -> String
extractFirstValue rows =
    case rows of

        row :: _ ->
            case Dict.values row of

                v :: _ ->
                    v

                [] ->
                    "0"

        [] ->
            "0"


runHttpMetric : String -> Task Error String
runHttpMetric configJson =
    let
        url = extractJsonField "url" configJson
    in
        if String.isEmpty url then
            Task.succeed "error: missing url"

        else
            Http.get url
                |> Task.map (\resp -> String.fromInt resp.status)
                |> Task.onError (\e -> Task.succeed ("error: " ++ Error.toString e))


runApiMetric : String -> Task Error String
runApiMetric configJson =
    let
        url = extractJsonField "url" configJson
        fieldPath = extractJsonField "field" configJson
    in
        if String.isEmpty url then
            Task.succeed "error: missing url"

        else
            Http.get url
                |> Task.map (\resp -> extractApiValue fieldPath resp.body)
                |> Task.onError (\e -> Task.succeed ("error: " ++ Error.toString e))


extractApiValue : String -> String -> String
extractApiValue fieldPath body =
    if String.isEmpty fieldPath then
        body

    else
        extractJsonField fieldPath body


recordMetricValue : String -> String -> Task Error ()
recordMetricValue metId value =
    LibDb.withConn
        (\conn ->
            Db.exec
                conn
                "UPDATE metrics SET last_value = ?, last_updated = datetime('now') WHERE id = ?"
                [ value, metId ]
                |> Task.andThen
                    (\_ ->
                        Db.exec
                            conn
                            "INSERT INTO metric_history (metric_id, value) VALUES (?, ?)"
                            [ metId, value ])
                |> Task.map (\_ -> ())
        )


-- ══════════════════════════════════════════════════════
-- MINIMAL JSON FIELD EXTRACTION (pure)
-- ══════════════════════════════════════════════════════
extractJsonField : String -> String -> String
extractJsonField key json =
    let
        searchKey = "\"" ++ key ++ "\""
    in
        case List.drop 1 (String.split searchKey json) of

            after :: _ ->
                extractJsonValue (String.trim (dropUntilColon after))

            [] ->
                ""


dropUntilColon : String -> String
dropUntilColon s =
    if String.isEmpty s then
        ""

    else if String.startsWith ":" s then
        String.trim (String.slice 1 (String.length s) s)

    else
        dropUntilColon (String.slice 1 (String.length s) s)


extractJsonValue : String -> String
extractJsonValue s =
    if String.startsWith "\"" s then
        let
            rest = String.slice 1 (String.length s) s
            endQuote = findCharIndex "\"" rest 0
        in
            if endQuote > 0 then
                String.slice 0 endQuote rest

            else
                rest

    else
        String.trim (String.slice 0 (findEndOfValue s 0) s)


findCharIndex : String -> String -> Int -> Int
findCharIndex ch s idx =
    if idx >= String.length s then
        -1

    else if String.slice idx (idx + 1) s == ch then
        idx

    else
        findCharIndex ch s (idx + 1)


findEndOfValue : String -> Int -> Int
findEndOfValue s idx =
    if idx >= String.length s then
        idx

    else
        let
            ch = String.slice idx (idx + 1) s
        in
            if ch == "," || ch == "}" || ch == "]" then
                idx

            else
                findEndOfValue s (idx + 1)
