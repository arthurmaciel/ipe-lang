module Lib.SafeQuery exposing (runReadOnly, isSelectOnly)

import Ipe.String as String
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Error as Error exposing (Error)


-- Run a query ONLY if it is a SELECT / WITH / EXPLAIN statement, rejecting
-- INSERT, UPDATE, DELETE, DROP, ALTER, CREATE, TRUNCATE, etc. This is the
-- read-only gate the metric collector runs user-authored SQL through: the
-- statement is inspected before it reaches the database, and a write-shaped
-- statement fails closed with an InvalidInput error rather than executing.
-- Even so, no user value is interpolated into the SQL of a first-party write
-- anywhere in the app — those all bind `?` parameters.
runReadOnly : Db -> String -> List String -> Task Error (List (Dict String String))
runReadOnly conn query params =
    if isSelectOnly query then
        Db.unsafeQuery conn query params

    else
        Task.fail
            (Error.invalidInput
                ("Query rejected: only SELECT queries are allowed. Got: "
                    ++ String.slice 0 50 query))


-- A query is read-only when its first keyword (after stripping leading line
-- comments) is SELECT, WITH, or EXPLAIN.
isSelectOnly : String -> Bool
isSelectOnly query =
    let
        cleaned = stripSqlComments (String.trim query)
        firstWord = getFirstWord (String.toUpper cleaned)
    in
        firstWord == "SELECT" || firstWord == "WITH" || firstWord == "EXPLAIN"


stripSqlComments : String -> String
stripSqlComments query =
    if String.startsWith "--" query then
        stripSqlComments (dropUntilNewline query)

    else
        query


dropUntilNewline : String -> String
dropUntilNewline s =
    if String.isEmpty s then
        ""

    else if String.startsWith "\n" s then
        String.trim (String.slice 1 (String.length s) s)

    else
        dropUntilNewline (String.slice 1 (String.length s) s)


getFirstWord : String -> String
getFirstWord s =
    case String.split " " (String.trim s) of

        word :: _ ->
            word

        [] ->
            ""
