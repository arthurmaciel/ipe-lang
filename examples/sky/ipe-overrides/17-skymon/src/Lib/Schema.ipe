module Lib.Schema exposing (ensureSchema)

import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Db.Unsafe as DbUnsafe
import Ipe.Error as Error exposing (Error)


-- Create every table if it does not already exist, chained off an open
-- connection. Each effect in this app calls `ensureSchema` right after
-- `Db.connect` (via `Lib.Db.withConn`), so the schema is guaranteed present
-- before any read or write and the connection never escapes into the
-- session-persisted Model. The same connection flows out so the caller can
-- keep building its Task pipeline. `DbUnsafe.unsafeExecRaw` is arg-less DDL only —
-- every runtime value reaches SQL through a bound `?` parameter elsewhere.
ensureSchema : Db -> Task Error Db
ensureSchema conn =
    DbUnsafe.unsafeExecRaw
        conn
        """CREATE TABLE IF NOT EXISTS monitors (
            id TEXT PRIMARY KEY,
            name TEXT NOT NULL,
            url TEXT NOT NULL,
            interval_secs INTEGER DEFAULT 30,
            status TEXT DEFAULT 'unknown',
            response_time INTEGER DEFAULT 0,
            last_checked TEXT DEFAULT '',
            visibility TEXT DEFAULT 'user',
            created_at TEXT DEFAULT (datetime('now'))
        )"""
        |> Task.andThen
            (\_ ->
                DbUnsafe.unsafeExecRaw
                    conn
                    """CREATE TABLE IF NOT EXISTS metrics (
                        id TEXT PRIMARY KEY,
                        name TEXT NOT NULL,
                        source_type TEXT NOT NULL,
                        config_json TEXT DEFAULT '{}',
                        last_value TEXT DEFAULT '',
                        last_updated TEXT DEFAULT '',
                        visibility TEXT DEFAULT 'user',
                        created_at TEXT DEFAULT (datetime('now'))
                    )"""
            )
        |> Task.andThen
            (\_ ->
                DbUnsafe.unsafeExecRaw
                    conn
                    """CREATE TABLE IF NOT EXISTS metric_history (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        metric_id TEXT NOT NULL,
                        value TEXT NOT NULL,
                        recorded_at TEXT DEFAULT (datetime('now'))
                    )"""
            )
        |> Task.andThen
            (\_ ->
                DbUnsafe.unsafeExecRaw
                    conn
                    """CREATE TABLE IF NOT EXISTS alerts (
                        id TEXT PRIMARY KEY,
                        metric_id TEXT NOT NULL,
                        condition TEXT NOT NULL,
                        threshold TEXT NOT NULL,
                        notify_type TEXT DEFAULT 'webhook',
                        notify_target TEXT DEFAULT '',
                        enabled INTEGER DEFAULT 1,
                        created_at TEXT DEFAULT (datetime('now'))
                    )"""
            )
        |> Task.andThen
            (\_ ->
                DbUnsafe.unsafeExecRaw
                    conn
                    """CREATE TABLE IF NOT EXISTS sessions (
                        id TEXT PRIMARY KEY,
                        username TEXT NOT NULL,
                        avatar_url TEXT DEFAULT '',
                        role TEXT DEFAULT 'user',
                        created_at TEXT DEFAULT (datetime('now'))
                    )"""
            )
        |> Task.andThen
            (\_ ->
                DbUnsafe.unsafeExecRaw
                    conn
                    """CREATE TABLE IF NOT EXISTS monitor_history (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        monitor_id TEXT NOT NULL,
                        status TEXT NOT NULL,
                        response_time INTEGER DEFAULT 0,
                        checked_at TEXT DEFAULT (datetime('now'))
                    )"""
            )
        |> Task.andThen
            (\_ ->
                DbUnsafe.unsafeExecRaw
                    conn
                    """CREATE TABLE IF NOT EXISTS alert_history (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        alert_id TEXT NOT NULL,
                        metric_id TEXT NOT NULL,
                        metric_value TEXT NOT NULL,
                        condition TEXT NOT NULL,
                        threshold TEXT NOT NULL,
                        notify_type TEXT NOT NULL,
                        fired_at TEXT DEFAULT (datetime('now'))
                    )"""
            )
        |> Task.map (\_ -> conn)
