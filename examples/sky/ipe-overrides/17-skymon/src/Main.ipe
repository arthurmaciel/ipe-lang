module Main exposing (main)

-- examples/17-skymon — uptime + metrics monitor, TEA rearchitecture.
--
-- SkyMon watches HTTP endpoints and custom metrics, records their history
-- to SQLite, and fires alerts when a metric crosses a threshold. The
-- upstream forces every database read/write and every HTTP probe with
-- `Task.run` — a module-level synchronous `dbConn`, synchronous `exec` /
-- `query` wrappers in `Lib/Database`, and synchronous `Http.get` inside the
-- metric/monitor collectors, all consumed mid-`update` and inside `view`
-- helpers. `Task.run` is removed from the Ipê surface (IPE-N0036) and Ipê
-- TEA has no synchronous force, so this is a whole-example rearchitecture,
-- hosted here as an `ipe-overrides/` tree (the same mechanism as
-- `13-skyshop`, `12-skyvote`, `16-skychess`, and `27-multi-session-chat`).
--
-- EFFECT MODEL. Every database read/write and every outbound HTTP probe is a
-- `Task Error a`; there is no synchronous force. A Web-shape `Model` is
-- persisted to the session store between requests, so it holds plain data
-- only — the settled monitor / metric / alert records and history rows,
-- never the opaque `Db` handle (IPE-L0120). Each database effect opens its
-- own pooled connection inside its Task chain (`Db.connect |> ensureSchema
-- |> op`, via `Lib.Db.withConn`), and only the settled DATA reaches the
-- Model through a response `Msg`. A page's data is loaded by the `Msg` that
-- navigates there (a route-only navigation re-renders the view without
-- running `update`) and refreshed by a periodic tick; the tick also runs the
-- monitor checks, metric collections, and alert evaluations as chained
-- Tasks. Every user-supplied value reaches SQL as a bound `?` parameter.

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Ui as Ui
import Ipe.Error as Error exposing (Error)
import Ipe.Tea.Web exposing (app, route)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import State exposing (..)
import Lib.Db as Db
import Lib.Monitors as Monitors
import Lib.Metrics as Metrics
import Lib.Alerts as Alerts
import Page.Dashboard as Dashboard
import Page.Status as StatusPage
import Page.Settings as Settings
import Page.AuthPage as AuthPage
import Page.MonitorDetail as MonitorDetail
import Page.MetricDetail as MetricDetail
import Page.Alerts as AlertsPage


-- ══════════════════════════════════════════════════════
-- APP
-- ══════════════════════════════════════════════════════
main =
    app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes =
              [ route "/" DashboardPage
              , route "/status" StatusPage
              , route "/settings" SettingsPage
              , route "/alerts" AlertsPage
              , route "/auth" AuthPage
              ]
        , notFound = NotFoundPage
        }


-- ══════════════════════════════════════════════════════
-- INIT
-- ══════════════════════════════════════════════════════
-- `init` runs once per new session. The dashboard's collections are loaded
-- asynchronously; the model starts empty and `BoardLoaded` fills it in.
init req =
    ( emptyModel, loadBoardCmd )


emptyModel : Model
emptyModel =
    { page = DashboardPage
    , session = Nothing
    , monitors = []
    , metrics = []
    , alerts = []
    , notification = ""
    , errorMessage = ""
    , configInput = Dict.empty
    , detailMonitorId = ""
    , detailMetricId = ""
    , monitorHistory = []
    , metricHistory = []
    , metricAlertHistory = []
    , alertHistory = []
    }


-- ══════════════════════════════════════════════════════
-- VIEW
-- ══════════════════════════════════════════════════════
-- The Web shape's `view` is `Model -> Element Msg`. Each page view returns a
-- typed `Ipe.Html` tree; the single `Ui.html` bridge lifts it into the
-- `Element Msg` the shape expects. Every `Page` constructor is enumerated
-- (IPE-T0018).
view : Model -> Ui.Element Msg
view model =
    Ui.html (viewPage model)


viewPage : Model -> Html Msg
viewPage model =
    case model.page of

        DashboardPage ->
            Dashboard.viewDashboard model

        StatusPage ->
            StatusPage.viewStatus model

        SettingsPage ->
            Settings.viewSettings model

        AlertsPage ->
            AlertsPage.viewAlerts model

        AuthPage ->
            AuthPage.viewAuth model

        MonitorDetailPage monId ->
            MonitorDetail.viewMonitorDetail monId model

        MetricDetailPage metId ->
            MetricDetail.viewMetricDetail metId model

        NotFoundPage ->
            Dashboard.viewDashboard model


-- ══════════════════════════════════════════════════════
-- SUBSCRIPTIONS
-- ══════════════════════════════════════════════════════
-- Every page ticks: the tick both refreshes the current page's data and, on
-- the collection pages, runs the monitor checks / metric collections / alert
-- evaluations. A route-only navigation re-renders the view without running
-- `update`, so the ticker is also how a freshly-navigated page's data first
-- loads.
subscriptions : Model -> Sub.Sub Msg
subscriptions model =
    Time.every 10000 Tick


-- ══════════════════════════════════════════════════════
-- UPDATE
-- ══════════════════════════════════════════════════════
update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigate page ->
            handleNavigate page model

        Tick ->
            ( model, tickCmd model )

        RefreshData ->
            ( model, loadBoardCmd )

        -- ── Async responses ──────────────────────────────────────────
        BoardLoaded (Ok board) ->
            ( { model | monitors = board.monitors
              , metrics = board.metrics
              , alerts = board.alerts
              }
            , Cmd.none
            )

        BoardLoaded (Err e) ->
            ( { model | notification = "Could not load data: " ++ Error.toString e }
            , Cmd.none
            )

        MonitorDetailLoaded (Ok data) ->
            ( { model | monitorHistory = data.history }, Cmd.none )

        MonitorDetailLoaded (Err e) ->
            ( { model | notification = "Could not load history: " ++ Error.toString e }
            , Cmd.none
            )

        MetricDetailLoaded (Ok data) ->
            ( { model | metricHistory = data.history
              , metricAlertHistory = data.alertHistory
              }
            , Cmd.none
            )

        MetricDetailLoaded (Err e) ->
            ( { model | notification = "Could not load history: " ++ Error.toString e }
            , Cmd.none
            )

        AlertHistoryLoaded (Ok rows) ->
            ( { model | alertHistory = rows }, Cmd.none )

        AlertHistoryLoaded (Err e) ->
            ( { model | notification = "Could not load alert history: " ++ Error.toString e }
            , Cmd.none
            )

        MonitorAdded (Ok _) ->
            ( { model | configInput = Dict.empty
              , notification = "Monitor added"
              , errorMessage = ""
              }
            , loadBoardCmd
            )

        MonitorAdded (Err e) ->
            ( { model | errorMessage = Error.toString e }, Cmd.none )

        MonitorRemoved (Ok _) ->
            ( { model | notification = "Monitor deleted" }, loadBoardCmd )

        MonitorRemoved (Err e) ->
            ( { model | notification = "Could not delete monitor: " ++ Error.toString e }
            , Cmd.none
            )

        MetricAdded (Ok _) ->
            ( { model | configInput = Dict.empty
              , notification = "Metric added"
              , errorMessage = ""
              }
            , loadBoardCmd
            )

        MetricAdded (Err e) ->
            ( { model | errorMessage = Error.toString e }, Cmd.none )

        MetricRemoved (Ok _) ->
            ( { model | notification = "Metric deleted" }, loadBoardCmd )

        MetricRemoved (Err e) ->
            ( { model | notification = "Could not delete metric: " ++ Error.toString e }
            , Cmd.none
            )

        AlertAdded (Ok _) ->
            ( { model | configInput = Dict.empty
              , notification = "Alert added"
              , errorMessage = ""
              }
            , loadBoardCmd
            )

        AlertAdded (Err e) ->
            ( { model | errorMessage = Error.toString e }, Cmd.none )

        AlertRemoved (Ok _) ->
            ( { model | notification = "Alert deleted" }, loadBoardCmd )

        AlertRemoved (Err e) ->
            ( { model | notification = "Could not delete alert: " ++ Error.toString e }
            , Cmd.none
            )

        ChecksRan (Ok _) ->
            ( model, loadBoardCmd )

        ChecksRan (Err e) ->
            ( { model | notification = "Check cycle failed: " ++ Error.toString e }
            , Cmd.none
            )

        -- ── Config-form inputs ───────────────────────────────────────
        InputMonitorName v ->
            ( setInput "monitor_name" v model, Cmd.none )

        InputMonitorUrl v ->
            ( setInput "monitor_url" v model, Cmd.none )

        InputMonitorVis v ->
            ( setInput "monitor_visibility" v model, Cmd.none )

        InputMetricName v ->
            ( setInput "metric_name" v model, Cmd.none )

        InputMetricType v ->
            ( setInput "metric_type" v model, Cmd.none )

        InputMetricUrl v ->
            ( setInput "metric_url" v model, Cmd.none )

        InputMetricQuery v ->
            ( setInput "metric_query" v model, Cmd.none )

        InputMetricField v ->
            ( setInput "metric_field" v model, Cmd.none )

        InputMetricVis v ->
            ( setInput "metric_visibility" v model, Cmd.none )

        InputAlertMetric v ->
            ( setInput "alert_metric" v model, Cmd.none )

        InputAlertCondition v ->
            ( setInput "alert_condition" v model, Cmd.none )

        InputAlertThreshold v ->
            ( setInput "alert_threshold" v model, Cmd.none )

        InputAlertNotifyType v ->
            ( setInput "alert_notify_type" v model, Cmd.none )

        InputAlertTarget v ->
            ( setInput "alert_notify_target" v model, Cmd.none )

        InputAuthUsername v ->
            ( setInput "auth_username" v model, Cmd.none )

        InputAuthPassword v ->
            ( setInput "auth_password" v model, Cmd.none )

        -- ── Commands ─────────────────────────────────────────────────
        AddMonitor ->
            handleAddMonitor model

        DeleteMonitor monId ->
            ( model, Task.attempt MonitorRemoved (Monitors.deleteMonitor monId) )

        AddMetric ->
            handleAddMetric model

        DeleteMetric metId ->
            ( model, Task.attempt MetricRemoved (Metrics.deleteMetric metId) )

        AddAlert ->
            handleAddAlert model

        DeleteAlert alertId ->
            ( model, Task.attempt AlertRemoved (Alerts.deleteAlert alertId) )

        DoSignIn ->
            handleSignIn model

        SignOut ->
            ( { model | session = Nothing, page = DashboardPage }, Cmd.none )

        DismissNotification ->
            ( { model | notification = "" }, Cmd.none )


-- ══════════════════════════════════════════════════════
-- NAVIGATION
-- ══════════════════════════════════════════════════════
-- Navigating to a detail page records which id is being viewed on the Model
-- and dispatches that page's history load; the response reads the pending id
-- back off the Model rather than being threaded through both the effect and
-- its response tag (which would move-then-reuse the same value). Every other
-- page loads through the board refresh or its own view of already-settled
-- data.
handleNavigate : Page -> Model -> ( Model, Cmd Msg )
handleNavigate page model =
    case page of

        MonitorDetailPage monId ->
            ( { model | page = page, detailMonitorId = monId, notification = "" }
            , Task.attempt
                MonitorDetailLoaded
                (Task.map
                    (\history -> { history = history })
                    (Monitors.getMonitorHistory monId 50))
            )

        MetricDetailPage metId ->
            ( { model | page = page, detailMetricId = metId, notification = "" }
            , loadMetricDetailCmd metId
            )

        AlertsPage ->
            ( { model | page = page, notification = "" }
            , Cmd.batch [ loadBoardCmd, loadAlertHistoryCmd ]
            )

        DashboardPage ->
            ( { model | page = page, notification = "" }, loadBoardCmd )

        StatusPage ->
            ( { model | page = page, notification = "" }, loadBoardCmd )

        SettingsPage ->
            ( { model | page = page, notification = "" }, loadBoardCmd )

        AuthPage ->
            ( { model | page = page, notification = "" }, Cmd.none )

        NotFoundPage ->
            ( { model | page = page, notification = "" }, Cmd.none )


-- ══════════════════════════════════════════════════════
-- EFFECT BUILDERS
-- ══════════════════════════════════════════════════════
-- The dashboard, status, settings, and alerts pages all render the same
-- three collections, so one composed load settles them together under a
-- single `BoardLoaded`.
loadBoardCmd : Cmd Msg
loadBoardCmd =
    Task.attempt
        BoardLoaded
        (Task.map2
            (\( monitors, metrics ) alerts ->
                { monitors = List.map rowToMonitor monitors
                , metrics = List.map rowToMetric metrics
                , alerts = List.map rowToAlert alerts
                })
            (Task.map2 (\a b -> ( a, b )) Monitors.getMonitors Metrics.getMetrics)
            Alerts.getAlerts)


loadMetricDetailCmd : String -> Cmd Msg
loadMetricDetailCmd metId =
    Task.attempt
        MetricDetailLoaded
        (Task.map2
            (\history alertHistory ->
                { history = history, alertHistory = alertHistory })
            (Metrics.getMetricHistory metId 50)
            (Alerts.getAlertHistoryForMetric metId 20))


loadAlertHistoryCmd : Cmd Msg
loadAlertHistoryCmd =
    Task.attempt AlertHistoryLoaded (Alerts.getAlertHistory 50)


-- The periodic tick refreshes whatever the current page renders and, on the
-- collection pages, runs the check cycle (probe every monitor, collect every
-- metric, evaluate every alert) as one chained Task before reloading.
tickCmd : Model -> Cmd Msg
tickCmd model =
    case model.page of

        DashboardPage ->
            runChecksCmd

        StatusPage ->
            runChecksCmd

        SettingsPage ->
            loadBoardCmd

        AlertsPage ->
            Cmd.batch [ loadBoardCmd, loadAlertHistoryCmd ]

        MonitorDetailPage monId ->
            Task.attempt
                MonitorDetailLoaded
                (Task.map
                    (\history -> { history = history })
                    (Monitors.getMonitorHistory monId 50))

        MetricDetailPage metId ->
            loadMetricDetailCmd metId

        AuthPage ->
            Cmd.none

        NotFoundPage ->
            Cmd.none


-- One check cycle: probe every monitor, collect every metric, then evaluate
-- every alert against the freshly collected values — all composed into one
-- Task so a failure in any stage surfaces through `ChecksRan`.
runChecksCmd : Cmd Msg
runChecksCmd =
    Task.attempt
        ChecksRan
        (Monitors.getMonitors
            |> Task.andThen runMonitorChecks
            |> Task.andThen (\_ -> Metrics.getMetrics)
            |> Task.andThen runMetricCollections
            |> Task.andThen
                (\_ ->
                    Task.map2 (\a m -> ( a, m ))
                        Alerts.getAlerts
                        Metrics.getMetrics)
            |> Task.andThen
                (\pair -> Alerts.checkAlerts (fst pair) (snd pair)))


runMonitorChecks : List (Dict String String) -> Task Error ()
runMonitorChecks monitors =
    case monitors of

        [] ->
            Task.succeed ()

        mon :: rest ->
            Monitors.checkAndRecord mon
                |> Task.andThen (\_ -> runMonitorChecks rest)


runMetricCollections : List (Dict String String) -> Task Error ()
runMetricCollections metrics =
    case metrics of

        [] ->
            Task.succeed ()

        met :: rest ->
            Metrics.collectMetric met
                |> Task.andThen (\_ -> runMetricCollections rest)


-- ══════════════════════════════════════════════════════
-- COMMAND HANDLERS
-- ══════════════════════════════════════════════════════
handleAddMonitor : Model -> ( Model, Cmd Msg )
handleAddMonitor model =
    let
        name = configOr "New Monitor" "monitor_name" model
        url = configOr "" "monitor_url" model
        vis = configOr "user" "monitor_visibility" model
    in
        if String.isEmpty url then
            ( { model | errorMessage = "URL is required" }, Cmd.none )

        else
            ( model, Task.attempt MonitorAdded (Monitors.createMonitor name url 30 vis) )


handleAddMetric : Model -> ( Model, Cmd Msg )
handleAddMetric model =
    let
        name = configOr "New Metric" "metric_name" model
        sourceType = configOr "http" "metric_type" model
        url = configOr "" "metric_url" model
        query = configOr "" "metric_query" model
        field = configOr "" "metric_field" model
        vis = configOr "user" "metric_visibility" model
        configJson = buildMetricConfig sourceType url query field
    in
        ( model, Task.attempt MetricAdded (Metrics.createMetric name sourceType configJson vis) )


buildMetricConfig : String -> String -> String -> String -> String
buildMetricConfig sourceType url query field =
    if sourceType == "sql" then
        "{\"dsn\":\"" ++ url ++ "\",\"query\":\"" ++ query ++ "\"}"

    else if sourceType == "api" then
        "{\"url\":\"" ++ url ++ "\",\"field\":\"" ++ field ++ "\"}"

    else
        "{\"url\":\"" ++ url ++ "\"}"


handleAddAlert : Model -> ( Model, Cmd Msg )
handleAddAlert model =
    let
        metricName = configOr "" "alert_metric" model
        condition = configOr ">" "alert_condition" model
        threshold = configOr "0" "alert_threshold" model
        notifyType = configOr "log" "alert_notify_type" model
        notifyTarget = configOr "" "alert_notify_target" model
        metricId = resolveMetricId metricName model.metrics
    in
        if String.isEmpty metricId then
            ( { model | errorMessage = "Metric not found: " ++ metricName }
            , Cmd.none
            )

        else
            ( model
            , Task.attempt
                AlertAdded
                (Alerts.createAlert metricId condition threshold notifyType notifyTarget)
            )


-- A signed-out sign-in against the built-in credentials. The admin login
-- grants the Admin role; any other non-empty pair is a plain User. This
-- mirrors the upstream's local demo auth (no external identity provider).
handleSignIn : Model -> ( Model, Cmd Msg )
handleSignIn model =
    let
        username = configOr "" "auth_username" model
        password = configOr "" "auth_password" model
    in
        if String.isEmpty username || String.isEmpty password then
            ( { model | errorMessage = "Please enter username and password" }
            , Cmd.none
            )

        else if username == "admin" && password == "admin123" then
            ( signedInModel "admin" Admin model, Cmd.none )

        else
            ( signedInModel username User model, Cmd.none )


signedInModel : String -> Role -> Model -> Model
signedInModel username role model =
    { model | session = Just { username = username, avatarUrl = "", role = role }
    , configInput = Dict.empty
    , notification = ""
    , errorMessage = ""
    , page = DashboardPage
    }


-- ══════════════════════════════════════════════════════
-- ROW → RECORD (pure; applied to settled rows in a response branch)
-- ══════════════════════════════════════════════════════
rowToMonitor : Dict String String -> Monitor
rowToMonitor row =
    { id = Db.field "id" row
    , name = Db.field "name" row
    , url = Db.field "url" row
    , interval = Db.intField "interval_secs" row
    , status = parseStatus (Db.field "status" row)
    , responseTime = Db.intField "response_time" row
    , lastChecked = Db.field "last_checked" row
    , visibility = parseVisibility (Db.field "visibility" row)
    }


rowToMetric : Dict String String -> Metric
rowToMetric row =
    { id = Db.field "id" row
    , name = Db.field "name" row
    , sourceType = Db.field "source_type" row
    , lastValue = Db.field "last_value" row
    , lastUpdated = Db.field "last_updated" row
    , visibility = parseVisibility (Db.field "visibility" row)
    }


rowToAlert : Dict String String -> AlertRule
rowToAlert row =
    { id = Db.field "id" row
    , metricId = Db.field "metric_id" row
    , condition = Db.field "condition" row
    , threshold = Db.field "threshold" row
    , notifyType = Db.field "notify_type" row
    , notifyTarget = Db.field "notify_target" row
    , enabled = Db.field "enabled" row == "1"
    }


parseStatus : String -> MonitorStatus
parseStatus s =
    if s == "healthy" then
        Healthy

    else if s == "degraded" then
        Degraded

    else if s == "down" then
        Down

    else
        Unknown


parseVisibility : String -> Visibility
parseVisibility s =
    if s == "public" then
        VisPublic

    else if s == "admin" then
        VisAdmin

    else
        VisUser


resolveMetricId : String -> List Metric -> String
resolveMetricId nameOrId metrics =
    case metrics of

        [] ->
            ""

        m :: rest ->
            if m.id == nameOrId || m.name == nameOrId then
                m.id

            else
                resolveMetricId nameOrId rest


-- ══════════════════════════════════════════════════════
-- CONFIG-INPUT HELPERS
-- ══════════════════════════════════════════════════════
setInput : String -> String -> Model -> Model
setInput key v model =
    { model | configInput = Dict.insert key v model.configInput }


configOr : String -> String -> Model -> String
configOr fallback key model =
    Maybe.withDefault fallback (Dict.get key model.configInput)
