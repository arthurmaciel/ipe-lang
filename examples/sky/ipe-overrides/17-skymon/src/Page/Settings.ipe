module Page.Settings exposing (viewSettings)

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onClick, onInput)
import State exposing (..)
import Ui.Layout as Layout


viewSettings : Model -> Html Msg
viewSettings model =
    Layout.page
        model
        (div
            []
            [ h2 [ class "section-title" ] [ text "Settings" ]
            , viewAddMonitorForm model
            , viewMonitorList model
            , viewAddMetricForm model
            , viewMetricList model
            ])


configValue : String -> String -> Model -> String
configValue key fallback model =
    Maybe.withDefault fallback (Dict.get key model.configInput)


viewAddMonitorForm : Model -> Html Msg
viewAddMonitorForm model =
    div
        [ class "card", style "margin-bottom: 24px" ]
        [ h3
              [ style "font-size: 16px; color: #f1f5f9; margin-bottom: 16px" ]
              [ text "Add Monitor" ]
        , formField "Name" "My API" (configValue "monitor_name" "" model) InputMonitorName
        , formField "URL" "https://api.example.com/health" (configValue "monitor_url" "" model) InputMonitorUrl
        , formField "Visibility" "public, user, or admin" (configValue "monitor_visibility" "user" model) InputMonitorVis
        , button
              [ onClick AddMonitor, class "btn btn-primary" ]
              [ text "Add Monitor" ]
        ]


formField : String -> String -> String -> (String -> Msg) -> Html Msg
formField labelText placeholderText fieldValue toMsg =
    div
        [ class "form-group" ]
        [ label [ class "form-label" ] [ text labelText ]
        , input
              [ type_ "text"
              , class "form-input"
              , placeholder placeholderText
              , value fieldValue
              , onInput toMsg
              ]
        ]


viewMonitorList : Model -> Html Msg
viewMonitorList model =
    if List.isEmpty model.monitors then
        text ""

    else
        div
            [ style "margin-bottom: 24px" ]
            [ h3
                  [ style "font-size: 16px; color: #f1f5f9; margin-bottom: 12px" ]
                  [ text "Existing Monitors" ]
            , table
                  [ class "table" ]
                  [ node
                        "thead"
                        []
                        [ tr
                              []
                              [ th [] [ text "Name" ]
                              , th [] [ text "URL" ]
                              , th [] [ text "Status" ]
                              , th [] [ text "Visibility" ]
                              , th [] [ text "" ]
                              ]
                        ]
                  , node "tbody" [] (List.map viewMonitorRow model.monitors)
                  ]
            ]


viewMonitorRow : Monitor -> Html Msg
viewMonitorRow monitor =
    tr
        []
        [ td [ style "font-weight: 600" ] [ text monitor.name ]
        , td [ style "color: #64748b; font-size: 12px" ] [ text monitor.url ]
        , td
              []
              [ span
                    [ class ("status-dot status-" ++ statusStr monitor.status)
                    , style "margin-right: 8px"
                    ]
                    []
              , text (statusStr monitor.status)
              ]
        , td [] [ viewVisBadge monitor.visibility ]
        , td
              []
              [ button
                    [ onClick (DeleteMonitor monitor.id)
                    , class "btn btn-danger btn-sm"
                    ]
                    [ text "Delete" ]
              ]
        ]


viewAddMetricForm : Model -> Html Msg
viewAddMetricForm model =
    div
        [ class "card", style "margin-bottom: 24px" ]
        [ h3
              [ style "font-size: 16px; color: #f1f5f9; margin-bottom: 16px" ]
              [ text "Add Metric" ]
        , formField "Name" "Orders/Hour" (configValue "metric_name" "" model) InputMetricName
        , formField "Type (http, sql, api)" "http" (configValue "metric_type" "" model) InputMetricType
        , formField "URL / DSN" "https://api.example.com/stats or postgres://..." (configValue "metric_url" "" model) InputMetricUrl
        , div
              [ class "form-group" ]
              [ label [ class "form-label" ] [ text "SQL Query (for sql type)" ]
              , textarea
                    [ class "form-textarea"
                    , placeholder
                          "SELECT COUNT(*) FROM orders WHERE created_at > datetime('now', '-1 hour')"
                    , value (configValue "metric_query" "" model)
                    , onInput InputMetricQuery
                    ]
                    []
              ]
        , formField "Visibility" "public, user, or admin" (configValue "metric_visibility" "user" model) InputMetricVis
        , formField "JSON Field Path (for api type)" "data.count or result.0.value" (configValue "metric_field" "" model) InputMetricField
        , button
              [ onClick AddMetric, class "btn btn-primary" ]
              [ text "Add Metric" ]
        ]


viewMetricList : Model -> Html Msg
viewMetricList model =
    if List.isEmpty model.metrics then
        text ""

    else
        div
            [ style "margin-bottom: 24px" ]
            [ h3
                  [ style "font-size: 16px; color: #f1f5f9; margin-bottom: 12px" ]
                  [ text "Existing Metrics" ]
            , table
                  [ class "table" ]
                  [ node
                        "thead"
                        []
                        [ tr
                              []
                              [ th [] [ text "Name" ]
                              , th [] [ text "Type" ]
                              , th [] [ text "Value" ]
                              , th [] [ text "Visibility" ]
                              , th [] [ text "" ]
                              ]
                        ]
                  , node "tbody" [] (List.map viewMetricRow model.metrics)
                  ]
            ]


viewMetricRow : Metric -> Html Msg
viewMetricRow metric =
    tr
        []
        [ td [ style "font-weight: 600" ] [ text metric.name ]
        , td [ style "color: #64748b" ] [ text metric.sourceType ]
        , td
              [ style "color: #38bdf8; font-weight: 600" ]
              [ text metric.lastValue ]
        , td [] [ viewVisBadge metric.visibility ]
        , td
              []
              [ button
                    [ onClick (DeleteMetric metric.id)
                    , class "btn btn-danger btn-sm"
                    ]
                    [ text "Delete" ]
              ]
        ]


statusStr : MonitorStatus -> String
statusStr s =
    case s of

        Healthy ->
            "healthy"

        Degraded ->
            "degraded"

        Down ->
            "down"

        Unknown ->
            "unknown"


viewVisBadge : Visibility -> Html Msg
viewVisBadge vis =
    case vis of

        VisPublic ->
            span [ class "badge badge-public" ] [ text "public" ]

        VisAdmin ->
            span [ class "badge badge-admin" ] [ text "admin" ]

        VisUser ->
            span [ class "badge badge-user" ] [ text "user" ]
