module Page.MonitorDetail exposing (viewMonitorDetail)

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onClick)
import State exposing (..)
import Lib.Db as Db
import Ui.Layout as Layout
import Ui.Charts as Charts


-- The monitor's response-time / status history is loaded into
-- `model.monitorHistory` by the `MonitorDetailLoaded` response when the page
-- is navigated to; the view reads it plainly, never running a database
-- effect itself.
viewMonitorDetail : String -> Model -> Html Msg
viewMonitorDetail monId model =
    Layout.page
        model
        (case List.head (List.filter (\m -> m.id == monId) model.monitors) of

            Just mon ->
                viewMonitorContent mon model.monitorHistory

            Nothing ->
                viewNotFound)


viewMonitorContent : Monitor -> List (Dict String String) -> Html Msg
viewMonitorContent mon history =
    div
        []
        [ viewBackButton
        , viewMonitorHeader mon
        , viewMonitorStats mon
        , viewMonitorHistory history
        ]


viewBackButton : Html Msg
viewBackButton =
    button
        [ onClick (Navigate DashboardPage)
        , class "btn btn-ghost btn-sm"
        , style "margin-bottom: 16px"
        ]
        [ text "← Back to Dashboard" ]


viewMonitorHeader : Monitor -> Html Msg
viewMonitorHeader mon =
    div
        [ class "card", style "margin-bottom: 24px" ]
        [ div
              [ style
                    "display: flex; justify-content: space-between; align-items: center"
              ]
              [ div
                    []
                    [ h2
                          [ style
                                "font-size: 24px; color: #f1f5f9; margin-bottom: 4px"
                          ]
                          [ text mon.name ]
                    , p
                          [ style "color: #64748b; font-size: 13px" ]
                          [ text mon.url ]
                    ]
              , viewStatusBadge mon.status
              ]
        ]


viewStatusBadge : MonitorStatus -> Html Msg
viewStatusBadge status =
    span
        [ style
              ("padding: 6px 16px; border-radius: 20px; font-weight: 600; font-size: 13px; background: "
                  ++ statusColor status)
        ]
        [ text (statusLabel status) ]


statusColor : MonitorStatus -> String
statusColor s =
    case s of

        Healthy ->
            "#166534"

        Degraded ->
            "#854d0e"

        Down ->
            "#991b1b"

        Unknown ->
            "#374151"


statusLabel : MonitorStatus -> String
statusLabel s =
    case s of

        Healthy ->
            "✓ Healthy"

        Degraded ->
            "⚠ Degraded"

        Down ->
            "✗ Down"

        Unknown ->
            "? Unknown"


viewMonitorStats : Monitor -> Html Msg
viewMonitorStats mon =
    div
        [ class "grid", style "margin-bottom: 24px" ]
        [ statCard (String.fromInt mon.responseTime ++ "ms") "Response Time" "#38bdf8"
        , statCard (String.fromInt mon.interval ++ "s") "Check Interval" "#a78bfa"
        , statCard mon.lastChecked "Last Checked" "#94a3b8"
        ]


statCard : String -> String -> String -> Html Msg
statCard statValue label color =
    div
        [ class "card" ]
        [ div
              [ class "card-value", style ("font-size: 24px; color: " ++ color) ]
              [ text statValue ]
        , div [ class "card-subtitle" ] [ text label ]
        ]


viewMonitorHistory : List (Dict String String) -> Html Msg
viewMonitorHistory history =
    let
        responseTimes =
            List.map (\r -> Db.intField "response_time" r) history
        statuses = List.map (\r -> Db.field "status" r) history
    in
        div
            [ class "card" ]
            [ h3
                  [ style "font-size: 16px; color: #f1f5f9; margin-bottom: 16px" ]
                  [ text "Response Time History" ]
            , Charts.sparkline 600 60 (List.reverse responseTimes)
            , div
                  [ style "margin-top: 16px" ]
                  [ h4
                        [ style "font-size: 14px; color: #94a3b8; margin-bottom: 8px" ]
                        [ text "Status History" ]
                  , Charts.statusBar 8 (List.reverse statuses)
                  ]
            , viewHistoryTable history
            ]


viewHistoryTable : List (Dict String String) -> Html Msg
viewHistoryTable history =
    if List.isEmpty history then
        p
            [ style "color: #64748b; margin-top: 16px" ]
            [ text "No history yet — checks will appear after the first interval." ]

    else
        div
            [ style "margin-top: 16px; max-height: 300px; overflow-y: auto" ]
            [ table
                  [ class "table" ]
                  [ node
                        "thead"
                        []
                        [ tr
                              []
                              [ th [] [ text "Time" ]
                              , th [] [ text "Status" ]
                              , th [] [ text "Response" ]
                              ]
                        ]
                  , node "tbody" [] (List.map viewHistoryRow (List.take 20 history))
                  ]
            ]


viewHistoryRow : Dict String String -> Html Msg
viewHistoryRow row =
    tr
        []
        [ td
              [ style "color: #64748b; font-size: 12px" ]
              [ text (Db.field "checked_at" row) ]
        , td
              []
              [ span
                    [ class ("status-dot status-" ++ Db.field "status" row)
                    , style "margin-right: 6px"
                    ]
                    []
              , text (Db.field "status" row)
              ]
        , td [] [ text (Db.field "response_time" row ++ "ms") ]
        ]


viewNotFound : Html Msg
viewNotFound =
    div
        [ class "empty-state" ]
        [ h3 [] [ text "Monitor not found" ]
        , button
              [ onClick (Navigate DashboardPage), class "btn btn-primary" ]
              [ text "Back to Dashboard" ]
        ]
