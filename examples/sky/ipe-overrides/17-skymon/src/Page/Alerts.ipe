module Page.Alerts exposing (viewAlerts)

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onClick, onInput)
import State exposing (..)
import Lib.Db as Db
import Ui.Layout as Layout


viewAlerts : Model -> Html Msg
viewAlerts model =
    Layout.page
        model
        (div
            []
            [ h2 [ class "section-title" ] [ text "Alert Rules" ]
            , viewAddAlertForm model
            , viewAlertList model
            , viewAlertHistory model
            ])


configValue : String -> String -> Model -> String
configValue key fallback model =
    Maybe.withDefault fallback (Dict.get key model.configInput)


formField : String -> String -> String -> (String -> Msg) -> Html Msg
formField labelText placeholderText fieldValue toMsg =
    div
        [ class "form-group" ]
        [ label [ class "form-label" ] [ text labelText ]
        , input
              [ type_ "text"
              , class "form-input"
              , placeholder placeholderText
              , value fieldValue
              , onInput toMsg
              ]
        ]


viewAddAlertForm : Model -> Html Msg
viewAddAlertForm model =
    div
        [ class "card", style "margin-bottom: 24px" ]
        [ h3
              [ style "font-size: 16px; color: #f1f5f9; margin-bottom: 16px" ]
              [ text "Add Alert Rule" ]
        , formField "Metric (select by name)" "Metric name or ID" (configValue "alert_metric" "" model) InputAlertMetric
        , div
              [ style "display: grid; grid-template-columns: 1fr 1fr; gap: 16px" ]
              [ formField "Condition" "> < >= <= == != contains down" (configValue "alert_condition" "" model) InputAlertCondition
              , formField "Threshold" "100" (configValue "alert_threshold" "" model) InputAlertThreshold
              ]
        , div
              [ style "display: grid; grid-template-columns: 1fr 2fr; gap: 16px" ]
              [ formField "Notify via" "webhook, slack, or log" (configValue "alert_notify_type" "log" model) InputAlertNotifyType
              , formField "Webhook / Slack URL" "https://hooks.slack.com/services/..." (configValue "alert_notify_target" "" model) InputAlertTarget
              ]
        , button
              [ onClick AddAlert, class "btn btn-primary" ]
              [ text "Add Alert" ]
        ]


viewAlertList : Model -> Html Msg
viewAlertList model =
    if List.isEmpty model.alerts then
        div
            [ class "empty-state" ]
            [ h3 [] [ text "No alert rules yet" ]
            , p
                  []
                  [ text
                        "Add a rule to get notified when metrics cross thresholds"
                  ]
            ]

    else
        div
            []
            [ table
                  [ class "table" ]
                  [ node
                        "thead"
                        []
                        [ tr
                              []
                              [ th [] [ text "Metric" ]
                              , th [] [ text "Condition" ]
                              , th [] [ text "Threshold" ]
                              , th [] [ text "Notify" ]
                              , th [] [ text "Status" ]
                              , th [] [ text "" ]
                              ]
                        ]
                  , node "tbody" [] (List.map (viewAlertRow model) model.alerts)
                  ]
            ]


viewAlertRow : Model -> AlertRule -> Html Msg
viewAlertRow model alert =
    tr
        []
        [ td [ style "font-weight: 600" ] [ text (findMetricName alert.metricId model.metrics) ]
        , td
              [ style "color: #a78bfa; font-family: monospace" ]
              [ text alert.condition ]
        , td
              [ style "color: #38bdf8; font-weight: 600" ]
              [ text alert.threshold ]
        , td
              [ style "color: #64748b" ]
              [ text (alert.notifyType ++ ": " ++ truncate 30 alert.notifyTarget) ]
        , td [] [ viewEnabled alert.enabled ]
        , td
              []
              [ button
                    [ onClick (DeleteAlert alert.id)
                    , class "btn btn-danger btn-sm"
                    ]
                    [ text "Delete" ]
              ]
        ]


viewEnabled : Bool -> Html Msg
viewEnabled enabled =
    if enabled then
        span [ style "color: #22c55e" ] [ text "✓ Active" ]

    else
        span [ style "color: #64748b" ] [ text "Disabled" ]


findMetricName : String -> List Metric -> String
findMetricName metricId metrics =
    case metrics of

        [] ->
            metricId

        m :: rest ->
            if m.id == metricId then
                m.name

            else
                findMetricName metricId rest


truncate : Int -> String -> String
truncate maxLen s =
    if String.length s > maxLen then
        String.slice 0 maxLen s ++ "..."

    else
        s


viewAlertHistory : Model -> Html Msg
viewAlertHistory model =
    div
        [ style "margin-top: 32px" ]
        [ h2 [ class "section-title" ] [ text "Alert History" ]
        , viewAlertHistoryContent model.alertHistory
        ]


viewAlertHistoryContent : List (Dict String String) -> Html Msg
viewAlertHistoryContent history =
    if List.isEmpty history then
        div
            [ class "empty-state" ]
            [ h3 [] [ text "No alerts fired yet" ]
            , p
                  []
                  [ text
                        "Alert events will appear here when conditions are triggered"
                  ]
            ]

    else
        div
            [ style "max-height: 400px; overflow-y: auto" ]
            [ table
                  [ class "table" ]
                  [ node
                        "thead"
                        []
                        [ tr
                              []
                              [ th [] [ text "Time" ]
                              , th [] [ text "Metric" ]
                              , th [] [ text "Value" ]
                              , th [] [ text "Condition" ]
                              , th [] [ text "Notify" ]
                              ]
                        ]
                  , node "tbody" [] (List.map viewAlertHistoryRow history)
                  ]
            ]


viewAlertHistoryRow : Dict String String -> Html Msg
viewAlertHistoryRow row =
    tr
        []
        [ td
              [ style "color: #64748b; font-size: 12px" ]
              [ text (Db.field "fired_at" row) ]
        , td [ style "font-weight: 600" ] [ text (Db.field "metric_id" row) ]
        , td
              [ style "color: #ef4444; font-weight: 600" ]
              [ text (Db.field "metric_value" row) ]
        , td
              [ style "color: #a78bfa; font-family: monospace" ]
              [ text (Db.field "condition" row ++ " " ++ Db.field "threshold" row) ]
        , td
              [ style "color: #64748b" ]
              [ text (Db.field "notify_type" row) ]
        ]
