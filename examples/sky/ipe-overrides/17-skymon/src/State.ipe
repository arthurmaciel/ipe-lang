module State exposing (..)

import Ipe.Maybe exposing (..)
import Ipe.Dict as Dict
import Ipe.Error as Error exposing (Error)


-- A Web-shape Model is persisted to the session store between requests, so
-- it holds plain data only — settled monitor/metric/alert records plus the
-- raw history rows a database effect delivered through a response `Msg`.
-- The opaque `Db` handle never lives here (IPE-L0120); every effect acquires
-- its own connection through `Lib.Db.withConn`.
type alias Monitor =
    { id : String
    , name : String
    , url : String
    , interval : Int
    , status : MonitorStatus
    , responseTime : Int
    , lastChecked : String
    , visibility : Visibility
    }


type alias Metric =
    { id : String
    , name : String
    , sourceType : String
    , lastValue : String
    , lastUpdated : String
    , visibility : Visibility
    }


type alias AlertRule =
    { id : String
    , metricId : String
    , condition : String
    , threshold : String
    , notifyType : String
    , notifyTarget : String
    , enabled : Bool
    }


type alias UserSession =
    { username : String
    , avatarUrl : String
    , role : Role
    }


type alias Model =
    { page : Page
    , session : Maybe UserSession
    , monitors : List Monitor
    , metrics : List Metric
    , alerts : List AlertRule
    , notification : String
    , errorMessage : String
    , configInput : Dict String String
    , detailMonitorId : String
    , detailMetricId : String
    , monitorHistory : List (Dict String String)
    , metricHistory : List (Dict String String)
    , metricAlertHistory : List (Dict String String)
    , alertHistory : List (Dict String String)
    }


type Page
    = DashboardPage
    | MonitorDetailPage String
    | MetricDetailPage String
    | SettingsPage
    | AlertsPage
    | StatusPage
    | AuthPage
    | NotFoundPage


type Role
    = Public
    | User
    | Admin


type MonitorStatus
    = Healthy
    | Degraded
    | Down
    | Unknown


type Visibility
    = VisPublic
    | VisUser
    | VisAdmin


-- The dashboard, status, settings, and alerts pages all render the same
-- three collections, so one composed load settles them together under a
-- single response `Msg`.
type alias BoardData =
    { monitors : List Monitor
    , metrics : List Metric
    , alerts : List AlertRule
    }


-- A monitor-detail load settles as the monitor's response-time / status
-- history rows; a metric-detail load settles as its value history plus that
-- metric's fired-alert history. Both fold into the Model in one branch.
type alias MonitorDetailData =
    { history : List (Dict String String) }


type alias MetricDetailData =
    { history : List (Dict String String)
    , alertHistory : List (Dict String String)
    }


type Msg
    = Navigate Page
    | Tick
    | RefreshData
    | AddMonitor
    | DeleteMonitor String
    | AddMetric
    | DeleteMetric String
    | AddAlert
    | DeleteAlert String
    | InputMonitorName String
    | InputMonitorUrl String
    | InputMonitorVis String
    | InputMetricName String
    | InputMetricType String
    | InputMetricUrl String
    | InputMetricQuery String
    | InputMetricField String
    | InputMetricVis String
    | InputAlertMetric String
    | InputAlertCondition String
    | InputAlertThreshold String
    | InputAlertNotifyType String
    | InputAlertTarget String
    | InputAuthUsername String
    | InputAuthPassword String
    | DoSignIn
    | SignOut
    | DismissNotification
    -- ── Async responses ─────────────────────────────────────────────
    | BoardLoaded (Result Error BoardData)
    | MonitorDetailLoaded (Result Error MonitorDetailData)
    | MetricDetailLoaded (Result Error MetricDetailData)
    | AlertHistoryLoaded (Result Error (List (Dict String String)))
    | MonitorAdded (Result Error String)
    | MonitorRemoved (Result Error ())
    | MetricAdded (Result Error String)
    | MetricRemoved (Result Error ())
    | AlertAdded (Result Error String)
    | AlertRemoved (Result Error ())
    | ChecksRan (Result Error ())
