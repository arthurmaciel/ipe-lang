# The removed synchronous `Task.run` becomes chained `Task` work performed by
# the entry boundary: each stage prints via `Task.andThen`, and the
# intentional failure is caught with `Task.onError`.

[[edit]]
file: src/Main.ipe
find:
"""
main =
    let
        pipeline =
            Task.succeed "Sky"
                |> Task.andThen
                       (\name -> Task.succeed ("Hello, " ++ name ++ "!"))
                |> Task.andThen
                       (\greeting ->
                           Task.succeed
                               (greeting ++ " Task is the effect boundary."))
        successResult = Task.run pipeline
        _ = printResult "Success" successResult
        failResult =
            Task.run
                (Task.fail (Error.unexpected "intentional")
                    |> Task.andThen (\_ -> Task.succeed "unreachable"))
    in
        printResult "Fail" failResult


printResult label result =
    case result of

        Ok val ->
            Io.println (label ++ ": " ++ val)

        Err e ->
            Io.println (label ++ " error: " ++ Error.toString e)
"""
replace:
"""
main : Task Error ()
main =
    Task.succeed "Sky"
        |> Task.andThen
               (\name -> Task.succeed ("Hello, " ++ name ++ "!"))
        |> Task.andThen
               (\greeting ->
                   Task.succeed
                       (greeting ++ " Task is the effect boundary."))
        |> reportOk "Success"
        |> Task.andThen (\_ -> failDemo)


-- The intentional failure: caught with `Task.onError` and printed, so the
-- entry boundary sees a successful `Task Error ()`.
failDemo : Task Error ()
failDemo =
    Task.fail (Error.unexpected "intentional")
        |> Task.andThen (\_ -> Task.succeed "unreachable")
        |> reportOk "Fail"


-- Print a labelled success, recovering a labelled error into success so the
-- pipeline continues.
reportOk : String -> Task Error String -> Task Error ()
reportOk label task =
    task
        |> Task.andThen
               (\val ->
                   let
                       _ = Io.println (label ++ ": " ++ val)
                   in
                       Task.succeed ())
        |> Task.onError
               (\e ->
                   let
                       _ = Io.println (label ++ " error: " ++ Error.toString e)
                   in
                       Task.succeed ())
"""
