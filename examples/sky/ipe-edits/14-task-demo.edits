# Make `main` the Task the entry boundary runs, not a synchronous force.
#
# The upstream demo forced two pipelines with `Task.run` at module load — a
# removed surface (IPE-N0036) — and pattern-matched the returned `Result`. A
# Task-typed `main` is performed for you at the entry boundary. Each pipeline
# becomes a top-level function (`successDemo`/`failDemo`) so no captured Task is
# forwarded out of a closure (IPE-L0126); `main` chains them so the boundary
# performs the success print, then the fail demo whose error surfaces through
# `Task.onError`. Every print is an ordinary `Io.println` effect run in order.

[[edit]]
file: src/Main.ipe
find:
"""
main =
    let
        pipeline =
            Task.succeed "Sky"
                |> Task.andThen
                       (\name -> Task.succeed ("Hello, " ++ name ++ "!"))
                |> Task.andThen
                       (\greeting ->
                           Task.succeed
                               (greeting ++ " Task is the effect boundary."))
        successResult = Task.run pipeline
        _ = printResult "Success" successResult
        failResult =
            Task.run
                (Task.fail (Error.unexpected "intentional")
                    |> Task.andThen (\_ -> Task.succeed "unreachable"))
    in
        printResult "Fail" failResult


printResult label result =
    case result of

        Ok val ->
            Io.println (label ++ ": " ++ val)

        Err e ->
            Io.println (label ++ " error: " ++ Error.toString e)
"""
replace:
"""
main : Task Error ()
main =
    successDemo ()
        |> Task.andThen (\_ -> failDemo ())


successDemo : () -> Task Error ()
successDemo _ =
    Task.succeed "Sky"
        |> Task.andThen (\name -> Task.succeed ("Hello, " ++ name ++ "!"))
        |> Task.andThen
               (\greeting ->
                   Task.succeed (greeting ++ " Task is the effect boundary."))
        |> Task.andThen (\val -> Io.println ("Success: " ++ val))


failDemo : () -> Task Error ()
failDemo _ =
    Task.fail (Error.unexpected "intentional")
        |> Task.andThen (\_ -> Task.succeed "unreachable")
        |> Task.andThen (\val -> Io.println ("Fail: " ++ val))
        |> Task.onError
               (\e -> Io.println ("Fail error: " ++ Error.toString e))
"""
