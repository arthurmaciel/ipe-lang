# Reshape the web view to the Ipê app-shape's contract.
#
# Ipe.Tea.Web's `app` takes `view : Model -> Element msg`, but the upstream view
# builds an `Html msg` tree. Wrap the top-level view through `Ipe.Ui.html`
# (`Html a -> Element a`) — the shipped conversion — keeping the Html-building
# helpers untouched. Also make the `subscriptions` case exhaustive: the upstream
# catch-all `_ -> Sub.none` hides `AboutPage`, which Ipê rejects (IPE-T0018);
# naming the constructor forces this arm to be revisited if a page is added.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.String as String
import Ipe.Html exposing (..)
"""
replace:
"""
import Ipe.String as String
import Ipe.Ui as Ui
import Ipe.Html exposing (..)
"""

[[edit]]
file: src/Main.ipe
find:
"""
        CounterPage ->
            Time.every 1000 Tick

        _ ->
            Sub.none
"""
replace:
"""
        CounterPage ->
            Time.every 1000 Tick

        AboutPage ->
            Sub.none
"""

[[edit]]
file: src/Main.ipe
find:
"""
view model =
    div
        []
        [ styleNode [] pageStyles
"""
replace:
"""
view model =
    Ui.html (viewBody model)


viewBody : Model -> Html Msg
viewBody model =
    div
        []
        [ styleNode [] pageStyles
"""
