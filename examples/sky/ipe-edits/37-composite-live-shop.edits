# Typed pub/sub topic — Ipê's `Cmd.publish` / `Sub.subscribeTopic` take a
# `Topic a` handle, not a bare topic-name `String`, and the pub/sub payload
# carrier is `Dict String String` (the one concrete lowering for a broadcast
# payload). The upstream passes the raw string "cart" to both ends and
# broadcasts a `{ name, count }` record; Ipê rejects both (IPE-T0001: expected
# `Topic a` / `Dict String String`).
#
# Introduce a single `cartTopic : Topic (Dict String String)` in State
# (imported by both Main and Update) and pass it to `Cmd.publish` and
# `Sub.subscribeTopic`, and build the broadcast payload as a `Dict String
# String` (name + stringified count). `CartTopicReceived` then carries the
# `Dict String String` the subscriber decodes.

# `Web.app`'s `view` is `Model -> Element Msg`; the framework applies
# `Ui.layout` (empty attrs) internally. The upstream declares `view : Model ->
# any` and calls `Ui.layoutWith` itself, returning `Html` — the wildcard return
# unifies with the shape's `Element` requirement at type-check but the emit
# re-wraps the `Html` in `ui_layout`, so the emitted crate fails to compile
# (E0308: expected `Element`, found `Html`). Return the root `Element` and move
# the `wrapperAttrs` (page background + font) onto it, so the page styling is
# preserved while the framework applies the outer layout.
[[edit]]
file: src/Main.ipe
find:
"""
view : Model -> any
view model =
    Ui.layoutWith
        { wrapperAttrs = [ Background.color (Ui.rgb 250 248 244)
          , Font.family "system-ui, -apple-system, sans-serif"
          , Font.size 14
          , Font.color (Ui.rgb 30 30 36)
          ]
        , rootAttrs = []
        }
        (Ui.column
            [ Ui.width Ui.fill, Ui.spacing 24 ]
"""
replace:
"""
view : Model -> Element Msg
view model =
    Ui.column
            [ Ui.width Ui.fill
            , Ui.spacing 24
            , Background.color (Ui.rgb 250 248 244)
            , Font.family "system-ui, -apple-system, sans-serif"
            , Font.size 14
            , Font.color (Ui.rgb 30 30 36)
            ]
"""

[[edit]]
file: src/Main.ipe
find:
"""
                  [ pageBody model ]
            , Common.footer
            ])
"""
replace:
"""
                  [ pageBody model ]
            , Common.footer
            ]
"""

[[edit]]
file: src/State.ipe
find:
"""
import Ipe.List as List
import Ipe.String as String
"""
replace:
"""
import Ipe.Dict as Dict exposing (Dict)
import Ipe.List as List
import Ipe.PubSub as PubSub exposing (Topic)
import Ipe.String as String
"""

[[edit]]
file: src/State.ipe
find:
"""
cartCount : List CartItem -> Int
"""
replace:
"""
-- A single typed topic handle keyed "cart". Shared between the publisher
-- (`Cmd.publish`) and the subscriber (`Sub.subscribeTopic`) so the compiler
-- proves both ends agree on the `Dict String String` payload the broker
-- carries.
cartTopic : Topic (Dict String String)
cartTopic =
    PubSub.topic "cart"


cartCount : List CartItem -> Int
"""

[[edit]]
file: src/Update.ipe
find:
"""
import Ipe.List as List
import Ipe.String as String
"""
replace:
"""
import Ipe.Dict as Dict
import Ipe.List as List
import Ipe.String as String
"""

[[edit]]
file: src/Update.ipe
find:
"""
                        , Cmd.batch [ Cmd.publish "cart" payload ]
"""
replace:
"""
                        , Cmd.batch [ Cmd.publish cartTopic payload ]
"""

[[edit]]
file: src/Update.ipe
find:
"""
mkCartPayload : String -> Int -> { name : String
, count : Int
}
mkCartPayload name count =
    { name = name, count = count }
"""
replace:
"""
-- The broadcast payload for the cart topic: the added product's name and the
-- new cart count, carried as the `Dict String String` the pub/sub broker uses.
mkCartPayload : String -> Int -> Dict String String
mkCartPayload name count =
    Dict.fromList [ ( "name", name ), ( "count", String.fromInt count ) ]
"""

[[edit]]
file: src/Main.ipe
find:
"""
        [ Sub.every 5000 Tick, Sub.subscribeTopic "cart" CartTopicReceived ]
"""
replace:
"""
        [ Sub.every 5000 Tick, Sub.subscribeTopic cartTopic CartTopicReceived ]
"""

# `DeviceClass` (Phone | Tablet | Desktop | BigDesktop) is a closed union;
# Ipê forbids a catch-all `_` arm over it (IPE-T0018) so a future variant
# forces every `case` to be revisited. The upstream lumps every non-Phone
# class into a `_` row arm — enumerate Tablet / Desktop / BigDesktop
# explicitly, all producing the same row layout.
[[edit]]
file: src/View/Common.ipe
find:
"""
        Phone ->
            Ui.column [ Ui.spacing 16, Ui.width Ui.fill ] children

        _ ->
            Ui.row [ Ui.spacing 16, Ui.width Ui.fill ] children
"""
replace:
"""
        Phone ->
            Ui.column [ Ui.spacing 16, Ui.width Ui.fill ] children

        Tablet ->
            Ui.row [ Ui.spacing 16, Ui.width Ui.fill ] children

        Desktop ->
            Ui.row [ Ui.spacing 16, Ui.width Ui.fill ] children

        BigDesktop ->
            Ui.row [ Ui.spacing 16, Ui.width Ui.fill ] children
"""
