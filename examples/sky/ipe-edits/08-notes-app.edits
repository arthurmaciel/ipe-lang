# Drop the lawless Io.println effect discards from createUser.
#
# The upstream source calls println inside a Result-returning function,
# discarding each Task with `let _ = println …`. After the member-move pass
# rewrites these to `_ = Io.println …` bindings, they remain in a let block
# whose enclosing function is typed Result Error String — not Task. The
# rewrite_discard_bindings pass would turn them into bare do-statements, and
# those would then trigger IPE-L0141 (lawless effect discard in a non-Task
# context).
#
# The fix removes the _ = Io.println lines before the discard-rewrite pass
# sees them, collapsing createUser back to a plain let … in form. The Io
# import is also removed since no other function in this file uses it.
#
# NOTE: this edit runs before rewrite_discard_bindings (mirror.sh Step 3),
# so the find anchor must match the post-member-move, pre-discard-rewrite form
# (i.e. `_ = Io.println ...` in a let block, not bare do-statements).

[[edit]]
file: src/Lib/Auth.ipe
find:
"""
import Ipe.Io as Io
"""
replace:
"""
"""

[[edit]]
file: src/Lib/Auth.ipe
find:
"""
        _ = Io.println ""
        _ = Io.println "=========================================="
        _ = Io.println "[Email Service] New user registration"
        _ = Io.println ("[Email Service] To: " ++ email)
        _ = Io.println "[Email Service] Verify your email at:"
        _ = Io.println ("  http://localhost:8000/auth/verify?token=" ++ token)
        _ = Io.println "=========================================="
        _ = Io.println ""
"""
replace:
"""
"""
