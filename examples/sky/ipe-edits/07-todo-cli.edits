# Keep the doc comment accurate after the println move.
#
# println/eprintln moved from Std.Log to Ipe.Io (imported as Io), so the code
# call site is Io.println. This comment names that identifier, so requalify it to
# match — the transform rewrites code only and never touches a comment, so a
# documentary reference to a moved value is corrected here.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.System
import Ipe.Io as Io
"""
replace:
"""
import Ipe.System
import Ipe.Io as Io
import Ipe.Log as Log
import Ipe.String as String
"""

[[edit]]
file: src/Main.ipe
find:
"""
                           -- single `println` call fires the side
"""
replace:
"""
                           -- single `Io.println` call fires the side
"""

[[edit]]
file: src/Main.ipe
find:
"""
-- We force the chain with Task.run at the entry point — runtime's
-- main-auto-run only fires for top-level `main : Task` exports, but
-- the codegen for that path is fragile under the current effect-
-- boundary migration; explicit Task.run is the reliable form for
-- CLI entry points.
main =
    let
        -- System.args is Task Error (List String) after the
        -- v1.0 Task-everywhere migration. Force at the
        -- read site for ergonomic let-binding access.
        pipeline =
            Db.connect () |> Task.andThen runApp |> Task.onError reportError
        _ = Task.run pipeline
    in
        ()


runApp : Db -> Task Error ()
runApp conn =
    initDb conn
        |> Task.andThen
               (\_ ->
                   let
                       userArgs =
                           System.args () |> Task.run |> Result.withDefault []
                       cmd = getArg userArgs
                       cmdArg = getArg (List.drop 1 userArgs)
                   in
                       runCommand conn cmd cmdArg)
"""
replace:
"""
-- The whole CLI is one `Task Error ()` chain performed by the entry
-- boundary: open the DB, run the chosen command, and route any failure to
-- `reportError`.
main : Task Error ()
main =
    Db.connect () |> Task.andThen runApp |> Task.onError reportError


runApp : Db -> Task Error ()
runApp conn =
    initDb conn
        |> Task.andThen (\_ -> System.args ())
        |> Task.andThen
               (\userArgs ->
                   let
                       cmd = getArg userArgs
                       cmdArg = getArg (List.drop 1 userArgs)
                   in
                       runCommand conn cmd cmdArg)
"""
