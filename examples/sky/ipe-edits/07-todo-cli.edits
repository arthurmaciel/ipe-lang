find:
"""
    initDb conn
        |> Task.andThen
               (\_ ->
                   let
                       userArgs =
                           System.args () |> Task.run |> Result.withDefault []
                       cmd = getArg userArgs
                       cmdArg = getArg (List.drop 1 userArgs)
                   in
                       runCommand conn cmd cmdArg)
"""
replace:
"""
    initDb conn
        |> Task.andThen
               (\_ ->
                   System.args ()
                       |> Task.andThen
                              (\userArgs ->
                                  let
                                      cmd = getArg userArgs
                                      cmdArg = getArg (List.drop 1 userArgs)
                                  in
                                      runCommand conn cmd cmdArg))
"""

