# Fix two import gaps exposed by Ipê's stricter scope rules.
#
# 1. Ui/Charts.ipe: a type annotation references Msg from State without importing
#    it. Add the import.
# 2. Lib/Auth.ipe: upstream Sky used System.loadEnv "KEY" as a single-key env
#    lookup (Sky's old API). Ipê's System.loadEnv loads a .env FILE (takes ());
#    the correct function is System.getenv : String -> Task Error String. Add the
#    import and rename all three call sites.

[[edit]]
file: src/Ui/Charts.ipe
find:
"""
import Ipe.Html.Attributes exposing (..)
"""
replace:
"""
import Ipe.Html.Attributes exposing (..)
import State exposing (Msg)
"""

[[edit]]
file: src/Lib/Auth.ipe
find:
"""
import Ipe.Io as Io
"""
replace:
"""
import Ipe.Io as Io
import Ipe.System as System
"""

[[edit]]
file: src/Lib/Auth.ipe
find:
"""
System.loadEnv "GITHUB_CLIENT_ID"
"""
replace:
"""
System.getenv "GITHUB_CLIENT_ID"
"""

[[edit]]
file: src/Lib/Auth.ipe
find:
"""
System.loadEnv "GITHUB_CLIENT_SECRET"
"""
replace:
"""
System.getenv "GITHUB_CLIENT_SECRET"
"""

[[edit]]
file: src/Lib/Auth.ipe
find:
"""
System.loadEnv "SKYMON_ADMINS"
"""
replace:
"""
System.getenv "SKYMON_ADMINS"
"""
