# The desktop WebView shape is `Ipe.Tea.WebView.app`, whose view type is
# `Model -> Element Msg`. This spike paints raw DOM (a Three.js canvas mount plus
# vendored <script> tags), so its `Html` tree is reached through the raw-HTML
# escape `Ui.html : Html msg -> Element msg` — the sanctioned way to drop direct
# DOM into the portable `Element` view. The `Std.Webview` -> `Ipe.WebView` prefix
# rewrite lands on the removed `Ipe.WebView` (no `Tea` segment); requalify the
# import onto `Ipe.Tea.WebView` and call the shipped `app` entry.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.Task as Task
import Ipe.WebView as Webview
import Ipe.Tea.WebView.Cmd as Cmd
import Ipe.Tea.WebView.Sub as Sub
import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
"""
replace:
"""
import Ipe.Task as Task
import Ipe.Tea.WebView as WebView
import Ipe.Tea.WebView.Cmd as Cmd
import Ipe.Tea.WebView.Sub as Sub
import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
"""

[[edit]]
file: src/Main.ipe
find:
"""
view : Model -> any
view _ =
    Html.node
        "div"
        [ Attr.id "scene-root" ]
"""
replace:
"""
view : Model -> Element Msg
view _ =
    -- Raw DOM (the Three.js canvas mount + vendored <script> tags) reaches the
    -- portable `Element` view through the `Ui.html` raw-HTML escape.
    Ui.html
        (Html.node
        "div"
        [ Attr.id "scene-root" ]
"""

[[edit]]
file: src/Main.ipe
find:
"""
        , Html.script [ Attr.src "/static/three.min.js" ] []
        , Html.script [ Attr.src "/static/scene.js" ] []
        ]
"""
replace:
"""
        , Html.script [ Attr.src "/static/three.min.js" ] []
        , Html.script [ Attr.src "/static/scene.js" ] []
        ]
        )
"""

[[edit]]
file: src/Main.ipe
find:
"""
    Webview.app
"""
replace:
"""
    WebView.app
"""
