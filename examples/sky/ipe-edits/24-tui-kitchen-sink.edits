# Remap onto the shipped Terminal shape.
#
# Upstream drove one Element view under both Sky.Tui and Sky.Live, choosing the
# backend from argv at module load with a synchronous `Task.run`. Ipê removes
# synchronous `Task.run` (IPE-N0036) and a module proves exactly one TEA shape
# from its `main` entry (IPE-N0035), so the argv multiplexer collapses to a
# single `Terminal.appScreen` app — the entry that matches an `Element` view
# driven by `onKey`. The whole view is unchanged; only the imports, the `init`
# argument type (`appScreen` pins `init : () -> …`), and `main` are reshaped.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.List as List
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tui as Tui
import Ipe.Tea.Web as Live
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
"""
replace:
"""
import Ipe.String as String
import Ipe.System as System
import Ipe.Tea.Terminal as Terminal
import Ipe.Tea.Terminal.Cmd as Cmd
import Ipe.Tea.Terminal.Sub as Sub
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
"""

