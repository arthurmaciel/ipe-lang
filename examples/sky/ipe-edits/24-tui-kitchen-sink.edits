find:
"""
view : Model -> Element Msg
view model =
    viewBody model


{- Sky.Live renders Std.Ui via `Ui.layout [] body`, which wraps the
   element in the host HTML scaffolding (head / body / inline style
   block). Tui doesn't need this — it paints directly into cells.
   Same `viewBody` feeds both.
-}
viewLive : Model -> any
viewLive model =
    Ui.layout [] (viewBody model)
"""
replace:
"""
view : Model -> Element Msg
view model =
    viewBody model
"""

[[edit]]
file: src/Main.ipe
find:
"""
argsList : List String
argsList =
    System.args () |> Task.run |> Result.withDefault []

type Page
    = KitchenSink


main =
    case List.head argsList of

        Just "live" ->
            Live.app
                { init = init
                , update = update
                , view = viewLive
                , subscriptions = subscriptions
                , routes = [ Live.route "/" KitchenSink ]
                , notFound = KitchenSink
                }

        _ ->
            Tui.app
                { init = init
                , update = update
                , view = view
                , subscriptions = subscriptions
                , onKey = onKey
                , routes = []
                , notFound = ()
                }
"""
replace:
"""
main =
    Terminal.appScreen
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }
"""
