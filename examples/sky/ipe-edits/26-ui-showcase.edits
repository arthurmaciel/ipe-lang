# Adopt Ipê's prescriptive web-app `init` signature and re-home `Cmd`/`Sub`.
#
# Upstream Sky leaves the web app's init argument a free type variable, so
# `init : {} -> ( Model, Cmd Msg )` is accepted. Ipê pins the argument to the
# typed opaque `WebReq` (the app requires `init : WebReq -> ( Model, Cmd Msg )`),
# a sanctioned make-invalid-states-unrepresentable divergence recorded as B24 in
# docs/divergences-from-sky.md and ADR 0021. The init body ignores the request,
# so the change is signature-only. `Cmd`/`Sub` came from Sky's Prelude; in Ipê
# they re-home to `Ipe.Tea.Web.Cmd` / `Ipe.Tea.Web.Sub`, so add those imports.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.Ui.Font as Font
import RegressionGates
"""
replace:
"""
import Ipe.Ui.Font as Font
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import RegressionGates
"""

[[edit]]
file: src/Main.ipe
find:
"""
init : {  } -> ( Model, Cmd Msg )
"""
replace:
"""
init : WebReq -> ( Model, Cmd Msg )
"""

[[edit]]
file: src/Main.ipe
find:
"""
view : Model -> any
view model =
"""
replace:
"""
view : Model -> Element Msg
view model =
"""

[[edit]]
