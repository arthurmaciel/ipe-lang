# Sky's `Task.perform` (removed in Ipê) ran a task and returned its result in
# direct style. The converter leaves it verbatim because there is no general
# syntactic rule — the fix is structural: rewrite the whole `main` body to use
# `do` with `<-` binds (desugaring to `Task.andThen`), building each task list
# independently to avoid a non-Clone capture across the `andThen` closures.

[[edit]]
file: src/Main.ipe
find:
"""
main =
    let
        tasks =
            [ expensiveTask 1
            , expensiveTask 2
            , expensiveTask 3
            , expensiveTask 4
            , expensiveTask 5
            ]
        seqResults = Task.perform (Task.sequence tasks)
        parResults = Task.perform (Task.parallel tasks)
        _ = Io.println "Sequential done"
        _ = Io.println "Parallel done"
        _ = seqResults
        _ = parResults
    in
        ()
"""
replace:
"""
main =
    do
        _ <- Task.sequence
            [ expensiveTask 1
            , expensiveTask 2
            , expensiveTask 3
            , expensiveTask 4
            , expensiveTask 5
            ]
        _ <- Task.parallel
            [ expensiveTask 1
            , expensiveTask 2
            , expensiveTask 3
            , expensiveTask 4
            , expensiveTask 5
            ]
        Io.println "Sequential done"
        Io.println "Parallel done"
"""
