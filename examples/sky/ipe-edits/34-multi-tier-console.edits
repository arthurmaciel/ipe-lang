# Reshape the web view to the Ipê app-shape's contract.
#
# Ipe.Tea.Web's `app` takes `view : Model -> Element msg`, but the upstream view
# builds an `Html msg` tree. Wrap the top-level view through `Ipe.Ui.html`
# (`Html a -> Element a`) — the shipped conversion — keeping the Html-building
# helper (`viewBody`) untouched.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.String as String
import Ipe.Tea.Web.Cmd as Cmd
"""
replace:
"""
import Ipe.String as String
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd as Cmd
"""

# Drop Log.* discards from the TEA update function.
#
# The upstream Sky source calls Log.infoWith / Log.errorWith inside `update`
# branches, discarding the Task with `let _ = ... in result`. Sky's runtime
# ran discarded Tasks eagerly; Ipê's TEA update returns (Model, Cmd Msg) —
# not a Task — so a discarded Task here is IPE-L0141 (lawless effect discard).
#
# The fix drops the Log.* calls entirely. In Ipê's TEA architecture side-effects
# in update are expressed through Cmd values, not direct Task execution.
[[edit]]
file: src/Main.ipe
find:
"""
        Navigate page ->
            let
                _ =
                    Log.infoWith
                        "navigate"
                        [ "from", pageLabel model.page, "to", pageLabel page ]
            in
                ( { model | page = page }, Cmd.none )
"""
replace:
"""
        Navigate page ->
            ( { model | page = page }, Cmd.none )
"""

