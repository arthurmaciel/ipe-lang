# Remap onto the shipped WebView shape.
#
# Upstream rendered one view across Sky.Live, Sky.Tui, and Sky.Webview, choosing
# the backend from argv at module load with a synchronous `Task.run`. Two shipped
# constraints make that multiplexer inexpressible in Ipê: synchronous `Task.run`
# is removed (IPE-N0036), and a module proves exactly one TEA shape from its
# `main` entry — a `case`/`if` `main` that head-calls several shape entries reads
# as a Program importing a shape and is rejected (IPE-N0033/N0035). So the app
# collapses to a single `WebView.app`, whose `view : Model -> Element msg` is the
# module's existing `viewElement` (the framework applies `Ui.layout` internally,
# so `View.view`'s outer wrap is not used). The shared `State` / `Update` / `View`
# modules are untouched; the day index seeds from a fixed constant now that the
# module-load clock read is gone.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.List as List
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Tea.WebView.Cmd as Cmd
import Ipe.Tea.Web as Live
import Ipe.Tea.WebView.Sub as Sub
import Ipe.Tea.WebView.Sub exposing (Sub)
import Ipe.Tui as Tui
import Ipe.WebView as Webview
import Head
import State exposing (..)
import Update exposing (update)
import View exposing (view, viewElement)
"""
replace:
"""
import Ipe.Tea.WebView as WebView
import Ipe.Tea.WebView.Cmd as Cmd
import Ipe.Tea.WebView.Sub as Sub
import Ipe.Tea.WebView.Sub exposing (Sub)
import State exposing (..)
import Update exposing (update)
import View exposing (viewElement)
"""

[[edit]]
file: src/Main.ipe
find:
"""
-- Read `Time.now ()` once at module load (Task.run synchronously
-- forces it) so `init` doesn't need to thread Cmd.perform for the
-- initial day index. `todayIndex` is `unix-millis / 86_400_000`,
-- i.e. a whole-day count since the Unix epoch.
todayIndex : Int
todayIndex =
    let
        nowMs = currentMillis
        millisPerDay = 86400000
    in
        nowMs // millisPerDay


currentMillis : Int
currentMillis =
    Result.withDefault 0 (Task.run (Time.unixMillis ()))


-- The dispatch: read argv once and pick the right backend.
argsList : List String
argsList =
    Result.withDefault [] (Task.run (System.args ()))


-- ─── main ───────────────────────────────────────────────────────────
main =
    case List.head argsList of

        Just "--tui" ->
            Tui.app
                { init = init
                , update = update
                , view = viewElement
                , subscriptions = subscriptions
                , onKey = onKey
                }
                |> Task.run

        Just "--webview" ->
            Webview.app
                { init = init
                , update = update
                , view = view
                , subscriptions = subscriptions
                , window = { title = "Sky Habits", size = ( 960, 720 ) }
                }
                |> Task.run

        _ ->
            Live.app
                { init = init
                , update = update
                , view = view
                , subscriptions = subscriptions
                , routes = [ Live.route "/" HomePage ]
                , notFound = HomePage
                , head = Head.headFor
                }
                |> Task.run

-- Single page constructor — the Live branch uses Page (an ADT
-- with one variant) so Live.app's `routes` field stays well-typed.
-- Tui + Webview ignore routing.
type Page
    = HomePage

-- Tui-only key handler. `q` exits the process (runtime's
-- top-level recover handles cleanup); everything else falls
-- through to Tick (the harmless model-touch Msg). In-tree
-- button + checkbox events arrive via Tab+Enter as usual.
type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey k =
    if k.kind == "char" && k.value == "q" then
        QuitTui

    else if k.kind == "ctrl" && k.value == "c" then
        QuitTui

    else
        NoOp
"""
replace:
"""
-- A whole-day count since the Unix epoch. The showcase seeds its habit
-- history relative to this index; a fixed value keeps the seeded chart
-- deterministic across runs.
todayIndex : Int
todayIndex =
    20000


-- ─── main ───────────────────────────────────────────────────────────
main =
    WebView.app
        { init = init
        , update = update
        , view = viewElement
        , subscriptions = subscriptions
        , window = { title = "Ipê Habits", size = ( 960, 720 ) }
        }
"""
