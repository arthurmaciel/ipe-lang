# The desktop WebView shape is `Ipe.Tea.WebView.app`: upstream Sky's
# `Std.Webview` maps to `Ipe.Tea.WebView`. The `Std.` -> `Ipe.` prefix rewrite
# lands on the removed `Ipe.WebView` (no `Tea` segment); requalify the import
# onto `Ipe.Tea.WebView` and call the shipped `app` entry.
#
# The view type is `Model -> Element Msg`: the framework applies `Ui.layout`
# internally to render into the window, so the port drops the explicit outer
# `Ui.layout` wrapper (which returned `Html`) and returns the `Ui.column`
# `Element` directly — moving the window-frame attributes (background + base font
# colour) onto that column, exactly as the sibling `22-tui-stopwatch-ui` does.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.WebView as Webview
"""
replace:
"""
import Ipe.Tea.WebView as WebView
import Ipe.Ui exposing (Element)
"""

[[edit]]
file: src/Main.ipe
find:
"""
view : Model -> Html
view model =
    Ui.layout
        [ Background.color (Ui.rgb 24 28 48), Font.color (Ui.rgb 220 220 230) ]
        (Ui.column
            [ Ui.padding 32, Ui.spacing 16 ]
"""
replace:
"""
view : Model -> Element Msg
view model =
    Ui.column
            [ Ui.padding 32
            , Ui.spacing 16
            , Background.color (Ui.rgb 24 28 48)
            , Font.color (Ui.rgb 220 220 230)
            ]
"""

[[edit]]
file: src/Main.ipe
find:
"""
            , Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text "Click the buttons or close the window to quit.")
            ])
"""
replace:
"""
            , Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text "Click the buttons or close the window to quit.")
            ]
"""

[[edit]]
file: src/Main.ipe
find:
"""
    Webview.app
"""
replace:
"""
    WebView.app
"""
