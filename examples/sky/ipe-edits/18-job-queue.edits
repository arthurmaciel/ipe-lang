# Add type annotations for two polymorphic view helpers and the missing
# `Ipe.Log` import.
#
# After the token rewrite, viewJob and viewSnapshot remain fully polymorphic
# because their record-field access is consistent with multiple types; Ipê
# reports IPE-L0102. Add explicit annotations so the type-checker can
# monomorphise them. Upstream imported `Std.Log exposing (println)`; `println`
# moved to `Ipe.Io`, but the code still calls `Log.errorWith`, so re-add the
# `Ipe.Log` import the rewrite dropped.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.Tea.Web.Sub as Sub
"""
replace:
"""
import Ipe.Tea.Web.Sub as Sub
import Ipe.Log as Log
import Ipe.Ui as Ui
"""

