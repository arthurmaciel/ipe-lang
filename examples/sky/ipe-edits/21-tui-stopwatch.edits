# The full-screen TUI shape is `Ipe.Tea.Terminal.appScreen`. Upstream Sky's
# `Std.Tui.program` drove a full-screen keystroke loop with a raw `String` view;
# the shipped `appScreen` view type is `Model -> Element Msg`. This banner is raw
# painted text with no `Ipe.Ui` layout, so it maps to a single `Ui.cells` island:
# the banner string is split into lines and each line becomes a row of characters
# painted verbatim to the terminal. `Ui.cells` is terminal-only, exactly the
# right primitive for a hand-drawn ASCII banner.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.Tui as Tui
import Ipe.Tea.Terminal.Cmd as Cmd
import Ipe.Tea.Terminal.Sub as Sub
"""
replace:
"""
import Ipe.List as List
import Ipe.Tea.Terminal as Terminal
import Ipe.Tea.Terminal.Cmd as Cmd
import Ipe.Tea.Terminal.Sub as Sub
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
"""

[[edit]]
file: src/Main.ipe
find:
"""
view : Model -> String
view model =
    let
        time =
            formatElapsed model.elapsedMs

        status =
            if model.running then
                "[ running ]"

            else
                "[ paused  ]"
    in
        "\r\n"
            ++ "  ╭───────────────────────────────╮\r\n"
            ++ "  │       Sky TUI Stopwatch       │\r\n"
            ++ "  ╰───────────────────────────────╯\r\n"
            ++ "\r\n"
            ++ "        " ++ time ++ "\r\n"
            ++ "        " ++ status ++ "\r\n"
            ++ "\r\n"
            ++ "    space  start / pause\r\n"
            ++ "    r      reset\r\n"
            ++ "    q      quit\r\n"
"""
replace:
"""
view : Model -> Element Msg
view model =
    let
        time =
            formatElapsed model.elapsedMs

        status =
            if model.running then
                "[ running ]"

            else
                "[ paused  ]"

        banner =
            "\n"
                ++ "  ╭───────────────────────────────╮\n"
                ++ "  │       Sky TUI Stopwatch       │\n"
                ++ "  ╰───────────────────────────────╯\n"
                ++ "\n"
                ++ "        " ++ time ++ "\n"
                ++ "        " ++ status ++ "\n"
                ++ "\n"
                ++ "    space  start / pause\n"
                ++ "    r      reset\n"
                ++ "    q      quit\n"
    in
    -- The banner is hand-drawn text with no `Ipe.Ui` layout, so it maps to a
    -- single raw `Ui.cells` island: one row of characters per line.
    Ui.cells (List.map String.toList (String.lines banner))
"""

[[edit]]
file: src/Main.ipe
find:
