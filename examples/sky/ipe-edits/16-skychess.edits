# Add missing State imports for type annotations that reference Model/Msg.
#
# Three files carry type annotations referencing Model or Msg from State without
# importing it; Sky's type-checker inferred the types, but Ipê requires the
# import to be in scope. Add the minimal import to each site.
#
# GameLogic.ipe also calls println without importing Std.Log — upstream Sky had
# it in transitive scope. In Ipê println lives in Ipe.Io, so add `import Ipe.Io as
# Io` and qualify the five call sites. The doc comment naming println is
# requalified too, so it matches the code (the transform never edits a comment).

[[edit]]
file: src/Chess/Move.ipe
find:
"""
import Chess.Board as Board
"""
replace:
"""
import Chess.Board as Board
import State exposing (Model)
"""

[[edit]]
file: src/Chess/Ai.ipe
find:
"""
import Chess.Eval as Eval
"""
replace:
"""
import Chess.Eval as Eval
import State exposing (Model)
"""

[[edit]]
file: src/Lib/GameLogic.ipe
find:
"""
import Lib.Games as Games
"""
replace:
"""
import Lib.Games as Games
import State exposing (Model, Msg)
"""

[[edit]]
file: src/Lib/GameLogic.ipe
find:
"""
-- error-recovery flow); chess uses println so the failure shows in
"""
replace:
"""
-- error-recovery flow); chess uses Io.println so the failure shows in
"""

[[edit]]
file: src/Lib/GameLogic.ipe
find:
"""
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
"""
replace:
"""
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
import Ipe.Io as Io
"""

[[edit]]
file: src/Lib/GameLogic.ipe
find:
"""
                    println
                        ("[CHESS][persist-fail] " ++ tag ++ ": "
"""
replace:
"""
                    Io.println
                        ("[CHESS][persist-fail] " ++ tag ++ ": "
"""

