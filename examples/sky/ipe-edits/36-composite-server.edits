file: src/Main.ipe
find:
"""
                                  let
                                      _ =
                                          Io.println
                                              ("Applied "
                                                  ++ String.fromInt
                                                         (List.length applied)
                                                  ++ " migration(s)")
                                      _ =
                                          List.map
                                              (\n -> Io.println ("  - " ++ n))
                                              applied
                                  in
                                      Db.close db))
"""
replace:
"""
                                  let
                                      count = List.length applied
                                  in
                                      do
                                          Io.println
                                              ("Applied "
                                                  ++ String.fromInt count
                                                  ++ " migration(s)")
                                          Task.sequence
                                              (List.map
                                                  (\n -> Io.println ("  - " ++ n))
                                                  applied)
                                              |> Task.map (\_ -> ())
                                          Db.close db))
"""

