"""
    Crypto.randomToken 4
        |> Task.andThen
               (\errId ->
                   Log.errorWith
                       op
                       [ ( "errId", errId )
                       , ( "error", Error.toString e )
                       ]
                       |> Task.andThen
                              (\_ ->
                                   Task.succeed
                                       (errorJson
                                           500
                                           ("internal error (ref " ++ errId ++ ")"))))
"""
