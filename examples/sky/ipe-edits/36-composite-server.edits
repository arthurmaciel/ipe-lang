# Rename the Sky-branded configuration env vars to Ipê's convention.
# Fix Server.ipe: the let-block mixes function bindings (cors h = ...) with a
# discarded Task (Log.infoWith).  The discard rewriter turns the whole let into
# a do-block where function-binding syntax is invalid (IPE-P0001).  Replace
# with a let...in wrapping a do that sequences only the two Task steps.
#
# Fix Main.ipe: runMigrate's let-block has two discards — Io.println and
# List.map — which the rewriter converts to a do-block.  List.map returns
# List (Task ()), not Task, so it fails IPE-T0001.  Replace with
# Task.sequence so every print is sequenced.  Also hoist List.length applied
# to a let binding to avoid a move-after-use borrow in emitted Rust.
#
# Fix Routes/Auth.ipe: logAndFail's do-block uses errId twice in the same
# closure; the Rust emitter moves it on first use.  Replace with a pipeline
# where Log.errorWith chains via Task.andThen into Task.succeed, so each
# closure captures errId exactly once.
#
# The port reads its JWT secret, DB path, and port from SKY_*-prefixed env vars.
# Ipê ships Ipe.Auth reading IPE_AUTH_TOKEN_SECRET, and the examples-sweep sets
# that name, so the SKY_ names never resolve — the server sees an empty secret,
# fails its `>= 32 bytes` guard closed, and never serves. Rename every SKY_
# config var (in code, comments, and error text) to its IPE_ equivalent so the
# port is Ipê-native and boots under the standard secret.

[[edit]]
file: src/Main.ipe
all: true
find:
"""
SKY_AUTH_TOKEN_SECRET
"""
replace:
"""
IPE_AUTH_TOKEN_SECRET
"""

[[edit]]
file: src/Main.ipe
all: true
find:
"""
SKY_COMPOSITE_DB
"""
replace:
"""
IPE_COMPOSITE_DB
"""

[[edit]]
file: src/Main.ipe
all: true
find:
"""
SKY_COMPOSITE_PORT
"""
replace:
"""
IPE_COMPOSITE_PORT
"""

[[edit]]
file: src/Server.ipe
find:
"""
run cfg bootMs db cache =
    let
        -- Explicit lambdas around partial applications dodge defensive
        -- constraint #463 (3-arg typed FFI kernel partial-application
        -- miscompile) and keep the wrapping shape obvious.
        cors h = Middleware.withCors cfg.corsOrigins h
        -- Two-layer middleware stack: CORS + structured request logging.
        -- We intentionally compose via the runtime kernel rather than
        -- through `Sky.Http.Middleware`'s `Handler -> Handler` shape
        -- (which the stdlib leaves an undeclared free type variable —
        -- see Middleware.sky for the typed re-binding).
        wrap h = cors (Middleware.withLogging h)
        -- Per-request rate limit is enforced at the handler boundary
        -- via `RateLimit.allow` rather than `Middleware.withRateLimit`
        -- because the latter's runtime cast (`task.(func() any)()`) is
        -- incompatible with the typed `SkyTask[Error, Response_R]`
        -- shape that handlers emit under v0.15 type-directed lowering.
        guarded h =
            wrap (rateLimit "api" cfg.rateLimitCapacity cfg.rateLimitRefill h)
        _ =
            Log.infoWith
                "server.starting"
                [ ( "port", String.fromInt cfg.port )
                , ( "rateLimitProbe", probeRateLimit )
                ]
        -- Sky.Http.Server's net/http-based dispatcher routes by path
        -- only (Route.Method is captured but unused in Server_listen).
        -- We dispatch GET vs POST on the same /api/todos pathname here.
        todosByMethod req =
            if req.method == "POST" then
                TodosRoutes.handleCreate cfg db req

            else
                TodosRoutes.handleList cfg db req
    in
        HttpServer.listen
            cfg.port
            [ HttpServer.api
                  "POST /api/register"
                  (wrap (AuthRoutes.handleRegister cfg db))
            , HttpServer.api
                  "POST /api/login"
                  (wrap (AuthRoutes.handleLogin cfg db))
            , HttpServer.api "/api/todos" (guarded todosByMethod)
            , HttpServer.api
                  "DELETE /api/todos/:id"
                  (guarded (TodosRoutes.handleDelete cfg db))
            -- Streaming responses bypass the middleware wrap.  Both
            -- `Middleware.withLogging` and `Middleware.withCors`
            -- consume the stream-handler sentinel token while peeking
            -- at the response status, but never re-emit it onto the
            -- returned SkyResult — the dispatcher then sees a bare
            -- "__sky_stream:N" Body with no StreamHandler attached and
            -- writes it as a plain text response.  Exporting outside
            -- the wrap preserves the chunked-write path.
            , HttpServer.api
                  "GET /api/export.csv"
                  (HealthRoutes.handleExport cfg db)
            , HttpServer.api
                  "GET /api/health"
                  (wrap (HealthRoutes.handleHealth cache bootMs))
            ]
"""
replace:
"""
run cfg bootMs db cache =
    let
        -- Explicit lambdas around partial applications keep the
        -- wrapping shape obvious and avoid partial-application
        -- miscompile in 3-arg typed FFI kernels.
        cors h =
            Middleware.withCors cfg.corsOrigins h

        -- Two-layer middleware stack: CORS + structured request logging.
        wrap h =
            cors (Middleware.withLogging h)

        -- Per-request rate limit enforced at the handler boundary.
        guarded h =
            wrap (rateLimit "api" cfg.rateLimitCapacity cfg.rateLimitRefill h)

        -- Dispatch GET vs POST on the same /api/todos pathname.
        todosByMethod req =
            if req.method == "POST" then
                TodosRoutes.handleCreate cfg db req

            else
                TodosRoutes.handleList cfg db req
    in
        do
            Log.infoWith
                "server.starting"
                [ ( "port", String.fromInt cfg.port )
                , ( "rateLimitProbe", probeRateLimit )
                ]
            HttpServer.listen
                cfg.port
                [ HttpServer.api
                      "POST /api/register"
                      (wrap (AuthRoutes.handleRegister cfg db))
                , HttpServer.api
                      "POST /api/login"
                      (wrap (AuthRoutes.handleLogin cfg db))
                , HttpServer.api "/api/todos" (guarded todosByMethod)
                , HttpServer.api
                      "DELETE /api/todos/:id"
                      (guarded (TodosRoutes.handleDelete cfg db))
                -- Streaming responses bypass the middleware wrap to
                -- preserve the chunked-write path.
                , HttpServer.api
                      "GET /api/export.csv"
                      (HealthRoutes.handleExport cfg db)
                , HttpServer.api
                      "GET /api/health"
                      (wrap (HealthRoutes.handleHealth cache bootMs))
                ]
"""

