# Add the explicit Ipe.String import the transform cannot supply.
#
# Upstream reaches String.* through `import Sky.Core.Prelude exposing (..)`, which
# the transform drops (Ipê has no Prelude — its Tier-A Ipe.Basics surface is
# auto-imported, ADR 0047). Ipe.String is not in that auto-imported set, so the
# String.* uses need an explicit import. Anchor on the retained Ipe.Io import.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.Io as Io
"""
replace:
"""
import Ipe.Io as Io
import Ipe.String as String
"""
