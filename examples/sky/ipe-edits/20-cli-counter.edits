# The line-oriented CLI shape is `Ipe.Tea.Terminal.appLines`: upstream Sky's
# `Std.Cli` line-mode TEA backend is the Terminal shape's line entry. The
# `Std.` -> `Ipe.` prefix rewrite lands on the removed `Ipe.Cli`; requalify the
# import onto `Ipe.Tea.Terminal` and call the shipped `appLines` entry. The cfg
# record already matches `appLines` (view : Model -> String, onLine).

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.Cli as Cli
"""
replace:
"""
import Ipe.Tea.Terminal as Terminal
"""

[[edit]]
file: src/Main.ipe
find:
"""
    Cli.program
"""
replace:
"""
    Terminal.appLines
"""
