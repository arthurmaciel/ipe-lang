# Ipê's `HttpRequest.method` is the closed `HttpMethod` ADT
# (make-invalid-states-unrepresentable), not a raw `String` as upstream Sky
# modelled it. Alias the `Ipe.Http` module and use its `Get` constructor.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.Http exposing (HttpRequest)
"""
replace:
"""
import Ipe.Http as Http exposing (HttpRequest)
"""

[[edit]]
file: src/Main.ipe
find:
"""
    { method = "GET"
"""
replace:
"""
    { method = Http.Get
"""
