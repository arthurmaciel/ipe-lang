# Add the explicit Ipe.Maybe import the transform cannot supply.
#
# Upstream reaches Maybe.withDefault through `import Sky.Core.Prelude exposing
# (..)`, which the transform drops (Ipê has no Prelude — its Tier-A Ipe.Basics
# surface is auto-imported, ADR 0047). Ipe.Maybe is not in that auto-imported set,
# so the Maybe.* use needs an explicit import. Anchor on the retained Ipe.String
# import.

[[edit]]
file: src/Main.ipe
find:
"""
import Ipe.String as String
"""
replace:
"""
import Ipe.String as String
import Ipe.Maybe as Maybe
"""
