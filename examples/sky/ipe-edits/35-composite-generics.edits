file: src/Compute.ipe
find:
"""
        wordTokens = Regex.findAll "[a-z]+" haystack
        sanitised = List.map (\tok -> Regex.replace "-" "_" tok) wordTokens
    in
        sanitised
"""
replace:
"""
        wordTokens = matchesAll "[a-z]+" haystack
        sanitised = List.map (\tok -> replaceAll "-" "_" tok) wordTokens
    in
        sanitised


-- The compiled-`Regex` surface, wrapped for a static literal pattern. An
-- invalid pattern conservatively yields no match / no-op rather than a
-- silent false positive.
matches : String -> String -> Bool
matches pattern haystack =
    case Regex.compile pattern of

        Ok re ->
            Regex.match re haystack

        Err _ ->
            False


matchesAll : String -> String -> List String
matchesAll pattern haystack =
    case Regex.compile pattern of

        Ok re ->
            Regex.findAll re haystack

        Err _ ->
            []


replaceAll : String -> String -> String -> String
replaceAll pattern replacement haystack =
    case Regex.compile pattern of

        Ok re ->
            Regex.replace re replacement haystack

        Err _ ->
            haystack
"""

