find:
"""
        wordTokens = Regex.findAll "[a-z]+" haystack
        sanitised = List.map (\tok -> Regex.replace "-" "_" tok) wordTokens
"""
replace:
"""
        wordTokens = findAllOf "[a-z]+" haystack
        sanitised = List.map (\tok -> replaceOf "-" "_" tok) wordTokens
"""

[[edit]]
file: src/Compute.ipe
find:
"""
classify : Transaction -> Bucket
"""
replace:
"""
-- Compile a literal pattern and test it against `subject`.  A pattern that
-- fails to compile falls closed to "no match" rather than crashing the report.
matches : String -> String -> Bool
matches pattern subject =
    case Regex.compile pattern of

        Ok re ->
            Regex.match re subject

        Err _ ->
            False


-- Every non-overlapping match of `pattern` in `subject`; empty on a pattern
-- that fails to compile.
findAllOf : String -> String -> List String
findAllOf pattern subject =
    case Regex.compile pattern of

        Ok re ->
            Regex.findAll re subject

        Err _ ->
            []


-- Replace every match of `pattern` in `subject` with `replacement`; leaves
-- `subject` unchanged on a pattern that fails to compile.
replaceOf : String -> String -> String -> String
replaceOf pattern replacement subject =
    case Regex.compile pattern of

        Ok re ->
            Regex.replace re replacement subject

        Err _ ->
            subject


classify : Transaction -> Bucket
"""
