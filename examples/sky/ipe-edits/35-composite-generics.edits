find:
"""
        if Regex.match "^transfer" cat then
            Transfer

        else if Regex.match "refund" cat then
            Refund

        else if Regex.match "(salary|bonus|payroll)" cat then
            Income

        else if isPositive && Regex.match "(deposit|interest|dividend)" cat then
            Income
"""
replace:
"""
        if matches "^transfer" cat then
            Transfer

        else if matches "refund" cat then
            Refund

        else if matches "(salary|bonus|payroll)" cat then
            Income

        else if isPositive && matches "(deposit|interest|dividend)" cat then
            Income
"""

