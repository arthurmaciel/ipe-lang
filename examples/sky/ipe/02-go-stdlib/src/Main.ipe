module Main exposing (main)

import Ipe.Crypto as Crypto
import Ipe.Http as Http
import Ipe.Result as Result
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Io as Io
import Ipe.Error as Error exposing (Error)


main : Task Error ()
main =
    Time.now ()
        |> Task.andThen
               (\nowMs ->
                   do
                       nowStr = Time.timeString nowMs
                       Io.println ("Current time: " ++ nowStr)
                       data = "Hello, Sky!"
                       Io.println
                           ("SHA256 of 'Hello, Sky!': " ++ Crypto.sha256 data)
                       Io.println "Sending HTTP request..."
                       Http.get "https://httpbin.org/get"
                           |> Task.andThen
                                  (\resp ->
                                      do
                                          Io.println
                                              ("HTTP response received, body length: "
                                                  ++ String.fromInt
                                                         (String.length resp.body))
                                          Task.succeed ())
                           |> Task.onError
                                  (\e ->
                                      do
                                          Io.println
                                              ("HTTP error: " ++ Error.toString e)
                                          Task.succeed ()))
