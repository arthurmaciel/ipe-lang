module Lib.Products exposing
    ( listProducts
    , listAllProducts
    , getProduct
    , createProduct
    , updateProduct
    , deleteProduct
    , listProductImages
    , addProductImage
    , deleteProductImage
    , searchProducts
    )

import Ipe.Maybe exposing (..)
import Ipe.Result as Result
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Io as Io
import Ipe.Error as Error exposing (Error(..))
import Ipe.Task as Task
import Ipe.Uuid as Uuid
import Lib.Db as Db


-- Entropy is an effect: `Uuid.v4 : () -> Task Error String`; fold it
-- synchronously like the other environment reads in this app.
newId : String
newId =
    Result.withDefault "" (Task.run (Uuid.v4 ()))


listProducts : List (Dict String String)
listProducts =
    Db.queryWhereOrLog "Products.listProducts" "products" "published" "==" "true"


listAllProducts : List (Dict String String)
listAllProducts =
    case Db.queryDocs "products" of

        Ok products ->
            products

        Err _ ->
            []


getProduct : String -> Result Error (Maybe (Dict String String))
getProduct productId =
    Db.getDoc "products" productId


searchProducts : String -> String -> String -> String -> List (Dict String String)
searchProducts query category sortBy sortDir =
    listProducts |> filterByCategory category |> filterBySearch query
        |> sortProducts sortBy sortDir


filterByCategory : String -> List (Dict String String) -> List (Dict String String)
filterByCategory category products =
    if category == "all" || category == "" then
        products

    else
        List.filter (\p -> Db.unsafeGetField "category" p == category) products


filterBySearch : String -> List (Dict String String) -> List (Dict String String)
filterBySearch query products =
    if query == "" then
        products

    else
        let
            lowerQuery = String.toLower query
        in
            List.filter
                (\p ->
                    String.contains
                        lowerQuery
                        (String.toLower (Db.unsafeGetField "title" p))
                        || String.contains
                               lowerQuery
                               (String.toLower (Db.unsafeGetField "summary" p)))
                products


-- Original used List.sortBy, which is no longer in the Sky.Core.List surface
-- (Rust-backend kernel gap). Faithful behaviour via a pure-Sky insertion sort
-- on a numeric key — sorts by effective price; title sort is a stable no-op
-- (matches the original, which sorted title by a constant key).
sortProducts : String -> String -> List (Dict String String) -> List (Dict String String)
sortProducts sortBy sortDir products =
    let
        sorted =
            if sortBy == "price" then
                insertionSortByKey
                    (\p ->
                        Db.unsafeGetInt "price_amount" p - Db.unsafeGetInt "price_discount" p)
                    products

            else
                products
    in
        if sortDir == "desc" then
            List.reverse sorted

        else
            sorted


-- Pure-Sky stable insertion sort keyed by an Int extractor.
insertionSortByKey : (Dict String String -> Int) -> List (Dict String String) -> List (Dict String String)
insertionSortByKey keyOf items =
    List.foldl (\item acc -> insertByKey keyOf item acc) [] items


insertByKey keyOf item sortedAcc =
    case sortedAcc of

        [] ->
            [item]

        x :: rest ->
            if keyOf item <= keyOf x then
                item :: sortedAcc

            else
                x :: insertByKey keyOf item rest


createProduct : String -> String -> String -> Int -> String -> Int -> Int -> Bool -> Result Error String
createProduct title summary category priceAmount priceCurrency priceDiscount stock published =
    let
        productId = newId
        productData =
            Dict.fromList
                [ ( "id", productId )
                , ( "title", title )
                , ( "summary", summary )
                , ( "category", category )
                , ( "price_amount", Db.intVal priceAmount )
                , ( "price_currency", priceCurrency )
                , ( "price_discount", Db.intVal priceDiscount )
                , ( "price_tax", Db.intVal 0 )
                , ( "stock", Db.intVal stock )
                , ( "published", Db.boolVal published )
                ]
        result = Db.setDoc "products" productId productData
    in
        case result of

            Ok _ ->
                Ok productId

            Err e ->
                Err e


updateProduct : String -> String -> String -> String -> Int -> String -> Int -> Int -> Bool -> Result Error String
updateProduct productId title summary category priceAmount priceCurrency priceDiscount stock published =
    let
        productData =
            Dict.fromList
                [ ( "id", productId )
                , ( "title", title )
                , ( "summary", summary )
                , ( "category", category )
                , ( "price_amount", Db.intVal priceAmount )
                , ( "price_currency", priceCurrency )
                , ( "price_discount", Db.intVal priceDiscount )
                , ( "stock", Db.intVal stock )
                , ( "published", Db.boolVal published )
                ]
        result = Db.setDoc "products" productId productData
    in
        case result of

            Ok _ ->
                Ok productId

            Err e ->
                Err e


deleteProduct : String -> Result Error ()
deleteProduct productId =
    let
        images = listProductImages productId
        _imageDelResults =
            List.map
                (\img -> Db.deleteDoc "product_images" (Db.unsafeGetField "id" img))
                images
        cartItems =
            Db.queryWhereOrLog
                "Products.deleteProduct"
                "cart_items"
                "product_id"
                "=="
                productId
        _cartItemDelResults =
            List.map
                (\item -> Db.deleteDoc "cart_items" (Db.unsafeGetField "id" item))
                cartItems
        result = Db.deleteDoc "products" productId
    in
        case result of

            Ok v ->
                Ok v

            Err e ->
                Err e


listProductImages productId =
    Db.queryWhereOrLog
        "Products.listProductImages"
        "product_images"
        "product_id"
        "=="
        productId


addProductImage : String -> String -> Result Error String
addProductImage productId imageData =
    let
        imageId = newId
        existingImages = listProductImages productId
        nextPosition = String.fromInt (List.length existingImages)
        imageDoc =
            Dict.fromList
                [ ( "id", imageId )
                , ( "product_id", productId )
                , ( "data", imageData )
                , ( "position", nextPosition )
                ]
        result = Db.setDoc "product_images" imageId imageDoc
    in
        case result of

            Ok _ ->
                Ok imageId

            Err e ->
                Err e


deleteProductImage : String -> Result Error ()
deleteProductImage imageId =
    Db.deleteDoc "product_images" imageId
