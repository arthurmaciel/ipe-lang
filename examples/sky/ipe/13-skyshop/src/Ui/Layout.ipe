module Ui.Layout exposing
    ( shell
    , adminShell
    , brand
    , brandAccent
    , pageBg
    , cardBg
    , ink
    , muted
    , hairline
    , danger
    , success
    , card
    , primaryButton
    , secondaryButton
    , dangerButton
    , sectionHeading
    , badge
    , notificationBanner
    )

import Ipe.Prelude exposing (..)
import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Region as Region
import State exposing (..)
import Lib.Db as Db
import Lib.Auth as Auth
import Lib.Translation as Tr


-- ══════════════════════════════════════════════════════
-- COLOUR PALETTE (faithful to skyshop's Tailwind design)
-- ══════════════════════════════════════════════════════
brand : Ui.Color
brand =
    Ui.rgb 37 99 235             -- blue-600


brandAccent : Ui.Color
brandAccent =
    Ui.rgb 22 163 74             -- green-600 (checkout / CTA)


pageBg : Ui.Color
pageBg =
    Ui.rgb 248 250 252           -- slate-50


cardBg : Ui.Color
cardBg =
    Ui.rgb 255 255 255


ink : Ui.Color
ink =
    Ui.rgb 26 32 44              -- gray-900


muted : Ui.Color
muted =
    Ui.rgb 107 114 128           -- gray-500


hairline : Ui.Color
hairline =
    Ui.rgb 229 231 235           -- gray-200


danger : Ui.Color
danger =
    Ui.rgb 239 68 68             -- red-500


success : Ui.Color
success =
    Ui.rgb 22 163 74


-- ══════════════════════════════════════════════════════
-- REUSABLE PRIMITIVES
-- ══════════════════════════════════════════════════════
card : List (Ui.Attribute Msg) -> Element Msg -> Element Msg
card extra content =
    Ui.el
        ([ Background.color cardBg
         , Border.rounded 8
         , Border.width 1
         , Border.color hairline
         , Ui.padding 24
         ]
            ++ extra)
        content


primaryButton : Msg -> String -> Element Msg
primaryButton msg label =
    Ui.button
        [ Background.color brand
        , Background.hoverColor (Ui.rgb 29 78 216)
        , Font.color (Ui.rgb 255 255 255)
        , Font.size 14
        , Font.semiBold
        , Border.rounded 6
        , Ui.paddingXY 20 8
        ]
        { onPress = Just msg, label = Ui.text label }


secondaryButton : Msg -> String -> Element Msg
secondaryButton msg label =
    Ui.button
        [ Background.color cardBg
        , Border.width 1
        , Border.color hairline
        , Font.color muted
        , Font.size 14
        , Border.rounded 6
        , Ui.paddingXY 20 8
        ]
        { onPress = Just msg, label = Ui.text label }


dangerButton : Msg -> String -> Element Msg
dangerButton msg label =
    Ui.button
        [ Background.color cardBg
        , Border.width 1
        , Border.color (Ui.rgb 254 202 202)
        , Font.color danger
        , Font.size 14
        , Border.rounded 6
        , Ui.paddingXY 16 8
        ]
        { onPress = Just msg, label = Ui.text label }


sectionHeading : String -> Element Msg
sectionHeading txt =
    Ui.el
        [ Region.heading 2, Font.size 24, Font.bold, Font.color ink ]
        (Ui.text txt)


badge : Ui.Color -> Ui.Color -> String -> Element Msg
badge fg bg txt =
    Ui.el
        [ Background.color bg
        , Font.color fg
        , Font.size 12
        , Font.semiBold
        , Border.rounded 999
        , Ui.paddingXY 8 4
        ]
        (Ui.text txt)


-- ══════════════════════════════════════════════════════
-- HEADER
-- ══════════════════════════════════════════════════════
navLink : String -> Page -> Element Msg
navLink label target =
    Ui.button
        [ Font.color muted
        , Background.hoverColor (Ui.rgb 243 244 246)
        , Font.size 14
        , Font.weight 500
        , Border.rounded 6
        , Ui.paddingXY 12 6
        ]
        { onPress = Just (Navigate target), label = Ui.text label }


header : Model -> Element Msg
header model =
    let
        lang = model.lang
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 24 12
            , Ui.spacing 16
            , Background.color cardBg
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color hairline
            , Region.navigation
            ]
            [ Ui.el
                  [ Region.heading 1
                  , Font.color ink
                  , Font.size 22
                  , Font.extraBold
                  ]
                  (Ui.text (Tr.t lang "app.name"))
            , navLink (Tr.t lang "nav.home") HomePage
            , navLink (Tr.t lang "nav.products") ProductsPage
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , languageToggle model
            , userNav model
            ]


languageToggle : Model -> Element Msg
languageToggle model =
    let
        nextLang =
            if model.lang == "en" then
                "zh"

            else
                "en"
        label =
            if model.lang == "en" then
                "中文"

            else
                "EN"
    in
        Ui.button
            [ Font.color muted
            , Font.size 12
            , Font.semiBold
            , Border.width 1
            , Border.color hairline
            , Border.rounded 6
            , Ui.paddingXY 8 4
            ]
            { onPress = Just (SetLang nextLang), label = Ui.text label }


userNav : Model -> Element Msg
userNav model =
    let
        lang = model.lang
    in
        case model.user of

            Just user ->
                Ui.row
                    [ Ui.spacing 12 ]
                    [ cartLink model
                    , navLink (Tr.t lang "nav.orders") OrdersPage
                    , adminLink user lang
                    , Ui.el [ Font.color ink, Font.size 14, Font.weight 500 ]
                        (Ui.text (Db.unsafeGetField "name" user))
                    , dangerButton DoSignOut (Tr.t lang "nav.signout")
                    ]

            Nothing ->
                primaryButton (Navigate AuthSignInPage) (Tr.t lang "nav.signin")


cartLink : Model -> Element Msg
cartLink model =
    let
        count = List.length model.cartItems
        label =
            if count > 0 then
                Tr.t model.lang "nav.cart" ++ " (" ++ String.fromInt count ++ ")"

            else
                Tr.t model.lang "nav.cart"
    in
        navLink label CartPage


adminLink : Dict String String -> String -> Element Msg
adminLink user lang =
    if Auth.isAdmin user then
        Ui.button
            [ Background.color (Ui.rgb 243 232 255)
            , Font.color (Ui.rgb 147 51 234)
            , Font.size 12
            , Font.semiBold
            , Border.rounded 6
            , Ui.paddingXY 8 4
            ]
            { onPress = Just (Navigate AdminProductsPage)
            , label = Ui.text (Tr.t lang "nav.admin")
            }

    else
        Ui.none


-- ══════════════════════════════════════════════════════
-- FOOTER
-- ══════════════════════════════════════════════════════
footer : Model -> Element Msg
footer model =
    let
        lang = model.lang
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 24 24
            , Ui.spacing 16
            , Background.color cardBg
            , Border.widthEach { top = 1, right = 0, bottom = 0, left = 0 }
            , Border.color hairline
            , Region.footer
            ]
            [ Ui.el [ Font.color muted, Font.size 12 ]
                (Ui.text (Tr.t lang "footer.tagline"))
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , Ui.el [ Font.color muted, Font.size 12 ]
                (Ui.text ("© 2024 " ++ Tr.t lang "footer.copyright"))
            ]


-- ══════════════════════════════════════════════════════
-- NOTIFICATION
-- ══════════════════════════════════════════════════════
notificationBanner : Model -> Element Msg
notificationBanner model =
    if model.notification == "" then
        Ui.none

    else
        let
            isError = model.notificationType == "error"
            fg =
                if isError then
                    Ui.rgb 185 28 28

                else
                    Ui.rgb 21 128 61
            bg =
                if isError then
                    Ui.rgb 254 242 242

                else
                    Ui.rgb 240 253 244
            bd =
                if isError then
                    danger

                else
                    success
        in
            Ui.row
                [ Ui.width Ui.fill
                , Background.color bg
                , Border.color bd
                , Border.width 1
                , Border.rounded 6
                , Ui.paddingXY 16 12
                , Ui.spacing 12
                ]
                [ Ui.el [ Font.color fg, Font.size 14, Ui.width Ui.fill ]
                    (Ui.text model.notification)
                , Ui.button
                    [ Font.color fg, Font.size 14 ]
                    { onPress = Just DismissNotification, label = Ui.text "✕" }
                ]


-- ══════════════════════════════════════════════════════
-- PAGE SHELLS — header + notification + content + footer
-- ══════════════════════════════════════════════════════
shell : Model -> Element Msg -> Element Msg
shell model content =
    Ui.column
        [ Ui.width Ui.fill, Background.color pageBg, Ui.spacing 0 ]
        [ header model
        , Ui.column
              [ Ui.width Ui.fill, Ui.paddingXY 24 32, Ui.spacing 24 ]
              [ notificationBanner model, content ]
        , footer model
        ]


adminShell : Model -> Element Msg -> Element Msg
adminShell model content =
    case model.user of

        Just user ->
            if Auth.isAdmin user then
                shell model content

            else
                shell
                    model
                    (Ui.el
                        [ Ui.paddingXY 0 80, Font.color muted, Font.size 22 ]
                        (Ui.text "Access denied"))

        Nothing ->
            shell
                model
                (Ui.el
                    [ Ui.paddingXY 0 80, Font.color muted, Font.size 22 ]
                    (Ui.text "Please sign in"))
