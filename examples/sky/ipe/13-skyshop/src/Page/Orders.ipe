module Page.Orders exposing (viewOrders, viewOrder, viewOrderSuccess)

import Ipe.Prelude exposing (..)
import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Region as Region
import State exposing (..)
import Ui.Layout as Layout
import Lib.Db as Db
import Lib.Money as Money
import Lib.Translation as Tr


-- ══════════════════════════════════════════════════════
-- ORDER LIST
-- ══════════════════════════════════════════════════════
viewOrders : Model -> Html.Html Msg
viewOrders model =
    Ui.layout []
        (Layout.shell
            model
            (case model.user of

                Nothing ->
                    Ui.column
                        [ Ui.width Ui.fill, Ui.paddingXY 0 64, Font.alignCenter ]
                        [ Layout.primaryButton
                              (Navigate AuthSignInPage)
                              (Tr.t model.lang "nav.signin")
                        ]

                Just _ ->
                    Ui.column
                        [ Ui.width Ui.fill, Ui.spacing 24 ]
                        [ Ui.el
                              [ Region.heading 1
                              , Font.size 30
                              , Font.bold
                              , Font.color Layout.ink
                              ]
                              (Ui.text (Tr.t model.lang "order.title"))
                        , if List.isEmpty model.orders then
                              Ui.el
                                  [ Ui.width Ui.fill
                                  , Ui.paddingXY 0 64
                                  , Font.alignCenter
                                  , Font.color Layout.muted
                                  ]
                                  (Ui.text (Tr.t model.lang "order.empty"))

                          else
                              Ui.column
                                  [ Ui.width Ui.fill, Ui.spacing 16 ]
                                  (List.map (viewOrderCard model) model.orders)
                        ]))


viewOrderCard : Model -> Dict String String -> Element Msg
viewOrderCard model order =
    let
        orderId = Db.unsafeGetField "id" order
        state = Db.unsafeGetField "state" order
        totalAmount = Db.unsafeGetInt "total_amount" order
        totalCurrency = Db.unsafeGetField "total_currency" order
        createdAt = Db.unsafeGetField "created_at" order
        colors = stateColors state
    in
        Ui.button
            [ Ui.width Ui.fill
            , Background.color Layout.cardBg
            , Border.rounded 12
            , Border.width 1
            , Border.color Layout.hairline
            , Ui.padding 24
            ]
            { onPress = Just (Navigate (OrderPage orderId))
            , label =
                  Ui.row
                      [ Ui.width Ui.fill ]
                      [ Ui.column
                            [ Ui.spacing 8 ]
                            [ Ui.row
                                  [ Ui.spacing 12 ]
                                  [ Ui.el
                                        [ Font.semiBold, Font.color Layout.ink ]
                                        (Ui.text
                                            (Money.formatPrice totalAmount totalCurrency))
                                  , Layout.badge
                                        colors.fg
                                        colors.bg
                                        (Tr.tCartState model.lang state)
                                  ]
                            , Ui.el
                                  [ Font.size 14, Font.color Layout.muted ]
                                  (Ui.text
                                      (Tr.t model.lang "order.placed" ++ ": " ++ createdAt))
                            ]
                      ]
            }


type alias StateColors =
    { fg : Ui.Color, bg : Ui.Color }


stateColors : String -> StateColors
stateColors state =
    case state of

        "ordered" ->
            { fg = Ui.rgb 29 78 216, bg = Ui.rgb 219 234 254 }

        "shipped" ->
            { fg = Ui.rgb 161 98 7, bg = Ui.rgb 254 249 195 }

        "delivered" ->
            { fg = Ui.rgb 21 128 61, bg = Ui.rgb 220 252 231 }

        "cancelled" ->
            { fg = Ui.rgb 185 28 28, bg = Ui.rgb 254 226 226 }

        "refunded" ->
            { fg = Ui.rgb 75 85 99, bg = Ui.rgb 243 244 246 }

        "pending" ->
            { fg = Ui.rgb 194 65 12, bg = Ui.rgb 255 237 213 }

        _ ->
            { fg = Ui.rgb 75 85 99, bg = Ui.rgb 243 244 246 }


-- ══════════════════════════════════════════════════════
-- ORDER DETAIL
-- ══════════════════════════════════════════════════════
viewOrder : Model -> Html.Html Msg
viewOrder model =
    Ui.layout []
        (Layout.shell
            model
            (case model.order of

                Just order ->
                    viewOrderDetail model order

                Nothing ->
                    Ui.el
                        [ Ui.width Ui.fill
                        , Ui.paddingXY 0 64
                        , Font.alignCenter
                        , Font.color Layout.muted
                        ]
                        (Ui.text (Tr.t model.lang "common.loading"))))


viewOrderDetail : Model -> Dict String String -> Element Msg
viewOrderDetail model order =
    let
        lang = model.lang
        state = Db.unsafeGetField "state" order
        totalAmount = Db.unsafeGetInt "total_amount" order
        totalCurrency = Db.unsafeGetField "total_currency" order
        createdAt = Db.unsafeGetField "created_at" order
        remarks = Db.unsafeGetField "checkout_remarks" order
        shippingName = Db.unsafeGetField "shipping_name" order
        shippingEmail = Db.unsafeGetField "shipping_email" order
        shippingPhone = Db.unsafeGetField "shipping_phone" order
        shippingLine1 = Db.unsafeGetField "shipping_line1" order
        shippingCity = Db.unsafeGetField "shipping_city" order
        shippingCountry = Db.unsafeGetField "shipping_country" order
        shippingPostcode = Db.unsafeGetField "shipping_postcode" order
        colors = stateColors state
    in
        Ui.column
            [ Ui.width Ui.fill, Ui.spacing 24 ]
            [ Ui.button
                  [ Font.size 14, Font.color Layout.brand ]
                  { onPress = Just (Navigate OrdersPage)
                  , label = Ui.text ("< " ++ Tr.t lang "common.back")
                  }
            , Layout.card
                  [ Ui.width Ui.fill ]
                  (Ui.column
                      [ Ui.width Ui.fill, Ui.spacing 24 ]
                      [ Ui.row
                            [ Ui.width Ui.fill ]
                            [ Ui.el
                                  [ Region.heading 1
                                  , Font.size 22
                                  , Font.bold
                                  , Font.color Layout.ink
                                  ]
                                  (Ui.text (Tr.t lang "order.detail"))
                            , Ui.el [ Ui.width Ui.fill ] Ui.none
                            , Layout.badge
                                  colors.fg
                                  colors.bg
                                  (Tr.tCartState lang state)
                            ]
                      , Ui.row
                            [ Ui.width Ui.fill, Ui.spacing 16 ]
                            [ Ui.column
                                  [ Ui.spacing 4 ]
                                  [ Ui.el
                                        [ Font.size 14, Font.color Layout.muted ]
                                        (Ui.text (Tr.t lang "cart.total"))
                                  , Ui.el
                                        [ Font.size 22, Font.bold, Font.color Layout.ink ]
                                        (Ui.text
                                            (Money.formatPrice totalAmount totalCurrency))
                                  ]
                            , Ui.column
                                  [ Ui.spacing 4 ]
                                  [ Ui.el
                                        [ Font.size 14, Font.color Layout.muted ]
                                        (Ui.text (Tr.t lang "order.placed"))
                                  , Ui.el
                                        [ Font.weight 500, Font.color Layout.ink ]
                                        (Ui.text createdAt)
                                  ]
                            ]
                      , if shippingName /= "" then
                            Ui.column
                                [ Ui.spacing 4 ]
                                [ Ui.el
                                      [ Font.semiBold, Font.color Layout.ink ]
                                      (Ui.text (Tr.t lang "order.shipping"))
                                , detailLine shippingName
                                , detailLine shippingEmail
                                , detailLine shippingPhone
                                , detailLine
                                      (shippingLine1 ++ ", " ++ shippingCity
                                          ++ " "
                                          ++ shippingPostcode
                                          ++ ", "
                                          ++ shippingCountry)
                                ]

                        else
                            Ui.none
                      , if remarks /= "" then
                            Ui.column
                                [ Ui.spacing 4 ]
                                [ Ui.el
                                      [ Font.semiBold, Font.color Layout.ink ]
                                      (Ui.text "Remarks")
                                , detailLine remarks
                                ]

                        else
                            Ui.none
                      ])
            , Layout.card
                  [ Ui.width Ui.fill ]
                  (Ui.column
                      [ Ui.width Ui.fill, Ui.spacing 12 ]
                      [ Ui.el
                            [ Font.semiBold
                            , Font.size 18
                            , Font.color Layout.ink
                            ]
                            (Ui.text (Tr.t lang "order.items"))
                      , Ui.column
                            [ Ui.width Ui.fill, Ui.spacing 12 ]
                            (List.map viewOrderItem model.orderItems)
                      ])
            ]


detailLine : String -> Element Msg
detailLine txt =
    Ui.el
        [ Font.size 14, Font.color (Ui.rgb 75 85 99) ]
        (Ui.text txt)


viewOrderItem : Dict String String -> Element Msg
viewOrderItem item =
    let
        title = Db.unsafeGetField "title" item
        qty = Db.unsafeGetInt "quantity" item
        price = Db.unsafeGetInt "price_amount" item
        discount = Db.unsafeGetInt "price_discount" item
        currency = Db.unsafeGetField "price_currency" item
        effectivePrice =
            if discount > 0 then
                price - discount

            else
                price
        lineTotal_ = Money.formatPrice (effectivePrice * qty) currency
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 0 12
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            , Border.color Layout.hairline
            ]
            [ Ui.row
                  [ Ui.spacing 8 ]
                  [ Ui.el
                        [ Font.weight 500, Font.color Layout.ink ]
                        (Ui.text title)
                  , Ui.el
                        [ Font.size 14, Font.color Layout.muted ]
                        (Ui.text ("x" ++ String.fromInt qty))
                  ]
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , Ui.el
                  [ Font.semiBold, Font.color Layout.ink ]
                  (Ui.text lineTotal_)
            ]


-- ══════════════════════════════════════════════════════
-- ORDER SUCCESS
-- ══════════════════════════════════════════════════════
viewOrderSuccess : Model -> Html.Html Msg
viewOrderSuccess model =
    Ui.layout []
        (Layout.shell
            model
            (Ui.column
                [ Ui.width Ui.fill, Ui.paddingXY 0 64, Font.alignCenter ]
                [ case model.order of

                      Just order ->
                          let
                              state = Db.unsafeGetField "state" order
                          in
                              if state == "ordered" || state == "shipped" || state == "delivered" then
                                  viewSuccessOk model order

                              else
                                  viewSuccessFailed model state

                      Nothing ->
                          Ui.el
                              [ Font.color Layout.muted ]
                              (Ui.text (Tr.t model.lang "order.processing"))
                ]))


viewSuccessOk : Model -> Dict String String -> Element Msg
viewSuccessOk model order =
    Ui.column
        [ Ui.width Ui.fill, Ui.spacing 16, Font.alignCenter ]
        [ Ui.el
              [ Ui.width (Ui.px 64)
              , Ui.height (Ui.px 64)
              , Background.color (Ui.rgb 220 252 231)
              , Border.rounded 999
              , Font.alignCenter
              , Font.size 24
              , Font.color Layout.success
              ]
              (Ui.text "✓")
        , Ui.el
              [ Region.heading 1
              , Font.size 22
              , Font.bold
              , Font.color Layout.ink
              ]
              (Ui.text (Tr.t model.lang "order.success"))
        , Layout.primaryButton
              (Navigate (OrderPage (Db.unsafeGetField "id" order)))
              (Tr.t model.lang "order.detail")
        ]


viewSuccessFailed : Model -> String -> Element Msg
viewSuccessFailed model state =
    Ui.column
        [ Ui.width Ui.fill, Ui.spacing 16, Font.alignCenter ]
        [ Ui.el
              [ Region.heading 1
              , Font.size 22
              , Font.bold
              , Font.color (Ui.rgb 220 38 38)
              ]
              (Ui.text (Tr.t model.lang "order.failed"))
        , Ui.el
              [ Font.color Layout.muted ]
              (Ui.text
                  (Tr.t model.lang "order.status" ++ ": "
                      ++ Tr.tCartState model.lang state))
        , Ui.button
              [ Font.color Layout.brand, Font.size 14 ]
              { onPress = Just (Navigate CartPage)
              , label = Ui.text (Tr.t model.lang "cart.continueShopping")
              }
        ]
