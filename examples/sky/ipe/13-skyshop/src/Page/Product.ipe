module Page.Product exposing (viewProduct)

import Ipe.Prelude exposing (..)
import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Region as Region
import State exposing (..)
import Ui.Layout as Layout
import Lib.Db as Db
import Lib.Money as Money
import Lib.Translation as Tr


-- ══════════════════════════════════════════════════════
-- PRODUCT DETAIL PAGE
-- ══════════════════════════════════════════════════════
viewProduct : Model -> Html.Html Msg
viewProduct model =
    Ui.layout []
        (Layout.shell
            model
            (case model.product of

                Just product ->
                    viewProductDetail model product

                Nothing ->
                    Ui.el
                        [ Ui.width Ui.fill
                        , Ui.paddingXY 0 64
                        , Font.alignCenter
                        , Font.color Layout.muted
                        ]
                        (Ui.text (Tr.t model.lang "common.loading"))))


viewProductDetail : Model -> Dict String String -> Element Msg
viewProductDetail model product =
    let
        title = Db.unsafeGetField "title" product
        summary = Db.unsafeGetField "summary" product
        category = Db.unsafeGetField "category" product
        pricing = Money.formatPriceFromRow product
        stock = Db.unsafeGetInt "stock" product
        images = model.productImages
        lang = model.lang
    in
        Ui.column
            [ Ui.width Ui.fill, Ui.spacing 24 ]
            [ breadcrumb lang title
            , Ui.row
                  [ Ui.width Ui.fill, Ui.spacing 48 ]
                  [ viewImageGallery images
                  , Ui.column
                        [ Ui.width Ui.fill, Ui.spacing 8 ]
                        [ Ui.el
                              [ Font.color (Ui.rgb 59 130 246)
                              , Font.size 12
                              , Font.semiBold
                              ]
                              (Ui.text (String.toUpper (Tr.tCategory lang category)))
                        , Ui.el
                              [ Region.heading 1
                              , Font.size 30
                              , Font.bold
                              , Font.color Layout.ink
                              ]
                              (Ui.text title)
                        , viewDetailPrice pricing
                        , viewDetailStock model stock
                        , if summary /= "" then
                              Ui.column
                                  [ Ui.spacing 4, Ui.paddingXY 0 8 ]
                                  [ Ui.el
                                        [ Font.size 14
                                        , Font.semiBold
                                        , Font.color Layout.ink
                                        ]
                                        (Ui.text (Tr.t lang "product.description"))
                                  , Ui.paragraph
                                        [ Font.color Layout.muted ]
                                        [ Ui.text summary ]
                                  ]

                          else
                              Ui.none
                        , viewAddToCart model product stock
                        , Ui.row
                              [ Ui.spacing 24, Ui.paddingXY 0 8 ]
                              [ viewFeature (Tr.t lang "product.quality")
                              , viewFeature (Tr.t lang "product.securePayment")
                              , viewFeature (Tr.t lang "product.fastShipping")
                              ]
                        ]
                  ]
            ]


breadcrumb : String -> String -> Element Msg
breadcrumb lang title =
    Ui.row
        [ Ui.spacing 8, Region.navigation ]
        [ Ui.button
              [ Font.color Layout.muted, Font.size 14 ]
              { onPress = Just (Navigate HomePage)
              , label = Ui.text (Tr.t lang "nav.home")
              }
        , Ui.el [ Font.color Layout.hairline, Font.size 14 ] (Ui.text "/")
        , Ui.button
              [ Font.color Layout.muted, Font.size 14 ]
              { onPress = Just (Navigate ProductsPage)
              , label = Ui.text (Tr.t lang "nav.products")
              }
        , Ui.el [ Font.color Layout.hairline, Font.size 14 ] (Ui.text "/")
        , Ui.el [ Font.color (Ui.rgb 75 85 99), Font.size 14 ] (Ui.text title)
        ]


viewFeature : String -> Element Msg
viewFeature featureLabel =
    Ui.row
        [ Ui.spacing 8 ]
        [ Ui.el
              [ Ui.width (Ui.px 8)
              , Ui.height (Ui.px 8)
              , Border.rounded 999
              , Background.color Layout.success
              ]
              Ui.none
        , Ui.el [ Font.size 12, Font.color Layout.muted ] (Ui.text featureLabel)
        ]


viewImageGallery : List (Dict String String) -> Element Msg
viewImageGallery images =
    if List.isEmpty images then
        Ui.el
            [ Ui.width (Ui.px 320)
            , Ui.height (Ui.px 280)
            , Background.color (Ui.rgb 243 244 246)
            , Border.rounded 8
            , Font.alignCenter
            , Font.color Layout.muted
            , Font.size 12
            ]
            (Ui.text "No images")

    else
        Ui.column
            [ Ui.spacing 12 ]
            [ case List.head images of

                  Just firstImg ->
                      Ui.el
                          [ Ui.width (Ui.px 320)
                          , Ui.height (Ui.px 280)
                          , Background.color (Ui.rgb 243 244 246)
                          , Border.rounded 8
                          , Font.alignCenter
                          , Font.color Layout.muted
                          , Font.size 12
                          ]
                          (Ui.text "Product image")

                  Nothing ->
                      Ui.none
            , if List.length images > 1 then
                  Ui.wrappedRow
                      [ Ui.spacing 8 ]
                      (List.map
                          (\imgRow ->
                              Ui.el
                                  [ Ui.width (Ui.px 72)
                                  , Ui.height (Ui.px 72)
                                  , Background.color (Ui.rgb 243 244 246)
                                  , Border.rounded 6
                                  ]
                                  Ui.none)
                          images)

              else
                  Ui.none
            ]


viewDetailPrice : Money.Price -> Element Msg
viewDetailPrice pricing =
    if pricing.hasDiscount then
        Ui.row
            [ Ui.spacing 12, Ui.paddingXY 0 4 ]
            [ Ui.el
                  [ Font.size 30, Font.bold, Font.color (Ui.rgb 220 38 38) ]
                  (Ui.text pricing.discounted)
            , Ui.el
                  [ Font.size 18, Font.color Layout.muted ]
                  (Ui.text pricing.original)
            , Layout.badge (Ui.rgb 220 38 38) (Ui.rgb 254 226 226) "SALE"
            ]

    else
        Ui.el
            [ Ui.paddingXY 0 4 ]
            (Ui.el
                [ Font.size 30, Font.bold, Font.color Layout.ink ]
                (Ui.text pricing.original))


viewDetailStock : Model -> Int -> Element Msg
viewDetailStock model stock =
    let
        lang = model.lang
    in
        if stock == 0 then
            Layout.badge
                (Ui.rgb 220 38 38)
                (Ui.rgb 254 226 226)
                (Tr.t lang "product.outOfStock")

        else if stock > 0 then
            Layout.badge
                (Ui.rgb 22 163 74)
                (Ui.rgb 220 252 231)
                (Tr.t lang "product.inStock" ++ " - "
                    ++ String.fromInt stock
                    ++ " "
                    ++ Tr.t lang "product.left")

        else
            Layout.badge
                (Ui.rgb 22 163 74)
                (Ui.rgb 220 252 231)
                (Tr.t lang "product.unlimited")


viewAddToCart : Model -> Dict String String -> Int -> Element Msg
viewAddToCart model product stock =
    let
        lang = model.lang
        productId = Db.unsafeGetField "id" product
        canAdd = stock /= 0
    in
        if canAdd then
            Ui.column
                [ Ui.spacing 16, Ui.paddingXY 0 8 ]
                [ Ui.row
                      [ Ui.spacing 12 ]
                      [ Ui.el
                            [ Font.size 14
                            , Font.weight 500
                            , Font.color (Ui.rgb 55 65 81)
                            ]
                            (Ui.text (Tr.t lang "product.quantity"))
                      , Layout.secondaryButton
                            (UpdateQuantity (model.quantity - 1))
                            "-"
                      , Ui.el
                            [ Ui.width (Ui.px 40)
                            , Font.alignCenter
                            , Font.semiBold
                            , Font.color Layout.ink
                            ]
                            (Ui.text (String.fromInt model.quantity))
                      , Layout.secondaryButton
                            (UpdateQuantity (model.quantity + 1))
                            "+"
                      ]
                , Layout.primaryButton
                      (AddToCart productId)
                      (Tr.t lang "product.addToCart")
                ]

        else
            Ui.el
                [ Ui.paddingXY 0 8 ]
                (Ui.el
                    [ Background.color (Ui.rgb 229 231 235)
                    , Font.color Layout.muted
                    , Font.size 14
                    , Font.semiBold
                    , Border.rounded 6
                    , Ui.paddingXY 20 12
                    ]
                    (Ui.text (Tr.t lang "product.outOfStock")))
