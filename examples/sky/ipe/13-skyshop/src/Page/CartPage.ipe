module Page.CartPage exposing (viewCart)

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Input as Input
import Ipe.Ui.Region as Region
import State exposing (..)
import Ui.Layout as Layout
import Lib.Db as Db
import Lib.Money as Money
import Lib.Products as Products
import Lib.Translation as Tr


-- ══════════════════════════════════════════════════════
-- CART PAGE
-- ══════════════════════════════════════════════════════
viewCart : Model -> Html.Html Msg
viewCart model =
    Ui.layout []
        (Layout.shell
            model
            (case model.user of

                Nothing ->
                    viewSignInPrompt model

                Just _ ->
                    viewCartContent model))


viewSignInPrompt : Model -> Element Msg
viewSignInPrompt model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 80
        , Ui.spacing 16
        , Font.alignCenter
        ]
        [ Ui.el
              [ Region.heading 2
              , Font.size 24
              , Font.bold
              , Font.color Layout.ink
              ]
              (Ui.text (Tr.t model.lang "cart.signinTitle"))
        , Ui.el
              [ Font.color Layout.muted ]
              (Ui.text (Tr.t model.lang "cart.signinPrompt"))
        , Layout.primaryButton (Navigate AuthSignInPage) (Tr.t model.lang "nav.signin")
        ]


viewCartContent : Model -> Element Msg
viewCartContent model =
    let
        lang = model.lang
    in
        Ui.column
            [ Ui.width Ui.fill, Ui.spacing 24 ]
            [ Ui.el
                  [ Region.heading 1
                  , Font.size 30
                  , Font.bold
                  , Font.color Layout.ink
                  ]
                  (Ui.text (Tr.t lang "cart.title"))
            , if model.checkoutUrl /= "" then
                  viewCheckoutRedirect model

              else if List.isEmpty model.cartItems then
                  viewEmptyCart model

              else
                  Ui.column
                      [ Ui.width Ui.fill, Ui.spacing 24 ]
                      [ Ui.el
                            [ Font.color Layout.muted ]
                            (Ui.text
                                (String.fromInt (List.length model.cartItems)
                                    ++ " items"))
                      , Ui.row
                            [ Ui.width Ui.fill, Ui.spacing 32 ]
                            [ Ui.el [ Ui.width Ui.fill ] (viewCartItems model)
                            , viewCartSummary model
                            ]
                      ]
            ]


viewCheckoutRedirect : Model -> Element Msg
viewCheckoutRedirect model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 64
        , Ui.spacing 12
        , Font.alignCenter
        ]
        [ Ui.el
              [ Font.size 18
              , Font.weight 500
              , Font.color Layout.ink
              ]
              (Ui.text (Tr.t model.lang "cart.redirecting"))
        , Ui.el
              [ Font.size 14, Font.color Layout.muted ]
              (Ui.text (Tr.t model.lang "cart.redirectHint"))
        , Layout.primaryButton StartCheckout (Tr.t model.lang "cart.goToPayment")
        ]


viewEmptyCart : Model -> Element Msg
viewEmptyCart model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.paddingXY 0 80
        , Ui.spacing 16
        , Font.alignCenter
        ]
        [ Ui.el
              [ Region.heading 2
              , Font.size 20
              , Font.semiBold
              , Font.color Layout.ink
              ]
              (Ui.text (Tr.t model.lang "cart.empty"))
        , Ui.el
              [ Font.color Layout.muted ]
              (Ui.text (Tr.t model.lang "cart.startShopping"))
        , Layout.primaryButton
              (Navigate ProductsPage)
              (Tr.t model.lang "cart.continueShopping")
        ]


viewCartItems : Model -> Element Msg
viewCartItems model =
    Layout.card
        [ Ui.width Ui.fill ]
        (Ui.column
            [ Ui.width Ui.fill, Ui.spacing 16 ]
            (List.map (viewCartItem model) model.cartItems))


viewCartItem : Model -> Dict String String -> Element Msg
viewCartItem model item =
    let
        itemId = Db.unsafeGetField "id" item
        title = Db.unsafeGetField "title" item
        pricing = Money.formatPriceFromRow item
        qty = Db.unsafeGetInt "quantity" item
        price = Db.unsafeGetInt "price_amount" item
        discount = Db.unsafeGetInt "price_discount" item
        currency = Db.unsafeGetField "price_currency" item
        effectivePrice =
            if discount > 0 then
                price - discount

            else
                price
        lineTotal_ = Money.formatPrice (effectivePrice * qty) currency
    in
        Ui.row
            [ Ui.width Ui.fill, Ui.spacing 16 ]
            [ Ui.el
                  [ Ui.width (Ui.px 56)
                  , Ui.height (Ui.px 56)
                  , Background.color (Ui.rgb 243 244 246)
                  , Border.rounded 6
                  ]
                  Ui.none
            , Ui.column
                  [ Ui.width Ui.fill, Ui.spacing 4 ]
                  [ Ui.el
                        [ Font.weight 500
                        , Font.size 14
                        , Font.color Layout.ink
                        ]
                        (Ui.text title)
                  , Ui.el
                        [ Font.size 12, Font.color Layout.muted ]
                        (Ui.text (pricing.original ++ " each"))
                  ]
            , Ui.row
                  [ Ui.spacing 8 ]
                  [ Layout.secondaryButton
                        (UpdateCartItemQty itemId (String.fromInt (qty - 1)))
                        "-"
                  , Ui.el
                        [ Ui.width (Ui.px 32)
                        , Font.alignCenter
                        , Font.semiBold
                        , Font.size 14
                        , Font.color Layout.ink
                        ]
                        (Ui.text (String.fromInt qty))
                  , Layout.secondaryButton
                        (UpdateCartItemQty itemId (String.fromInt (qty + 1)))
                        "+"
                  ]
            , Ui.el
                  [ Ui.width (Ui.px 80)
                  , Font.alignCenter
                  , Font.semiBold
                  , Font.color Layout.ink
                  ]
                  (Ui.text lineTotal_)
            , Layout.dangerButton (RemoveCartItem itemId) (Tr.t model.lang "cart.remove")
            ]


viewCartSummary : Model -> Element Msg
viewCartSummary model =
    let
        lang = model.lang
        totalAmount =
            case model.cart of

                Just cart ->
                    Db.unsafeGetInt "total_amount" cart

                Nothing ->
                    0
        totalCurrency =
            case model.cart of

                Just cart ->
                    Db.unsafeGetField "total_currency" cart

                Nothing ->
                    "GBP"
    in
        Ui.el
            [ Ui.width (Ui.px 360) ]
            (Layout.card
                [ Ui.width Ui.fill ]
                (Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 16 ]
                    [ Ui.el
                          [ Font.semiBold, Font.color Layout.ink ]
                          (Ui.text (Tr.t lang "cart.orderSummary"))
                    , Ui.column
                          [ Ui.width Ui.fill, Ui.spacing 4 ]
                          [ Ui.el
                                [ Font.size 14, Font.color Layout.muted ]
                                (Ui.text (Tr.t lang "cart.remarks"))
                          , Input.text
                                [ Ui.width Ui.fill ]
                                { onChange = UpdateRemarks
                                , text = model.cartRemarks
                                , placeholder =
                                      Just
                                          (Input.placeholder
                                              []
                                              (Ui.text
                                                  (Tr.t lang "cart.deliveryInstructions")))
                                , label = Input.labelHidden "remarks"
                                }
                          ]
                    , Ui.column
                          [ Ui.width Ui.fill, Ui.spacing 4 ]
                          [ summaryRow
                                (Tr.t lang "cart.subtotal")
                                (Money.formatPrice totalAmount totalCurrency)
                                Layout.muted
                          , shippingRow lang
                          ]
                    , Ui.row
                          [ Ui.width Ui.fill ]
                          [ Ui.el
                                [ Font.size 18, Font.bold, Font.color Layout.ink ]
                                (Ui.text (Tr.t lang "cart.total"))
                          , Ui.el [ Ui.width Ui.fill ] Ui.none
                          , Ui.el
                                [ Font.size 22, Font.bold, Font.color Layout.ink ]
                                (Ui.text (Money.formatPrice totalAmount totalCurrency))
                          ]
                    , Layout.primaryButton StartCheckout (Tr.t lang "cart.checkout")
                    , Ui.button
                          [ Font.color Layout.brand
                          , Font.size 14
                          , Font.weight 500
                          , Ui.width Ui.fill
                          , Font.alignCenter
                          ]
                          { onPress = Just (Navigate ProductsPage)
                          , label = Ui.text (Tr.t lang "cart.continueShopping")
                          }
                    ]))


summaryRow : String -> String -> Ui.Color -> Element Msg
summaryRow leftLabel rightLabel rightColor =
    Ui.row
        [ Ui.width Ui.fill ]
        [ Ui.el
              [ Font.size 14, Font.color Layout.muted ]
              (Ui.text leftLabel)
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , Ui.el
              [ Font.weight 500, Font.color rightColor ]
              (Ui.text rightLabel)
        ]


shippingRow : String -> Element Msg
shippingRow lang =
    Ui.row
        [ Ui.width Ui.fill ]
        [ Ui.el
              [ Font.size 14, Font.color Layout.muted ]
              (Ui.text (Tr.t lang "cart.shipping"))
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , Ui.el
              [ Font.size 14, Font.weight 500, Font.color Layout.success ]
              (Ui.text (Tr.t lang "cart.shippingFree"))
        ]
