module Main exposing (main)

import Ipe.Task as Task
import Ipe.Io as Io
import Ipe.Http.Server as Server
import Ipe.Http.Server exposing (Handler, Request, Response)
import Ipe.Error exposing (Error)


indexHandler : Handler
indexHandler _req =
    Task.succeed (Server.text "Welcome to Sky Mux Server!")


echoHandler : Handler
echoHandler _req =
    Task.succeed (Server.text "echo received")


pingHandler : Handler
pingHandler _req =
    Task.succeed (Server.text "pong")


main : Task Error ()
main =
    do
        Io.println "Server starting on port 8000"
        Server.listen
            8000
            [ Server.get "/" indexHandler
            , Server.post "/echo" echoHandler
            , Server.get "/ping" pingHandler
            ]
