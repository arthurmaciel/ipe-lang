-- anzellai/sky#153 — build + run must succeed (no `undefined: T1`) with the
-- parametric `Zipper a` defined in a sibling module and used here.
module Main exposing (main)

import Ipe.Prelude exposing (..)
import Ipe.String as String
import Ipe.Log exposing (println)
import Zipper exposing (Zipper)


main =
    let
        z = Zipper.singleton 42
        _ = println (String.fromInt (Zipper.current z))
    in
        ()
