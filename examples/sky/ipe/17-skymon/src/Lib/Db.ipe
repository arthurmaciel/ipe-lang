module Lib.Db exposing (withConn, field, intField)

import Ipe.Maybe as Maybe
import Ipe.String as String
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Db.Unsafe as DbUnsafe
import Ipe.Error as Error exposing (Error)
import Lib.Schema as Schema


-- The database is reached through acquire-per-effect: every effect opens
-- its own pooled connection, ensures the schema, runs its operation, and
-- lets the connection fall out of scope when the Task settles. The
-- connection is never threaded through the Model, because a Web-shape
-- Model is persisted to the session store between requests and may not
-- carry the opaque `Db` handle (IPE-L0120). Only the settled DATA reaches
-- the Model, via a response `Msg`.
withConn : (Db -> Task Error a) -> Task Error a
withConn op =
    Db.connect ()
        |> Task.andThen Schema.ensureSchema
        |> Task.andThen op


-- Read a string column from a row already loaded into the Model. A missing
-- column is a schema mismatch, not a runtime error worth bubbling: the
-- empty-string default lets a display-only read degrade predictably.
field : String -> Dict String String -> String
field key row =
    DbUnsafe.unsafeGetField key row


-- Read an integer column, defaulting to 0 for a missing or non-numeric
-- value so callers never have to unwrap.
intField : String -> Dict String String -> Int
intField key row =
    Maybe.withDefault 0 (String.toInt (field key row))
