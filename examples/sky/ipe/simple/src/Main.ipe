module Main exposing (main)

import Ipe.Task as Task
import Ipe.Io as Io


expensiveTask n =
    Task.succeed (n * n)


main =
    do
        tasks =
            [ expensiveTask 1
            , expensiveTask 2
            , expensiveTask 3
            , expensiveTask 4
            , expensiveTask 5
            ]
        seqResults = Task.perform (Task.sequence tasks)
        parResults = Task.perform (Task.parallel tasks)
        Io.println "Sequential done"
        Io.println "Parallel done"
        seqResults
        parResults
        ()
