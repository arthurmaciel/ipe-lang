module Main exposing (main)

import Ipe.Task as Task
import Ipe.Io as Io


expensiveTask n =
    Task.succeed (n * n)


main =
    do
        _ <- Task.sequence
            [ expensiveTask 1
            , expensiveTask 2
            , expensiveTask 3
            , expensiveTask 4
            , expensiveTask 5
            ]
        _ <- Task.parallel
            [ expensiveTask 1
            , expensiveTask 2
            , expensiveTask 3
            , expensiveTask 4
            , expensiveTask 5
            ]
        Io.println "Sequential done"
        Io.println "Parallel done"
