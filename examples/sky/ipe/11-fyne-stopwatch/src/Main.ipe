module Main exposing (main)

import Ipe.Result as Result
import Ipe.Io as Io
import Fyne.Io.Fyne.V2 as Fyne
import Fyne.Io.Fyne.V2.App as FyneApp
import Fyne.Io.Fyne.V2.Widget as Widget


setupWindow myApp =
    case Fyne.appNewWindow myApp "Sky Stopwatch" of

        Ok window ->
            showWindow window

        Err e ->
            do
                Io.println ("Failed to create window: " ++ errorToString e)
                ()


showWindow window =
    case Widget.newLabel "00:00.0 -- Built with Sky + Fyne" of

        Ok display ->
            do
                Fyne.windowSetContent window display
                case Fyne.newSize 400.0 200.0 of

                    Ok size ->
                        do
                            Fyne.windowResize window size
                            ()

                    Err _ ->
                        ()
                Fyne.windowShowAndRun window
                ()

        Err e ->
            do
                Io.println ("Failed to create label: " ++ errorToString e)
                ()


main =
    case FyneApp.new () of

        Ok myApp ->
            setupWindow myApp

        Err e ->
            do
                Io.println ("Failed to create Fyne app: " ++ errorToString e)
                ()
