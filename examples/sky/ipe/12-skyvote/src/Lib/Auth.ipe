module Lib.Auth exposing (createUser, authenticateUser, getUserById)

import Ipe.Maybe exposing (..)
import Ipe.List as List
import Ipe.Result as Result
import Ipe.String as String
import Ipe.Crypto as Crypto
import Ipe.Auth as Auth
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Db.Unsafe as DbUnsafe
import Ipe.Error as Error exposing (Error)
import Lib.Db as LibDb


hashPassword : String -> String
hashPassword password =
    case Auth.hashPassword password of

        Ok hash ->
            hash

        Err _ ->
            ""


-- Auth.verifyPassword returns Result Error Bool — collapse with
-- withDefault False so an internal error denies rather than grants.
verifyPassword : String -> String -> Bool
verifyPassword password storedHash =
    Result.withDefault False (Auth.verifyPassword password storedHash)


-- Registers a user. A UNIQUE-key clash on username or email surfaces as a
-- validation error the form can show inline, so the raw DB error text never
-- reaches the user.
createUser : String -> String -> String -> Task Error String
createUser username email password =
    let
        id = String.slice 0 12 (Crypto.sha256 (username ++ ":" ++ email))
        passHash = hashPassword password
    in
        LibDb.withConn
            (\conn ->
                Db.exec
                    conn
                    "INSERT INTO users (id, username, email, password_hash) VALUES (?, ?, ?, ?)"
                    [ id, username, email, passHash ])
            |> Task.map (\_ -> id)
            |> Task.onError
                (\_ ->
                    Task.fail
                        (Error.invalidInput "Username or email already taken."))


-- Wrong password and unknown email both return the same PermissionDenied
-- with identical text, so the response never reveals which of the two was
-- wrong (avoids a user-enumeration oracle). A genuine DB failure surfaces
-- as its own error so callers can distinguish "service down" from "bad
-- credentials".
authenticateUser : String -> String -> Task Error (Dict String String)
authenticateUser email password =
    LibDb.withConn
        (\conn ->
            DbUnsafe.unsafeQuery
                conn
                "SELECT id, username, email, password_hash FROM users WHERE email = ? LIMIT 1"
                [ email ])
        |> Task.andThen (\rows -> checkCredentials password rows)


checkCredentials : String -> List (Dict String String) -> Task Error (Dict String String)
checkCredentials password userRows =
    case List.head userRows of

        Nothing ->
            Task.fail
                (Error.permissionDenied
                    |> Error.withMessage "Invalid email or password.")

        Just user ->
            let
                storedHash = DbUnsafe.unsafeGetField "password_hash" user
            in
                if verifyPassword password storedHash then
                    Task.succeed user

                else
                    Task.fail
                        (Error.permissionDenied
                            |> Error.withMessage "Invalid email or password.")


-- The outer Task is for DB failure; the inner Maybe is "found / not
-- found", which is normal and not an error.
getUserById : String -> Task Error (Maybe (Dict String String))
getUserById userId =
    LibDb.withConn
        (\conn ->
            DbUnsafe.unsafeQuery
                conn
                "SELECT id, username, email FROM users WHERE id = ? LIMIT 1"
                [ userId ])
        |> Task.map List.head
