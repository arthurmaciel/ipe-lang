module Main exposing (main)

import Ipe.Io as Io
import Ipe.List as List
import Ipe.String as String


inc : Int -> Int
inc x =
    x + 1


dbl : Int -> Int
dbl x =
    x * 2


main =
    do
        -- `>>` = left-to-right (apply inc, then dbl → dbl (inc 3) = 8);
        -- `<<` = right-to-left (apply dbl, then inc → inc (dbl 3) = 7).
        forward = inc >> dbl
        backward = inc << dbl
        mapped = List.map (inc >> dbl) [ 1, 2, 3 ]
        Io.println (String.fromInt (forward 3))
        Io.println (String.fromInt (backward 3))
        Io.println (String.join "," (List.map String.fromInt mapped))
