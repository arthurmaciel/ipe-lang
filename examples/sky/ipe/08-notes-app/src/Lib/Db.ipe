module Lib.Db exposing
    ( User
    , Session
    , Note
    , SessionUser
    , userStore
    , sessionStore
    , noteStore
    , sessionUserCodec
    )

import Ipe.Codec as Codec exposing (Codec)
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error exposing (Error)
import Ipe.Result as Result


-- ── Typed rows ──────────────────────────────────────────────────────
type alias User =
    { id : Int
    , email : String
    , passwordHash : String
    , verified : Int
    , verificationToken : String
    , createdAt : String
    }

type alias Session =
    { id : Int
    , userId : Int
    , token : String
    , createdAt : String
    }

type alias Note =
    { id : Int
    , userId : Int
    , title : String
    , content : String
    , createdAt : String
    , updatedAt : String
    }


-- ── Codec witnesses (top-level annotated blanks, required by Codec.auto) ──
blankUser : User
blankUser =
    { id = 0
    , email = ""
    , passwordHash = ""
    , verified = 0
    , verificationToken = ""
    , createdAt = ""
    }

blankSession : Session
blankSession =
    { id = 0, userId = 0, token = "", createdAt = "" }

blankNote : Note
blankNote =
    { id = 0
    , userId = 0
    , title = ""
    , content = ""
    , createdAt = ""
    , updatedAt = ""
    }

blankSessionUser : SessionUser
blankSessionUser =
    { id = 0, email = "", createdAt = "" }


-- ── Stores ─────────────────────────────────────────────────────────
-- Each store is exposed as `Result Error (Store a)` so callers can
-- sequence with `Task.fromResult` and propagate failures cleanly.

userStore : Result Error (Store User)
userStore =
    case Store.fromCodec "users" (Codec.auto blankUser) of
        Err e -> Err e
        Ok s0 ->
            let s1 = Store.serial .id s0
                s2 = Store.unique .email s1
                s3 = Store.defaultInt .verified 0 s2
                s4 = Store.defaultNow .createdAt s3
            in
                Ok (Store.public s4)


sessionStore : Result Error (Store Session)
sessionStore =
    case Store.fromCodec "sessions" (Codec.auto blankSession) of
        Err e -> Err e
        Ok s0 ->
            let s1 = Store.serial .id s0
                s2 = Store.unique .token s1
                s3 = Store.defaultNow .createdAt s2
            in
                Ok (Store.public s3)


noteStore : Result Error (Store Note)
noteStore =
    case Store.fromCodec "notes" (Codec.auto blankNote) of
        Err e -> Err e
        Ok s0 ->
            let s1 = Store.serial .id s0
                s2 = Store.defaultText .content "" s1
                s3 = Store.defaultNow .createdAt s2
                s4 = Store.touchOnUpdate .updatedAt s3
            in
                Ok (Store.public s4)


-- ── JOIN projection (users ⋈ sessions) ──────────────────────────────
type alias SessionUser =
    { id : Int
    , email : String
    , createdAt : String
    }


sessionUserCodec : Codec SessionUser
sessionUserCodec =
    Codec.auto blankSessionUser
