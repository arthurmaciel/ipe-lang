module Lib.Notes exposing (createNote, updateNote, deleteNote, getNotes, getNote)

import Ipe.Maybe as Maybe exposing (..)
import Ipe.List as List
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Error as Error exposing (Error)
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store
import Lib.Db as Lib exposing (Note)


-- parseNoteId : parse a URL-param note id string to Int, or fail closed.
parseNoteId : String -> Task Error Int
parseNoteId s =
    case String.toInt s of

        Just n ->
            Task.succeed n

        Nothing ->
            Task.fail (Error.invalidInput ("Invalid note id: " ++ s))


-- createNote : Task Error () — DB stamps id/createdAt/updatedAt.
createNote : Db -> Int -> String -> String -> Task Error ()
createNote conn userId title content =
    Task.fromResult Lib.noteStore
        |> Task.andThen
               (\store ->
                   let
                       newNote =
                           { id = 0
                           , userId = userId
                           , title = title
                           , content = content
                           , createdAt = ""
                           , updatedAt = ""
                           }
                   in
                       Store.insert conn store newNote
                           |> Task.map (\_ -> ()))


-- updateNote : ownership-scoped update. Scoped to userId so one user cannot
-- edit another's note; touchOnUpdate bumps updatedAt with no raw SQL.
updateNote : Db -> String -> Int -> String -> String -> Task Error ()
updateNote conn noteId userId title content =
    parseNoteId noteId
        |> Task.andThen
               (\nid ->
                   Task.fromResult Lib.noteStore
                       |> Task.andThen
                              (\store ->
                                  Store.query store
                                      |> Store.where (Store.eq .id nid)
                                      |> Store.where (Store.eq .userId userId)
                                      |> Store.toList conn
                                      |> Task.map List.head
                                      |> Task.andThen
                                             (\maybeNote ->
                                                 case maybeNote of

                                                     Nothing ->
                                                         Task.succeed ()

                                                     Just note ->
                                                         let
                                                             changed =
                                                                 { note | title = title, content = content }
                                                             cond =
                                                                 Store.and
                                                                     [ Store.eq .id note.id
                                                                     , Store.eq .userId userId
                                                                     ]
                                                         in
                                                             Store.updateWhere conn store cond changed
                                                                 |> Task.map (\_ -> ()))))


deleteNote : Db -> String -> Int -> Task Error ()
deleteNote conn noteId userId =
    parseNoteId noteId
        |> Task.andThen
               (\nid ->
                   Task.fromResult Lib.noteStore
                       |> Task.andThen
                              (\store ->
                                  Store.deleteWhere
                                      conn
                                      store
                                      (Store.and
                                          [ Store.eq .id nid
                                          , Store.eq .userId userId
                                          ])
                                      |> Task.map (\_ -> ())))


-- getNotes : Task Error (List Note) — this user's notes, newest edit first.
getNotes : Db -> Int -> Task Error (List Note)
getNotes conn userId =
    Task.fromResult Lib.noteStore
        |> Task.andThen
               (\store ->
                   Store.query store
                       |> Store.where (Store.eq .userId userId)
                       |> Store.orderDesc "updatedAt"
                       |> Store.toList conn)


getNote : Db -> String -> Int -> Task Error (Maybe Note)
getNote conn noteId userId =
    parseNoteId noteId
        |> Task.andThen
               (\nid ->
                   Task.fromResult Lib.noteStore
                       |> Task.andThen
                              (\store ->
                                  Store.query store
                                      |> Store.where (Store.eq .id nid)
                                      |> Store.where (Store.eq .userId userId)
                                      |> Store.toList conn
                                      |> Task.map List.head))
