module Lib.Auth exposing
    ( hashPassword
    , verifyPassword
    , generateToken
    , createUser
    , authenticateUser
    , createSession
    , getSessionUser
    , verifyEmail
    )

import Ipe.Maybe as Maybe exposing (..)
import Ipe.Result as Result
import Ipe.List as List
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Error as Error exposing (Error)

import Ipe.Auth as Auth
import Ipe.Crypto as Crypto
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Unsafe as DbUnsafe
import Ipe.Db exposing (SqlValue(..))
import Ipe.Db.Store as Store
import Ipe.Dict as Dict
import Lib.Db as Lib exposing (User, SessionUser)


hashPassword : String -> String
hashPassword password =
    case Auth.hashPassword password of

        Ok hash ->
            hash

        Err _ ->
            ""


verifyPassword : String -> String -> Bool
verifyPassword password storedHash =
    Result.withDefault False (Auth.verifyPassword password storedHash)


-- generateToken : Task Error String — CSPRNG-backed UUID via Crypto.randomToken.
generateToken : () -> Task Error String
generateToken _ =
    Crypto.randomToken 32


-- createUser : Task Error String (verification token). The UNIQUE email
-- constraint turns a duplicate into a driver error surfaced as InvalidInput.
createUser : Db -> String -> String -> Task Error String
createUser conn email password =
    generateToken ()
        |> Task.andThen
               (\token ->
                   let
                       passHash = hashPassword password
                       newUser =
                           { id = 0
                           , email = email
                           , passwordHash = passHash
                           , verified = 0
                           , verificationToken = token
                           , createdAt = ""
                           }
                   in
                       Task.fromResult Lib.userStore
                           |> Task.andThen
                                  (\store ->
                                      Store.insert conn store newUser
                                          |> Task.map (\_ -> token)
                                          |> Task.onError
                                                 (\_ ->
                                                     Task.fail
                                                         (Error.invalidInput
                                                             "That email is already registered, or a server error occurred."))))


-- authenticateUser : Task Error User. Wrong email / wrong password both
-- surface as PermissionDenied; DB errors propagate upstream.
authenticateUser : Db -> String -> String -> Task Error User
authenticateUser conn email password =
    Task.fromResult Lib.userStore
        |> Task.andThen
               (\store ->
                   Store.query store
                       |> Store.where (Store.eq .email email)
                       |> Store.toList conn
                       |> Task.map List.head
                       |> Task.andThen
                              (\maybeUser ->
                                  case maybeUser of

                                      Nothing ->
                                          Task.fail
                                              (Error.permissionDenied
                                                  |> Error.withMessage "Invalid email or password.")

                                      Just user ->
                                          Task.fromResult (checkCredentials password user)))


-- Verifies password + verified flag, returning the whole user on success.
checkCredentials : String -> User -> Result Error User
checkCredentials password user =
    if verifyPassword password user.passwordHash then
        if user.verified == 1 then
            Ok user

        else
            Err
                (Error.permissionDenied
                    |> Error.withMessage
                           "Email not verified yet. Please check the server console for your verification link.")

    else
        Err
            (Error.permissionDenied
                |> Error.withMessage "Invalid email or password.")


-- createSession : Task Error String — generates a token, inserts the row,
-- returns the token for the cookie.
createSession : Db -> Int -> Task Error String
createSession conn userId =
    generateToken ()
        |> Task.andThen
               (\token ->
                   let
                       newSession =
                           { id = 0, userId = userId, token = token, createdAt = "" }
                   in
                       Task.fromResult Lib.sessionStore
                           |> Task.andThen
                                  (\store ->
                                      Store.insert conn store newSession
                                          |> Task.map (\_ -> token)))


-- getSessionUser : Task Error (Maybe SessionUser). Runs a JOIN
-- (users ⋈ sessions) via raw SQL — single-table Store cannot express it.
getSessionUser : Db -> String -> Task Error (Maybe SessionUser)
getSessionUser conn sessionToken =
    DbUnsafe.unsafeQuery
        conn
        "SELECT u.id, u.email, u.created_at FROM users u INNER JOIN sessions s ON u.id = s.user_id WHERE s.token = ? LIMIT 1"
        [ SqlString sessionToken ]
        |> Task.map (\rows -> List.head (List.filterMap decodeSessionUser rows))


decodeSessionUser : Dict String String -> Maybe SessionUser
decodeSessionUser row =
    case ( Dict.get "id" row, Dict.get "email" row, Dict.get "created_at" row ) of

        ( Just idStr, Just email, Just createdAt ) ->
            case String.toInt idStr of

                Just id ->
                    Just { id = id, email = email, createdAt = createdAt }

                Nothing ->
                    Nothing

        _ ->
            Nothing


-- verifyEmail : Task Error String — flip verified=1 for the row matching the
-- verification token (only while still unverified).
verifyEmail : Db -> String -> Task Error String
verifyEmail conn token =
    Task.fromResult Lib.userStore
        |> Task.andThen
               (\store ->
                   Store.query store
                       |> Store.where (Store.eq .verificationToken token)
                       |> Store.where (Store.eq .verified 0)
                       |> Store.toList conn
                       |> Task.map List.head
                       |> Task.andThen
                              (\maybeUser ->
                                  case maybeUser of

                                      Nothing ->
                                          Task.succeed
                                              "Your email has been verified! You can now sign in."

                                      Just user ->
                                          Store.update conn store { user | verified = 1 }
                                              |> Task.map
                                                     (\_ ->
                                                         "Your email has been verified! You can now sign in.")))
