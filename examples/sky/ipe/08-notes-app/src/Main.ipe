module Main exposing (main)

import Ipe.Maybe as Maybe exposing (..)
import Ipe.Task as Task
import Ipe.String as String
import Ipe.Http as Http
import Ipe.Http.Server as Server
import Ipe.Http.Server exposing (Request, Response)
import Ipe.Dict as Dict
import Ipe.Io as Io
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store
import Ipe.Error as Error exposing (Error)
import Lib.Db as Lib exposing (SessionUser)
import Lib.Auth as Auth
import Lib.Notes as Notes
import Lib.View as View


-- ============================================================
-- Form helpers
-- ============================================================
formValue : String -> Request -> String
formValue key req =
    Http.parseQuery (Server.body req)
        |> Dict.get key
        |> Maybe.withDefault ""


-- ============================================================
-- Database initialisation
-- ============================================================

-- initDb : open all three stores (idempotent DDL via migrate ledger).
initDb : Db -> Task Error ()
initDb conn =
    Task.fromResult Lib.userStore
        |> Task.andThen
               (\us ->
                   Store.create conn us
                       |> Task.andThen
                              (\_ -> Task.fromResult Lib.sessionStore)
                       |> Task.andThen
                              (\ss ->
                                  Store.create conn ss
                                      |> Task.andThen
                                             (\_ -> Task.fromResult Lib.noteStore)
                                      |> Task.andThen
                                             (\ns -> Store.create conn ns)
                                      |> Task.map (\_ -> ())))
        |> Task.onError
               (\e ->
                   do
                       Io.println
                           ("[NOTES ERROR] initDb: " ++ Error.toString e)
                       Task.succeed ())


-- ============================================================
-- Auth helpers
-- ============================================================
getSessionToken : Request -> String
getSessionToken req =
    Server.getCookie "session" req |> Maybe.withDefault ""


-- requireAuth : runs `onUser user email` only when a valid session exists.
-- DB errors log + redirect to sign-in. Ok Nothing → clear cookie + redirect.
requireAuth : Db -> Request -> (SessionUser -> String -> Task Error Response) -> Task Error Response
requireAuth conn req onUser =
    let
        token = getSessionToken req
    in
        if token == "" then
            Task.succeed (Server.redirect "/auth/sign-in")

        else
            Auth.getSessionUser conn token
                |> Task.andThen
                       (\maybeUser ->
                           case maybeUser of

                               Nothing ->
                                   Task.succeed
                                       (Server.redirect "/auth/sign-in"
                                           |> Server.withCookie
                                                  (Server.cookie "session" ""))

                               Just user ->
                                   let
                                       email = user.email
                                   in
                                       onUser user email)
                |> Task.onError
                       (\e ->
                           do
                               Io.println
                                   ("[NOTES ERROR] session lookup: "
                                       ++ Error.toString e)
                               Task.succeed (Server.redirect "/auth/sign-in"))


-- ============================================================
-- Auth handlers
-- ============================================================
handleLanding : Db -> Request -> Task Error Response
handleLanding _ req =
    let
        token = getSessionToken req
    in
        if token == "" then
            Task.succeed (Server.html (View.landingPage ()))

        else
            Task.succeed (Server.redirect "/notes")


-- handleSignIn: Auth.authenticateUser returns Task Error User.
-- Unauthorised → show the form error verbatim (already user-safe).
-- DbError/other → generic "unavailable" message, log details.
handleSignIn : Db -> Request -> Task Error Response
handleSignIn conn req =
    if Server.method req == "POST" then
        let
            email = formValue "email" req
            password = formValue "password" req
        in
            Auth.authenticateUser conn email password
                |> Task.andThen
                       (\user ->
                           let
                               userId = user.id
                           in
                               Auth.createSession conn userId
                                   |> Task.andThen
                                          (\sessionToken ->
                                              Task.succeed
                                                  (Server.redirect "/notes"
                                                      |> Server.withCookie
                                                             (Server.cookie "session" sessionToken)))
                                   |> Task.onError
                                          (\e ->
                                              do
                                                  Io.println
                                                      ("[NOTES ERROR] sign-in createSession: "
                                                          ++ Error.toString e)
                                                  Task.succeed
                                                      (Server.html
                                                          (View.signInPage
                                                              "Sign-in temporarily unavailable. Please try again."))))
                |> Task.onError
                       (\e ->
                           do
                               Io.println
                                   ("[NOTES ERROR] sign-in: " ++ Error.toString e)
                               Task.succeed
                                   (Server.html
                                       (View.signInPage (Error.toString e))))

    else
        Task.succeed (Server.html (View.signInPage ""))


-- handleSignUp: createUser returns Task Error String (token).
-- On validation error surface it verbatim; other errors get a generic msg.
handleSignUp : Db -> Request -> Task Error Response
handleSignUp conn req =
    if Server.method req == "POST" then
        let
            email = formValue "email" req
            password = formValue "password" req
            confirm = formValue "confirm_password" req
        in
            if password /= confirm then
                Task.succeed
                    (Server.html (View.signUpPage "Passwords do not match."))

            else if String.length password < 8 then
                Task.succeed
                    (Server.html
                        (View.signUpPage
                            "Password must be at least 8 characters."))

            else
                Auth.createUser conn email password
                    |> Task.andThen
                           (\_ -> Task.succeed (Server.html (View.signUpSuccessPage ())))
                    |> Task.onError
                           (\e ->
                               do
                                   Io.println
                                       ("[NOTES ERROR] sign-up: "
                                           ++ Error.toString e)
                                   Task.succeed
                                       (Server.html
                                           (View.signUpPage (Error.toString e))))

    else
        Task.succeed (Server.html (View.signUpPage ""))


handleForgotPassword : Db -> Request -> Task Error Response
handleForgotPassword _ req =
    if Server.method req == "POST" then
        let
            email = formValue "email" req
        in
            Auth.generateToken ()
                |> Task.andThen
                       (\resetToken ->
                           do
                               Io.println
                                   ("[Email Service] Password reset for: "
                                       ++ email
                                       ++ " "
                                       ++ resetToken)
                               Task.succeed
                                   (Server.html (View.forgotPasswordSentPage ())))

    else
        Task.succeed (Server.html (View.forgotPasswordPage ""))


-- handleVerify: verifyEmail returns Task Error String.
-- On DbError surface a generic failure message (details logged).
handleVerify : Db -> Request -> Task Error Response
handleVerify conn req =
    let
        token = Maybe.withDefault "" (Server.queryParam "token" req)
    in
        if token == "" then
            Task.succeed
                (Server.html
                    (View.verifyResultPage False "Missing verification token."))

        else
            Auth.verifyEmail conn token
                |> Task.andThen
                       (\msg -> Task.succeed (Server.html (View.verifyResultPage True msg)))
                |> Task.onError
                       (\e ->
                           do
                               Io.println
                                   ("[NOTES ERROR] verify: " ++ Error.toString e)
                               Task.succeed
                                   (Server.html
                                       (View.verifyResultPage
                                           False
                                           ("Verification failed: " ++ Error.toString e))))


handleSignOut : Db -> Request -> Task Error Response
handleSignOut conn req =
    let
        token = getSessionToken req
    in
        Task.fromResult Lib.sessionStore
            |> Task.andThen
                   (\store ->
                       Store.deleteWhere
                           conn
                           store
                           (Store.eq .token token)
                           |> Task.map (\_ -> ()))
            |> Task.onError
                   (\e ->
                       do
                           Io.println
                               ("[NOTES ERROR] sign-out: " ++ Error.toString e)
                           Task.succeed ())
            |> Task.andThen
                   (\_ ->
                       Task.succeed
                           (Server.redirect "/"
                               |> Server.withCookie (Server.cookie "session" "")))


-- ============================================================
-- Notes handlers
-- ============================================================

-- handleNotesList: getNotes returns Task Error (List Note).
-- On DbError show the generic error page — data integrity matters
-- more than silently rendering an empty list.
handleNotesList : Db -> Request -> Task Error Response
handleNotesList conn req =
    requireAuth conn req
        (\user email ->
            let
                userId = user.id
            in
                Notes.getNotes conn userId
                    |> Task.andThen
                           (\notes ->
                               Task.succeed (Server.html (View.notesListPage email notes)))
                    |> Task.onError
                           (\e ->
                               do
                                   Io.println
                                       ("[NOTES ERROR] list: " ++ Error.toString e)
                                   Task.succeed
                                       (Server.html
                                           (View.errorPage
                                               ("Failed to load notes: "
                                                   ++ Error.toString e)))))


handleNewNote : Db -> Request -> Task Error Response
handleNewNote conn req =
    requireAuth conn req
        (\user email ->
            let
                userId = user.id
            in
                if Server.method req == "POST" then
                    let
                        title = formValue "title" req
                        content = formValue "content" req
                    in
                        Notes.createNote conn userId title content
                            |> Task.andThen
                                   (\_ -> Task.succeed (Server.redirect "/notes"))
                            |> Task.onError
                                   (\e ->
                                       do
                                           Io.println
                                               ("[NOTES ERROR] createNote: "
                                                   ++ Error.toString e)
                                           Task.succeed
                                               (Server.html
                                                   (View.errorPage
                                                       ("Failed to save note: "
                                                           ++ Error.toString e))))

                else
                    Task.succeed
                        (Server.html (View.noteFormPage email "" "" "" False)))


handleViewNote : Db -> Request -> Task Error Response
handleViewNote conn req =
    requireAuth conn req
        (\user email ->
            let
                userId = user.id
                noteId =
                    Maybe.withDefault "" (Server.queryParam "id" req)
            in
                Notes.getNote conn noteId userId
                    |> Task.andThen
                           (\maybeNote ->
                               case maybeNote of

                                   Just note ->
                                       Task.succeed
                                           (Server.html (View.noteViewPage email note))

                                   Nothing ->
                                       Task.succeed
                                           (Server.html (View.errorPage "Note not found.")))
                    |> Task.onError
                           (\e ->
                               do
                                   Io.println
                                       ("[NOTES ERROR] getNote: " ++ Error.toString e)
                                   Task.succeed
                                       (Server.html
                                           (View.errorPage
                                               ("Failed to load note: "
                                                   ++ Error.toString e)))))


handleEditNote : Db -> Request -> Task Error Response
handleEditNote conn req =
    requireAuth conn req
        (\user email ->
            let
                userId = user.id
                noteId =
                    Maybe.withDefault "" (Server.queryParam "id" req)
            in
                if Server.method req == "POST" then
                    let
                        title = formValue "title" req
                        content = formValue "content" req
                    in
                        Notes.updateNote conn noteId userId title content
                            |> Task.andThen
                                   (\_ ->
                                       Task.succeed
                                           (Server.redirect ("/notes/view?id=" ++ noteId)))
                            |> Task.onError
                                   (\e ->
                                       do
                                           Io.println
                                               ("[NOTES ERROR] updateNote: "
                                                   ++ Error.toString e)
                                           Task.succeed
                                               (Server.html
                                                   (View.errorPage
                                                       ("Failed to update note: "
                                                           ++ Error.toString e))))

                else
                    Notes.getNote conn noteId userId
                        |> Task.andThen
                               (\maybeNote ->
                                   case maybeNote of

                                       Just note ->
                                           let
                                               title = note.title
                                               content = note.content
                                           in
                                               Task.succeed
                                                   (Server.html
                                                       (View.noteFormPage
                                                           email
                                                           title
                                                           content
                                                           noteId
                                                           True))

                                       Nothing ->
                                           Task.succeed
                                               (Server.html (View.errorPage "Note not found.")))
                        |> Task.onError
                               (\e ->
                                   do
                                       Io.println
                                           ("[NOTES ERROR] getNote (edit): "
                                               ++ Error.toString e)
                                       Task.succeed
                                           (Server.html
                                               (View.errorPage
                                                   ("Failed to load note: "
                                                       ++ Error.toString e)))))


handleDeleteNote : Db -> Request -> Task Error Response
handleDeleteNote conn req =
    requireAuth conn req
        (\user email ->
            let
                userId = user.id
                noteId =
                    Maybe.withDefault "" (Server.queryParam "id" req)
            in
                Notes.deleteNote conn noteId userId
                    |> Task.andThen (\_ -> Task.succeed (Server.redirect "/notes"))
                    |> Task.onError
                           (\e ->
                               do
                                   Io.println
                                       ("[NOTES ERROR] deleteNote: " ++ Error.toString e)
                                   Task.succeed
                                       (Server.html
                                           (View.errorPage
                                               ("Failed to delete note: "
                                                   ++ Error.toString e)))))


-- ============================================================
-- Server entry point
-- ============================================================
runServer : Db -> Task Error ()
runServer conn =
    initDb conn
        |> Task.andThen
               (\_ ->
                   do
                       Io.println ""
                       Io.println "==========================================="
                       Io.println " Notes App server running"
                       Io.println " http://localhost:8000"
                       Io.println "==========================================="
                       Io.println ""
                       Server.listen
                           8000
                           [ Server.any "/" (handleLanding conn)
                           , Server.any "/auth/sign-in" (handleSignIn conn)
                           , Server.any "/auth/sign-up" (handleSignUp conn)
                           , Server.any "/auth/forgot-password" (handleForgotPassword conn)
                           , Server.any "/auth/verify" (handleVerify conn)
                           , Server.any "/auth/sign-out" (handleSignOut conn)
                           , Server.any "/notes" (handleNotesList conn)
                           , Server.any "/notes/new" (handleNewNote conn)
                           , Server.any "/notes/view" (handleViewNote conn)
                           , Server.any "/notes/edit" (handleEditNote conn)
                           , Server.any "/notes/delete" (handleDeleteNote conn)
                           ])


main : Task Error ()
main =
    Db.connect ()
        |> Task.andThen runServer
