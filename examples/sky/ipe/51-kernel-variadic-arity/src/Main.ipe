module Main exposing (main)

import Ipe.Http as Http
import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Io as Io


fetchBody : Http.HttpRequest -> Task Error String
fetchBody req =
    Http.request req |> Task.andThen (\r -> Task.succeed r.body)


-- under-count case: `Db.open` partial-application (a curried closure).
openSqlite : String -> Task Error Db.Db
openSqlite =
    Db.open "sqlite"


main =
    do
        Io.println "kernel-arity ok"
