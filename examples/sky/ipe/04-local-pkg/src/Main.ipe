module Main exposing (main)

import Ipe.Io as Io
import Lib.Utils as Utils


main =
    let
        a = 10
        b = 20
        sum = Utils.add a b
        message = Utils.formatMessage "Current" sum
    in
        Io.println ("Calculation result: " ++ message)

    -- Io.println takes a single String; concat the prefix and the
    -- formatted message before passing.
