module Ui.Layout exposing (page)

import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onClick)
import State exposing (..)
import Ui.Styles exposing (globalStyles)


page model content =
    div
        []
        [ styleNode [] globalStyles
        , viewHeader model
        , div [ class "container" ] [ content ]
        ]


viewHeader model =
    headerNode
        [ class "header" ]
        [ div
              [ class "header-inner" ]
              [ a
                    [ href "/", attribute "sky-nav" "", class "logo" ]
                    [ text "♞ SkyChess" ]
              , nav [ class "nav" ] [ viewNavItems model ]
              ]
        ]


viewNavItems model =
    case model.page of

        GamePage ->
            span
                [ class "nav-info" ]
                [ span [ class "nav-player" ] [ text model.playerName ]
                , button
                      [ onClick BackToHome, class "btn btn-ghost btn-sm" ]
                      [ text "Home" ]
                ]

        _ ->
            text ""
