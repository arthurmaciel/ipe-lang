module Server exposing (run)

-- Wires the router + middleware stack.  Each route's handler is
-- composed bottom-up: the raw `Request -> Task Error Response`
-- handler gets withRateLimit (for bearer-bearing routes only),
-- then withLogging (everything), then withCors (everything).
--
-- The composite intentionally calls every middleware once so the
-- regression set catches a misregistered kernel sig.

import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Error exposing (Error)
import Ipe.Http.Server as HttpServer
import Ipe.Http.Server exposing (Request, Response)
import Ipe.Http.RateLimit as RateLimit
import Middleware
import Ipe.Cache as Cache
import Ipe.Log as Log
import Routes.Auth as AuthRoutes
import Routes.Todos as TodosRoutes
import Routes.Health as HealthRoutes
import State exposing (Config)


run : Config -> Int -> Db -> Cache.Cache String String -> Task Error ()
run cfg bootMs db cache =
    let
        -- Explicit lambdas around partial applications keep the
        -- wrapping shape obvious and avoid partial-application
        -- miscompile in 3-arg typed FFI kernels.
        cors h =
            Middleware.withCors cfg.corsOrigins h

        -- Two-layer middleware stack: CORS + structured request logging.
        wrap h =
            cors (Middleware.withLogging h)

        -- Per-request rate limit enforced at the handler boundary.
        guarded h =
            wrap (rateLimit "api" cfg.rateLimitCapacity cfg.rateLimitRefill h)

        -- Dispatch GET vs POST on the same /api/todos pathname.
        todosByMethod req =
            if req.method == "POST" then
                TodosRoutes.handleCreate cfg db req

            else
                TodosRoutes.handleList cfg db req
    in
        do
            Log.infoWith
                "server.starting"
                [ ( "port", String.fromInt cfg.port )
                , ( "rateLimitProbe", probeRateLimit )
                ]
            HttpServer.listen
                cfg.port
                [ HttpServer.api
                      "POST /api/register"
                      (wrap (AuthRoutes.handleRegister cfg db))
                , HttpServer.api
                      "POST /api/login"
                      (wrap (AuthRoutes.handleLogin cfg db))
                , HttpServer.api "/api/todos" (guarded todosByMethod)
                , HttpServer.api
                      "DELETE /api/todos/:id"
                      (guarded (TodosRoutes.handleDelete cfg db))
                -- Streaming responses bypass the middleware wrap to
                -- preserve the chunked-write path.
                , HttpServer.api
                      "GET /api/export.csv"
                      (HealthRoutes.handleExport cfg db)
                , HttpServer.api
                      "GET /api/health"
                      (wrap (HealthRoutes.handleHealth cache bootMs))
                ]


probeRateLimit : String
probeRateLimit =
    if RateLimit.allow "probe" "0.0.0.0" 100 100 then
        "true"

    else
        "false"


-- In-handler rate limit gate.  Returns a 429 Response directly when
-- the bucket is empty; otherwise threads the request through `inner`.
rateLimit : String -> Int -> Int -> (Request -> Task Error Response) -> Request -> Task Error Response
rateLimit name capacity refill inner req =
    let
        ip = clientIp req
    in
        if RateLimit.allow name ip capacity refill then
            inner req

        else
            Task.succeed (rateLimitedResponse)


clientIp : Request -> String
clientIp req =
    case Dict.get "X-Forwarded-For" req.headers of

        Just v ->
            v

        Nothing ->
            req.remoteAddr


rateLimitedResponse : Response
rateLimitedResponse =
    { status = 429
    , body = "{\"error\":\"rate limit exceeded\"}"
    , headers = Dict.empty
    , contentType = "application/json"
    }
