module Middleware exposing (withCors, withLogging, withRateLimit, withBasicAuth)

-- Local typed wrappers over the kernel middleware dispatchers.
--
-- The stdlib `Sky.Http.Middleware` module declares its helpers as
-- `Handler -> Handler` where `Handler` is an undeclared name — Sky's
-- HM treats it as an opaque type that doesn't unify with the actual
-- handler shape `Request -> Task Error Response`, so passing the
-- result to `Server.get` / `Server.post` produces a type error.
-- (Filed as a finding in the v0.16.2 composite-server work; until
-- the stdlib module exports a typed Handler alias, this re-binding
-- via `Ffi.kernel` is the canonical workaround.)

import Ipe.Http.Middleware as Middleware
import Ipe.Error exposing (Error)
import Ipe.Http.Server exposing (Request, Response)

type alias Handler =
    Request -> Task Error Response


withCors : List String -> Handler -> Handler
withCors =
    Middleware.withCors


withLogging : Handler -> Handler
withLogging =
    Middleware.withLogging


withRateLimit : String -> Int -> Int -> Handler -> Handler
withRateLimit =
    Middleware.withRateLimit


withBasicAuth : String -> String -> Handler -> Handler
withBasicAuth =
    Middleware.withBasicAuth
