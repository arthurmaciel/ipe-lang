module Main exposing (main)

-- examples/27-multi-session-chat — pub/sub chatroom demo.
--
-- Two browser tabs in the same room see each other's messages in
-- real time WITHOUT polling. Each session subscribes to the room's
-- topic via `Sub.subscribeTopic` and broadcasts new messages via
-- `Cmd.publish`. The publisher's own subscription also receives the
-- broadcast (echo-by-default — matches Redis/NATS/MQTT semantics).
--
-- DURABILITY PATTERN. Each SendMessage handler ALWAYS writes the
-- message to SQLite first, THEN publishes to the topic. Notifications
-- can be lost on a process crash or network blip — the database is
-- the source of truth, the broadcast is the low-latency hint. If the
-- publish never reaches a subscriber, the next /chat/<room> page
-- load reads the persisted history.
--
-- EFFECT MODEL. Every database read/write is a `Task Error a`; there
-- is no synchronous force. A Web-shape `Model` is persisted to the
-- session store between requests, so it holds plain data only — never
-- the opaque `Db` handle. Each database effect therefore opens its
-- own pooled connection inside its Task chain (`Db.connect
-- |> Task.andThen <schema> |> Task.andThen <op>`): `init` pre-loads a
-- direct-linked room's history via the `Ready` message, `JoinRoom`
-- re-reads it via `HistoryLoaded`, and `SendMessage` reads the clock
-- and persists in one chain reported by `PersistResult`. Each effect
-- is dispatched from `update` via `Task.attempt`, and its settled
-- `Result` folds into the model in a dedicated `update` branch.

import Ipe.String as String
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Error as Error exposing (Error(..), ErrorKind(..))
import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Html.Events exposing (onSubmit)
import Ipe.Ui as Ui
import Ipe.PubSub as PubSub exposing (Topic)
import Ipe.Tea.Web exposing (app, route)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Db as Db
import Ipe.Db.Unsafe as DbUnsafe

-- ─── Model ───────────────────────────────────────────────────────
type Page
    = LobbyPage
    | RoomPage String

type alias ChatMessage =
    { author : String
    , text : String
    , at : String
    }

-- The Web-shape Model is persisted to the session store between
-- requests, so it holds plain data only — never the opaque `Db`
-- handle (IPE-L0120). Each database effect opens its own pooled
-- connection inside its Task chain; the settled data (loaded history,
-- a persist result) is what reaches the Model.
type alias Model =
    { page : Page
    , me : String
    , room : String
    , history : List ChatMessage
    , notice : String
    }

type alias JoinPayload =
    { room : String
    , me : String
    }

type alias ChatForm =
    { text : String }

type Msg
    = Ready (Result Error (List ChatMessage))
    | JoinRoom JoinPayload
    | HistoryLoaded (Result Error (List ChatMessage))
    | SendMessage ChatForm
    | MessageReceived (Dict String String)
    | PersistResult (Result Error Int)


-- ─── Db helpers ──────────────────────────────────────────────────
-- Create the table if it does not exist. Chains off an open
-- connection and yields the same connection so callers can keep
-- building the Task pipeline.
ensureSchema : Db -> Task Error Db
ensureSchema conn =
    DbUnsafe.unsafeExecRaw
        conn
        """CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            room TEXT NOT NULL,
            author TEXT NOT NULL,
            text TEXT NOT NULL,
            at TEXT NOT NULL
        )"""
        |> Task.map (\_ -> conn)


rowToMessage : Dict String String -> ChatMessage
rowToMessage row =
    { author = DbUnsafe.unsafeGetString "author" row
    , text = DbUnsafe.unsafeGetString "text" row
    , at = DbUnsafe.unsafeGetString "at" row
    }


-- Open a pooled connection, ensure the schema, and read `room`'s
-- persisted history (most recent 200, oldest first). One self-
-- contained Task chain — the connection never escapes into the Model.
loadRoomHistory : String -> Task Error (List ChatMessage)
loadRoomHistory room =
    Db.connect ()
        |> Task.andThen ensureSchema
        |> Task.andThen
            (\conn ->
                DbUnsafe.unsafeQuery
                    conn
                    "SELECT author, text, at FROM messages WHERE room = ? ORDER BY id ASC LIMIT 200"
                    [ room ]
            )
        |> Task.map (List.map rowToMessage)


-- Open a pooled connection, ensure the schema, and persist one row.
persistMessage : String -> ChatMessage -> Task Error Int
persistMessage room msg =
    Db.connect ()
        |> Task.andThen ensureSchema
        |> Task.andThen
            (\conn ->
                Db.insertRow
                    conn
                    "messages"
                    (Dict.fromList
                        [ ( "room", room )
                        , ( "author", msg.author )
                        , ( "text", msg.text )
                        , ( "at", msg.at )
                        ])
            )


-- ─── Topic naming ────────────────────────────────────────────────
-- A `Topic (Dict String String)` handle keyed by room. Sharing one
-- handle type between `Cmd.publish` and `Sub.subscribeTopic` makes
-- the compiler prove publisher and subscriber agree on the payload
-- shape (a flat string-valued row).
roomTopic : String -> Topic (Dict String String)
roomTopic room =
    PubSub.topic ("chat:room-" ++ room)


-- ─── Decoder for broadcast payloads ──────────────────────────────
-- Subscribers receive the flat `Dict String String` row the
-- publisher broadcast and read its fields back into the application
-- shape.
decodeChatMessage : Dict String String -> ChatMessage
decodeChatMessage payload =
    { author = DbUnsafe.unsafeGetString "author" payload
    , text = DbUnsafe.unsafeGetString "text" payload
    , at = DbUnsafe.unsafeGetString "at" payload
    }


-- ─── Init ────────────────────────────────────────────────────────
-- | `init` runs once per new session. The runtime hands us the
-- request, whose `path` is the URL that opened the session, so we can
-- pre-load the room's persisted history when a user lands directly on
-- `/chat/<room>` (e.g. via a bookmark or shared link). The history is
-- read asynchronously; the model starts empty and `Ready` fills it in.
init req =
    let
        slug = roomSlugFromPath req.path
        startPage =
            if slug == "" then
                LobbyPage

            else
                RoomPage slug

        loadHistory =
            if slug == "" then
                Cmd.none

            else
                Task.attempt Ready (loadRoomHistory slug)
    in
        ( { page = startPage
          , me = ""
          , room = slug
          , history = []
          , notice = ""
          }
        , loadHistory
        )


-- | `roomSlugFromPath path` — pull `<slug>` out of `/chat/<slug>`.
-- Returns "" when the path doesn't match (lobby + everything else).
roomSlugFromPath : String -> String
roomSlugFromPath path =
    if String.startsWith "/chat/" path then
        String.slice 6 (String.length path) path

    else
        ""


-- ─── Subscriptions ───────────────────────────────────────────────
subscriptions : Model -> Sub.Sub Msg
subscriptions model =
    case model.page of

        RoomPage room ->
            Sub.subscribeTopic (roomTopic room) MessageReceived

        LobbyPage ->
            Sub.none


-- | Derive the current room slug from `model.page`. This stays in
-- step with the URL automatically (the runtime sets `model.page`
-- from the matched route), so SendMessage / subscribeTopic never
-- drift out of sync with the browser's address bar.
currentRoom : Model -> String
currentRoom model =
    case model.page of

        RoomPage room ->
            room

        LobbyPage ->
            ""


-- ─── Update ──────────────────────────────────────────────────────
update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Ready (Ok history) ->
            ( { model | history = history }, Cmd.none )

        Ready (Err e) ->
            ( { model | notice = "cannot open chat.db: " ++ Error.toString e }
            , Cmd.none
            )

        JoinRoom payload ->
            ( { model | page = RoomPage payload.room
              , me = payload.me
              , room = payload.room
              , history = []
              , notice = "Joined " ++ payload.room ++ " as " ++ payload.me
              }
            , Task.attempt HistoryLoaded (loadRoomHistory payload.room)
            )

        HistoryLoaded (Ok history) ->
            ( { model | history = history }, Cmd.none )

        HistoryLoaded (Err e) ->
            ( { model | notice = "load failed: " ++ Error.toString e }
            , Cmd.none
            )

        SendMessage submitted ->
            let
                trimmed = String.trim submitted.text
                room = currentRoom model
                author =
                    if model.me == "" then
                        "guest"

                    else
                        model.me
            in
                if trimmed == "" || room == "" then
                    ( model, Cmd.none )

                else
                    ( model, sendMessageCmd room author trimmed )

        MessageReceived payload ->
            let
                chatMsg = decodeChatMessage payload
            in
                ( { model | history = List.append model.history [ chatMsg ] }
                , Cmd.none
                )

        PersistResult (Ok _) ->
            ( model, Cmd.none )

        PersistResult (Err e) ->
            ( { model | notice = "save failed: " ++ Error.toString e }
            , Cmd.none
            )


-- Persist the message (timestamp read inside the same chain, so the
-- clock read is never forced synchronously) and broadcast the row to
-- the room's topic. The persist is reported by `PersistResult`; the
-- publish is fire-and-forget (the durable write is the source of
-- truth). Echo-to-publisher means the sender's own subscription
-- appends the row, so `update` does not touch `history` here.
sendMessageCmd : String -> String -> String -> Cmd Msg
sendMessageCmd room author trimmed =
    let
        payloadFor timestamp =
            Dict.fromList
                [ ( "author", author )
                , ( "text", trimmed )
                , ( "at", timestamp )
                ]

        persist =
            Time.now ()
                |> Task.andThen
                    (\millis ->
                        let
                            row = payloadFor (Time.timeString millis)
                        in
                            persistMessage room (rowToMessage row)
                    )
    in
        Cmd.batch
            [ Task.attempt PersistResult persist
            , Cmd.publish
                (roomTopic room)
                (payloadFor (currentTimestampHint ()))
            ]


-- The broadcast is a low-latency hint; its timestamp is a best-effort
-- placeholder that the durable row (persisted with the real clock
-- read) supersedes on the next history load. Kept blank so the hint
-- never claims a fabricated time.
currentTimestampHint : () -> String
currentTimestampHint _ =
    ""


-- ─── View ────────────────────────────────────────────────────────
-- The Web shape's `view` is `Model -> Element Msg`; this app is
-- rendered as raw HTML with its own stylesheet, reached through the
-- single `Ui.html` bridge node.
view : Model -> Element Msg
view model =
    Ui.html (viewHtml model)


viewHtml : Model -> Html Msg
viewHtml model =
    div
        []
        [ styleNode [] pageStyles
        , div
              [ class "app" ]
              [ header
                    [ class "topbar" ]
                    [ h1 [] [ text "Ipê · multi-session chat" ]
                    , p
                          [ class "hint" ]
                          [ text
                                "Open two browser tabs in the same room to see pub/sub in action."
                          ]
                    ]
              , div [ class "content" ] [ pageBody model ]
              , footer
                    [ class "footer" ]
                    [ text
                          "Echo-to-publisher matches Redis/NATS/MQTT — your own messages arrive on the broadcast too."
                    ]
              ]
        ]


pageBody : Model -> Html Msg
pageBody model =
    case model.page of

        LobbyPage ->
            lobbyView model

        RoomPage room ->
            roomView model room


lobbyView : Model -> Html Msg
lobbyView _model =
    div
        [ class "lobby" ]
        [ h2 [] [ text "Join a room" ]
        , form
              [ class "lobby-form", onSubmit JoinRoom ]
              [ label
                    []
                    [ text "Your name"
                    , input
                          [ name "me"
                          , placeholder "alice"
                          , required True
                          , autocomplete "off"
                          ]
                    ]
              , label
                    []
                    [ text "Room"
                    , input
                          [ name "room"
                          , placeholder "lounge"
                          , required True
                          , autocomplete "off"
                          ]
                    ]
              , button [ type_ "submit", class "primary" ] [ text "Join" ]
              ]
        , p
              [ class "hint" ]
              [ text
                    "Tip: open this page in TWO browser tabs and join the same room with different names. Each message you send in one tab will appear in the other within a few milliseconds, with no polling."
              ]
        ]


roomView : Model -> String -> Html Msg
roomView model room =
    div
        [ class "room" ]
        [ div
              [ class "room-header" ]
              [ h2 [] [ text ("# " ++ room) ]
              , div [ class "me" ] [ text ("you: " ++ model.me) ]
              ]
        , div
              [ class "log", id "chat-log" ]
              (List.map (messageRow model.me) model.history)
        , form
              [ class "composer", onSubmit SendMessage ]
              [ input
                    [ name "text"
                    , id "chat-input"
                    , placeholder "Say something…"
                    , autocomplete "off"
                    ]
              , button [ type_ "submit", class "primary" ] [ text "Send" ]
              ]
        , if model.notice == "" then
              span [] []

          else
              div [ class "notice" ] [ text model.notice ]
        ]


messageRow : String -> ChatMessage -> Html Msg
messageRow me msg =
    let
        klass =
            if msg.author == me then
                "msg msg-mine"

            else
                "msg"
    in
        div
            [ class klass ]
            [ span [ class "msg-author" ] [ text msg.author ]
            , span [ class "msg-at" ] [ text (" · " ++ msg.at) ]
            , div [ class "msg-text" ] [ text msg.text ]
            ]


-- ─── App wiring ──────────────────────────────────────────────────
main =
    app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ route "/" LobbyPage, route "/chat/:room" RoomPage ]
        , notFound = LobbyPage
        }


-- ─── Styles ──────────────────────────────────────────────────────
pageStyles =
    """
    * { box-sizing: border-box; }
    body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #f5f5f5;
        color: #1f2937;
    }
    .app { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
    .topbar { border-bottom: 1px solid #e5e7eb; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    .topbar h1 { margin: 0 0 .25rem; font-size: 1.4rem; }
    .hint { color: #6b7280; font-size: .9rem; margin: 0; }
    .lobby-form { display: flex; flex-direction: column; gap: .75rem; max-width: 320px; margin: 1rem 0 1.5rem; }
    .lobby-form label { display: flex; flex-direction: column; gap: .25rem; font-size: .85rem; color: #374151; }
    .lobby-form input { padding: .5rem .75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem; }
    .room-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 1px solid #e5e7eb; margin-bottom: 1rem; }
    .room-header h2 { margin: 0; font-size: 1.2rem; }
    .me { color: #6b7280; font-size: .85rem; }
    .log { min-height: 280px; max-height: 460px; overflow-y: auto; padding: .5rem; background: white; border: 1px solid #e5e7eb; border-radius: 8px; margin-bottom: 1rem; }
    .msg { padding: .35rem .5rem; margin: .15rem 0; border-radius: 6px; }
    .msg-mine { background: #eff6ff; }
    .msg-author { font-weight: 600; color: #1f2937; font-size: .85rem; }
    .msg-at { color: #9ca3af; font-size: .75rem; }
    .msg-text { color: #1f2937; margin-top: .15rem; white-space: pre-wrap; word-break: break-word; }
    .composer { display: flex; gap: .5rem; }
    .composer input { flex: 1; padding: .5rem .75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem; }
    .primary { padding: .5rem 1rem; border: 0; border-radius: 6px; background: #2563eb; color: white; font-size: .95rem; cursor: pointer; }
    .primary:hover { background: #1d4ed8; }
    .notice { margin-top: .75rem; padding: .5rem .75rem; background: #fef3c7; color: #92400e; border-radius: 6px; font-size: .85rem; }
    .footer { margin-top: 2rem; color: #9ca3af; font-size: .8rem; text-align: center; }
    """
