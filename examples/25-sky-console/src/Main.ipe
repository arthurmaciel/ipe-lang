module Main exposing (main)

-- Sky Console (Phase A — Ipe.Ui Ipe.Live mini-app).
--
-- Phase A: standalone Ipe.Live example that proves the Ipe.Ui UI
-- works typed end-to-end with mocked data. Once green, the same
-- source moves to sky-stdlib/Sky/Internal/Console/ in Phase B and
-- the runtime auto-mounts it under /_sky/console.
--
-- No hand-written JS in this source — every interaction is
-- onClick → Msg → update → re-render via Ipe.Live's framework
-- wire (SSE + POST /_sky/event). Multi-module split so the
-- type-checker stays well below the heap-exhaustion limit
-- (AGENTS.md Limitation #17).
import Ipe.Prelude exposing (..)
import Ipe.Cmd as Cmd
import Ipe.Sub as Sub
import Ipe.Live exposing (app, route)
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)
import State exposing (..)
import View exposing (view)


init : a -> ( Model, Cmd Msg )
init _req =
    ( { tab      = Overview
      , overview = mockOverview
      , logs     = mockLogs
      , metrics  = mockMetrics
      , traces   = mockTraces
      , errors   = mockErrors
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        SelectTab tab ->
            ( { model | tab = tab }, Cmd.none )

        Tick ->
            -- Phase B: re-fetch overview / logs / etc. from runtime.
            -- Phase A: tick is a no-op so the polling sub still
            -- exercises the wire path end-to-end.
            ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


viewWrapped : Model -> any
viewWrapped model =
    Ui.layout [] (view model)


main =
    app
        { init          = init
        , update        = update
        , view          = viewWrapped
        , subscriptions = subscriptions
        , routes        = [ route "/" () ]
        , notFound      = ()
        }
