module Migrations exposing (all)

-- Versioned schema migrations for the composite todo+auth service.
-- One migration per logical change; checksums of the SQL body are
-- guarded by `Db.migrate` so an edit-after-apply is rejected.
--
-- Corpus patch: upstream uses `Db.Migration` (a record type alias
-- `{ name : String, sql : String }`); our Ipê compiler's DbMigrate
-- kernel takes `List (String, String)` (name, sql) tuples directly.
import Sky.Core.Prelude exposing (..)
import Std.Db as Db


all : List ( String, String )
all =
    [ usersTable, todosTable, todosUserIdIndex ]


usersTable : ( String, String )
usersTable =
    ( "0001_users"
    , """
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            created_at INTEGER NOT NULL
        )
      """
    )


todosTable : ( String, String )
todosTable =
    ( "0002_todos"
    , """
        CREATE TABLE todos (
            id TEXT PRIMARY KEY,
            user_id INTEGER NOT NULL,
            text TEXT NOT NULL,
            done INTEGER NOT NULL DEFAULT 0,
            created_at INTEGER NOT NULL
        )
      """
    )


todosUserIdIndex : ( String, String )
todosUserIdIndex =
    ( "0003_todos_user_id_idx"
    , "CREATE INDEX todos_user_id_idx ON todos(user_id)"
    )
